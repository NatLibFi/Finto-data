{% if request.lang == 'fi' %}

<p id="suggestion-link">
{% if request.vocabid == 'yso' %}
  Voit ehdottaa uusia käsitteitä YSOon <a href="yso/{{request.lang}}/#suggestion" target="_blank">lomakkeella</a>.
  Jos haluat ehdottaa muutosta YSOn käsitteeseen, muutosehdotuslomake löytyy YSO-käsitteiden tietojen yhteydestä.
{% elseif request.vocabid == 'yso-paikat'  %}
  Voit ehdottaa uusia käsitteitä YSO-paikkoihin <a href="yso-paikat/{{request.lang}}/#suggestion" target="_blank">lomakkeella</a>.
  Jos haluat ehdottaa muutosta YSO-paikkojen käsitteeseen, muutosehdotuslomake löytyy YSO-paikat-käsitteiden tietojen yhteydestä.
{% elseif request.vocabid == 'slm' %}
  Voit ehdottaa uusia käsitteitä SLM:ään <a href="slm/{{request.lang}}/#suggestion" target="_blank">lomakkeella</a>.
  Jos haluat ehdottaa muutosta SLM:n käsitteeseen, muutosehdotuslomake löytyy SLM-käsitteiden tietojen yhteydestä.
{% endif %}
</p>

{% elseif request.lang == 'sv' %}

<p id="suggestion-link">
{% if request.vocabid == 'yso' %}
  Du kan föreslå nya begrepp till ALLFO med hjälp av <a href="yso/{{request.lang}}/#suggestion" target="_blank">förslagsformuläret</a>.
  Ändringar av ALLFO-begrepp föreslås via formuläret i begreppets uppgifter.
{% elseif request.vocabid == 'yso-paikat'  %}
  Du kan föreslå nya begrepp till ALLFO-orter med hjälp av <a href="yso-paikat/{{request.lang}}/#suggestion" target="_blank">förslagsformuläret</a>.
  Ändringar av ALLFO-orter föreslås via formuläret i begreppets uppgifter.
{% elseif request.vocabid == 'slm' %}
