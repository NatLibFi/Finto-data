        ysa:Y214456 ;
    skos:definition "Elektronisesti tuotettu, klubiympäristöön tarkoitettu tanssittava popmusiikki, jota luonnehtii yleensä rumpukoneen luoma voimakas rytmi, samplerilla tai syntetisaattorilla luotu melodia sekä nopea tempo. Laulun rooli on yleensä vähäinen ja musiikki usein enimmäkseen instrumentaalista, poikkeuksena kuitenkin dance."@fi,
        "Elektroniskt producerad popmusik avsedd för dans, som vanligen präglas av kraftig rytm skapad med trummaskin, melodi skapad med sampler eller syntetisator samt snabbt tempo. Sångens roll är vanligen obetydlig och musiken är ofta instrumental, undantaget dance."@sv ;
    skos:inScheme ekso: ;
    skos:narrower yso:p12377,
        yso:p14614,
        yso:p29901,
        yso:p29943,
        yso:p30024,
        yso:p30149,
        yso:p39083 ;
    skos:prefLabel "electronic dance music"@en,
        "elektroninen tanssimusiikki"@fi,
        "elektrovnnalaš dánsamusihkka"@sme,
        "elektronisk dansmusik"@sv .

