yso:p14131 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2002-12-02"^^xsd:date ;
    rdau:P60686 yso:p14132 ;
    skos:altLabel "uppfostringshem"@sv ;
    skos:broader yso:p8577 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85112239>,
        <http://www.wikidata.org/entity/Q10709884>,
        allars:Y42058,
        ysa:Y121972 ;
    skos:definition "Kasvatuslaitoksia alettiin perustaa 1800-luvulla. Laitoksiin sijoitettiin tuomioistuinten päätöksillä 7–14-vuotiaita lapsia ja laitokset toimivat vankeinhoitohallituksen alaisina. Kasvatuslaitosten nimet muutettiin koulukodeiksi vuonna 1946, kun rangaistuslaitosten maineesta pyritiin eroon."@fi,
        "Uppfostringsanstalter började grundas på 1800-talet. I dessa anstalter placerades barn i åldern 7-14 på basis av domstolsbeslut och anstalterna fungerade under fångvårdsstyrelsen. Uppfostringsanstalternas namn ändrades till skolhem år 1946 då man försökte frånkomma ryktet som straffanstalter."@sv ;
    skos:hiddenLabel "reformatory"@en,
        "kasvatuslaitos"@fi,
        "bajásgeassinásahus"@sme,
        "uppfostringsanstalt"@sv ;
    skos:inScheme ekso: ;
    skos:note "Concept in use until 1946. For later use, see [http://www.yso.fi/onto/yso/p14132]."@en,
        "Vuodesta 1946 alkaen käytetty nimitystä [http://www.yso.fi/onto/yso/p14132]"@fi,
        "Sedan 1946 används begreppet [http://www.yso.fi/onto/yso/p14132]"@sv ;
    skos:prefLabel "reformatories"@en,
        "kasvatuslaitokset"@fi,
        "bajásgeassinásahusat"@sme,
        "uppfostringsanstalter"@sv ;
    skos:related yso:p14129 ;
    yso-meta1:singularPrefLabel "reformatory"@en,
        "kasvatuslaitos"@fi,
        "bajásgeassinásahus"@sme,
        "uppfostringsanstalt"@sv .

