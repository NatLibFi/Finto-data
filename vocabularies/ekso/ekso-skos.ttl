yso:p28777 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2016-01-13"^^xsd:date ;
    skos:broader yso:p28425 ;
    skos:closeMatch allars:Y50170,
        ysa:Y206801 ;
    skos:hiddenLabel "tradition area"@en,
        "perinnealue"@fi,
        "árbeguovlu"@sme,
        "traditionsområde"@sv ;
    skos:inScheme ekso: ;
    skos:note "Alue, joka on perinteensä osalta suhteellisen homogeeninen. Perinnealueen määrittymiseen vaikuttavat mm. etnisyys, murre tai kieli, hallinnolliset rajat ja uskonto. Suomalaisessa perinteentutkimuksessa perinnealuejako myötäilee yleensä Suomen historiallisia maakuntia."@fi,
        "Område som till sin tradition är relativt homogent. Bestämningen av ett traditionsområde påverkas bl.a. av etnicitet, dialekt eller språk, administrativa gränser och religion. Inom finländsk traditionsforskning indelas traditionsområden vanligen i enlighet med Finlands historiska landskap."@sv ;
    skos:prefLabel "tradition areas"@en,
        "perinnealueet"@fi,
        "árbeguovllut"@sme,
        "traditionsområden"@sv ;
    yso-meta1:singularPrefLabel "tradition area"@en,
        "perinnealue"@fi,
        "árbeguovlu"@sme,
        "traditionsområde"@sv .

