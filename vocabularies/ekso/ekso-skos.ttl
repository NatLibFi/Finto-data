yso:p26342 a skos:Concept,
        yso-meta1:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-04-24"^^xsd:date ;
    skos:altLabel "townhouses"@fi,
        "stadssmåhus"@sv ;
    skos:broader yso:p11762 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q1202402>,
        allars:Y44511,
        ysa:Y185614 ;
    skos:hiddenLabel "townhouse"@en,
        "kaupunkipientalo"@fi,
        "townhouse"@fi,
        "townhouse"@sv ;
    skos:inScheme ekso: ;
    skos:note "A townhouse is a terraced (row housing) house in urban areas that consist of multiple floors and stands on its own plot.  Townhouses usually have their own outside door and a small private backyard."@en,
        "Viereiseen asuntoon kytketty, kaksi- tai kolmikerroksinen kaupunkimainen pientalo, joka sijaitsee omalla tontillaan. Kaupunkipientaloissa ei ole rivitaloille usein tyypillisiä yhteispihoja, ainoastaan pieni yksityispiha, joka sijaitsee yleensä rakennuksen takana. Kuhunkin kaupunkipientaloon on sisäänkäynti suoraan kadulta"@fi,
        "Stadsaktigt småhus i två eller tre våningar, på egen tomt, men i direkt anslutning till angränsande bostad. Husen har inte gemensamma gårdar såsom radhus, utan enbart en liten privat gård som vanligen finns på byggnadens baksida. Ingång till husen sker direkt från gatan."@sv ;
    skos:prefLabel "townhouses"@en,
        "kaupunkipientalot"@fi,
        "townhouses"@sv ;
    yso-meta1:singularAltLabel "townhouse"@fi ;
    yso-meta1:singularPrefLabel "townhouse"@en,
        "kaupunkipientalo"@fi,
        "townhouse"@sv .

