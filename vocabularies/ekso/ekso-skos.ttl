yso:p18173 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2004-03-18"^^xsd:date ;
    skos:altLabel "undersökande inlärning"@sv ;
    skos:broader yso:p2945 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q7248847>,
        allars:Y30059,
        ysa:Y130224 ;
    skos:inScheme ekso: ;
    skos:note "Tarkoittaa sellaista oppimista, jossa tietoja ei omaksuta valmiina opettajalta tai oppikirjasta, vaan oppija ohjaa omaa oppimistaan asettamalla ongelmia, muodostamalla omia käsityksiään ja selityksiään sekä hakemalla tietoa itsenäisesti ja rakentelemalla näin syntyneestä tiedosta laajempia kokonaisuuksia"@fi,
        "Lärande där information inte anammas i färdig form från lärare eller läroböcker, utan där den som lär sig styr sitt eget lärande genom att ställa upp problem, bilda egna uppfattningar och förklaringar, samt söka information självständigt och bygga upp vidare helheter av den informationen."@sv ;
    skos:prefLabel "investigative learning"@en,
        "tutkiva oppiminen"@fi,
        "dutki oahppan"@sme,
        "undersökande lärande"@sv ;
    skos:related yso:p38876 .

