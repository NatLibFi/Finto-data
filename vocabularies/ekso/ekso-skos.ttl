yso:p29887 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2005-06-16"^^xsd:date ;
    skos:altLabel "monisolistikonsertot"@fi,
        "neloiskonsertot"@fi,
        "viitoiskonsertot"@fi,
        "yhtyekonsertot"@fi ;
    skos:broader yso:p10246 ;
    skos:closeMatch allars:Y51951,
        ysa:Y214634 ;
    skos:definition "Orkesterisäestyksellinen konsertto, joissa on vähintään neljä soolosoitinta, mutta joka ei ole varsinainen concerto grosso. Pelkistä soolosoittimista (tai soolosoittimista ja continuosta) koostuvista konsertoista käytetään käsitettä kamarikonsertot. Tärkeitä ryhmäkonserttojen säveltäjiä ovat olleet mm. Fasch, Heinichen, Telemann ja Vivaldi."@fi,
        "Konsert med orkesterackompanjemang, i vilken minst fyra soloinstrument ingår, men som inte är en egentlig concerto grosso. Om konserter som består av enbart soloinstrument (eller soloinstrument och continuo) används begreppet kammarkonserter. Viktiga kompositörer av gruppkonserter är t.ex. Fasch, Heinichen, Telemann och Vivaldi."@sv ;
    skos:hiddenLabel "group concerto"@en,
        "monisolistikonsertto"@fi,
        "neloiskonsertto"@fi,
        "ryhmäkonsertto"@fi,
        "viitoiskonsertto"@fi,
        "yhtyekonsertto"@fi,
        "gruppkonsert (kompositioner)"@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "group concertos"@en,
        "ryhmäkonsertot"@fi,
        "gruppkonserter (kompositioner)"@sv ;
    skos:related yso:p30040,
        yso:p30064,
        yso:p30118 ;
    yso-meta1:singularAltLabel "monisolistikonsertto"@fi,
        "neloiskonsertto"@fi,
        "viitoiskonsertto"@fi,
        "yhtyekonsertto"@fi ;
    yso-meta1:singularPrefLabel "group concerto"@en,
        "ryhmäkonsertto"@fi,
        "gruppkonsert (kompositioner)"@sv .

yso:p29894 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2005-06-16"^^xsd:date ;
    skos:altLabel "RnB"@en,
        "r&b"@en,
        "RnB"@fi,
        "nyky-r&b"@fi,
