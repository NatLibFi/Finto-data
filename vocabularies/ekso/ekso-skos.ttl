yso:p30142 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:altLabel "pentatoninen säveljärjestelmä"@fi ;
    skos:broader yso:p12382 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2002002627>,
        allars:Y51969,
        ysa:Y214723 ;
    skos:definition "Viidestä sävelestä koostuvaan asteikkoon perustuva säveljärjestelmä, joka on yleinen eurooppalaisessa kansanmusiikissa, mutta myös monissa ei-eurooppalaisissa kulttuureissa ja mm. antiikin Kreikassa. Viisisäveljärjestelmät muodostuvat joko pelkistä kokosävelaskelista (antihemitoninen) tai myös puolisävelaskelista (hemitoninen)."@fi,
        "Tonsystem som grundar sig på en skala bestående av fem toner, och som är vanlig i europeisk folkmusik, men också i många icke-europeiska kulturer och bl.a. i antikens Grekland."@sv ;
    skos:hiddenLabel "pentatonic scale"@en ;
    skos:inScheme ekso: ;
    skos:prefLabel "pentatonic scales"@en,
        "viisisäveljärjestelmä"@fi,
        "pentatonalaš skálá"@sme,
        "pentatonik"@sv ;
    yso-meta1:singularPrefLabel "pentatonic scale"@en .

yso:p30143 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:broader yso:p3064 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh99012468>,
        <http://www.wikidata.org/entity/Q606089>,
        allars:Y51975,
        ysa:Y214661 ;
    skos:definition "Yhdysvalloissa käyttöön otettu nimitys jazzmusiikille, jossa kokoonpanossa oli sellaisia omatekoisia soittimia, kuten pesulauta ja paperilla päällystetty kampa. Nimityksen ottivat käyttöön myös eräät Isossa-Britanniassa 1950-luvulla syntyneet yhtyeet, jotka yhdistivät musiikissaan jazzia, bluesia ja folkia."@fi,
        "Musikgenre med influenser av jazz, blues och folk. Ursprungligen togs benämningen i bruk för ensemblen med hemmagjorda instrument, såsom tvättbräden."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "skiffle"@en,
        "skiffle"@fi,
        "skiffle"@sme,
        "skiffle"@sv .

