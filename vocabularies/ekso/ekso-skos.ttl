    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh98003471>,
        allars:Y52205,
        ysa:Y216500 ;
    skos:definition "Alkuperältään ranskalainen, kolmijakoinen kansantanssi, joka tuli jo 1600-luvulla hovikäyttöön, muuntuen 1700-luvulla itsenäiseksi sävellykseksi sekä sarjojen, sinfonioiden ja muiden laajempien sävellysten vakituiseksi osaksi."@fi,
        "Till sitt ursprung fransk folkdans i tretakt, som togs i bruk vid hov redan på 1600-talet och som omvandlades till en självständig komposition på 1700-talet samt en etablerad del av sviter, sinfonier och andra större kompositioner."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "minuet (dances)"@en,
        "menuetti (tanssit)"@fi,
        "menuehtta (dánssat)"@sme,
        "menuett (danser)"@sv .

