yso:p18883 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2000-02-14"^^xsd:date ;
    skos:broader yso:p15608 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85032419>,
        <http://www.wikidata.org/entity/Q36155>,
        allars:Y42180,
        ysa:Y112745 ;
    skos:inScheme ekso: ;
    skos:note "Koptin kieli on egyptin kielen myöhäisin muoto, jota Egyptin kristityt käyttivät puhe- ja kirjakielenään 100-luvulla jKr. Koptin kieltä kirjoitetaan kreikkalaisin kirjaimin. Arabialaisten valloitettua Egyptin 640-641 koptin kieli alkoi puhekielenä väistyä arabian kielen tieltä, ja 900-luvulta lähtien koptin kieltä on käytetty lähes yksinomaan liturgisena kielenä."@fi,
        "Den senaste formen av egyptiska, som de kristna i Egypten använde som tal- och skriftspråk på 100-talet e.Kr. Efter arabernas erövring av Egypten år 640-641 avtog användningen av koptiska som talspråk och fr.o.m. 900-talet används koptiska nästan enbart som liturgiskt språk."@sv ;
    skos:prefLabel "Coptic language"@en,
        "koptin kieli"@fi,
        "koptigiella"@sme,
        "koptiska"@sv .

