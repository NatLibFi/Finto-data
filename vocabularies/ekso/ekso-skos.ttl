        allars:Y43314,
        ysa:Y182869 ;
    skos:inScheme ekso: ;
    skos:note "A scientific theory that describes the large-scale motions of Earth's lithosphere."@en,
        "Teoria, joka selittää mannerlaattojen liikkeen mekanismia ja liikkeen vaikutuksia."@fi,
        "Teori som förklarar mekanismen bakom kontinentalplattornas rörelse och rörelsens effekter."@sv ;
    skos:prefLabel "plate tectonics"@en,
        "laattatektoniikka"@fi,
        "plattektonik"@sv ;
    skos:related yso:p21654,
