        <http://www.wikidata.org/entity/Q483352>,
        allars:Y51941,
        ysa:Y214700 ;
    skos:definition "1980-luvulla syntynyt heavy metallin tyyli, joka on luonteeltaan erittäin perkussiivista ja aggressiivista. Varsinkin alkuaikoina tyyli oli nopeatempoista ja hyvin lähellä speed metal -tyyliä. Tunnettuja edustajia ovat Anthrax, Slayer ja Megadeth."@fi,
        "Undergenre till heavy metal som uppkom på 1980-talet och som till sin karaktär är mycket perkussiv och aggressiv, särskilt i början med snabbt tempo och mycket nära speed metal-stilen. Kända företrädare är t.ex. Anthrax, Slayer och Megadeth."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "trash metal"@en,
        "thrash metal"@fi,
        "thrash metal"@sme,
        "thrash metal"@sv ;
    skos:related yso:p20679,
        yso:p26907,
        yso:p29836,
        yso:p29914 .

yso:p29914 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2005-04-25"^^xsd:date ;
    skos:broader yso:p15521 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q211723>,
        allars:Y51940,
        ysa:Y214677 ;
    skos:definition "1980-luvun alussa Yhdysvalloissa syntynyt erittäin nopea ja teknisesti vaativa heavy rockin tyyli, joka on saanut vahvoja vaikutteita punk rockista. Tunnettuja edustajia ovat olleet Anthrax, Megadeth, Metallica (varhainen), Slayer ja suomalainen Stone."@fi,
        "Metalgenre med mycket snabbt tempo som är tekniskt krävande och starkt influerad av punkrock, uppkommen i början 1980-talet i USA. Kända företrädare av stilen har varit Anthrax, Megadeth, Metallica (tidig produktion), Slayer och finländska Stone."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "speed metal"@en,
        "speed metal"@fi,
        "speed metal"@sme,
        "speed metal"@sv ;
    skos:related yso:p20679,
        yso:p26907,
        yso:p29836,
        yso:p29912 .

