yso:p29637 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2017-04-03"^^xsd:date ;
    skos:altLabel "hardcorepunk"@fi,
        "hc punk"@fi,
        "hardcore (punk)"@sv,
        "hc punk"@sv ;
    skos:broader yso:p29762 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2003002059>,
        <http://www.wikidata.org/entity/Q10922>,
        allars:Y51369,
        ysa:Y504977 ;
    skos:definition "Punk rockista 1970-luvun lopusta lähtien kehittynyt nopeatempoisempi ja aggressiivisempi alalaji. Hardcore punkin sanoituksissa otetaan usein kantaa yhteiskunnallisiin aiheisiin vastustaen esimerkiksi militarismia, auktoriteetteja ja väkivaltaa. Paino on yleensä enemmän rytmissä kuin melodiassa ja laulu on usein huutavaa tai karjuvaa. Kitaraosuudet ovat toisinaan monitahoisia, teknisesti vaativia ja rytmillisesti haasteellisia. Kokoonpanossa on tyypillisesti laulajan ja säröisen kitaran lisäksi bassokitara ja rummut."@fi,
        "Underart till punkrock som utvecklats sedan slutet av 1970-talet och som har snabbare rytm och aggressivare uttryck."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "hardcore punk music"@en,
        "hardcore punk"@fi,
        "hardcore punk"@sme,
        "hardcorepunk"@sv ;
    skos:related yso:p38076 .

