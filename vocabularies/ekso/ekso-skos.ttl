yso:p27970 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2014-06-12"^^xsd:date ;
    skos:altLabel "dancehall reggae"@fi,
        "ragga"@fi,
        "raggamuffin"@fi,
        "dancehall reggae"@sme,
        "ragga"@sme,
        "raggamuffin"@sme,
        "dancehall reggae"@sv,
        "ragga"@sv,
        "raggamuffin"@sv ;
    skos:broader yso:p2968 ;
    skos:closeMatch allars:Y46659,
        ysa:Y199292 ;
    skos:definition "1980-luvun alussa Jamaikalla syntynyt reggaen laji, jonka tunnusomaisena piirteenä on DJ:n puhelaulu (toasting) yksinkertaisen konetaustan päälle. Tyyliä alettiin kutsua 1990-luvulla termillä raggamuffin (tai ragga), mutta alkuperäinen termi on sittemmin otettu uudelleen käyttöön. Tunnettuja edustajia ovat Yellowman, Elephant Man, Buju Banton, Sizzla ja Cutty Ranks."@fi,
        "Genre inom reggae, som uppkom på Jamaica i början av 1980-talet och som kännetecknas av en dj:s talsång (toasting) ovanpå en enkel maskinbakgrund. Stilen började kallas för raggamuffin eller ragga på 1990-talet, men senare har den ursprungliga termen åter tagits i bruk. Kända representanter är Yellowman, Elephant Man, Buju Banton, Sizzla och Cutty Ranks."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "dancehall (dance)"@en,
        "dancehall"@fi,
        "dancehall"@sme,
        "dancehall"@sv ;
    skos:related yso:p28047 .

