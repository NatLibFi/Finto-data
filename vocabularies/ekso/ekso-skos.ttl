yso:p25273 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2011-06-22"^^xsd:date ;
    skos:broader yso:p127 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q497592>,
        allars:Y41542,
        ysa:Y180293 ;
    skos:inScheme ekso: ;
    skos:note "Modaalinen realismi on ontologinen näkemys, jonka mukaan mahdolliset maailmat ovat yhtä todellisia kuin aktuaalinen maailma. Se perustuu ennen kaikkea seuraaviin ajatuksiin: mahdolliset maailmat ovat olemassa, ne eivät ole lajiltaan erilaisia kuin aktuaalinen maailma, niitä ei voida palauttaa muihin entiteetteihin, ja termi \"aktuaalinen\" on aktuaalisten maailmojen tapauksessa indeksikaalinen."@fi,
        "Ontologiskt synsätt, enligt vilket alla möjliga världar är lika verkliga som den aktuella världen."@sv ;
    skos:prefLabel "modal realism"@en,
        "modaalinen realismi"@fi,
        "modála realisma"@sme,
        "modal realism"@sv ;
    skos:related yso:p1055 .

