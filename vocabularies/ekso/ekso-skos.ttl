eksometa:Concept a owl:Class ;
    rdfs:label "EKSO Concept"@en,
        "EKSO-käsite"@fi,
        "EKSO-begrepp"@sv ;
    rdfs:subClassOf skos:Concept,
        eksometa:Class .

