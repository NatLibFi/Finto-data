yso:p26738 a skos:Concept,
        yso-meta1:Concept ;
    dc:source "FinMeSH; Lääketieteen termit"@fi ;
    dct:created "2012-08-21"^^xsd:date ;
    skos:altLabel "Unverricht-Lundborgin tauti"@fi,
        "epilepsia myoclonica progressiva"@fi,
        "progressiv myoklonusepilepsi"@sv ;
    skos:broader yso:p26226,
        yso:p28721 ;
    skos:closeMatch allars:Y45143,
        ysa:Y187670 ;
    skos:inScheme ekso: ;
    skos:note "Genetic epilepsy disorder that onsets in children between the ages of 6 and 15. The disease is characterized by tonic-clonic seizures,  myoclonic jerks, ataxia, dysarthria and mood swings. Most cases originate from the Baltic region of Europe."@en,
        "Suomalaiseen tautiperintöön kuuluva peittyvästi periytyvä epilepsia, jolle ovat ominaisia 6-15 vuoden iässä alkavat grand mal -kohtaukset ja myokloniset nykäykset, liikuntavaikeudet, dysartria ja mielialan heilahtelut"@fi,
        "Genetisk epileptisk sjukdom som hör till det finländska sjukdomsarvet och i vilken ingår epileptiska anfall som börjar i 6-15 års ålder, myokloniska ryck, rörelsesvårigheter, dysartri och humörsvängningar."@sv ;
    skos:prefLabel "Unverricht–Lundborg disease"@en,
        "Unverricht–Lundborgin oireyhtymä"@fi,
        "Unverricht-Lundborg syndroma"@sme,
        "Unverricht–Lundborgs sjukdom"@sv .

