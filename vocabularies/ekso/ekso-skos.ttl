yso:p30024 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:altLabel "trance (musik)"@sv ;
    skos:broader yso:p29932 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2006000812>,
        <http://www.wikidata.org/entity/Q170435>,
        allars:Y52233,
        ysa:Y214705 ;
    skos:definition "Hypnoottisia ääni- ja rytmikulkuja hyödyntävä teknomusiikin alalaji, jolle on luonteenomaista muuttumaton ja tasajakoinen (4/4) rytmitausta, jota jäsentävät lyhyet, toistuvat synetisaattoriteemat ja ajoittaiset atmosfääriset sointivärit. Tunnettuja edustajia ovat Joey Beltram, CJ Bolland, DJ Orkidea, Hardfloor ja Sven Väth. Lähempänä tavanomaista popmusiikkia ovat esimerkiksi Ian Van Dahl, Lasgo ja Darude."@fi,
        "Undergenre till technomusik med hypnotiska ton- och rytmföljder, för vilken en statisk och jämnfördelad (4/4) rytmbakgrund som struktureras av korta upprepade syntteman och periodiska atmosfäriska klangfärger, är karakteristisk. Kända företrädare är t.ex. Joey Beltram, CJ Bolland, DJ Orkidea, Hardfloor och Sven Väth. Närmare den vanliga popmusiken är t.ex. Ian Van Dahl, Lasgo och Darude."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "trance (electronic dance music)"@en,
        "trance"@fi,
        "trance"@sme,
        "trance"@sv ;
    skos:related yso:p12377,
        yso:p14614,
        yso:p29901 .

