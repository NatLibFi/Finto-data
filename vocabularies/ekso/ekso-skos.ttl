yso:p26341 a skos:Concept,
        yso-meta1:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-04-24"^^xsd:date ;
    skos:broader yso:p1051 ;
    skos:closeMatch allars:Y44510,
        ysa:Y185615 ;
    skos:inScheme ekso: ;
    skos:note "Kirchenkampf (English: \"church struggle\") is a German term pertaining to the situation of the Christian churches in Germany during the Nazi period (1933–1945)."@en,
        "Tarkoittaa Saksan natsihallinnolle myötämielisen Deutsche Christen-liikkeen sekä sitä vastaan taistelleen protestanttisen kirkkokunnan, Tunnustuskirkon (Bekennende Kirche) välistä kamppailua."@fi,
        "Avser kampen mellan Deutsche Christen-rörelsen som var anhängare till det tyska naziststyret och det protestantiska samfundet Bekännelsekyrkan (Bekennende Kirche) som var emot det."@sv ;
    skos:prefLabel "kirchenkampf"@en,
        "kirkkotaistelu"@fi,
        "girkodáistaleapmi"@sme,
        "kyrkokamp"@sv ;
    skos:related yso:p12596 .

