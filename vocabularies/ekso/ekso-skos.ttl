yso:p19380 a skosext:DeprecatedConcept,
        skos:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    dct:isReplacedBy yso:p5171 ;
    owl:deprecated true ;
    skos:broadMatch yso:p5171 ;
    skos:closeMatch allars:Y28681,
        ysa:Y100173 ;
    skos:inScheme ekso:deprecatedconceptscheme ;
    skos:note "Concept in use between 1986 and 1995. For earlier, see [http://www.yso.fi/onto/yso/p19381]."@en,
        "Nimitys käytössä v. 1986-1995. Vesi- ja ympäristöhallinnon edeltäjä oli vesihallinto (1970-1986). Vesi- ja ympäristöhallinto sulautui ympäristöhallintoon ja maa- ja metsätaloushallintoon vuonna 1995, jolloin vesi- ja ympäristähallitus lakkautettiin ja sen tehtävät siirrettiin suurimmaksi osaksi Suomen ympäristökeskukselle."@fi,
        """Begreppet användes 1986-1995. Före det användes begreppet
[http://www.yso.fi/onto/yso/p19381].  Vatten- och miljöförvaltning uppgick i miljöförvaltning och jord- och skogsbruksförvaltning 1995."""@sv ;
    skos:prefLabel "water and environmental administration"@en,
        "vesi- ja ympäristöhallinto"@fi,
        "vatten- och miljöförvaltning"@sv ;
    skos:relatedMatch yso:p19381 ;
    skos:scopeNote "deprecated on 2021-05-29" ;
    skos:topConceptOf ekso:deprecatedconceptscheme .

