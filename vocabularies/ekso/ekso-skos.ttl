    skos:broader yso:p40486 ;
    skos:closeMatch allars:Y41394,
        ysa:Y174332 ;
    skos:definition "Kulttuurihistoriallinen rakennus Lappeenrannassa; keisari Aleksanteri III ja keisarinna Maria Fedorovna majoitettiin taloon Lappeenrannan vierailuillaan 1885 ja 1891. Talon kunnostuksen toteutti tuolloin arkkitehti Jac. Ahrenberg. Alkuperäinen talo tuhoutui tulipalossa 1929. Paikalle valmistui 1930 Lars Sonckin suunnittelema rakennus."@fi,
        "Kulturhistorisk byggnad i Villmanstrand."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "Fontell house (Lappeenranta)"@en,
        "Fontellin talo (Lappeenranta)"@fi,
        "Fontell dállu (Lappeenranta)"@sme,
        "Fontells hus (Villmanstrand)"@sv .

