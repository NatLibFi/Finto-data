yso:p25776 a skos:Concept,
        yso-meta1:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-03-01"^^xsd:date ;
    skos:altLabel "antiikin tutkimus"@fi,
        "antikvetenskap"@sv ;
    skos:broader yso:p183 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q841090>,
        allars:Y43390,
        ysa:Y184595 ;
    skos:inScheme ekso: ;
    skos:narrower yso:p25952 ;
    skos:note "A multidisciplinary field focusing on the history and culture of the ancient Mediterranean world up until the early Middle Ages."@en,
        "Tieteidenvälinen tutkimusala, jonka kohteena ovat antiikin historia ja kulttuuri niiden kaikissa ilmenemismuodoissa. Antiikilla tarkoitetaan tässä yhteydessä yleensä niin sanottua klassista antiikkia eli antiikin Kreikkaa ja Roomaa sekä näiden kulttuurien vaikutuspiiriin joutuneita alueita keskiajan kynnykselle asti"@fi,
        "Tvärvetenskapligt forskningsområde som undersöker antikens historia och kultur i alla dess uttrycksformer. Med antiken avses i detta sammanhang den s.k. klassiska antiken, alltså antikens Grekland och Rom samt områden som kommit under dessa kulturers inflytande, fram till tidig medeltid."@sv ;
    skos:prefLabel "classical studies"@en,
        "antiikintutkimus"@fi,
        "antihkkadutkamuš"@sme,
        "antikforskning"@sv ;
    skos:related yso:p11348 .

