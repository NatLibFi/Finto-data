yso:p20145 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2002-02-19"^^xsd:date ;
    skos:altLabel "vägledande utbildning"@sv ;
    skos:broader yso:p84 ;
    skos:closeMatch allars:Y43322,
        ysa:Y117616 ;
    skos:inScheme ekso: ;
    skos:note "Ohjaava koulutus auttaa työelämän muutosvaiheessa olevia nuoria ja aikuisia löytämään suunnan urallaan tai hahmottamaan uusia toimintavaihtoehtoja itselleen. Henkilökohtaisen ja ryhmäohjauksen sekä työharjoittelun ja/tai ammatilliseen koulutukseen tutustumisen avulla opiskelijat laativat työmarkkinasuunnitelman. Tavoitteena on sellaisten ajatus- ja toimintamallien tuottaminen, joka auttaa yksilöitä itsenäisiin ratkaisuihin työelämän ja koulutusjärjestelmän muutoksissa"@fi,
        "Utbildning som hjälper unga och vuxna som befinner sig i ett förändringsskede i arbetslivet att hitta en riktning för sin karriär och att utforma nya handlingsalternativ för sig själv. Genom personlig och grupphandledning samt arbetspraktik och/eller orientering i yrkesutbildning sammanställer de studerande en arbetsmarknadsplan. Målsättningen är att frambringa sådana tanke- och handlingsmodeller som hjälper individer att göra självständiga lösningar under förändringar i arbetsliv och utbildningssystem."@sv ;
    skos:prefLabel "career counselling courses"@en,
        "ohjaava koulutus"@fi,
        "orienterande utbildning"@sv ;
    skos:related yso:p19421,
        yso:p39211 .

