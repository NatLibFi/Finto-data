yso:p25441 a skos:Concept,
        yso-meta1:Concept ;
    dc:source "http://www.martinkeitel.net/tietoinensydan/2011/dietrich.htm"@fi ;
    dct:created "2011-10-05"^^xsd:date ;
    skos:altLabel "cosmomusiikki"@fi,
        "kosmomusiikki"@fi,
        "cosmoterapi"@sv ;
    skos:broader yso:p392 ;
    skos:closeMatch allars:Y50259,
        ysa:Y181656 ;
    skos:inScheme ekso: ;
    skos:note "Kosmoterapia on moniaistinen terapiamuoto, joka hyödyntää eri aisteja sekä luovaa yhdessäoloa. Terapian kehitti saksalainen Dietrich Gümbel, ja se perustuu hänen kokemukseensa hoidoista yrttiöljyillä ja tutkimuksiin värien, sävelten ja kivien vaikutuksista ihmiskehoon."@fi,
        "Behandlingsform utvecklad av Dietrich Gümbel, som grundar sig på behandling med örtoljor och på färgers, toners och stenars inverkan på kroppen."@sv ;
    skos:prefLabel "cosmomusic"@en,
        "kosmoterapia"@fi,
        "kosmoterapiija"@sme,
        "kosmoterapi"@sv .

