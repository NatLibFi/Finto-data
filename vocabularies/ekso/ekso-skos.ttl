        "koulukoti"@fi,
        "skuvlaruoktu"@sme ;
    skos:inScheme ekso: ;
    skos:note "Concept in use from 1946 onwards. For previous use, see [http://www.yso.fi/onto/yso/p14131]."@en,
        "Nimitys käytössä vuodesta 1946 lähtien, aiemmat katso [http://www.yso.fi/onto/yso/p14131]."@fi,
