        <http://www.wikidata.org/entity/Q211745>,
        allars:Y15522,
        ysa:Y100911 ;
    skos:definition "Atonaalisessa musiikissa ei ole tonaalista keskusta eikä sävelten välisiä hierarkkisia suhteita."@fi,
        "I atonal musik finns inget tonalt centrum eller några hierarkiska relationer mellan toner."@sv ;
    skos:inScheme ekso: ;
    skos:prefLabel "atonality"@en,
        "atonaalisuus"@fi,
        "atonalitet"@sv ;
    skos:related yso:p12381,
