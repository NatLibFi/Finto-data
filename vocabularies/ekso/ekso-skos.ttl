yso:p227 a skos:Concept,
        yso-meta1:Concept ;
    dct:created "2004-10-13"^^xsd:date ;
    skos:altLabel "kirkon yhteiskunnallinen työ"@fi,
        "yhteiskunnallinen työ"@fi,
        "samhällsarbete (kyrkligt arbete)"@sv ;
    skos:broader yso:p229 ;
    skos:closeMatch allars:Y30462,
        ysa:Y133786 ;
    skos:inScheme ekso: ;
    skos:note "Tarkoittaa seurakuntatyön muotoa, jonka avulla tuetaan seurakuntalaisia elämään omassa arkiympäristössään, työssä, kotona ja vapaa-aikana. Yhteiskuntatyön menetelmiä ovat yhdyskuntatyö, henkilökohtaiset keskustelut, ryhmätoiminta, aikuiskasvatus, yhteistyö järjestöjen, työpaikkojen, työttömien ja muiden syrjäytymisvaarassa olevien, maahanmuuttajien sekä yhteiskunnan laitosten kanssa."@fi,
        "Avser form av församlingsarbete, med vilket man stöder församlingsmedlemmarnas liv i deras egna vardagsmiljö, arbete, hemma och på fritiden. Metoder för arbetet är socialt arbete, personliga samtal, gruppverksamhet, vuxenutbildning, samarbete med föreningar, arbetsplatser arbetslösa, invandrare och andra med risk för marginalisering, samt andra samhällsinstitutioner."@sv ;
    skos:prefLabel "church community work"@en,
        "yhteiskuntatyö"@fi,
        "servodatbargu"@sme,
        "kyrkans samhällsarbete"@sv ;
    skos:related yso:p228 .

