    foaf:homepage <https://www.eduskunta.fi/kirjasto/EKS/> .

ekso-meta:Concept a owl:Class;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "EKSO-käsite"@fi, 
        "EKSO-begrepp"@sv, 
        "EKSO Concept"@en .

ekso-meta:Hierarchy a owl:Class;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Hierarchical EKSO concept"@en, 
        "Hierarkisoiva EKSO-käsite"@fi, 
        "Hierarkiserande EKSO-begrepp"@sv .

yso-meta:Concept a owl:Class;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "YSO-käsite"@fi,
        "ALLFO-begrepp"@sv,
        "YSO Concept"@en .
