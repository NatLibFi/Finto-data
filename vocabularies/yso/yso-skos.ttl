yso:p15915 a skos:Concept,
        ysometa:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    dct:modified "2023-02-08"^^xsd:date ;
    skos:broader yso:p10544 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q1090674> ;
    skos:definition "Länsimaisen taidemusiikin esittämiseen alun perin tarkoitettu yli yhdeksän hengen esityskokoonpano, jonka soittimisto koostuu jousisoittimista (voi sisältää continuon ja muutamia lyömäsoittimia). 1900-luvulta alkaen kokoonpanoa on käytetty runsaasti myös populaarimusiikissa."@fi,
        "Ensemble ursprungligen avsedd för framförande av västerländsk konstmusik, bestående av över nio personer med stråkinstrument (kan innehålla continuo och några slaginstrument). Fr.o.m. 1900-talet har besättningen använts rikligt även i populärmusik."@sv ;
    skos:exactMatch allars:Y26999,
        koko:p528,
        ysa:Y101958 ;
    skos:hiddenLabel "string orchestra"@en,
        "jousiorkesteri"@fi,
        "stråkorkester"@sv ;
    skos:inScheme yso: ;
    skos:note "Jos orkesterissa on mukana myös muihin soitinryhmiin kuuluvia soittimia, mutta kyseessä ei ole täysimittainen sinfoniaorkesteri, käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p10544'>kamariorkesterit</a>."@fi,
        "Om orkestern också består av instrument ur andra instrumentgrupper, men det inte är frågan om en fullständig sinfoniorkester, används begreppet <a href='http://www.yso.fi/onto/yso/p10544'>kammarorkestrar</a>."@sv ;
    skos:prefLabel "string orchestras"@en,
        "jousiorkesterit"@fi,
        "stråkorkestrar"@sv ;
    ysometa:singularPrefLabel "string orchestra"@en,
        "jousiorkesteri"@fi,
        "stråkorkester"@sv .

