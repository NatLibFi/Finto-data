yso:p558 a skos:Concept,
        ysometa:Concept ;
    dc:source "Source: Wikipedia"@en,
        "Lähde: Biologian sanakirja"@fi ;
    dct:created "1993-02-25"^^xsd:date ;
    dct:modified "2023-11-09"^^xsd:date ;
    skos:altLabel "biotoopit"@fi,
        "elinympäristö (biologia)"@fi,
        "biotoper"@sv,
        "livsmiljö (biologi)"@sv ;
    skos:broader yso:p14074 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q175208> ;
    skos:exactMatch allars:Y16142,
        koko:p37354,
        ysa:Y107031 ;
    skos:inScheme yso: ;
    skos:narrower yso:p2328 ;
    skos:note "Biotope is an area of uniform environmental conditions providing a living place for a specific assemblage of plants and animals."@en,
        "Tarkoittaa eliöiden kasvupaikkaa tai elinympäristöä yleisesti. Biotooppi on elinympäristö, jossa tärkeimmät ympäristötekijät ovat samankaltaisia ja jonka sisäinen rakenne on yhtenäinen. Biotooppi kertoo ennakko-oletuksesta, että joku alue on tietylle lajille, yksilölle tai populaatiolle mahdollinen elinympäristö. Biotooppi luokittelee ympäristöä eikä perustu laji- tai yksilöhavaintoihin"@fi,
        "Ekologisk term för ett område eller utrymme som karaktäriseras av vissa yttre faktorer. Biotopen är den yttre världen i vilken ett visst växt- eller djursamhälle hör hemma, och det är biotopens egenskaper som bestämmer vilket samhälle som kommer att finnas där."@sv ;
    skos:prefLabel "biotope"@en,
        "biotooppi"@fi,
        "biotohpa"@se,
        "biotop"@sv ;
    skos:related yso:p11017,
        yso:p20751,
        yso:p4636,
        yso:p4997,
        yso:p5678,
        yso:p634 .

