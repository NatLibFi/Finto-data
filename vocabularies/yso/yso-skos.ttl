yso:p15389 a skos:Concept,
        ysometa:Concept ;
    dct:created "2002-11-29"^^xsd:date ;
    dct:modified "2024-01-23"^^xsd:date ;
    skos:altLabel "ekologiskt avtryck"@sv,
        "ekologiskt fotspår"@sv ;
    skos:broader yso:p21210 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q234173> ;
    skos:exactMatch allars:Y17245,
        koko:p15431,
        ysa:Y121919 ;
    skos:inScheme yso: ;
    skos:note "Ekologisen jalanjäljen avulla voidaan arvioida missä mitassa luonnonvarojen käyttö ja päästöt vaikuttavat elolliseen luontoon. Se kertoo kuinka paljon ekologisesti tuottavaa maata eli viljelymaata, laidunta, metsää, rakennettua maata ja energiankulutuksen vaatimaa maa-alaa tarvitaan resurssien  tuottamiseen ja samalla sulauttamaan takaisin luontoon päästöt ja jätteet. Mittaa ihmisen toiminnan vaikutusta elolliseen luontoon hehtaareina."@fi,
        "Sätt att utvärdera i vilken grad t.ex. en individs förbrukning av naturresurser och utsläpp eller avfall påverkar den levande naturen."@sv ;
    skos:prefLabel "ecological footprint"@en,
        "ekologinen jalanjälki"@fi,
        "ekologalaš juolgeluodda"@se,
        "ekologiskt fotavtryck"@sv ;
    skos:related yso:p12186,
        yso:p39970,
        yso:p41122 .

