yso:p1882 a skos:Concept,
        ysometa:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    dct:modified "2024-08-28"^^xsd:date ;
    skos:altLabel "rohkka"@se,
        "rockmusik"@sv ;
    skos:broader yso:p2969 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85114675>,
        <http://www.wikidata.org/entity/Q11399> ;
    skos:definition "Yhdysvalloissa rock and rollista ja mustan musiikin muodoista kehittynyt popmusiikin laji, joka on levinnyt kaikkialle maailmassa erääksi suosituimmista populaarimusiikin tyyliryhmistä. Rock-musiikille on ominaista suhteellisen nopea tempo, toisen ja neljännen tahdinosan korostaminen (back beat) ja yksinkertainen, sähköinen esityskokoonpano (sähkökitarat, sähköbasso, rummut). 1900-luvun toisella puoliskolla syntyi suuri määrä rockin muunnelmia, joiden määritelmällinen erottaminen toisistaan on usein erittäin vaikeaa."@fi,
        "Populärmusikalisk genre som utvecklats i USA ur rock and roll och svart musik och sedan spridit sig i hela världen som en av de mest populära stilarna. Karakteristiskt för rockmusik är relativt snabbt tempo, betoning av den andra och fjärde taktdelen (back beat) och enkel, elektrisk musikalisk besättning (elgitarrer, elbas, trummor). Under andra delen av 1900-talet uppkom en stor mängd olika varianter av rock, som med avseende på definition är svåra att avskilja från varandra."@sv ;
    skos:exactMatch allars:Y25261,
        koko:p3873,
        ysa:Y98616 ;
    skos:inScheme yso: ;
    skos:narrower yso:p10250,
        yso:p10995,
        yso:p15274,
        yso:p15521,
        yso:p17581,
        yso:p1881,
        yso:p19827,
        yso:p21503,
        yso:p27390,
        yso:p28632,
        yso:p29226,
        yso:p29762,
        yso:p29778,
        yso:p29858,
        yso:p29904,
        yso:p29926,
        yso:p30039,
        yso:p30084,
        yso:p30108,
        yso:p30129,
        yso:p37978,
        yso:p38010,
        yso:p38041,
        yso:p39342,
        yso:p41190,
        yso:p5499 ;
    skos:prefLabel "rock music"@en,
        "rock"@fi,
        "rock"@se,
        "rock (musik)"@sv ;
