yso:p37935 a skos:Concept,
        ysometa:Concept ;
    dct:created "2018-05-24"^^xsd:date ;
    dct:modified "2023-08-08"^^xsd:date ;
    skos:altLabel "lääkehoidon turvallisuus"@fi,
        "turvallinen lääkehoito"@fi,
        "läkemedelstrygghet"@sv ;
    skos:broader yso:p2726 ;
    skos:definition "Lääketurvallisuus liittyy lääkeaineeseen ja -valmisteeseen. Siihen kuuluvat lääkkeen ominaisuuksien ja vaikutusten tunteminen, lääkkeen laadukas valmistusprosessi ja lääkkeeseen liittyvä informaatio."@fi,
        "Läkemedelssäkerhet gäller själva läkemedlet och -preparatet. Till läkemedelssäkerhet hör kännedom om läkemedlets egenskaper och verkningar, en kvalitativ tillverkningsprocess för läkemedlet och information i samband med läkemedlet. Om säkerhet i behandling med läkemedel avses används begreppet <a href='http://www.yso.fi/onto/yso/p37961'>medicineringssäkerhet</a>."@sv ;
    skos:exactMatch allars:Y52607,
        koko:p81390,
        ysa:Y359368 ;
    skos:inScheme yso: ;
    skos:prefLabel "drug safety"@en,
        "lääketurvallisuus"@fi,
        "dálkkasdorvvolašvuohta"@se,
        "läkemedelssäkerhet"@sv ;
    skos:related yso:p19936,
        yso:p24295,
        yso:p37961 .

