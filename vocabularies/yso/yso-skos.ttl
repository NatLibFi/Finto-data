yso:p25769 a skos:Concept,
        ysometa:Concept ;
    dc:source "http://www.ihmisoikeudet.net/index.php?page=sopimukset-turvaamaan-oikeuksia"@fi ;
    dct:created "2012-03-06"^^xsd:date ;
    dct:modified "2020-04-02"^^xsd:date ;
    skos:altLabel "kolmannen sukupolven oikeudet"@fi,
        "solidaarisuusoikeudet"@fi,
        "solidaritetsrättigheter"@sv ;
    skos:broader yso:p152 ;
    skos:exactMatch allars:Y43448,
        koko:p63788,
        ysa:Y184729 ;
    skos:hiddenLabel "third-generation human right"@en,
        "kolmannen polven oikeus"@fi,
        "kolmannen sukupolven oikeus"@fi,
        "solidaarisuusoikeus"@fi,
        "solidaritetsrättighet"@sv ;
    skos:inScheme yso: ;
    skos:note "Third-generation human rights are those rights that go beyond the mere civil and social, as expressed in many progressive documents of international law, including the 1972 Stockholm Declaration of the United Nations Conference on the Human Environment, the 1992 Rio Declaration on Environment and Development, and other pieces of generally aspirational \"soft law.\""@en,
        "Kolmannen polven oikeuksien lähtökohtana on YK:n peruskirjan periaate kansojen itsemääräämisoikeudesta. Lisäksi lähtökohtana on ihmisoikeuksien julistuksessa mainittu jokaisen oikeus sellaiseen yhteiskunnalliseen ja kansainväliseen järjestykseen, jossa ihmisoikeudet voivat toteutua. Kolmannen polven oikeuksiin kuuluvat esim. oikeus  kehitykseen, rauhaan ja puhtaaseen ympäristöön"@fi,
        "Utgångspunkten för den tredje generationens rättigheter är FN-stadgans princip om folkens självbestämmanderätt. Därtill även envars rätt till sådan samhällelig och internationell ordning i vilka mänskliga rättigheter kan förverkligas, vilken nämns i deklarationen om mänskliga rättigheter. Till tredje generationens rättigheter hör också rätt till utveckling, fred och ren miljö."@sv ;
    skos:prefLabel "third-generation human rights"@en,
        "kolmannen polven oikeudet"@fi,
        "tredje generationens rättigheter"@sv ;
    skos:related yso:p2402 ;
    ysometa:singularAltLabel "kolmannen sukupolven oikeus"@fi,
        "solidaarisuusoikeus"@fi,
        "solidaritetsrättighet"@sv ;
    ysometa:singularPrefLabel "third-generation human right"@en,
        "kolmannen polven oikeus"@fi .

