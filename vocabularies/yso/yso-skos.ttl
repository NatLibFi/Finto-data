yso:p26249 a skos:Concept,
        ysometa:Concept ;
    dct:created "2012-04-24"^^xsd:date ;
    dct:modified "2020-09-05"^^xsd:date ;
    skos:altLabel "aktiivinen sairausloma"@fi,
        "osa-aikainen sairausloma"@fi,
        "osa-aikasairausloma"@fi,
        "osasairausloma"@fi,
        "deltidssjukledighet"@sv ;
    skos:broader yso:p570 ;
    skos:exactMatch allars:Y44469,
        koko:p69949,
        ysa:Y185658 ;
    skos:inScheme yso: ;
    skos:note "Osasairausvapaan tarkoituksena on tukea pitkän ajan sairauden vuoksi työstä poissa olleen  työntekijän oma-aloitteista työhön paluuta. Kannustimena työhön paluuseen on, että asianomaisella on mahdollisuus kokeilla työhön palaamista ennen työkyvyttömyysajan päättymistä työskentelemällä osa-aikaisesti ja saada samalla osa-aikapalkan lisäksi muita taloudellisia etuuksia."@fi,
        "Avsikten med partiell sjukledighet är att stöda en arbetstagares återgång till arbetet efter en längre tids frånvaro p.g.a. sjukdom. Återgången till arbetet sporras av att arbetstagaren har möjlighet att pröva på att arbeta igen innan arbetsoförmögenhetstiden slutar, genom att arbeta deltid och samtidigt utöver deltidslönen också få andra ekonomiska förmåner."@sv ;
    skos:prefLabel "partial sick leave"@en,
        "osasairausvapaa"@fi,
        "partiell sjukledighet"@sv ;
    skos:related yso:p19776,
        yso:p21652,
        yso:p6982 .

