yso:p26219 a skos:Concept,
        ysometa:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-04-24"^^xsd:date ;
    dct:modified "2026-05-27"^^xsd:date ;
    skos:altLabel "Saracen people"@en ;
    skos:broader yso:p487 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q105763> ;
    skos:exactMatch allars:Y44575,
        koko:p69571,
        ysa:Y185683 ;
    skos:hiddenLabel "Saracen"@en,
        "saraseeni"@fi,
        "saracen"@sv ;
    skos:inScheme yso: ;
    skos:note "Rooman valtakunnan alkuaikoina saraseeneiksi kutsuttiin Siinailla asuvan arabiheimon jäseniä. Myöhemmin Rooman valtakunnan alaiset kreikkalaiset laajensivat termin kattamaan kaikki arabit, sekä Pyreneiden niemimaan valloituksen aikana myös berberit. Ristiretkien aikana sanan käyttö laajeni koskemaan kaikkia muslimeja ja erityisesti Apenniinien niemimaan eteläosien ja Sisilian muslimeja."@fi,
        "I början av Romarska rikets tid kallades medlemmar av en arabstam som bodde i Sinai för saracener. Senare utvidgade grekerna under Romerska riket termen till att omfatta alla araber, samt under erövringen av Pyreneiska halvön även berberna. Under korstågens tid utvidgades användningen av ordet till att omfatta alla muslimer och särskilt muslimerna på Apenninska halvöns södra delar och på Sicilien."@sv ;
    skos:prefLabel "Saracens"@en,
        "saraseenit"@fi,
        "saracener"@sv ;
    skos:related yso:p14797,
        yso:p5314 ;
    ysometa:singularPrefLabel "Saracen"@en,
        "saraseeni"@fi,
        "saracen"@sv .

