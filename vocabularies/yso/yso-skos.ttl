yso:p14131 a skos:Concept,
        ysometa:Concept ;
    dct:created "2002-12-02"^^xsd:date ;
    dct:modified "2023-12-20"^^xsd:date ;
    rdau:P60686 yso:p14132 ;
    skos:altLabel "uppfostringshem"@sv ;
    skos:broader yso:p8577 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85112239>,
        <http://www.wikidata.org/entity/Q10709884> ;
    skos:definition "Kasvatuslaitoksia alettiin perustaa 1800-luvulla. Laitoksiin sijoitettiin tuomioistuinten päätöksillä 7–14-vuotiaita lapsia ja laitokset toimivat vankeinhoitohallituksen alaisina. Kasvatuslaitosten nimet muutettiin koulukodeiksi vuonna 1946, kun rangaistuslaitosten maineesta pyritiin eroon."@fi,
        "Uppfostringsanstalter började grundas på 1800-talet. I dessa anstalter placerades barn i åldern 7-14 på basis av domstolsbeslut och anstalterna fungerade under fångvårdsstyrelsen. Uppfostringsanstalternas namn ändrades till skolhem år 1946 då man försökte frånkomma ryktet som straffanstalter."@sv ;
    skos:exactMatch allars:Y42058,
        koko:p18952,
        ysa:Y121972 ;
    skos:hiddenLabel "reformatory"@en,
        "kasvatuslaitos"@fi,
        "bajásgeassinásahus"@sme,
        "uppfostringsanstalt"@sv ;
    skos:inScheme yso: ;
    skos:note "Concept in use until 1946. For later use, see <a href='http://www.yso.fi/onto/yso/p14132'>reform schools</a>."@en,
        "Vuodesta 1946 alkaen käytetty nimitystä <a href='http://www.yso.fi/onto/yso/p14132'>koulukodit</a>"@fi,
        "Sedan 1946 används begreppet <a href='http://www.yso.fi/onto/yso/p14132'>skolhem</a>"@sv ;
    skos:prefLabel "reformatories"@en,
        "kasvatuslaitokset"@fi,
        "bajásgeassinásahusat"@se,
        "uppfostringsanstalter"@sv ;
    skos:related yso:p14129 ;
    ns12:prefLabel <http://www.yso.fi/onto/yso/p14131#sme_1> ;
    ysometa:singularPrefLabel "reformatory"@en,
        "kasvatuslaitos"@fi,
        "bajásgeassinásahus"@sme,
        "uppfostringsanstalt"@sv .

yso:p14132 a skos:Concept,
        ysometa:Concept ;
    dct:created "1986-07-01"^^xsd:date ;
    dct:modified "2023-02-08"^^xsd:date ;
    rdau:P60683 yso:p14131 ;
    skos:altLabel "ungdomsvårdsskolor"@sv ;
    skos:broader yso:p8577 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85112239>,
        <http://www.wikidata.org/entity/Q4781751> ;
    skos:definition "Lastensuojelulaitos, jossa annetaan kasvatusta, hoitoa ja perusopetusta ja siihen liittyvää muuta opetusta sekä ammatillista koulutusta sellaisille lastensuojelulain perusteella sosiaalilautakunnan huostaan otetuille lapsille ja nuorille henkilöille, joita ei voida tarkoituksenmukaisesti kasvattaa ja hoitaa perhehoidossa, lastenkodissa tai muussa lastensuojelulaitoksessa."@fi,
        "Barnskyddsenheter för krävande vård av barn och unga utanför hemmet och krävande särskilt stöd inom grundläggande utbildning."@sv ;
    skos:exactMatch allars:Y26126,
        koko:p5493,
        ysa:Y96399 ;
    skos:hiddenLabel "reform school"@en,
        "koulukoti"@fi,
        "skuvlaruoktu"@sme ;
    skos:inScheme yso: ;
    skos:note "Concept in use from 1946 onwards. For previous use, see <a href='http://www.yso.fi/onto/yso/p14131'>reformatories</a>."@en,
        "Nimitys käytössä vuodesta 1946 lähtien, aiemmat katso <a href='http://www.yso.fi/onto/yso/p14131'>kasvatuslaitokset</a>."@fi,
        "Benämningen i bruk sedan 1946, för tidigare se  <a href='http://www.yso.fi/onto/yso/p14131'>uppfostringsanstalter</a>. I Sverige används benämningen ungdomsvårdsskola."@sv ;
    skos:prefLabel "reform schools"@en,
        "koulukodit"@fi,
        "skuvlaruovttut"@se,
        "skolhem"@sv ;
    skos:related yso:p14129 ;
    ysometa:singularPrefLabel "reform school"@en,
        "koulukoti"@fi,
        "skuvlaruoktu"@sme .

