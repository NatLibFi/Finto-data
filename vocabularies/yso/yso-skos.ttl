yso:p20679 a skos:Concept,
        ysometa:Concept ;
    dct:created "2009-11-20"^^xsd:date ;
    dct:modified "2023-03-30"^^xsd:date ;
    skos:broader yso:p15521 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh99000162>,
        <http://www.wikidata.org/entity/Q132438> ;
    skos:definition "1980-luvun lopulla thrash metal -tyylistä kehittynyt heavy metalin soittoteknisesti yksinkertainen alalaji, jolle ovat ominaisia nopea, aggressiivinen soittotapa ja korkeaääninen, kirskuva laulutapa. Sanoitusten aihepiiri liittyy usein uskonnollisiin ilmiöihin ja mytologioihin. Tyypillisiä edustajia ovat Darkthrone, Bathory, Venom ja Emperor."@fi,
        "Underart till heavy metal som utvecklades på slutet av 1980-talet ur trash metal. Präglas av snabb och aggressiv instrumentstil och ett skrikande sångsätt i högt tonläge. Texternas tema relaterar ofta till religiösa fenomen och mytologier. Typiska företrädare är Darkthrone, Bathory, Venom och Emperor."@sv ;
    skos:exactMatch allars:Y39173,
        koko:p48903,
        ysa:Y169576 ;
    skos:inScheme yso: ;
    skos:prefLabel "black metal"@en,
        "black metal"@fi,
        "black metal"@se,
        "black metal"@sv ;
    skos:related yso:p26907,
        yso:p29836,
        yso:p29912,
        yso:p29914 .

