    skos:hiddenLabel "Ingrian"@en,
        "Ingrian Finn"@en,
        "inkeriläinen"@fi,
        "inkerinsuomalainen"@fi,
        "inkerilaš"@sme,
        "ingermanlänning"@sv ;
    skos:inScheme yso: ;
    skos:note "The Finnish population of Ingria that descends from Lutheran Finnish immigrants who moved into the area in the 17th century. For the Finnic people native to Ingria, who traditionally speak the Ingrian language, use <a href='http://www.yso.fi/onto/yso/p20725'>Izhorians</a>."@en,
        "Tarkoittaa Suomesta etenkin 1600-luvulla Inkeriin siirtyneitä suomalaisia. Alkuperäisestä itämerensuomalaisesta, perinteisesti inkeroisen kieltä puhuvasta väestöstä käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p20725'>inkerikot</a>."@fi,
        "Folkgrupp som härstammar från den finska invandringen till Ingermanland under främst 1600-talet. Om det ursprungliga östersjöfinska folket i Ingermanland, som talade ingriska, används begreppet <a href='http://www.yso.fi/onto/yso/p20725'>ingrer</a>."@sv ;
    skos:prefLabel "Ingrians"@en,
        "inkeriläiset"@fi,
        "inkerilaččat"@se,
        "ingermanlänningar"@sv ;
    skos:related yso:p12667,
        yso:p20725,
        yso:p9533,
        yso:p9534 ;
    ysometa:singularAltLabel "Ingrian Finn"@en,
        "inkerinsuomalainen"@fi ;
    ysometa:singularPrefLabel "Ingrian"@en,
        "inkeriläinen"@fi,
        "inkerilaš"@sme,
        "ingermanlänning"@sv .

