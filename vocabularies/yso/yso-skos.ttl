yso:p26924 a skos:Concept,
        ysometa:Concept ;
    dc:source "http://www.terapiapalvelutmyotatuuli.fi/html/kehityspsykoterpia.html"@fi ;
    dct:created "2013-04-09"^^xsd:date ;
    dct:modified "2020-09-15"^^xsd:date ;
    skos:altLabel "DDP"@fi,
        "Dyadic Developmental Psychotherapy"@fi,
        "DDP"@sv ;
    skos:broader yso:p2587 ;
    skos:exactMatch allars:Y50326,
        koko:p69722,
        ysa:Y192121 ;
    skos:inScheme yso: ;
    skos:note "Erityisesti monitraumatisoituneiden, huostaanotettujen lasten ja nuorten hoitoon tarkoitettu psykoterapia, jossa huomiota kiinnitetään varsinkin kiintymyssuhteen rakentamiseen ja vahvistamiseen lapsen ja hänen uuden hoitajansa (esim. sijaisvanhemmat, perhekodin omahoitaja tms.) välillä. Hoitaja osallistuu terapiatapaamisiin ja tarjoaa lapselle siten konkreettisen turvan myös tarapian kontekstissa. Myös sijaiskasvattajan ja terapeutin tapaamisen ovat keskeisessä asemassa."@fi,
        "Form av psykoterapi som är avsedd för vård av traumatiserade och omhändertagna barn och ungdomar, och som fokuserar särskilt på byggandet och stärkandet av en anknytningsrelation mellan barnet och dess nya vårdare."@sv ;
    skos:prefLabel "dyadic developmental psychotherapy"@en,
        "vuorovaikutteinen kehityspsykoterapia"@fi,
        "dyadic developmental psychotherapy"@sv .

