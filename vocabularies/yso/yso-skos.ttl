yso:p22463 a skos:Concept,
        ysometa:Concept ;
    dct:created "2008-05-27"^^xsd:date ;
    dct:modified "2023-02-08"^^xsd:date ;
    skos:broader yso:p2969 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q4390945> ;
    skos:definition "Rautalankamusiikki on erityisesti Isossa-Britanniassa (The Shadows) 1950-luvun lopulla syntynyttä instrumentaalista rockia, jota soitetaan sähkökitaroilla, bassokitaralla ja rummuilla. Suomessa tyylistä innostuttiin 1960-luvulla ja suomalaiselle tyyliä edustavalle musiikille annettiin nimeksi rautalankamusiikki. Läheinen ilmiö surfmusiikki on pääosin yhdysvaltalainen ilmiö."@fi,
        "Instrumental rock som uppkom i slutet av 1950-talet, särskilt i Storbritannien (The Shadows), och som spelas med elgitarrer, basgitarrer och trummor. I Finland blev stilen populär på 1960-talet. Den näraliggande surfmusiken är i huvudsak ett amerikanskt fenomen."@sv ;
    skos:exactMatch allars:Y36283,
        koko:p71938,
