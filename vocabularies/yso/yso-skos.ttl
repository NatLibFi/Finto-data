yso:p14300 a skos:Concept,
        ysometa:Concept ;
    dc:source "http://fi.wikipedia.org/wiki/Sadutus"@fi ;
    dct:created "2002-02-20"^^xsd:date ;
    dct:modified "2023-02-08"^^xsd:date ;
    skos:altLabel "saduttaminen"@fi,
        "barns sagoberättande"@sv ;
    skos:broader yso:p14 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q11891895> ;
    skos:exactMatch allars:Y15757,
        koko:p15374,
        ysa:Y117647 ;
    skos:inScheme yso: ;
    skos:note "Narratiivinen menetelmä, jossa uusi tarina syntyy vapaasti muotoutuen kertojan ja saduttajan välillä. Saduttaja kirjaa kerrotun tarinan sellaisenaan muistiin ja lukee sen kertojalle, joka voi halutessaan vielä tehdä muutoksia ja korjauksia. Menetelmää voi soveltaa eri-ikäisten parissa erilaisissa ympäristöissä."@fi,
        "En metod där barn får berätta för vuxna och de vuxna lyssnar och antecknar utan att lägga sig i och föreslå. Texten läses sedan högt och berättaren kan göra ändringar."@sv ;
    skos:prefLabel "storycrafting method"@en,
        "sadutus"@fi,
        "sagotering"@sv .

