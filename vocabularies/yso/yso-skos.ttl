yso:p28047 a skos:Concept,
        ysometa:Concept ;
    dct:created "2014-06-12"^^xsd:date ;
    dct:modified "2023-02-08"^^xsd:date ;
    skos:altLabel "regueton"@fi ;
    skos:broader yso:p2969 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q202930> ;
    skos:definition "Popmusiikin laji, joka tuli suosituksi 1990-luvun lopulla latinalaisamerikkalaisen nuorison keskuudessa. Se syntyi Panamassa nimellä reggae en espanol ja on levinnyt erityisesti Puerto Ricoon, Yhdysvaltoihin ja Eurooppaan 2000-luvun alkupuolelta lähtien. Reggaeton sekoittaa jamaikalaisia musiikkivaikutteita (reggaeta ja dancehallia) latinalaisen Amerikan bomba-, plena- sekä hip hop -musiikkeihin. Reggaetoniin yhdistetään yleensä espanjankielistä räppäystä."@fi,
        "Popmusikgenre som blev populär bland den latinamerikanska ungdomen i slutet av 1990-talet. Reggaeton uppstod i Panama med namnet reggae en espanol, och har spridit sig särskilt till Puerto Rico, USA och Europa fr.o.m. början av 2000-talet. I reggaeton blandas jamaikanska musikinfluenser (reggae och dancehall) med de latinamerikanska bomba-, plena-, och hiphopstilarna. Reggaeton sammankopplas vanligen med rap på spanska."@sv ;
    skos:exactMatch allars:Y46661,
        koko:p73478,
        ysa:Y199290 ;
    skos:inScheme yso: ;
    skos:prefLabel "reggaeton"@en,
        "reggaeton"@fi,
        "reggaeton"@se,
        "reggaeton"@sv ;
    skos:related yso:p14336,
        yso:p14614,
        yso:p180,
        yso:p27970,
        yso:p2968 .

