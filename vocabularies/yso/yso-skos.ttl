yso:p16674 a skos:Concept,
        ysometa:Concept ;
    dc:source "Lähde: Taloussanasto"@fi ;
    dct:created "2000-02-16"^^xsd:date ;
    dct:modified "2024-01-23"^^xsd:date ;
    skos:broader yso:p250 ;
    skos:exactMatch allars:Y17902,
        koko:p10390,
        ysa:Y112090 ;
    skos:hiddenLabel "financing system"@en,
        "rahoitusjärjestelmä"@fi,
        "ruhtadanvuogádat"@sme ;
    skos:inScheme yso: ;
    skos:note "Tarkoittaa kansantalouden mekanismeja, jotka siirtävät rahoituspääomat sektorilta toiselle. Rahoituksen välitykseen osallistuvat pankit ja muut luottolaitokset sekä pääomamarkkinat, joilla tapahtuu lähinnä joukkovelkakirjojen ja osakkeiden kauppa."@fi,
        "Avser nationalekonomiska mekanismer som förflyttar finansieringskapital från en sektor till en annan. I förmedling av finansiering deltar banker och andra kreditinstitut samt kapitalmarknader, på vilka närmast handel med masskuldebrev och aktier bedrivs."@sv ;
    skos:prefLabel "financing systems"@en,
        "rahoitusjärjestelmät"@fi,
        "ruhtadanvuogádagat"@se,
        "finansieringssystem"@sv ;
    ysometa:singularPrefLabel "financing system"@en,
        "rahoitusjärjestelmä"@fi,
        "ruhtadanvuogádat"@sme .

