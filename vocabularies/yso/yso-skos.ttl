yso:p26223 a skos:Concept,
        ysometa:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-04-24"^^xsd:date ;
    dct:modified "2024-03-02"^^xsd:date ;
    skos:altLabel "sophism"@en,
        "sofismi"@fi,
        "sofisma"@se,
        "sofism"@sv,
        "sofisterna"@sv,
        "sofistik"@sv ;
    skos:broader yso:p418 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85125278>,
        <http://www.wikidata.org/entity/Q166955>,
        <http://www.wikidata.org/entity/Q3750514> ;
    skos:exactMatch allars:Y44576,
        koko:p14114,
        ysa:Y185687 ;
    skos:hiddenLabel "sophist"@en,
        "sofisti"@fi,
        "sofista"@sme,
        "sofist"@sv ;
    skos:inScheme yso: ;
    skos:note "Sofistit olivat antiikin Kreikassa kierrelleitä viisauden opettajia, jotka harjoittivat paljon dialektiikkaa ja opettivat maksua vastaan retoriikkaa ja muita taitoja, joita vapaat miehet tarvitsivat voidakseen osallistua poliittiseen elämään. Sofistit voidaan lukea esisokraatikkojen joukkoon."@fi,
        "Vishetslärare i antikens Grekland som utövade dialektik och lärde mot betalning ut retorik och andra färdigheter som fria män behövde för att kunna delta i det politiska livet. Sofisterna kan räknas till de försokratiska tänkarna."@sv ;
    skos:prefLabel "sophists"@en,
        "sofistit"@fi,
        "sofisttat"@se,
        "sofister"@sv ;
    ysometa:singularPrefLabel "sophist"@en,
        "sofisti"@fi,
        "sofista"@sme,
        "sofist"@sv .

