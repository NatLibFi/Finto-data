yso:p4483 a skos:Concept,
        ysometa:Concept ;
    dct:created "2001-01-04"^^xsd:date ;
    dct:modified "2023-03-23"^^xsd:date ;
    skos:altLabel "rhythm and blues"@en,
        "rhythm & blues"@sv,
        "rhythm-and-blues"@sv ;
    skos:broadMatch <http://id.loc.gov/authorities/subjects/sh85113834> ;
    skos:broader yso:p3064 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q45981> ;
    skos:definition "Yhdysvalloissa 1940- ja 1950-luvuilla kukoistanut bluesiin ja big band -jazziin pohjautuva musiikkityyli, jossa puhallinsoittimilla ja blues-tyylisellä laululla oli keskeinen asema. Tyylin tunnettuja edustajia ovat mm. T-Bone Walker, Louis Jordan ja Big Joe Turner. Tyyli on kokenut 1960-luvulta lähtien uuden suosion."@fi,
        "Musikstil som blomstrade i USA särskilt på 1940-1950-talet och som grundar sig på blues och big band-jazz. Blåsinstrument och bluespräglad sång har en en central ställning i musiken. Kända företrädare av stilen är bl.a. T-Bone Walker, Louis Jordan och Big Joe Turner."@sv ;
    skos:exactMatch allars:Y25201,
        koko:p4523,
        ysa:Y113414 ;
    skos:inScheme yso: ;
    skos:note "Nykyaikaisesta rhythm and blues -musiikista käytetään käsitettä  <a href='http://www.yso.fi/onto/yso/p29894'>r&b</a>."@fi,
        "Om modern rhythm and blues-musik används begreppet <a href='http://www.yso.fi/onto/yso/p29894'>r&b</a>."@sv ;
    skos:prefLabel "rhythm and blues music"@en,
        "rhythm and blues"@fi,
        "rhythm and blues"@se,
        "rhythm and blues"@sv ;
    skos:related yso:p29776,
        yso:p29783,
        yso:p29890,
        yso:p29894,
        yso:p29946,
        yso:p4482 .

