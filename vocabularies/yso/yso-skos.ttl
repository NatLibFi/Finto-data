yso:p19199 a skos:Concept,
        ysometa:Concept ;
    dct:created "1993-05-05"^^xsd:date ;
    dct:modified "2023-03-31"^^xsd:date ;
    skos:broader yso:p38078 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh87003427>,
        <http://www.wikidata.org/entity/Q213121> ;
    skos:definition "New age -liikkeen myötä kehittynyt musiikkityyli, joka perustuu selkeään tonaaliseen rakenteeseen. Siinä on vähän dynaamisia vaihteluita, runsaasti syntetisaattorilla tuotettuja ääniä, usein musiikkiin yhdistettynä erilaisia luonnonääniä, ja julkaisujen sekä kappaleiden nimissä viitataan usein mystiikkaan, mytologiaan, luontoon, mielenrauhaan, mietiskelyyn jne."@fi,
        "Musikstil som utvecklats i samband med new age-rörelsen och som bygger på en tydlig tonal struktur. Stilen präglas av sparsamma dynamiska växlingar, rikligt med ljud som skapats med syntetisator, ofta olika naturljud som kombinerats med musiken, och hänvisningar till mystik, mytologi, natur, sinnesro, meditation etc. i namnen på musikstyckena."@sv ;
    skos:exactMatch allars:Y23496,
        koko:p13581,
        ysa:Y107427 ;
    skos:inScheme yso: ;
    skos:prefLabel "new age music"@en,
        "new age -musiikki"@fi,
        "new age -musihkka"@se,
        "new age-musik"@sv ;
    skos:related yso:p29942,
        yso:p29953 .

