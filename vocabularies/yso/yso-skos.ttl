yso:p5678 a skos:Concept,
        ysometa:Concept ;
    dc:source "Source: Wikipedia"@en,
        "Lähde: Biologian sanakirja"@fi ;
    dct:created "1999-02-22"^^xsd:date ;
    dct:modified "2023-08-11"^^xsd:date ;
    skos:altLabel "elinympäristö (biologia)"@fi,
        "habitaatit"@fi,
        "livsmiljö (biologi)"@sv ;
    skos:broader yso:p14074 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh00005995>,
        <http://www.wikidata.org/entity/Q52105> ;
    skos:exactMatch allars:Y19261,
        koko:p8913,
        ysa:Y111794 ;
    skos:inScheme yso: ;
    skos:note "An ecological or environmental area that is inhabited by a particular species of animal, plant, or other type of organism. It is the natural environment in which an organism lives, or the physical environment that surrounds a species population."@en,
        "Tarkoittaa tietyn eliölajin tai siihen kuuluvan yksilön tai populaation tyypillistä elinympäristöä tai ainutkertaista esiintymispaikkaa tai -aluetta. Habitaatti luonnehditaan usein dominoivien kasvien tai paikan fysikaalisten ominaisuuksien mukaan, esim. metsä, havumetsä, lehdon lehvästö, puro jne."@fi,
        "Avser livsmiljö eller unik förekomstplats eller -område för en viss organismart, individ eller population av denna. Habitat karakteriseras ofta enligt dominerande växtlighet eller platsens fysikaliska egenskaper, t.ex. skog, barrskog, lund, lövskog, bäck etc."@sv ;
    skos:prefLabel "habitat"@en,
        "habitaatti"@fi,
        "habitáhtta"@se,
        "habitat"@sv ;
    skos:related yso:p11017,
        yso:p20751,
        yso:p27164,
        yso:p4636,
        yso:p4997,
        yso:p558,
        yso:p634 .

