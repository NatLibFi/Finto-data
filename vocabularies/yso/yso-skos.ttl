        "institutsofficer"@sv ;
    skos:inScheme yso: ;
    skos:note "Concept in use from 1989 onwards. For earlier, use <a href='http://www.yso.fi/onto/yso/p7060'>warrant officers</a> (1974-1989) and <a href='http://www.yso.fi/onto/yso/p7061'>regular non-commisioned officers</a> (until 1974)."@en,
        "Nimitys käytössä vuodesta 1989 lähtien, aiemmat katso <a href='http://www.yso.fi/onto/yso/p7060'>toimiupseerit</a> (1974-1989) ja <a href='http://www.yso.fi/onto/yso/p7061'>kanta-aliupseerit</a> (vuoteen 1974)."@fi,
        "Termen används sedan 1989, tidigare användes termen <a href='http://www.yso.fi/onto/yso/p7060'>befattningsofficerare</a> (1974-1989) och termen <a href='http://www.yso.fi/onto/yso/p7061'>stamunderofficerare</a> (-1974)."@sv ;
    skos:prefLabel "warrant officers"@en,
        "opistoupseerit"@fi,
