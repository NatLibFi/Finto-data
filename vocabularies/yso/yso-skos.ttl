        koko:p17925,
        ysa:Y106174 ;
    skos:inScheme yso: ;
    skos:note "Public legal aid is provided by the state to a person who needs assistance in a legal matter and is unable to cover the expenses due to his or her finanical situation."@en,
        "Oikeusapua annetaan valtion varoin henkilölle, joka tarvitsee asiantuntevaa apua oikeudellisessa asiassa ja joka taloudellisen asemansa vuoksi ei kykene itse suorittamaan sen hoitamisen vaatimia menoja."@fi,
        "Rättshjälp ges med statliga medel till personer som behöver sakkunnig hjälp vid skötsel av juridiska ärenden och som p.g.a. sin ekonomiska ställning inte själva kan bekosta sådan."@sv ;
    skos:prefLabel "legal aid"@en,
        "oikeusapu"@fi,
        "riekteveahkki"@se,
        "rättshjälp"@sv ;
    skos:related yso:p13146,
        yso:p9198,
        yso:p9201 ;
    skos:scopeNote "In reference to aid by a court to another court or to a public authority use <a href='http://www.yso.fi/onto/yso/p12955'>executive assistance</a>."@en,
        "Tuomioistuimen toiselle tuomioistuimelle tai viranomaiselle antamasta avusta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p12955'>virka-apu</a>."@fi,
        "För den hjälp en domstol kan ge en annan domstol eller myndighet används begreppet <a href='http://www.yso.fi/onto/yso/p12955'>handräckning</a>."@sv ;
    ns12:prefLabel <http://www.yso.fi/onto/yso/p9200#sme_1> .

