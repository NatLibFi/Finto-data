allars:allars_juuri a rdfs:Resource .

ysometa:deprecatedHasPart a owl:ObjectProperty ;
    rdfs:domain ysometa2007:DeprecatedConcept .

ysometa:deprecatedHasPredecessor a owl:ObjectProperty ;
    rdfs:label "Deprecated has a predecessor"@en,
        "Käytöstä poistetulla on edeltäjä"@fi,
        "Utfasad har en företrädare"@sv ;
    rdfs:domain ysometa2007:DeprecatedConcept .

ysometa:deprecatedHasSuccessor a owl:ObjectProperty ;
    rdfs:label "Deprecated has a successor"@en,
        "Käytöstä poistetulla on seuraaja"@fi,
        "Utfasad har en efterträdare"@sv ;
    rdfs:domain ysometa2007:DeprecatedConcept .

ysometa:deprecatedPartOf a owl:ObjectProperty ;
    rdfs:domain ysometa2007:DeprecatedConcept .

ysometa:deprecatedSubClassOf a owl:ObjectProperty ;
    rdfs:domain ysometa2007:DeprecatedConcept .

ysometa:oldPrefLabel a owl:DatatypeProperty ;
    rdfs:label "old preferred label" ;
    rdfs:domain ysometa2007:Concept .

ysometa:singularAltLabel a owl:DatatypeProperty ;
    rdfs:label "singular entry term"@en,
        "ohjaustermin yksikkömuoto"@fi,
        "stivrentearbma ovttaidlogus"@se,
        "hänvisningsterm i singular"@sv ;
    rdfs:domain ysometa:Concept ;
    rdfs:subPropertyOf skos:hiddenLabel .

ysometa:singularPrefLabel a owl:DatatypeProperty ;
    rdfs:label "singular preferred term"@en,
        "käytettävän termin yksikkömuoto"@fi,
        "ávžžuhuvvon tearbma ovttaidlogus"@se,
        "föredragen term i singular"@sv ;
    rdfs:domain ysometa:Concept ;
    rdfs:subPropertyOf skos:hiddenLabel .

