yso:p13288 a skos:Concept,
        ysometa:Concept ;
    dct:created "1993-04-20"^^xsd:date ;
    dct:modified "2026-02-06"^^xsd:date ;
    skosext:partOf yso:p13285 ;
    skos:broader yso:p272,
        yso:p6818 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q313354> ;
    skos:exactMatch allars:Y19772,
        koko:p5533,
        ysa:Y107342 ;
    skos:hiddenLabel "jurisdictional district"@en,
        "kihlakunta"@fi,
        "gihligoddi"@sme,
        "härad"@sv ;
    skos:inScheme yso: ;
    skos:note "Lääniä pienempi valtion paikallisalue. Kihlakunta on alkuaan vastannut pitäjää, myöhemmin se on ollut mm. tuomarin virka-alue. Vuodesta 1945 vuoteen 1996 kihlakunta on ollut henkikirjoittajan toimialue. 1.12.1996 lähtien paikallishallinto on järjestetty kihlakunnittain, joita on 90"@fi,
        "Inom den statliga lokalförvaltningen följer häraderna efter länen. En härad var ursprungligen en socken och senare blev den bla. en domares tjänsteområde. Mellan 1945-1996 sköttes folkbok- föringen i häraderna. Från och med 1.12.1996 är den statliga lokalförvaltningen ordnad härads- vis. Antalet härader är 90."@sv ;
    skos:prefLabel "jurisdictional districts"@en,
        "kihlakunnat"@fi,
        "gihligottit"@se,
        "härader"@sv ;
    skos:related yso:p13285 ;
    ysometa:singularPrefLabel "jurisdictional district"@en,
        "kihlakunta"@fi,
        "gihligoddi"@sme,
        "härad"@sv .

