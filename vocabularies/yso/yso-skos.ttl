    skos:broadMatch <http://id.loc.gov/authorities/subjects/sh85113834> ;
    skos:broader yso:p2969 ;
    skos:definition "Popmusiikin tyylilaji, jossa on vaikutteita rhythm and bluesista, soulista, funkista ja hip hopista. R&B-musiikissa hyödynnetään tyypillisesti elektronisen tanssimusiikin elementtejä ja teknologiaa. Tunnettuja edustajia ovat mm. Michael Jackson, Beyoncé ja Rihanna."@fi,
        "Stilart inom popmusik med influenser av rhytm and blues, soul, funk och hiphop. I r&b-musik finns typiskt element av elektronisk dansmusik och teknologi. Kända representanter är bl.a. Michael Jackson, Beyoncé och Rihanna."@sv ;
    skos:exactMatch allars:Y51947,
        koko:p48965,
        ysa:Y214621 ;
    skos:inScheme yso: ;
    skos:note "Perinteisesta r&b-musiikista käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p4483'>rhythm and blues</a>."@fi,
        "Om traditionell r&b-musik används begreppet <a href='http://www.yso.fi/onto/yso/p4483'>rhythm and blues</a>."@sv ;
