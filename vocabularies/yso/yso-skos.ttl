yso:p24031 a skos:Concept,
        ysometa:Concept ;
    dct:created "2010-03-11"^^xsd:date ;
    dct:modified "2025-01-10"^^xsd:date ;
    skos:broader yso:p5007 ;
    skos:exactMatch allars:Y38865,
        koko:p57919,
        ysa:Y171548 ;
    skos:inScheme yso: ;
    skos:note "Tarkoittaa sellaista sirkusopetusta, jossa sirkus toimii välineenä uuden oppimiseen. Sosiaalinen sirkus opettaa itsenäisyyttä, parantaa itseluottamusta, antaa työkaluja sosiaaliseen  kanssakäymiseen, murtaa ennakkoluuloja ja opettaa iloa ja  elämänhallintataitoja. Sosiaalinen sirkus on sirkuksen soveltavaa käyttöä, esimerkiksi  erityisnuorisotyössä."@fi,
        "Cirkusundervisning i vilken cirkus fungerar som ett redskap för att lära sig nytt. Målsättningar kan vara att lära ut självständighet, förbättra självförtroende, ge redskap för socialt umgänge, bryta fördomar och lära ut glädje och livskompetens. Sådan tillämpning av cirkus används t.ex. inom specialungdomsarbete."@sv ;
    skos:prefLabel "social circus"@en,
        "sosiaalinen sirkus"@fi,
        "sosiála sirkus"@se,
        "social cirkus"@sv .

