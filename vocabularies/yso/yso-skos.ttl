yso:p16274 a skos:Concept,
        ysometa:Concept ;
    dct:created "2003-02-18"^^xsd:date ;
    dct:modified "2024-08-28"^^xsd:date ;
    skos:altLabel "Afghanistankriget"@sv,
        "Afghansk-sovjetiska kriget"@sv ;
    skos:broader yso:p1271 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85001522>,
        <http://www.wikidata.org/entity/Q83085> ;
    skos:exactMatch allars:Y46368,
        koko:p12970,
        ysa:Y123238 ;
    skos:inScheme yso: ;
    skos:note "Neuvostoliiton asevoimien tukeman Afganistanin hallituksen ja sitä vastustavien kapinallisten välinen sota 28.12.1979 alkaen. Tavoitteisiin pääsemättömät neuvostojoukot poistuivat maasta 1988-1989 YK:n valvonnassa. Sota jatkui sisällissotana. Taistelevat ryhmittymät allekirjoittivat maaliskuussa 1993 rauhansopimuksen Islamabadissa Pakistanissa, mutta sisällissota jatkui vielä islamilaisten ryhmien välillä."@fi,
        "Krig mellan Afghanistans styre stödd av sovjetiska styrkor och rebeller som motarbetade detta, från och med 28.12.1979. De sovjetiska styrkorna uppnådde inte sina mål och lämnade landet under FN:s övervakning 1988-1989. Kriget fortgick som inbördeskrig. De stridande grupperingarna undertecknade ett fredsavtal i Islamabad i Pakistan i mars 1993, men inbördeskriget fortgick ännu mellan islamistiska grupper."@sv ;
    skos:prefLabel "Soviet–Afghan War (1979-1989)"@en,
        "Afganistanin sota (1979-1989)"@fi,
        "Afghanistan soahti (1979-1989)"@se,
        "Afghanistankriget 1979-1989"@sv ;
    skos:related yso:p27437 .

