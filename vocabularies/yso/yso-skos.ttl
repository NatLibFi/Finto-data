yso:p39929 a skos:Concept,
        ysometa:Concept ;
    dct:created "2023-03-13"^^xsd:date ;
    dct:modified "2023-06-10"^^xsd:date ;
    skos:altLabel "fetichism (religion)"@en ;
    skos:broader yso:p38135 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85047960>,
        <http://www.wikidata.org/wiki/Q182116> ;
    skos:exactMatch koko:p94463 ;
    skos:inScheme yso: ;
    skos:prefLabel "fetishism (religion)"@en,
        "fetisismi (uskonto)"@fi,
        "fetisisma (oskkoldat)"@se,
        "fetischism (religion)"@sv ;
    skos:related yso:p1015,
        yso:p1017,
        yso:p39932,
        yso:p6426 ;
    skos:scopeNote "Refers to a belief in the supernatural power of an object or objects. For sexual fetishism, use <a href='http://www.yso.fi/onto/yso/p14324'>fetishism (sexuality)</a>. For fetishism in Marxian sociology and economics, use <a href='http://www.yso.fi/onto/yso/p39932'>commodity fetichism</a>."@en,
        "Tarkoittaa uskomusta tietyn objektin tai objektien yliluonnolliseen voimaan. Seksuaalisesta fetisismistä käytä käsitettä <a href='http://www.yso.fi/onto/yso/p14324'>fetisismi (seksuaalisuus)</a>. Marxilaisen yhteiskunta- ja talousteorian yhteydessä käytä käsitettä <a href='http://www.yso.fi/onto/yso/p39932'>hyödykefetisismi</a>."@fi,
        "Avser tro på magisk kraft hos vissa föremål. Om sexuell fetischism används begreppet <a href='http://www.yso.fi/onto/yso/p14324'>fetischism (sexualitet)</a>. I samband med marxistisk samhälls- och ekonomisk teori används begreppet <a href='http://www.yso.fi/onto/yso/p39932'>varufetischism</a>."@sv .

