yso:p26407 a skos:Concept,
        ysometa:Concept ;
    dc:source "Määritelmä muokattu laista ”Laki valvontarangaistuksesta”."@fi ;
    dct:created "2012-06-07"^^xsd:date ;
    dct:modified "2024-06-06"^^xsd:date ;
    skos:broader yso:p1287 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q5488446> ;
    skos:exactMatch allars:Y44659,
        koko:p69569,
        ysa:Y186440 ;
    skos:inScheme yso: ;
    skos:note "Valvontarangaistus on ehdottoman vankeusrangaistuksen sijasta tuomittava rangaistus, jonka suorittamista valvotaan erilaisilla keinoilla. Tuomittua valvotaan hänen asuntoonsa asennettavilla, tuomitun haltuun annettavilla taikka tuomitun ylle ranteeseen, nilkkaan tai vyötärölle kiinnitettävillä teknisillä välineillä taikka tällaisten välineiden yhdistelmällä."@fi,
        "Straff som kan utdömas i stället för ovillkorligt fängelsestraff och som innebär att den dömda övervakas med tekniska medel som placeras i dennas bostad, i den dömdas besittning och/eller på dennas kropp."@sv ;
    skos:prefLabel "monitoring sentence"@en,
        "valvontarangaistus"@fi,
        "gozihanráŋggáštus"@se,
        "övervakningsstraff"@sv .

