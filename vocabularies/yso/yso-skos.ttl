yso:p10926 a skos:Concept,
        ysometa:Concept ;
    dct:created "2005-05-19"^^xsd:date ;
    dct:modified "2023-01-20"^^xsd:date ;
    skos:altLabel "pop-rai"@fi ;
    skos:broader yso:p3064 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh97002100> ;
    skos:definition "1920-1930-luvulta peräisin oleva algerialainen populaarimusiikkityyli, joka tyypillisesti koostuu vuorottelevista lauletuista säkeistä ja gaspah-huilulla soitetuista välikkeistä."@fi,
        "Algerisk populärmusikstil som härstammar från 1920-1930-talet, och som typiskt består av alternerande sjungna verser och övergångar spelade med en typ av flöjt."@sv ;
    skos:exactMatch allars:Y35897,
        koko:p17340,
        ysa:Y138135 ;
    skos:inScheme yso: ;
    skos:note "Käsitettä ei käytetä soitinmusiikista eikä tarkoittamaan yleisemmin arabimaissa suosittuja laulutyylejä."@fi,
        "Begreppet används inte om instrumentalmusik, eller om sångstilar som mera allmänt är populära i arabländerna."@sv ;
    skos:prefLabel "raï"@en,
        "rai"@fi,
        "rai"@se,
        "rai"@sv ;
    skos:related yso:p29976,
        yso:p3065 .

