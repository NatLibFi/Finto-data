yso:p10544 a skos:Concept,
        ysometa:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    dct:modified "2024-03-12"^^xsd:date ;
    skos:broader yso:p5070 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85022426>,
        <http://www.wikidata.org/entity/Q2470540> ;
    skos:exactMatch allars:Y20536,
        koko:p9736,
        ysa:Y102142 ;
    skos:hiddenLabel "chamber orchestra"@en,
        "kamariorkesteri"@fi,
        "gámmárorkester"@sme,
        "kammarorkester"@sv ;
    skos:inScheme yso: ;
    skos:narrower yso:p15915 ;
    skos:prefLabel "chamber orchestras"@en,
        "kamariorkesterit"@fi,
        "gámmárorkesterat"@se,
        "kammarorkestrar"@sv ;
    skos:scopeNote "Kamariorkesterina pidetään esityskokoonpanoa, jossa on edustajia vähintään kahdesta soitinperheestä ja jossa on korkeintaan noin 25 soittajaa. Tätä suuremmista kokoonpanoista käytetään käsitteitä <a href='http://www.yso.fi/onto/yso/p5070'>orkesterit</a>, <a href='http://www.yso.fi/onto/yso/p19581'>sinfoniaorkesterit</a> ja <a href='http://www.yso.fi/onto/yso/p16416'>puhallinorkesterit</a>. Jos kokoonpanossa on vain jousisoittimia (lisäksi voi olla joitakin lyömäsoittimia), käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p15915'>jousiorkesterit</a>."@fi,
        "Besättning i vilken ingår representanter från minst två instrumentfamiljer och med högst ca 25 instrumentalister. Om besättningar som är större än så används begreppen <a href='http://www.yso.fi/onto/yso/p5070'>orkestrar</a>, <a href='http://www.yso.fi/onto/yso/p19581'>symfoniorkestrar</a> och <a href='http://www.yso.fi/onto/yso/p16416'>blåsorkestrar</a>. Om ensembler med bara stråkinstrument (därtill kan det finnas några slaginstrument) används begreppet <a href='http://www.yso.fi/onto/yso/p15915'>stråkorkestrar</a>."@sv ;
    ysometa:singularPrefLabel "chamber orchestra"@en,
        "kamariorkesteri"@fi,
        "gámmárorkester"@sme,
        "kammarorkester"@sv .

