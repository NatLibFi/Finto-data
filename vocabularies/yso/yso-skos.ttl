yso:p11390 a skos:Concept,
        ysometa:Concept ;
    dc:source "Lähde: Kosmopolis vol.27:1/1997 (Riikka Lehdon artikkeli)"@fi ;
    dct:created "2001-01-05"^^xsd:date ;
    dct:modified "2023-02-08"^^xsd:date ;
    skos:broader yso:p7946 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q5683226> ;
    skos:exactMatch allars:Y22850,
        koko:p16750,
        ysa:Y113258 ;
    skos:hiddenLabel "environmental conflict"@en,
        "ympäristökonflikti"@fi,
        "biraskonflikta"@sme,
        "miljökonflikt"@sv ;
    skos:inScheme yso: ;
    skos:note "Ympäristökonflekteja on Jörgen Holstin mukaan kolmea eri tyyppiä: 1. Konflikti, joka tuhoaa ympäristöä. 2. Konflikti, joka on syntynyt ympäristöongelmien ja ympäristön tuhoutumisen takia. 3. Ympäristökonfliktiksi voidaan kutsua myös jostakin syystä jo olemassa olevaa konfliktia, joka syvenee ja laajenee, ja ympäristön saastuminen tai tuhoutuminen tulee lisätekijäksi."@fi,
        "Miljökonflikter kan indelas i tre typer: 1. Konflikt som förstör miljön. 2. Konflikt som uppstått pga. miljöproblem och miljöförstörelse. 3. Konflikt som redan existerar och som förvärras med miljöförorening och -förstörelse som tilläggsfaktor."@sv ;
    skos:prefLabel "environmental conflicts"@en,
        "ympäristökonfliktit"@fi,
        "biraskonflivttat"@se,
        "miljökonflikter"@sv ;
    ysometa:singularPrefLabel "environmental conflict"@en,
        "ympäristökonflikti"@fi,
        "biraskonflikta"@sme,
        "miljökonflikt"@sv .

