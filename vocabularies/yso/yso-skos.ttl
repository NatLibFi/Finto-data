yso:p29901 a skos:Concept,
        ysometa:Concept ;
    dct:created "1996-02-07"^^xsd:date ;
    dct:modified "2023-02-08"^^xsd:date ;
    skos:altLabel "ambient house"@en,
        "ambient house"@fi,
        "ambient house"@se,
        "ambient house"@sv ;
    skos:broader yso:p29932 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh97008974>,
        <http://www.wikidata.org/entity/Q20502> ;
    skos:definition "Elektronisen tanssimusiikin laji, joka kehittyi discomusiikista 1980-luvun alkupuolella.  Tyyli oli instrumentaalipainotteista, rytmi muuttui mekaanisemmaksi, bassotaajuudet  syvemmiksi, ja mukaan tuli vaikutteita mm. syntikkapopista, dub reggaesta, hip hopista ja jazzista. 1980-luvun loppupuolelta alkaen tyyli yleistyi ja sirpaloitui (mm. ambient house, acid house, deep house, epic house, hard house ja latino house). 1990-luvulla house-tyylistä  tuli popmusiikin valtavirtaan kuuluva ilmiö. Tunnettuja edustajia ovat olleet Basement Jaxx, Daft Punk, Larry Heard, Marshall Jefferson, Frankie Knuckles, Larry Levan, David  Morales, Eric Morillo, Danny Rampling ja Todd Terry."@fi,
        "Elektronisk dansmusikstil som utvecklades ur discomusiken i början av 1980-talet. Stilen var instrumentalt betonad, rymten blev mera mekanisk och basljuden djupare, influenser av synthpop, dub reggae, hip hop och jazz inkluderades. Vid slutet av 1980-talet blev stilen allmännare och splittrades i flera underarter (bl.a. ambient house, acid house, deep house, epic house, hard house och latino house). Kända företrädare har varit t.ex. Basement Jaxx, Daft Punk, Larry Heard, Marshall Jefferson, Frankie Knuckles, Larry Levan, David  Morales, Eric Morillo, Danny Rampling och Todd Terry."@sv ;
    skos:exactMatch allars:Y51904,
        koko:p81083,
        ysa:Y214499 ;
    skos:inScheme yso: ;
    skos:prefLabel "house (music)"@en,
        "house"@fi,
        "house"@se,
        "house"@sv ;
    skos:related yso:p12374,
        yso:p12375,
        yso:p12377,
        yso:p14336,
        yso:p14614,
        yso:p29942,
        yso:p30024,
        yso:p30149 .

