        ysometa:Concept ;
    dct:created "1996-02-08"^^xsd:date ;
    dct:modified "2023-02-01"^^xsd:date ;
    skos:broader yso:p127 ;
    skos:definition "Refers to Boris Asafiev’s concept of intonation in music."@en,
        "Boris V. Asafjevin kehittelemä marxilaisen filosofian piiriin lukeutuva teoria ihmisen tajunnan ja yhteiskunnallisen muutoksen, erityisesti poliittisen historian, sekä musiikin välisestä vuorovaikutuksesta."@fi,
        "Teori utvecklad av Boris Asafjev som hör till marxistisk filosofi och handlar om växelverkan  mellan människans medvetande och samhällelig förändring, särskilt politisk historia, samt musik."@sv ;
    skos:exactMatch allars:Y51755,
        koko:p48860,
        ysa:Y214507 ;
    skos:inScheme yso: ;
    skos:prefLabel "intonation theory"@en,
        "intonaatioteoria"@fi,
        "intonašuvdnateoriija"@se,
        "intonationsteori"@sv .

