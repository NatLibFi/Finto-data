yso:p25784 a skos:Concept,
        ysometa:Concept ;
    dct:created "2012-03-01"^^xsd:date ;
    dct:modified "2025-04-18"^^xsd:date ;
    skos:altLabel "theater of the absurd"@en ;
    skos:broader yso:p2625 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85134575>,
        <http://www.wikidata.org/entity/Q191760> ;
    skos:exactMatch allars:Y43392,
        koko:p62678,
        ysa:Y184589 ;
    skos:inScheme yso: ;
    skos:note "Tyylisuunta, joka kokosi yhteen useiden avantgarde-kirjoittajien, mm. Samuel Beckettin, Eugéne Ionescon, Arthur Adamovin ja Camusin tekstejä. Tyylisuunta merkitsi ensimmäistä tosiasiallista murrosta suhteessa klassiseen dramaturgiaan. Absurdi dramaturgia perustui tapahtumattomuudelle ja merkityksellisen toiminnan puutteelle."@fi,
        "Stilriktning som samlade ihop texter av flera avantgardeförfattare, bl.a. Samuel Beckett, Eugéne Ionesco, Arthur Adamov och Albert Camus, och som utgjorde den första riktiga brytningen i förhållande till klassisk dramaturgi. Absurd dramaturgi grundade sig på händelselöshet och avsaknad av betydelsefull handling."@sv ;
    skos:prefLabel "theatre of the absurd"@en,
        "absurdi teatteri"@fi,
        "absurda teáhter"@se,
        "absurd teater"@sv ;
    skos:related yso:p2624,
        yso:p28809 .

