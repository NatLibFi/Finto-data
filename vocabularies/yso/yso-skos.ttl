yso:p10995 a skos:Concept,
        ysometa:Concept ;
    dct:created "2003-10-07"^^xsd:date ;
    dct:modified "2024-08-28"^^xsd:date ;
    skos:altLabel "folkrock"@fi,
        "folkrock (elförstärkt)"@sv ;
    skos:broader yso:p1882 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh87004213>,
        <http://www.wikidata.org/entity/Q186472> ;
    skos:definition "Alkuperältään angloamerikkalainen sähkösoittimia hyödyntävä pop- ja rockmusiikkityyli, jossa käytetään hyväksi perinnesävelmiä ja osittain perinnesoittimia. Tyylisuunta kehittyi lähinnä Isossa-Britanniassa 1960-luvun lopulla ja kukoisti 1970-luvulla. Myös Yhdysvalloissa oli oma folk rockin kausi, joka käynnistyi, kun osa folkmusiikin esittäjistä alkoi käyttää sähköisiä soittimia (mm. Bob Dylan ja The Byrds). Folk rockin rinnakkainen ilmiö on country rock."@fi,
        "Till sitt ursprung angloamerikansk pop- och rockmusikstil som använder elektriska och delvis traditionella instrument och som innehåller traditionella melodier. Stilriktningen utvecklades främst i Storbritannien i slutet av 1960-talet och blomstrade på 1970-talet. Även USA hade en egen folkrock-period, som igångsattes när en del av folkmusikens framförare började använda elektriska instrument (bl.a. Bob Dylan och The Byrds). Ett parallellt fenomen till folkrock är countryrock."@sv ;
    skos:exactMatch allars:Y41880,
        koko:p9500,
        ysa:Y127401 ;
    skos:inScheme yso: ;
    skos:prefLabel "folk rock"@en,
        "folk rock"@fi,
        "folk rock"@se,
        "folkrock (förstärkt)"@sv ;
    skos:related yso:p12376,
        yso:p29295,
        yso:p5499 .

