yso:p2824 a skos:Concept,
        ysometa:Concept ;
    dc:source "Lähde: CD-Facta"@fi ;
    dct:created "2002-12-04"^^xsd:date ;
    dct:modified "2022-10-13"^^xsd:date ;
    skos:altLabel "sisäkauppa"@fi,
        "yhtenäismarkkinat"@fi,
        "internhandel"@sv ;
    skos:broader yso:p2823 ;
    skos:exactMatch allars:Y29609,
        koko:p4415,
        ysa:Y122091 ;
    skos:inScheme yso: ;
    skos:note "Markkina-alue, jossa henkilöiden, palveluiden, tavaroiden ja pääomien liikkuminen on vapaata ja jossa noudatetaan mm. yhtenäistä kilpailupolitiikkaa. Nimitystä on käytetty varsinaisesti Euroopan yhteisön jäsenmaiden välisestä kaupankäynnistä sen jälkeen kun  v. 1993-1994 poistettiin viimeisetkin tullimuodollisuudet jäsenmaiden välisestä kaupasta"@fi,
        "Marknadsområde, inom vilket råder fri rörelse för tjänster, varor och kapital och förs en gemensam konkurrenspolitik. Benämningen har använts särskilt om handeln mellan medlemsländer i den Europeiska gemenskapen, efter att de sista tullformaliteterna för handel mellan medlemsländerna avskaffades år 1993-1994."@sv ;
    skos:prefLabel "internal market"@en,
        "sisämarkkinat"@fi,
        "sismárkanat"@se,
        "inre marknad"@sv ;
    skos:related yso:p16257,
        yso:p17236,
        yso:p1732,
        yso:p2821,
        yso:p2822,
        yso:p2825 .

