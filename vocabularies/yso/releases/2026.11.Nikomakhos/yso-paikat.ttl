:p94473  rdf:type          skos:Concept;
        dct:created        "1990-05-16"^^xsd:date;
        dct:modified       "2024-09-25"^^xsd:date;
        skos:closeMatch    <http://www.wikidata.org/entity/Q440068>;
        skos:exactMatch    allars:Y34787;
        skos:exactMatch    ysa:Y94473;
        skos:inScheme      :places;
        skos:note          "Gamla Finland, även Ryska Finland eller Viborgska guvernementet, de delar av Finland som avträddes till Ryssland genom frederna i Nystad 1721 och Åbo 1743. Området returnerades till Finland 1812 och bildade då Viborgs län."@sv;
        skos:note          "Tarkoittaa niitä Kaakkois-Suomen alueita, jotka Venäjä sai Ruotsi-Suomelta Uudenkaupungin rauhassa 1721 ja Turun rauhassa 1743. Alue palautettiin muun Suomen yhteyteen 1812 ja siitä muodostettiin uusi Viipurin lääni. Vanhan Suomen alueesta käytettiin 1743-1783 nimitystä Viipurin kuvernementti."@fi;
        skos:prefLabel     "Gamla Finland"@sv;
        skos:prefLabel     "Vanha Suomi"@fi;
        skos:related       :p107950;
        skos:related       :p197138;
        skos:topConceptOf  :places .

