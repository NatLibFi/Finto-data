:p98845  rdf:type                  skos:Concept;
        dc:source                  "Wikipedia"@fi;
        dct:created                "1987-02-01"^^xsd:date;
        dct:modified               "2024-09-25"^^xsd:date;
        iso-thes:broaderPartitive  :p105024;
        iso-thes:broaderPartitive  :p94080;
        iso-thes:broaderPartitive  :p94111;
        skos:broader               :p105024;
        skos:broader               :p94080;
        skos:broader               :p94111;
        skos:closeMatch            <http://www.wikidata.org/entity/Q36288>;
        skos:exactMatch            allars:Y25808;
        skos:exactMatch            ysa:Y98845;
        skos:inScheme              :places;
        skos:note                  "Historiskt nätverk handelsvägar som gick genom Asien, från Chang’an (numera Xi’an) till Antiochia i Syrien och andra platser i Mellanöstern och Europa. Via Sidenvägen transporterades silke och andra handelsvaror, såsom elfenben, guld och ädelstenar, i huvudsak med karavaner."@sv;
        skos:note                  "Joukko yhteenliittyneitä kauppareittejä, jotka kulkivat Aasian halki Kiinan Chang-ansta (nyk. Xian) Syyrian Antiokiaan ja muihin Lähi-idän ja Euroopan kohteisiin. Silkkitien kautta kuljetettiin silkkiä ja muita kauppatavaroita, kuten norsunluuta, kultaa ja jalokiviä pääasiassa karavaaneilla."@fi;
        skos:prefLabel             "Sidenvägen"@sv;
        skos:prefLabel             "Silkkitie"@fi .

