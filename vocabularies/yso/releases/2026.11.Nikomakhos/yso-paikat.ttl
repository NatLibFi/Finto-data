        skos:altLabel      "Västerbotten (maakunta)"@fi;
        skos:closeMatch    <http://www.wikidata.org/entity/Q211652>;
        skos:exactMatch    allars:Y32936;
        skos:exactMatch    ysa:Y106280;
        skos:inScheme      yso-update:;
        skos:inScheme      :places;
        skos:note          "Historiskt landskap i Sverige-Finland, samt nutida landskap i Sverige. Västerbotten kallas också området på bägge sidor om Torne älv och Muonio älv, med i huvudsak finskspråkig befolkning, i finska Lappland och svenska Norrbotten."@sv;
        skos:note          "Ruotsi-Suomen historiallinen maakunta sekä Ruotsin nykyinen maakunta. Länsipohjaksi kutsutaan myös Tornionjoen ja Muonionjoen molemmin puolin olevaa, äidinkieleltään kokonaan tai pääasiallisesti suomenkielisen väestön asuttamaa aluetta Suomen Lapissa ja Ruotsin Norrbottenissa."@fi;
        skos:prefLabel     "Västerbotten"@fi;
        skos:prefLabel     "Västerbotten"@sv;
        skos:related       :p508705;
        skos:topConceptOf  :places .

