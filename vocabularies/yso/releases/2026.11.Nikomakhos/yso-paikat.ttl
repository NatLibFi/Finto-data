:p508497  rdf:type                 skos:Concept;
        dc:source                  "Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Kylä tai kulmakunta"@fi;
        dc:source                  "Wikidata"@fi;
        dct:created                "2021-08-20T11:52:55.555000+03:00"^^xsd:dateTime;
        dct:modified               "2024-09-25"^^xsd:date;
        iso-thes:broaderPartitive  :p94328;
        skos:broader               :p94328;
        skos:closeMatch            <http://paikkatiedot.fi/so/1000772/10332719>;
        skos:closeMatch            <http://www.wikidata.org/entity/Q11853517>;
        skos:inScheme              yso-update:;
        skos:inScheme              :places;
        skos:note                  "By i Parkano. År 1926 delades byn Aurejärvi i Kuru socken i tre delar och en del av den (s.k. Wähä-Aure) anslöts med namnet Aurejärvi till Parkano socken. De andra delarna (s.k. Iso-Aure) blev kvar i Kuru med namnen Itä-Aure och Länsi-Aure."@sv;
        skos:note                  "Kylä Parkanossa. Vuonna 1926 Kurun pitäjän Aurejärven kylä jaettiin kolmeen osaan ja osa siitä (nk. Wähä-Aure) liitettiin Parkanon pitäjään nimellä Aurejärvi. Muut osat (nk. Iso-Aure) jäivät Kuruun nimillä Itä-Aure ja Länsi-Aure."@fi;
        skos:prefLabel             "Aurejärvi (Parkano)"@fi;
        skos:prefLabel             "Aurejärvi (Parkano)"@sv;
        skos:related               :p125921;
        skos:related               :p125922 .

