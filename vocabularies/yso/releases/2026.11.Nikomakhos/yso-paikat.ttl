:p111725  rdf:type                 skos:Concept;
        dc:source                  "Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Lääni (2009)"@fi;
        dct:created                "1999-01-14"^^xsd:date;
        dct:modified               "2024-09-25"^^xsd:date;
        iso-thes:broaderPartitive  :p94426;
        skos:broader               :p94426;
        skos:closeMatch            <http://paikkatiedot.fi/so/1000772/10899555>;
        skos:closeMatch            <http://www.wikidata.org/entity/Q192759>;
        skos:exactMatch            allars:Y31158;
        skos:exactMatch            ysa:Y111725;
        skos:inScheme              :places;
        skos:note                  "Länsi-Suomen lääni perustettiin 1.9.1997. Lääni muodostuu entisestä Hämeen läänin pohjoisosasta, Keski-Suomen läänistä, Turun ja Porin läänistä ja Vaasan läänistä. Länsi-Suomen lääni lakkautettiin 31.12.2009 valtion aluehallintouudistuksen yhteydessä. Aluehallintovirastot (AVI) ja elinkeino- liikenne- ja ympäristökeskukset (ELY) hoitavat 1.1.2010 alkaen alueilla tehtäviä, joita tähän asti ovat hoitaneet lääninhallitukset, TE-keskukset, alueelliset ympäristökeskukset, ympäristölupavirastot, tiepiirit ja työsuojelupiirien työsuojelutoimistot"@fi;
        skos:note                  "Västra Finlands län grundades 1.9.1997. Det bildades av tidigare Tavastehus läns norra del, Mellersta Finlands län, Åbo och Björneborgs län och Vasa län"@sv;
        skos:prefLabel             "Länsi-Suomen lääni"@fi;
        skos:prefLabel             "Västra Finlands län"@sv;
        skos:related               :p105117;
        skos:related               :p105120;
        skos:related               :p105946;
        skos:related               :p94448;
        skos:related               :p94467 .

:p111726  rdf:type                 skos:Concept;
        dc:source                  "Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Lääni (2009)"@fi;
        dct:created                "1999-01-14"^^xsd:date;
        dct:modified               "2024-09-25"^^xsd:date;
        iso-thes:broaderPartitive  :p94426;
        skos:broader               :p94426;
        skos:closeMatch            <http://paikkatiedot.fi/so/1000772/10899564>;
        skos:closeMatch            <http://www.wikidata.org/entity/Q188752>;
        skos:exactMatch            allars:Y31148;
        skos:exactMatch            ysa:Y111726;
        skos:inScheme              :places;
        skos:note                  "Etelä-Suomen lääni perustettiin 1.9.1997. Lääni muodostuu entisestä Hämeen läänin eteläosasta, Kymen läänistä ja Uudenmaan läänistä. Lisäksi suurlääniin liitettiin entisestä Mikkelin läänistä Heinola, Sysmä ja Hartola. Etelä-Suomen lääni lakkautettiin 31.12.2009 valtion aluehallintouudistuksen yhteydessä. Aluehallintovirastot (AVI) ja elinkeino- liikenne- ja ympäristökeskukset (ELY) hoitavat 1.1.2010 alkaen alueilla tehtäviä, joita tähän asti ovat hoitaneet lääninhallitukset, TE-keskukset, alueelliset ympäristökeskukset, ympäristölupavirastot, tiepiirit ja työsuojelupiirien työsuojelutoimistot"@fi;
        skos:note                  "Södra Finlands län grundades 1.9.1977. Det bildades av  tidigare Tavastehus läns södra del, Kymmene län och Nylands län. Till det nya storlänet anslöts även Heinola, Sysmä och  Gustav Adolfs från tidigare S:t Michels län."@sv;
        skos:prefLabel             "Etelä-Suomen lääni"@fi;
        skos:prefLabel             "Södra Finlands län"@sv;
        skos:related               :p105108;
        skos:related               :p105117;
        skos:related               :p105917;
        skos:related               :p94460 .

