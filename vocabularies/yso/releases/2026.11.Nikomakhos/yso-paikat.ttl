:p168591  rdf:type                 skos:Concept;
        dc:source                  "Web-Facta; Wikipedia"@fi;
        dct:created                "2009-10-15"^^xsd:date;
        dct:modified               "2026-04-10T13:52:22"^^xsd:dateTime;
        iso-thes:broaderPartitive  :p105573;
        skos:altLabel              "Nikaia"@fi;
        skos:altLabel              "Nikaia (Nicaea)"@sv;
        skos:broader               :p105573;
        skos:closeMatch            <http://www.wikidata.org/entity/Q739037>;
        skos:exactMatch            allars:Y44776;
        skos:exactMatch            ysa:Y168591;
        skos:inScheme              yso-update:;
        skos:inScheme              :places;
        skos:note                  "Alkujaan kreikkalainen siirtokunta ja kaupunki Vähässä-Aasiassa. Nikea perustettiin noin v. 316 eKr. Kaupungissa pidettiin vuosina 325 ja 787 ekumeeniset kirkolliskokoukset. Nikea oli Nikean keisarikunnan pääkaupunki 1300-luvulle asti, jolloin sen valloittivat turkkilaiset. Nykyään samalla paikalla sijaitsee İznikin kaupunki."@fi;
        skos:note                  "Forntida stad i Mindre Asien, grundad år 316 f.Kr. Numera finns på samma plats staden Iznik."@sv;
        skos:prefLabel             "Nicaea"@sv;
        skos:prefLabel             "Nikea"@fi;
        skos:related               :p509077 .

