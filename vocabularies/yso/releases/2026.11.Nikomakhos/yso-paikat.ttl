:p197138  rdf:type         skos:Concept;
        dc:source          "Nenonen, Kaisu-Maija, Historian suursanakirja; Wikipedia"@fi;
        dct:created        "2014-02-21"^^xsd:date;
        dct:modified       "2024-09-25"^^xsd:date;
        skos:altLabel      "Viborgs guvernement"@sv;
        skos:closeMatch    <http://www.wikidata.org/entity/Q2487972>;
        skos:exactMatch    allars:Y49297;
        skos:exactMatch    ysa:Y197138;
        skos:inScheme      :places;
        skos:note          "Benämning på det s.k. Gamla Finlands område som hörde till Ryssland 1743-1783. Efter freden i Åbo 1743 bildades Viborgs guvernement som en administrativ helhet av Viborg, Kexholm och Kymmenegårds provinser."@sv;
        skos:note          "Venäjän valtaan kuuluneesta ns. Vanhan Suomen alueesta 1743-1783 käytetty nimitys. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus Viipurin kuvernementti."@fi;
        skos:prefLabel     "Viborgska guvernementet"@sv;
        skos:prefLabel     "Viipurin kuvernementti"@fi;
        skos:related       :p197139;
        skos:related       :p197140;
        skos:related       :p94473;
        skos:topConceptOf  :places .

:p197139  rdf:type         skos:Concept;
        dc:source          "Wikipedia"@fi;
        dct:created        "2014-02-21"^^xsd:date;
        dct:modified       "2025-01-10T09:08:27"^^xsd:dateTime;
        skos:altLabel      "Viborgs provins"@sv;
        skos:exactMatch    allars:Y49296;
        skos:exactMatch    ysa:Y197139;
        skos:inScheme      :places;
        skos:note          "Uudenkaupungin rauhassa 1721 siirtyivät Käkisalmen läänin etelä- ja keskiosat sekä pääosa Viipurin läänistä Venäjän haltuun. Alue muodosti hallinnollisesti Pietarin kuvernementtiin kuuluneen Viipurin ja Käkisalmen provinssin. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus, Viipurin kuvernementti."@fi;
        skos:prefLabel     "Viborgska provinsen"@sv;
        skos:prefLabel     "Viipurin provinssi"@fi;
        skos:related       :p197138;
        skos:topConceptOf  :places .

:p197140  rdf:type         skos:Concept;
        dct:created        "2014-02-21"^^xsd:date;
        dct:modified       "2026-01-02T15:09:53"^^xsd:dateTime;
        skos:altLabel      "Keksholms provins"@sv;
        skos:exactMatch    allars:Y48961;
        skos:exactMatch    ysa:Y197140;
        skos:inScheme      :places;
        skos:note          "Uudenkaupungin rauhassa 1721 siirtyivät Käkisalmen läänin etelä- ja keskiosat sekä pääosa Viipurin läänistä Venäjän haltuun. Alue muodosti hallinnollisesti Pietarin kuvernementtiin kuuluneen Viipurin ja Käkisalmen provinssin. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus, Viipurin kuvernementti."@fi;
        skos:note          "Vid freden i Nystad 1721 blev de södra och mellersta delarna av Kexholms län samt huvuddelen av Viborgs län en del av Ryssland. Området bildade förvaltningsmässigt Viborgs och Kexholms provins, som tillhörde guvernementet Sankt Petersburg. Efter freden i Åbo 1743 bildades av Viborgs, Kexholms och Kymmenegårds provinser en förvaltningsmässig helhet, Viborgs guvernement."@sv;
        skos:prefLabel     "Kexholms provins"@sv;
        skos:prefLabel     "Käkisalmen provinssi"@fi;
        skos:related       :p197138;
        skos:topConceptOf  :places .

