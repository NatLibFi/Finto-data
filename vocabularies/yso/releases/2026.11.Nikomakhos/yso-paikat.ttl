        skos:closeMatch            <http://www.wikidata.org/entity/Q403>;
        skos:exactMatch            allars:Y32559;
        skos:exactMatch            ysa:Y107592;
        skos:inScheme              :places;
        skos:note                  "Jugoslavia hajosi v. 1991. Serbia ja Montenegro muodostivat v. 1992 Jugoslavian liittotasavallan, ns. Tynkä-Jugoslavian.  Jugoslavian nimi muuttui Serbia ja Montenegroksi 14.3.2002, jolloin Serbia ja Montenegro allekirjoittivat valtioliittosopimuksen. 21. toukokuuta 2006 järjestetyssä kansanäänestyksessä enemmistö kannatti Montenegron itsenäistymistä ja valtio julistautui itsenäiseksi 3. kesäkuuta 2006.  Euroopan unioni tunnusti Montenegron 12. kesäkuuta ja Serbian 15. kesäkuuta 2006. Montenegrosta tuli Yhdistyneiden kansakuntien 192. jäsen 28. kesäkuuta 2006. Kosovo julistautui itsenäiseksi 17. helmikuuta 2008"@fi;
        skos:note                  "Jugoslavien upplöstes 1991. Serbien och Montenegro bildade Förbundsrepubiken Jugoslavien, som blev FN-medlem 1.11.2000 ; namnet ändrades till Serbien och Montenegro 14.3.2002, då ett avtal om statsförbund undertecknades."@sv;
        skos:prefLabel             "Serbia"@fi;
        skos:prefLabel             "Serbien"@sv;
        skos:related               :p105202;
        skos:related               :p112712;
        skos:related               :p118301;
        skos:related               :p120572 .

