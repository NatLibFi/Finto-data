:p104990  rdf:type                 skos:Concept;
        dct:created                "1991-10-29"^^xsd:date;
        dct:modified               "2026-06-08T15:58:46"^^xsd:dateTime;
        iso-thes:broaderPartitive  :p94111;
        skos:altLabel              "Britannia (Iso-Britannia)"@fi;
        skos:altLabel              "Britannien (Storbritannien)"@sv;
        skos:altLabel              "Förenade konungariket"@sv;
        skos:altLabel              "Förenade konungariket Storbritannien och Irland"@sv;
        skos:altLabel              "Förenade konungariket Storbritannien och Nordirland"@sv;
        skos:altLabel              "Förenade kungariket"@sv;
        skos:altLabel              "Förenade kungariket Storbritannien och Irland"@sv;
        skos:altLabel              "Förenade kungariket Storbritannien och Nordirland"@sv;
        skos:altLabel              "Iso Britannia"@fi;
        skos:altLabel              "Iso-Britannia ja Pohjois-Irlanti"@fi;
        skos:altLabel              "Ison-Britannian ja Irlannin yhdistynyt kuningaskunta"@fi;
        skos:altLabel              "Ison-Britannian ja Pohjois-Irlannin yhdistynyt kuningaskunta"@fi;
        skos:altLabel              "Ison-Britannian kuningaskunta"@fi;
        skos:altLabel              "Yhdistynyt kuningaskunta"@fi;
        skos:broader               :p94111;
        skos:closeMatch            <http://www.wikidata.org/entity/Q145>;
        skos:exactMatch            allars:Y30643;
        skos:exactMatch            ysa:Y104990;
        skos:inScheme              yso-update:;
        skos:inScheme              :places;
        skos:note                  "Ison-Britannian kuningaskunta syntyi v. 1707, jolloin Englannin ja Skotlannin välinen personaaliunioni muuttui reaaliunioniksi. Tätä seurasi v. 1801 Ison-Britannian ja Irlannin yhdistynyt kuningaskunta, Irlannin itsenäistyttyä Ison-Britannian ja Pohjois-Irlannin yhdistynyt kuningaskunta. Englanti-nimeä käytetään Ison-Britannian osasta. Britannia on historiallinen nimi, joka tarkoitti Englantia, Walesia ja Skotlantia tai niiden Rooman valtakuntaan kuuluneita osia (Rooman provinssi 43 jKr.- n. 450 jKr.)."@fi;
        skos:note                  "Kungariket Storbritannien bildades år 1707 då personalunionen mellan England och Skottland blev en realunion. På detta följde Förenade kungariket Storbritannien och Irland och efter att Irland blivit självständigt Förenade kungariket Storbritannien och Nordirland. Benämningen England används om Storbritanniens del. Britannia eller Britannien är ett historiskt namn, som avsåg England, Wales och Skottland eller de delar av dem som tillhörde Romerska riket (en romersk provins från 43 e.Kr. till ca 450 e.Kr.)."@sv;
        skos:prefLabel             "Iso-Britannia"@fi;
        skos:prefLabel             "Storbritannien"@sv;
        skos:related               :p105484;
        skos:related               :p105720;
        skos:related               :p109993;
        skos:related               :p110434;
        skos:related               :p131239;
        skos:related               :p508111;
        skos:related               :p509091 .

