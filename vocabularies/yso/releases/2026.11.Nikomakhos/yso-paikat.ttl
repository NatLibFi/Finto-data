:p110631  rdf:type                 skos:Concept;
        dc:source                  "Kielikello 2/1998"@fi;
        dct:created                "1997-10-01"^^xsd:date;
        dct:modified               "2026-02-19T11:04:16"^^xsd:dateTime;
        iso-thes:broaderPartitive  :p94080;
        skos:altLabel              "Belgian Kongo"@fi;
        skos:altLabel              "Belgiska Kongo"@sv;
        skos:altLabel              "Demokratiska republiken Kongo"@sv;
        skos:altLabel              "Kinshasan Kongo"@fi;
        skos:altLabel              "Kongo (Kongon demokraattinen tasavalta)"@fi;
        skos:altLabel              "Kongo-Kinshasa"@fi;
        skos:altLabel              "Kongo-Kinshasa"@sv;
        skos:altLabel              "Zaire"@fi;
        skos:altLabel              "Zaire"@sv;
        skos:broader               :p94080;
        skos:closeMatch            <http://www.wikidata.org/entity/Q974>;
        skos:exactMatch            allars:Y32468;
        skos:exactMatch            ysa:Y110631;
        skos:inScheme              yso-update:;
        skos:inScheme              :places;
        skos:note                  "Ennen itsenäistymistään v. 1960 maa oli nimeltään Belgian Kongo, 1885-1908 Kongon vapaavaltio. Itsenäistyttyään valtio oli ensin nimeltään Kongon tasavalta, myöhemmin Zaire, ja vuodesta 1997 eteenpäin se on tunnettu nykyisellä nimellä. "@fi;
        skos:note                  "Före sin självständighet år 1960 hette landet Belgiska kongo, åren 1885-1908 Kongostaten. Åren 1971-1998 hette staten också Zaire."@sv;
        skos:prefLabel             "Kongo (Kinshasa)"@sv;
        skos:prefLabel             "Kongon demokraattinen tasavalta"@fi .

