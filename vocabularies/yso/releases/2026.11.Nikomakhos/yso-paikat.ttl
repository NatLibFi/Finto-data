:p161556  rdf:type         skos:Concept;
        dct:created        "2008-10-09"^^xsd:date;
        dct:modified       "2024-09-25"^^xsd:date;
        skos:altLabel      "Gränskarelen"@sv;
        skos:altLabel      "Ladoga-Karelen"@sv;
        skos:altLabel      "Raja-Karjala"@fi;
        skos:closeMatch    <http://www.wikidata.org/entity/Q3436524>;
        skos:exactMatch    allars:Y38120;
        skos:exactMatch    ysa:Y161556;
        skos:inScheme      :places;
        skos:note          "Laatokan luoteis-, pohjois- ja koillispuolinen osa, joka kuului ennen talvi- ja jatkosotaa Suomen Karjalaan. Laatokan Karjala alkaa Kurkijoesta ja ulottuu Korpiselän ja Ilomantsin kaakkoisosiin saakka. Laatokan Karjalan itäisintä osaa on kutsuttu Raja-Karjalaksi. Nykyään alue kuuluu Karjalan tasavaltaan."@fi;
        skos:note          "Området nordväst, norr och nordost om Ladoga som före vinterkriget hörde till Finland. Ladogakarelen börjar från Kurkijoki och sträcker sig till sydöstra delarna av Korpiselkä och Ilomants. Ladogakarelens östligaste del kallas Gränskarelen. Området hör nu till Karelska republiken."@sv;
        skos:prefLabel     "Laatokan Karjala"@fi;
        skos:prefLabel     "Ladogakarelen"@sv;
        skos:related       :p94192;
        skos:topConceptOf  :places .

