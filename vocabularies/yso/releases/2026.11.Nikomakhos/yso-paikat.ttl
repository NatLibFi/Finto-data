:p149420  rdf:type         skos:Concept;
        dc:source          "Web-Facta; Wikipedia"@fi;
        dct:created        "2006-12-04"^^xsd:date;
        dct:modified       "2024-09-25"^^xsd:date;
        skos:altLabel      "Ottomaanien imperiumi"@fi;
        skos:altLabel      "Ottomaanien valtakunta"@fi;
        skos:altLabel      "Ottomanska riket"@sv;
        skos:altLabel      "Turkin sulttaanikunta"@fi;
        skos:closeMatch    <http://www.wikidata.org/entity/Q12560>;
        skos:exactMatch    allars:Y34489;
        skos:exactMatch    ysa:Y149420;
        skos:inScheme      :places;
        skos:note          "Benämning på den turkiska statsbildning som uppkom ca 1300 i n.v. Mindre Asien med den osmanska stammen som kärna och som 1923 ersattes av den turkiska republiken"@sv;
        skos:note          "Turkkilaisten 1300-luvulla perustama, 1922 hajonnut sulttaanivaltakunta. Turkkilaiset osmanit olivat muslimeja, mutta valtakuntaan kuului monia kansoja jotka saivat säilyttää oman kulttuurinsa ja uskontonsa. Valtakunnan hajottua siitä jäi jäljelle nykyinen Turkki"@fi;
        skos:prefLabel     "Osmanien valtakunta"@fi;
        skos:prefLabel     "Osmanska riket"@sv;
        skos:related       :p105573;
        skos:topConceptOf  :places .

:p149458  rdf:type         skos:Concept;
        dc:source          "Web-Facta"@fi;
        dct:created        "2006-12-05"^^xsd:date;
        dct:modified       "2024-09-25"^^xsd:date;
        skos:altLabel      "Konungariket Jerusalem"@sv;
        skos:closeMatch    <http://www.wikidata.org/entity/Q55502>;
        skos:exactMatch    allars:Y44802;
        skos:exactMatch    ysa:Y149458;
        skos:inScheme      :places;
        skos:note          "Ristiretkeläisten v. 1099 perustama valtio, joka käsitti laajimmillaan Palestiinan, Tripoliin, Antiokian ja Edessan ja joka hajosi lopullisesti v. 1291 kristittyjen menetettyä Akkan"@fi;
        skos:note          "Stat grundad av korstågsfararna år 1099. När staten var som störst omfattade den Palestina, Tripoli, Antiokia och Edessa, men den upplöstes efter att de kristna år 1291 förlorat Akko."@sv;
        skos:prefLabel     "Jerusalemin kuningaskunta"@fi;
        skos:prefLabel     "Kungariket Jerusalem"@sv;
        skos:topConceptOf  :places .

:p149464  rdf:type                 skos:Concept;
        dc:source                  "Wikipedia (espanjankielinen)"@fi;
        dct:created                "2006-12-05"^^xsd:date;
        dct:modified               "2024-09-25"^^xsd:date;
        iso-thes:broaderPartitive  :p105209;
        skos:broader               :p105209;
        skos:closeMatch            <http://www.wikidata.org/entity/Q123559>;
        skos:exactMatch            allars:Y38114;
        skos:exactMatch            ysa:Y149464;
        skos:inScheme              :places;
        skos:note                  "På 700-talet skapade morerna ett stort muslimskt rike i det som i dag är Spanien och Portugal. Det kallades al-Andalus och senare även kalifatet i Cordoba."@sv;
        skos:note                  "Tarkoittaa muslimien v. 711-1492 hallitsemaa aluetta Iberian niemimaalla. Al-Andalusin alue vaihteli eri aikoina, kattaen laajimmillaan lähes koko niemimaan Almeriaa, Malagaa ja Granadaa lukuunottamatta. Al-Andalus oli vain lyhyitä aikoja suunnilleen sama kuin nykyinen Andalusia"@fi;
        skos:prefLabel             "Al-Andalus"@fi;
        skos:prefLabel             "al-Andalus"@sv .

:p149659  rdf:type         skos:Concept;
        dct:created        "2006-12-15"^^xsd:date;
        dct:modified       "2024-09-25"^^xsd:date;
        skos:altLabel      "Kannas"@fi;
        skos:altLabel      "Karjalan kannas"@fi;
        skos:altLabel      "Näset (Karelska näset)"@sv;
        skos:closeMatch    <http://www.wikidata.org/entity/Q209010>;
        skos:exactMatch    allars:Y34135;
        skos:exactMatch    ysa:Y149659;
        skos:inScheme      yso-update:;
        skos:inScheme      :places;
        skos:note          "Naturgeografiskt område som åtskiljer Ladoga och Finska viken. Näset avgränsas i sydost av Neva och nordvästgränsen går från Viborgska viken till viken längst i väster i Ladoga."@sv;
        skos:note          "Tarkoittaa luonnonmaantieteellistä aluetta, joka erottaa Laatokan ja Suomenlahden toisistaan. Kannaksen kaakkoisraja on Neva ja luoteisraja kulkee Viipurinlahdesta Laatokan läntisimpään lahteen."@fi;
        skos:prefLabel     "Karelska näset"@sv;
        skos:prefLabel     "Karjalankannas"@fi;
        skos:related       :p94192;
        skos:topConceptOf  :places .

