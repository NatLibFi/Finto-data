:p110633  rdf:type                 skos:Concept;
        dc:source                  "Kielikello 2/1998"@fi;
        dct:created                "1997-10-01"^^xsd:date;
        dct:modified               "2026-02-19T11:18:36"^^xsd:dateTime;
        iso-thes:broaderPartitive  :p94080;
        skos:altLabel              "Brazzavillen Kongo"@fi;
        skos:altLabel              "Kongo (Kongon tasavalta)"@fi;
        skos:altLabel              "Kongo-Brazzaville"@fi;
        skos:altLabel              "Kongo-Brazzaville"@sv;
        skos:altLabel              "Kongon kansantasavalta"@fi;
        skos:altLabel              "Republiken Kongo"@sv;
        skos:broader               :p94080;
        skos:closeMatch            <http://www.wikidata.org/entity/Q971>;
        skos:exactMatch            allars:Y32466;
        skos:exactMatch            ysa:Y110633;
        skos:inScheme              yso-update:;
        skos:inScheme              :places;
        skos:note                  "Kongon tasavalta itsenäistyi vuonna 1960. Sitä ennen alue kuului ensin Ranskan Kongona ja myöhemmin Ranskan Keski-Afrikkana tunnettuun siirtomaa-alueeseen, johon sisältyivät lisäksi nykyisen Gabonin ja Keski-Afrikan tasavallan sekä myöhemmin myös Tsadin alueet."@fi;
        skos:note                  "Republiken Kongo blev självständig år 1960. Före det hörde området till ett kolonialområde först känt som Franska Kongo och senare som Franska Ekvatorialafrika, i vilket även områden i nuvarande Gabon och Centralafrikanska republiken samt senare också Tchad ingick."@sv;
        skos:prefLabel             "Kongo (Brazzaville)"@sv;
        skos:prefLabel             "Kongon tasavalta"@fi .

