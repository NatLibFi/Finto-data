        skos:exactMatch            allars:Y35107;
        skos:exactMatch            ysa:Y125921;
        skos:inScheme              yso-update:;
        skos:inScheme              :places;
        skos:note                  "By i Kuru. År 1926 delades byn i tre delar och en del av den (s.k. Wähä-Aure) anslöts med namnet Aurejärvi till Parkano socken. De andra delarna (s.k. Iso-Aure) blev kvar i Kuru med namnen Itä-Aure och Länsi-Aure. Kuru anslöts till Ylöjärvi 1.1.2009."@sv;
        skos:note                  "Kylä Kurussa. Vuonna 1926 kylä jaettiin kolmeen osaan ja osa siitä (nk. Wähä-Aure) liitettiin Parkanon pitäjään nimellä Aurejärvi.  Muut osat (nk. Iso-Aure) jäivät Kuruun nimillä Itä-Aure ja Länsi-Aure. Kuru liitettiin 1.1.2009 Ylöjärveen. "@fi;
        skos:prefLabel             "Aurejärvi (Kuru)"@fi;
        skos:prefLabel             "Aurejärvi (Kuru)"@sv;
        skos:related               :p125922;
        skos:related               :p508497 .

