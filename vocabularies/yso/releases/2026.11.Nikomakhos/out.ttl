:p29795  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1997-09-30"^^xsd:date;
        dct:modified     "2020-10-14"^^xsd:date;
        skos:altLabel    "mellanspel"@sv;
        skos:broader     :p1515;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh95001194>;
        skos:definition  "Renessanssiajan näytelmien väliin sijoitettu musiikillinen välinäytös. Intermediot olivat erityisen tärkeitä Firenzessä 1500-luvulla. 1600-luvulla intermedio muuntui oopperan väliosaksi. Rinnakkaisia ilmiöitä olivat masque Englannissa ja ballet de cour Ranskassa."@fi , "Musikaliskt mellanspel placerat mellan akterna i renässanstidens skådespel. Intermedier var särskilt viktiga i Florens på 1500-talet. Under 1600-talet omvandlades intermediet till en mellandel i opera. Parallella fenomen var masque i England och ballet de cour i Frankrike."@sv;
        skos:exactMatch  ysa:Y214506 , allars:Y51754;
        skos:inScheme    :;
        skos:note        "Bör ej sammanblandas med begreppet <a href='http://www.yso.fi/onto/yso/p10244'>intermezzon (operor)</a>."@sv , "Ei pidä sekoittaa käsitteeseen <a href='http://www.yso.fi/onto/yso/p10244'>intermezzot (kamarioopperat)</a>."@fi;
        skos:prefLabel   "intermedier"@sv , "intermedi"@en , "intermediot"@fi;
        skos:related     :p5187;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26582 , :p26571;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "intermedio"@en , "intermedium"@sv .

