:p27970  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2014-06-12"^^xsd:date;
        dct:modified     "2023-01-06"^^xsd:date;
        skos:altLabel    "dancehall reggae"@sv , "raggamuffin"@sv , "raggamuffin"@fi , "dancehall reggae"@se , "ragga"@se , "dancehall reggae"@fi , "ragga"@sv , "raggamuffin"@se , "ragga"@fi;
        skos:broader     :p2968;
        skos:definition  "1980-luvun alussa Jamaikalla syntynyt reggaen laji, jonka tunnusomaisena piirteenä on DJ:n puhelaulu (toasting) yksinkertaisen konetaustan päälle. Tyyliä alettiin kutsua 1990-luvulla termillä raggamuffin (tai ragga), mutta alkuperäinen termi on sittemmin otettu uudelleen käyttöön. Tunnettuja edustajia ovat Yellowman, Elephant Man, Buju Banton, Sizzla ja Cutty Ranks."@fi , "Genre inom reggae, som uppkom på Jamaica i början av 1980-talet och som kännetecknas av en dj:s talsång (toasting) ovanpå en enkel maskinbakgrund. Stilen började kallas för raggamuffin eller ragga på 1990-talet, men senare har den ursprungliga termen åter tagits i bruk. Kända representanter är Yellowman, Elephant Man, Buju Banton, Sizzla och Cutty Ranks."@sv;
        skos:exactMatch  ysa:Y199292 , allars:Y46659;
        skos:inScheme    :;
        skos:prefLabel   "dancehall"@se , "dancehall"@sv , "dancehall (dance)"@en , "dancehall"@fi;
        skos:related     :p28047;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

