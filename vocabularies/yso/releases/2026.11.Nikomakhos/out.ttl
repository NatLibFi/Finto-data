        skos:narrower    :p14723 , :p2126 , :p21084 , :p10123 , :p30617 , :p2599 , :p9544 , :p18263 , :p11009 , :p16349 , :p24212 , :p6612 , :p39491 , :p8210 , :p13272 , :p1896 , :p7177 , :p9698 , :p8111 , :p14042 , :p15630 , :p10986 , :p4641 , :p1778 , :p2281 , :p24007 , :p5725 , :p7407 , :p11597 , :p4200 , :p15007 , :p19188 , :p24970 , :p6478 , :p18348 , :p22052 , :p10115 , :p11598 , :p21447 , :p24627 , :p7204 , :p15390 , :p1148 , :p2127 , :p4513;
        skos:note        "Som uttrycksmedel i litterära verk fungerar språket i skriftlig, tryckt eller muntlig form. Litterära verk indelas i skönlitterära och förklarande verk. Väldigt många skriftliga verk åtnjuter upphovsrättsligt skydd, bl.a. kartor och andra förklarande verk räknas också till litterära verk."@sv , "Kirjallisten teosten ilmaisukeinona on kieli kirjoitetussa, painetussa tai suullisessa muodossa, ja ne jaetaan kaunokirjallisiin ja selittäviin teoksiin. Tekijänoikeudellista suojaa nauttivat siis erittäin monet kirjalliset tuotteet, mm. karttoja ja muita selittäviä teoksia pidetään kirjallisina teoksina."@fi;
        skos:prefLabel   "kirjalliset teokset"@fi , "litterära verk"@sv , "literary works"@en;
        skos:related     :p16697 , :p2346 , :p2345;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26564 , :p26559;
