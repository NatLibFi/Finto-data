:p14614  rdf:type        skos:Concept , <http://www.yso.fi/onto/yso-meta/Concept>;
        dct:created      "2001-03-27"^^xsd:date;
        dct:modified     "2023-01-06"^^xsd:date;
        skos:altLabel    "eurodance"@fi , "tanssipop"@fi , "eurodance"@se , "dance-pop"@fi , "danspop"@sv , "eurodance"@sv;
        skos:broader     :p29932;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh00000588>;
        skos:definition  "1990-luvulla suosituksi tullut elektronisen tanssimusiikin laji, jota voi luonnehtia housen ja teknon helpotetuksi versioksi. Laulu ja melodisuus ovat tärkeämmässä osassa kuin muussa elektronisessa tanssimusiikissa. Tunnetuin dancen alagenre on eurodance, joka sisältää usein myös räppiä."@fi , "Genre inom elektronisk dansmusik som är en lättare version av house och techno och som blev populär på 1990-talet. Sång och melodiskhet är mer betonad än i annan elektronisk dansmusik. Den mest kända underarten av dance är eurodance, som ofta också innehåller rap."@sv;
        skos:exactMatch  allars:Y16748 , ysa:Y113587;
        skos:inScheme    :;
        skos:prefLabel   "dance"@fi , "dance"@se , "dance"@sv , "dance (music)"@en;
        skos:related     :p29901 , :p28047 , :p12377 , :p30024 , :p30149 , :p14336 , :p12374 , :p29894;
        skos:scopeNote   "Käsitettä käytetään myös klubimusiikista vaikutteita ammentavien listapop-artistien tuotannon tanssittavimmasta osasta."@fi , "Begreppet används också om den del av listpopartisters produktion som influeras av dans och klubbmusik."@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

