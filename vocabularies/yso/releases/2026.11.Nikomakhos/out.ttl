:p24749  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2011-02-28"^^xsd:date;
        dct:modified     "2026-05-07"^^xsd:date;
        skos:altLabel    "hámilaš gielat"@se , "seemiläis-haamilaiset kielet"@fi , "haamilaiset kielet"@fi , "hamitiska språk"@sv , "semitisk-hamitiska språk"@sv , "Semitic-Hamitic languages"@en , "hamito-semitiska språk"@sv;
        skos:broader     :p556;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85002020> , <http://www.wikidata.org/entity/Q25268>;
        skos:exactMatch  allars:Y40250 , ysa:Y177625;
        skos:inScheme    :;
        skos:narrower    :p38727 , :p26211 , :p14142 , :p14794 , :p15608 , :p19606 , :p4265;
        skos:note        "Tidigare användes termen semitisk-hamitiska språk. Tidigare indelades afroasiatiska språk i semitisk-hamitiska språk, men användningen av den benämningen har upphört eftersom det inte finns någon språkvetenskaplig grund för indelning i semitiska och hamitiska språk."@sv , "Nimitys on otettu sanastoon 2011, aiemmin on käytetty termiä seemiläis-haamilaiset kielet. Aikaisemmin afroaasialaiset kielet jaettiin seemiläis-haamilaisiksi kieliksi, mutta nimityksestä on luovuttu, koska kielten jaolla seemiläisiin ja haamilaisiin kieliin ei ole kielitieteellistä perustetta."@fi;
        skos:prefLabel   "afroasiatiska språk"@sv , "afroásialaš gielat"@se , "Afroasiatic languages"@en , "afroaasialaiset kielet"@fi;
        skos:related     :p19079;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26557 , :p3749;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "hamito-semitiskt språk"@sv , "hamitiskt språk"@sv , "semitisk-hamitiskt språk"@sv , "Semitic-Hamitic language"@en , "haamilainen kieli"@fi , "hámilaš giella"@se , "seemiläis-haamilainen kieli"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "afroasiatiskt språk"@sv , "afroásialaš giella"@se , "Afroasiatic language"@en , "afroaasialainen kieli"@fi .

