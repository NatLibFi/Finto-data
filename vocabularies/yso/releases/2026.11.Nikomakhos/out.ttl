:p29901  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-02-07"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "ambient house"@sv , "ambient house"@en , "ambient house"@fi , "ambient house"@se;
        skos:broader     :p29932;
        skos:closeMatch  <http://www.wikidata.org/entity/Q20502> , <http://id.loc.gov/authorities/subjects/sh97008974>;
        skos:definition  "Elektronisen tanssimusiikin laji, joka kehittyi discomusiikista 1980-luvun alkupuolella.  Tyyli oli instrumentaalipainotteista, rytmi muuttui mekaanisemmaksi, bassotaajuudet  syvemmiksi, ja mukaan tuli vaikutteita mm. syntikkapopista, dub reggaesta, hip hopista ja jazzista. 1980-luvun loppupuolelta alkaen tyyli yleistyi ja sirpaloitui (mm. ambient house, acid house, deep house, epic house, hard house ja latino house). 1990-luvulla house-tyylistä  tuli popmusiikin valtavirtaan kuuluva ilmiö. Tunnettuja edustajia ovat olleet Basement Jaxx, Daft Punk, Larry Heard, Marshall Jefferson, Frankie Knuckles, Larry Levan, David  Morales, Eric Morillo, Danny Rampling ja Todd Terry."@fi , "Elektronisk dansmusikstil som utvecklades ur discomusiken i början av 1980-talet. Stilen var instrumentalt betonad, rymten blev mera mekanisk och basljuden djupare, influenser av synthpop, dub reggae, hip hop och jazz inkluderades. Vid slutet av 1980-talet blev stilen allmännare och splittrades i flera underarter (bl.a. ambient house, acid house, deep house, epic house, hard house och latino house). Kända företrädare har varit t.ex. Basement Jaxx, Daft Punk, Larry Heard, Marshall Jefferson, Frankie Knuckles, Larry Levan, David  Morales, Eric Morillo, Danny Rampling och Todd Terry."@sv;
        skos:exactMatch  allars:Y51904 , ysa:Y214499;
        skos:inScheme    :;
        skos:prefLabel   "house"@se , "house"@sv , "house"@fi , "house (music)"@en;
        skos:related     :p12377 , :p14614 , :p30024 , :p29942 , :p30149 , :p14336 , :p12374 , :p12375;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

