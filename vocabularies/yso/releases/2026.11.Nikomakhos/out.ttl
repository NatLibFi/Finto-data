:p30014  rdf:type        skos:Concept , <http://www.yso.fi/onto/yso-meta/Concept>;
        dct:created      "2005-06-17"^^xsd:date;
        dct:modified     "2023-03-22"^^xsd:date;
        skos:broader     :p3046;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh2004004533>;
        skos:definition  "Dans som uppkom bland den svarta befolkningen i USA på 1800-talet och som fr.o.m. 1890-talet spreds som en del av den rådande sceniska underhållningskulturen med minstrel show-föreställningar. Musiken i cakewalk var vanligen ragtime."@sv , "Yhdysvaltain mustan väestön piirissä 1800-luvulla syntynyt tanssi, joka 1890-luvulta alkaen levisi minstrel show -esitysten välityksellä osaksi vallitsevaa näyttämöllistä viihdekulttuuria. Cakewalkin musiikkina oli tavallisesti ragtime."@fi;
        skos:exactMatch  ysa:Y214429 , allars:Y51964;
        skos:inScheme    :;
        skos:prefLabel   "cakewalk"@se , "cakewalk"@fi , "cakewalk"@en , "cakewalk"@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26582 .

