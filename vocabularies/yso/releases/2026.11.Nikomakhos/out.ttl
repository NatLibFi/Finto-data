:p4380  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2005-02-14"^^xsd:date;
        dct:modified     "2022-11-22"^^xsd:date;
        skos:altLabel    "företagsbesiktning"@sv;
        skos:broader     :p38217;
        skos:exactMatch  ysa:Y136025 , allars:Y30730;
        skos:inScheme    :;
        skos:note        "Tarkoittaa prosessia, jossa ostaja tutkii kohdeyrityksen liiketoiminnan, kirjanpidon ja tilinpäätöksen sekä oikeudellisen aseman. Ostaja pyrkii näin varmentamaan olettamukset, joihin alustava yritysjärjestelypäätös perustuu"@fi , "Avser process i vilken en köpare undersöker ett målföretags affärsverksamhet, bokföring och bokslut, samt juridiska ställning. Köparen eftersträvar på så vis att styrka de antaganden, på vilka ett preliminärt beslut om företagsarrangemang grundar sig."@sv;
        skos:prefLabel   "due diligence"@sv , "due diligence"@se , "due diligence"@fi , "due diligence"@en;
        skos:related     :p4381 , :p4382;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26538 .

