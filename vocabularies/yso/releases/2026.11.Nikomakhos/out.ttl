        skos:closeMatch     <http://id.loc.gov/authorities/subjects/sh85057674> , <http://www.wikidata.org/wiki/Q1974973>;
        skos:editorialNote  "TP päätettiin lisätä kulttuurisensitiivisyysmerkintä englannille, ei muille kielille. Kotuksen muistiinpanoista: \"Nimen tausta halventava, mutta vaihtoehtoista termiä ei ole; WP: \"\"The name is written guaycurú or guaicurú in Spanish (plural guaycurúes or guaicurúes), and guaicuru in Portuguese (plural guaicurus). It was originally an offensive epithet given to the Mbayá people of Paraguay by the Guarani, meaning \"\"savage\"\" or \"\"barbarian\"\", which later was extended to the whole group.\""@en;
        skos:inScheme       :;
        skos:prefLabel      "guaicurúspråk"@sv , "Guaicuruan languages"@en , "guaycurulaiset kielet"@fi;
