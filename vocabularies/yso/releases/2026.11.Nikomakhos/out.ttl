:p10926  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2005-05-19"^^xsd:date;
        dct:modified     "2023-01-20"^^xsd:date;
        skos:altLabel    "pop-rai"@fi;
        skos:broader     :p3064;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh97002100>;
        skos:definition  "Algerisk populärmusikstil som härstammar från 1920-1930-talet, och som typiskt består av alternerande sjungna verser och övergångar spelade med en typ av flöjt."@sv , "1920-1930-luvulta peräisin oleva algerialainen populaarimusiikkityyli, joka tyypillisesti koostuu vuorottelevista lauletuista säkeistä ja gaspah-huilulla soitetuista välikkeistä."@fi;
        skos:exactMatch  ysa:Y138135 , allars:Y35897;
        skos:inScheme    :;
        skos:note        "Käsitettä ei käytetä soitinmusiikista eikä tarkoittamaan yleisemmin arabimaissa suosittuja laulutyylejä."@fi , "Begreppet används inte om instrumentalmusik, eller om sångstilar som mera allmänt är populära i arabländerna."@sv;
        skos:prefLabel   "rai"@se , "raï"@en , "rai"@sv , "rai"@fi;
        skos:related     :p29976 , :p3065;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

