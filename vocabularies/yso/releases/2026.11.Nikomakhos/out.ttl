        skos:altLabel    "intelligent agent software"@en , "älykkäät ohjelmistoagentit"@fi , "intelligent software agents"@en;
        skos:broader     :p26592;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh97000493> , <http://www.wikidata.org/entity/Q1142726>;
        skos:exactMatch  ysa:Y175729 , allars:Y39775;
        skos:inScheme    :;
        skos:note        "Avser datorprogram som sammankopplar applikationer och databasprogram i en virtuell miljö. I dem används vanligen artificiell intelligens och krävs en del självständig problemlösning. Intelligenta agenter används för att skapa en illusion av människoliknande interaktion."@sv , "Tarkoittaa tietokoneohjelmia, jotka yhdistävät sovelluksia ja tietokantaohjelmia virtuaalisessa ympäristössä. Älykkäissä agenteissa käytetään yleensä tekoälyä ja ne vaativat jonkin verran itsenäistä ongelmanratkaisua. Älykkäitä agentteja käytetään luomaan illuusio ihmismäisestä vuorovaikutuksesta."@fi;
        skos:prefLabel   "intelligent agents"@en , "älykkäät agentit"@fi , "intelligenta agenter"@sv;
        skos:related     :p2616;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26553;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "älykäs ohjelmistoagentti"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "intelligent agent"@sv , "intelligent software agent"@en , "älykäs agentti"@fi , "intelligent agent"@en .

