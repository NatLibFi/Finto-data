:p29989  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-02-08"^^xsd:date;
        dct:modified     "2023-05-04"^^xsd:date;
        skos:altLabel    "brass bandit"@fi , "brassband"@sv;
        skos:broader     :p16416;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85016437>;
        skos:definition  "Orkester för militär, yrkeskår, (t.ex. polis, brandkår, järnväg), arbetarförening e.d. som i huvudsak består av blås- och slaginstrument."@sv , "Pääasiassa puhaltimia ja lyömäsoittimia käsittävä sotilas-, ammattikunta- (esim. poliisi, palokunta, rautatie), työväenyhdistyksen jne. orkesteri."@fi;
        skos:exactMatch  allars:Y52219 , ysa:Y214667;
        skos:inScheme    :;
        skos:narrower    :p19355;
        skos:note        "Jos puhallinsoittimista koostuva kokoonpano sisältää modernin puhallinorkesterin soittimet, siitä käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p16416'>puhallinorkesterit</a>. Jos tällainen kokoonpano on nimetysti osa sotilaallista organisaatiota, käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p19355'>sotilassoittokunnat</a>."@fi , "Om en ensemble bestående av blåsinstrument inbegriper en modern blåsorkesters instrument används begreppet <a href='http://www.yso.fi/onto/yso/p16416'>blåsorkestrar</a>. Om ensemblen till namnet är en del av en militär organisation används begreppet militärmusikårer."@sv;
        skos:prefLabel   "musihkkagottit"@se , "brass bands"@en , "soittokunnat"@fi , "musikkårer"@sv;
        skos:related     :p15412;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "brass band"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "soittokunta"@fi , "musikkår"@sv , "musihkkagoddi"@se , "brass band"@en .

