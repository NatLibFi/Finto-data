:p25776  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Wikipedia"@fi;
        dct:created      "2012-03-01"^^xsd:date;
        dct:modified     "2024-09-06"^^xsd:date;
        skos:altLabel    "antikvetenskap"@sv , "antiikin tutkimus"@fi;
        skos:broader     :p183;
        skos:closeMatch  <http://www.wikidata.org/entity/Q841090>;
        skos:exactMatch  allars:Y43390 , ysa:Y184595;
        skos:inScheme    :;
        skos:narrower    :p25952;
        skos:note        "Tvärvetenskapligt forskningsområde som undersöker antikens historia och kultur i alla dess uttrycksformer. Med antiken avses i detta sammanhang den s.k. klassiska antiken, alltså antikens Grekland och Rom samt områden som kommit under dessa kulturers inflytande, fram till tidig medeltid."@sv , "Tieteidenvälinen tutkimusala, jonka kohteena ovat antiikin historia ja kulttuuri niiden kaikissa ilmenemismuodoissa. Antiikilla tarkoitetaan tässä yhteydessä yleensä niin sanottua klassista antiikkia eli antiikin Kreikkaa ja Roomaa sekä näiden kulttuurien vaikutuspiiriin joutuneita alueita keskiajan kynnykselle asti"@fi , "A multidisciplinary field focusing on the history and culture of the ancient Mediterranean world up until the early Middle Ages."@en;
        skos:prefLabel   "antikforskning"@sv , "antiikintutkimus"@fi , "classical studies"@en , "antihkkadutkamuš"@se;
        skos:related     :p11348;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26544 , :p26540 .

:p4283  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1998-04-24"^^xsd:date;
        dct:modified     "2023-11-09"^^xsd:date;
