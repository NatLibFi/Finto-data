:p19707  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1986-05-01"^^xsd:date;
        dct:modified     "2023-06-20"^^xsd:date;
        skos:broader     :p125;
        skos:closeMatch  <http://www.wikidata.org/entity/Q234213> , <http://id.loc.gov/authorities/subjects/sh85001045>;
        skos:exactMatch  allars:Y29375 , ysa:Y100981;
        skos:inScheme    :;
        skos:note        "Avser brott mot strafflag, i vilket en gift person har sexuellt umgänge med en person utanför äktenskapet. I Finland var detta ett brott enligt strafflagen fram till år 1948. I en del länder är äktenskapsbrott fortfarande kriminaliserat."@sv , "Rikoslain alainen rikos, jossa avioliitossa elävä henkilö harjoittaa sukupuoliyhteyttä muun kuin oman aviopuolisonsa kanssa. Suomessa tämä oli rikoslain alainen rikos vuoteen 1948. Aviorikos on kuitenkin rikoslain alainen asia monissa maissa edelleen."@fi;
        skos:prefLabel   "adulteries (crimes)"@en , "aviorikokset"@fi , "äktenskapsbrott"@sv , "náittosrihkkosat"@se;
        skos:related     :p39918;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26559;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "aviorikos"@fi , "adultery (crimes)"@en , "náittosrihkus"@se .

