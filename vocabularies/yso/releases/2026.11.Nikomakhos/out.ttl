        skos:closeMatch  <http://www.wikidata.org/entity/Q20920218>;
        skos:exactMatch  allars:Y25761 , ysa:Y117628;
        skos:inScheme    :;
        skos:note        "Avser verksamhet med syfte att stöda klineter som är i behov av särskild service, sammanställa uppgifter om social- och hälsovårdstjänster och annan social trygghet som klienter är berättigade till, samt ge råd till och handleda klienter i användningen av tjänsterna."@sv , "Tarkoittaa toimintaa, jonka tarkoituksena on tukea erityisen palvelun tarpeessa olevan asiakkaan selviytymistä, koota keskitetysti yhteen tiedot asiakkaalle kuuluvista sosiaali- ja terveydenhuollon palveluista ja muusta sosiaaliturvasta sekä neuvoa ja ohjata asiakasta palvelujen käytössä."@fi;
        skos:prefLabel   "servicerådgivning"@sv , "bálvalusbagadallan"@se , "palveluohjaus"@fi , "service counselling"@en;
        skos:related     :p3307 , :p1307;
