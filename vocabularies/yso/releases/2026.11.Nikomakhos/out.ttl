:p27273  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "2013-12-19"^^xsd:date;
        dct:modified        "2024-01-23"^^xsd:date;
        skos:altLabel       "koulunkäynnin ohjaajat"@fi;
        skos:broader        :p30185;
        skos:editorialNote  "Aikaisempi huomautus: \nKoulunkäynninohjaajat ovat koulunkäynnin ja aamu- ja iltapäivätoiminnan ammattitutkinnon suorittaneita. He voivat sijoittua koulunkäynnin ohjaustehtäviin esimerkiksi esiopetuksessa ja perusopetuksessa, aamu- ja iltapäivätoiminnan ja vapaa-ajantoiminnan tehtäviin sekä toimia avustajana päivähoidossa.(http://www.takk.fi/?id=koulutusesite&esite=1252&koulutus=12622). Tehtävän nimikkeestä on ollut kiistaa, vanhempi nimike on koulunkäyntiavustajat (http://suomenkuvalehti.fi/jutut/kotimaa/uusi-ammattiryhma-koulussa-tehtavan-nimikkeesta-riita/)"@fi;
        skos:exactMatch     allars:Y46386 , ysa:Y196305;
        skos:inScheme       :;
        skos:note           "Motsvarande yrke var fram till år 2010 <a href='http://www.yso.fi/onto/yso/p16602'>skolgångsbiträden</a>."@sv , "Vuoteen 2010 vastaava ammatti on ollut <a href='http://www.yso.fi/onto/yso/p16602'>koulunkäyntiavustajat</a>."@fi;
        skos:prefLabel      "special needs teaching assistants"@en , "koulunkäynninohjaajat"@fi , "skuvlavázzinbagadallit"@se , "skolgångshandledare"@sv;
        skos:related        :p16602;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26554 , :p26549;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "koulunkäynnin ohjaaja"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "special needs teaching assistant"@en , "koulunkäynninohjaaja"@fi , "skuvlavázzinbagadalli"@se .

