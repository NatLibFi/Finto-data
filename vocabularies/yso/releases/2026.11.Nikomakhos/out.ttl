:p25441  rdf:type                <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source                "http://www.martinkeitel.net/tietoinensydan/2011/dietrich.htm"@fi;
        dct:created              "2011-10-05"^^xsd:date;
        dct:modified             "2025-08-25"^^xsd:date;
        skos:altLabel            "cosmoterapi"@sv , "cosmomusiikki"@fi , "kosmomusiikki"@fi;
        skos:broader             :p391 , :p392;
        skos:exactMatch          ysa:Y181656 , allars:Y50259;
        skos:inScheme            :;
        skos:note                "Kosmoterapia on moniaistinen terapiamuoto, joka hyödyntää eri aisteja sekä luovaa yhdessäoloa. Terapian kehitti saksalainen Dietrich Gümbel, ja se perustuu hänen kokemukseensa hoidoista yrttiöljyillä ja tutkimuksiin värien, sävelten ja kivien vaikutuksista ihmiskehoon."@fi , "Behandlingsform utvecklad av Dietrich Gümbel, som grundar sig på behandling med örtoljor och på färgers, toners och stenars inverkan på kroppen."@sv;
        skos:prefLabel           "kosmoterapia"@fi , "cosmomusic"@en , "kosmoterapiija"@se , "kosmoterapi"@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26550;
        yso-update:newGroup      :p26550;
        yso-update:removedGroup  :p26571 , :p26532 .

