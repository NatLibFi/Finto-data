        skos:exactMatch  ysa:Y118837 , allars:Y19311;
        skos:inScheme    :;
        skos:note        "Kauppakeskus muodostuu liikerakennuksesta, jossa tyypillisesti kulku myymälöihin ja palveluihin on mahdollista sisätiloissa, esimerkiksi rakennuksen sisällä olevan käytävän tai aukion kautta. Kauppakeskuksessa on vähintään 10 liikettä ja sen huoneistoala on yli 5000 m2."@fi , "Köpcentrum som utgörs av en affärsbyggnad, i vilken ingång till butiker och service är möjlig inomhus, t.ex. via en korridor eller öppen plan inne i byggnaden. I handelscentrum finns minst 10 butiker och ytan är över 5000 m2."@sv;
        skos:prefLabel   "köpcentrum"@sv , "gávpeguovddážat"@se , "kauppakeskukset"@fi , "shopping centres"@en;
        skos:related     :p10614 , :p39308 , :p10613 , :p1132;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26538 , :p26526;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "shopping center"@en , "butiksgalleria"@sv , "affärsgalleria"@sv , "kauppagalleria"@fi , "galleria (köpcentrum)"@sv , "handelscentrum"@sv , "större köpcentrum"@sv;
