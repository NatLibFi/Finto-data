:p3115  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-08-28"^^xsd:date;
        dct:modified     "2024-08-28"^^xsd:date;
        skos:altLabel    "förstörelseverk"@sv , "tuhopoltto"@fi , "anlagd brand"@sv , "sabotage (juridisk kategori)"@sv;
        skos:broader     :p125 , :p38217;
        skos:definition  "Tuhotyö on rikoslain mukaan yleisvaarallinen rikos, joka aiheuttaa yleistä hengen tai terveyden vaaraa, huomattavan taloudellisen vahingon vaaraa, tai vakavaa vaaraa energiahuollolle, yleiselle terveydenhuollolle, maanpuolustukselle, oikeudenhoidolle tai muulle näihin rinnastettavalle yhteiskunnan tärkeälle toiminnolle."@fi , "Avser allmänfarligt brott som orsakar allmän fara för liv eller hälsa, betydande ekonomisk skada, eller fara för energiförsörjningen, den allmänna hälsovården, försvaret, rättsvården eller någon med dessa jämförbar viktig samhällsfunktion."@sv;
        skos:exactMatch  allars:Y25505 , ysa:Y109931;
        skos:inScheme    :;
        skos:note        "Ersatte i lagtext 21.4.1995 bl.a. termen mordbrand."@sv , "Korvannut lakitekstissä 21.4.1995 mm. termin murhapoltto."@fi;
        skos:prefLabel   "tuhotyö"@fi , "duššadandahku"@se , "sabotage (brott)"@sv , "criminal mischief"@en;
        skos:related     :p3113 , :p1662;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26559 .

