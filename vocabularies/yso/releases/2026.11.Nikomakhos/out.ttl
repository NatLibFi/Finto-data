:p29908  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2017-07-11"^^xsd:date;
        dct:modified     "2024-07-12"^^xsd:date;
        skos:altLabel    "notturnos"@sv;
        skos:broader     :p1513;
        skos:definition  "1700-luvulta peräisin olevia moniosaisia soitinsävellyksiä, joita perinteisesti esitettiin ulkona yöaikaan."@fi , "Flerdelade instrumentalkompositioner från 1700-talet, vilka traditionellt framfördes utomhus och nattetid."@sv;
        skos:exactMatch  ysa:Y214793 , allars:Y52080;
        skos:inScheme    :;
        skos:note        "Yötunnelmaisista, yleensä hiljaisista ja luonteeltaan meditatiivisista sävellyksistä, joita on kirjoitettu 1810-luvulta alkaen pääasiassa pianolle tai orkesterille, käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p29794'>nocturnet</a>."@fi , "Om stilla och till sin natur meditativa kompositioner med nattstämning, som komponerats fr.o.m. 1810-talet i huvudsak för piano eller orkester används begreppet <a href='http://www.yso.fi/onto/yso/p29794'>nocturner</a>."@sv;
        skos:prefLabel   "notturno"@sv , "notturnos"@en , "notturnot"@fi , "notturnot"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "notturno"@se , "notturno"@en , "notturno"@fi .

