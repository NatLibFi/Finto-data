        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85125359> , <http://www.wikidata.org/entity/Q131272>;
        skos:definition  "Yhdysvalloissa 1950-luvulla gospelmusiikista ja rhythm and bluesista kehittynyt popmusiikkityyli, josta tuli 1960-luvulla maailmanlaajuisesti suosittua. Tunnettuja edustajia ovat mm. James Brown, Aretha Franklin, The Supremes ja The Temptations."@fi , "Popmusikstil som utvecklades ur gospelmusik och rhythm and blues i USA på 1950-talet, och som på 1960-talet blev populär världsomfattande. Kända företrädare av stilen är bl.a. James Brown, Aretha Franklin, The Supremes och The Temptations."@sv;
        skos:exactMatch  allars:Y26570 , ysa:Y103995;
        skos:inScheme    :;
        skos:prefLabel   "soul"@sv , "soul music"@en , "soul"@se , "soul"@fi;
