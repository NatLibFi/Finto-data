:p25273  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2011-06-22"^^xsd:date;
        dct:modified     "2023-09-05"^^xsd:date;
        skos:broader     :p127;
        skos:closeMatch  <http://www.wikidata.org/entity/Q497592>;
        skos:exactMatch  ysa:Y180293 , allars:Y41542;
        skos:inScheme    :;
        skos:note        "Modaalinen realismi on ontologinen näkemys, jonka mukaan mahdolliset maailmat ovat yhtä todellisia kuin aktuaalinen maailma. Se perustuu ennen kaikkea seuraaviin ajatuksiin: mahdolliset maailmat ovat olemassa, ne eivät ole lajiltaan erilaisia kuin aktuaalinen maailma, niitä ei voida palauttaa muihin entiteetteihin, ja termi \"aktuaalinen\" on aktuaalisten maailmojen tapauksessa indeksikaalinen."@fi , "Ontologiskt synsätt, enligt vilket alla möjliga världar är lika verkliga som den aktuella världen."@sv;
        skos:prefLabel   "modal realism"@en , "modaalinen realismi"@fi , "modal realism"@sv , "modála realisma"@se;
        skos:related     :p1055;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26545 .

