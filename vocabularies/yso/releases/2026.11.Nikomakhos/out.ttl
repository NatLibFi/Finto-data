:p37935  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2018-05-24"^^xsd:date;
        dct:modified     "2023-08-08"^^xsd:date;
        skos:altLabel    "lääkehoidon turvallisuus"@fi , "turvallinen lääkehoito"@fi , "läkemedelstrygghet"@sv;
        skos:broader     :p2726;
        skos:definition  "Läkemedelssäkerhet gäller själva läkemedlet och -preparatet. Till läkemedelssäkerhet hör kännedom om läkemedlets egenskaper och verkningar, en kvalitativ tillverkningsprocess för läkemedlet och information i samband med läkemedlet. Om säkerhet i behandling med läkemedel avses används begreppet <a href='http://www.yso.fi/onto/yso/p37961'>medicineringssäkerhet</a>."@sv , "Lääketurvallisuus liittyy lääkeaineeseen ja -valmisteeseen. Siihen kuuluvat lääkkeen ominaisuuksien ja vaikutusten tunteminen, lääkkeen laadukas valmistusprosessi ja lääkkeeseen liittyvä informaatio."@fi;
        skos:exactMatch  allars:Y52607 , ysa:Y359368;
        skos:inScheme    :;
        skos:prefLabel   "lääketurvallisuus"@fi , "dálkkasdorvvolašvuohta"@se , "läkemedelssäkerhet"@sv , "drug safety"@en;
        skos:related     :p24295 , :p37961 , :p19936;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26550 .

