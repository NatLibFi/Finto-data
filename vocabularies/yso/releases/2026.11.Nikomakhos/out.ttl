:p9489  rdf:type            <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "1995-08-29"^^xsd:date;
        dct:modified        "2023-08-08"^^xsd:date;
        skos:broader        :p38217 , :p14;
        skos:editorialNote  "Poistettu huomautus: 1) olla tai toimia välineenä tai tekijänä, jonka kautta, avulla, jota pitkin jokin siirtyy, toimitetaan jostakin johonkin; olla yhdyssiteenä, -elimenä; 2) toimia välimiehenä, sovittelijana riidassa tms., sovitella, sovittaa; 3) vars. kielteisissä yhteyksissä a) ottaa varteen, huomioon; kiinnittää huomiota, tuntea kiinnostusta, \"piitata\"; b) pitää tarpeellisena; viitsiä, haluta, tahtoa"@fi;
        skos:exactMatch     ysa:Y109130 , allars:Y18677;
        skos:inScheme       :;
