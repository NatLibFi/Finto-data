:p14026  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Lähde: Opetus, oppiminen, vuorovaikutus"@fi;
        dct:created      "2002-03-13"^^xsd:date;
        dct:modified     "2023-08-04"^^xsd:date;
        skos:altLabel    "luonnontieto"@fi , "miljökunskap"@sv , "ympäristötieto"@fi , "naturkunskap"@sv;
        skos:broader     :p5296;
        skos:exactMatch  ysa:Y118240 , allars:Y34297;
        skos:inScheme    :;
        skos:note        "Oppiainekokonaisuus ympäristö- ja luonnontieto mainittiin ensimmäisen kerran vuoden 1994 peruskoulun opetussuunnitelman perusteissa (Opetushallitus 1994). Ympäristö- ja luonnontiedossa yhdistyvät osittain aikaisempien ympäristöä ja luontoa käsitelleiden oppiaineiden (biologian, kansalaistaidon, maantiedon ja ympäristöopin) tavoitteet ja sisällöt"@fi , "Läroämneshelhet som nämndes första gången i grunderna för läroplanen för den grundläggande utbildningen från år 1994. I detta ämne förenades delvis målsättningarna och innehållen i de tidigare läroämnena som behandlade miljö och natur (biologi, medborgarfärdighet, geografi, omgivningslära)."@sv;
        skos:prefLabel   "miljö- och naturkunskap"@sv , "environment and nature studies"@en , "ympäristö- ja luonnontieto"@fi , "biras- ja luonddudiehtu"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26554 .

