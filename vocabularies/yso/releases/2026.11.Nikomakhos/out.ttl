:p11637  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2002-02-18"^^xsd:date;
        dct:modified     "2026-10-08"^^xsd:date;
        skos:altLabel    "inkomstfällor"@sv , "tukiloukut"@fi , "työttömyysloukut"@fi , "tuloloukut"@fi , "unemployment traps"@en , "arbetslöshetsfällor"@sv , "bidragsfällor"@sv , "incitamentsfällor"@sv;
        skos:broader     :p605;
        skos:closeMatch  <http://www.wikidata.org/entity/Q2916679>;
        skos:exactMatch  allars:Y34463 , ysa:Y117544;
        skos:inScheme    :;
        skos:note        "Finlandssvensk term. Det finns två typer av flitfällor. En inkomstfälla innebär att bruttoinkomsternas tillväxt inte följer de disponibla inkomsternas tillväxt. En arbetslöshetsfälla innebär att det inte lönar sig för en person att ta emot arbete, eftersom socialskyddet ger god utkomst."@sv , "Kannustinloukkuja on kahdenlaisia. Tuloloukku tarkoittaa, että bruttotulojen kasvua ei seuraakaan käytettävissä olevien tulojen kasvu. Työttömyysloukku tarkoittaa, että henkilön ei kannata vastaanottaa työtä, koska sosiaaliturva tarjoaa hyvän toimeentulon."@fi;
        skos:prefLabel   "flitfällor"@sv , "kannustinloukut"@fi , "incentive traps"@en;
        skos:related     :p941 , :p12764;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26525 , :p26538 , :p26549;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "incitamentsfälla"@sv , "tukiloukku"@fi , "inkomstfälla"@sv , "tuloloukku"@fi , "arbetslöshetsfälla"@sv , "bidragsfälla"@sv , "unemployment trap"@en , "työttömyysloukku"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "flitfälla"@sv , "incentive trap"@en , "kannustinloukku"@fi .

