        skos:broader     :p29783;
        skos:definition  "Country bluesin keskeisin alueellinen tyylilaji, joka on esitystavaltaan karkeampaa kuin folk blues. Tunnettuja tyylin edustajia ovat mm. Charley Patton, Son House ja Robert Johnson."@fi , "Stilriktning inom country blues, som till sitt framförandesätt var grövre än folkblues. Kända företrädare för stilen var bl.a. Charley Patton, Son House och Robert Johnson."@sv;
        skos:exactMatch  ysa:Y214575 , allars:Y51917;
        skos:inScheme    :;
        skos:prefLabel   "Mississippi-blues"@se , "Mississippi-blues"@sv , "Mississippi blues"@en , "Mississippi-blues"@fi;
        skos:related     :p29868;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

