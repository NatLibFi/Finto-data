:p38010  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2018-06-18"^^xsd:date;
        dct:modified     "2022-12-02"^^xsd:date;
        skos:broader     :p1882;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh00006850>;
        skos:definition  "Saksassa 1960- ja 1970-lukujen taitteessa syntynyt populaarimusiikin genre, jossa tyypillisiä elementtejä ovat toistoon ja pelkistettyyn ilmaisuun perustuva rakenne sekä perinteisen rock-instrumentaation ja elektronisen musiikin soundien yhdistäminen."@fi , "Populärmusikalisk genre som uppkom i Tyskland vid övergången mellan 1960- och 1970-talet. Typiska element i krautrock är en struktur som bygger på upprepning och ett avskalat uttryck, samt kombinering av sound från traditionell rockinstrumentation och elektronisk musik."@sv;
        skos:exactMatch  ysa:Y218841 , allars:Y52621;
        skos:inScheme    :;
        skos:prefLabel   "krautrock"@sv , "krautrock"@se , "krautrock"@fi , "krautrock"@en;
        skos:related     :p29858;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

