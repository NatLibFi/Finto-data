:p2506  rdf:type                     skos:Concept , <http://www.yso.fi/onto/yso-meta/DeprecatedConcept>;
        dct:isReplacedBy             :p37875;
        owl:deprecated               true;
        skos:altLabel                "executive committees"@en , "hallitukset (hallintoelimet)"@fi;
        skos:broadMatch              :p4066;
        skos:broader                 <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        skos:closeMatch              <http://id.loc.gov/authorities/subjects/sh98002035>;
        skos:editorialNote           "en saanut tbc:ssä lisättyä newaltlabel-propertyä, mutta ysa-yso-päivittimen mukaan tälle pitäisi tulla uudeksi altlabeliksi: valtioiden hallitukset"@fi , "Sanastoon otettu \"hallitukset (yhteisöt)\" 2018 alussa. se on kuitenkin merkitykseltään sama kuin tämä ikivanha YSO-käsite, jonka alkuperäinen preflabel oli \"hallitukset (hallintoelimet)\". näiden päällekkäisyys on varmaan jäänyt vain huomaamatta. koska sanastossa ei kannata pitää näitä molempia niin kannattanee deprekoida tuo tuoreempi käsite? ( tältä käsitteeltä korjattiin  definedconcept-suhteet nykyistä YSAa vastaavaksi)" , "tälle käsitteelle tapahtui jotain mystistä. p2506-urillinen käsite poistui kehitysversiosta. ja samalla \"tapahtumat ja toiminta\"-käsitteeseen yhdistyi kaikki tämän käsitteen sisältö. ilmeisesti tämä oli aiemmin muuttuneet listalla. vanhat tiedot palautettiin.";
        skos:exactMatch              allars:Y52495 , ysa:Y217971;
        skos:inScheme                :deprecatedconceptscheme;
        skos:note                    "muut kuin viranomaistahoihin liittyvät hallitukset (esim. yritysten ja yhdistysten hallitukset)"@fi;
        skos:prefLabel               "boards of directors (administrative bodies)"@en , "styrelser"@sv , "hallitukset (yhdistykset ja yritykset)"@fi;
        <http://www.yso.fi/onto/yso-meta/comment>
                "deprecated on 2019-02-20";
        <http://www.yso.fi/onto/yso-meta/deprecatedBroader>
                <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        <http://www.yso.fi/onto/yso-meta/deprecatedHasThematicGroup>
                :p26541 , :p26524;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "executive committee"@en , "hallitus"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "hallitus (yhdistykset ja yritykset)"@fi , "board of directors (administrative bodies)"@en , "styrelse"@sv;
