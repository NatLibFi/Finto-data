:p29992  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-02-09"^^xsd:date;
        dct:modified     "2023-09-02"^^xsd:date;
        skos:altLabel    "mikrointervallmusik"@sv , "kvartstonsmusik"@sv;
        skos:broader     :p1808;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85084939>;
        skos:definition  "Puolisävelaskelta pienempiä tai sitä suurempia mutta kokosävelaskelta pienempiä intervalleja sisältävä musiikin laji, joka esiintyy sekä modernistisena taidemusiikin tyylisuuntana että monien musiikkiperinteiden (esimerkiksi arabialainen musiikki, Intian klassinen musiikki ja monet etniset perinteet) osana."@fi , "Musikart som innehåller tonsprång mindre än halvtonsprång och som förekommer både som en stilriktning inom modernistisk konstmusik och som en del av många musikaliska traditioner (t.ex. arabisk musik, indisk klassisk musik och många etniska traditioner)."@sv;
        skos:exactMatch  allars:Y51786 , ysa:Y214571;
        skos:inScheme    :;
        skos:prefLabel   "mikrotonaalinen musiikki"@fi , "mikrotonála musihkka"@se , "microtonal music"@en , "mikrotonal musik"@sv;
        skos:related     :p12382;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

