:p27293  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "2013-12-19"^^xsd:date;
        dct:modified        "2023-02-08"^^xsd:date;
        skos:altLabel       "salonkitanssit"@fi , "early dances"@en;
        skos:broader        :p3046;
        skos:closeMatch     <http://www.wikidata.org/entity/Q549130>;
        skos:definition     "1900-luvun taitteessa suositut seuratanssit, kuten mignon, pas d'Espagne, pas de quatre, krakoviak, wengerka, kickapoo ja wienervalssi."@fi , "Populära sällskapsdanser vid övergången till 1900-talet, såsom mignon, pas d'Espagne, pas de quatre, krakowiak, wengerka, kickapoo och wienervals."@sv;
        skos:editorialNote  "En-käännös tarkistettu MUSAlaisilta";
        skos:exactMatch     allars:Y51108 , ysa:Y196345;
        skos:inScheme       :;
        skos:note           "Begreppet bör inte sammanblandas med termen gammeldans, med vilken man menar folkliga danser såsom vals, jenka, polka, schottis, mazurka och hambo."@sv , "Käsitettä ei pidä sekoittaa Ruotsissa ja suomenruotsalaisten keskuudessa esiintyvään gammeldans-käsitteeseen, jolla tarkoitetaan kansanomaisia tansseja kuten valssi, jenkka, polkka, sottiisi, masurkka ja hambo."@fi;
        skos:prefLabel      "historical dances"@en , "vanhat tanssit"@fi , "salongsdanser"@sv;
        skos:related        :p37727;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26582;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "salonkitanssi"@fi , "early dance"@en;
