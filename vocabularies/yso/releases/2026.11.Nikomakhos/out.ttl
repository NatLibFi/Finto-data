:p1882  rdf:type         skos:Concept , <http://www.yso.fi/onto/yso-meta/Concept>;
        dct:created      "1987-01-01"^^xsd:date;
        dct:modified     "2024-08-28"^^xsd:date;
        skos:altLabel    "rockmusik"@sv , "rohkka"@se;
        skos:broader     :p2969;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85114675> , <http://www.wikidata.org/entity/Q11399>;
        skos:definition  "Populärmusikalisk genre som utvecklats i USA ur rock and roll och svart musik och sedan spridit sig i hela världen som en av de mest populära stilarna. Karakteristiskt för rockmusik är relativt snabbt tempo, betoning av den andra och fjärde taktdelen (back beat) och enkel, elektrisk musikalisk besättning (elgitarrer, elbas, trummor). Under andra delen av 1900-talet uppkom en stor mängd olika varianter av rock, som med avseende på definition är svåra att avskilja från varandra."@sv , "Yhdysvalloissa rock and rollista ja mustan musiikin muodoista kehittynyt popmusiikin laji, joka on levinnyt kaikkialle maailmassa erääksi suosituimmista populaarimusiikin tyyliryhmistä. Rock-musiikille on ominaista suhteellisen nopea tempo, toisen ja neljännen tahdinosan korostaminen (back beat) ja yksinkertainen, sähköinen esityskokoonpano (sähkökitarat, sähköbasso, rummut). 1900-luvun toisella puoliskolla syntyi suuri määrä rockin muunnelmia, joiden määritelmällinen erottaminen toisistaan on usein erittäin vaikeaa."@fi;
        skos:exactMatch  ysa:Y98616 , allars:Y25261;
        skos:inScheme    :;
        skos:narrower    :p29858 , :p5499 , :p1881 , :p10995 , :p10250 , :p29904 , :p29762 , :p19827 , :p15274 , :p17581 , :p28632 , :p38041 , :p29778 , :p15521 , :p29926 , :p30108 , :p21503 , :p29226 , :p27390 , :p30039 , :p38010 , :p37978 , :p39342 , :p30129 , :p30084;
        skos:prefLabel   "rock music"@en , "rock (musik)"@sv , "rock"@fi , "rock"@se;
        skos:related     :p12376 , :p12377 , :p30013 , :p12061 , :p29886 , :p22463 , :p30128 , :p7198 , :p12374 , :p12375;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

