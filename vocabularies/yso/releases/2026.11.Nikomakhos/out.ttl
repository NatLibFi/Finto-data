        skos:exactMatch  allars:Y20041 , ysa:Y95556;
        skos:inScheme    :;
        skos:note        "The Finnish population of Ingria that descends from Lutheran Finnish immigrants who moved into the area in the 17th century. For the Finnic people native to Ingria, who traditionally speak the Ingrian language, use <a href='http://www.yso.fi/onto/yso/p20725'>Izhorians</a>."@en , "Folkgrupp som härstammar från den finska invandringen till Ingermanland under främst 1600-talet. Om det ursprungliga östersjöfinska folket i Ingermanland, som talade ingriska, används begreppet <a href='http://www.yso.fi/onto/yso/p20725'>ingrer</a>."@sv , "Tarkoittaa Suomesta etenkin 1600-luvulla Inkeriin siirtyneitä suomalaisia. Alkuperäisestä itämerensuomalaisesta, perinteisesti inkeroisen kieltä puhuvasta väestöstä käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p20725'>inkerikot</a>."@fi;
        skos:prefLabel   "inkerilaččat"@se , "Ingrians"@en , "inkeriläiset"@fi , "ingermanlänningar"@sv;
        skos:related     :p9534 , :p12667 , :p20725 , :p9533;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26532;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "Ingrian Finn"@en , "inkerinsuomalainen"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "ingermanlänning"@sv , "inkeriläinen"@fi , "Ingrian"@en , "inkerilaš"@se .

