        skos:closeMatch  <http://www.wikidata.org/entity/Q34147>;
        skos:exactMatch  allars:Y17998 , ysa:Y101370;
        skos:inScheme    :;
        skos:note        "Den nederländska som talas i Belgien har kallats flamländska. Numera avser flamländska flamländarnas talspråk och dialekten i Flanderna, vilken språkvetenskapligt anses vara en dialekt av nederländska."@sv , "Belgiassa puhuttavaa hollannin kieltä on kutsuttu flaamin kieleksi. Nimitys flaamin kieli tarkoittaa nykyään flaamien puhekieltä ja Flanderin murretta, jota kielitieteellisessä mielessä pidetään yhtenä etelähollannin murteena."@fi;
        skos:prefLabel   "flámagiella"@se , "Flemish language"@en , "flamländska"@sv , "flaamin kieli"@fi;
        skos:related     :p15311;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26557 .

