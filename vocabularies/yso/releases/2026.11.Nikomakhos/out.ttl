:p10544  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1987-01-01"^^xsd:date;
        dct:modified     "2024-03-12"^^xsd:date;
        skos:broader     :p5070;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85022426> , <http://www.wikidata.org/entity/Q2470540>;
        skos:exactMatch  ysa:Y102142 , allars:Y20536;
        skos:inScheme    :;
        skos:narrower    :p15915;
        skos:prefLabel   "kammarorkestrar"@sv , "kamariorkesterit"@fi , "gámmárorkesterat"@se , "chamber orchestras"@en;
        skos:scopeNote   "Besättning i vilken ingår representanter från minst två instrumentfamiljer och med högst ca 25 instrumentalister. Om besättningar som är större än så används begreppen <a href='http://www.yso.fi/onto/yso/p5070'>orkestrar</a>, <a href='http://www.yso.fi/onto/yso/p19581'>symfoniorkestrar</a> och <a href='http://www.yso.fi/onto/yso/p16416'>blåsorkestrar</a>. Om ensembler med bara stråkinstrument (därtill kan det finnas några slaginstrument) används begreppet <a href='http://www.yso.fi/onto/yso/p15915'>stråkorkestrar</a>."@sv , "Kamariorkesterina pidetään esityskokoonpanoa, jossa on edustajia vähintään kahdesta soitinperheestä ja jossa on korkeintaan noin 25 soittajaa. Tätä suuremmista kokoonpanoista käytetään käsitteitä <a href='http://www.yso.fi/onto/yso/p5070'>orkesterit</a>, <a href='http://www.yso.fi/onto/yso/p19581'>sinfoniaorkesterit</a> ja <a href='http://www.yso.fi/onto/yso/p16416'>puhallinorkesterit</a>. Jos kokoonpanossa on vain jousisoittimia (lisäksi voi olla joitakin lyömäsoittimia), käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p15915'>jousiorkesterit</a>."@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "kammarorkester"@sv , "gámmárorkester"@se , "chamber orchestra"@en , "kamariorkesteri"@fi .

