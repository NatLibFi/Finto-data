:p29942  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1997-09-30"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "dark ambient"@fi , "experimental ambient"@fi , "dark ambient"@en , "experimental ambient"@sv , "dark ambient"@se , "experimental ambient"@se , "experimental ambient"@en , "dark ambient"@sv;
        skos:broader     :p23218;
        skos:closeMatch  <http://www.wikidata.org/entity/Q193207> , <http://id.loc.gov/authorities/subjects/sh2006005853>;
        skos:definition  "Populärmusikstil som uppkom på 1970-talet och i vilken olika, vanligtvis harmoniska, ljudmiljöer skapas med främst elektroniska instrument. I ren ambientmusik har rytm endast liten betydelse. Begreppet används främst om musik efter 1975."@sv , "1970-luvulla syntynyt populaarimusiikkityyli, jossa on pyritty luomaan yleensä elektronisin soittimin erilaisia, tavallisesti harmonisia ääniympäristöjä. Puhtaassa ambient-musiikissa rytmillä on hyvin pieni merkitys. Käsitettä suositellaan käytettäväksi lähinnä vain vuoden 1975 jälkeen syntyneestä musiikista."@fi;
        skos:exactMatch  allars:Y51876 , ysa:Y214390;
        skos:inScheme    :;
        skos:note        "Ordet förekommer också som en del i olika genren skapade på 1990-talet ur ravekulturen (t.ex. ambient dub, ambient house, ambient pop, ambient techno). I samband med dessa används deras överordnade begrepp (dub, house, popmusik, techno etc.)."@sv , "Termi esiintyy myös osana 1990-luvulla rave-kulttuurin johdannaisena luoduista genreistä käytettäviä nimityksiä (esim. ambient dub, ambient house, ambient pop, ambient techno). Näiden yhteydessä suositellaan käytettäväksi niiden yläkäsitteitä (dub, house, popmusiikki, tekno jne.)."@fi;
        skos:prefLabel   "ambient music"@en , "ambient"@se , "ambient"@sv , "ambient"@fi;
        skos:related     :p29901 , :p12377 , :p19199 , :p30069 , :p29953 , :p30116;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

