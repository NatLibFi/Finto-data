:p6279  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Lähde: Ympäristöterveysohjelma (Maailman terveysjärjestön määritelmä ympäristöterveydestä)"@fi;
        dct:created      "1996-03-12"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "miljö och hälsa"@sv;
        skos:broader     :p28822;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85044173> , <http://www.wikidata.org/entity/Q932068>;
        skos:exactMatch  allars:Y22822 , ysa:Y109616;
        skos:inScheme    :;
        skos:narrower    :p28408;
        skos:note        "Inbegriper de aspekter på människans hälsa och sjukdom som miljöfaktorer påverkar. Avser också den teori och de praktiska åtgärder, med vilka man utvärderar och kontrollerar hälsopåverkande faktorer i miljön."@sv , "Ympäristöterveyteen sisältyvät ne ihmisen terveyden ja sairauden näkökulmat, joihin ympäristötekijät vaikuttavat. Sillä tarkoitetaan myös sitä teoriaa ja niitä käytännön toimenpiteitä, joilla arvioidaan ja hallitaan ympäristössä olevia terveyteen vaikuttavia tekijöitä."@fi;
        skos:prefLabel   "birasdearvvašvuohta"@se , "miljöhälsa"@sv , "ympäristöterveys"@fi , "environmental health"@en;
        skos:related     :p39575 , :p1105 , :p2762;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26550 , :p26560 .

