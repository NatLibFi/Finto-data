:p29932  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2016-10-26"^^xsd:date;
        dct:modified     "2023-04-01"^^xsd:date;
        skos:altLabel    "breakbeat"@sv , "electronic dance music"@sv , "rave-musiikki"@fi , "elektronisk musik"@sv , "breakbeat"@en , "EDM"@se , "electronic dance music"@se , "EDM"@sv , "electronic dance music"@fi , "EDM"@fi , "klubimusiikki"@fi , "elektrovnnalaš musihkka"@se , "ravemusik"@sv , "breakbeat"@fi , "breakbeat"@se , "klubbmusik"@sv , "elektroninen musiikki"@fi , "EDM"@en;
        skos:broader     :p2969 , :p23218;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh00000588> , <http://www.wikidata.org/entity/Q851213>;
        skos:definition  "Elektroniskt producerad popmusik avsedd för dans, som vanligen präglas av kraftig rytm skapad med trummaskin, melodi skapad med sampler eller syntetisator samt snabbt tempo. Sångens roll är vanligen obetydlig och musiken är ofta instrumental, undantaget dance."@sv , "Elektronisesti tuotettu, klubiympäristöön tarkoitettu tanssittava popmusiikki, jota luonnehtii yleensä rumpukoneen luoma voimakas rytmi, samplerilla tai syntetisaattorilla luotu melodia sekä nopea tempo. Laulun rooli on yleensä vähäinen ja musiikki usein enimmäkseen instrumentaalista, poikkeuksena kuitenkin dance."@fi;
        skos:exactMatch  allars:Y52231 , ysa:Y214456;
        skos:inScheme    :;
        skos:narrower    :p30149 , :p29943 , :p39083 , :p30024 , :p14614 , :p12377 , :p29901;
        skos:prefLabel   "elektrovnnalaš dánsamusihkka"@se , "elektroninen tanssimusiikki"@fi , "elektronisk dansmusik"@sv , "electronic dance music"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

