        skos:editorialNote  "Instanssi.";
        skos:exactMatch     ysa:Y198244 , allars:Y46420;
        skos:inScheme       :;
        skos:note           "Villa från sekelskiftet 1900 på Drumsö i Helsingfors, ägd av Kvinnosaksförbundet Unionen. Villan ägdes från början av företagsledare och donator Ida Salin, som skänkte villan med namnet Solvikstorp till Kvinnosaksförbundet Unionen år 1952."@sv , "Naisasialiitto Unionin omistama 1900-luvun vaihteen huvila Helsingin Lauttasaaressa. Huvilan omisti alunperin yritysjohtaja ja lahjoittaja Ida Salin, joka lahjoitti Solvikstorp-nimisen huvilan Naisasialiitto Unionille vuonna 1952."@fi;
        skos:prefLabel      "Villa Salin"@sv , "Villa Salin"@fi , "Villa Salin"@en , "Villa Salin"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26552 .

