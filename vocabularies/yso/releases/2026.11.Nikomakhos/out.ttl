:p16785  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1990-04-11"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:broader     :p16228;
        skos:closeMatch  <http://www.wikidata.org/entity/Q2496949>;
        skos:definition  "Komposition som kompositören namngett sorgmarsch (marche funèbre, marcia funebre), eller som man vet är avsedd för detta ändamål. Vanligen präglas sorgmarscher av långsamt tempo, from stämning och avsaknad av stora dynamiska växlingar."@sv , "Marssi, jolle säveltäjä on antanut tällaisen nimen (marche funèbre, marcia funebre), sekä marssi, joka tiedetään tarkoitetun surumarssiksi. Surumarssilla ei ole mitään objektiivisia ominaisuuksia, mutta yleensä niihin liitetään hidas tempo, harras tunnelma ja suurten dynaamisten vaihteluiden välttäminen."@fi;
        skos:exactMatch  allars:Y26560 , ysa:Y103429;
        skos:inScheme    :;
        skos:prefLabel   "surumarssit"@fi , "dead marches"@en , "sorgmarscher"@sv;
        skos:related     :p16784;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "surumarssi"@fi , "sorgmarsch"@sv , "dead march"@en .

