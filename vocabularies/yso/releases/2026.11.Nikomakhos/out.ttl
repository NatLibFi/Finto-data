:p8718  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Lähde: Gascoigne, S. Kiinalainen tie terveyteen"@fi;
        dct:created      "2001-01-16"^^xsd:date;
        dct:modified     "2025-04-10"^^xsd:date;
        skos:altLabel    "chi kung"@fi , "qi gong"@fi;
        skos:broader     :p15095;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85023204> , <http://www.wikidata.org/entity/Q204368>;
        skos:exactMatch  allars:Y39190 , ysa:Y113491;
        skos:inScheme    :;
        skos:note        "Kinesisk lära om upprätthållande, stärkande och regeneration av kroppens qi alltså energi, med hjälp av rörelser och andliga övningar. Används också som behandlingsmetod, som innefattar rörelserserier, andnings- och meditationsövningar."@sv , "Qigong on kiinalainen oppi ruumiin qin eli energian ylläpidosta, vahvistamisesta ja elvyttämisestä ruumiillisen liikunnan ja henkisten harjoitusten avulla. Qigongia käytetään myös hoitomenetelmänä, joka käsittää liikesarja- hengitys- ja meditaatioharjoituksia."@fi;
        skos:prefLabel   "qigong"@sv , "qigong"@fi , "qigong"@se , "qi gong"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26550 .

