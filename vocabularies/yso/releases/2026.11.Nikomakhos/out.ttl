:p28047  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2014-06-12"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "regueton"@fi;
        skos:broader     :p2969;
        skos:closeMatch  <http://www.wikidata.org/entity/Q202930>;
        skos:definition  "Popmusikgenre som blev populär bland den latinamerikanska ungdomen i slutet av 1990-talet. Reggaeton uppstod i Panama med namnet reggae en espanol, och har spridit sig särskilt till Puerto Rico, USA och Europa fr.o.m. början av 2000-talet. I reggaeton blandas jamaikanska musikinfluenser (reggae och dancehall) med de latinamerikanska bomba-, plena-, och hiphopstilarna. Reggaeton sammankopplas vanligen med rap på spanska."@sv , "Popmusiikin laji, joka tuli suosituksi 1990-luvun lopulla latinalaisamerikkalaisen nuorison keskuudessa. Se syntyi Panamassa nimellä reggae en espanol ja on levinnyt erityisesti Puerto Ricoon, Yhdysvaltoihin ja Eurooppaan 2000-luvun alkupuolelta lähtien. Reggaeton sekoittaa jamaikalaisia musiikkivaikutteita (reggaeta ja dancehallia) latinalaisen Amerikan bomba-, plena- sekä hip hop -musiikkeihin. Reggaetoniin yhdistetään yleensä espanjankielistä räppäystä."@fi;
        skos:exactMatch  allars:Y46661 , ysa:Y199290;
        skos:inScheme    :;
        skos:prefLabel   "reggaeton"@fi , "reggaeton"@sv , "reggaeton"@en , "reggaeton"@se;
        skos:related     :p180 , :p14614 , :p2968 , :p14336 , :p27970;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

<http://www.yso.fi/onto/yso/p18510#xl_prefLabel_en_100115>
        rdf:type      <http://www.w3.org/2008/05/skos-xl#Label>;
        dct:created   "2026-08-31"^^xsd:date;
        dct:modified  "2026-08-31"^^xsd:date;
        skos:note     "Kouluneuvos is a term related to Finnish society with no exact equivalent in English. Kouluneuvos is the singular form. The plural form is kouluneuvokset."@en;
