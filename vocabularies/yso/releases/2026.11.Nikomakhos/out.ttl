:p25509  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2011-02-28"^^xsd:date;
        dct:modified     "2022-10-13"^^xsd:date;
        skos:altLabel    "historian käyttö"@fi , "historiankäyttö"@fi , "historiebruk"@sv;
        skos:broader     :p372;
        skos:definition  "Tarkoittaa kaikkia niitä tapoja, joilla menneisyyttä koskevia mielikuvia ja tietoja tuotetaan ja käytetään. Historiakulttuuri muodostuu erilaisista menneisyyden kohtaamisen muodoista, tavoista ja tapahtumista sekä menneisyydelle annetuista merkityksistä."@fi , "Avser alla de sätt, på vilka information och uppfattningar som rör det förflutna skapas och används. Historiekultur bildas av olika former och sätt för att möta det förlutna, händelser och de betydelser som tilldelas det förlutna."@sv;
        skos:exactMatch  allars:Y40270 , ysa:Y177658;
        skos:inScheme    :;
        skos:prefLabel   "history culture"@en , "historiekultur"@sv , "historiakulttuuri"@fi , "historjákultuvra"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26532 , :p26540 .

