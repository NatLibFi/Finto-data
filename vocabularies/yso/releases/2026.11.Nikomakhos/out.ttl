:p4485  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1989-01-01"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "African-American music"@en;
        skos:broader     :p1808;
        skos:closeMatch  <http://www.wikidata.org/entity/Q388207> , <http://id.loc.gov/authorities/subjects/sh85001968>;
        skos:definition  "Musiikinlajit, jotka ovat syntyneet ja muotoutuneet afrikkalaisten musiikkikulttuureiden sulautuessa amerikkalaiseen kulttuuriin aina afrikkalaisten orjien tuonnista 1400-luvulta 1800-luvulle ja sen jälkeen afrikkalaista syntyperää olevien amerikkalaisten keskuudessa."@fi , "Musikstilar som har uppkommit vid den afrikanska musikkulturens sammansmältning med den amerikanska kulturen, ända från det att afrikanska slavar fördes till landet till efter det bland amerikaner med afrikansk härkomst."@sv;
        skos:exactMatch  allars:Y14972 , ysa:Y94518;
        skos:inScheme    :;
        skos:narrower    :p29990 , :p29816 , :p14995 , :p4482 , :p4484 , :p15777;
        skos:prefLabel   "afroamerikkalainen musiikki"@fi , "afroamerihkálaš musihkka"@se , "afroamerikansk musik"@sv , "Afro-American music"@en;
        skos:related     :p3064 , :p14996;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

