:p14300  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "http://fi.wikipedia.org/wiki/Sadutus"@fi;
        dct:created      "2002-02-20"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "saduttaminen"@fi , "barns sagoberättande"@sv;
        skos:broader     :p14;
        skos:closeMatch  <http://www.wikidata.org/entity/Q11891895>;
        skos:exactMatch  ysa:Y117647 , allars:Y15757;
        skos:inScheme    :;
        skos:note        "Narratiivinen menetelmä, jossa uusi tarina syntyy vapaasti muotoutuen kertojan ja saduttajan välillä. Saduttaja kirjaa kerrotun tarinan sellaisenaan muistiin ja lukee sen kertojalle, joka voi halutessaan vielä tehdä muutoksia ja korjauksia. Menetelmää voi soveltaa eri-ikäisten parissa erilaisissa ympäristöissä."@fi , "En metod där barn får berätta för vuxna och de vuxna lyssnar och antecknar utan att lägga sig i och föreslå. Texten läses sedan högt och berättaren kan göra ändringar."@sv;
        skos:prefLabel   "sagotering"@sv , "sadutus"@fi , "storycrafting method"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26554 .

:p29880  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-02-08"^^xsd:date;
        dct:modified     "2020-10-09"^^xsd:date;
        skos:broader     :p5070 , :p27211;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85127813>;
        skos:definition  "Trinidadin saarella 1930-luvulla kehittynyt esityskokoonpano, jonka soittimisto koostuu steel-rummuista (alun perin valmistettu tyhjistä öljytynnyreistä) ja joskus myös muista rytmisoittimista."@fi , "Ensembletyp som utvecklades på ön Trinidad på 1930-talet, och som består av steel pan (ursprungligen tillverkade av tomma oljetunnor) och ibland även andra rytminstrument."@sv;
        skos:exactMatch  ysa:Y214679 , allars:Y51743;
        skos:inScheme    :;
        skos:prefLabel   "steel bandit"@fi , "steel bands"@en , "steel band"@sv;
        skos:related     :p29959;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "steel band"@fi , "steel band"@en .

