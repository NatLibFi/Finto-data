        dc:source        "Lähde: Tepa-termipankki"@fi;
        dct:created      "1986-10-01"^^xsd:date;
        dct:modified     "2022-10-13"^^xsd:date;
        skos:altLabel    "tiedonsiirtoverkot"@fi , "datasiirtoverkot"@fi , "televerkot"@fi , "telenät"@sv , "datakommunikationsnät"@sv , "telecommunications networks"@en;
        skos:broader     :p5569;
        skos:exactMatch  allars:Y27541 , ysa:Y99527;
        skos:inScheme    :;
        skos:narrower    :p2001 , :p4119 , :p1956 , :p7503 , :p2002 , :p26359 , :p12758 , :p8348 , :p24221 , :p10248 , :p16814 , :p15744;
        skos:note        "Tiedonsiirto- ja välitysjärjestelmien ja muiden tietoliikennepalveluihin tarvittavien laitteiden muodostama kokonaisuus, jossa voidaan sähkömagneettisen menetelmän avulla siirtää informaatiota liitäntäpisteestä toiseen. Tele- eli tietoliikenneverkossa käytettävät sähkömagneettiset menetelmät voivat perustua esimerkiksi radioyhteyden tai optisen yhteyden hyödyntämiseen."@fi , "Den övergripande utrustning som krävs för data- överföringssystem och annan datakommunikation så att information på elektromagnetisk väg kan förmedlas från en anslutningspunkt till en annan. De elektromagnetiska tillämpningar som används för tele- eller datakommunikationsnät kan bygga på t.ex. radioförbindelse eller optiska förbindelser."@sv;
        skos:prefLabel   "data communications networks"@en , "diehtojohtolatfierpmit"@se , "tietoliikenneverkot"@fi , "telekommunikationsnät"@sv;
        skos:related     :p38807 , :p8944 , :p12936;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26542;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "telecommunication network"@en , "tiedonsiirtoverkko"@fi , "televerkko"@fi , "datasiirtoverkko"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "diehtojohtolatfierbmi"@se , "tietoliikenneverkko"@fi , "data communication network"@en .

