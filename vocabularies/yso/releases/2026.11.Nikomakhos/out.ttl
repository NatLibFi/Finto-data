:p30149  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2005-06-17"^^xsd:date;
        dct:modified     "2023-04-12"^^xsd:date;
        skos:altLabel    "drum 'n' bass"@sv , "drum and bass"@fi , "drum and bass"@se , "jungle"@fi , "drum and bass"@sv , "jungle"@se , "drum'n'bass"@fi , "jungle"@sv;
        skos:broader     :p29932;
        skos:closeMatch  <http://www.wikidata.org/entity/Q188994>;
        skos:definition  "Elektronisen tanssimusiikin alalaji, joka kehittyi Englannissa 1990-luvun alkupuolella hardcore-teknosta. Jungle on drum 'n' bassin rinnakkainen ilmiö (enemmän reggaevaikutteinen) ja molemmat perustuvat nopeisiin polyrytmeihin ja synkopoituun breakbeatiin sekä matalataajuisiin bassokulkuihin."@fi , "Underart till elektronisk dansmusik, som utvecklades ur hardcore techno i England i början av 1990-talet. Jungle är ett parallellt fenomen (men mera reggaeinfluerad) och bägge grundar sig på snabba polyrytmer och synkoperad breakbeat samt lågfrekventa basgångar."@sv;
        skos:exactMatch  ysa:Y214449 , allars:Y51981;
        skos:inScheme    :;
        skos:prefLabel   "drum 'n' bass"@se , "drum'n'bass"@sv , "drum 'n' bass"@en , "drum 'n' bass"@fi;
        skos:related     :p29901 , :p12377 , :p14614 , :p29943 , :p14336;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

