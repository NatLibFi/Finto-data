:p29776  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2005-06-17"^^xsd:date;
        dct:modified     "2023-04-05"^^xsd:date;
        skos:altLabel    "cityblues"@fi , "cityblues"@sv;
        skos:broader     :p4482;
        skos:definition  "1920- ja 1930-luvuilla kaupungeissa kehittynyt bluesin tyylilaji, joka on yleensä akustista pienyhtyebluesia selvin yhteyksin jazziin. City bluesin edustajia ovat mm. Big Maceo, Tampa Red, ja Sonny Boy Williamson I."@fi , "Underart till blues som utvecklats i städerna på 1920- och 1930-talen och som vanligen är akustisk och spelas i små band, samt har klara band till jazz. Företrädare för city blues är t.ex. Big Maceo, Tampa Red och Sonny Boy WIlliamson I."@sv;
        skos:exactMatch  allars:Y51890 , ysa:Y214436;
        skos:inScheme    :;
        skos:note        "Myöhempien aikojen kaupunkilaisbluesista käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p29946'>urban blues</a>."@fi , "Om senare tiders stadsblues används begreppet <a href='http://www.yso.fi/onto/yso/p29946'>urban blues</a>."@sv;
        skos:prefLabel   "city blues"@en , "city blues"@sv , "city blues"@fi , "city blues"@se;
        skos:related     :p29783 , :p29946 , :p4483;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

