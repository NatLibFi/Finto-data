:p27059  rdf:type        skos:Concept , <http://www.yso.fi/onto/yso-meta/Concept>;
        dct:created      "2013-07-12"^^xsd:date;
        dct:modified     "2024-05-16"^^xsd:date;
        skos:broader     :p40210;
        skos:exactMatch  ysa:Y193826 , allars:Y45859;
        skos:inScheme    :;
        skos:note        "Näyttötutkintomestarit ovat näyttötutkintojärjestelmän asiantuntijoita. Näyttötutkintomestarin koulutus on tarkoitettu pääsääntöisesti aikuiskoulutuksessa ja tutkintotilaisuuksien järjestämisessä työskenteleville opettajille, oppilaitosjohdolle sekä työelämässä tutkinnonsuorittajien ammattitaitoa arvioiville henkilöille. Koulutusta  (25 ov) tarjoavat monet ammattikorkeakoulut ja ammatilliset opettajakorkeakoulut."@fi , "Examensmästare organiserar fristående examina, handleder examinander, arrangerar examenstillfällen på arbetsplatser, bedömer examinander, introducerar bedömare i sin uppgift och sköter det pappersarbete som hör till bedömningsprocessen och avläggandet av examen."@sv;
        skos:prefLabel   "näyttötutkintomestarit"@fi , "specialists in competence based qualifications"@en , "examensmästare"@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26554;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "specialist in competence base qualifications"@en , "näyttötutkintomestari"@fi .

