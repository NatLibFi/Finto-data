:p1807  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1987-01-01"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "muzak"@fi , "muzak"@sv;
        skos:broader     :p1808;
        skos:closeMatch  <http://www.wikidata.org/entity/Q1353390> , <http://id.loc.gov/authorities/subjects/sh87006893>;
        skos:definition  "Liikekeskuksissa, työpaikoilla, lentokentillä yms. julkisissa tiloissa soitettava musiikki, jonka tarkoituksena on usein edistää haluttua mielialaa tai tunnelmaa (esim. ostohalukkuus, tarmokkuus työssä, rauhallisuus tms.). Taustamusiikki on yleensä staattista, toisteista ja tasaisen harmonista, joten siihen ei kiinnitetä tietoista huomiota."@fi , "Musik som spelas i köpcentrum, på arbetsplatser, flygplatser e.d offentliga platser, och vars syfte är att främja en önskad sinnesstämning eller stämning. Bakgrundsmusik är vanligen statisk, upprepande och jämt harmonisk, så att man inte ägnar den någon medveten uppmärksamhet."@sv;
        skos:exactMatch  ysa:Y103624 , allars:Y15659;
        skos:inScheme    :;
        skos:prefLabel   "duogášmusihkka"@se , "bakgrundsmusik"@sv , "taustamusiikki"@fi , "background music"@en;
        skos:related     :p29508 , :p37819 , :p39818;
        skos:scopeNote   "Begreppet används endast i denna betydelse. Termen \"muzak\" som också är vanlig används inte, eftersom det är ett registrerat varumärke."@sv , "Käsitettä käytetään vain tässä merkityksessä. Arkikielessä yleistä termiä \"muzak\" ei  käytetä, koska se on tavaramerkillä suojattu kaupallinen termi."@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 , :p20796 .

