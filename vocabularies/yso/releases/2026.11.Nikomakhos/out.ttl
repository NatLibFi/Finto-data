:p20911  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2008-05-23"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "yritysjohdon valvonta"@fi , "företagsledningens övervakning"@sv , "hallinnointikoodi"@fi , "omistajavalvonta"@fi , "corporate governance"@en , "corporate governance"@fi , "styrningskod"@sv , "styrningskoden"@sv , "bolagsstyrning"@sv , "corporate governance"@sv;
        skos:broader     :p1911;
        skos:closeMatch  <http://www.wikidata.org/entity/Q380767>;
        skos:exactMatch  ysa:Y159146 , allars:Y36172;
        skos:inScheme    :;
        skos:note        "Aikaisemmin käytetty asiasanaa corporate governance. Tarkoittaa yrityksen johdon toimien valvontaa, eli kaikkia niitä toimia, joiden avulla omistajat pyrkivät varmistumaan siitä, että johto toimii heidän tavoitteidensa mukaisesti."@fi , "Tidigare användes termen corporate governance. Avser bevakning av ledningens verksamhet, alltså alla de handlingar, med vilka ägarna försäkrar sig om att ledningen handlar i enlighet med deras målsättningar."@sv;
        skos:prefLabel   "ägarstyrning"@sv , "omistajaohjaus"@fi , "ownership steering"@en;
        skos:related     :p20912 , :p15508;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26524 , :p26538 .

