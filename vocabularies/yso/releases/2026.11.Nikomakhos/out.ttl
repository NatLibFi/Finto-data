:p29904  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-02-07"^^xsd:date;
        dct:modified     "2024-06-12"^^xsd:date;
        skos:altLabel    "Afro-rock"@en;
        skos:broader     :p1882;
        skos:closeMatch  <http://www.wikidata.org/entity/Q3606268>;
        skos:definition  "1970-luvulla kehittynyt rockin tyylisuuntaus, jossa angloamerikkalaiseen rock-musiikkiin yhdistettiin afrikkalaisen perinnemusiikin aineksia. Musiikissa on viitteitä myös highlifetyylistä. Tunnettu tyylin edustaja on Osibisa-yhtye."@fi , "Stilriktning inom rock som utvecklades på 1970-talet och i vilken angloamerikansk rockmusik har förenats med inslag av afrikansk traditionell musik. I musiken finns också referenser till highlife. En känd företrädare för stilen är bandet Osibisa."@sv;
        skos:exactMatch  allars:Y51872 , ysa:Y214381;
        skos:inScheme    :;
        skos:note        "Käsitettä ei käytetä afrikkalaisen rock-musiikin yleisnimityksenä."@fi , "Begreppet används inte som allmän benämning på afrikansk rockmusik."@sv;
        skos:prefLabel   "afrorock"@sv , "afrorock"@se , "afro-rock"@fi , "Afro rock"@en;
        skos:related     :p40369 , :p29844;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

