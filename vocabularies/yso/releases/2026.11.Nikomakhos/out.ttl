:p26223  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Wikipedia"@fi;
        dct:created      "2012-04-24"^^xsd:date;
        dct:modified     "2024-03-02"^^xsd:date;
        skos:altLabel    "sophism"@en , "sofism"@sv , "sofisterna"@sv , "sofisma"@se , "sofistik"@sv , "sofismi"@fi;
        skos:broader     :p418;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85125278> , <http://www.wikidata.org/entity/Q166955> , <http://www.wikidata.org/entity/Q3750514>;
        skos:exactMatch  ysa:Y185687 , allars:Y44576;
        skos:inScheme    :;
        skos:note        "Vishetslärare i antikens Grekland som utövade dialektik och lärde mot betalning ut retorik och andra färdigheter som fria män behövde för att kunna delta i det politiska livet. Sofisterna kan räknas till de försokratiska tänkarna."@sv , "Sofistit olivat antiikin Kreikassa kierrelleitä viisauden opettajia, jotka harjoittivat paljon dialektiikkaa ja opettivat maksua vastaan retoriikkaa ja muita taitoja, joita vapaat miehet tarvitsivat voidakseen osallistua poliittiseen elämään. Sofistit voidaan lukea esisokraatikkojen joukkoon."@fi;
        skos:prefLabel   "sophists"@en , "sofisttat"@se , "sofister"@sv , "sofistit"@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26545;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "sofist"@sv , "sofisti"@fi , "sophist"@en , "sofista"@se .

