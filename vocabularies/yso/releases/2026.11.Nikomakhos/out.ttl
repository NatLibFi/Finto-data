:p8502  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1987-01-01"^^xsd:date;
        dct:modified     "2024-06-13"^^xsd:date;
        skos:altLabel    "negro spirituals"@sv , "afroamerikanska spirituals"@sv , "spiritualer"@sv , "negro spirituaalit"@fi , "negrospirituaalit"@fi;
        skos:broader     :p2842 , :p8501;
        skos:closeMatch  <http://www.wikidata.org/entity/Q212024> , <http://id.loc.gov/authorities/subjects/sh85126782>;
        skos:definition  "Andliga traditionella sånger som förmedlats genom muntlig tradition hos den afroamerikanska befolkningen i USA, och som ursprungligen sjungits utan ackompanjemang, men senare också ackompanjerats av orgel, harmonium e.d., ofta i samband med gudstjänster. Som spirituals räknas också konstmusikaliska bearbetningar av dessa sånger."@sv , "Yhdysvaltain afroamerikkalaisen väestön perinteinen suullisena perimätietona välittynyt hengellinen laulu, jollaisia on laulettu alun perin ilman säestystä ja myöhemmin myös urkujen, harmonin tms. säestyksellä, usein jumalanpalvelusten yhteydessä. Spirituaaleina pidetään myös näiden laulujen taidemusiikin omaisia sovituksia."@fi;
        skos:exactMatch  allars:Y26666 , ysa:Y101449;
        skos:inScheme    :;
        skos:prefLabel   "spirituálat"@se , "spirituals"@sv , "spirituals (songs)"@en , "spirituaalit"@fi;
        skos:related     :p8499 , :p8500;
