:p8318  rdf:type         skos:Concept , <http://www.yso.fi/onto/yso-meta/Hierarchy>;
        dct:created      "2014-01-01"^^xsd:date;
        dct:modified     "2025-04-09"^^xsd:date;
        skos:altLabel    "henkiset tuotokset"@fi , "intellectual accomplishments"@en , "mentala produkter"@sv;
