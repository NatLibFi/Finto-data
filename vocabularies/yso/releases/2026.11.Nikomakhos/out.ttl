:p39929  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2023-03-13"^^xsd:date;
        dct:modified     "2023-06-10"^^xsd:date;
        skos:altLabel    "fetichism (religion)"@en;
        skos:broader     :p38135;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85047960> , <http://www.wikidata.org/wiki/Q182116>;
        skos:inScheme    :;
        skos:prefLabel   "fetischism (religion)"@sv , "fetishism (religion)"@en , "fetisisma (oskkoldat)"@se , "fetisismi (uskonto)"@fi;
        skos:related     :p39932 , :p1017 , :p6426 , :p1015;
        skos:scopeNote   "Avser tro på magisk kraft hos vissa föremål. Om sexuell fetischism används begreppet <a href='http://www.yso.fi/onto/yso/p14324'>fetischism (sexualitet)</a>. I samband med marxistisk samhälls- och ekonomisk teori används begreppet <a href='http://www.yso.fi/onto/yso/p39932'>varufetischism</a>."@sv , "Refers to a belief in the supernatural power of an object or objects. For sexual fetishism, use <a href='http://www.yso.fi/onto/yso/p14324'>fetishism (sexuality)</a>. For fetishism in Marxian sociology and economics, use <a href='http://www.yso.fi/onto/yso/p39932'>commodity fetichism</a>."@en , "Tarkoittaa uskomusta tietyn objektin tai objektien yliluonnolliseen voimaan. Seksuaalisesta fetisismistä käytä käsitettä <a href='http://www.yso.fi/onto/yso/p14324'>fetisismi (seksuaalisuus)</a>. Marxilaisen yhteiskunta- ja talousteorian yhteydessä käytä käsitettä <a href='http://www.yso.fi/onto/yso/p39932'>hyödykefetisismi</a>."@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26551 .

