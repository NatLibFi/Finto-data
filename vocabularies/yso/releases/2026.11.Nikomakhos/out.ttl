:p5906  rdf:type            skos:Concept , <http://www.yso.fi/onto/yso-meta/DeprecatedConcept>;
        dct:created         "2002-11-21"^^xsd:date;
        dct:isReplacedBy    :p39624;
        owl:deprecated      true;
        skos:altLabel       "Lactuceae"@en;
        skos:broadMatch     :p141;
        skos:broader        <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        skos:closeMatch     <http://id.loc.gov/authorities/subjects/sh85025928>;
        skos:editorialNote  "2022-03-30/JS: wikidatan mappauksen yhteydessä selivisi, että enkkulabel on väärin. Tämä on tribus eli sukuryhmä Cichorieae eikä Cichoriaceae joka olisi heimo (ei ole olemassakaan, vaikka on kyllä LCSH labelina).   - korjaan tämän.\nkts taksonomia: https://species.wikimedia.org/wiki/Cichorieae\n\nHUOM! SV-label on nyt \"cikorior\" eli sikurit, joka on kasvisuvun nimi (Cichorium http://tun.fi/MX.39911) eikä tämä tribus. Wikidatassa ruotsinkielinen termi on Cichorieae." , "MF: jos muutetaan sv > Cichorieae, olisi varsinkin ruotsin kannalta tärkeää saada mukaan se varsinainen laji eli sikuri, josta on aineistoa Melindassakin, tein ehdotuksen. Huom. Laji.fi:ssäkin on sikurit ja sikuri, ei sikurikasveja. Ja Melindassa näyttää olevan käytetty kyllä sikureista ja sikurista, enemmän kuin \"sikurikasveista\" (tribus). Jos silti säilytetään tämä muoto niin teen yllä ehdotettu muutos (mutta tosiaan siinä toivossa että myös sikurit ja/tai ainakin sikuri otetaan)";
        skos:exactMatch     ysa:Y121792 , allars:Y42845;
        skos:inScheme       :deprecatedconceptscheme;
        skos:prefLabel      "cikorior"@sv , "sikurikasvit"@fi , "Cichorieae"@en;
        <http://www.yso.fi/onto/yso-meta/comment>
                "deprecated on 2023-01-20";
        <http://www.yso.fi/onto/yso-meta/deprecatedBroader>
                <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        <http://www.yso.fi/onto/yso-meta/deprecatedHasThematicGroup>
                :p26533 .

