:p19380  rdf:type          skos:Concept , <http://www.yso.fi/onto/yso-meta/DeprecatedConcept>;
        dct:created        "1987-01-01"^^xsd:date;
        dct:isReplacedBy   :p5171;
        owl:deprecated     true;
        skos:broadMatch    :p5171;
        skos:broader       <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        skos:exactMatch    ysa:Y100173 , allars:Y28681;
        skos:inScheme      :deprecatedconceptscheme;
        skos:note          "Concept in use between 1986 and 1995. For earlier, see <a href='http://www.yso.fi/onto/yso/p19381'>water administration</a>."@en , "Nimitys käytössä v. 1986-1995. Vesi- ja ympäristöhallinnon edeltäjä oli vesihallinto (1970-1986). Vesi- ja ympäristöhallinto sulautui ympäristöhallintoon ja maa- ja metsätaloushallintoon vuonna 1995, jolloin vesi- ja ympäristähallitus lakkautettiin ja sen tehtävät siirrettiin suurimmaksi osaksi Suomen ympäristökeskukselle."@fi , "Begreppet användes 1986-1995. Före det användes begreppet\n<a href='http://www.yso.fi/onto/yso/p19381'>vattenförvaltning</a>.  Vatten- och miljöförvaltning uppgick i miljöförvaltning och jord- och skogsbruksförvaltning 1995."@sv;
        skos:prefLabel     "vatten- och miljöförvaltning"@sv , "water and environmental administration"@en , "vesi- ja ympäristöhallinto"@fi;
        skos:relatedMatch  :p19381;
        <http://www.yso.fi/onto/yso-meta/comment>
                "deprecated on 2021-05-29";
        <http://www.yso.fi/onto/yso-meta/deprecatedBroader>
                <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        <http://www.yso.fi/onto/yso-meta/deprecatedHasThematicGroup>
                :p26524 , :p26560 , :p26580 .

