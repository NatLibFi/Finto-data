:p558   rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Lähde: Biologian sanakirja"@fi , "Source: Wikipedia"@en;
        dct:created      "1993-02-25"^^xsd:date;
        dct:modified     "2023-11-09"^^xsd:date;
        skos:altLabel    "livsmiljö (biologi)"@sv , "biotoopit"@fi , "biotoper"@sv , "elinympäristö (biologia)"@fi;
        skos:broader     :p14074;
        skos:closeMatch  <http://www.wikidata.org/entity/Q175208>;
        skos:exactMatch  ysa:Y107031 , allars:Y16142;
        skos:inScheme    :;
        skos:narrower    :p2328;
        skos:note        "Ekologisk term för ett område eller utrymme som karaktäriseras av vissa yttre faktorer. Biotopen är den yttre världen i vilken ett visst växt- eller djursamhälle hör hemma, och det är biotopens egenskaper som bestämmer vilket samhälle som kommer att finnas där."@sv , "Biotope is an area of uniform environmental conditions providing a living place for a specific assemblage of plants and animals."@en , "Tarkoittaa eliöiden kasvupaikkaa tai elinympäristöä yleisesti. Biotooppi on elinympäristö, jossa tärkeimmät ympäristötekijät ovat samankaltaisia ja jonka sisäinen rakenne on yhtenäinen. Biotooppi kertoo ennakko-oletuksesta, että joku alue on tietylle lajille, yksilölle tai populaatiolle mahdollinen elinympäristö. Biotooppi luokittelee ympäristöä eikä perustu laji- tai yksilöhavaintoihin"@fi;
        skos:prefLabel   "biotop"@sv , "biotohpa"@se , "biotooppi"@fi , "biotope"@en;
        skos:related     :p5678 , :p4636 , :p634 , :p4997 , :p11017 , :p20751;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26579 , :p26560 .

:p29864  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "1996-02-09"^^xsd:date;
        dct:modified        "2026-06-02"^^xsd:date;
        skos:altLabel       "trior (kompositioner)"@sv , "triot (sävellykset)"@fi;
        skos:broader        :p1515 , :p1514;
        skos:closeMatch     <http://www.wikidata.org/entity/Q29596700>;
        skos:definition     "Verk som komponerats eller arrangerats för tre instrument."@sv , "Kolmelle soittimelle sävelletty tai sovitettu teos."@fi;
        skos:editorialNote  "Sme: tarkenne muuttunut NP: Tällaisen käännös pitäisi etsiä ja korjata kerralla kaikkialla, vaihdettu (instrumentála musihkka)"@se;
        skos:exactMatch     allars:Y52089 , ysa:Y214806;
        skos:inScheme       :;
        skos:note           "Kolmelle lauluäänelle sävelletyistä tai sovitetuista teoksista käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p30115'>tertsetot</a>. Kolmen soittajan muodostamasta esityskokoonpanosta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p30130'>triot (yhtyeet)</a>."@fi , "Om verk som komponerats eller arrangerats för tre sångröster används begreppet <a href='http://www.yso.fi/onto/yso/p30115'>tersetter (kompositioner)</a>. Om ensemble bestående av tre instrumentalister används begreppet <a href='http://www.yso.fi/onto/yso/p30130'>trior (ensembler)</a>."@sv;
        skos:prefLabel      "trios (instrumentals)"@en , "trior (instrumentalmusik)"@sv , "triot (soitinmusiikki)"@fi , "triot (instrumentála musihkka)"@se;
        skos:related        :p14380 , :p1514;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "trio (sävellykset)"@fi , "trio (kompositioner)"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "trio (soitinmusiikki)"@fi , "trio (instrumentála musihkka)"@se , "trio (instrumentals)"@en , "trio (instrumentalmusik)"@sv .

