:p6293  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1998-09-16"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "skinnhuvuden"@sv , "skinheads"@sv , "skinit"@fi;
        skos:broader     :p1127;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh96000234> , <http://www.wikidata.org/entity/Q485417>;
        skos:exactMatch  allars:Y29615 , ysa:Y111423;
        skos:inScheme    :;
        skos:note        "Skinhead-kulttuuri syntyi  1960-luvun puolivälissä Isossa-Britanniassa. Skinheadit omaksuivat joitakin  ns. kovan mod-kulttuurin piirteitä, mutta liittivät niihin vahvasti proletaarisia symboleja. Alkuperäiseen skinhead-kulttuuriin ei välttämättä liittynyt rasismia. Myöhemmin siihen on liittynyt rasististisia, väkivaltaisia ja äärioikeistolaisia piirteitä"@fi , "Subkultur som uppkom i mitten av 1960-talet i Storbritannien och som hade några drag av mods-kulturen, men också förenade starkt proletariska symboler med den. Rasism hörde inte nödvändigtvis till den ursprungliga skinheadsrörelsen, men senare har den inkluderat rasistiska, våldsamma och högerextrema drag."@sv;
        skos:prefLabel   "skinheads"@en , "skinnskallar"@sv , "skinheadit"@fi;
        skos:related     :p6294 , :p8552 , :p6291;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26541 , :p26562;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "skini"@fi , "skinhead"@sv , "skinnhuvud"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "skinnskalle"@sv , "skinhead"@en , "skinhead"@fi .

