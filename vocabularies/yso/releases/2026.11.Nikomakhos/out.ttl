:p15859  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1987-01-01"^^xsd:date;
        dct:modified     "2026-06-11"^^xsd:date;
        skos:altLabel    "kisällilaulu"@en , "kisällilaulut"@en;
        skos:broader     :p10920;
        skos:definition  "Kisällilaulu on päivänpolitiikkaan ja ajankohtaisiin uutistapahtumiin humoristisesti kantaa ottava kansanomainen pilkkalaulu. Kisällilaulut kehittyivät 1920-luvulla suomalaisen työväenliikkeen nuorison harrastustoiminnan osana."@fi , "Avser folklig nidvisa som på ett humoristiskt sätt tar ställning till dagspolitiken och aktuella nyhetshändelser. Dessa sånger uppkom på 1920-talet som en del av den finska arbetarrörelsens fritidsverksamhet för ungdomar."@sv;
        skos:exactMatch  ysa:Y102559 , allars:Y18975;
        skos:inScheme    :;
        skos:note        "A type of political folk song."@en;
        skos:prefLabel   "kisällilaulu"@en , "gesällvisor"@sv , "kisällilaulut"@fi;
        skos:related     :p13243;
        <http://www.w3.org/2008/05/skos-xl#altLabel>
                <http://www.yso.fi/onto/yso/p15859#xl_altLabel_en_100084>;
        <http://www.w3.org/2008/05/skos-xl#prefLabel>
                <http://www.yso.fi/onto/yso/p15859#xl_prefLabel_en_100083>;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26541 , :p26532 , :p26571;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "gesällvisa"@sv , "kisällilaulu"@fi .

