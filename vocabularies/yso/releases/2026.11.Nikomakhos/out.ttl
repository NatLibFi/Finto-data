        <http://rdaregistry.info/Elements/u/P60686>
                :p7060;
        skos:broader     :p3733;
        skos:exactMatch  allars:Y33132 , ysa:Y133590;
        skos:inScheme    :;
        skos:note        "Vuodesta 1974 vuoteen 1989 käytetty nimitystä toimiupseerit. Vuodesta 1989 alkaen käytetty nimitystä opistoupseerit. Miehistön aliupseereista käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p13161'>aliupseerit</a>."@fi , "Concept in use until 1974. From 1974 to 1989, use <a href='http://www.yso.fi/onto/yso/p7060'>warrant officers</a> and for later <a href='http://www.yso.fi/onto/yso/p7059'>warrant officers</a>."@en , "Benämningen befattningsofficerare användes 1974-1989. Därefter ändrades benämningen till institutofficerare. Om manskapets underofficerare används begreppet <a href='http://www.yso.fi/onto/yso/p13161'>underofficerare</a>."@sv;
        skos:prefLabel   "regular non-commisioned officers"@en , "stamunderofficerare"@sv , "kanta-aliupseerit"@fi;
        skos:related     :p13161 , :p789 , :p7059;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26575;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "regular non-commisioned officer"@en , "kanta-aliupseeri"@fi .

