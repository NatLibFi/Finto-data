:p13132  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Lähde: Mir iskusstva : taiteen maailma"@fi;
        dct:created      "2001-10-02"^^xsd:date;
        dct:modified     "2024-06-04"^^xsd:date;
        skos:broader     :p2393;
        skos:closeMatch  <http://www.wikidata.org/entity/Q1425138>;
        skos:exactMatch  allars:Y44269 , ysa:Y115605;
        skos:inScheme    :;
        skos:note        "Konstnärlig rörelse inom rysk kultur, främst i början av 1900-talet."@sv , "Mir iskusstvan käsite kattaa lukuisia venäläisen kulttuurin ilmiöitä. Se tarkoittaa taiteilijaryhmää, kahta taideyhdistystä ja niiden taidenäyttelyitä, taidelehteä, graafisen suunnittelun suuntausta, venäläisen teatterin voittokulkua Euroopassa ja omaperäistä taidefilosofiaa, joka oli sisäistänyt vuosisadan vaihteen kulttuurin uudet tuulet."@fi;
        skos:prefLabel   "Mir iskusstva"@en , "Mir iskusstva"@sv , "Mir iskusstva"@se , "Mir iskusstva"@fi;
        skos:related     :p6889;
