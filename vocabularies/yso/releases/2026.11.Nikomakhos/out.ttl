:p10752  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "1989-11-01"^^xsd:date;
        dct:modified        "2024-01-30"^^xsd:date;
        skos:altLabel       "förvarstagning"@sv , "detention (intoxicated persons)"@en , "noncriminal detention"@en , "detention (asylum seekers)"@en , "detention (non-criminal)"@en , "tagande i förvar"@sv;
        skos:broader        :p14;
        skos:editorialNote  "2021-07-21/js:  säilöönotto käsitteestä on Ulkomaalaislaissa käytetty termiä \"detention\", joten se tulisi olla tässäkin näkyvissä, ehkä jopa pääterminä, mutta pitäisi olla tarkenne, sillä termiä on käytetty eri tavoin myös käsitteissä \"pidättäminen\", \"vangitseminen\", \"vankeus\",  \"tutkintavankeus\". \nkts. https://en.wikipedia.org/wiki/Detention_(imprisonment)" , "JS: pitäisi varmaan vaihtaa tähän käsittteseen sillä ko. LCSH on mapattu wikidatassa https://www.wikidata.org/wiki/Q1071447 \"säilöönotto\". \nPidättäminen on LCHS:ssa \"Arrest\". Siellä on myös \"preventive detention\", joka on mapattu wikidatassa käsitteeseen \"tutkintavankeus\" alias \"vangitseminen\"." , "2023-01-23 TP Github-issuessa kaivattiin detention-pohjaista preflabelia. miten olisi \"detention (non-criminal)\"?" , "Mirja: https://migri.fi/en/detention. Löytyy detention of asylum seekers ja toisaalta detention of intoxicated persons. Take into custody voi tarkoittaa myös pidätystä. Detention on myös jälki-istunto. On toki sekin mahdollisuus, että jaetaan tämä." , "http://id.loc.gov/authorities/subjects/sh85037293 Detention of persons on nyt linkitetty käsitteeseen \"vangitseminen\"" , "https://github.com/Finto-ehdotus/YSE/issues/10232";
        skos:exactMatch     ysa:Y99187 , allars:Y19096;
        skos:inScheme       :;
        skos:prefLabel      "säilöönotto"@fi , "förvarstagande"@sv , "non-criminal detention"@en;
        skos:related        :p10750 , :p10751 , :p4715 , :p9723;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26559 .

