        skos:inScheme    :;
        skos:note        "Filosofisk uppfattning enligt vilken ingenting utanför jaget existerar."@sv , "Käsitys, jonka mukaan vain itsestään tietoinen minä olisi olemassa ja kaikki muu olisi ainoastaan sen mielikuvia tai ajatuksia. Solipsismia ei kukaan ole varsinaisesti kannattanut, mutta idealismin pohjalta se on tietoteoreettisissa tarkasteluissa esitetty realismin periaatteelliseksi vastakohdaksi."@fi;
        skos:prefLabel   "solipsisma"@se , "solipsism"@sv , "solipsism"@en , "solipsismi"@fi;
