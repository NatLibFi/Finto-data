:p7267  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1998-11-09"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "jakotoimitus"@fi , "halkominen"@fi , "lohkominen"@fi , "maanmittaustoimitus"@fi;
        skos:broader     :p7270;
        skos:closeMatch  <http://www.wikidata.org/entity/Q10494290>;
        skos:exactMatch  allars:Y17784 , ysa:Y103318;
        skos:inScheme    :;
        skos:note        "Kiinteistöjen muodostaminen toteutetaan kiinteistötoimituksilla. Kiinteistötoimituksilla muodostetaan uusia kiinteistöjä, muutetaan kiinteistöihin liittyviä oikeuksia tai määritetään kiinteistön ulottuvuuksia. Yleisimpiä kiinteistötoimituksia ovat lohkominen, tontin ja yleisen alueen mittaus, halkominen, tilusvaihto sekä kiinteistönmääritys."@fi , "Changes in real properties must be managed through a cadastral procedure including  the subdivision, reallotment and partitioning of property."@en , "Fastighetsbildning förverkligas genom fastighetsförrättning. Med fastighetsförrättning bildas nya fastigheter, ändras rätter i anslutning till fastigheter eller bestäms fastigheters utsträckning. De vanligaste fastighetsförrättningarna är styckning, mätning av tomt eller allmänt område, klyvning, ägobyte och fastighetsbestämning."@sv;
        skos:prefLabel   "fastighetsförrättning"@sv , "cadastral procedures"@en , "kiinteistötoimitus"@fi;
        skos:related     :p7269 , :p7146 , :p7268;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26559 , :p26535;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "cadastral procedure"@en .

