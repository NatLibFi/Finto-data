:p8022  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-02-09"^^xsd:date;
        dct:modified     "2024-08-28"^^xsd:date;
        skos:altLabel    "menuetter (danser)"@sv , "menuetit (tanssit)"@fi;
        skos:broader     :p3046;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh98003471>;
        skos:definition  "Alkuperältään ranskalainen, kolmijakoinen kansantanssi, joka tuli jo 1600-luvulla hovikäyttöön, muuntuen 1700-luvulla itsenäiseksi sävellykseksi sekä sarjojen, sinfonioiden ja muiden laajempien sävellysten vakituiseksi osaksi."@fi , "Till sitt ursprung fransk folkdans i tretakt, som togs i bruk vid hov redan på 1600-talet och som omvandlades till en självständig komposition på 1700-talet samt en etablerad del av sviter, sinfonier och andra större kompositioner."@sv;
        skos:exactMatch  ysa:Y216500 , allars:Y52205;
        skos:inScheme    :;
        skos:prefLabel   "menuetti (tanssit)"@fi , "minuet (dances)"@en , "menuett (danser)"@sv , "menuehtta (dánssat)"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26582 .

