        skos:definition  "Upplevd helhet av sinnesförnimmelser, upplevelser, känslor, minnesbilder och tankar som en individ har vid en tidpunkt, eller individens medvetenhet om sig själv och sin omgivning. Studeras t.ex. inom filosofi."@sv , "Esim. filosofian alueella tutkittu yksilön kullakin hetkellä kokemien aistimusten, elämysten, tunteiden, muistikuvien ja ajatusten kokonaisuus, tai yksilön tietoisuus itsestään ja ympäristöstään."@fi;
        skos:exactMatch  allars:Y22642 , ysa:Y99508;
        skos:inScheme    :;
        skos:narrower    :p25466 , :p112 , :p23046 , :p40257 , :p10 , :p25283;
        skos:note        "In the context of e.g. philosophy, the whole of a person’s feelings, sensations, recollections and thoughts, or a person’s consciousness of themselves and their surroundings."@en;
        skos:prefLabel   "medvetenhet"@sv , "tietoisuus"@fi , "consciousness (mental properties)"@en , "diđolašvuohta (mentála iešvuođat)"@se;
        skos:related     :p7066 , :p9293 , :p24919 , :p7065 , :p21791;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26545 , :p26543 .

