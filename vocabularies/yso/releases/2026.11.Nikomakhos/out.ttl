:p2549  rdf:type            <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "1998-11-09"^^xsd:date;
        dct:modified        "2025-04-09"^^xsd:date;
        skos:altLabel       "delande"@sv , "jako"@fi;
        skos:broader        :p38217;
        skos:editorialNote  "Poistettu huomautus: 1) osittaa, saattaa osiksi a) osittaa jokin irrallisiin, itsenäisiin osiin: paloitella, lohkoa, pilkkoa, hajottaa tms.; b) erottaa jonkin kokonaisuuden piirissä sen osia toisistaan; jaotella, ryhmitellä, luokitella; (mat.) laskea osamäärä, osittaa määrätavalla; c) sijoittaa, levittää jokin kokonaisuus, rasitus, tehtävä tms. osina määräalueelle; d) tasata jokin, osallistua johonkin, olla mukana jossakin tms."@fi , "Käsite on aiemmin ollut jaettu. Jaetun käsitteen preflabel oli \"jakaminen (osiin)\"."@fi;
        skos:exactMatch     allars:Y16836 , ysa:Y111610;
        skos:inScheme       :;
        skos:narrower       :p6826 , :p6825 , :p6015 , :p4268 , :p10510 , :p2548 , :p24078 , :p11369;
        skos:prefLabel      "delning"@sv , "division (active)"@en , "jakaminen"@fi , "juohkin"@se;
        skos:related        :p5149;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26556 .

