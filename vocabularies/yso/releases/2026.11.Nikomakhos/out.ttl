        skos:broadMatch           :p29883;
        skos:broader              <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        skos:definition           "Orkesterille sävelletyistä teoksista koostettua harjoitteluaineistoa, joka voi esiintyä  nuottina, videona tai \"music-minus-one\" -tyyppisenä äänitteenä. Orkesteriharjoitukset ovat  eri soittimille tarkoitettuja orkesterimusiikkiteosten katkelmia ja soolo-osuuksia yksittäisinä  ääninä. Tunnettuja orkesteriharjoitusjulkaisuja ovat Orchesterstudien, Orchester Probe-Spiele ja Orchestral excerpts."@fi;
        skos:editorialNote        "https://github.com/Finto-ehdotus/YSE/issues/6138";
