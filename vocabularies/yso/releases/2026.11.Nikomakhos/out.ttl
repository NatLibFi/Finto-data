:p9612  rdf:type                     skos:Concept , <http://www.yso.fi/onto/yso-meta/DeprecatedConcept>;
        dc:source                    "Lähde: Suomen kielen perussanakirja; CD-Facta"@fi;
        dct:isReplacedBy             :p9577;
        owl:deprecated               true;
        skos:altLabel                "kanonit"@fi;
        skos:broadMatch              :p4902;
        skos:broader                 <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        skos:exactMatch              allars:Y30983 , ysa:Y102064;
        skos:inScheme                :deprecatedconceptscheme;
        skos:note                    "kirjapainoalalla eräs iso kirjasinkoko; Kirjapainomaailmassa kaanon kuitenkin on tarkoittanut 36 pisteen kirjasinta. Nimi toki juontuu Raamatun ns. kanonisista kirjoista"@fi;
        skos:prefLabel               "canons"@en , "kaanonit (koko)"@fi , "kanon (storlek)"@sv;
        <http://www.yso.fi/onto/yso-meta/comment>
                "deprecated on 24.09.2014";
        <http://www.yso.fi/onto/yso-meta/deprecatedBroader>
                <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        <http://www.yso.fi/onto/yso-meta/deprecatedHasThematicGroup>
                :p26556;
        yso-update:newBroader        :p22841;
        yso-update:newGroup          :p26551 , :p26564 , :p26581 , :p26571;
        yso-update:newNote           "Kulttuurin ja/tai taiteen keskeisinä pidetyt teokset esim. jossakin maassa, tai uskonnon pyhien kirjojen kokoelma."@fi;
        yso-update:newPrefLabel      "kaanonit (valikoimat)"@fi;
        yso-update:removedGroup      :p26556;
        yso-update:removedNote       "Sanalla on monia merkityksiä. 1) Uskonnossa kaanon voi olla pyhien kirjojen kokoelma, kirkolliskokouksen tai paavin säädös, katolisen kirkon pyhimysluettelo tai ortodoksinen liturginen runoelma. 2) Kuvataiteissa ihmisruumiin ihanteellisten mittasuhteiden säännöt. 3) Musiikissa moniääninen sävellysmuoto, jossa sama teema alkaa uudessa äänessä ennen kuin se on päättynyt toisessa. 4) Kulttuurin ja/tai taiteen keskeisinä pidetyt teokset esim. jossakin maassa. 5) Kirjapainoalalla eräs iso kirjasinkoko"@fi;
        yso-update:removedPrefLabel  "kaanonit"@fi;
        yso-update:removedSource     "Suomen kielen perussanakirja; CD-Facta"@fi .

