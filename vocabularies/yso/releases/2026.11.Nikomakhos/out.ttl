        skos:inScheme    :;
        skos:note        "Termen omfattar allt från preventivrådgivning, aborter, könssjukdomar, födande, infertilitet till menopaus och gynekologiska sjukdomar."@sv , "Tarkoittaa kaikkia niitä seksuaalisuuteen, lisääntymiseen ja kehon lisääntymisjärjestelmään liittyviä asioita, joilla on merkitystä terveyden kannalta."@fi;
        skos:prefLabel   "reproductive health"@en , "lisääntymisterveys"@fi , "reproduktiv hälsa"@sv , "eatnánandearvvašvuohta"@se;
        skos:related     :p4285 , :p4284;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26550 .

