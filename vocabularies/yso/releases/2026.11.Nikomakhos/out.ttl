:p30066  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1996-02-07"^^xsd:date;
        dct:modified     "2020-09-29"^^xsd:date;
        skos:altLabel    "haitarijazz"@en;
        skos:broader     :p3064 , :p181;
        skos:definition  "Stilgenre inom finländsk populär dansmusik. Dragspelsjazz framfördes av bl.a. Dallapé, Ramblers och Rytmi-Pojat på 1920-1930-talen."@sv , "Suomalainen populaarin tanssimusiikin tyylilaji, jossa on perinteisten viihdemusiikin lajien (erityisesti foxtrot) joukkoon yhdistetty hieman \"jatsia\" ja jossa harmonikalla on solistisia sooloja. Haitarijazzia esittivät mm. Dallapé, Ramblers ja Rytmi-Pojat 1920- ja 1930-luvuilla. Pääosa haitarijazzin piirissä esitetyistä sävellyksistä oli foxtroteja, valsseja, tangoja, polkkia ja jenkkoja."@fi;
        skos:exactMatch  ysa:Y214472 , allars:Y51720;
        skos:inScheme    :;
        skos:prefLabel   "Finnish accordion jazz"@en , "haitarijazz"@fi , "dragspelsjazz"@sv;
        skos:related     :p4484 , :p8434;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

