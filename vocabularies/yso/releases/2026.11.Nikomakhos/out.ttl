:p12381  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "1987-01-01"^^xsd:date;
        dct:modified        "2023-02-08"^^xsd:date;
        skos:altLabel       "sävellajisidonnaisuus"@fi , "sävellajisuus"@fi;
        skos:broader        :p28821;
        skos:closeMatch     <http://www.wikidata.org/entity/Q192822> , <http://id.loc.gov/authorities/subjects/sh85135965>;
        skos:definition     "Tonal musik grundar sig på hierarkiska förhållanden mellan toner och det tonala centrumet. Former av tonal musik är t.ex. dur-molltonalitet och modalitet (pentatoniska, diatoniska, kromatiska och tonsystem med mikrointervaller)."@sv , "Tonaalinen musiikki perustuu sävelten välisiin hierarkkisiin suhteisiin ja tonaaliseen keskukseen. Tonaalisen musiikin muotoja ovat esimerkiksi duuri-mollitonaalisuus ja modaalisuus (pentatoniset, diatoniset, kromaattiset ja mikrointervalleja käyttävät säveljärjestelmät)."@fi;
        skos:editorialNote  "Poistettu huomautus: sävellajisuus, sävelten ja harmonioiden tonaalisten ominaisuuksien kokonaisuus. Termiä voidaan käyttää myös modaalisuuden distinktiona."@fi , "Käsite on aiemmin ollut jaettu. Jaetun käsitteen preflabel oli \"tonaalisuus (säveljärjestelmät)\"."@fi;
        skos:exactMatch     allars:Y27807 , ysa:Y100912;
        skos:inScheme       :;
        skos:prefLabel      "tonaalisuus"@fi , "tonalitet"@sv , "tonality"@en;
        skos:related        :p29773 , :p12383 , :p12382;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

