:p19199  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1993-05-05"^^xsd:date;
        dct:modified     "2023-03-31"^^xsd:date;
        skos:broader     :p38078;
        skos:closeMatch  <http://www.wikidata.org/entity/Q213121> , <http://id.loc.gov/authorities/subjects/sh87003427>;
        skos:definition  "New age -liikkeen myötä kehittynyt musiikkityyli, joka perustuu selkeään tonaaliseen rakenteeseen. Siinä on vähän dynaamisia vaihteluita, runsaasti syntetisaattorilla tuotettuja ääniä, usein musiikkiin yhdistettynä erilaisia luonnonääniä, ja julkaisujen sekä kappaleiden nimissä viitataan usein mystiikkaan, mytologiaan, luontoon, mielenrauhaan, mietiskelyyn jne."@fi , "Musikstil som utvecklats i samband med new age-rörelsen och som bygger på en tydlig tonal struktur. Stilen präglas av sparsamma dynamiska växlingar, rikligt med ljud som skapats med syntetisator, ofta olika naturljud som kombinerats med musiken, och hänvisningar till mystik, mytologi, natur, sinnesro, meditation etc. i namnen på musikstyckena."@sv;
        skos:exactMatch  allars:Y23496 , ysa:Y107427;
        skos:inScheme    :;
        skos:prefLabel   "new age -musihkka"@se , "new age music"@en , "new age-musik"@sv , "new age -musiikki"@fi;
        skos:related     :p29942 , :p29953;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26551 , :p26571 , :p26532 .

