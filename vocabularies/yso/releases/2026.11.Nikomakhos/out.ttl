        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85144131>;
        skos:definition  "Kolmen lauluäänen muodostama kokoonpano."@fi , "Ensemble bestående av tre sångröster."@sv;
        skos:exactMatch  allars:Y51836 , ysa:Y214697;
        skos:inScheme    :;
        skos:note        "Om verk komponerade eller arrangerade för tre sångröster används begreppet <a href='http://www.yso.fi/onto/yso/p30115'>tersetter (kompositioner)</a>. Om verk komponerade eller arrangerade för tre instrument används begreppet <a href='http://www.yso.fi/onto/yso/p29864'>trior (kompositioner)</a>. Om ensemble bestående av tre instrumentalister används begreppet <a href='http://www.yso.fi/onto/yso/p30130'>trior (ensembler)</a>."@sv , "Kolmelle lauluäänelle sävelletyistä tai sovitetuista teoksista käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p30115'>tertsetot</a>. Kolmelle soittimelle sävelletyistä tai sovitetuista teoksista käytetään käsitettä  <a href='http://www.yso.fi/onto/yso/p29864'>triot (sävellykset)</a>. Kolmen soittajan muodostamasta esityskokoonpanosta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p30130'>triot (yhtyeet)</a>."@fi;
        skos:prefLabel   "tersetter (ensembler)"@sv , "tertsetit"@fi , "terzettos (ensembles)"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "vocal trio"@en , "terzett (ensembler)"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "tertsetti"@fi , "terzetto (ensembles)"@en , "tersett (ensembler)"@sv .

