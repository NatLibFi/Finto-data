:p2667  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1987-01-01"^^xsd:date;
        dct:modified     "2023-06-23"^^xsd:date;
        skos:broader     :p1510;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85057803> , <http://www.wikidata.org/entity/Q6607>;
        skos:definition  "Yleensä kuusikielinen näppäilysoitin, jota voidaan soittaa myös rämpyttäen. Perinteisessä klassisessa kitarassa on ääntä vahvistava puinen kaikukoppa. Kitaralla on useita muunnoksia, joista osa on sähköisesti vahvistettuja ja osassa kielet ja rakenne ovat erilaiset."@fi , "Knäppinstrument, vanligen med sex strängar, och i den traditionella klassiska versionen med en ljudförstärkande resonanslåda i trä. Det finns olika varianter, av vilka en del är elektriskt förstärkta."@sv;
        skos:exactMatch  ysa:Y101009 , allars:Y18996;
        skos:inScheme    :;
        skos:narrower    :p2666 , :p22040 , :p30117 , :p10953 , :p29819;
        skos:prefLabel   "gitárra"@se , "guitar"@en , "gitarr"@sv , "kitara"@fi;
        skos:related     :p29898 , :p12480 , :p27659;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

