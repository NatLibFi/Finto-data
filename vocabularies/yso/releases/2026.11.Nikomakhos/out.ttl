        skos:related     :p18555;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26525 , :p26554 .

:p10250  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2004-01-12"^^xsd:date;
        dct:modified     "2023-03-30"^^xsd:date;
        skos:altLabel    "proge"@fi;
        skos:broader     :p1882;
        skos:closeMatch  <http://www.wikidata.org/entity/Q49451> , <http://id.loc.gov/authorities/subjects/sh95010319>;
        skos:definition  "Taiteellisesti kunnianhimoinen rock-tyyli, jolle on luonteenomaista virtuoosimainen soittimien käsittely, monipolviset kappalerakenteet ja rytmiikka sekä mahdolliset vaikutteet jazzista tai taidemusiikista."@fi , "Konstnärligt ambitiös rockstil, för vilken virtuosmässig hantering av instrument, komplicerad låtstruktur och rytmik samt intryck från jazz eller konstmusik är typiska."@sv;
        skos:exactMatch  allars:Y35888 , ysa:Y128892;
        skos:inScheme    :;
        skos:narrower    :p38528;
        skos:note        "Koska määrittely ja rajanveto on muiden rock-tyylien lailla hankalaa, suositellaan lisäksi  käytettäväksi aina myös termiä rock."@fi , "Eftersom definition och gränsdragning på samma sätt som för andra rockstilar är svår, rekommenderas dessutom att man också alltid använder termen rock."@sv;
        skos:prefLabel   "progressiiva rock"@se , "progressiv rock"@sv , "progressive rock music"@en , "progressiivinen rock"@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

