        skos:exactMatch  ysa:Y185474 , allars:Y45042;
        skos:inScheme    :;
        skos:note        "Slaviskt folk som bor spritt på olika områden i Östra Mellaneuropa och som talar ett eget språk rusinska."@sv , "Itäisen Keski-Euroopan eri alueilla hajallaan elävä slaavilainen kansa, joka puhuu omaa, itäslaavilaisiin kieliin kuuluvaa ruteenin kieltään. Ruteenien perinteisenä kotiseutuna pidetään Ruteniaa. Suurimmat nykyiset ruteenien keskittymät ovat Slovakiassa, Ukrainassa (karpatoruteenit), Puolassa ja Serbian Vojvodinassa."@fi;
        skos:prefLabel   "ruteenit"@fi , "rusiner"@sv , "Rusyns"@en;
