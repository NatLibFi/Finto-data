:p27183  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2013-03-21"^^xsd:date;
        dct:modified     "2023-07-28"^^xsd:date;
        skos:altLabel    "biological assays"@en , "bioassay"@sv;
        skos:broader     :p3971;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85014169>;
        skos:exactMatch  ysa:Y191755 , allars:Y45572;
        skos:inScheme    :;
        skos:note        "A method of determining the biological activity or potency of a substance, as a vitamin or hormone, by testing its effect on the growth of an organism."@en , "Test i vilket en substans bestäms med hjälp av biologiskt provmaterial. Som provmaterial kan en organism, ett organ eller en vävnad fungera. Används för att utreda ämnens halter och effekter särskilt inom biovetenskaperna."@sv , "Testi, jossa yhdiste määritetään biologisen koemateriaalin avulla. Koemateriaalina voi olla jokin organismi, elin tai kudosta. Käytetään aineiden pitoisuuksien ja vaikutusten selvittämiseen etenkin biotieteissä."@fi;
        skos:prefLabel   "biotest"@sv , "biotestit"@fi , "bioassays"@en , "bioteasttat"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26579;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "biological assay"@en;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "bioassay"@en , "bioteasta"@se , "biotesti"@fi .

