        skos:altLabel    "djurfristäder"@sv , "eläinsuojelukeskukset"@fi;
        skos:broader     :p272;
        skos:definition  "Eläinten turvakoti tarjoaa turvallisen, elinikäisen kodin tuotanto-, lemmikki- tai villieläimille. Turvakodissa eläimillä on mahdollisuus lajityypilliseen käyttäytymiseen. Osa turvakodeista tarjoaa ihmisille mahdollisuuden vierailuihin ja tekee eläinsuojeluun liittyvää koulutus- ja tiedotustoimintaa."@fi;
        skos:inScheme    :;
        skos:prefLabel   "eläinten turvakodit"@fi , "animal sanctuaries"@en , "skyddshem för djur"@sv;
        skos:related     :p2778;
