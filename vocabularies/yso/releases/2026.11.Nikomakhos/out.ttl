:p18234  rdf:type           skos:Concept , <http://www.yso.fi/onto/yso-meta/DeprecatedConcept>;
        dct:isReplacedBy    :p4549;
        owl:deprecated      true;
        skos:altLabel       "fyllning (aktivitet)"@sv , "täyttäminen"@fi , "fyllande"@sv , "ifyllning"@sv;
        skos:broadMatch     :p38217;
        skos:broader        <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        skos:editorialNote  "Poistettu huomautus: 1) panna tai saattaa jotakin johonkin tilaan niin, että tila tulee täyde(mmä)ksi, täyteen a) vajauksen tm. puutoksen kattamisesta; b) täyttää eläimen nahka niin, että sen ruumiin muoto tulee samaksi kuin elävällä eläimellä; c) (ruok.) panna johonkin leivonnaiseen tm. ruoka-aineeseen täytteeksi jotkain toista ainetta; d) (lääk.) hampaan täyttäminen paikka-aineella; 2) tehdä jokin täydeksi määrällään, olemassaolollaan; 3) olla mitoiltaan, laajuudeltaan tm. ominaisuudeltaan jonkin mukainen, vastata jotakin; 4) ottaa, palkata tai asettaa joku johonkin virkaan, toimeen tai tehtävään; 5) saavuttaa täysinä vuosina (tai kuukausina)"@fi;
        skos:exactMatch     ysa:Y111156 , allars:Y18441;
        skos:inScheme       :deprecatedconceptscheme;
        skos:prefLabel      "täyttö"@fi , "påfyllning"@sv , "filling (activity)"@en;
        <http://www.yso.fi/onto/yso-meta/comment>
                "deprecated on 2019-02-26";
        <http://www.yso.fi/onto/yso-meta/deprecatedBroader>
                <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        <http://www.yso.fi/onto/yso-meta/deprecatedHasThematicGroup>
                :p26556 .

