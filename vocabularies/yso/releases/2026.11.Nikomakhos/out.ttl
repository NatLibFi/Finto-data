:p18536  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Lähde: Ojala, I., Managerialismi ja oppilaitosjohtaminen"@fi;
        dct:created      "2004-02-24"^^xsd:date;
        dct:modified     "2023-05-04"^^xsd:date;
        skos:broader     :p220;
        skos:closeMatch  <http://www.wikidata.org/entity/Q282750>;
        skos:exactMatch  ysa:Y129786 , allars:Y34772;
        skos:inScheme    :;
        skos:note        "Managerialismilla tarkoitetaan yksilöjohtamisen edellytysten lisäämistä ja yksilöjohtamisen alan laajentamista korostavaa ideologiaa, joka heijastuu yksilöiden arvoihin, asenteisiin ja käyttäytymiseen, poliittis-hallinnollisten ohjelmien tavoitteisiin, organisaatioiden rakennepiirteisiin ja toimintakäytäntöihin."@fi , "Ideologi som betonar individuellt ledarskap och som avspeglas i individers värderingar, attityder och beteende, målsättningar i politisk-administrativa program, organisationers strukturella drag och verksamhetspraxis."@sv;
        skos:prefLabel   "managerialisma"@se , "managerialismi"@fi , "managerialism"@sv , "managerialism"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26538 , :p26541 .

