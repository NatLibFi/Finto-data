        skos:exactMatch  ysa:Y98379 , allars:Y16735;
        skos:inScheme    :;
        skos:narrower    :p21834 , :p4682 , :p9653 , :p20771;
        skos:note        "Används om barnomsorgen för barn som vanligen är 1-5 år och som i Sverige kallas förskola. Använd begreppet <a href='http://www.yso.fi/onto/yso/p15089'>förskolan</a> om den pedagogiska verksamhet som riktar sig till barn som följande läsår skall börja skolan och som i Sverige benämns förskoleklass."@sv;
