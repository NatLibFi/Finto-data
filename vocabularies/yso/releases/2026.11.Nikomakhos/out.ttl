:p29637  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2017-04-03"^^xsd:date;
        dct:modified     "2023-03-30"^^xsd:date;
        skos:altLabel    "hardcorepunk"@fi , "hc punk"@fi , "hc punk"@sv , "hardcore (punk)"@sv;
        skos:broader     :p29762;
        skos:closeMatch  <http://www.wikidata.org/entity/Q10922> , <http://id.loc.gov/authorities/subjects/sh2003002059>;
        skos:definition  "Underart till punkrock som utvecklats sedan slutet av 1970-talet och som har snabbare rytm och aggressivare uttryck."@sv , "Punk rockista 1970-luvun lopusta lähtien kehittynyt nopeatempoisempi ja aggressiivisempi alalaji. Hardcore punkin sanoituksissa otetaan usein kantaa yhteiskunnallisiin aiheisiin vastustaen esimerkiksi militarismia, auktoriteetteja ja väkivaltaa. Paino on yleensä enemmän rytmissä kuin melodiassa ja laulu on usein huutavaa tai karjuvaa. Kitaraosuudet ovat toisinaan monitahoisia, teknisesti vaativia ja rytmillisesti haasteellisia. Kokoonpanossa on tyypillisesti laulajan ja säröisen kitaran lisäksi bassokitara ja rummut."@fi;
        skos:exactMatch  allars:Y51369 , ysa:Y504977;
        skos:inScheme    :;
        skos:prefLabel   "hardcore punk"@se , "hardcore punk"@fi , "hardcore punk music"@en , "hardcorepunk"@sv;
        skos:related     :p38076;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

