:p29914  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2005-04-25"^^xsd:date;
        dct:modified     "2023-03-30"^^xsd:date;
        skos:broader     :p15521;
        skos:closeMatch  <http://www.wikidata.org/entity/Q211723>;
        skos:definition  "Metalgenre med mycket snabbt tempo som är tekniskt krävande och starkt influerad av punkrock, uppkommen i början 1980-talet i USA. Kända företrädare av stilen har varit Anthrax, Megadeth, Metallica (tidig produktion), Slayer och finländska Stone."@sv , "1980-luvun alussa Yhdysvalloissa syntynyt erittäin nopea ja teknisesti vaativa heavy rockin tyyli, joka on saanut vahvoja vaikutteita punk rockista. Tunnettuja edustajia ovat olleet Anthrax, Megadeth, Metallica (varhainen), Slayer ja suomalainen Stone."@fi;
        skos:exactMatch  ysa:Y214677 , allars:Y51940;
        skos:inScheme    :;
        skos:prefLabel   "speed metal"@se , "speed metal"@sv , "speed metal"@en , "speed metal"@fi;
        skos:related     :p29912 , :p20679 , :p26907 , :p29836;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

