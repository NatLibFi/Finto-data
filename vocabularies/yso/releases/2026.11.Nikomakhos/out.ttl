        skos:broadMatch  <http://id.loc.gov/authorities/subjects/sh85125359>;
        skos:broader     :p2969;
        skos:definition  "1990-luvulla muotoutunut soul-musiikista vaikutteita saanut populaarimusiikin laji, jossa on tunnusomaisena piirteenä perinteisten soittimien käyttö. Tyypillisiä tyylin edustajia ovat Erykah Badu, Lauryn Hill, Angie Stone ja Raphael Saadiq."@fi , "Populärmusikalisk genre som formats på 1990-talet med intryck av soulmusik, och som typiskt inkluderar traditionella instrument. Företrädare av stilen är t.ex. Erykah Badu, Lauryn Hill, Angie Stone och Raphael Saadiq."@sv;
        skos:exactMatch  allars:Y51985 , ysa:Y214593;
        skos:inScheme    :;
        skos:prefLabel   "neo-soul"@sv , "neo-soul"@fi , "neo-soul"@en , "neo-soul"@se;
        skos:related     :p29894 , :p12375;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

