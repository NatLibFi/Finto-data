:p14131  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2002-12-02"^^xsd:date;
        dct:modified     "2023-12-20"^^xsd:date;
        <http://rdaregistry.info/Elements/u/P60686>
                :p14132;
        skos:altLabel    "uppfostringshem"@sv;
        skos:broader     :p8577;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85112239> , <http://www.wikidata.org/entity/Q10709884>;
        skos:definition  "Kasvatuslaitoksia alettiin perustaa 1800-luvulla. Laitoksiin sijoitettiin tuomioistuinten päätöksillä 7–14-vuotiaita lapsia ja laitokset toimivat vankeinhoitohallituksen alaisina. Kasvatuslaitosten nimet muutettiin koulukodeiksi vuonna 1946, kun rangaistuslaitosten maineesta pyritiin eroon."@fi , "Uppfostringsanstalter började grundas på 1800-talet. I dessa anstalter placerades barn i åldern 7-14 på basis av domstolsbeslut och anstalterna fungerade under fångvårdsstyrelsen. Uppfostringsanstalternas namn ändrades till skolhem år 1946 då man försökte frånkomma ryktet som straffanstalter."@sv;
        skos:exactMatch  ysa:Y121972 , allars:Y42058;
        skos:inScheme    :;
        skos:note        "Concept in use until 1946. For later use, see <a href='http://www.yso.fi/onto/yso/p14132'>reform schools</a>."@en , "Sedan 1946 används begreppet <a href='http://www.yso.fi/onto/yso/p14132'>skolhem</a>"@sv , "Vuodesta 1946 alkaen käytetty nimitystä <a href='http://www.yso.fi/onto/yso/p14132'>koulukodit</a>"@fi;
        skos:prefLabel   "bajásgeassinásahusat"@se , "uppfostringsanstalter"@sv , "kasvatuslaitokset"@fi , "reformatories"@en;
        skos:related     :p14129;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26554 , :p26549;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "bajásgeassinásahus"@se , "reformatory"@en , "uppfostringsanstalt"@sv , "kasvatuslaitos"@fi .

