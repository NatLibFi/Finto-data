:p38310  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2019-03-07"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:altLabel    "indie pop"@fi , "indie pop"@sv;
        skos:broader     :p2969;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh2015000867> , <http://www.wikidata.org/entity/Q842324>;
        skos:definition  "Indierockille läheinen tyylilaji, joka alun perin liittyi punkin myötä syntyneeseen tee se itse -eetokseen ja itsenäisiin levy-yhtiöihin. Äänimaisemaltaan indiepop on indierockiin ja punkiin verrattuna rauhallisempi ja vähemmän aggressiivinen."@fi , "Musikstil besläktad med indierock, som från början förknippades med självständiga skivbolag och gör det själv-etoset som uppstått i samband med punk. Till sin ljudmiljö är indiepop lugnare och mindre aggressiv i jämförelse med indierock och punk."@sv;
        skos:exactMatch  allars:Y53220 , ysa:Y506952;
        skos:inScheme    :;
        skos:prefLabel   "indiepop"@fi , "indiepop"@se , "indiepop"@sv , "indie pop"@en;
        skos:related     :p21503;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

