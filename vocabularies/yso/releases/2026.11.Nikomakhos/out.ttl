        skos:broader     :p12382;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85139017> , <http://www.wikidata.org/entity/Q221686>;
        skos:definition  "Kompostionsteknik i vilken tonskalans tolv toner bestäms som jämlika och man avstår från hierarkiska förhållanden mellan tonerna. Användning av s.k. tonrad, vilken binder melodibildningen till en på förhand skapad regel är karakteristiskt för systemet."@sv , "Sävellystekniikka, jossa sävelasteikon 12 säveltä on määritelty tasa-arvoisiksi ja luovuttu tonaalisuuteen kuuluvista sävelten välisistä hierarkkisista suhteista. Järjestelmälle on tunnusomaista ns. sävelrivin käyttö, joka sitoo melodianmuodostuksen ennalta laadittuun sääntöön."@fi;
        skos:exactMatch  ysa:Y95760 , allars:Y27800;
        skos:inScheme    :;
        skos:prefLabel   "twelve-tone system"@en , "kaksitoistasäveljärjestelmä"@fi , "tolvtonssystem"@sv;
        skos:related     :p12383 , :p14414;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

