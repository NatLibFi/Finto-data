        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85134980>;
        skos:definition  "Yhdellä tai useammalla soittimella toteutettava säestys, joka perustuu tavallisesti säveltäjän kirjoittamaan bassostemmaan ja sointuja ilmaiseviin numeroihin."@fi , "Ackompanjemang som utförs med ett eller flera instrument och som vanligen baserar sig på bassostämma och siffror som anger ackord, skrivna av kompositören."@sv;
        skos:exactMatch  allars:Y38723 , ysa:Y102392;
        skos:inScheme    :;
        skos:note        "Vastaavasta säestysperiaatteesta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p9311'>kenraalibasso</a>."@fi , "Om motsvarande princip för ackompanjemang används begreppet <a href='http://www.yso.fi/onto/yso/p9311'>generalbas</a>."@sv;
        skos:prefLabel   "continuo"@en , "continuo"@fi , "continuo"@se , "continuo"@sv;
        skos:related     :p9311;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

