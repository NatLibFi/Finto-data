:p25254  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2011-05-04"^^xsd:date;
        dct:modified     "2024-10-02"^^xsd:date;
        skos:altLabel    "Finlandia-palkinto"@fi , "Finlandia Literary Prize"@en , "Finlandiapriset"@sv , "Finlandia-bálkkašupmi"@se;
        skos:broader     :p6879;
        skos:closeMatch  <http://www.wikidata.org/entity/Q911223>;
        skos:exactMatch  ysa:Y179068 , allars:Y41495;
        skos:inScheme    :;
        skos:prefLabel   "Kaunokirjallisuuden Finlandia"@fi , "Finlandia Prize in Fiction"@en , "Čáppagirjjálašvuođa Finlandia"@se , "Finlandiapriset i skönlitteratur"@sv;
        skos:scopeNote   "Jaetaan vuosittain ansiokkaan romaanin kirjoittajalle. Alun perin palkinto myönnettiin mille tahansa kaunokirjalliselle teokselle mutta vuodesta 1993 sen on voinut saada vain romaani."@fi , "Litterärt pris som utdelas årligen till författaren av en meriterad roman. Ursprungligen kunde priset tilldelas vilken skönlitterär genre som helst, men från och med år 1993 har endast romaner kunnat få priset."@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26564 .

