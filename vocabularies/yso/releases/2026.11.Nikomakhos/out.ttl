:p27948  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "2015-01-29"^^xsd:date;
        dct:modified        "2024-08-28"^^xsd:date;
        skos:altLabel       "vildren"@sv , "Rangifer tarandus"@fi;
        skos:broader        :p12133;
        skos:definition     "Hirvieläinlaji (Rangifer tarandus), jonka alalajeja ovat mm. metsäpeura ja tunturipeura (sekä siitä kesytetty poro) Euraasiassa ja karibut Pohjois-Amerikassa."@fi , "A species in the family Cervidae, whose subspecies include mountain reindeer (both wild and domesticated) and Finnish forest reindeer in Eurasia and caribou in North America."@en , "Hjortdjursart (Rangifer tarandus) med underarter såsom skogsren och fjällren (samt från den domesticerad tamren) i Eurasien och caribou i Nordamerika."@sv;
        skos:editorialNote  "TP onko ok näin enkuksi? en viitsinyt määritelmään laittaa että \"A species of deer..\" koska siinä olisi ollut tautologiaa preflabelin kanssa.";
        skos:exactMatch     allars:Y49504 , ysa:Y201958;
        skos:inScheme       :;
        skos:narrowMatch    <http://id.loc.gov/authorities/subjects/sh85112433>;
        skos:narrower       :p17524 , :p12662;
        skos:prefLabel      "peura (laji)"@fi , "ren (vild)"@sv , "reindeer (species)"@en , "goddi (šládja)"@se;
        skos:scopeNote      "Muista peuroiksi nimitetyistä hirvieläimistä käytetään kunkin lajin mukaista termiä, esim. valkohäntäpeura, kuusipeura."@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26529 .

