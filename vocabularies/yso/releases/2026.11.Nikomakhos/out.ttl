:p20679  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2009-11-20"^^xsd:date;
        dct:modified     "2023-03-30"^^xsd:date;
        skos:broader     :p15521;
        skos:closeMatch  <http://www.wikidata.org/entity/Q132438> , <http://id.loc.gov/authorities/subjects/sh99000162>;
        skos:definition  "Underart till heavy metal som utvecklades på slutet av 1980-talet ur trash metal. Präglas av snabb och aggressiv instrumentstil och ett skrikande sångsätt i högt tonläge. Texternas tema relaterar ofta till religiösa fenomen och mytologier. Typiska företrädare är Darkthrone, Bathory, Venom och Emperor."@sv , "1980-luvun lopulla thrash metal -tyylistä kehittynyt heavy metalin soittoteknisesti yksinkertainen alalaji, jolle ovat ominaisia nopea, aggressiivinen soittotapa ja korkeaääninen, kirskuva laulutapa. Sanoitusten aihepiiri liittyy usein uskonnollisiin ilmiöihin ja mytologioihin. Tyypillisiä edustajia ovat Darkthrone, Bathory, Venom ja Emperor."@fi;
        skos:exactMatch  allars:Y39173 , ysa:Y169576;
        skos:inScheme    :;
        skos:prefLabel   "black metal"@fi , "black metal"@en , "black metal"@se , "black metal"@sv;
        skos:related     :p29912 , :p29914 , :p26907 , :p29836;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

