        skos:broader        :p1307;
        skos:editorialNote  "Poistettu huomautus: \t\navopalvelu, jota asiakas saa kotonaan, kotona asumisen helpottamiseksi. Kotipalveluina voidaan järjestää mm. kodinhoitajan tai kotiavustajan antama työapu, vammaisen, vanhuksen tai pitkäaikaisesti sairaan asiakkaan kotona annettava hoito sekä erilaisia tukipalveluja. Kotipalveluja annetaan heikentyneen toimintakyvyn, perhetilanteen, rasittuneisuuden, sairauden, synnytyksen, vamman tms. syyn perusteella."@fi , "Käsite on aiemmin ollut jaettu. Jaetun käsitteen preflabel oli \"kotipalvelut (sosiaalipalvelut)\"."@fi;
        skos:exactMatch     allars:Y19456 , ysa:Y96379;
        skos:inScheme       :;
        skos:narrower       :p11496;
        skos:prefLabel      "kotipalvelut"@fi , "home help services"@en , "hemservice"@sv , "ruoktobálvalusat"@se;
