:p29838  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created       "2014-05-27"^^xsd:date;
        dct:modified      "2024-10-03"^^xsd:date;
        skos:altLabel     "videospelsmusik"@sv , "digitaalipelimusiikki"@fi , "computer game music"@en , "video game music"@en , "mobiilipelimusiikki"@fi , "verkkopelimusiikki"@fi , "tietokonepelimusiikki"@fi , "konsolipelimusiikki"@fi , "datorspelsmusik"@sv , "tv-spelsmusik"@sv , "videopelimusiikki"@fi , "mobile game music"@en;
        skos:broader      :p1808;
        skos:closeMatch   <http://www.wikidata.org/entity/Q1062702>;
        skos:definition   "Kaikenlaisten fyysisten, analogisten ja digitaalisten pelien yhteyteen sävelletty tai muokattu ja niiden pelaamisen tai seuraamisen aikana soitettavaksi ja kuultavaksi tarkoitettu musiikki. Termiä voi myös käyttää silloin, kun kyse on pelimusiikiksi sävelletystä musiikista, joka esiintyy muussa yhteydessä."@fi , "Musik som är komponerad eller bearbetad i anslutning till alla sorters fysiska, analoga eller digitala spel och avsedd att spelas upp och höras under spelandet. Begreppet kan också användas då det är frågan om musik som är komponerad som spelmusik, men som förekommer i en annan kontext."@sv;
        skos:exactMatch   ysa:Y214608 , allars:Y52022;
        skos:inScheme     :;
        skos:narrowMatch  <http://id.loc.gov/authorities/subjects/sh00009336>;
        skos:prefLabel    "speallanmusihkka"@se , "spelmusik"@sv , "pelimusiikki"@fi , "game music"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p20796 , :p26571 .

