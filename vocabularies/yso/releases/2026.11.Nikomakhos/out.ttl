:p28777  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2016-01-13"^^xsd:date;
        dct:modified     "2023-08-02"^^xsd:date;
        skos:broader     :p28425;
        skos:exactMatch  allars:Y50170 , ysa:Y206801;
        skos:inScheme    :;
        skos:note        "Område som till sin tradition är relativt homogent. Bestämningen av ett traditionsområde påverkas bl.a. av etnicitet, dialekt eller språk, administrativa gränser och religion. Inom finländsk traditionsforskning indelas traditionsområden vanligen i enlighet med Finlands historiska landskap."@sv , "Alue, joka on perinteensä osalta suhteellisen homogeeninen. Perinnealueen määrittymiseen vaikuttavat mm. etnisyys, murre tai kieli, hallinnolliset rajat ja uskonto. Suomalaisessa perinteentutkimuksessa perinnealuejako myötäilee yleensä Suomen historiallisia maakuntia."@fi;
        skos:prefLabel   "traditionsområden"@sv , "tradition areas"@en , "perinnealueet"@fi , "árbeguovllut"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26532;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "traditionsområde"@sv , "árbeguovlu"@se , "tradition area"@en , "perinnealue"@fi .

