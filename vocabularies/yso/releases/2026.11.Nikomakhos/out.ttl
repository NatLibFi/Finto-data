:p26385  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2012-06-07"^^xsd:date;
        dct:modified     "2023-08-02"^^xsd:date;
        skos:altLabel    "matfostran"@sv , "måltidspedagogik"@sv;
        skos:broader     :p476;
        skos:exactMatch  ysa:Y186412 , allars:Y44690;
        skos:inScheme    :;
        skos:note        "Matfostran ges i bl.a. daghem och skolor. I skolan sammanknyts det med flera läroämnen och till det hör också skolbespisning och annan måltidsrelaterad verksamhet (t.ex. mellanmål). Matfostran är en del av skolornas hållbarhetsfostran."@sv , "Ruokakasvatusta annetaan mm. päiväkodeissa ja kouluissa. Koulussa ruokakasvatus nivoutuu useaan oppiaineeseen ja siihen kuuluu myös kouluruokailu ja muu kouluaikaiseen ruokailemiseen liittyvä toiminta (mm. välipalat). Ruokakasvatus on osa koulujen kestävyyskasvatusta"@fi;
        skos:prefLabel   "borramušbajásgeassin"@se , "food education"@en , "matpedagogik"@sv , "ruokakasvatus"@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26555 , :p26554 .

