        skos:exactMatch  allars:Y44521 , ysa:Y185600;
        skos:inScheme    :;
        skos:note        "Ranskassa 1700-luvulla alkunsa saanut muotitaide, jolla nykyisin viitataan kalliisiin ja korkeatasoisiin, mittatilaustyönä ja pääosin käsintehtyihin muotiluomuksiin, joita voidaan pitää taideteoksina."@fi , "Form of fashion that originated in 18th century France. Today referring to expensive and high-quality handmade fashion items that can be regarded as works of art."@en , "Modekonst som fick sin början i 1700-talets Frankrike och med vilken man numera hänvisar till dyra, högkvalitativa, måttbeställda och i huvudsak handgjorda modekreationer som kan anses vara konstverk."@sv;
        skos:prefLabel   "haute couture"@fi , "haute couture"@se , "haute couture"@sv , "haute couture"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26532 , :p26578 .

