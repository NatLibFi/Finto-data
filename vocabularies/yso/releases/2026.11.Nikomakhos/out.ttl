        skos:broader     :p245;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh85015572>;
        skos:definition  "Tredimensionell beskrivning av ett landskap i miniatyrstorlek, i vilken storleksförhållanden och material avbildar verkligheten så väl som möjligt. Landskapet görs ofta i en låg kruka, ett kärl eller på ett träunderlag."@sv , "Bonkei on kolmiulotteinen kuvaus maisemasta pienoiskoossa, jossa mittasuhteet ja materiaalit pyritään pitämään mahdollisimman todellisuutta jäljittelevinä. Maisema tehdään yleensä matalaan ruukkuun, astiaan tai puualustalle."@fi;
        skos:exactMatch  ysa:Y186330 , allars:Y44645;
        skos:inScheme    :;
        skos:prefLabel   "bonkei"@fi , "bonkei"@se , "bonkei"@sv , "bonkei"@en;
        skos:related     :p30200 , :p4931;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26586 , :p26528 .

