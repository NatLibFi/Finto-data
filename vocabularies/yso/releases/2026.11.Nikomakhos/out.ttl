:p21343  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2008-10-09"^^xsd:date;
        dct:modified     "2026-05-06"^^xsd:date;
        skos:altLabel    "vildmarksområden"@sv;
        skos:broader     :p16977;
        skos:closeMatch  <http://www.wikidata.org/entity/Q2445527> , <http://id.loc.gov/authorities/subjects/sh85146698>;
        skos:definition  "Statsägt markområde som är obebyggt och väglöst och som enligt lag är reserverat för utövande av naturnäringar."@sv , "Uninhabitet and roadless area owned by the state, restricted by law to traditional livelihoods."@en , "Valtion omistama asumaton ja tietön maa-alue, joka on lain nojalla varattu perinteisten luontaiselinkeinojen harjoittamiseen. -- Ympäristösanasto"@fi;
        skos:exactMatch  ysa:Y161598 , allars:Y36736;
        skos:inScheme    :;
        skos:note        "Suomessa on 12 erämaa-aluetta: Hammastunturin, Kaldoaivin, Kemihaaran, Käsivarren, Muotkatunturin, Paistunturin, Puljun, Pöyrisjärven, Tarvantovaaran, Tsarmitunturin, Tuntsan ja Vätsärin erämaa-alueet."@fi , "I Finland finns 12 ödemarksområden: området Lapska armen, Tarvantovaaraområdet, Pöyrisjärviområdet, Muotkatunturiområdet, Paistunturiområdet, Kaldoaiviområdet, Vätsäriområdet, Tsarmitunturiområdet, Hammastunturiområdet, Puljuområdet, Kemihaaraområdet och Tuntsaområdet."@sv , "Finland has 12 wilderness areas: Hammastunturi, Kaldoaivi, Kemihaara, Käsivarsi, Muotkatunturi, Paistunturi, Pulju, Pöyrisjärvi, Tarvantovaara, Tsarmitunturi, Tuntsa and Vätsäri."@en;
        skos:prefLabel   "erämaa-alueet"@fi , "wilderness areas"@en , "ödemarksområden"@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26560 , :p26526;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "vildmarksområde"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "wilderness area"@en , "erämaa-alue"@fi , "ödemarksområde"@sv .

