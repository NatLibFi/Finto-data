:p28980  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source           "Maa- ja elintarviketalouden tutkimuskeskus, 2009."@fi;
        dct:created         "2016-05-19"^^xsd:date;
        dct:modified        "2023-04-04"^^xsd:date;
        skos:altLabel       "ursprungliga raser"@sv;
        skos:broader        :p40541;
        skos:editorialNote  "Tarkistetaan vielä, mihin local breeds viittaa.";
        skos:exactMatch     allars:Y50700 , ysa:Y208651;
        skos:inScheme       :;
        skos:note           "Alkuperäisrotu on tietyn maantieteellisen alueen perinteinen kotieläinrotu. Rodulla on omalla alueellaan pitkä historia ja se perustuu tietyllä alueella perinteisesti kasvatettuun eläinkantaan."@fi , "Traditionell husdjursras för ett visst geografiskt område. Rasen har en lång historia på det egna området och och den grundar sig på ett djurbestånd som traditionellt fötts upp på området."@sv;
        skos:prefLabel      "alkuperäisrodut"@fi , "ursprungsraser"@sv , "endemic breeds"@en;
        skos:related        :p2032;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26528;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "ursprunglig ras"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "endemic breed"@en , "alkuperäisrotu"@fi , "ursprungsras"@sv .

