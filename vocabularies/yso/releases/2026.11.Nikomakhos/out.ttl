        skos:broader        :p796;
        skos:closeMatch     <http://www.wikidata.org/wiki/Q16426763>;
        skos:editorialNote  "2023-03-24 TP Tästä keskusteltiin. Onko järkevää, että englannin preflabelissa on suomen monikkomuoto? Yksikkömuoto palvelisi englanninkielistä käyttäjää paremmin, koska käyttäjä ei välttämättä tunne suomen kielen taivutusjärjestelmää. Luonnollisessa kielenkäytössä tällaiset sitaattilainat ilmennevät yleensä yksikkömuodossa. Tämän voisi ottaa keskusteluun jossakin OY-kokouksessa.";
        skos:inScheme       :;
        skos:prefLabel      "parat"@fi , "parat (supernatural creatures)"@en , "bjäror"@sv , "bárát"@se;
        skos:related        :p29541;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26532;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "pukhare"@sv , "mjölkhare"@sv , "trollhare"@sv , "puke"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
