:p29869  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2017-07-11"^^xsd:date;
        dct:modified     "2020-09-24"^^xsd:date;
        skos:altLabel    "minstrelartister"@sv;
        skos:broadMatch  <http://id.loc.gov/authorities/subjects/sh86002417>;
        skos:broader     :p5329;
        skos:definition  "Yhdysvalloissa 1800-luvulla suosittu viihdemuoto minstrel show oli laulua, tanssia ja teatteria yhdistävä esitys, jossa perinteisesti karrikoitiin mustien ulkonäköä, tanssia ja laulua. Yleensä minstrel show -esiintyjät olivat valkoisia viihdetaiteilijoita, jotka maalasivat kasvonsa mustiksi."@fi , "Minstrel show var i 1800-talets USA en populär underhållningsform som utgjordes av en kombination av sång, dans och teater och som karikerade svartas utseende, dans och sång. Minstrel show-artisterna var vanligen vita underhållningsartister som målade sina ansikten svarta."@sv;
        skos:exactMatch  ysa:Y214789 , allars:Y52078;
        skos:inScheme    :;
        skos:note        "Termin lisäksi on syytä käyttää maantieteellisiä ja ajallisia täsmenteitä."@fi;
        skos:prefLabel   "minstrel show -esiintyjät"@fi , "minstrel show performers"@en , "minstrel show-artister"@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 , :p26582;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "minstrelartist"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "minstrel show-artist"@sv , "minstrel show -esiintyjä"@fi , "minstrel show performer"@en .

