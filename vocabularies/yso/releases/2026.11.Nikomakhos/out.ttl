:p24914  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "2011-06-08"^^xsd:date;
        dct:modified     "2023-03-21"^^xsd:date;
        skos:altLabel    "erirakenteiskasvatus"@fi , "eri-ikäismetsätalous"@fi , "eri-ikäisrakenteinen metsätalous"@fi , "harsintametsätalous"@fi , "uneven-age management"@en , "kontinuerlig beståndsvård"@sv , "hyggesfritt skogsbruk"@sv;
        skos:broader     :p24915;
        skos:definition  "Metsänkasvatustapa, jossa yksittäiset puut syntyvät eri aikoina, jolloin tuloksena on kaiken ikäisiä ja kaiken kokoisia puita sisältävä metsä. Hakkuut ovat poimintahakkuita ja uusiutuminen tapahtuu luontaisesti. -- Tuhat tärkeää termiä - metsäsanasto"@fi , "Skogsodlingsmetod som innebär att enskilda träd börjar växa i olika skeden och resultatet således blir skog med träd i olika storlek och ålder. Avverkning sker i form av plockhuggning och förnyelse sker naturligt."@sv;
        skos:exactMatch  ysa:Y179781 , allars:Y40679;
        skos:inScheme    :;
        skos:prefLabel   "kontinuitetsskogsbruk"@sv , "selection system (forest cultivation)"@en , "jatkuva kasvatus"@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26537 .

