:p13288  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1993-04-20"^^xsd:date;
        dct:modified     "2026-02-06"^^xsd:date;
        skosext:partOf   :p13285;
        skos:broader     :p272 , :p6818;
        skos:closeMatch  <http://www.wikidata.org/entity/Q313354>;
        skos:exactMatch  allars:Y19772 , ysa:Y107342;
        skos:inScheme    :;
        skos:note        "Inom den statliga lokalförvaltningen följer häraderna efter länen. En härad var ursprungligen en socken och senare blev den bla. en domares tjänsteområde. Mellan 1945-1996 sköttes folkbok- föringen i häraderna. Från och med 1.12.1996 är den statliga lokalförvaltningen ordnad härads- vis. Antalet härader är 90."@sv , "Lääniä pienempi valtion paikallisalue. Kihlakunta on alkuaan vastannut pitäjää, myöhemmin se on ollut mm. tuomarin virka-alue. Vuodesta 1945 vuoteen 1996 kihlakunta on ollut henkikirjoittajan toimialue. 1.12.1996 lähtien paikallishallinto on järjestetty kihlakunnittain, joita on 90"@fi;
        skos:prefLabel   "kihlakunnat"@fi , "härader"@sv , "jurisdictional districts"@en , "gihligottit"@se;
        skos:related     :p13285;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26559 , :p26524;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "jurisdictional district"@en , "kihlakunta"@fi , "härad"@sv , "gihligoddi"@se .

