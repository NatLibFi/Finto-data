:p9577  rdf:type            <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "1987-01-01"^^xsd:date;
        dct:modified        "2026-06-03"^^xsd:date;
        skos:altLabel       "kanoner (urval)"@sv , "kanonit"@fi , "konstkanoner"@sv , "literary canons"@en , "kulturkanoner"@sv , "kanonisering (verk)"@sv , "kanonisointi (teokset)"@fi , "konstkanon"@sv , "taidekaanonit"@fi , "litteraturkanoner"@sv , "litteraturkanon"@sv , "kulturkanon"@sv , "kulttuurikaanonit"@fi , "kirjallisuuskaanonit"@fi , "cultural canons"@en;
        skos:broader        :p22841;
        skos:editorialNote  "Sme: lisätty ohjaustermit kirjallisuuskaanonit, kulttuurikaanonit, taidekaanonit"@se , "Käsitteen vanha preflabel oli \"kaanonit (uskonnolliset tuotokset)\"."@fi , "Poistettu huomautus: Sanalla on monia merkityksiä. 1) Uskonnossa kaanon voi olla pyhien kirjojen kokoelma, kirkolliskokouksen tai paavin säädös, katolisen kirkon pyhimysluettelo tai ortodoksinen liturginen runoelma. 2) Kuvataiteissa ihmisruumiin ihanteellisten mittasuhteiden säännöt. 3) Musiikissa moniääninen sävellysmuoto, jossa sama teema alkaa uudessa äänessä ennen kuin se on päättynyt toisessa. 4) Kirjallisuudenhistoriassa yleisesti hyväksytyt teokset. 5) Kirjapainoalalla eräs iso kirjasinkoko"@fi;
        skos:exactMatch     ysa:Y102064 , allars:Y46671;
        skos:inScheme       :;
        skos:narrowMatch    <http://id.loc.gov/authorities/subjects/sh85019643>;
        skos:note           "Kulttuurin ja/tai taiteen keskeisinä pidetyt teokset esim. jossakin maassa, tai uskonnon pyhien kirjojen kokoelma."@fi , "Verk som anses centrala för kultur och/eller konst t.ex. i något land, eller en religions samling heliga skrifter."@sv;
        skos:prefLabel      "canons (collections)"@en , "kaanonit (valikoimat)"@fi , "kanon (urval)"@sv;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26551 , :p26564 , :p26571 , :p26581;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "kirjallisuuskaanon"@fi , "cultural canon"@en , "taidekaanon"@fi , "literary canon"@en , "kulttuurikaanon"@fi;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "canon (collections)"@en , "kaanon (valikoimat)"@fi .

