        skos:definition     "Verk komponerat eller arrangerat för två instrument."@sv , "Kahdelle soittimelle sävelletty tai sovitettu teos."@fi , "A composition or arrangement for two instrumentalists."@en;
        skos:editorialNote  "Sme: tarkenne muuttunut"@se;
        skos:exactMatch     ysa:Y214773 , allars:Y51741;
        skos:inScheme       :;
        skos:note           "Om verk komponerade eller arrangerade för två sångröster används begreppet <a href='http://www.yso.fi/onto/yso/p8007'>duetter</a>. Om ensemble bestående av två instrumentalister används begreppet <a href='http://www.yso.fi/onto/yso/p29815'>duor (ensembler)</a>."@sv , "Kahdelle lauluäänelle sävelletyistä tai sovitetuista teoksista käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p8007'>duetot</a>. Kahden soittajan muodostamasta esityskokoonpanosta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p29815'>duot (yhtyeet)</a>."@fi , "For compositions or arrangements for two singers, see <a href='http://www.yso.fi/onto/yso/p8007'>duets (vocal)</a>. For ensembles of two musicians, see <a href='http://www.yso.fi/onto/yso/p29815'>duos (ensembles)</a>."@en;
        skos:prefLabel      "duor (instrumentalmusik)"@sv , "duot (komposišuvnnat)"@se , "duot (soitinmusiikki)"@fi , "duets (instrumentals)"@en;
