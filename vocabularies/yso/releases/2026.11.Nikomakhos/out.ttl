:p9975  rdf:type           skos:Concept , <http://www.yso.fi/onto/yso-meta/DeprecatedConcept>;
        dc:source          "Lähde: CD-Facta"@fi;
        dct:created        "1995-10-26"^^xsd:date;
        dct:isReplacedBy   :p6458 , :p6457;
        owl:deprecated     true;
        skos:broadMatch    :p418;
        skos:broader       <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        skos:closeMatch    <http://www.wikidata.org/entity/Q4989857>;
        skos:exactMatch    allars:Y17426 , ysa:Y104318;
        skos:inScheme      :deprecatedconceptscheme;
        skos:note          "Avser personer som av religiösa eller politiska orsaker har tvingats lämna sitt hemland. Används främst i historisk bemärkelse, i annat fall används begreppet <a href='http://www.yso.fi/onto/yso/p6458'>flyktingar</a>."@sv , "Tarkoittaa henkilöä, joka uskonnollisista tai poliittisista syistä on joutunut jättämään kotimaansa. Käytetään lähinnä historiallisessa yhteydessä, muissa tapauksissa käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p6458'>pakolaiset</a>."@fi , "A person who has been forced to leave their own country, typically for political or religious reasons. Mainly used in historical contexts, for contemporary use see <a href='http://www.yso.fi/onto/yso/p6458'>refugees</a>."@en;
        skos:prefLabel     "emigrantit"@fi , "emigranter"@sv , "émigrés"@en;
        skos:relatedMatch  :p6457 , :p9977 , :p6458 , :p20631 , :p6165 , :p6639;
        <http://www.yso.fi/onto/yso-meta/comment>
                "deprecated on 2022-09-30";
        <http://www.yso.fi/onto/yso-meta/deprecatedBroader>
                <http://www.yso.fi/onto/yso-meta/deprecatedConcepts>;
        <http://www.yso.fi/onto/yso-meta/deprecatedHasThematicGroup>
                :p26541 , :p26570;
