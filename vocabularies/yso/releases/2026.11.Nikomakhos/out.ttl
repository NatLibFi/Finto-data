:p17833  rdf:type           <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created         "1993-05-05"^^xsd:date;
        dct:modified        "2023-07-07"^^xsd:date;
        skos:broader        :p220;
        skos:closeMatch     <http://www.wikidata.org/entity/Q133363>;
        skos:editorialNote  "LCSH:ssa satanism, mutta eri merkityksellä";
        skos:exactMatch     ysa:Y107336 , allars:Y25630;
        skos:inScheme       :;
        skos:note           "Avser livsuppfattning, filosofi och religion som betonar människans djuriska och kroppsliga sida. Enligt denna satanism är det bara självständiga, individualistiska och egoistiska moraluppfattningar som är godtagbara. Om dyrkan av Satan som personifierad ondska används begreppet <a href='http://www.yso.fi/onto/yso/p9012'>satansdyrkan</a>."@sv , "Elämänkäsitys, filosofia ja uskonto, joka painottaa ihmisen eläimellistä ja ruumiillista puolta. Satanismin mukaan vain itsenäiset, individualistiset ja egoistiset moraalikäsitykset ovat hyväksyttäviä. Personoidun pahuuden palvonnasta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p9012'>saatananpalvonta</a>."@fi;
        skos:prefLabel      "satanism"@sv , "satanismi"@fi , "satanism"@en , "satanisma"@se;
        skos:related        :p9012;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26532 , :p26551 .

