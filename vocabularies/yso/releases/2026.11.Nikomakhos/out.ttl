:p27133  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Wikipedia"@en;
        dct:created      "2013-03-26"^^xsd:date;
        dct:modified     "2026-06-11"^^xsd:date;
        skos:altLabel    "rekilaulut"@en , "finska enstrofingar"@sv , "riimilliset kansanlaulut"@fi;
        skos:broader     :p2842;
        skos:definition  "A type of rhymed stanzaic folksong in Finland."@en , "Finsk lyrisk folksång som blev allmän på 1800-talet. Den bestod urpsrungligen av en strof och två verspar med slutrim sinsemellan. Det första versparet innehöll vanligen en inledning av allmän karaktär, ofta med naturen som ämne, med vilket det efterföljande versparet sammankopplade en egen erfarenhet hos sångaren."@sv , "1800-luvulla yleistynyt suomalainen, alkuaan yksisäkeistöinen, kahdesta keskenään loppusoinnullisesta säeparista muodostunut lyyrissävyinen kansanlaulu. Ensimmäinen säepari sisältää tavallisesti yleisluontoisen mieleen johdatuksen, yleensä luontoaiheisen, johon jälkisäepari liittää laulajan omakohtaisen kokemuksen."@fi;
        skos:exactMatch  allars:Y45618 , ysa:Y191922;
        skos:inScheme    :;
        skos:note        "Det finns inget etablerat motsvarande begrepp på svenska."@sv;
        skos:prefLabel   "rekilaulu"@en , "rekilaulut"@fi , "rekilaulut"@sv , "rekilaulut"@se;
        <http://www.w3.org/2008/05/skos-xl#altLabel>
                <http://www.yso.fi/onto/yso/p27133#xl_altLabel_en_100069>;
        <http://www.w3.org/2008/05/skos-xl#prefLabel>
                <http://www.yso.fi/onto/yso/p27133#xl_prefLabel_en_100068>;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26532 , :p26571;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "finsk enstrofing"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "rekilaulu"@fi .

