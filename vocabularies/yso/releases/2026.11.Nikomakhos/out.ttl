:p13057  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Lähde: Eläketurvakeskus"@fi;
        dct:created      "2000-02-11"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:broader     :p5933;
        skos:closeMatch  <http://www.wikidata.org/entity/Q182103> , <http://id.loc.gov/authorities/subjects/sh85099579>;
        skos:exactMatch  ysa:Y112695 , allars:Y24199;
        skos:inScheme    :;
        skos:narrower    :p13055;
        skos:note        "Taloudellinen yksikkö (esim. Valtion eläkerahasto) tai useiden toimijoiden muodostama kokonaisuus (yksityisen sektorin työeläkerahastot), joka hallinnoi toimintapiiriin kuuluvien henkilöiden eläkkeitä varten kerättyjä varoja ja yleensä maksaa myös eläkkeitä. Menot rahoitetaan vakuutusmaksuilla ja rahastoivassa eläkejärjestelmässä myös sijoitusten tuotolla."@fi , "Ekonomisk enhet eller helhet bildad av flera aktörer, som förvaltar medel som samlats för pensioner och vanligen också betalar ut pensioner. Utgifterna finansieras med försäkringsavgifter och i fonderande system också med avkastning från investeringar."@sv;
        skos:prefLabel   "pension funds"@en , "eläkerahastot"@fi , "pensionsfonder"@sv , "ealáhatfoanddat"@se;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26538 , :p26549;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "pension fund"@en , "pensionsfond"@sv , "eläkerahasto"@fi , "ealáhatfoanda"@se .

