        skos:altLabel    "free jazz"@sv;
        skos:broader     :p4484;
        skos:closeMatch  <http://id.loc.gov/authorities/subjects/sh2003005848> , <http://www.wikidata.org/entity/Q211781>;
        skos:definition  "1960-luvulla syntynyt kokeellinen jazzin tyylisuuntaus, jossa on pyritty eroon perinteisistä improvisointia ja yhteissoittoa koskeneista säännöistä. Tunnettuja free jazzin edustajia ovat olleet mm. Cecil Taylor, Ornette Coleman ja Art Ensemble of Chicago, Suomessa Edward Vesala."@fi , "Experimentell stilriktning inom jazz som uppkom på 1960-talet, och i vilken de traditionella reglerna beträffande improvisering och samspel luckrats upp. Kända representanter har varit bl.a. Cecil Taylor, Ornette Coleman och Art Ensemble of Chicago, i Finland Edward Vesala."@sv;
        skos:exactMatch  ysa:Y109478 , allars:Y41886;
        skos:inScheme    :;
        skos:prefLabel   "free jazz"@fi , "free jazz"@se , "frijazz"@sv , "free jazz"@en;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571 .

