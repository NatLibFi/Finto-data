        skos:exactMatch  ysa:Y214819 , allars:Y51837;
        skos:inScheme    :;
        skos:note        "Om verk komponerade eller arrangerade för tre instrument används begreppet <a href='http://www.yso.fi/onto/yso/p29864'>trior (kompositioner)</a>. Om ensemble bestående av tre sångare används begreppet <a href='http://www.yso.fi/onto/yso/p30131'>tersetter (ensembler)</a>."@sv , "Kolmelle soittimelle sävelletyistä tai sovitetuista teoksista käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p29864'>triot (sävellykset)</a>. Kolmen laulajan muodostamasta esityskokoonpanosta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p30131'>tertsetit</a>."@fi;
        skos:prefLabel   "tertsetot"@fi , "tersetter (kompositioner)"@sv , "terzettos (compositions)"@en;
