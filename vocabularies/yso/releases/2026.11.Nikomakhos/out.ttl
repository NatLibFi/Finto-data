:p4181  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "SFS:n SI-opas"@fi;
        dct:created      "1993-01-12"^^xsd:date;
        dct:modified     "2023-02-08"^^xsd:date;
        skos:broader     :p1400;
        skos:closeMatch  <http://www.wikidata.org/entity/Q107715>;
        skos:exactMatch  allars:Y26933 , ysa:Y106831;
        skos:inScheme    :;
        skos:narrower    :p4180 , :p38865 , :p2101;
        skos:note        "En storhet är en egenskap som till sin kvalitet kan igenkännas och till sin kvantitet mätas. Egenskaper som kan mätas hos naturfenomen är storheter. Storheter är tid, längd, massa, kraft, frekvens, resistans, vinkel m.m. Deras motsvarande måttenheter är sekund, meter, kilogram, newton, hertz, ohm, radian m.m. En storhets värde är talvärdets och måttenhetens produkt. Exempel: längden är fem meter. Här är längden storhet, fem talvärde och meter enhet."@sv , "Suure on ominaisuus, joka voidaan laadultaan tunnistaa ja määrältään mitata. Luonnonilmiöiden mitattavat ominaisuudet ovat suureita. Suureita ovat aika, pituus, massa, voima, taajuus, resistanssi, tasokulma ym. Niiden mittayksiköt ovat sekunti, metri, kilogramma, newton, hertsi, ohmi, radiaani ym. Suureen arvo on lukuarvon\nja mittayksikön tulo. Esimerkki: pituus on viisi metriä. Tässä pituus on suure, viisi lukuarvo ja metri yksikkö."@fi;
        skos:prefLabel   "storheter"@sv , "quantities"@en , "suureet"@fi;
        skos:related     :p4366 , :p3586 , :p4499;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26565;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "quantity"@en , "suure"@fi , "storhet"@sv .

:p9200  rdf:type         <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dc:source        "Finlex"@fi;
        dct:created      "1992-06-05"^^xsd:date;
        dct:modified     "2025-01-10"^^xsd:date;
        skos:altLabel    "julkinen oikeusapu"@fi , "oikeudellinen neuvonta"@fi , "offentlig rättshjälp"@sv , "legal help"@en , "allmän rättshjälp"@sv , "almmolaš riekteveahkki"@se , "public legal aid"@en , "yleinen oikeusapu"@fi;
        skos:broader     :p838;
        skos:closeMatch  <http://www.wikidata.org/entity/Q707748> , <http://id.loc.gov/authorities/subjects/sh85075720>;
        skos:exactMatch  ysa:Y106174 , allars:Y30769;
        skos:inScheme    :;
        skos:note        "Oikeusapua annetaan valtion varoin henkilölle, joka tarvitsee asiantuntevaa apua oikeudellisessa asiassa ja joka taloudellisen asemansa vuoksi ei kykene itse suorittamaan sen hoitamisen vaatimia menoja."@fi , "Public legal aid is provided by the state to a person who needs assistance in a legal matter and is unable to cover the expenses due to his or her finanical situation."@en , "Rättshjälp ges med statliga medel till personer som behöver sakkunnig hjälp vid skötsel av juridiska ärenden och som p.g.a. sin ekonomiska ställning inte själva kan bekosta sådan."@sv;
        skos:prefLabel   "oikeusapu"@fi , "legal aid"@en , "riekteveahkki"@se , "rättshjälp"@sv;
        skos:related     :p13146 , :p9201 , :p9198;
        skos:scopeNote   "För den hjälp en domstol kan ge en annan domstol eller myndighet används begreppet <a href='http://www.yso.fi/onto/yso/p12955'>handräckning</a>."@sv , "In reference to aid by a court to another court or to a public authority use <a href='http://www.yso.fi/onto/yso/p12955'>executive assistance</a>."@en , "Tuomioistuimen toiselle tuomioistuimelle tai viranomaiselle antamasta avusta käytetään käsitettä <a href='http://www.yso.fi/onto/yso/p12955'>virka-apu</a>."@fi;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26559 .

