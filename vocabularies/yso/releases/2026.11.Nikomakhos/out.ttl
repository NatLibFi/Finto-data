:p13836  rdf:type        <http://www.yso.fi/onto/yso-meta/Concept> , skos:Concept;
        dct:created      "1987-01-01"^^xsd:date;
        dct:modified     "2024-05-01"^^xsd:date;
        skos:altLabel    "kuplettsånger"@sv , "cuplés"@en;
        skos:broadMatch  <http://id.loc.gov/authorities/subjects/sh85062974>;
        skos:broader     :p2371;
        skos:closeMatch  <http://www.wikidata.org/entity/Q3843655>;
        skos:definition  "Suomessa 1800-luvun lopulla vakiintunut säkeistö-kertosäkeistö -muotoinen laulutyyppi, jolle on ominaista ajankohtaisten aiheiden käsittely humoristisella tai satiirisella tavalla. Perinteisiä kuplettilaulajia ovat olleet J. Alfred Tanner, Rafael Ramstedt ja Esa Pakarinen, uudempiin kuuluu mm. Jaakko Teppo."@fi , "Sångtyp med formen vers-refräng som etablerades i Finland i slutet av 1800-talet, och i vilken aktuella ämnen behandlas på ett humoristiskt eller satiriskt sätt. Traditionella kuplettsångare har varit J. Alfred Tanner, Rafael Ramstedt och Esa Pakarinen, till de nyare hör bl.a. Jaakko Teppo."@sv;
        skos:exactMatch  allars:Y21466 , ysa:Y96572;
        skos:inScheme    :;
        skos:prefLabel   "kupletter"@sv , "kupletit"@fi , "comic songs"@en , "kupleahtat"@se;
        skos:related     :p7159 , :p16293 , :p30045 , :p18116;
        <http://www.yso.fi/onto/yso-meta/memberOf>
                :p26571;
        <http://www.yso.fi/onto/yso-meta/singularAltLabel>
                "cuplé"@en , "kuplettsång"@sv;
        <http://www.yso.fi/onto/yso-meta/singularPrefLabel>
                "kupleahtta"@se , "kuplett"@sv , "comic song"@en , "kupletti"@fi .

