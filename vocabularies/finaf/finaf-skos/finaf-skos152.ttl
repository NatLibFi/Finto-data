        "Vladimir I, kievrusisk furste, ca. 956-1015"@sv ;
    rdau:P61101 "<a href='https://fi.wikipedia.org/wiki/Vladimir_Suuri'>Wikipedia</a>, katsottu 10.9.2026 (Vladimir Suuri, kastettuna Vasili (ven. Влади́мир I Святосла́вич, Vladimir I Svjatoslavitš; ukr. Володи́мир I Святосла́вич, Volodymyr I Svjatoslavytš) (muinaisslaaviksi: Володи́мѣръ Свѧтосла́вичь) ; (n. 956 Kiova – 15. heinäkuuta 1015 Berestovo, lähellä Kiovaa) oli Kiovan Rusin ruhtinas vuosina 980–1015. Vladimir oli ensimmäinen Kiovan ruhtinas, joka otti kristillisen kasteen vuonna 988 ja sen vuoksi hänet tunnetaan Venäjän ortodoksisessa kirkossa pyhänä eli pyhimyksenä nimellä Pyhä Vladimir Kiovalainen. Hän on saanut myös tittelin \"apostolienvertainen\". )"@fi,
        "<a href='https://libris.kb.se/rp3573491lhz493#it'>Libris</a>, katsottu 10.9.2026 (Vladimir I, kievrusisk furste, ca. 956-1015)"@fi,
        "<a href='https://www.ortodoksi.net/index.php/Vladimir_Kiovalainen'>Ortodoksi.net-sivusto</a>, katsottu 10.9.2026 (Vladimir Kiovalainen: Pyhä apostolienvertainen Vladimir Kiovalainen, Kiovan Venäjän hallitsija vuosina 980 – 1015. Hänet tunnetaan myös nimellä Vladimir Suuri.)"@fi ;
    skos:altLabel "Vladimir I, Kiovan suuriruhtinas, noin 956-1015"@fi,
        "Vladimir, Kiovalainen, noin 956-1015"@fi,
        "Vladimir, Suuri, noin 956-1015"@fi,
        "Vladimir, suuriruhtinas, noin 956-1015"@fi,
        "Володи́мир I, Святосла́вич, noin 956-1015"@fi ;
    skos:inScheme finaf: ;
