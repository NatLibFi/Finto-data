    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Clason, Jan, 1704-1790"@fi,
        "Clason, John, 1704-1790"@fi ;
    rdaa:P50104 mts:m2536,
        mts:m2770,
        mts:m3996,
        mts:m4162 ;
    rdaa:P50109 yso:p104995,
        yso:p105464 ;
    rdaa:P50113 "Ruotsalainen, Tukholmassa toiminut liike- ja teollisuusmies. 1730-luvulla edusti Ruotsia varakonsulina Lontoossa. Palasi Tukholmaan 1740-luvun alussa, ja isänsä kuoltua vuonna 1747 otti hoitaakseen Blasieholmenin telakan perillisten puolesta; hänen johdollaan telakalla rakennettiin aluksia Itä-Intian kauppakomppanialle. Veljensä Jacobin kuoltua vuonna 1750 hänestä tuli myös Graningen rautaruukin johtaja. Hän kiinnostui syvästi rautaruukin hallinnosta ja luovutti siksi Blasieholmenin telakan sisarenpojalleen Jacob Ephraimille vuonna 1769. 1770-luvulla hän kävi tappiollisen oikeusriidan maaherra Carl Bungen kanssa, ja hakeutui konkurssiin vuonna 1785. Julkaisi taloustieteellisiä tutkielmia, joiden ansiosta hänet kutsuttiin Ruotsi kuninkaallisen tiedeakatemian jäseneksi vuonna 1745, ja toimiessaan akatemian puheenjohtajana vuosina 1751 ja 1760 hän piti merkittäviä puheita Ruotsin kaupan historiasta."@fi ;
    rdaa:P50120 "1790" ;
    rdaa:P50121 "1704" ;
    rdaa:P50291 "Clason" ;
    rdaa:P50292 "Johan" ;
    rdaa:P50346 "Sollefteå, Ruotsi"@fi ;
