finaf:000237799 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-09-16"^^xsd:date ;
    dct:modified "2026-09-16T13:46:10+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000053376248>,
        <http://viaf.org/viaf/62390896>,
        "Asteri ID: 000237799" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Brelin, Nicolaus Johannis, 1697-1753"@fi,
        "Brelin, Nils Johansson, 1697-1753"@fi,
        "Bräckselius, Nils, 1697-1753"@fi ;
    rdaa:P50104 mts:m2479,
        mts:m2946 ;
    rdaa:P50109 "Karlstad, Ruotsi"@fi ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi ja tiedemies. Toimi aluksi kirjurina Karlstadin raastuvanoikeudessa, mutta joutui matkallaan vuonna 1720 pakkovärvätyksi Preussin armeijaan. Onnistui pakenemaan ja vaelsi sitten Euroopassa elättäen itsensä soitinrakennuksella. Vuonna 1721 hän haaksirikkoutui Fynin edustalla ja vannoi ryhtyvänsä papiksi, jos selviytyisi. Palattuaan samana vuonna Ruotsiin hän jatkoi opintojaan. Suoritettuaan filosofian maisterin tutkinnon ja hankittuaan pätevyyden pappisvihkimykseen hänet nimitettiin opettajaksi Karlstadin kouluun vuonna 1727 ja konsistorin kirjuriksi vuonna 1732, mutta jätti virkansa, koska ei saanut ylennystä. Lähti uudestaan matkoille Eurooppaan, ja palasi kotimaahan vuonna 1739. Tuli valituksi Ruotsin kuninkaallisen tiedeakatemian (joka oli perustettu samana vuonna) jäseneksi, ja samana vuonna hänet nimitettiin Bolstadin seurakunnan kirkkoherraksi Karlstadin hiippakunnassa. Vuonna 1749 hän suoritti teologian lisensiaatin tutkinnon Wittenbergissä – jossa hän oli harjoittanut teologisia opintoja jo aiemmalla matkallaan – ja vuonna 1750 hänestä tuli teologian tohtori Ruotsissa."@fi ;
    rdaa:P50118 "Mellerud, Ruotsi"@fi ;
    rdaa:P50119 yso:p173376 ;
    rdaa:P50120 "1753" ;
    rdaa:P50121 "1697" ;
    rdaa:P50291 "Brelin" ;
    rdaa:P50292 "Nils" ;
    rdaa:P50346 yso:p218272 ;
    rdaa:P50411 "Brelin, Nils, 1697-1753"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Nils_Brelin'>Wikipedia</a>, katsottu 16.9.2026 (Nils Brelin)"@fi ;
    skos:altLabel "Brelin, Nicolaus Johannis, 1697-1753"@fi,
        "Brelin, Nils Johansson, 1697-1753"@fi,
        "Bräckselius, Nils, 1697-1753"@fi ;
    skos:hiddenLabel "Nicolaus Johannis Brelin"@fi,
        "Nils Brelin"@fi,
        "Nils Bräckselius"@fi,
        "Nils Johansson Brelin"@fi ;
