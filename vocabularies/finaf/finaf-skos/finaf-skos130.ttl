    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p3830,
        yso:p4503 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2479 ;
    rdaa:P50109 yso:p132000,
        yso:p157464,
        yso:p226794,
        "Lövånger, Ruotsi"@fi ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi. Valmistui filosofian maisteriksi Uppsalan yliopistosta vuonna 1755 ja vihittiin papiksi vuonna 1757. Palveltuaan Pehr Rådströmin apulaisena Skellefteåssa vuoteen 1761, siirtyi sieltä Luulajaan opettajaksi ja apulaispapiksi. Vuonna 1767 hänestä tuli Ylikainuun (Överkalix) seurakunnan kirkkoherra. Johdettuaan papiston synodia Piitimessä vuonna 1787 hän sai kunniarovastin arvonimen. Vuonna 1789 Länsipohjan kolmannen rovastikunnan rovastiksi, nimitettiin samana vuonna Lövångerin kirkkoherraksi, mutta aloitti tässä tehtävässä vasta vuonna 1791. Hänen kuolinpäivästään ei ole täyttä varmuutta, leski on saattanut lykätä ilmoitusta vappuun asti saadakseen vielä vuoden verran eläkettä."@fi ;
    rdaa:P50118 "Lövånger, Ruotsi"@fi ;
    rdaa:P50119 "Sveg, Ruotsi"@fi ;
    rdaa:P50120 "1797~" ;
    rdaa:P50121 "1728" ;
    rdaa:P50291 "Hamrén" ;
    rdaa:P50292 "Olof" ;
    rdaa:P50346 yso:p106813,
        yso:p165699 ;
    rdaa:P50411 "Hamrén, Olof, 1728-1797"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Olof_Hamr%C3%A9n'>Wikipedia</a>, katsottu 7.9.2026 (Olof Hamrén)"@fi ;
