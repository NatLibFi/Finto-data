finaf:000237989 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-09-30"^^xsd:date ;
    dct:modified "2026-09-30T11:29:06+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000052666593>,
        <http://viaf.org/viaf/22129298>,
        "Asteri ID: 000237989" ;
    rdaa:P50097 yso:p105244,
        yso:p94259,
        yso:p94383 ;
    rdaa:P50100 yso:p3884,
        yso:p3941 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Palmstruck, Georg Reinhold, 1686-1757"@fi ;
    rdaa:P50104 mts:m5089 ;
    rdaa:P50113 "Ruotsalainen upseeri. Liittyi vapaaehtoisena Pohjanmaan rykmenttiin vuonna 1701, toimi siellä aseupseerina vuonna 1702 ja vapautui palveluksesta vuonna 1703. Samana vuonna hänestä tuli lipunkantaja von Mengdenin lättiläisessä maakuntamiliisirykmentissä. Jätti tehtävän vuonna 1705 ja siirtyi samana vuonna vääpeliksi Hälsingen rykmenttiin. Osallistui Riian saartoon vuonna 1701, Väinäjoen ylitykseen ja sitä seuranneeseen taisteluun sekä Gemauerthofin taisteluun. Vuonna 1706 sai ylennyksen Hälsingen rykmentin vänrikiksi ja vuonna 1708 luutnantiksi. Osallistui myös Lesnajan taisteluun, jossa hän kantoi rykmentin lippua; saatuaan osuman rintaansa hän joutui kuitenkin luovuttamaan lipun toiselle henkilölle. Yritti myöhemmin tavoittaa kuninkaan armeijan mutta epäonnistui. Sen sijaan hän onnistui palaamaan Mitaun kaupunkiin, jossa hänen vammansa hoidettiin. Vuonna 1709 hänestä tuli rykmentin majoittajamestari ja myöhemmin samana vuonna kapteeni Hälsingen rykmentissä. Vuonna 1712 hänet ylennettiin majuriksi. Palmstruch osallistui myös Gadebuschin taisteluun ja Tönningenin antautumiseen vuonna 1713, jäi tanskalaisten vangiksi mutta hän onnistui pakenemaan ja palasi Ruotsiin joulukuussa 1714. Osallistui Norjan-sotaretkeen vuonna 1718 ja sai samana vuonna Jämtlandissa toimivan armeijan adjutanttikenraalin tehtävän. Syyskuussa 1718 hän johti Långstenin solan puolustusta. Hän erosi armeijasta vuonna 1719, sai vuonna 1720 eroamisensa yhteydessä kenraaliadjutantin arvon ja vuonna 1722 everstin kunnia-arvon. Vuonna 1734 siirtyi Puolan kuninkaan palvelukseen musketöörien everstinä. Vuonna 1736 hänestä tuli Hämeen läänin jalkaväkirykmentin everstiluutnantti, ja vuosina 1743–1757 hän toimi Västerbottenin rykmentin everstinä ja komentajana. Palmstruch ylennettiin jalkaväen kenraalimajuriksi vuonna 1751."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p105392 ;
    rdaa:P50120 "1757" ;
    rdaa:P50121 "1686" ;
    rdaa:P50291 "Palmstruch" ;
    rdaa:P50292 "Georg Reinhold" ;
    rdaa:P50411 "Palmstruch, Georg Reinhold, 1686-1757"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Georg_Reinhold_Palmstruch_(1686%E2%80%931757)'>Wikipedia</a>, katsottu 30.9.2026 (Georg Reinhold Palmstruch (1686–1757))"@fi ;
