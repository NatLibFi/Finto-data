finaf:000238089 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-10-07"^^xsd:date ;
    dct:modified "2026-10-07T13:27:00+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000099934401>,
        <http://viaf.org/viaf/96169521>,
        "Asteri ID: 000238089" ;
    rdaa:P50097 yso:p105190,
        yso:p105839,
        yso:p107128,
        yso:p94383 ;
    rdaa:P50100 yso:p469,
        yso:p9890 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/eng> ;
    rdaa:P50104 mts:m2441 ;
    rdaa:P50109 yso:p104995,
        yso:p212781 ;
    rdaa:P50113 "Skottilainen seikkailija. Opiskeli lääketiedettä Aberdeenin yliopistossa ja ehkä myös Leidenissä. Ei kuitenkaan valmistunut lääkäriksi, vaan ryhtyi 1730-luvulla painamaan kirjoja Lontoossa. Joutui pariksi vuodeksi velkavankeuteen, jonka jälkeen hän perehtyi lääketieteeseen ja maatalouteen. Chandosin herttua palkkasi hänet johtamaan Cannonsin uudistamista, mutta hän joutui jättämään tehtävän vuonna 1741. Seuraavana vuonna hän muutti Ruotsiin, jossa hän onnistui parantamaan kuninkaan ja sai jopa nimityksen tämän henkilääkäriksi, mutta herätti pian epäilyksiä puoskaroinnista ja palasi käytännön maanviljelyn pariin. Vuonna 1745 hän julkaisi teoksen \"An Essay on the Improvement of Swedish Agriculture\", jonka epäiltiin olevan käännös englanninkielisestä tekstistä, ja sai johdettavakseen mallitilan Allestadissa. Tämäkään hanke ei menestynyt. Ruotsin sekava poliittinen tilanne myssypuolueen ollessa Britannian vaikutusvallassa antoi hänelle uuden tilaisuuden yrittää takaisin kuninkaan suosioon. Maaliskuussa 1747 hän välitti kuninkaalle suullisen viestin, jonka väitti olevan Tanskan kuningattarelta Louiselta (Iso-Britannian kuninkaan Yrjö II:n tytär). Viestissä vihjattiin, että tarjolla olisi suuri rahasumma, jos Ruotsin kruununperimystä muutettaisiin niin, että sylilapsi-ikäinen kruununperillinen sivuutettaisiin. Kuningas ohjasi Blackwellin aluksi kahden luottomiehensä puheille, mutta säikähti seuraavana päivänä ja kertoi asiasta ministereilleen, jotka pidättivät tämän välittömästi. Blackwell kertoi hävittäneensä anonyymin kirjeen, eikä hänestä saatu kidutuksellakaan irti enempää tietoja, vain tunnustus, jonka hän myöhemmin perui. Hänet tuomittiin kuitenkin ilman julkista oikeudenkäyntiä kuolemaan."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p212781 ;
    rdaa:P50120 "1747" ;
    rdaa:P50121 "1700~" ;
    rdaa:P50291 "Blackwell" ;
    rdaa:P50292 "Alexander" ;
    rdaa:P50346 yso:p178125 ;
    rdaa:P50411 "Blackwell, Alexander, noin 1700-1747"@fi ;
    rdau:P61101 "<a href='https://en.wikipedia.org/wiki/Alexander_Blackwell'>Wikipedia</a>, katsottu 7.10.2026 (Alexander Blackwell)"@fi,
        "<a href='https://en.wikisource.org/wiki/Dictionary_of_National_Biography,_1885-1900/Blackwell,_Alexander'>Dictionary of National Biography, 1885-1900</a>, katsottu 7.10.2026 (Blackwell, Alexander)"@fi ;
    skos:hiddenLabel "Alexander Blackwell"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Blackwell, Alexander, noin 1700-1747"@fi .

