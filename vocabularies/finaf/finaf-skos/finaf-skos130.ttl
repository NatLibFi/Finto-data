    rdaa:P50103 "Lagerstroem, Magnus, 1691-1759"@fi,
        "Lagerström, Carl Magnus de, 1691-1759"@fi,
        "Lagerström, Magnus, Junior, 1691-1759"@fi,
        "M. L., 1691-1759"@fi ;
    rdaa:P50104 mts:m2522,
        mts:m3004,
        mts:m4162 ;
    rdaa:P50109 yso:p105464,
        yso:p192081,
        "Stralsund, Saksa"@fi ;
    rdaa:P50110 mts:m3701 ;
    rdaa:P50113 "Ruotsalainen kauppamies ja bibliofiili. Saksalaisissa yliopistoissa opiskeltuaan sain nimityksen kenraalikuvernöörin sihteeriksi kotikaupungissaan Stettinissä (Szczecin) vuonna 1712, mutta jo vuonna 1713 kaupungin vaihtaessa omistajaa siirtyi muun hallinnon mukana Stralsundiin. Stralsundin antauduttua ja perheen menetettyä omaisuutensa vuonna 1715 hän jäi vielä kaupunkiin, mutta muutti sitten Tukholmaan, jossa hänelle vuonna 1721 myönnettiin ero virasta, hovineuvoksen arvonimen ja vähäisen eläkkeen. Eläke oli niin pieni, että hänen oli täydennettävä tulojaan kauppakollegion johtajan yksityissihteerinä sekä kirjoittamalla ja kääntämällä. Tulotaso koheni huomattavasti, kun hänet kielitaitonsa ansiosta nimitettiinsihteeriksi vuonna 1731 Göteborgiin perustettuun Itä-Intian kauppakomppaniaan. Hän kokosi tehtävänsä aikana suuren omaisuuden, osti useita kartanoita, joiden puistoja ja viljelyksiä kehitti. Aikoi vetäytyä maaseudulle vuonna 1746, mutta nimitettiinkin kauppakomppania johtajaksi. Vuonna 1747 hän sai kauppaneuvoksen arvon ja vuonna 1748 hänestä tuli sekä Uppsalan kuninkaallisen tiedeseuran että Ruotsin kuninkaallisen tiedeakatemian jäsen."@fi ;
    rdaa:P50118 yso:p105256 ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1759" ;
    rdaa:P50121 "1691" ;
    rdaa:P50291 "Lagerström" ;
    rdaa:P50292 "Magnus" ;
