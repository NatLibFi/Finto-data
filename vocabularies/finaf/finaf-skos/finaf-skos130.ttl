    rdaa:P50104 mts:m2452,
        mts:m2773 ;
    rdaa:P50109 yso:p105464 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50113 "Suomenruotsalainen virkamies. Ruotsin kansliapresidentin sihteeri vuodesta 1738. Toimi voimakkaasti aikansa puolue-elämässä myssypuolueen hyväksi. Pidätettiin helmikuussa 1741 epäiltynä valtiopäivien salaisen valiokunnan tietojen luovuttamisesta Venäjälle. Tutkinnassa todettiin hänen saaneen rahaa Venäjän Tukholman-lähetystöstä. Tuomittiin kuolemaan, mutta tuomio lievennettiin elinkautiseksi vankeudeksi, joka muutettiin maastakarkotukseksi vuonna 1743. Matkusteli tämän jälkeen laajalti ja asettui Venäjän palvelukseen Liivinmaalle, mistä keisarinna Elisabet antoi hänelle kartanon."@fi ;
    rdaa:P50118 "Se̅rmu̅kši, Latvia"@fi ;
    rdaa:P50120 "1764" ;
    rdaa:P50121 "1709" ;
    rdaa:P50291 "Gyllenstierna" ;
