finaf:000237900 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-09-24"^^xsd:date ;
    dct:modified "2026-09-24T12:41:32+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000051875166>,
        <http://viaf.org/viaf/66450504>,
        "Asteri ID: 000237900" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p13300,
        yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2806,
        mts:m2816 ;
    rdaa:P50109 yso:p105464,
        yso:p112241 ;
    rdaa:P50113 "Ruotsalainen aatelinen poliitikko ja amiraali. Osallistui säätyvaltiopäiville vuosina 1731-1747 ja toimi salaisessa valiokunnassa vuosina 1734 sekä 1746–1747. Aloitti sotilasuransa amiraliteetin palveluksessa vuonna 1701, eteni vuonna 1704 tykkimiehen apulaiseksi. Vuonna 1706 hän sai luvan opintomatkalle muihin Euroopan laivastoihin. Vuonna 1708 hänet ylennettiin tykkimieheksi ja vuonna 1710 aliluutnantiksi. Ylennettiin ylimääräiseksi yliluutnantiksi vuonna 1715, luutnantiksi vuonna 1716 ja laivakapteeniksi vuonna 1717. Saman vuoden syksyllä hänet määrättiin Öölannin merijalkaväkirykmenttiin. Vuosina 1717–1720 hän toimi kaapparilaivan päällikkönä. Vuonna 1720 hän osallistui Ledsundin taisteluun, jossa hän jäi sotavangiksi. Palasi vankeudesta vuonna 1721, minkä jälkeen hänet lähetettiin vuosiksi 1722–1726 Välimerelle tutustumaan kaleerien käyttöön merisodankäynnissä. Vuonna 1729 hänet ylennettiin amiraliteettikapteeniksi, ja vuonna 1735 hänestä tuli Karlskronan telakkamajuri. Sai nimityksen varustelu- ja takilointimestariksi vuonna 1741 ja vara-amiraaliksi vuonna 1743; jälkimmäisessä tehtävässä hän komensi Ruotsin laivastojoukkoja Korpoströmin taistelussa. Hän komensi Karlskronan kunniaeskaderia kruununprinsessa Lovisa Ulrikan saapuessa Ruotsiin vuonna 1744. Vuonna 1746 hänet nimitettiin Karlskronan komendantiksi, ja vuonna 1749 hänestä tuli amiraali sekä amiraliteettineuvoston jäsen."@fi ;
    rdaa:P50118 yso:p112241 ;
    rdaa:P50120 "1752" ;
    rdaa:P50121 "1686" ;
    rdaa:P50291 "Falkengréen" ;
    rdaa:P50292 "Abraham" ;
    rdaa:P50411 "Falkengréen, Abraham, 1686-1752"@fi ;
