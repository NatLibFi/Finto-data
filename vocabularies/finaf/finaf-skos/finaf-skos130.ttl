        <http://viaf.org/viaf/39363998>,
        "Asteri ID: 000237958" ;
    rdaa:P50097 yso:p104968,
        yso:p105087,
        yso:p105244,
        yso:p94383 ;
    rdaa:P50100 yso:p3884 ;
    rdaa:P50103 "De Laval, Carl Magnus, 1680-1750"@fi,
        "De la Wall, Carl Magnus, 1680-1750"@fi,
        "Wall, Carl Magnus de la, 1680-1750"@fi ;
    rdaa:P50104 mts:m2359 ;
    rdaa:P50109 yso:p108131 ;
    rdaa:P50113 "Ruotsalainen upseeri. Rakuuna eversti Karassowin rykmentissä Bremenissä vuonna 1699, muskettisotilas Kronobergin rykmentissä vuonna 1700 ja majoittajakersantti samassa rykmentissä vuonna 1701. Henkivartiokaartin kersantti vuonna 1702 ja vänrikki samassa joukko-osastossa vuonna 1704, kapteeni Gustaf Adam Tauben rakuunarykmentissä vuonna 1706 sekä majuri Puolan kuninkaan Stanisławin palveluksessa vuonna 1711. Vuonna 1713 de Lavalista tuli everstiluutnantti kuningas Stanisławin palveluksessa sekä Västgötan ratsurykmentissä, vaikka hän ottikin tehtävän vastaan ​​kyseisessä rykmentissä vasta tammikuussa 1717. Hän osallistui Thornin piiritykseen, Veprykin valtaukseen ja Pultavan taisteluun; jälkimmäisessä jäi sotavangiksi, mutta onnistui pakenemaan kahden vuoden vankeuden jälkeen. Hänet lähetettiin kolmesti Benderiin viemään viestejä Kaarle XII:lle. Myöhemmin hän siirtyi Puolan ja Ranskan palvelukseen ja yleni everstiksi vuonna 1726; hän komensi Upplannin rykmenttiä vuosina 1741–1748 ja Skaraborgin rykmenttiä vuosina 1748-1749. Vuonna 1748 hänet nimitettiin Miekkaritarikunnan ritariksi."@fi ;
    rdaa:P50118 "Biskopskulla, Ruotsi"@fi ;
    rdaa:P50119 "Eggby, Ruotsi"@fi ;
    rdaa:P50120 "1750" ;
    rdaa:P50121 "1680" ;
    rdaa:P50291 "Laval" ;
    rdaa:P50292 "Carl Magnus de" ;
    rdaa:P50411 "Laval, Carl Magnus de, 1680-1750"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Carl_de_Laval'>Wikipedia</a>, katsottu 29.9.2026 (Carl de Laval)"@fi ;
    skos:altLabel "De Laval, Carl Magnus, 1680-1750"@fi,
        "De la Wall, Carl Magnus, 1680-1750"@fi,
        "Wall, Carl Magnus de la, 1680-1750"@fi ;
    skos:hiddenLabel "Carl Magnus De Laval"@fi,
        "Carl Magnus De la Wall"@fi,
        "Carl Magnus de Laval"@fi,
        "Carl Magnus de la Wall"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Laval, Carl Magnus de, 1680-1750"@fi .

finaf:000237959 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-09-29"^^xsd:date ;
    dct:modified "2026-09-29T13:27:03+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000051809038>,
        <http://viaf.org/viaf/59069527>,
        "Asteri ID: 000237959" ;
    rdaa:P50097 yso:p104987,
        yso:p94383 ;
    rdaa:P50100 yso:p3884,
        yso:p7510 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Wrangel af Sauss, Otto Reinhold, 1681-1744"@fi,
        "Wrangel, Otto, 1681-1744"@fi,
        "Wrangell, Otto Reinhold, 1681-1744"@fi ;
    rdaa:P50104 mts:m3996,
        mts:m5089 ;
    rdaa:P50113 "Ruotsalainen upseeri. Aloitti sotilasuransa Riian kuvernöörin rykmentissä ja eteni suuren Pohjan sodan aikana. Osallistui muun muassa Riian piiritykseen vuonna 1700. Vuonna 1711 hän sai luutnantin arvon. Myöhemmin hän palveli sodassa eri rykmenteissä ja kuului niihin, jotka seurasivat Kaarle XII:ta Benderiin Pultavan taistelun jälkeen. Benderissä kuningas ylensi hänet kapteeniksi Svean henkikaartiin vuonna 1711 ja antoi hänelle tehtäväksi koota ja lunastaa vapaaksi ruotsalaisia ​​sotavankeja Krimillä ja Asovan alueella. Hän sai majurin arvon vuoden 1718 alussa. Osallistui Kaarle XII:n toiseen Norjan-sotaretkeen. Sodan jälkeen vuonna 1723 hänet aateloitiin Ruotsissa. Hänet ylennettiin henkivartiokaartin komentajaksi vuonna 1739. Hattujen sodan epäonnistumisen myötä hänet määrättiin arestiin vuonna 1743, mutta ei asetettu syytteeseen. Arestia kesti vain viisi kuukautta. Peri ensimmäiseltä apeltaan Anders Lagercronalta kolmanneksen Laxån rautaruukista vuonna 1739 ja otti sen johtamisesta päävastuun."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p506150 ;
    rdaa:P50120 "1744" ;
    rdaa:P50121 "1681" ;
    rdaa:P50291 "Wrangel" ;
    rdaa:P50292 "Otto Reinhold" ;
    rdaa:P50411 "Wrangel, Otto Reinhold, 1681-1744"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Otto_Reinhold_Wrangel'>Wikipedia</a>, katsottu 29.9.2026 (Otto Reinhold Wrangel)"@fi ;
    skos:altLabel "Wrangel af Sauss, Otto Reinhold, 1681-1744"@fi,
        "Wrangel, Otto, 1681-1744"@fi,
        "Wrangell, Otto Reinhold, 1681-1744"@fi ;
    skos:hiddenLabel "Otto Reinhold Wrangel"@fi,
