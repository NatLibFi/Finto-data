        yso:p3941 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Leyonhufwud, Carl Leonhard, 1686-1743"@fi ;
    rdaa:P50104 mts:m2726 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50113 "Ruotsalainen aatelinen, sotilas ja hovimies. Kirjoittautui Uppsalan yliopistoon marraskuussa 1702. Palveli muskettisotilaana Ruotsin palkatussa henkijalkaväkirykmentissä vuonna 1704. Toimi kersanttina vuonna 1707. Sai vänrikin viran Erik Sparren saksalaisessa palkkarykmentissä (Ranskan palveluksessa) vuonna 1707. Ylennettiin luutnantiksi Erik Sparren saksalaisessa palkkarykmentissä vuonna 1708. Nimitettiin kapteeniksi Taalainmaan rykmenttiin 21. lokakuuta 1709. Ylennettiin majuriksi Taalainmaan rykmentissä 29. syyskuuta 1712. Sai vahvistetun virkakirjan 16. huhtikuuta 1716. Ylennettiin everstiluutnantiksi 13. kesäkuuta 1716. Jäi pois palveluksesta 22. helmikuuta 1733."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1743" ;
    rdaa:P50121 "1686" ;
    rdaa:P50291 "Leijonhufvud" ;
    rdaa:P50292 "Carl Leonhard" ;
    rdaa:P50346 yso:p106813 ;
    rdaa:P50411 "Leijonhufvud, Carl Leonhard, 1686-1743"@fi ;
    rdau:P61101 "<a href='https://www.adelsvapen.com/genealogi/Leijonhufvud_nr_26#TAB_23'>Adelsvapen-Wiki</a>, katsottu 21.8.2026 (Carl Leonard, son av Axel Gabriel)"@fi,
