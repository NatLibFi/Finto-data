finaf:000237991 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-09-30"^^xsd:date ;
    dct:modified "2026-09-30T11:58:53+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/000000005473836X>,
        <http://viaf.org/viaf/2456392>,
        "Asteri ID: 000237991" ;
    rdaa:P50097 yso:p104987,
        yso:p94383 ;
    rdaa:P50100 yso:p3884 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Von der Pahlen, Otto Christian, 1680-1756"@fi ;
    rdaa:P50104 mts:m5089 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50113 "Ruotsalainen aatelinen upseeri. Aloitti kadettina leskikuningattaren henkivartioratsurykmentissä. Vuonna 1699 hänestä tuli aliupseeri everstiluutnantti Stahlenin pataljoonassa, vuonna 1700 majoittaja Uudenmaan rakuunarykmentissä jasaman vuoden lokakuussa luutnantti Turun läänin tremänning-ratsuväkirykmentissä (nimitys vahvistettiin 26. marraskuuta 1700). Hänestä tuli vuonna 1702 nuorempi ratsumestari Smålandin ratsuväkirykmentissä, vuonna 1705 vanhempi ratsumestari samassa rykmentissä ja majuri vuonna 1708. Jäi venäläisten vangiksi Krasnokutsk–Gorodnojen taistelussa vuonna 1709. Sai everstin arvonimen vuonna 1722. Ylennettiin everstiluutnantiksi vuonna 1728 Itä-Götanmaan ratsuväkirykmentissä. Vuonna 1739 Länsi-Götanmaan rykmentin eversti. Jäi eläkkeelle vuonna 1747, sai kenraalimajurin arvonimen samana vuonna. Nimitettiin Miekkaritarikunnan ritariksi vuonna 1748."@fi ;
    rdaa:P50118 "Åsbo, Ruotsi"@fi ;
    rdaa:P50119 yso:p107804 ;
    rdaa:P50120 "1756" ;
    rdaa:P50121 "1680" ;
