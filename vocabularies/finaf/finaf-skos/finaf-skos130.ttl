finaf:000238006 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-10-01"^^xsd:date ;
    dct:modified "2026-10-01T13:10:33+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000108631622>,
        <http://viaf.org/viaf/2589083>,
        "Asteri ID: 000238006" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p4655,
        yso:p469 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Berg, Peter Jonas, 1730-1790"@fi,
        "Bergius, Pehr Jonas, 1730-1790"@fi,
        "Bergius, Petr. Jon., 1730-1790"@fi,
        "Bergius, Petrus Jonas, 1730-1790"@fi,
        "Bergius, Petter Jonas, 1730-1790"@fi ;
    rdaa:P50104 mts:m2487 ;
    rdaa:P50109 yso:p105464 ;
    rdaa:P50113 "Ruotsalainen lääkäri ja botanisti. Toimi Tukholmassa luonnonhistorian ja farmasian professorina vuodesta 1761 ja harjoitti samalla lääkärintointaan. Aloitti opintonsa 16-vuotiaana Lundin yliopistossa, väitteli lääketieteen tohtoriksi Uppsalassa vuonna 1754. Oli perehtynyt kasvitieteeseen,testamenttasi kirjastons, arvokkaan kasvinäytekokoelmansa, 100000 kuparitaaleria sekä maaseututilansa Karlbergsallénin läheisyydessä Ruotsin kuninkaalliselle tiedeakatemialle sillä ehdolla, että tilalle perustetaan puutarha-alan oppilaitos. Ehto toteutettiin, mutta vuonna 1884 akatemia myi kiinteistön Tukholman nopean kasvun vuoksi. Uusi \"Bergielund\" perustettiin sittemmin Brunnsvikenin lähellä sijaitsevalle Frescatin tilalle, jonka akatemia oli hankkinut omistukseensa."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 "Vittaryd, Ruotsi"@fi ;
    rdaa:P50120 "1790" ;
    rdaa:P50121 "1730" ;
    rdaa:P50291 "Bergius" ;
    rdaa:P50292 "Peter Jonas" ;
    rdaa:P50411 "Bergius, Peter Jonas, 1730-1790"@fi ;
    rdau:P61101 "<a href='.'>Wikipedia</a>, katsottu 30.9.2026 ()"@fi ;
