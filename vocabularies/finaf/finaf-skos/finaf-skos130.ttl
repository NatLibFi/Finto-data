finaf:000237485 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-08-25"^^xsd:date ;
    dct:modified "2026-08-25T14:36:37+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000053850675>,
        <http://viaf.org/viaf/46745415>,
        "Asteri ID: 000237485" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p3884,
        yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2545,
        mts:m2773,
        mts:m2816,
        mts:m5089 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50113 "Ruotsalainen aatelinen. Aloitti sotilasuransa vuonna 1699, yleni kapteeniksi vuonna 1704 ja palveli Baltian maakunnissa sekä Suomessa vuoteen 1707 saakka. Vuonna 1710 Fuchs nimitettiin majuriksi Taalainmaan rykmenttiin ja vuonna 1712 everstiluutnantiksi. Samana vuonna hän lähti Magnus Stenbockin mukana Saksaan. Gadebuschin taistelussa hän komensi koko Taalainmaan rykmenttiä. Vuonna 1716 osallistui Kaarle XII:n Norjan-sotaretkeen. Samana vuonna hänet aateloitiin ja ylennettiin everstiksi – ensin Taalainmaan rykmentin ja myöhemmin Södermanlandin rykmentin komentajaksi (tehtävässä vuoteen 1739 saakka). Hän osallistui myös toiseen Norjan-sotaretkeen vuonna 1718. Palattuaan hän johti rykmenttinsä – jossa oli vain 700–800 miestä – ratkaisevaan rooliin Södra Stäketin taistelussa elokuussa 1719. Tämän teon ansiosta hänetkorotettiin vapaaherraksi ja nimitettiin kenraalimajuriksi vielä saman vuoden aikana. Myöhemmin hän oli aktiivinen politiikassa. Tuettuaan aluksi Arvid Hornia hän liittyi vuosien 1738-1739 valtiopäivillä hattupuolueeseen. Nimitettiin sekä salaiseen valiokuntaan että 12 hengen komiteaan. Tämä komitea laati puolustussuunnitelman ja ns. \"salaisen liitteen\", joka valtuutti hallituksen julistamaan sodan Venäjää vastaan. Vuonna 1739 hänet nimitettiin Tukholman kenraalikuvernööriksi. Hän ajautui kuitenkin pian välirikkoon hattujen kanssa. Vuonna 1740 hän vastusti voimakkaasti puolueen sotapolitiikkaa, ja sitä seuranneissa puoluekiistoissa hän kuului myssypuolueen johtohahmoihin."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p109589 ;
    rdaa:P50120 "1753" ;
    rdaa:P50121 "1682" ;
    rdaa:P50291 "Fuchs" ;
    rdaa:P50292 "Rutger" ;
    rdaa:P50411 "Fuchs, Rutger, 1682-1753"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Rutger_Fuchs'>Wikipedia</a>, katsottu 25.8.2026 (Rutger Fuchs)"@fi ;
    skos:hiddenLabel "Rutger Fuchs"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Fuchs, Rutger, 1682-1753"@fi .

