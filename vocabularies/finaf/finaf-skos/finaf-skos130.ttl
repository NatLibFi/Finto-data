finaf:000238139 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-10-09"^^xsd:date ;
    dct:modified "2026-10-09T11:08:26+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://viaf.org/viaf/86430046>,
        "Asteri ID: 000238139" ;
    rdaa:P50097 yso:p107128,
        yso:p94383 ;
    rdaa:P50100 yso:p4029,
        yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Speran, 1704-1788"@fi,
        "Springer, Kristofer, 1704-1788"@fi ;
    rdaa:P50104 mts:m2406,
        mts:m2773 ;
    rdaa:P50109 yso:p104995,
        yso:p105464,
        yso:p108296 ;
    rdaa:P50113 "Ruotsalainen kauppias ja poliitikko. Matkusteli nuoruudessaan ulkomailla ja asettui sitten synnyinkaupunkiinsa harjoittamaan kauppaa. Lähti pian mukaan politiikkaan – aluksi hattupuolueen riveissä, mutta vuoden 1742 valtiopäivistä lähtien myssypuolueen edustajana. Ajoi vuonna 1743 ns. prinsipalaattikysymystä. Vuosina 1746-1747 Springer pyrki edistämään myssyjen menestystä ja piti samalla salaista yhteyttä Venäjän lähettilääseen J.A. von Korffiin. Hattujen voitettua säätyvaltiopäivät Springer pidätettiin ja asetettiin syytteeseen. Säätyjen muodostama komissio tuomitsi hänet marraskuussa 1747 elinkautiseen vankeuteen. Hän oli ennen tuomion julistamista paennut Iso-Britannian lähetystöön, mutta lähettiläs joutui luovuttamaan hänet Ruotsin viranomaisille, jotka määräsivät rangaistuspaikaksi Marstrandin linnoituksen. Vuonna 1752 hän onnistui pakenemaan Venäjälle, missä hän toimi Arkangelin kauppakollegion jäsenenä salanimellä Sperat. Vuonna 1754 hän pakeni jälleen ja päätyi lopulta Lontooseen monien vaiheiden jälkeen. Siellä hän sai mainetta ruotsalaisen seurakunnan tukijana. Vielä 1760-luvulla hän hoiti yhteydenpitoa myssypuolueen ja Englannin hallituksen välillä."@fi ;
    rdaa:P50118 yso:p104995 ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1788" ;
    rdaa:P50121 "1704" ;
    rdaa:P50291 "Springer" ;
    rdaa:P50292 "Christopher" ;
    rdaa:P50411 "Springer, Christopher, 1704-1788"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Christopher_Springer'>Wikipedia</a>, katsottu 9.10.2026 (Christopher Springer)"@fi ;
    skos:altLabel "Speran, 1704-1788"@fi,
        "Springer, Kristofer, 1704-1788"@fi ;
    skos:hiddenLabel "Christopher Springer"@fi,
        "Kristofer Springer"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Springer, Christopher, 1704-1788"@fi .

