    rdaa:P50097 yso:p104968 ;
    rdaa:P50100 yso:p17889,
        yso:p2849,
        yso:p3582 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/fra> ;
    rdaa:P50103 "M***, 1675-1738"@fi,
        "M., Monsieur, 1675-1738"@fi,
        "Melon de Pradou, Jean-François, 1675-1738"@fi,
        "Melon, Jean-François de, 1675-1738"@fi ;
    rdaa:P50104 mts:m2612,
        mts:m2780,
        mts:m3004 ;
    rdaa:P50109 yso:p108438 ;
    rdaa:P50113 "Ranskalainen ekonomisti, fysiokratismin edelläkävijä. Toimi uransa alussa asianajajana Bordeaux'ssa. Oppineitten ja kirjailijoiden seura sai hänet omistautumaan kirjallisuudelle ja talouskysymyksille. Vuonna 1715 perusti pienen akatemian, jonka suojelijana toimi hänen tuttavansa herttua de La Force, ja hän itse toimi akatemian pysyvänä sihteerinä. Pari vuotta myöhemmin herttua – joka kuului Ludvig XIV:n kuoleman jälkeen perustettuun valtiovarainneuvostoon – yritti taivutella hänet muuttamaan Pariisiin. Kun kyseinen neuvosto lakkautettiin, Melon siirtyi työskentelemään valtiovarainministeri d’Argensonin alaisuudessa; ministeri nimitti hänet myöhemmin Bordeaux’n veronkantoalueen tarkastajaksi. Melon jätti kuitenkin tämän tehtävän siirtyäkseen Pariisiin ulkoministeri Abbé Dubois’n palvelukseen. Myöhemmin hän erosi tästäkin tehtävästä ryhtyäkseen John Law’n sihteeriksi ja pysyi tässä toimessa aina Law’n talousjärjestelmän romahdukseen saakka vuonna 1720. Sitten hän siirtyi sijaishallitsijan (Philippe d'Orléans) sihteeriksi ja pysyi tehtävässä hallitsijan kuolemaan asti."@fi ;
    rdaa:P50118 yso:p104996 ;
    rdaa:P50119 "Tulle, Ranska"@fi ;
    rdaa:P50120 "1738" ;
    rdaa:P50121 "1675" ;
    rdaa:P50291 "Melon" ;
    rdaa:P50292 "Jean-François" ;
    rdaa:P50411 "Melon, Jean-François, 1675-1738"@fi ;
    rdau:P61101 "<a href='https://fr.wikipedia.org/wiki/Jean-Fran%C3%A7ois_Melon'>Wikipedia</a>, katsottu 18.9.2026 (Jean-François Melon)"@fi ;
    skos:altLabel "M***, 1675-1738"@fi,
        "M., Monsieur, 1675-1738"@fi,
