    rdaa:P50094 <http://isni.org/isni/0000000531608059>,
        "Asteri ID: 000237760" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p18241,
        yso:p2059 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Preus, Joachim, 1667-1741"@fi ;
    rdaa:P50104 mts:m3996 ;
    rdaa:P50109 yso:p239385 ;
    rdaa:P50113 "Ruotsalainen teollisuusmies ja asetehtailija. Alunperin sukunimeltään Preus, kunnes samanniminen isä Hans (1636-1711) aateloitiin vuonna 1695. Uppsalassa vuodesta 1676 opiskeltuaan pääsi vuonna 1691 Norrtäljen muskettitehtaan johtoon, ja vuonna 1695 Jönköpingiin saman tuotantoalan tehtaaseen. Asetuotantoa oli jo vuodesta 1689 alkaen alettu siirtää Husqvarnaan, mutta hän viimeisteli alueen rakennuttamalla asuntoja työntekijöille ja tehtaanjohtajalle. Vuonna 1715 hänet nimitettiin Ruotsin kaikkien asetehtaiden johtajaksi. Kaarle XII:n sodista aiheutuneen inflaation ja vielä kuninkaan kuoltuakin sitoneiden sopimusten tähden joutui toimittamaan tavaraa merkittävällä tappiolla. Vuonna 1731 onnistui neuvottelemaan paremman hinnan uudelle muskettimallille. Ehrenpreus kuitenkin sairastui, ja vuonna 1732 hän siirsi tehtaan sekä kaiken omaisuutensa vävylleen Jöns Wetterbergille, joka kuitenkin kuoli jo vuonna 1735 jättäen jälkeensä suuret velat. Ehrenpreus anoi velkojensa anteeksiantoa kruunulta varattomuuteensa vedoten, mutta ajautui pian henkilökohtaiseen konkurssiin. Velat ja Husqvarnan työntekijöiden saatavat siirrettiin sopimuksen nojalla hänen pojalleen Nils Ehrenpreusille, mutta Nilskin kuoli ennen isäänsä vuonna 1738. Husqvarnan muskettitehdas siirrettiin tällöin hänen nuorimmalle pojalleen Fredrik Ehrenpreusille."@fi ;
    rdaa:P50118 "Vara, Ruotsi"@fi ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1741" ;
    rdaa:P50121 "1667" ;
    rdaa:P50291 "Ehrenpreus" ;
    rdaa:P50292 "Joachim" ;
    rdaa:P50346 yso:p106813 ;
    rdaa:P50411 "Ehrenpreus, Joachim, 1667-1741"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Joachim_Ehrenpreus'>Wikipedia</a>, katsottu 14.9.2026 (Joachim Ehrenpreus)"@fi ;
    skos:altLabel "Preus, Joachim, 1667-1741"@fi ;
    skos:hiddenLabel "Joachim Ehrenpreus"@fi,
        "Joachim Preus"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Ehrenpreus, Joachim, 1667-1741"@fi .

