    rdaa:P50292 "Ulric" ;
    rdaa:P50346 yso:p106813 ;
    rdaa:P50411 "Rudenschöld, Ulric, 1704-1765"@fi ;
    rdau:P61101 "<a href='https://fi.wikipedia.org/wiki/Ulrik_Rudensch%C3%B6ld'>Wikipedia</a>, katsottu 16.9.2026 (Ulrik Rudenschöld)"@fi ;
