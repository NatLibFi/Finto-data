finaf:000237781 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-09-15"^^xsd:date ;
    dct:modified "2026-09-15T12:46:49"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000016771919>,
        <http://viaf.org/viaf/51722664>,
        "Asteri ID: 000237781" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p2692,
        yso:p27139 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2343,
        mts:m2621 ;
    rdaa:P50109 yso:p105256,
        yso:p105464 ;
    rdaa:P50110 mts:m3701 ;
    rdaa:P50113 "Ruotsalainen kirjanpitäjä ja kauppaneuvos. Vuonna 1721 hän aloitti Göteborgin lääninrahaston kirjanpitäjänä, siirtyi vuonna 1730 Tukholmaan sotakollegion veteraanihuolto-osaston kirjanpitäjäksi ja toimi siellä kassanhoitajana vuosina 1735-1742. Vuonna 1739 alkoi hoitaa erityistehtäviä säätyjen manufaktuurikonttorin kirjanpidossa, ja vuosina 1740-1761 hän kuului virkamiesten leski- ja orpokassan johtajistoon. Vuosina 1742–1746 hän oli kirjanpitäjänä ja jäsenenä Tukholman manufaktuurioikeudessa, vuonna 1747 hänestä tuli manufaktuurikonttorin vakituinen kirjanpitäjä ja vielä samana vuonna sen ensimmäinen komissaari. Kun manufaktuurikonttori lakkautettiin vuonna 1766, hänet siirrettiin kauppakollegion ylimääräiseen henkilökuntaan. Hänet nimitettiin kauppaneuvokseksi manufaktuuriosastolle vuonna 1770 ja kauppa- ja manufaktuuriosastolle vuonna 1773; lisäksi hän toimi virkamiesten leski- ja orpokassan hallituksen kunniajäsenenä vuosina 1773–1782."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50120 "1786" ;
    rdaa:P50121 "1704~" ;
    rdaa:P50291 "Lissander" ;
    rdaa:P50292 "Anders" ;
    rdaa:P50411 "Lissander, Anders, 1704-1786"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Anders_Lissander'>Wikipedia</a>, katsottu 15.9.2026 (Anders Lissander)"@fi ;
