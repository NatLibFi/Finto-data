finaf:000237691 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-09-09"^^xsd:date ;
    dct:modified "2026-09-09T10:55:57"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000054832284>,
        <http://viaf.org/viaf/19661875>,
        "Asteri ID: 000237691" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p12966,
        yso:p15307,
        yso:p3830 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2479,
        mts:m3996 ;
    rdaa:P50109 "Dal, Ruotsi"@fi ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi. Opiskeli teologiaa Uppsalassa, vihittiin papiksi vuonna 1742. Apulaiskirkkoherra Ytterlännäsissä Ångermanlandissa. Kirjoitti yksityiskohtaisen kuvauksen Ångermanlandin noitavainoista 1670-luvulla. Vuonna 1750 osallistui lasitehtaan perustamiseen Sandön saarelle kotipitäjässään. Osti veljensä kanssa maata paperitehdasta varten, mutta myi osuutensa jo ennen tehtaan rakentamista."@fi ;
    rdaa:P50118 "Ytterlännäs, Ruotsi"@fi ;
