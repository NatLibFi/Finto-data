        yso:p3830,
        yso:p6227,
        yso:p798 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Törner, Johan Johannis, 1712-1790"@fi,
        "Törner, Johan Johansson, 1712-1790"@fi ;
    rdaa:P50104 mts:m2479,
        mts:m2770,
        mts:m3991 ;
    rdaa:P50109 yso:p234571,
        yso:p234959 ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi, opettaja ja kirjailija. Valmistuttuaan filosofian maisteriksi Uppsalan yliopistosta vuonna 1740 hän kävi vuosina 1741-1745 useissa Saksan yliopistoissa. Kotiin palattuaan hänet nimitettiin vuonna 1746 filosofisen tiedekunnan dosentiksi ja adjuktiksi vuonna 17511. Saman vuonna hänet nimitettiin samana vuonna Rooman kirjallisuuden ja luonnontieteen vanhemmaksi maisteriksi Linköpingin lukioon. Sai pappisvihkimyksen vuonna 1753 ja väitteli teologian tohtoriksi Greifswaldissa vuonna 1756. Skedan prebendin rehtori vuonna 1771 ja teologian 1. vanhempi maisteri vuonna 1777 (2. vanhempi maisteri jo 1771). Vapautettiin virastaan kuulon heikentymisen tähden."@fi ;
    rdaa:P50118 "Skeda, Ruotsi"@fi ;
    rdaa:P50119 yso:p234959 ;
    rdaa:P50120 "1790" ;
    rdaa:P50121 "1712" ;
    rdaa:P50291 "Törner" ;
    rdaa:P50292 "Johan" ;
    rdaa:P50346 yso:p106813 ;
    rdaa:P50411 "Törner, Johan, 1712-1790"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Johan_T%C3%B6rner_(1712%E2%80%931790)'>Wikipedia</a>, katsottu 8.9.2026 (Johan Törner)"@fi ;
    skos:altLabel "Törner, Johan Johannis, 1712-1790"@fi,
        "Törner, Johan Johansson, 1712-1790"@fi ;
    skos:hiddenLabel "Johan Johannis Törner"@fi,
        "Johan Johansson Törner"@fi,
        "Johan Törner"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Törner, Johan, 1712-1790"@fi .

