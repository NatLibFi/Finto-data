    rdaa:P50103 "Amarantus, 1716-1776"@fi,
        "Arimaspus, 1716-1776"@fi,
        "Chrysophilus, 1716-1776"@fi,
        "Patridophilus, 1716-1776"@fi,
        "Sahlstedt, Abraham Magnusson, 1716-1776"@fi,
        "Sahlstedt, Abraham, 1716-1776"@fi ;
    rdaa:P50104 mts:m2386,
        mts:m2452,
        mts:m2788,
        mts:m3004 ;
    rdaa:P50109 yso:p105464 ;
    rdaa:P50113 "Ruotsalainen kielitieteilijä, filologi ja kirjailija. Uppsalan yliopistosta valmistuttuaan aloitti vuonna 1735 työt valtionarkistossa ja kansliakollegiossa ylimääräisenä virkamiehenä ja eteni lopulta kirjaajaksi vuonna 1747. Vaikka hän hoiti ajoittain sihteerin tehtäviä, häntä ei valittu vakinaiseen virkaan; niinpä hänet nimitettiin vuonna 1756 kuninkaalliseksi sihteeriksi – tehtävään, johon kuului ylimääräisen virkamiehen palkka ja joka vapautti hänet varsinaisista työvelvoitteistaan ​​”hyödyllisten kirjoitusten” julkaisemista varten. Teki tunnetuksi ranskalaista klassista estetiikkaa ja arvioi runoteoksia, minkä vuoksi häntä on sanottu ”ruotsalaisen kirjallisuuskritiikin isäksi”. Julkaisi myös itse kaunokirjallisia teoksia. Osallistui talouspoliittiseen keskusteluun pamfleteillaan. Lisäksi toimi aktiivisesti lähes kaikilla ruotsalaisen kulttuurin aloilla ja osallistui myös virsikirjan uudistamiseen. Kirjoitteli ahkerasti päivälehdistöön, erityisesti \"Dagligt Allehanda\" -lehteen."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1776" ;
    rdaa:P50121 "1716" ;
    rdaa:P50291 "Sahlstedt" ;
    rdaa:P50292 "Abraham Magni" ;
    rdaa:P50346 yso:p106813 ;
    rdaa:P50411 "Sahlstedt, Abraham Magni, 1716-1776"@fi ;
