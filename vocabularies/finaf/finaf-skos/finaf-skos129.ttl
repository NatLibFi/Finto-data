        <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Dahl, Nils Hufvedsson, 1690-1740"@fi,
        "Dal, Nicolaus Hufvedi fil., 1690-1740"@fi,
        "N. D. H. F., 1690-1740"@fi,
        "N. H. D., 1690-1740"@fi,
        "Nicolaus Hugonis, 1690-1740"@fi ;
    rdaa:P50104 mts:m2437,
        mts:m2522,
        mts:m2962,
        mts:m2971,
        mts:m3004 ;
    rdaa:P50109 yso:p105464,
        yso:p106813 ;
    rdaa:P50113 "Ruotsalainen historijoitsija ja antikvaarinen kirjakauppias. Aloitti yliopisto-opintonsa Uppsalassa vuonna 1707. Vuonna 1710 valmistui maisteriksi puolustamalla mentorinsa Erik Benzeliuksen laatimaa latinankielistä editiota Margareta Olausdotterin pyhän Birgitan sukutaustaa käsittelevästä kronikasta. Vuonna 1711 palasi synnyinkaupunkiinsa Uppsalaa uhkaavan ruttoepidemian vuoksi ja alkoi kerätä väitöskirja-aineistoa Boråsin historiasta. Tutkimus esitettiin latinaksi vuonna 1719 ja tekijä itse ruotsinsi sen samana vuonna. Väitöskirjan valmistumista viivästytti paitsi toimiminen varakkaiden perheiden yksityisopettajana, myös alkoholin käyttö. Vuodesta 1717 alkaen hän asui Tukholmassa, missä Benzelius otti hänet mukaan erilaisiin kirjallisiin hankkeisiin. Samalla hän opetti hovipoikia ja toimi harjoittelijana muinaismuistoarkistossa vuosina 1717-1729. Vuonna 1722 hän sai apurahan, jonka turvin saattoi matkustaa Kööpenhaminaan tutkimaan islantilaisia käsikirjoituksia. Seuraavana vuonna hän teki vastaavan matkan Englantiin. Julkaisi runsaasti käännöksiä ja omia tekstejä. Hän oli todennäköisesti kirjallisen väärennöksen \"Konung Krembres i Giötaland och konung Augis i Uppsala saga\" kirjoittaja; teos julkaistiin käännöksenä islantilaisesta alkuteoksesta."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p235672 ;
    rdaa:P50120 "1740" ;
    rdaa:P50121 "1690" ;
    rdaa:P50291 "Dal" ;
    rdaa:P50292 "Nils Hufwedsson" ;
    rdaa:P50346 yso:p106954 ;
    rdaa:P50411 "Dal, Nils Hufwedsson, 1690-1740"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Nils_Hufwedsson_Dal'>Wikipedia</a>, katsottu 18.9.2026 (Nils Hufwedsson Dal)"@fi ;
    skos:altLabel "Dahl, Nils Hufvedsson, 1690-1740"@fi,
        "Dal, Nicolaus Hufvedi fil., 1690-1740"@fi,
        "N. D. H. F., 1690-1740"@fi,
