    rdaa:P50103 "Wrangel, Carl Heinrich von, 1681-1755"@fi ;
    rdaa:P50104 mts:m2816,
        mts:m3347,
        mts:m5089 ;
    rdaa:P50109 yso:p105464 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50118 "Halmstad, Ruotsi"@fi ;
    rdaa:P50119 yso:p172165 ;
    rdaa:P50120 "1755" ;
    rdaa:P50121 "1681" ;
    rdaa:P50291 "Wrangel" ;
    rdaa:P50292 "Carl Henrik" ;
    rdaa:P50346 yso:p94255,
        yso:p94280 ;
    rdaa:P50411 "Wrangel, Carl Henrik, 1681-1755"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Carl_Henrik_Wrangel'>Wikipedia</a>, katsottu 23.9.2026 (Carl Henrik Wrangel)"@fi,
        "Ruotsalainen aatelinen upseeri, baltiansaksalaista syntyperää. Aloitti sotilasuransa 15-vuotiaana ja osallistui useisiin Kaarle XII:n sotaretkiin edeten henkivartioston kapteeniksi ja myöhemmin Skoonen ratsuväkirykmenttin everstiluutnantiksi. Jäi venäläisten vangiksi Pultavan taistelussa vuonna 1709. Palattuaan hän sai Uudenmaan ratsurykmentin komentajuuden vuonna 1722, toimi Hämeen rykmentin komentajana vuodesta 1727 ja Uudenmaan rakuunarykmentin komentajana vuodesta 1729, ylennettiin kenraalimajuriksi vuonna 1732 ja nimitettiin Skaraborgin rykmentin komentajaksi vuonna 1739. Vuonna 1732 hänet nimitettiin myös Pohjanmaan läänin maaherraksi, mutta tämä virkakausi jäi lyhyeksi. Vuonna 1739 hänelle tarjottiin valtaneuvoston jäsenyyttä, mutta hän kieltäytyi tehtävästä ”pysyäkseen armeijan ja sotapalveluksen parissa”. Vuonna 1741 Venäjän ja Ruotsin välisessä sodassa hän komensi komensi toista Ruotsin armeijan kahdesta Suomessa toimineesta joukko-osastosta Henrik Magnus von Buddenbrockin yleiskomennossa. Lappeenrannassa hän ryhtyi taisteluun itseään yli kaksi kertaa suurempaa venäläistä armeijakuntaa vastaan ​​vastoin käskyä odottamatta Buddenbrockin divisioonan saapumista. Venäläiset valloittivat Lappeenrannan ja Wrangel joutui jälleen vangiksi. Tästä huolimatta tappiosta sai syyn niskoilleen yksinomaan Buddenbrock, joka mestattiin. Ilmeisesti Wrangel ei saanut syytettä, koska kuului sotaa vastustaneisiin myssyihin. Erosi armeijan palveluksesta vuonna 1748."@fi ;
    skos:altLabel "Wrangel, Carl Heinrich von, 1681-1755"@fi ;
    skos:hiddenLabel "Carl Heinrich von Wrangel"@fi,
        "Carl Henrik Wrangel"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Wrangel, Carl Henrik, 1681-1755"@fi .

