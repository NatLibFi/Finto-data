    rdaa:P50022 yso:p1585,
        yso:p1631,
        yso:p21539,
        yso:p5462 ;
    rdaa:P50023 <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/fin> ;
    rdaa:P50025 "Tampere University. Faculty of Information Technology and Communication Sciences"@fi,
        "Tampereen yliopiston informaatioteknologian ja viestinnän tiedekunta"@fi ;
    rdaa:P50035 "Informaatioteknologian ja viestinnän tiedekunta (ITC) on yksi Tampereen yliopiston seitsemästä tiedekunnasta. Tiedekunta aloitti toimintansa vuoden 2019 alusta, kun aikaisemmat Tampereen yliopisto ja Tampereen teknillinen yliopisto yhdistyivät uudeksi Tampereen yliopistoksi. Tiedekuntaan sulautuivat vanhan Tampereen yliopiston luonnontieteiden ja viestintätieteiden tiedekunnat sekä Tampereen teknillisen yliopiston tieto- ja sähkötekniikan tiedekunta."@fi ;
    rdaa:P50037 "2019" ;
    rdaa:P50237 mts:m4751 ;
    rdaa:P50350 yso:p94436 ;
    rdaa:P50407 "Tampereen yliopisto (2019-). Informaatioteknologian ja viestinnän tiedekunta"@fi ;
    rdau:P61101 "Muutoksen mekanismit: kolmen aikapisteen reaaliaikatutkimus Helsingin puhekielestä, 2021"@fi ;
    skos:altLabel "Tampere University. Faculty of Information Technology and Communication Sciences"@fi,
        "Tampereen yliopiston informaatioteknologian ja viestinnän tiedekunta"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Tampereen yliopisto (2019-). Informaatioteknologian ja viestinnän tiedekunta"@fi .

