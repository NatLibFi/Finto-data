finaf:000177594 a rdac:C10005,
        skos:Concept ;
    dct:created "1994-11-08"^^xsd:date ;
    dct:modified "2025-12-16T12:19:08"^^xsd:dateTime ;
    rdaa:P50006 <http://isni.org/isni/0000000115434985>,
        "Asteri ID: 000177594" ;
    rdaa:P50022 yso:p1882 ;
    rdaa:P50023 <http://lexvo.org/id/iso639-3/eng> ;
    rdaa:P50025 "LC Cowboys"@fi ;
    rdaa:P50035 "Yhtye esittää omia versioitaan rock-klassikoista ja venäläisistä kansanlauluista, mutta myös omia kappaleita on on julkaistu ja esitetty. Omaleimainen ilme syntyy yhtyeen pukeutumisesta hiustötteröihin, piikkikärkikenkiin ja aurinkolaseihin. Yhtye tunnetaan myös Aki Kaurismäen elokuvista Leningrad Cowboys Go America (1989) ja Leningrad Cowboys Meet Moses (1994). Suuren yleisön huomion yhtye sai senaatintorilla vuonna 1993 järjestetystä Total Balalaika Showsta, jossa yhtye esiintyi yhdessä Puna-armeijan kuoron kanssa."@fi ;
