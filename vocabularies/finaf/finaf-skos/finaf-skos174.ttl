    rdaa:P50334 finaf:000098307,
        finaf:000139535,
        finaf:000140989,
        finaf:000140991 ;
    rdaa:P50393 "Kuninkaallinen kirjapaino. Samanaikaisesti myös Henric Keyser II (1640-1699) käytti Kuninkaallisen kirjanpainajan arvoa vuosina 1678-1699."@fi,
        "Nils Wankijffin (k. 1690) leski Maria Matras jatkoi miehensä kuoleman jälkeen kirjapainon toimintaa. Kirjapainoa hoitivat ainakin Matthias Syngman (k. 1697) ilmeisesti vuoteen 1693, sitten Olof (Olaus) Enaeus (k. 1710) vuoteen 1694, Michael Laurelius (k. 1719) vuoteen 1698 ja Johan Henric Werner vuoteen 1705, jolloin hän lunasti painon itselleen."@fi ;
    rdaa:P50407 "Wankijffin leski (kirjapaino, Tukholma, 1690-1705)"@fi ;
    rdau:P61101 "Klemming, G. E. Svensk boktryckeri-historia 1483-1883, 1883"@fi ;
