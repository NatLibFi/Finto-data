finaf:000037833 a rdac:C10005,
        skos:Concept ;
    dct:created "1999-11-19"^^xsd:date ;
    dct:modified "2020-11-05T20:47:28"^^xsd:dateTime ;
    rdaa:P50006 <http://isni.org/isni/000000009155624X>,
        "Asteri ID: 000037833" ;
    rdaa:P50022 yso:p2969,
        yso:p8434 ;
    rdaa:P50023 <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/fin> ;
    rdaa:P50025 "Paradise"@fi,
        "Pepe and Paradise"@fi ;
    rdaa:P50035 "Alun perin Paradise-nimellä esiintynyt yhtye muodostui Frankies-yhtyeestä, joka säesti laulaja Johnny Liebkindiä vuoden 1968 kesäkiertueella. Mukana kiertueella oli myös Pepe Willberg. Syksyllä 1968 Paradise-yhtyeeseen tulivat Erkki Lehtola, Jorma Kalenius ja Antero Päiväläinen. Syksyllä 1969 Paradise fuusioitui Tapani Kansan yhtyeen kanssa ja jatkoi Kansan säestysyhtyeenä kevääseen 1970. Yhtyeessä soittivat tällöin myös Erik Dannholm, Seppo Keurulainen ja Christer Bergholm, joka tuli Kaleniuksen tilalle. Keväällä 1970 Paradisen ja Tapani Kansan tiet erosivat, ja yhtye alkoi esittää omaa ohjelmistoaan. Paradise-yhtye oli mukana myös Suomen Euroviisukarsinnoissa vuonna 1973. Seija Simolan esittämässä kappaleessa, One, two, three, lauloivat Pepe Willberg, Pave Maijanen, Markku Johansson ja Kalle Fält."@fi ;
    rdaa:P50236 "1968/.."^^<http://id.loc.gov/datatypes/edtf> ;
    rdaa:P50237 mts:m1100 ;
    rdaa:P50334 finaf:000148117 ;
    rdaa:P50350 yso:p94426 ;
    rdaa:P50407 "Pepe & Paradise"@fi ;
    rdau:P61101 "<a href='http://www.saunalahti.fi/~oystila/raimo/pepe/historiikki/paradise.html'>Raimo Öystilän sivusto</a>, katsottu 2.2.2018"@fi,
        "<a href='https://fi.wikipedia.org/wiki/Pepe & Paradise'>Wikipedia</a>, katsottu 15.1.2018"@fi,
        "<a href='https://fi.wikipedia.org/wiki/Pepe_%26_Paradise'>Wikipedia</a>, katsottu 28.11.2012"@fi,
        "<a href='https://www.pepewillberg.net/historiaa'>Pepe Willbergin kotisivut</a>, katsottu 2.2.2018 (perustamisvuosi)"@fi,
        "<a href='https://yle.fi/aihe/artikkeli/2007/02/26/seija-simola-ja-paradise-one-two-three'>Yle. Elävä areena</a>, katsottu 2.2.2018"@fi,
        "Hankalat musiikkinimet"@fi,
        "Kai vielä muistat sen, 2012: t.p. (Kai vielä muistat sen / Pepe Willberg, Georg Lindström. Helsinki : Readme.fi,)"@fi,
        "Suomalaisen rockin tietosanakirja. 2 / Lehtonen"@fi ;
    skos:altLabel "Paradise"@fi,
        "Pepe and Paradise"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Pepe & Paradise"@fi .

