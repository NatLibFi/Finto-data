    rdaa:P50025 "#Uuttakoulua -projektet"@fi,
        "Projektet #Uuttakoulua"@fi,
        "Uuttakoulua -projektet"@fi,
        "Uuttakoulua-hanke"@fi ;
    rdaa:P50035 "#Uuttakoulua-hanke oli osa Uusi peruskoulu -ohjelmaa. Ohjelman tavoitteena oli edistää peruskoulun oppijalähtöisyyttä, lisätä opettajien osaamista sekä vahvistaa avointa ja yhteisöllistä toimintakulttuuria. Hanke alkoi 1.4.2019 ja se päättyi 31.1.2021. Hanke toteutettiin yhteistyössä Opetushallituksen, Helsingin yliopiston Koulutuksen arviointikeskuksen, Etelä-Suomen Aluehallintoviraston, Suomen Vanhempainliiton, Dialogiakatemian/ Synesiksen ja Positive Learning:n kanssa."@fi ;
    rdaa:P50037 "2019" ;
    rdaa:P50038 "2021" ;
    rdaa:P50237 mts:m853 ;
    rdaa:P50407 "#Uuttakoulua-hanke"@fi ;
    rdau:P61101 "Tehdään yhdessä #Uuttakoulua, 2020"@fi ;
    skos:altLabel "#Uuttakoulua -projektet"@fi,
        "Projektet #Uuttakoulua"@fi,
        "Uuttakoulua -projektet"@fi,
        "Uuttakoulua-hanke"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "#Uuttakoulua-hanke"@fi .

