finaf:000002078 a rdac:C10005,
        skos:Concept ;
    dct:created "1997-01-23"^^xsd:date ;
    dct:modified "2025-06-15T11:06:53+03:00"^^xsd:dateTime ;
    rdaa:P50006 <http://isni.org/isni/0000000474378719>,
        "Asteri ID: 000002078" ;
    rdaa:P50016 finaf:000037009 ;
    rdaa:P50025 "Centralen för huslig ekonomi"@fi,
        "Marttaliiton, Pienviljelijäin keskusliiton, Pienviljelijäin liiton, Sos. dem. työläisnaisliiton ja Finlands svenska Marthaförbund'in kotitalouskeskus"@fi ;
    rdaa:P50236 "1941/1972"^^<http://id.loc.gov/datatypes/edtf> ;
    rdaa:P50407 "Kotitalouskeskus"@fi ;
    rdau:P61101 "<a href='https://apurahat.skr.fi/nimikkorahastot/nimikkorahastoesite?numero=283350'>Suomen kulttuurirahaston verkkosivut</a>, katsottu 15.6.2025 (Kotitalous- ja kuluttaja-asiain tutkimuskeskus ry - Forskningscentralen för hushållnings- och konsumentfrågor rf. sai alkunsa 30.9.1941, jolloin neuvonta- järjestöjen edustajat kokoontuivat Marttaliiton aloitteesta keskustelemaan Kotitalouskeskuksen perustamisesta. Marttaliiton ohella perustajia olivat Pienviljelijäin Keskusliitto, Pienviljelijäin Liitto ja Sosiaalidemokraattinen Työläisnaisliitto. Myös Finlands svenska Marthaförbund kuului perustajajäseniin, ja jatkossa mukaan liittyi muitakin järjestöjä. ... Kotitalouskeskus toimi valtakunnallisena tutkimuskeskuksena toimialanaan kotitalousopetus ja -neuvonta sekä kuluttajapolitiikkaa palveleva tutkimustoiminta. ... Nimi muutettiin 1972 Kotitalous- ja kuluttaja-asiain tutkimuskeskukseksi (KKTK).)"@fi,
        "Kirjontaa / Aino Hausmann, [1945]: kansi (Marttaliiton, Pienviljelijäin keskusliiton, Pienviljelijäin liiton, Sos. dem. työläisnaisliiton ja Finlands svenska Marthaförbund'in kotitalouskeskus)"@fi ;
    skos:altLabel "Centralen för huslig ekonomi"@fi,
        "Marttaliiton, Pienviljelijäin keskusliiton, Pienviljelijäin liiton, Sos. dem. työläisnaisliiton ja Finlands svenska Marthaförbund'in kotitalouskeskus"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Kotitalouskeskus"@fi .

