    rdaa:P50104 mts:m2441,
        mts:m2666 ;
    rdaa:P50109 yso:p106038,
        yso:p140952 ;
    rdaa:P50113 "Flaamilainen, Antwerpenissä (1548-1589) toiminut kirjanpainaja ja kustantaja. Aloitti Christophe Plantinin oppipoikana vuonna 1557, työskenteli vuosien 1562-1563 tienoilla Venetsiassa ja palasi sitten Antwerpeniin. Nai Martina Plantinin vuonna 1570. Peri appensa yrityksen tämän kuoltua vuonna 1589. Leski jatkoi liiketoimintaa vuodet 1610-1614, ja hänen jälkeensä heidän poikansa Balthasar ja Jan (II)."@fi ;
    rdaa:P50120 "1610" ;
    rdaa:P50121 "1543" ;
    rdaa:P50291 "Moretus" ;
