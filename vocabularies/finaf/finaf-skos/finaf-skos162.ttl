    rdaa:P50291 "Hörhammer" ;
    rdaa:P50292 "Ivar" ;
    rdaa:P50318 finaf:000022315 ;
    rdaa:P50411 "Hörhammer, Ivar, 1884-1953"@fi ;
    rdau:P61101 "<a href='https://fi.wikipedia.org/wiki/Ivar_H%C3%B6rhammer'>Wikipedia</a>, katsottu 11.11.2025 (Ivar Hörhammer: Ivar Gabriel Hörhammer (11. helmikuuta 1884 Örebro – 3. helmikuuta 1953 Helsinki) oli suomalainen taidekauppias, mesenaatti, toimittaja ja poliitikko. Hän toimi SDP:n kansanedustajana 1909–1911 sekä työskenteli muun muassa Arbetet-lehden päätoimittajana 1910–1912. Jätettyään politiikan vuonna 1916 Hörhammerista tuli Suomen merkittävimpiä taidevaikuttajia, joka tunnetaan erityisesti Helsingissä pitkään toimineen Galerie Hörhammerin perustajana ja ensimmäisenä toimitusjohtajana."@fi ;
    skos:altLabel "Hörhammer, I. (Ivar), 1884-1953"@fi,
        "Hörhammer, Ivar Gabriel, 1884-1953"@fi ;
    skos:hiddenLabel "I. Hörhammer"@fi,
        "Ivar Gabriel Hörhammer"@fi,
        "Ivar Hörhammer"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Hörhammer, Ivar, 1884-1953"@fi .

