    rdaa:P50103 "Cervantes Salazar, Francisco, noin 1514-1575"@fi,
        "Cervantes y Salazar, Francisco, noin 1514-1575"@fi,
        "De Salazar, Francisco Cervantes, noin 1514-1575"@fi,
