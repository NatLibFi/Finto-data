    rdaa:P50103 "Willebrand, Canutus Felix, 1814-1893"@fi,
        "Willebrand, K. F. v., 1814-1893"@fi,
        "Willebrand, K. F. von, 1814-1893"@fi ;
    rdaa:P50104 mts:m2487,
        mts:m3368 ;
    rdaa:P50113 "FK 1836, FM 1836, LK 1839, LL 1840, LKT 1840. Alilääkäri 1. Suomen meriekipaasissa 1840, ylilääkäri 1842-1850. Vankilanlääkäri Helsingissä 1841. Aleksanterin yliopiston lääketieteen apulainen 1843. Professorin arvonimi 1856. Yleisen patologian ja lääkeopillisen klinikan professori 1856-1874. Lääkintöylihallituksen päätirehtööri 1863-1890. Valtioneuvos 1867. Todellinen valtioneuvos 1874. Vapaaherra 1889. Valtiopäivämies 1863-1864, 1867, 1872, 1877-1878, 1882, 1885 ja 1888."@fi ;
    rdaa:P50118 yso:p94137 ;
    rdaa:P50119 "Salo, Suomi"@fi ;
