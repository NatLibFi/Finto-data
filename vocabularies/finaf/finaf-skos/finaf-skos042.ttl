finaf:000105430 a rdac:C10004,
        skos:Concept ;
    dct:created "1998-10-06"^^xsd:date ;
    dct:modified "2026-10-05T04:05:23+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000052666585>,
        <http://viaf.org/viaf/13164419068520232319>,
        "Asteri ID: 000105430" ;
    rdaa:P50097 yso:p94383,
        yso:p94426 ;
    rdaa:P50100 yso:p3884,
        yso:p3941 ;
    rdaa:P50103 "Knorring, Henric Johan von, 1683-1752"@fi,
        "Knorring, Johan Hinric von, 1683-1752"@fi ;
    rdaa:P50104 mts:m2359 ;
    rdaa:P50109 yso:p94351 ;
    rdaa:P50113 "Suomenruotsalainen aatelinen upseeri. Vapaaehtoinen eversti Hornin varuskuntarykmentissä Narvassa 1699. Aliupseeri Otto Wellingkin jalkaväkirykmentissä 1700. Luutnantti Viipurin kaksinkertaisessa jalkaväkirykmentissä 1701. Kapteeni Uudenmaan kaksinkertaisessa rykmentissä 1708 ja Uudenmaan vakinaisessa jalkaväkirykmentissä 1709; majuri samassa rykmentissä 1714. Jämtlandin armeijan kenraaliadjutantti 1718; kapteeni Pohjanmaan rykmentissä 1721; majuri 1734; everstiluutnantti samassa rykmentissä 1739. Eversti Porin rykmentissä 1741. Miekkaritarikunnan ritari 1748. Haudattu Porin kaupunginkirkkoon. Osallistui taisteluihin Narvassa, Väinäjoella, Systerbäckissä ja Gemauertzhoffissa, Viipurin piirityksiin vuosina 1706 ja 1710 sekä Napuen taisteluun vuonna 1714. Osallistui myös sotaretkiin Norjassa 1718 ja Suomessa 1740-luvulla."@fi ;
    rdaa:P50120 "1752" ;
    rdaa:P50121 "1683" ;
    rdaa:P50291 "Knorring" ;
    rdaa:P50292 "Henrik Johan von" ;
    rdaa:P50411 "Knorring, Henrik Johan von, 1683-1752"@fi ;
    rdau:P61101 "<a href='http://runeberg.org/anrep/2/0472.html'>Anrep, Gabriel. Svenska adelns ättar-taflor. 2, 1861</a>"@fi,
        "Nuncius necis Saulinae a Davide caesus, 2. Sam. I: 15., [1733]"@fi,
        "Vallinkoski, Jorma. Turun akatemian väitöskirjat 1642-1828. II"@fi ;
    skos:altLabel "Knorring, Henric Johan von, 1683-1752"@fi,
        "Knorring, Johan Hinric von, 1683-1752"@fi ;
    skos:hiddenLabel "Henric Johan von Knorring"@fi,
        "Henrik Johan von Knorring"@fi,
        "Johan Hinric von Knorring"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Knorring, Henrik Johan von, 1683-1752"@fi .

