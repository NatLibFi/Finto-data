finaf:000105592 a rdac:C10004,
        skos:Concept ;
    dct:created "1998-10-08"^^xsd:date ;
    dct:modified "2026-09-29T08:07:57+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000051911614>,
        <http://viaf.org/viaf/68916410>,
        "Asteri ID: 000105592" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p3884 ;
    rdaa:P50103 "Skagge, Daniel Olofsson, 1686-1751"@fi,
        "Skragge, Daniel Olofsson, 1686-1751"@fi ;
    rdaa:P50104 mts:m3173 ;
    rdaa:P50113 "Ruotsalainen upseeri. Aateloitiin vuonna 1719. Vuonna 1703 liittyi vapaaehtoisena Närken-Värmlannin rykmenttiin; vuonna 1705 hänet määrättiin kenttäarmeijaan, mutta sijoitettiin Riikaan, jossa hänestä tuli vuonna 1709 Buddenbrockin rykmentin rykmentinadjutantti. Jäi venäläisten vangiksi Riian valtauksen yhteydessä vuonna 1710, mutta onnistui pakenemaan ja palasi Ruotsiin vuonna 1711. Siellä hänet nimitettiin Västmanlannin rykmentin alikapteeniksi. Osallistui rykmentin mukana Stenbockin Pommerin-sotaretkeen. Hän oli mukana torjumassa Stralsundin piiritystä (1711–1712) ja hänet nimitettiin Hälsingen rykmentin toiseksi kapteeniksi, mutta hän jäi tanskalaisten vangiksi Tönningenin antautumisen jälkeen. Onnistui kuitenkin pakenemaan takaisin Ruotsiin vuonna 1714. Seurasi Armfeldtia vuoden 1718 Norjan-sotaretkellä ja yleni sotaretken aikana majuriksi, vaikka saikin virallisen nimityksen Västerbottenin rykmentin majuriksi vasta vuonna 1739. Osallistui hattujen sotaan Venäjää vastaan. Keväällä 1742 hänestä tuli everstiluutnantti ja Västerbottenin rykmentin vt. komentaja."@fi ;
    rdaa:P50118 yso:p226793 ;
    rdaa:P50119 "Huggenäs, Ruotsi"@fi ;
    rdaa:P50120 "1751" ;
    rdaa:P50121 "1686" ;
    rdaa:P50291 "Lagerborg" ;
    rdaa:P50292 "Daniel" ;
    rdaa:P50411 "Lagerborg, Daniel, 1686-1751"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Daniel_Lagerborg'>Wikipedia</a>, katsottu 28.9.2026 (Daniel Lagerborg)"@fi ;
