    rdaa:P50104 mts:m2780,
        "sotaviskaali"@fi ;
    rdaa:P50109 yso:p105464,
        yso:p239385,
        yso:p94447 ;
    rdaa:P50113 "Ruotsalainen aatelinen juristi. Opiskelijana Lundissa vuonna 1726. Auskultanttina Svean hovioikeudessa vuonna 1729 ja Götan hovioikeudessa vuonna 1730. Aktuaarin sijaisena Kamarikollegiossa marraskuussa 1735. Aktuaarina Kamarikollegiossa vuonna 1736. Turun läänin jalkaväkirykmentin rykmentintarkastajana vuonna 1737. Sotilasviskaalina vuonna 1743. Asessorina Turun hovioikeudessa vuonna 1747. Kuoli naimattomana Turussa ja haudattiin Turun tuomiokirkkoon."@fi ;
    rdaa:P50120 "1750" ;
    rdaa:P50121 "1706" ;
    rdaa:P50291 "Mannerfelt" ;
