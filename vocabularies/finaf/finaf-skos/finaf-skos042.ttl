finaf:000104468 a rdac:C10004,
        skos:Concept ;
    dct:created "1998-09-07"^^xsd:date ;
    dct:modified "2026-09-23T12:28:02+03:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000051994560>,
        "Asteri ID: 000104468" ;
    rdaa:P50097 yso:p94383,
        yso:p94426 ;
    rdaa:P50100 yso:p3884 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Fröberg, Eric, 1682-1751"@fi ;
    rdaa:P50104 mts:m2359 ;
    rdaa:P50113 "Ruotsalainen upseeri. Aloitti sotilasuransa vapaaehtoisena isänsä rykmentissä. Palveli sitten henkivartiokaartissa ja Länsi-Götanmaan rakuunarykmentissä, jossa ylennettiin kapteeniksi vuonna 1709. Osallistui Kaarle XII:n Venäjän-sotaretkeen. Vaikka haavoittui Pultavassa, seurasi kuningasta Benderiin, jossa osallistui kahakkaan vuonna 1713. Vuonna 1715 hän sai majurin arvon Benderin rakuunarykmentissä, ja vuonna 1717 hänet aateloitiin. Jatkoi sotilasuraansa, kohosi Pohjois-Skoonen ratsuväkirykmentissä everstiluutnantiksi ja vuonna 1741 everstiksi. Samana vuonna hänet nimitettiin Uudenmaan jalkaväkirykmentin everstiksi ja komentajaksi; kyseisen rykmentin riveissä hän osallistui tappiolliseen hattujen sotaan. Vältti kuolemantuomion, mutta erotettiin, koska oli hylännyt asemansa ja vetäytynyt joukkoineen."@fi ;
    rdaa:P50118 "Järeda, Ruotsi"@fi ;
    rdaa:P50120 "1751" ;
    rdaa:P50121 "1682" ;
    rdaa:P50291 "Fröberg" ;
    rdaa:P50292 "Erik" ;
    rdaa:P50411 "Fröberg, Erik, 1682-1751"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Erik_Fr%C3%B6berg'>Wikipedia</a>, katsottu 23.9.2026 (Erik Fröberg)"@fi ;
    skos:altLabel "Fröberg, Eric, 1682-1751"@fi ;
    skos:hiddenLabel "Eric Fröberg"@fi,
        "Erik Fröberg"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Fröberg, Erik, 1682-1751"@fi .

