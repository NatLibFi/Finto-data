    rdaa:P50097 yso:p104968,
        yso:p94383 ;
    rdaa:P50103 "Frederico Adolfo di Svezia, duca di Östergötland, 1750-1803"@fi,
        "Fredrik Adolf, prins av Sverige, hertig av Östergötland, 1750-1803"@fi,
        "Fredrik, prins av Sverige, 1750-1803"@fi,
        "Friedrich Adolf, Schweden, Prinz , 1750-1803"@fi,
        "Friedrich Adolph Ostgotland, Herzog, 1750-1803"@fi,
        "Frédéric-Adolphe de Suède, 1750-1803"@fi ;
    rdaa:P50110 mts:m3651,
        mts:m809 ;
    rdaa:P50113 "Ruotsalainen prinssi, Itä-Göötanmaan herttua. Nimitettiin jo 12-vuotiaan everstiksi ja vuonna 1792 sai ylennyksen kenraaliksi ja kenttämarsalkaksi. Nämä sotilasarvot olivat lähinnä muodollisia vailla velvoitteita, mutta hän osallistui kuitenkin sotaan Venäjää vastaan vuonna 1788. Hänen käskyjään ei kuitenkaan toteltu, ja kuningas lähetti hänet muun armeijakunna kanssa Loviisan varuskuntaan. Erosi armeijasta välittömästi, ja asettui tukemaan Anjalan liiton näkemyksiä."@fi ;
    rdaa:P50118 "Montpellier, Ranska"@fi ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1803" ;
    rdaa:P50121 "1750" ;
    rdaa:P50292 "Fredrik Aadolf" ;
    rdaa:P50411 "Fredrik Aadolf, Ruotsin prinssi, Itä-Göötanmaan herttua, 1750-1803"@fi ;
    rdau:P61101 "<a href='https://fi.wikipedia.org/wiki/Fredrik_Adolf'>Wikipedia</a>, katsottu 8.5.2026 (Fredrik Adolf)"@fi ;
