        yso:p4668 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Schröder, Georgius Claudius, 1714-1773"@fi,
        "Schröder, Göran Klas, 1714-1773"@fi,
        "Schröder, Jöran, 1714-1773"@fi ;
    rdaa:P50104 mts:m2479,
        mts:m2816 ;
    rdaa:P50109 yso:p105464,
        yso:p106813,
        yso:p167868 ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi. Opiskeli ensin (1728) Uppsalan ja sitten Lundin (1735) yliopistoissa. Valmistuttuaan maisteriksi vuonna 1738 hän toimi kreikan kielen lehtorina Kalmarin kymnaasissa. Sai pappisvihkimyksen vuonna 1740, hovisaarnaajaksi seuraavana vuonna. Vuonna 1751 hän aloitti Tukholma Pyhän Nikolauksen seurakunnan kirkkoherrana ja kruununprinssi Kustaan teologianopettajana. Vuonna 1753 hän alkoi opettaa myös perintöruhtinaita Kaarlea ja Fredrik Adolfia. Hän suoritti teologian tohtorin tutkinnon vuonna 1751 (myönnettiin virallisesti vuonna 1752). Hän toimi myös kuninkaallisten ritarikuntien pappina. Vuonna 1756 hänet vapautettiin hovisaarnaajan ja ritarikuntien papin tehtävistään. Vuonna 1770 sai nimityksen Karlstadin hiippakunnan superintendentiksi, ja lokakuussa 1772 hänestä tuli saman hiippakunnan piispa."@fi ;
    rdaa:P50118 "Karlstad, Ruotsi"@fi ;
    rdaa:P50119 yso:p105256 ;
    rdaa:P50120 "1773" ;
    rdaa:P50121 "1714" ;
    rdaa:P50291 "Schröder" ;
    rdaa:P50292 "Georg Claes" ;
    rdaa:P50411 "Schröder, Georg Claes, 1714-1773"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Georg_Claes_Schr%C3%B6der'>Wikipedia</a>, katsottu 24.11.2026 (Georg Claes Schröder)"@fi ;
