finaf:000238447 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:modified "2026-11-02T07:53:55+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000051828394>,
        <http://viaf.org/viaf/61530103>,
        "Asteri ID: 000238447" ;
    rdaa:P50097 yso:p105087,
        yso:p94383 ;
    rdaa:P50100 yso:p1584 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Ruder, Gustav, 1708-1771"@fi,
        "Ruder, Gustavus, 1708-1771"@fi,
        "Ruder, Göstaf, 1708-1771"@fi ;
    rdaa:P50104 mts:m2413 ;
    rdaa:P50109 yso:p105464 ;
    rdaa:P50113 "Ruotsalainen pedagogi. Kirjoittautui Lundin yliopistoon vuonna 1726, ja vuosina 1730–1731 opiskeli Greifswaldin yliopistossa. Asui vuodesta 1732 Tukholmassa, jonne perusti seuraavana vuonna 1733 yksityiskoulun. Useat yritykset saada virka julkisesta oppilaitoksesta epäonnistuivat, mikä johtui todennäköisesti ennen kaikkea hänen ja Tukholman papiston välisistä ristiriidoista. Hän kritisoi tiettyjä pappissäädylle kuuluvia taloudellisia etuoikeuksia. Ajoi useissa kirjoituksissaan lahjakkuuksien valintaa (\"snillevalet\"). Ruderille tämä käsite (\"delectus ingeniorum\") tarkoitti yksilön koulutuksen räätälöimistä sekä tämän henkilökohtaisten taipumusten että työmarkkinoiden tarpeiden perusteella. Näiden taipumusten selvittämiseksi hän ehdotti kokeiden ja havaintojen käyttöä, joiden avulla oppilaat luokiteltaisiin neljän temperamentin teorian mukaisesti. Hän kannatti myös toimintoja, kuten juoksua, purjehdusta ja uintia, edistääkseen yksilön tasapainoista kehitystä. Hän anoi useaan otteeseen kuninkaalta tai valtiopäiväsäädyiltä lupaa toteuttaa ajatuksiaan käytännössä, mutta tuloksetta. Samoin kävi hänen muillekin ehdotuksilleen, joiden tavoitteena oli mukauttaa kouluopetusta käytännön elämän vaatimuksiin esimerkiksi perustamalla kotitalouskouluja."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p112241 ;
    rdaa:P50120 "1771" ;
    rdaa:P50121 "1708" ;
    rdaa:P50291 "Ruder" ;
    rdaa:P50292 "Gustaf" ;
    rdaa:P50346 yso:p167868,
        yso:p234571 ;
    rdaa:P50411 "Ruder, Gustaf, 1708-1771"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Gustaf_Ruder'>Wikipedia</a>, katsottu 2.11.2026 (Gustaf Ruder)"@fi ;
    skos:altLabel "Ruder, Gustav, 1708-1771"@fi,
