finaf:000238647 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-12"^^xsd:date ;
    dct:modified "2026-11-12T11:36:41+02:00"^^xsd:dateTime ;
    rdaa:P50094 "Asteri ID: 000238647" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p3582 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Lagerfelt, Gustaf Adolf, 1693-1769"@fi ;
    rdaa:P50104 mts:m2452 ;
    rdaa:P50109 yso:p106813,
        yso:p234959 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50113 "Ruotsalainen aatelinen virkamies. Aloitti opinnot Uppsalan yliopistossa vuonna 1708. Vuonna 1713 hän aloitti auskultanttina Svean hovioikeudessa. Vuosina 1720-1721 hänet nimitettiin kihlakunnantuomariksi useisiin kihlakuntiin Itä-Göötanmaalla, ja myöhemmin, vuonna 1741, hänestä tuli revisionisihteeri. Vuonna 1748 hänet nimitettiin Linköpingin läänin maaherran virkaan, jota hoiti lopun elämänsä. Hänestä tuli vuonna 1758 Pohjantähti-ritari. Vuonna 1766 kuningas korotti hänet vapaaherraksi ja myönsi pian tämän jälkeen presidentin arvonimen."@fi ;
    rdaa:P50118 yso:p234959 ;
    rdaa:P50119 "Kärna, Ruotsi"@fi ;
    rdaa:P50120 "1769" ;
    rdaa:P50121 "1693" ;
    rdaa:P50291 "Lagerfeldt" ;
    rdaa:P50292 "Gustaf Adolph" ;
    rdaa:P50411 "Lagerfeldt, Gustaf Adolph, 1693-1769"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Gustaf_Adolf_Lagerfelt'>Wikipedia</a>, katsottu 12.11.2026 (Gustaf Adolf Lagerfelt)"@fi ;
