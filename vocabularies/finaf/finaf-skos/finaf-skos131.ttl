    rdaa:P50102 <http://lexvo.org/id/iso639-3/fra> ;
    rdaa:P50103 "Auenstein, Georges Louis Schmid d', 1720-1805"@fi,
        "Avenstein, George Louis Schmid d', 1720-1805"@fi,
        "Schmid d'Avenstein, George Louis, 1720-1805"@fi,
        "Schmid, Georgius Ludovicus, 1720-1805"@fi,
        "Schmidt, George Ludwig, 1720-1805"@fi ;
    rdaa:P50104 mts:m2487,
        mts:m2852,
        mts:m3004 ;
    rdaa:P50109 yso:p104996,
        yso:p178125 ;
    rdaa:P50113 "Sveitsiläinen lääkäri ja filosofi. Valmistui lääkäriksi Leidenin yliopistosta vuonna 1747. Vuosina 1748–1756 hän toimi neuvonantajana Saksi-Weimarin herttuakunnan hovissa, ennen kuin palasi Sveitsiin. Vuosina 1760–1763 hän julkaisi teoksen \"Essais sur divers sujets intéressans de politique et de morale\", joka sai merkittävää vaikutusvaltaa eri puolilla Eurooppaa ja käännettiin useille kielille. Vuosina 1767–1768 hän oleskeli Pariisissa. Hänen vuonna 1776 julkaistu teoksensa \"Principes de la législation universelle\" edisti fysiokratian aatteita."@fi ;
    rdaa:P50118 "Lenzburg, Sveitsi"@fi ;
    rdaa:P50119 "Aarau, Sveitsi"@fi ;
    rdaa:P50120 "1805" ;
    rdaa:P50121 "1720" ;
    rdaa:P50291 "Auenstein" ;
    rdaa:P50292 "Georg Ludwig Schmid von" ;
    rdaa:P50411 "Auenstein, Georg Ludwig Schmid von, 1720-1805"@fi ;
    rdau:P61101 "<a href='https://fr.wikipedia.org/wiki/Georges_Louis_Schmid'>Wikipedia</a>, katsottu 23.11.2026 (Georges Louis Schmid)"@fi ;
