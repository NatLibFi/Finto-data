        yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Löwenbach, Carl Fredrik Pechlin, 1720-1796"@fi,
        "Pechlin von Löwenbach, Carl Friedrich, 1720-1796"@fi,
        "Pechlin, Carl Fredrik, 1720-1796"@fi ;
    rdaa:P50104 mts:m2816,
        mts:m5089 ;
    rdaa:P50109 yso:p105464,
        yso:p167868 ;
    rdaa:P50110 "vapaaherra"@fi ;
    rdaa:P50113 "Saksalais-ruotsalainen upseeri ja poliitikko. Opiskeltuaan Lundin yliopistossa liittyi vuonna 1733 Ruotsin armeijaan ja osallistui hattujen sotaan. Eteni eversitiluutnantiksi (1751), everstiksi (1761) ja kenraalimajuriksi (1770). Päästyään Ruotsin ritarihuoneen jäseneksi saattoi osallistua menestyksekkäämmin Ruotsin puoluekamppailuihin. Vuosien 1755–1756 valtiopäiviin mennessä hän oli syrjäyttänyt F. Gyllenborgin ja päässyt asemaan, jossa hän saattoi valvoa ranskalaisten lahjusten jakamista. Vuosien 1760-1762 valtiopäivillä vastusti ponnekkaasti hovin pyrkimyksiä kasvattaa valtaansa, mutta teki vain muutaman päivän kestäneen sovinnon hovipuolueen kanssa tammikuussa 1761. Hänen johtamansa \"maapuolueeksi\" kutsuttu hattuja vastustava oppositio hajosi salaiseen sopimukseen Ranskan lähettilään ja von Fersenin kanssa. Paheksuntaa herätti myös yritys estää A. Nordencrantzin komission toiminta, jotta saisi suojeltua lankonsa R. Finlayn ja J. Jenningsin tarkastukselta. Kiivaiden yhteenottojen jälkeen hänet erotettiin valtiopäiviltä kesken kauden elokuussa 1761 ja kiellettiin pyrkimästä seuraavallekin istuntokaudelle."@fi ;
    rdaa:P50118 yso:p150288 ;
    rdaa:P50119 "Holstein, Saksa"@fi ;
    rdaa:P50120 "1796" ;
    rdaa:P50121 "1720" ;
    rdaa:P50291 "Pechlin" ;
    rdaa:P50292 "Carl Friedrich" ;
    rdaa:P50411 "Pechlin, Carl Friedrich, 1720-1796"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Carl_Fredrik_Pechlin'>Wikipedia</a>, katsottu 24.11.2026 (Carl Fredrik Pechlin)"@fi ;
    skos:altLabel "Löwenbach, Carl Fredrik Pechlin, 1720-1796"@fi,
        "Pechlin von Löwenbach, Carl Friedrich, 1720-1796"@fi,
        "Pechlin, Carl Fredrik, 1720-1796"@fi ;
