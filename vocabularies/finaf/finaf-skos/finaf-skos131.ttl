    rdaa:P50094 <http://isni.org/isni/0000000123529773>,
        <http://viaf.org/viaf/282262653>,
        "Asteri ID: 000238819" ;
    rdaa:P50097 yso:p104990 ;
    rdaa:P50098 "../1750"^^<http://id.loc.gov/datatypes/edtf> ;
    rdaa:P50100 yso:p25952,
        yso:p454,
        yso:p9026 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/lat> ;
    rdaa:P50103 "Britannicus, 1684 tai 1691-1750"@fi,
        "Cato, 1684 tai 1691-1750"@fi,
        "Englishman, 1684 tai 1691-1750"@fi,
        "Layman, 1684 tai 1691-1750"@fi,
        "Montanus, 1684 tai 1691-1750"@fi,
        "Philo-Reflector, 1684 tai 1691-1750"@fi,
        "True-born Englishman, 1684 tai 1691-1750"@fi,
        "laïque, Un, 1684 tai 1691-1750"@fi ;
    rdaa:P50104 mts:m2522,
        mts:m2565,
        mts:m3004 ;
    rdaa:P50109 yso:p104995 ;
    rdaa:P50113 "Brittiläinen klassinen filologi ja pamfletisti. Kannatti kansainyhteisöaatetta. Julkaisi vuosien 1719-1740 tienoilla yhdessä J. Trenchardin kanssa viikkolehteä \"The Independent Whig\". Hän toimi Trenchardin sihteerinä ja nai myöhemmin tämän lesken Anne Blackettin saaden näin haltuunsa huomattavan omaisuuden. Johti viinilupien valvontavirastoa kuolemaansa asti. Paheksui eläinten tappamista ihmisravinnoksi ja oli sitä mieltä, että vasta kulttuuriset käytännöt saavat ihmiset voittamaan vastenmielisyytensä lihaa kohtaan."@fi ;
    rdaa:P50119 "Kirkcudbright, Skotlanti"@fi ;
    rdaa:P50121 "[1684..1691]" ;
    rdaa:P50291 "Gordon" ;
