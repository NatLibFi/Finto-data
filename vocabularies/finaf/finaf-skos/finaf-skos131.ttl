finaf:000238863 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-25"^^xsd:date ;
    dct:modified "2026-11-25T13:20:21+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000053404886>,
        <http://viaf.org/viaf/77118271>,
        "Asteri ID: 000238863" ;
    rdaa:P50097 yso:p107128,
        yso:p94383 ;
    rdaa:P50100 yso:p21228,
        yso:p3884,
        yso:p4029,
        yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2443,
        mts:m2773,
        mts:m2776,
        mts:m2816,
        mts:m3996 ;
    rdaa:P50113 "Ruotsalainen, Englannissa kasvanut aatelinen kauppias ja poliitikko. Perheen palattua Ruotsiin vietti vuodet 1750-1753 sotilaana ja yleni ratsumestariksi. Tämän jälkeen hän alkoi harjoittaa liiketoimintaa laajassa mittakaavassa. Hän hyötyi merkittävästi hattupuolueen luotosta, jonka hän sai appensa T. Plomgrenin kautta. Hankkimalla huomattavia lainoja Ruotsin valtionpankista hän pystyi ostamaan ja perustamaan useita rautaruukkeja, muun muassa Robertsforsin ja Olofsforsin ruukit. Näiden hankkeiden menestys johti hänen nimitykseensä Järnkontoretin johtokunnan jäseneksi sekä valintaansa Ruotsin kuninkaallisen tiedeakatemian jäseneksi vuonna 1756. Samana vuonna akatemia myönsi Jenningsille kultamitalin tunnustuksena hänen parannuksistaan masuunien rakenteeseen. Vuosina 1752–1762 hän harjoitti R. Finlayn ja J. Graverin kanssa kuninkaallisella etuoikeudella toimivaa ”englantilaista nahkatehdasta” Kungsholmenilla. Liikeideana oli parkita häränvuotia pohjanahaksi, jonka heikko kysyntä sekä vaikeudet raaka-aineiden hankinnassa johtivat kuitenkin huonoon kannattavuuteen. Hän oli myös kiinnostunut kanavarakentamisesta. Vuosien 1760–1762 valtiopäivillä hän alkoi myös osallistua aktiivisesti poliittiseen elämään. Varakkaana miehenä hän tuki puoluetta taloudellisesti. Tänä aikana hän istui myös salaisessa valiokunnassa. Vuoden 1769 valtiopäivillä hänellä oli hyvin aktiivinen rooli pyrkimyksissä palauttaa hattupuolue valtaan. Vapauden ajan viimeisillä valtiopäivillä hän joutui A. Nordencrantzin hyökkäyksen kohteeksi. Tämä väitti, että Jenningsin taloudellinen toiminta oli aiheuttanut valtakunnassa vallinneen taloudellisen epäjärjestyksen. Jennings laati yksityiskohtaisia ​​vastineita, jotka julkaistiin myöhemmin vuonna 1772. Syytösten tutkimiseen asetettiin kaikista neljästä säädystä koostuva valiokunta, mutta Kustaa III:n vallankaappaus keskeytti tutkinnan."@fi ;
    rdaa:P50118 "Forsmark (Östhammar), Ruotsi"@fi ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1773" ;
    rdaa:P50121 "1729" ;
    rdaa:P50291 "Jennings" ;
    rdaa:P50292 "John" ;
    rdaa:P50411 "Jennings, John, 1729-1773"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/John_Jennings'>Wikipedia</a>, katsottu 25.11.2026 (John Jennings)"@fi ;
    skos:hiddenLabel "John Jennings"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Jennings, John, 1729-1773"@fi .

