finaf:000238607 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-10"^^xsd:date ;
    dct:modified "2026-11-10T18:01:53+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000066427438>,
        <http://viaf.org/viaf/7423265>,
        "Asteri ID: 000238607" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p10414,
        yso:p17618,
        yso:p4655 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Bergius, Benedictus, 1723-1784"@fi,
        "Bergius, Bengt, den yngre, 1723-1784"@fi ;
    rdaa:P50104 mts:m3004,
        mts:m3294,
        mts:m3407 ;
    rdaa:P50109 yso:p105464,
        yso:p167868 ;
    rdaa:P50113 "Ruotsalainen historioitsija ja botanisti. Aloitti opintonsa Lundin yliopistossa vuonna 1741, valmistui maisteriksi vuonna 1745 ja toimi historian dosenttina vuosina 1747–1749. Myöhemmin hän muutti Tukholmaan, jossa hänestä tuli vuonna 1758 ylimääräinen asessori muinaistieteellisessä arkistossa, ja vuonna 1762 hänet nimitettiin komissaariksi pankkiin. Alkoi jo opiskeluaikanaan kerätä aineistoa Ruotsin poliittisesta ja aatehistoriasta, ja kokosi näin kymmeniä niteitä lähdeaineistoa. Hänen 8-osainen teoksensa \"Småsaker till nöje och tidsfördrif\" (1756–1757), jonka julkaisemista jatkettiin nimellä \"Allahanda\" (3 osaa, 1757-1758) herätti suurta huomiota. Se sisälsi runoja (joista useat olivat Olof von Dalinin käsialaa), anekdootteja ja muuta aineistoa. Niiden julkinen myynti kiellettiin, mikä vain lisäsi niiden kysyntää entisestään. Vuonna 1766 hänet valittiin Ruotsin kuninkaallisen tiedeakatemian jäseneksi. Hän toimi akatemian puheenjohtajana kahdesti: ensimmäisen kerran vuonna 1769, jolloin hän piti esitelmän ruotsalaisesta niittyhoidosta ja sen kehittämisestä viljelemällä tuottoisia heinälajeja ja toisen kerran vuonna 1780, jolloin hän käsitteli esitelmässään ”herkkuja” tarkastellen sekä luonnostaan ​​herkullisina pidettyjä asioita että sellaisia, joita eri kansat pitävät herkkuina omien tapojensa ja käsitystensä perusteella."@fi ;
    rdaa:P50119 "Hålanda, Ruotsi"@fi ;
    rdaa:P50120 "1784" ;
    rdaa:P50121 "1723" ;
    rdaa:P50291 "Bergius" ;
    rdaa:P50292 "Bengt" ;
    rdaa:P50411 "Bergius, Bengt, 1723-1784"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Bengt_Bergius'>Wikipedia</a>, katsottu 10.11.2026 (Bengt Bergius)"@fi ;
    skos:altLabel "Bergius, Benedictus, 1723-1784"@fi,
        "Bergius, Bengt, den yngre, 1723-1784"@fi ;
    skos:hiddenLabel "Benedictus Bergius"@fi,
        "Bengt Bergius"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Bergius, Bengt, 1723-1784"@fi .

