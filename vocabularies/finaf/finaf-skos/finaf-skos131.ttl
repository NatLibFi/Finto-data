finaf:000238750 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-18"^^xsd:date ;
    dct:modified "2026-11-18T12:10:05+02:00"^^xsd:dateTime ;
    rdaa:P50094 "Asteri ID: 000238750" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p16546,
        yso:p3884 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Gyllenstierna af Björksund och Helgö, Nils, 1670-1731"@fi,
        "Gyllenstierna, Nils Göransson, 1670-1731"@fi ;
    rdaa:P50104 mts:m3154,
        mts:m3193 ;
    rdaa:P50110 mts:m816 ;
    rdaa:P50113 "Ruotsalainen aatelinen upseeri ja virkamies. Aloitti sotilasuransa ulkomaisessa palveluksessa. Vuonna 1694 hänestä tuli ratsuväen kapteeni Ruotsin armeijassa; hänet ylennettiin majuriksi vuonna 1698, everstiluutnantiksi vuonna 1701 ja rakuunarykmentin everstiksi vuonna 1707. Rykmentinkomentajana hän osallistui Kaarle XII:n Venäjän-sotaretkeen. Hän oli mukana Pultavan taistelussa vuonna 1709, jossa hän jäi sotavangiksi, palasi Ruotsiin venäläisestä vankeudesta vasta vuonna 1722, ja samana vuonna hänestä tuli ratsuväen kenraaliluutnantti. Vuonna 1723 hänet nimitettiin Södermanlandin läänin maaherraksi, ja vuonna 1727 hänestä tuli valtaneuvos. Valtaneuvostossa Gyllenstiernan katsottiin kuuluvan Arvid Hornin ryhmäkuntaan."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50120 "1731" ;
    rdaa:P50121 "1670" ;
    rdaa:P50291 "Gyllenstierna" ;
    rdaa:P50292 "Nils" ;
    rdaa:P50411 "Gyllenstierna, Nils, 1670-1731"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Nils_Gyllenstierna_(1670%E2%80%931731)'>Wikipedia</a>, katsottu 18.11.2026 (Nils Gyllenstierna (1670–1731))"@fi ;
    skos:altLabel "Gyllenstierna af Björksund och Helgö, Nils, 1670-1731"@fi,
        "Gyllenstierna, Nils Göransson, 1670-1731"@fi ;
    skos:hiddenLabel "Nils Gyllenstierna"@fi,
        "Nils Gyllenstierna af Björksund och Helgö"@fi,
        "Nils Göransson Gyllenstierna"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Gyllenstierna, Nils, 1670-1731"@fi .

finaf:000238751 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-18"^^xsd:date ;
    dct:modified "2026-11-18T12:38:56+02:00"^^xsd:dateTime ;
    rdaa:P50094 "Asteri ID: 000238751" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p9663 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Brahe, Ulrika Juliana, 1704-1765"@fi,
        "Gyllenstierna, Ulrica Juliana, 1704-1765"@fi ;
    rdaa:P50104 mts:m3384 ;
    rdaa:P50110 mts:m2094 ;
    rdaa:P50113 "Ruotsalainen kreivitär ja hovinainen. Vuonna 1721 hän avioitui vapaaherra C.g. von Liewenin kanssa, mutta tämä kuoli jo helmikuussa 1722 ennen heidän poikansa Carl Gustafin syntymää. Maaliskuussa 1723 hän solmi toisen avioliittonsa kreivi Nils Gyllenstiernan kanssa. Tästä liitosta syntyneet lapset Göran (1724) ja Eva Margareta (1730) elivät aikuisikään asti. Vuonna 1761 Ulrika Juliana Gyllenstierna nimitettiin hovin ylikamarirouvaksi (\"överhovmästarinna\"). Hän hoiti tehtävää kuolemaansa saakka. Hänestä käytettiin usein nimeä \"kreivitär Brahe\", sillä hovissa oli tapana puhutella naista hänen tyttönimellään, jos naisen isän suku oli yhteiskunnalliselta asemaltaan korkeampi kuin hänen aviomiehensä suku."@fi ;
    rdaa:P50118 "Nyköping, Ruotsi"@fi ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1765" ;
    rdaa:P50121 "1704" ;
    rdaa:P50291 "Gyllenstierna" ;
    rdaa:P50292 "Ulrika Juliana" ;
    rdaa:P50411 "Gyllenstierna, Ulrika Juliana, 1704-1765"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Ulrika_Juliana_Gyllenstierna'>Wikipedia</a>, katsottu 18.11.2026 (Ulrika Juliana Gyllenstierna)"@fi ;
    skos:altLabel "Brahe, Ulrika Juliana, 1704-1765"@fi,
        "Gyllenstierna, Ulrica Juliana, 1704-1765"@fi ;
    skos:hiddenLabel "Ulrica Juliana Gyllenstierna"@fi,
        "Ulrika Juliana Brahe"@fi,
        "Ulrika Juliana Gyllenstierna"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Gyllenstierna, Ulrika Juliana, 1704-1765"@fi .

finaf:000238752 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-18"^^xsd:date ;
    dct:modified "2026-11-18T13:15:21+02:00"^^xsd:dateTime ;
    rdaa:P50094 "Asteri ID: 000238752" ;
    rdaa:P50097 yso:p104968,
        yso:p94383 ;
    rdaa:P50100 yso:p3884 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/fra>,
        <http://lexvo.org/id/iso639-3/ita>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Gyldenstierna, Göran, 1662-1736"@fi,
        "Gyllenstierna af Björksund och Helgö, Nils, 1662-1736"@fi,
        "Gyllenstierna, Göran Jöransson, 1662-1736"@fi,
        "Güldenstierna, Göran, 1662-1736"@fi ;
    rdaa:P50104 mts:m5089 ;
    rdaa:P50110 mts:m816 ;
    rdaa:P50113 "Ruotsalainen aatelinen upseeri. Vuosina 1682-1685 teki laajan Euroopan-matkan ja opiskeli eri yliopistoissa sekä muissa oppilaitoksissa. Tämän jälkeen hän aloitti sotilasuransa. Syyskuussa 1788 hänestä tuli kapteeni eversti Gustaf Mauritz Lewenhauptin rakuunarykmentissä, joka palveli vuosina 1688–1691 osana Ruotsin apujoukkoja Hollannissa yhdeksänvuotisen sodan aikana. Rykmentti osallistui yhdellä pataljoonalla vuonna 1690 käytyyn, liittokunnan kannalta tappiolliseen Fleuruksen taisteluun, jossa se oli sijoitettuna liittokunnan armeijan oikeaan sivustaan. Vuonna 1691 Gyllenstierna ylennettiin saman rykmentin everstiksi. Hän erosi tästä tehtävästä vuonna 1698. Heinäkuussa 1700 hänet nimitettiin Skånen \"tremännings\"-ratsurykmentin everstiksi. Suuren Pohjan sodan aikana, kun tanskalaiset hyökkäsivät Skåneen, Magnus Stenbock ylensi Gyllenstiernan kenraalimajuriksi ja antoi hänen komentoonsa kolme Skånessa ollutta ratsurykmenttiä. Tanskan sotaretken ajan hän toimi yhtenä Magnus Stenbockin tärkeimmistä alipäälliköistä ja johti ruotsalaisjoukkoja Fjälkingessä käydyssä yhteenotossa, jossa hän joutui perääntymään tanskalaisten ylivoiman edessä. Helmikuussa 1710 käydyssä Helsingborgin taistelussa, joka päättyi ruotsalaisten voittoon, Gyllenstierna komensi ruotsalaisten vasemman sivustan ensimmäistä linjaa kenraaliluutnantti J. Burenskiöldin yleisjohdon alaisuudessa. Taistelun jälkeen, maaliskuussa 1710, Gyllenstierna nimitettiin ratsuväen kenraalimajuriksi. Hän pyysi eroa palveluksesta vuonna 1718. Gyllenstierna kuoli naimattomana sukutilallaan Torönsborgissa."@fi ;
    rdaa:P50118 "Söderköping, Ruotsi"@fi ;
    rdaa:P50119 yso:p104996 ;
    rdaa:P50120 "1736" ;
    rdaa:P50121 "1662~" ;
    rdaa:P50291 "Gyllenstierna" ;
    rdaa:P50292 "Göran" ;
    rdaa:P50411 "Gyllenstierna, Göran, 1662-1736"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/G%C3%B6ran_Gyllenstierna_(1662%E2%80%931736)'>Wikipedia</a>, katsottu 18.11.2026 (Göran Gyllenstierna (1662–1736))"@fi ;
