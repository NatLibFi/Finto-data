    rdaa:P50103 "Lang, Nils, 1681-1747"@fi ;
    rdaa:P50104 mts:m2452,
        mts:m3004 ;
    rdaa:P50109 yso:p106813,
        yso:p112241 ;
    rdaa:P50113 "Ruotsalainen virkamies ja kirjoittaja. Opiskelijana Uppsalassa vuonna 1700. Sotakollegion presidentin sihteeri vuonna 1714, sihteeri samassa virastossa vuonna 1719. Aateloitiin yhdessä veljensä kanssa vuonna 1727. Amiraliteettikamarineuvos Karlskronassa vuonna 1728. Kuoli siellä lapsettomana, jolloin koko aatelissuku sammui. Hän oli pietistisen liikkeen vankka kannattaja ja tuli tunnetuksi useista terävistä, purevista ja nimettöminä julkaistuista kirjoituksista, joissa hän haastoi papiston vuoden 1720 valtiopäivillä."@fi ;
    rdaa:P50118 yso:p112241 ;
    rdaa:P50119 "Gillberga (Säffle), Ruotsi"@fi ;
    rdaa:P50120 "1747" ;
    rdaa:P50121 "1681" ;
    rdaa:P50291 "Lang" ;
    rdaa:P50292 "Nils von" ;
    rdaa:P50411 "Lang, Nils von, 1681-1747"@fi ;
    rdau:P61101 "<a href='https://www.adelsvapen.com/genealogi/Von_Lang_nr_1832'>Adelsvapen.com</a>, katsottu 29.10.2026 (Nils Lang)"@fi ;
