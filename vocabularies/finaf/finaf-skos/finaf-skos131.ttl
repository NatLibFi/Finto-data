finaf:000238861 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-25"^^xsd:date ;
    dct:modified "2026-11-25T09:52:18+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000022099356>,
        <http://viaf.org/viaf/3313988>,
        "Asteri ID: 000238861" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p3884 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Brummer, M. H., 1735-1790"@fi ;
    rdaa:P50104 mts:m2410,
        mts:m3348 ;
    rdaa:P50109 yso:p106813 ;
    rdaa:P50113 "Ruotsalainen upseeri ja metsänhoitaja. Kirjoittautui Uppsalan yliopistoon vuonna 1752, liittyi vapaaehtoisena Länsi-Göötanmaan ratsurykmenttiin vuonna 1755 ja henkikaartiin vuonna 1756, jossa hän yleni myöhemmin samana vuonna rustmestariksi. Syyskuussa 1756 Brummerista tuli kersantti Länsi-Götanmaan ja Dalslandin rykmentissä. Tammikuussa 1757 hänet nimitettiin saman rykmentin nuoremmaksi adjutantiksi, ja saman vuoden syyskuussa hän sai luutnantin arvon. Toukokuusta 1757 alkaen hän osallistui Pommerin sotaan; kesäkuussa 1758 hän sai vänrikin viran, ja tammikuussa 1759 hän jäi sotavangiksi Anklamin antautuessa. Rauhan solmimisen jälkeen vuonna 1762 hänet vapautettiin, ja vuonna 1763 hänet ylennettiin luutnantiksi. Hän sai sijoituksen Vedbon komppaniaan, josta hänet siirrettiin pian sen jälkeen Sundalin komppaniaan. Joulukuussa 1758 tapahtunut putoaminen hevosen selästä aiheutti hänelle nivustyrän, minkä vuoksi hänen oli erottava sotapalveluksesta vuonna 1770. Vaikka hän saikin pientä eläkettä valtakunnan palveluksessa saamiensa vammojen vuoksi, hänen oli vaikea tulla toimeen, ja vuonna 1773 hän haki takaisin sotapalvelukseen. Hakemus hylättiin, samoin kuin hänen yrityksensä löytää työtä ulkomailta, mutta vuonna 1775 hän onnistui saamaan ylimetsänhoitajan viran Hallandin läänistä. Vuonna 1787 hän erosi tehtävästä paremman palkan toivossa, mutta yritys oli turha."@fi ;
    rdaa:P50118 "Eftra, Ruotsi"@fi ;
    rdaa:P50119 "Nors, Ruotsi"@fi ;
    rdaa:P50120 "1790" ;
    rdaa:P50121 "1735" ;
    rdaa:P50291 "Brummer" ;
    rdaa:P50292 "Magnus Hendric" ;
    rdaa:P50411 "Brummer, Magnus Hendric, 1735-1790"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Magnus_Hendric_Brummer'>Wikipedia</a>, katsottu 25.11.2026 (Magnus Hendric Brummer)"@fi ;
