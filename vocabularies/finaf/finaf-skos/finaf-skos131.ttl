finaf:000238625 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-11"^^xsd:date ;
    dct:modified "2026-11-12T10:31:36+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000078465423>,
        <http://viaf.org/viaf/71677965>,
        "Asteri ID: 000238625" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p2339 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Triewaldt, Martin, 1691-1747"@fi,
        "Tydelekurson, Mårten, 1691-1747"@fi ;
    rdaa:P50104 mts:m2443,
        mts:m2644 ;
    rdaa:P50109 yso:p105464,
        yso:p505667,
        "Östhammar, Ruotsi"@fi ;
    rdaa:P50113 "Ruotsalainen kauppias, teknikko ja Ruotsin kuninkaallisen tiedeakatemian perustajajäsen. Kävi aluksi kauppaa, mutta sai vuonna 1716 työnjohtajan paikan Newcastlen hiilikaivoksilla ja perehtyi siellä mekaniikkaan. Teki useita parannuksia höyrykoneisiin. Palattuaan Ruotsiin vuonna 1726 rakensi valtakunnan ensimmäisen höyrykoneen Dannemoran kaivoksille veden pois pumppaamiseksi. Vuosina 1728-1729 hän luennoi mekaniikasta Tukholman Ritarihuoneella ja esitteli D. Menlösin avustamana Englannista hankkimiaan tieteellisiä instrumentteja. Vuonna 1732 Lundin yliopisto osti nämä välineet ja myönsi Menlösille matematiikan professuurin vastineeksi. Triewald nimitettiin \"director mechanicus\" -virkaan, ja hän työskenteli jonkin aikaa raudanvalmistuksen parissa Västmanlandissa. Vuonna 1735 hänet nimitettiin maansa ainoana tähän tehtävään sopivana henkilönä linnoitusjoukkojen \"captain-mechanicus\"-arvoon. Samalla hänelle myönnettiin säätyjen taholta vuotuinen eläke. Lisäksi hän perusti vuonna 1729 sukellusyhtiön ja kirjoitti teoksen, jossa kuvattiin avoimien sukelluskellojen käyttöä sekä sukeltajille tarkoitettuja varusteita. Myös mehiläishoito kiinnosti häntä. Vuonna 1729 hänet valittiin Uppsalan kuninkaallisen tiedeseuran jäseneksi, ja oli vuonna 1739 yksi Ruotsin kuninkaallisen tiedeakatemian kuudesta perustajajäsenestä. Hän oli myös Lontoon Royal Societyn jäsen."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1747" ;
    rdaa:P50121 "1691" ;
    rdaa:P50291 "Triewald" ;
    rdaa:P50292 "Mårten" ;
    rdaa:P50411 "Triewald, Mårten, 1691-1747"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/M%C3%A5rten_Triewald'>Wikipedia</a>, katsottu 11.11.2026 (Mårten Triewald)"@fi ;
    skos:altLabel "Triewaldt, Martin, 1691-1747"@fi,
        "Tydelekurson, Mårten, 1691-1747"@fi ;
    skos:hiddenLabel "Martin Triewaldt"@fi,
