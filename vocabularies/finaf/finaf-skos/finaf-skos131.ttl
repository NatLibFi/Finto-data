    skos:prefLabel "Odelström, Erik, 1684-1753"@fi .

finaf:000238524 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-05"^^xsd:date ;
    dct:modified "2026-11-05T10:57:58+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000053826376>,
        <http://viaf.org/viaf/39360163>,
        "Asteri ID: 000238524" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p10943 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Stridzberg, Magnus, 1696-1772"@fi ;
    rdaa:P50104 mts:m2413,
        mts:m3368 ;
    rdaa:P50109 "Boteå, Ruotsi"@fi ;
    rdaa:P50113 "Ruotsalainen opettaja ja maatalousasiantuntija. Hän kirjoittautui Uppsalan yliopistoon vuonna 1715 ja suoritti siellä maisterintutkinnon vuonna 1725. Toimittuaan vuodesta 1728 lähtien opettajana Härnösandin triviaalikoulussa hänet nimitettiin vuonna 1737 filosofian lehtoriksi saman kaupungin kymnaasiin. Hän jäi eläkkeelle vuonna 1761, jolloin hänelle myönnettiin \"extra ordinarius\"-professorin arvonimi. Sai perinnöksi Sundbyn tilan ja kiinnostui syvästi maataloudesta, erityisesti sen teknisistä näkökohdista. Hänen ehkä jo 1730-luvulla suunnittelemansa raskaspyöräinen puintivaunu korvasi raskaan käsinpuinnin. Keksintö levisi koko Norlannin alueelle, ja hän kuvaili sitä itse vuonna 1754 Ruotsin kuninkaallisen tiedeakatemian julkaisusarjassa \"VAH\". Hän julkaisi myös muita maatalouden uudistamiseen tähtääviä teoksia, ja vuonna 1755 hänelle myönnettiin Ruotsin kuninkaallisen tiedeakatemian kultamitali humalanviljelyä koskevista havainnoistaan."@fi ;
    rdaa:P50119 "Boteå, Ruotsi"@fi ;
    rdaa:P50120 "1772" ;
    rdaa:P50121 "1696" ;
    rdaa:P50291 "Stridsberg" ;
    rdaa:P50292 "Magnus" ;
    rdaa:P50411 "Stridsberg, Magnus, 1696-1772"@fi ;
    rdau:P61101 "<a href='https://sok.riksarkivet.se/sbl/Presentation.aspx?id=34529&forceOrdinarySite=true'>Riksarkivet.se</a>, katsottu 5.11.2026 (Magnus Stridsberg)"@fi ;
