    rdaa:P50103 "Hiortzberg, Jonas, 1703-1766"@fi,
        "Hjortsberg, Jonas Laurentii, 1703-1766"@fi,
        "Hjortzberg Larsson, Jonas, 1703-1766"@fi ;
    rdaa:P50104 mts:m2479,
        mts:m2816,
        mts:m3285 ;
    rdaa:P50109 yso:p105464,
        yso:p106813,
        "Edeby, Ruotsi"@fi ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi ja runoilija. Aloitti opiskelunsa Uppsalan yliopistossa vuonna 1721 ja tuli siellä tunnetuksi runoilijana. Vihittiin papiksi vuonna 1729, ja toimi sen jälkeen pappina Edebyssä Helgarössä. Vuonna 1735 hän muutti Tukholmaan Maria Magdalenan seurakunnan apulaispapiksi. Siellä hän tuli tunnetuksi taitavana saarnaajana ja väsymättömänä köyhien auttajana; juuri hänen tarmokkuutensa ansiosta perustettiin Marian köyhäintalo. Vuonna 1747 hän siirtyi Kjulaan seurakunnan kirkkoherraksi. Vuonna 1761 hänet nimitettiin kunniarovastiksi, valittiin valtiopäiväedustajaksi ja nimitettiin salaiseen valiokuntaan."@fi ;
    rdaa:P50118 "Kjula (Eskilstuna), Ruotsi"@fi ;
    rdaa:P50119 "Husby-Rekarne (Eskilstuna), Ruotsi"@fi ;
    rdaa:P50120 "1766" ;
    rdaa:P50121 "1703" ;
    rdaa:P50291 "Hjortsberg" ;
    rdaa:P50292 "Jonas Larsson" ;
    rdaa:P50411 "Hjortsberg, Jonas Larsson, 1703-1766"@fi ;
