    rdaa:P50100 yso:p469 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/eng>,
        <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2487,
        mts:m2522 ;
    rdaa:P50109 yso:p104995,
        yso:p106813,
        yso:p234550,
        "Harderwijk, Alankomaat"@fi ;
    rdaa:P50113 "Ruotsalainen lääkäri. Aloitti lääketieteen opinnot Uppsalan yliopistossa vuonna 1699 ja jatkoi niitä Englannissa. Väitteli tohtoriksi Alankomaissa Harderwijkin yliopistossa. Palveli Skoonessa kenttälääkärinä ja vuodesta 1715 alkaen Närken lääninlääkärinä. Eteni Collegium Medicumin asessoriksi ja vuonna 1724 Tukholman kaupunginlääkäriksi. Hän teki vuosien 1731 ja 1734 valtiopäiville virallisen ehdotuksen julkisen sairaalan rakentamisesta pääkaupunkiin, koska erillinen laitos oli välttämätön sekä köyhien sairaiden hoitamiseksi että uusien lääketieteen opiskelijoiden asianmukaiseksi kouluttamiseksi. Vaikka hänen kaukonäköinen ehdotuksensa kaatui lopulta kaupungin puutteellisiin taloudellisiin resursseihin, hänen ponnistelunsa raivasivat tietä vuoden 1737 terveyskomissiolle."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1739" ;
    rdaa:P50121 "1683" ;
