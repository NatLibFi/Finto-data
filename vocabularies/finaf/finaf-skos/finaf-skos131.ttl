finaf:000238599 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-10"^^xsd:date ;
    dct:modified "2026-11-16T04:08:15+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000016592005>,
        "Asteri ID: 000238599" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p454,
        yso:p9113 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50104 mts:m2452,
        mts:m2773,
        mts:m2816 ;
    rdaa:P50109 yso:p106813 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50113 "Ruotsalainen aatelinen virkamies. Opiskeli Uppsalan yliopistossa vuosina 1741-1750. Palkattomana harjoittelijana kauppakollegiossa vuonna 1750. Osallistui valtiopäiville (kannatti myssypuoluetta) vuosina 1760-1762, 1765-1766, 1771-1772, 1778 ja 1789. Toimi näiden aikana mm. salaisen valiokunnan jäsenenä vuosina 1762 ja 1765-1766. Pöytäkirjavaliokunnan jäsenenä (ja puheenjohtajana) vuosina 1771-1772 sekä valitsijamiehenä vuosina 1765-1766. Hän toimi valtakunnan säätyjen hallintoelimen valtuutettuna vuosina 1762-1765. Sai kamarineuvoksen arvonimen tammikuussa 1765 ja nimitettiin tullineuvokseksi saman vuoden joulukuussa. Hänellä oli myös kamariherran arvonimi. Säätyjen kuninkaalle lokakuussa 1766 osoittaman ilmoituksen seurauksena hänet julistettiin kelpaamattomaksi osallistumaan säätyjen käsittelyihin, ja hänet erotettiin kuninkaallisesta palveluksesta. Tämän seurauksena hänet erotettiin tullihallinnosta marraskuussa 1766. Elokuussa 1786 hänet nimitettiin kauppaneuvokseksi - kyseessä oli ylimääräinen virka. Hän toimi maalis-kesäkuussa 1788 jäsenenä komiteassa, jonka tehtävänä oli säädellä sillinpyyntiä ja kalaöljyn valmistusta koskevaa lainsäädäntöä. Hänelle myönnettiin vuonna 1772 Vaasan ritarikunnan komentajamerkki (KVO)."@fi ;
    rdaa:P50118 "Brännkyrka (Tukholma), Ruotsi"@fi ;
    rdaa:P50119 yso:p105464 ;
    rdaa:P50120 "1795" ;
    rdaa:P50121 "1734" ;
    rdaa:P50291 "Cederhielm" ;
    rdaa:P50292 "Josias Carl" ;
    rdaa:P50411 "Cederhielm, Josias Carl, 1734-1795"@fi ;
    rdau:P61101 "<a href='https://sok.riksarkivet.se/sbl/Presentation.aspx?id=14711'>Riksarkivet.se</a>, katsottu 10.11.2026 (Josias Carl Cederhielm)"@fi ;
