finaf:000238740 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-18"^^xsd:date ;
    dct:modified "2026-11-18T10:16:26+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://viaf.org/viaf/1185166959201147160008>,
        "Asteri ID: 000238740" ;
    rdaa:P50097 yso:p105190,
        yso:p94383 ;
    rdaa:P50100 yso:p454,
        yso:p7046 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Neresius, Joachim, 1688-1748"@fi,
        "Nerés, Joachim, 1688-1748"@fi ;
    rdaa:P50104 mts:m2344,
        mts:m2816 ;
    rdaa:P50109 yso:p105464,
        yso:p106813,
        yso:p106815 ;
    rdaa:P50113 "Ruotsalainen pormestari, kanslianeuvos ja porvarissäädyn valtiopäiväedustaja. Aloitti opinnot Uppsalan yliopistossa vuonna 1706. Vuonna 1708 sai paikan ylimääräisenä amanuenssina valtionarkistossa. Vuonna 1709 hän aloitti auskultanttina Svean hovioikeudessa, vuonna 1716 hänestä tuli presidentin sihteeri kauppakollegiossa ja myöhemmin samana vuonna komissaari samassa virastossa. Vuonna 1717 sai luvan matkustaa ulkomaille opiskelemaan palkkaansa menettämättä. Vuotta myöhemmin hän oli kuitenkin yhä Ruotsissa, kun hänet määrättiin osallistumaan Madagaskarille suuntautuvaan retkikuntaan, jonka tarkoituksena oli solmia sopimuksia siellä toimivien kaappareiden kanssa. Amsterdamissa ollessaan hän sai tiedon kuningas Kaarle XII:n kuolemasta ja päätti luopua tehtävästä. Samana kesänä Amsterdamissa hän tapasi Joakim Fredrik Preisin ja ryhtyi tämän avustajaksi Preisin toimiessa säätyjen yleiskokouksen sihteerinä. Göteborgin \"poliittisen pormestarin\" virka aukesi vuonna 1723 ja kuningas nimitti hänet siihen myöhemmin samana vuonna. Göteborgin pormestarina hän toimi kaupungin edustajana vuosien 1726–1727 valtiopäivillä, joilla hän oli jäsenenä salaisessa valiokunnassa sekä talous- ja kauppavaliokunnissa. Tukholman kauppapormestarin A. Aulævillin kuoltua hän haki siirtoa ja nimitettiin tähän virkaan vuonna 1728. Jo vuonna 1729 hänet kuitenkin nimitettiin sen sijaan kanslianeuvokseksi. Vuonna 1734 hän toimi komissaarina Ruotsin ja Ranskan välisissä neuvotteluissa sekä samana vuonna käydyissä neuvotteluissa Tanskan kanssa; hän osallistui myös Ison-Britannian ja Venäjän kanssa vuonna 1735 käytyihin neuvotteluihin. Aateloitiin vuonna 1730. Osallistui valtiopäiville vuosina 1731-1747. Vuonna 1731 salaisen valiokunnan jäsenenä, ja vuonna 1734 hän kuului raha-, talous- ja kauppavaliokuntiin. Hän tuki A. Hornin ulkopolitiikkaa, ja kun Horn erosi, oli hänenkin luovuttava kanslianeuvoksen virastaan."@fi ;
    rdaa:P50118 "Näshulta, Ruotsi"@fi ;
    rdaa:P50119 yso:p105256 ;
    rdaa:P50120 "1748" ;
    rdaa:P50121 "1688" ;
    rdaa:P50291 "Nerés" ;
    rdaa:P50292 "Joachim von" ;
    rdaa:P50411 "Nerés, Joachim von, 1688-1748"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Joachim_Ner%C3%A9s'>Wikipedia</a>, katsottu 18.11.2026 (Joachim Nerés)"@fi ;
    skos:altLabel "Neresius, Joachim, 1688-1748"@fi,
        "Nerés, Joachim, 1688-1748"@fi ;
    skos:hiddenLabel "Joachim Neresius"@fi,
