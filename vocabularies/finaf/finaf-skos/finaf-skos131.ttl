finaf:000238419 a rdac:C10005,
        skos:Concept ;
    dct:created "2026-10-29"^^xsd:date ;
    dct:modified "2026-10-29T12:39:51+02:00"^^xsd:dateTime ;
    rdaa:P50006 "Asteri ID: 000238419" ;
    rdaa:P50022 yso:p5954,
        yso:p7196,
        "kirkon hallinto"@fi ;
    rdaa:P50023 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50025 "Adeligit Jungfru Stift"@fi,
        "VAJS"@fi ;
    rdaa:P50035 "Säätiö perustettiin vuonna 1739 C.W. Cederhielmin ehdotuksesta. Alkuperäisenä tarkoituksena oli perustaa Vadstenan linnaan protestanttinen yhteisö aatelissukuisille naimattomille naisille. Sen oli määrä toimia sekä aatelistyttöjen kouluna että kotina varattomille aatelisnaisille, jotka eivät kyenneet elättämään itseään. Hanke ei kuitenkaan toteutunut kustannussyistä. Vuodesta 1747 alkaen säätiö alkoi kuitenkin ottaa jäseniä, jotka saivat arvonimen \"stiftsfröken\" sekä taloudellista avustusta, vaikka he eivät koskaan asuneet Vadstenan linnassa. Vuonna 1758 säätiö muutettiin virallisesti rahastoksi, jonka tarkoituksena oli tukea aatelissukuisia naimattomia naisia, jotka myös käyttivät arvonimeä \"stiftsfröken\". Vaikka VAJS ei koskaan varsinaisesti toiminut säätiönä, sen muodollinen haaraosasto Norrköping jungfrustift, toimi säätiönä vuosina 1783-1796."@fi ;
    rdaa:P50037 "1739" ;
    rdaa:P50038 "1758~" ;
    rdaa:P50237 mts:m257 ;
    rdaa:P50350 yso:p108404 ;
    rdaa:P50407 "Vadstena adliga jungfrustift."@fi ;
    rdau:P61101 "<a href='https://en.wikipedia.org/wiki/Vadstena_adliga_jungfrustift'>Wikipedia</a>, katsottu 29.10.2026 (Vadstena adliga jungfrustift)"@fi ;
    skos:altLabel "Adeligit Jungfru Stift"@fi,
        "VAJS"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Vadstena adliga jungfrustift."@fi .

