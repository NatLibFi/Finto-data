    rdaa:P50411 "König, Carl Henrik, 1726-1804"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Carl_Henrik_K%C3%B6nig'>Wikipedia</a>, katsottu 23.11.2026 (Carl Henrik König)"@fi ;
