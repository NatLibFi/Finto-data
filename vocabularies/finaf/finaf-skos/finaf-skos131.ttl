finaf:000238523 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-11-05"^^xsd:date ;
    dct:modified "2026-11-09T04:07:57+02:00"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000531877486>,
        "Asteri ID: 000238523" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p16546,
        yso:p3884 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Erik Karlsson, 1684-1753"@fi,
        "Odelström, Eric, 1684-1753"@fi ;
    rdaa:P50104 mts:m2359,
        mts:m3193 ;
    rdaa:P50109 yso:p173943 ;
    rdaa:P50113 "Ruotsalainen aatelinen upseeri. Aloitti sotilasuransa vapaaehtoisena linnoitusjoukoissa vuonna 1701. Vuonna 1705 hänestä tuli luutnantti rakuunarykmentissä. Eteni urallaan eri rykmenteissä ja oli everstiluutnantti, kun hänet aateloitiin vuonna 1711. Vuonna 1721 hän jäi eläkkeelle everstinä. Osallistui Pultavan taisteluun, jossa hän jäi sotavangiksi, mutta hänet vapautettiin vielä saman vuoden aikana. Vuonna 1710 hän osallistui Helsingborgin taisteluun, jossa haavoittui. Vuosina 1739-1749 hän toimi Länsi-Norlannin läänin maaherrana."@fi ;
    rdaa:P50118 "Kägleholm, Ruotsi"@fi ;
    rdaa:P50120 "1753" ;
    rdaa:P50121 "1684" ;
    rdaa:P50291 "Odelström" ;
    rdaa:P50292 "Erik" ;
    rdaa:P50411 "Odelström, Erik, 1684-1753"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Erik_Odelstr%C3%B6m'>Wikipedia</a>, katsottu 5.11.2026 (Erik Odelström)"@fi ;
    skos:altLabel "Erik Karlsson, 1684-1753"@fi,
        "Odelström, Eric, 1684-1753"@fi ;
    skos:hiddenLabel "Eric Odelström"@fi,
        "Erik Odelström"@fi ;
