        <http://viaf.org/viaf/9857012>,
        "Asteri ID: 000238452" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p3830 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Benzel, Ericus, 1675-1743"@fi,
        "Benzelius, Eric, den yngre, 1675-1743"@fi,
        "Benzelius, Ericus, 1675-1743"@fi ;
    rdaa:P50104 mts:m2479,
        mts:m2901,
        mts:m2919,
        mts:m3368 ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi. Pappisvihkimys vuonna 1709. Opiskelujensa jälkeen Benzelius teki laajan ulkomaanmatkan Saksaan, Ranskaan ja Englantiin. Matkalla hän perehtyi monipuolisesti ajan tieteelliseen elämään ja tutustui aikansa johtaviin tiedemiehiin, muun muassa Leibnitziin. Palattuaan hän toimi ensin vuodesta 1702 hän oli Uppsalan yliopiston kirjastonhoitaja, vuodesta 1723 professori, vuodesta 1726 Göteborgin piispa ja vuodesta 1731 Linköpingin piispa. Vuonna 1742 hänet nimitettiin Uppsalan arkkipiispaksi, mutta hän kuoli ennen astumistaan virkaan. Monipuolisten tietojensa ja suhteittensa ulkomaisiin tiedemiehiin avulla Benzelius vaikutti Ruotsin kirjalliseen elämään. Hän kartutti Upsalan kirjastoa noin 3 300 niteellä, toimitti aikanaan harvinaisia kriittisiä historiallia lähdejulkaisuja sekä perusti 1710 oppineen Collegium curiosorum -seuran sekä Ruotsin ensimmäinen tieteellisen aikakauskirjan Acta literaria Sueciae vuonna 1720. Vaikka Benzeliuksen mainitaan olleen uskonnolliselta kannaltaan suvaitsevainen, vastusti hän Johan Konrad Dippeliä (1673–1734) vaatien tämän karkottamista maasta."@fi ;
    rdaa:P50118 yso:p234959 ;
    rdaa:P50119 yso:p106813 ;
    rdaa:P50120 "1743" ;
    rdaa:P50121 "1675" ;
    rdaa:P50291 "Benzelius" ;
    rdaa:P50292 "Erik" ;
    rdaa:P50411 "Benzelius, Erik, 1675-1743"@fi ;
    rdau:P61101 "<a href='https://fi.wikipedia.org/wiki/Erik_Benzelius_nuorempi'>Wikipedia</a>, katsottu 2.11.2026 (Erik Benzelius nuorempi)"@fi ;
    skos:altLabel "Benzel, Ericus, 1675-1743"@fi,
        "Benzelius, Eric, den yngre, 1675-1743"@fi,
        "Benzelius, Ericus, 1675-1743"@fi ;
