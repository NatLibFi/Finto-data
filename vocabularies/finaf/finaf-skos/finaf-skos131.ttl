    rdaa:P50103 "Wilskman, Sven Gabrielsson, 1716-1797"@fi,
        "Wilskman, Sveno, 1716-1797"@fi ;
    rdaa:P50104 mts:m2414,
        mts:m2479,
        mts:m2770,
        mts:m2919,
        mts:m3294 ;
    rdaa:P50109 yso:p106813,
        "Skara, Ruotsi"@fi ;
    rdaa:P50113 "Ruotsalainen luterilainen pappi ja historioitsija. Valmistui filosofian maisteriksi Uppsalan yliopistosta vuonna 1743. Vuonna 1745 hänestä tuli Skaran lukion adjunkti, ja hänet vihittiin papiksi. Myöhemmin hän toimi Skaran konsistorin notaarina (1751), kaupungin triviaalikoulun rehtorina (1754), historian lehtorina Skaran lukiossa (1757) sekä saman oppilaitoksen rehtorina (1760). Vuonna 1763 hänet nimitettiin Fredsbergin kirkkoherraksi (otti viran vastaan ​​seuraavana vuonna). Vuonna 1772 hänelle myönnettiin teologian tohtorin arvo. Vuonna 1774 hänestä tuli Norra Vadsbon rovastikunnan lääninrovasti. Saatuaan vapautuksen tehtävistään hän asettui asumaan Skövdeen vuonna 1787."@fi ;
    rdaa:P50118 yso:p507537 ;
    rdaa:P50119 "Uddetorp, Ruotsi"@fi ;
    rdaa:P50120 "1797" ;
    rdaa:P50121 "1716" ;
    rdaa:P50291 "Wilskman" ;
    rdaa:P50292 "Sven" ;
    rdaa:P50411 "Wilskman, Sven, 1716-1797"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Sven_Wilskman'>Wikipedia</a>, katsottu 3.11.2026 (Sven Wilskman)"@fi ;
    skos:altLabel "Wilskman, Sven Gabrielsson, 1716-1797"@fi,
