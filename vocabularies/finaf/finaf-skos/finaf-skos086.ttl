    rdaa:P50103 "Celadon, 1718-1773"@fi,
        "Odel, Andreas, 1718-1773"@fi,
        "Odhelius, Anders, 1718-1773"@fi ;
    rdaa:P50104 mts:m2445,
        mts:m2933,
        mts:m3004 ;
    rdaa:P50113 "Ruotsalainen runoilija ja virkamies. Liittyi vapaaehtoisena linnoitusjoukkoihin vuonna 1747. Toimi vuodesta 1751 manufaktuurihallituksen palveluksessa ja vuodesta 1757 manufaktuurioikeuden johtajana. Hattupuolueen kannattaja, julkaisi sarjan puoluetta tukevia pamfletteja. Nuoruudessaan opiskeli kuvataidetta G.T. Taravalin johdolla. Vuodet 1748-1751 vietti Pariisissa perehtymässä ranskalaiseen taideteollisuuteen. Suunnitteli kuvioita silkkikankaisiin ja posliiniastioihin."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 "Falköping, Ruotsi"@fi ;
