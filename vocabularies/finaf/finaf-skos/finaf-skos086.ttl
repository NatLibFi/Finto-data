        skos:Concept ;
    dct:created "2018-08-16"^^xsd:date ;
    dct:modified "2020-11-16T20:03:18"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000484257742>,
        "Asteri ID: 000186809" ;
    rdaa:P50103 "Augenstern, Willy"@fi ;
    rdaa:P50291 "Augenstern" ;
    rdaa:P50292 "Arthur Wilhelm" ;
    rdaa:P50411 "Augenstern, Arthur Wilhelm"@fi ;
    rdau:P61101 "Paa-da-pap / Mikko Innanen & Innkvisitio (\"Tiller Waltz was composed by and almost forgotten Finnish jazz pioneer Arthur Wilhelm \"Willy\" Augenstern (1904-?, born as Artturi Wilhelm Armas), who had a strong presence on the Berlin music and cabaret scene in the 1920s and the 1930s. Augenstern composed an impressive amount of music during those turbulent years - unfortunately, most of it having been lost from posterity. As a composer, he was much ahead of his time as you can hear in the bi-tonal harmonies of this composition.\")"@fi ;
    skos:altLabel "Augenstern, Willy"@fi ;
    skos:hiddenLabel "Arthur Wilhelm Augenstern"@fi,
        "Willy Augenstern"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Augenstern, Arthur Wilhelm"@fi .

