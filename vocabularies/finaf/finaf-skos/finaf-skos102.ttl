    rdaa:P50025 "Games of the XV Olympiad (1952 : Helsinki)"@fi,
        "Helsingin olympialaiset 1952"@fi,
        "Kesäolympialaiset 1952 Helsingissä"@fi,
        "Olympic Games (15. : 1952 : Helsinki, Suomi)"@fi,
        "Olympiska sommarspelen 1952 i Helsingfors"@fi,
        "Olympiska spelen i Helsingfors 1952"@fi,
        "XV olympiadin kisat (1952 : Helsinki)"@fi ;
    rdaa:P50035 "Vuoden 1952 Helsingin olympialaiset (19. heinäkuuta 1952 – 3. elokuuta 1952) olivat 12. järjestetyt kesäolympialaiset. Kisojen virallinen järjestysnumero oli olympiadien mukaan XV, mutta kisat numero VI, XII ja XIII jäivät järjestämättä sotien takia). Helsinki oli alkujaan saanut järjestettäväkseen kesäolympialaiset 1940, jotka kuitenkin peruttiin talvisodan takia. Helsingille myönnettiin sitten sodan jälkeen vuoden 1952 kesäolympialaisten järjestäminen."@fi ;
    rdaa:P50037 "1952" ;
    rdaa:P50038 "1952" ;
    rdaa:P50237 mts:m4693 ;
