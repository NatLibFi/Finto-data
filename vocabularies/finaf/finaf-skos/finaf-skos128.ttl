    rdaa:P50100 yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Sparhe, Erich, 1550-1600"@fi,
        "Sparre de Sundby, Ericus, 1550-1600"@fi,
        "Sparre, Eric, 1550-1600"@fi,
        "Sparre, Erich, 1550-1600"@fi,
        "Sparre, Ericus, 1550-1600"@fi,
        "Sparre, Erik, 1550-1600"@fi,
        "Sparre, Eryk, 1550-1600"@fi ;
    rdaa:P50104 mts:m2773,
        mts:m3363 ;
    rdaa:P50110 mts:m3644 ;
    rdaa:P50113 "Ruotsalainen aatelinen ja valtaneuvos. Lyötiin ritariksi vuonna 1569, lähti opintomatkalle Frankfurt an der Oderiin ja ehkä myös Padovaan. Palasi Ruotsiin vuonna 1574 ja sai nopeasti korkeita virkoja. Valtaneuvoston jäsen vuodesta 1575 alkaen, toimi mm. varakanslerina, hovikanslerina ja laamannina sekä vuodesta 1582 lähtien Västmanlannin ja Taaliainmaan käskynhaltijana. Kannatti Juhana III:tta tämän ja Kaarle-herttuan välisessä kiistassa, siirtyi myöhemmin Sigismundin kannattajaksi. Teki kuitenkin sovinnon Kaarlen kanssa Juhana III;n kuoltua, mutta jatkoi kritiikkiä Kaarlen itsevaltaisuutta vastaan. Kirjoitti useita teoksia aristokraattisesta perustuslaillisuudesta. Mestattiin vuonna 1600 maanpetoksesta tuomittuna."@fi ;
    rdaa:P50118 yso:p234959 ;
    rdaa:P50119 "Öja, Ruotsi"@fi ;
    rdaa:P50120 "1600" ;
    rdaa:P50121 "1550" ;
