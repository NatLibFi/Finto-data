        <http://viaf.org/viaf/7287663>,
        "Asteri ID: 000237429" ;
    rdaa:P50095 "Lundin yliopisto"@fi ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p132237,
