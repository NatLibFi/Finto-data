    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Baneer, Steen, 1546-1600"@fi ;
    rdaa:P50104 mts:m2749,
        mts:m2773 ;
    rdaa:P50113 "Ruotsalainen aatelinen ja valtaneuvos. Opiskeltuaan Rostockissa (1558) ja Greifswaldissa (1562) hän toimi sota-aluksen päällikkönä vuodet 1566-1567 ja osallistui vuonna 1568 Tanskaa vastaan käytyyn seitsenvuotiseen sotaan. Oli mukana syrjäyttämässä Eerik XIV:ttä ja pääsi näin Juhana III:n suosioon, nimitettiin 24-vuotiaana valtaneuvostoon. Vuonna 1595 Sten Banér toimi Ruotsin pääneuvottelijana Täyssinän rauhassa. Mestattiin vuonna 1600 maanpetoksesta tuomittuna."@fi ;
    rdaa:P50118 yso:p234959 ;
    rdaa:P50119 "Djursholm, Ruotsi"@fi ;
    rdaa:P50120 "1600" ;
    rdaa:P50121 "1546" ;
