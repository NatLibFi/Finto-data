    rdaa:P50100 yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Bielke, Thure, 1548-1600"@fi ;
    rdaa:P50104 mts:m2773,
        mts:m3363 ;
    rdaa:P50113 "Ruotsalainen aatelinen ja valtaneuvos. Nimitettiin jo 25-vuotiaana Kalmarin käskynhaltijaksi, sitten Katariina Jagellonican hovimestariksi. Vuonna 1586 hänestä tuli valtaneuvoston jäsen. Toimi myös valtakunnan kamarimestarina, kamarineuvoksena, laamannina Smoolannissa vuosina 1593-1598 ja vuodesta 1579 alkaen Åkerbon kihlakunnan tuomarina. Pysyi loppuun asti uskollisena Sigismundille. Mestattiin vuonna 1600 maanpetoksesta tuomittuna."@fi ;
    rdaa:P50118 yso:p234959 ;
    rdaa:P50119 "Flen, Ruotsi"@fi ;
