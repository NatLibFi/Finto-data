finaf:000237220 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-07-20"^^xsd:date ;
    dct:modified "2026-07-21T08:33:31"^^xsd:dateTime ;
    rdaa:P50094 <http://viaf.org/viaf/4273157884810560620000>,
