    rdaa:P50097 yso:p210929,
        yso:p94383 ;
    rdaa:P50100 yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Baneer, Gustaf, 1547-1600"@fi,
        "Banér, Gustaf, 1547-1600"@fi,
        "Banér, Kustaa, 1547-1600"@fi ;
    rdaa:P50104 mts:m2773,
        mts:m3363 ;
    rdaa:P50113 "Ruotsalainen aatelinen ja valtaneuvos. Osallistui Eerik XIV:n syrjäyttämiseen, ja vain 23-vuotiaana hänestä tuli valtaneuvosto jäsen ja sai läänityksenä lähes koko Mustasaaren pitäjän ja Korsholman kartanon. Toimi Viron, Liivinmaan ja Inkerin käskynhaltijana. Vuonna 1571 hänellä oli Suomessa olevien joukkojen ylipäällikkyys, mutta ei menestynyt ja erotettiin tehtävässään syksyllä 1572. Asettui Sigismundin puolelle Kaarle-herttuaa vastaan. Vuonna 1598 Stångebron taistelun jälkeen hänet muiden valtaneuvosten kanssa luovutettiin Kaarlelle. Mestattiin vuonna 1600 maanpetoksesta tuomittuna."@fi ;
    rdaa:P50118 yso:p234959 ;
    rdaa:P50119 "Djursholm, Ruotsi"@fi ;
    rdaa:P50120 "1600" ;
    rdaa:P50121 "1547" ;
    rdaa:P50291 "Banér" ;
    rdaa:P50292 "Gustaf Axelsson" ;
    rdaa:P50411 "Banér, Gustaf Axelsson, 1547-1600"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Gustav_Ban%C3%A9r'>Wikipedia</a>, katsottu 20.7.2026 (Gustaf Banér)"@fi ;
