finaf:000237286 a rdac:C10004,
        skos:Concept ;
    dct:created "2026-07-31"^^xsd:date ;
    dct:modified "2026-07-31T12:01:38"^^xsd:dateTime ;
    rdaa:P50094 <http://isni.org/isni/0000000087050529>,
        <http://viaf.org/viaf/39347032>,
        "Asteri ID: 000237286" ;
    rdaa:P50097 yso:p94383 ;
    rdaa:P50100 yso:p454 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Gyllenstierna af Björksund och Helgo, Johan, 1635-1680"@fi,
        "Gyllenstjerna, Johan Göransson, 1635-1680"@fi,
        "Güldenstern, Johan, 1635-1680"@fi ;
    rdaa:P50104 mts:m2773,
        mts:m2816 ;
    rdaa:P50109 yso:p105464 ;
    rdaa:P50110 mts:m816 ;
    rdaa:P50113 "Ruotsalainen aatelinen ja valtaneuvos. Kuningas Kaarle X Kustaa nimitti vuonna 1658 hänet kamariherraksi ja antoi osallistua valtaneuvoston istuntoihin. Samana vuonna hän sai nimityksen kanslianeuvokseksi. Vuosien 1660 ja 1664 valtiopäivillä hän kohosi nuoremman ja alemman aatelin johtohahmoksi näiden kamppaillessa vanhempia kreivi- ja vapaaherrasukuja vastaan; hän pyrki rajoittamaan näiden säätyveljiensä etuoikeuksia omasta korkeasta syntyperästään huolimatta. Vuonna 1664 hän ajoi myös aatelistilojen osien palauttamista kruunulle. Ylhäisaateli nimitti hänet hovikansleriksi vuonna 1666 ja aateliston marsalkaksi vuoden 1668 valtiopäivillä tehdäkseen hänestä vaarattoman. Valtiopäivien päätyttyä Kaarle XI:n holhoojahallitus kutsui hänet valtaneuvostoon, jossa hänestä tuli pian valtakunnankansleri Magnus Gabriel De la Gardien Ranska-myönteisen politiikan jyrkin vastustaja. Palvellessaan Kaarle XI:n rinnalla Skånen sodassa Gyllenstierna onnistui saavuttamaan kuninkaan luottamuksen niin, että tämä kuunteli vain hänen neuvojaan. Vuonna 1674 hänet korotettiin vapaaherrasta kreiviksi. Vuonna 1679 hän toimi Ruotsin täysivaltaisena edustajana Lundin rauhanneuvotteluissa, joissa hän sai aikaan sopimuksen yhteispohjoismaisesta ulkopoliitikasta sekä rahaliitosta. Hänet nimitettiin tanskalaisten maakuntien kenraalikuvernööriksi, mutta kuoli jo seuraavan kesän alussa."@fi ;
    rdaa:P50118 "Landskrona, Ruotsi"@fi ;
    rdaa:P50119 "Brännkyrka, Ruotsi"@fi ;
    rdaa:P50120 "1680" ;
    rdaa:P50121 "1635" ;
    rdaa:P50291 "Gyllenstierna" ;
    rdaa:P50292 "Johan" ;
    rdaa:P50346 yso:p106813 ;
    rdaa:P50411 "Gyllenstierna, Johan, 1635-1680"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Johan_G%C3%B6ransson_Gyllenstierna'>Wikipedia</a>, katsottu 31.7.2026 (Johan Göransson Gyllenstierna)"@fi ;
    skos:altLabel "Gyllenstierna af Björksund och Helgo, Johan, 1635-1680"@fi,
