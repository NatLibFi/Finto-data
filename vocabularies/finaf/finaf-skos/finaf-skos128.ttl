    rdaa:P50104 mts:m2956 ;
    rdaa:P50119 "Keswick, Englanti"@fi ;
    rdaa:P50120 "2011?" ;
    rdaa:P50121 "1922" ;
    rdaa:P50291 "Preston" ;
    rdaa:P50292 "John" ;
    rdaa:P50346 yso:p94137 ;
    rdaa:P50411 "Preston, John, 1922-2011?"@fi ;
    rdau:P61101 "<a href='https://belfastgeologists.org/about-us/our-history/'>Belfast Geologists' Societyn verkkosivut</a>, katsottu 10.8.2026 (Dr John (Jack) Preston ... Jack was born in Keswick(21/1/22) ... After National Service ... he went to Manchester University where he read geology ... His PhD was undertaken at Helsinki University in Finland with Eskola, where he investigated mantled gneiss domes at Kuopia [se on Kuopio] ... Jack joined the Dept of Geology Queen’s University in the Autumn of 1951 and ... was immediately thrown into delivering a wide range of courses including stratigraphy, palaeontology and sedimentary petrology. Jack was an honorary member, as well as a long-time advisor, of the Belfast Geologists’ Society.)"@fi ;
    skos:altLabel "Preston, Jack, 1922-2011?"@fi ;
    skos:hiddenLabel "Jack Preston"@fi,
        "John Preston"@fi ;
    skos:inScheme finaf: ;
    skos:prefLabel "Preston, John, 1922-2011?"@fi .

