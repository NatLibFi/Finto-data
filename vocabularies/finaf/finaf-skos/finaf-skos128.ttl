        <http://lexvo.org/id/iso639-3/lat>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Oelreich, Niclas von, 1699-1770"@fi,
        "Oelreich, Nicolaus von, 1699-1770"@fi,
        "Oelreich, Nils von, 1699-1770"@fi,
        "Von Oelreich, Niklas, 1699-1770"@fi ;
    rdaa:P50104 mts:m2452,
        mts:m2519,
        mts:m2919,
        mts:m3368 ;
    rdaa:P50109 yso:p105464,
        yso:p167868 ;
    rdaa:P50113 "Ruotsalainen Lundin yliopiston professori, kanslianeuvos ja kirjailija. Teki ulkomaanmatkan vuosina 1738-1744, jonka jälkeen ylennettiin kirjallisuushistoriasta teoreettisen filosofian professoriksi. Nimitettiin sensoriksi vuonna 1746, ja tässä tehtävässä joutui usein vastakkain muiden kirjallisuutta valvovien viranomaisten – erityisesti Tukholman konsistorin – sekä kansliakollegiossa toimivien omien esimiestensä kanssa. Aateloitiin vuonna 1749. Ajoi aluksi hattupuolueen etuja, valtaneuvoston ja kuninkaan välisen kiistan aikana pyrki kääntämään yleisen mielipiteen valtaneuvoston kannalle julkaisemalla vuosina 1755-1756 Ruotsin ensimmäistä poliittista aikakauslehteä \"En ärlig swensk\". Lehti sai paljon huomiota ja suhteellisen laajan levikin. Petyttyään 1760-luvun alussa hattupuolueen rahapalkkion vähyyteen hän siirtyi myssyjen kannattajaksi ja sai näiden avulla julki kirjoituksiaan huolimatta riidastaan kansliakollegion kanssa. Vuonna 1762 hänet nimitettiin valtiosihteeriksi ja vuonna 1766 kauppakollegion presidentiksi."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 "Skurup, Ruotsi"@fi ;
    rdaa:P50120 "1770" ;
    rdaa:P50121 "1699" ;
    rdaa:P50291 "Oelreich" ;
    rdaa:P50292 "Niklas von" ;
    rdaa:P50411 "Oelreich, Niklas von, 1699-1770"@fi ;
    rdau:P61101 "<a href='https://sv.wikipedia.org/wiki/Niklas_von_Oelreich'>Wikipedia</a>, katsottu 20.8.2026 (Niklas von Oelreich)"@fi ;
    skos:altLabel "Oelreich, Niclas von, 1699-1770"@fi,
        "Oelreich, Nicolaus von, 1699-1770"@fi,
        "Oelreich, Nils von, 1699-1770"@fi,
