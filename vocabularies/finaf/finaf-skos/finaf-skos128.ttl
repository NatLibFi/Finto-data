    rdaa:P50097 yso:p105087,
        yso:p94383 ;
    rdaa:P50100 yso:p454,
        yso:p5209 ;
    rdaa:P50102 <http://lexvo.org/id/iso639-3/fra>,
        <http://lexvo.org/id/iso639-3/swe> ;
    rdaa:P50103 "Hamilton af Hageby, Carl Otto, 1704-1770"@fi ;
    rdaa:P50104 mts:m2816,
        mts:m3363 ;
    rdaa:P50110 mts:m3657 ;
    rdaa:P50113 "Ruotsalainen aatelinen ja valtioneuvos, hattupuolueen kannattaja. Vuosina 1728-1739 Holsteinin herttuan palveluksessa, jona aikana toimi Holsteinin lähettiläänä Isossa-Britanniassa, Alankomaissa ja Ranskassa. Palattuaan Ruotsiin jatkoi diplomaattina ja osallistui kolmihenkiseen Pietarin-lähetystöön vuonna 1742. Kruununperijän ylikamariherra vuodesta 1743. Osallistui valtiopäiville vuosina 1740–1755. Nimitettiin hovikansleriksi ja kansliakollegion jäseneksi vuoden 1747 huhtikuussa ja Taalainmaan kapinaa käsitelleen erityiskomission puheenjohtajaksi saman vuoden lokakuussa. Hovikansleri vuonna 1751, valtioneuvos vuonna 1755, kanslianeuvos vuonna 1761. Vapautettiin viroistaan syyskuussa 1765, mutta palasi valtioneuvostoon toukokuussa 1769."@fi ;
    rdaa:P50118 yso:p105464 ;
    rdaa:P50119 "Forstena, Ruotsi"@fi ;
    rdaa:P50120 "1770" ;
    rdaa:P50121 "1704" ;
    rdaa:P50291 "Hamilton" ;
