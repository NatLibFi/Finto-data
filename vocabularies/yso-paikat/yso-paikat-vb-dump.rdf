  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p192068">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-04-08</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
