  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p169014">
    <dc:source xml:lang="fi">Web-Facta</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-11-04</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p105206"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p105206"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q234"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y44743"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y169014"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Numera kallas Flandern den norra, främst nederländskspråkiga, delen av Belgien. I historisk bemärkelse är Flandern ett landskap mellan Nordsjön och floden Schelde.</skos:note>
    <skos:note xml:lang="fi">Nykyisin Flanderiksi kutsutaan Belgian pohjoista, pääosin hollanninkielistä osaa. Historiallisessa merkityksessä Flanderi on maakunta Pohjanmeren ja Scheldejoen välissä ja käsittää alueen Pohjois-Ranskasta, Belgian Länsi-Flanderin ja Itä-Flanderin provinssit sekä osan Alankomaiden Zeelandista. Flanderi yhdistettiin v. 1814 Alankomaihin. Vuonna 1830 osa Flanderista joutui Belgialle.</skos:note>
    <skos:prefLabel xml:lang="fi">Flanderi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Flandern</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p104968"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105190"/>
  </skos:Concept>
