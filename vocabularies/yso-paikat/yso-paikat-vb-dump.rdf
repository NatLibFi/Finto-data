  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p118301">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2002-03-15</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-17T11:11:49</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94111"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94111"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q37024"/>
