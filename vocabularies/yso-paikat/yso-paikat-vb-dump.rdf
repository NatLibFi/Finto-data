    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q62646"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y30645"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y111744"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Germania on nimitys, jota roomalaiset käyttivät germaanien  asuttamasta, pohjoisessa Pohjanmereen ja Itämereen ulottuvasta Reinin ja Veikselin välissä olevasta alueesta ja sen  roomalaisista provinsseista</skos:note>
    <skos:note xml:lang="sv">Romarnas namn på det av germanska stammar bebodda Nordeuropa, såväl det underkuvade området längs Rhengränsen som "det fria G." ö. därom</skos:note>
    <skos:prefLabel xml:lang="fi">Germania</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Germanien</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105087"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p111745">
    <dc:source xml:lang="fi">Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Lääni (2009)</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1999-01-14</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94426"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94426"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10899572"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q194073"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y31848"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y111745"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Itä-Suomen lääni perustettiin 1.9.1997. Lääni muodostuu entisestä Kuopion läänistä, Mikkelin läänistä ja Pohjois-Karjalan läänistä. Itä-Suomen lääni lakkautettiin 31.12.2009 valtion aluehallintouudistuksen yhteydessä. Aluehallintovirastot (AVI) ja elinkeino- liikenne- ja ympäristökeskukset (ELY) hoitavat 1.1.2010 alkaen alueilla tehtäviä, joita tähän asti ovat hoitaneet lääninhallitukset, TE-keskukset, alueelliset ympäristökeskukset, ympäristölupavirastot, tiepiirit ja työsuojelupiirien työsuojelutoimistot</skos:note>
    <skos:note xml:lang="sv">Östra Finlands län grundades 1.9.1997. Det utgörs av f.d. Kuopio län, S:t Michels län och Norra Karelens län</skos:note>
    <skos:prefLabel xml:lang="fi">Itä-Suomen lääni</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Östra Finlands län</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105068"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105094"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105095"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94161"/>
  </skos:Concept>
