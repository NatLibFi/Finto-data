  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p113324">
    <dc:source xml:lang="fi">Otavan suuri ensyklopedia (s. 2119-2120); Nimitoimisto (Saara Welin 20.11.00)</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2000-11-20</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
