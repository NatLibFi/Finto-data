  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p106977">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1993-02-03</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-12T11:27:40</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94339"/>
    <skos:altLabel xml:lang="sv">Ackas kommun</skos:altLabel>
    <skos:altLabel xml:lang="fi">Akaan kunta</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94339"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q413747"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y52234"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y106977"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso-update/"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Ackas kommun upphörde 1.1.1946, då dess kyrkby bildade den självständiga köpingen Toijala. De övriga delarna av kommunen sammanslogs med Kylmäkoski, Viiala och Sääksmäki.</skos:note>
    <skos:note xml:lang="fi">Akaan kunta lakkautettiin 1.1.1946, jolloin sen kirkonkylästä muodostettiin itsenäinen Toijalan kauppala. Muu osa kunnasta liitettiin Kylmäkoskeen, Viialaan ja Sääksmäkeen.</skos:note>
    <skos:prefLabel xml:lang="sv">Ackas (kommun)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Akaa (kunta)</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p106983"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p215781"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94432"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94444"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94485"/>
    <skos:scopeNote xml:lang="sv">Använd begreppet [http://www.yso.fi/onto/yso/p215781] om staden Ackas som grundades 2007 avses.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tarkoitettaessa vuonna 2007 perustettua Akaan kaupunkia käytetään käsitettä [http://www.yso.fi/onto/yso/p215781].</skos:scopeNote>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p106983">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1993-02-03</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-15T13:17:39</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94339"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94339"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q1641581"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y32695"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y106983"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Ackas uppdelades 1.1.1946 mellan Toijala, Kylmäkoski, Sääksmäki och Viiala. Toijala och Viiala sammanslogs till staden Ackas 1.1.2007. Kylmäkoski sammanslogs med Ackas 1.1.2011.</skos:note>
    <skos:note xml:lang="fi">Akaan kunta jaettiin 1.1.1946 Toijalan, Kylmäkosken, Sääksmäen ja Viialan kesken. Toijala ja Viiala liitettiin yhteen Akaa-nimiseksi kaupungiksi 1.1.2007. Kylmäkoski liitettiin 1.1.2011 Akaan kaupunkiin.</skos:note>
    <skos:prefLabel xml:lang="sv">Kylmäkoski (kommun)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kylmäkoski (kunta)</skos:prefLabel>
