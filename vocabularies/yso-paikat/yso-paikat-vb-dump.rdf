    <skos:note xml:lang="sv">Ö i Finska viken, som avträddes till Sovjetunionen. Fr.o.m. år 1904 var Lövskär en självständig kommun. </skos:note>
    <skos:prefLabel xml:lang="fi">Lavansaari</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Lövskär (Finska viken)</skos:prefLabel>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
