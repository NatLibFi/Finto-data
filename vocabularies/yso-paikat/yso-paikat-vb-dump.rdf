  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p149420">
    <dc:source xml:lang="fi">Web-Facta; Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-12-04</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:altLabel xml:lang="fi">Ottomaanien imperiumi</skos:altLabel>
    <skos:altLabel xml:lang="fi">Ottomaanien valtakunta</skos:altLabel>
    <skos:altLabel xml:lang="sv">Ottomanska riket</skos:altLabel>
    <skos:altLabel xml:lang="fi">Turkin sulttaanikunta</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q12560"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y34489"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y149420"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Benämning på den turkiska statsbildning som uppkom ca 1300 i n.v. Mindre Asien med den osmanska stammen som kärna och som 1923 ersattes av den turkiska republiken</skos:note>
    <skos:note xml:lang="fi">Turkkilaisten 1300-luvulla perustama, 1922 hajonnut sulttaanivaltakunta. Turkkilaiset osmanit olivat muslimeja, mutta valtakuntaan kuului monia kansoja jotka saivat säilyttää oman kulttuurinsa ja uskontonsa. Valtakunnan hajottua siitä jäi jäljelle nykyinen Turkki</skos:note>
    <skos:prefLabel xml:lang="fi">Osmanien valtakunta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Osmanska riket</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105573"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p149458">
    <dc:source xml:lang="fi">Web-Facta</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-12-05</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:altLabel xml:lang="sv">Konungariket Jerusalem</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q55502"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y44802"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y149458"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Ristiretkeläisten v. 1099 perustama valtio, joka käsitti laajimmillaan Palestiinan, Tripoliin, Antiokian ja Edessan ja joka hajosi lopullisesti v. 1291 kristittyjen menetettyä Akkan</skos:note>
    <skos:note xml:lang="sv">Stat grundad av korstågsfararna år 1099. När staten var som störst omfattade den Palestina, Tripoli, Antiokia och Edessa, men den upplöstes efter att de kristna år 1291 förlorat Akko.</skos:note>
    <skos:prefLabel xml:lang="fi">Jerusalemin kuningaskunta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Kungariket Jerusalem</skos:prefLabel>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p149464">
    <dc:source xml:lang="fi">Wikipedia (espanjankielinen)</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-12-05</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p105209"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p105209"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q123559"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y38114"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y149464"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">På 700-talet skapade morerna ett stort muslimskt rike i det som i dag är Spanien och Portugal. Det kallades al-Andalus och senare även kalifatet i Cordoba.</skos:note>
    <skos:note xml:lang="fi">Tarkoittaa muslimien v. 711-1492 hallitsemaa aluetta Iberian niemimaalla. Al-Andalusin alue vaihteli eri aikoina, kattaen laajimmillaan lähes koko niemimaan Almeriaa, Malagaa ja Granadaa lukuunottamatta. Al-Andalus oli vain lyhyitä aikoja suunnilleen sama kuin nykyinen Andalusia</skos:note>
    <skos:prefLabel xml:lang="fi">Al-Andalus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">al-Andalus</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p149659">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-12-15</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:altLabel xml:lang="fi">Kannas</skos:altLabel>
    <skos:altLabel xml:lang="fi">Karjalan kannas</skos:altLabel>
    <skos:altLabel xml:lang="sv">Näset (Karelska näset)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q209010"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y34135"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y149659"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso-update/"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Naturgeografiskt område som åtskiljer Ladoga och Finska viken. Näset avgränsas i sydost av Neva och nordvästgränsen går från Viborgska viken till viken längst i väster i Ladoga.</skos:note>
    <skos:note xml:lang="fi">Tarkoittaa luonnonmaantieteellistä aluetta, joka erottaa Laatokan ja Suomenlahden toisistaan. Kannaksen kaakkoisraja on Neva ja luoteisraja kulkee Viipurinlahdesta Laatokan läntisimpään lahteen.</skos:note>
    <skos:prefLabel xml:lang="sv">Karelska näset</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Karjalankannas</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94192"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
