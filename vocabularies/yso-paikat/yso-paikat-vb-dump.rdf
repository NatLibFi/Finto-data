    <skos:note xml:lang="fi">Tarkoitettaessa kylää Uudellakirkolla käytä muotoa Kaukjärvi (Uusikirkko Vpl. : kylä). Tarkoitettaessa järveä Uudellakirkolla käytä muotoa Kaukjärvi (Uusikirkko Vpl. : järvi)</skos:note>
    <skos:prefLabel xml:lang="sv">Kaukjärvi (Nykyrka : by)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kaukjärvi (Uusikirkko Vpl. : kylä)</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p215999"/>
  </skos:Concept>
