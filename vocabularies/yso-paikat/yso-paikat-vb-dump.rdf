  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p166824">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-07-14</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94383"/>
    <skos:altLabel xml:lang="fi">Korkearannikko</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94383"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q849273"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y38144"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y166824"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Kustområde i Bottniska viken i Västernorrlands län i Sverige. Höga kusten uppfördes år 2000 på UNESCOs lista över världsarv.</skos:note>
    <skos:note xml:lang="fi">Pohjanlahden rannikkoalue Länsi-Norlannin läänissä Ruotsissa. Korkea rannikko hyväksyttiin UNESCOn maailmanperintökohteeksi vuonna 2000</skos:note>
    <skos:prefLabel xml:lang="sv">Höga kusten</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Korkea rannikko</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p166825">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-07-14</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94344"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94344"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q13257169"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y44943"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y166825"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Heinäkuussa v. 2006 Merenkurkun saaristo hyväksyttiin UNESCOn maailmanperintöluetteloon Suomen ensimmäisenä luontokohteena. Alue lisättiin maailmanperintölistalle aiemmin listalla olleen Ruotsin Korkea rannikon laajennuksena.</skos:note>
    <skos:note xml:lang="sv">Skärgårdsområde som godkändes som naturobjekt på Unescos världsarvslista år 2006.</skos:note>
    <skos:prefLabel xml:lang="sv">Kvarkens skärgård</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Merenkurkun saaristo</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105848"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p166876">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-07-16</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q11888758"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y45527"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y166876"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Historiskt förvaltningsområde som omfattade Nylands östra del, känt sedan 1400-talet. År 1620 sammanslogs det med Nylands och Tavastehus län.</skos:note>
    <skos:note xml:lang="fi">Uudenmaan maakunnan itäisen puoliskon käsittänyt Suomen paikallishallintoalue, joka tunnetaan jo 1400-luvulla. Porvoon linnalääni oli Viipurin linnan alaisena voutikuntana 1500-luvun alussa, jolloin siihen kuuluivat Helsingin, Sipoon, Porvoon, Pernajan ja Pyhtään pitäjät. Ennen vuonna 1619 tapahtunutta Turun linnalääniin liittämistä sen rajoja muutettiin useaan kertaan. Vuonna 1620 se yhdistettiin Hämeen ja Uudenmaan lääniin.</skos:note>
    <skos:prefLabel xml:lang="sv">Borgå län</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Porvoon lääni</skos:prefLabel>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
