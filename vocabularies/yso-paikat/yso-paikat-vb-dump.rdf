    <skos:altLabel xml:lang="fi">Riilahti (Bromarv)</skos:altLabel>
    <skos:altLabel xml:lang="sv">Rilax (Bromarv)</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p163327"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10312055"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y48047"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y168422"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Bromarv liitetty 1.1.1977 Tenholaan ja Hankoon; Tenhola liitetty 1.1.1993 Tammisaareen. Karjaa, Pohja ja Tammisaari liitettiin yhteen Raasepori-nimiseksi kaupungiksi 1.1.2009.</skos:note>
    <skos:note xml:lang="sv">Bromarv sammanslogs med Tenala och Hangö 1.1.1977. Tenala sammanslogs med Ekenäs 1.1.1993. Karis, Pojo och Ekenäs sammanslogs till staden Raseborg 1.1.2009.</skos:note>
    <skos:prefLabel xml:lang="fi">Riilahti (Raasepori)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Rilax (Raseborg)</skos:prefLabel>
