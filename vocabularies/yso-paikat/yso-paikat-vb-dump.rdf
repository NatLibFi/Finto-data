  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p107592">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1993-06-08</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-15T14:54:35</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94111"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94111"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q403"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y32559"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y107592"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Jugoslavia hajosi v. 1991. Serbia ja Montenegro muodostivat v. 1992 Jugoslavian liittotasavallan, ns. Tynkä-Jugoslavian.  Jugoslavian nimi muuttui Serbia ja Montenegroksi 14.3.2002, jolloin Serbia ja Montenegro allekirjoittivat valtioliittosopimuksen. 21. toukokuuta 2006 järjestetyssä kansanäänestyksessä enemmistö kannatti Montenegron itsenäistymistä ja valtio julistautui itsenäiseksi 3. kesäkuuta 2006.  Euroopan unioni tunnusti Montenegron 12. kesäkuuta ja Serbian 15. kesäkuuta 2006. Montenegrosta tuli Yhdistyneiden kansakuntien 192. jäsen 28. kesäkuuta 2006. Kosovo julistautui itsenäiseksi 17. helmikuuta 2008</skos:note>
    <skos:note xml:lang="sv">Jugoslavien upplöstes 1991. Serbien och Montenegro bildade Förbundsrepubiken Jugoslavien, som blev FN-medlem 1.11.2000 ; namnet ändrades till Serbien och Montenegro 14.3.2002, då ett avtal om statsförbund undertecknades.</skos:note>
    <skos:prefLabel xml:lang="fi">Serbia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Serbien</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105202"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p112712"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p118301"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p120572"/>
  </skos:Concept>
