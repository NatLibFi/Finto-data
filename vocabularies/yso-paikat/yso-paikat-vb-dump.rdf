  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p94395">
    <dc:source xml:lang="fi">Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Kunta, maaseutu</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1991-10-29</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-09T12:29:07</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94256"/>
    <skos:altLabel xml:lang="sv">Kuolajärvi (kommun)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kuolajärvi (kunta)</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94256"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10575941"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q936067"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y33958"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y94395"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso-update/"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Kommunens namn var Kuolajärvi fram till år 1936. I kommunen fanns också en by med namnet Kuolajärvi, som hörde till området som överläts till Sovjetunionen.</skos:note>
    <skos:note xml:lang="fi">Vuoteen 1936 asti kunnan nimi oli Kuolajärvi. Kuolajärvellä ja Sallassa oli myös Kuolajärvi-niminen kylä, joka jäi Neuvostoliitolle luovutetulle alueelle.</skos:note>
    <skos:prefLabel xml:lang="fi">Salla</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Salla</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p508970"/>
  </skos:Concept>
