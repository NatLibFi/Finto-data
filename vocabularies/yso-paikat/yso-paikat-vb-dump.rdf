    <skos:altLabel xml:lang="fi">Pargas</skos:altLabel>
    <skos:altLabel xml:lang="sv">Väståboland</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94476"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10295052"/>
