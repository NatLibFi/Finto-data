    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y94474"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Helsinge socken ändrades till Helsinge 1865. Helsinge ändrades till Vanda 1.1.1972</skos:note>
    <skos:note xml:lang="fi">Helsingin pitäjä muuttui Helsingin maalaiskunnaksi v. 1865. Helsingin maalaiskunta muuttui vuonna 1972 Vantaan kauppalaksi. Vuonna 1974 Vantaan kauppala muuttui Vantaan kaupungiksi.</skos:note>
