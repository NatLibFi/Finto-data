    <skos:note xml:lang="fi">Vöyri ja Maksamaa yhdistetty 1.1.2007 yhdeksi kunnaksi nimeltä Vöyri-Maksamaa. Oravainen liitetty 1.1.2011 Vöyriin ja samalla Vöyri-Maksamaan nimi muutettiin Vöyriksi</skos:note>
    <skos:prefLabel xml:lang="sv">Vörå</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Vöyri</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p150235"/>
  </skos:Concept>
