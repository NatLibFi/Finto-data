  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p504798">
    <dc:source xml:lang="fi">Wikidata</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-03-24</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q80338"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y51411"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y504798"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Alue Bengalinlahden pohjukassa. Nykyään Bengali jakaantuu hallinnollisesti Bangladeshin valtioon ja Intian Länsi-Bengalin osavaltioon. Aikaisemmin brittiläisen Intian provinssi (1757-1947), sitä ennen osa Suurmogulien valtakuntaa, 1352-1576 itsenäinen sulttaanikunta. Nykyisen Bangladeshin alue oli vuosina 1947-1971 osa Pakistania ensin nimellä Itä-Bengali, myöhemmin Itä-Pakistan.</skos:note>
    <skos:note xml:lang="sv">Historiskt landområde i norra delen av Indiska halvön, i dag delat mellan den indiska delstaten Västbengalen och Bangladesh.</skos:note>
    <skos:prefLabel xml:lang="sv">Bengalen</skos:prefLabel>
