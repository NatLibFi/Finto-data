  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p196807">
    <dc:source xml:lang="fi">Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Kylä, kaupunginosa tai kulmakunta</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-01-16</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-28</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94181"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94181"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10266913"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q11883963"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y48935"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y196807"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">By som ursprungligen hette Uusikylä och hörde till Paltamo, tills den anslöts till Kajana landskommun år 1954. Byns namn ändrades till Nakertaja år 1957. Kajana landskommun sammanslogs med Kajana stad 1.1.1977.</skos:note>
    <skos:note xml:lang="fi">Kylä kuului Uusikylä-nimisenä alun perin Paltamoon, kunnes se liitettiin Kajaanin maalaiskuntaan vuonna 1954. Kylän nimi vaihtui Nakertajaksi vuonna 1957. Kajaanin maalaiskunta liitetty 1.1.1977 Kajaanin kaupunkiin</skos:note>
    <skos:prefLabel xml:lang="fi">Nakertaja (Kajaani)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Nakertaja (Kajana)</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p208559"/>
  </skos:Concept>
