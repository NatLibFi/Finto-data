    <skos:altLabel xml:lang="fi">Utö</skos:altLabel>
    <skos:altLabel xml:lang="sv">Utö</skos:altLabel>
    <skos:altLabel xml:lang="sv">Utö (Korpo)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Utö (Korppoo)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Utö (Länsi-Turunmaa)</skos:altLabel>
    <skos:altLabel xml:lang="sv">Utö (Väståboland)</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94327"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10310752"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q194522"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y49091"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y200170"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Utö oli kylä, saari ja majakka Korppoossa. Korppoo ja joukko muita kuntia liitettiin yhteen Länsi-Turunmaa-nimiseksi kaupungiksi 1.1.2009. Länsi-Turunmaan nimi muutettiin Paraiseksi 1.1.2012</skos:note>
    <skos:note xml:lang="sv">Utö var en by, en ö och en fyr i Korpo. Korpo och några andra kommuner sammanslogs till staden Väståboland 1.1.2009. Väståboland bytte namn till Pargas 1.1.2012.</skos:note>
    <skos:prefLabel xml:lang="fi">Utö (Parainen)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Utö (Pargas)</skos:prefLabel>
  </skos:Concept>
