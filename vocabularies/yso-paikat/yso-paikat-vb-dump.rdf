  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p192125">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-04-09</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-18T12:40:59</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94256"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94256"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q18660802"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y49052"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y192125"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Finsk benämning på område som omfattar den sydvästra delen av Lapplands landskap vid Bottenhavets kust, området mellan Norra Österbotten och Sverige, och samma som Kemi-Torneå ekonomiska region, alltså kommunerna Kemi, Keminmaa, Simo, Tervola och Torneå.</skos:note>
    <skos:note xml:lang="fi">Meri-Lappi on Perämeren rannikolla oleva Lapin maakunnan lounaisosa, Pohjois-Pohjanmaan ja Ruotsin välissä oleva alue ja sama kuin Kemi-Tornion seutukunta eli käsittää kunnat Kemi, Keminmaa, Simo, Tervola ja Tornio</skos:note>
    <skos:prefLabel xml:lang="sv">Havslappland</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Meri-Lappi</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p119952"/>
  </skos:Concept>
