    <skos:note xml:lang="fi">Historiallinen maakunta Tiszan, Tonavan, Muresjoen ja Etelä-Karpaattien välissä. Trianonin ja Sèvresin sopimuksilla 1920 Romania, Unkari ja Jugoslavia (nyk. Serbia) saivat kukin osan Baanaattia</skos:note>
    <skos:note xml:lang="sv">Historiskt landskap beläget mellan Tisza, Donau, Mureș och Sydkarpaterna. Genom fördragen i Trianon och Sèvres 1920 fick Rumänien, Ungern och Jugoslavien (nuvarande Serbien) vardera en del av Banatet.</skos:note>
    <skos:prefLabel xml:lang="fi">Baanaatti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Banatet</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105029"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105030"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105202"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p107592"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
