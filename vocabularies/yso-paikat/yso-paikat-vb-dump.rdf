  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p201435">
    <dc:source xml:lang="fi">Hakulinen, Kerkko: Paikannimet (2006); Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-12-16</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <rdau:P60686 rdf:resource="http://www.yso.fi/onto/yso/p105092"/>
    <skos:altLabel xml:lang="fi">Saksan Lounais-Afrikka</skos:altLabel>
    <skos:altLabel xml:lang="sv">Tyska Sydvästafrika</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q153665"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y49678"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y201435"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Lounais-Afrikka oli Saksan keisarikunnan siirtomaa vuodesta 1884 vuoteen 1915, myöhemmin Etelä-Afrikan hallussaan pitämä alue, virallisesti Namibia vuodesta 1968.</skos:note>
    <skos:note xml:lang="sv">Tyska Sydvästafrika var åren 1884–1915 en tysk koloni motsvarande ungefär nuvarande Namibia. Därefter kontrollerades området av Sydafrika och kallades Sydvästafrika. Fr.o.m. år 1968 började landet kallas Namibia.</skos:note>
    <skos:prefLabel xml:lang="fi">Lounais-Afrikka</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Sydvästafrika</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105098"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
