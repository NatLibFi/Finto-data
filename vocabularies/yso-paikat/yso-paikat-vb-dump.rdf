  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p110631">
    <dc:source xml:lang="fi">Kielikello 2/1998</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1997-10-01</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-19T11:04:16</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94080"/>
    <skos:altLabel xml:lang="fi">Belgian Kongo</skos:altLabel>
    <skos:altLabel xml:lang="sv">Belgiska Kongo</skos:altLabel>
    <skos:altLabel xml:lang="sv">Demokratiska republiken Kongo</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kinshasan Kongo</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kongo (Kongon demokraattinen tasavalta)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kongo-Kinshasa</skos:altLabel>
    <skos:altLabel xml:lang="sv">Kongo-Kinshasa</skos:altLabel>
    <skos:altLabel xml:lang="fi">Zaire</skos:altLabel>
    <skos:altLabel xml:lang="sv">Zaire</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94080"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q974"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y32468"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y110631"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso-update/"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Ennen itsenäistymistään v. 1960 maa oli nimeltään Belgian Kongo, 1885-1908 Kongon vapaavaltio. Itsenäistyttyään valtio oli ensin nimeltään Kongon tasavalta, myöhemmin Zaire, ja vuodesta 1997 eteenpäin se on tunnettu nykyisellä nimellä. </skos:note>
    <skos:note xml:lang="sv">Före sin självständighet år 1960 hette landet Belgiska kongo, åren 1885-1908 Kongostaten. Åren 1971-1998 hette staten också Zaire.</skos:note>
    <skos:prefLabel xml:lang="sv">Kongo (Kinshasa)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kongon demokraattinen tasavalta</skos:prefLabel>
  </skos:Concept>
