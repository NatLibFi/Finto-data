    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Fors i Imatra. Om stadsdelen i Imatra avses används formen Vallinkoski (Imatra : by).</skos:note>
    <skos:note xml:lang="fi">Vallinkoski oli  luonnonmukaisena vuoteen 1944 asti virrannut koski Vuoksessa Imatralla. Sittemmin sen teho on hyödynnetty Neuvostoliiton/Venäjän puolella olevassa Enson (Svetogorsk) voimalaitoksessa. Tarkoitettaessa Vallinkoski-nimistä kaupunginosaa Imatralla käytä muotoa Vallinkoski (Imatra : kylä).</skos:note>
    <skos:prefLabel xml:lang="sv">Vallinkoski (Imatra : fors)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Vallinkoski (Imatra : koski)</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p203003"/>
  </skos:Concept>
