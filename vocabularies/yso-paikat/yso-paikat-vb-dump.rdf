    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y30644"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y111743"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Gallia on roomalaisten antama nimi nykyisen Pohjois-Italian ja Ranskan alueelle, jonka kelttiläisistä asukkaista käytettiin nimitystä gallialaiset</skos:note>
    <skos:note xml:lang="sv">Under antiken romersk benämning på områden bebodda av kelter (lat. galli) i nuv. Norditalien, Frankrike och Belgien</skos:note>
    <skos:prefLabel xml:lang="fi">Gallia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Gallien</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p111744">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1999-01-14</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p105081"/>
