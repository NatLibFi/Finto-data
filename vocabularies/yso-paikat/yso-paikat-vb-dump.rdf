    <skos:altLabel xml:lang="fi">Vanda</skos:altLabel>
    <skos:altLabel xml:lang="fi">Vantaan kauppala</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94465"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10013069"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q127623"/>
