  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p192353">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-04-22</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-10T15:35:13</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94465"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94465"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q673425"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y48777"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y192353"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Helsingin seutu (ruots. Helsingforsregionen) on 1,37 milj. asukkaan kasvukeskus ja metropolialue. Helsingin seutu koostuu pääkaupunkiseudun kunnista, jotka ovat Helsinki, Espoo, Vantaa ja Kauniainen sekä kehyskunnista Hyvinkää, Järvenpää, Kerava, Kirkkonummi, Nurmijärvi, Sipoo, Tuusula ja Vihti, joskus myös Mäntsälä ja Pornainen. Katso myös Helsingin seutukunta</skos:note>
    <skos:note xml:lang="sv">Metropolområde  och tillväxtcentrum bestående av huvudstadsregionens kommuner, vilka är Helsingfors, Esbo, Vanda, Grankulla, samt kranskommunerna Hyvinge, Träskända, Kervo, Kyrkslätt, Nurmijärvi, Sibbo, Tusby, Vichtis, ibland även Mäntsälä och Borgnäs. Se även Helsingfors ekonomiska region.</skos:note>
    <skos:prefLabel xml:lang="sv">Helsingforsregionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Helsingin seutu</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p165250"/>
  </skos:Concept>
