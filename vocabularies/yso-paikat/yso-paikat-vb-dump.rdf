  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p196118">
    <dc:source xml:lang="fi">Hakulinen, Kerkko, Pariisista Papukaijannokkaan; Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-12-04</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-10-16</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p106039"/>
    <skos:altLabel xml:lang="sv">Norra Cypern</skos:altLabel>
    <skos:altLabel xml:lang="sv">Turkiska republiken Norra Cypern</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p106039"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q23681"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y49137"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y196118"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Förvaltningsdistrikt på Cypern som även utropat sig till självständig stat år 1983, vilket dock endast Turkiet har godkänt.</skos:note>
    <skos:note xml:lang="fi">Hallintoalue Kyproksella. Julistautunut itsenäiseksi Pohjois-Kyproksen turkkilaiseksi tasavallaksi vuonna 1983, mutta valtion on tunnustanut vain Turkki</skos:note>
    <skos:prefLabel xml:lang="sv">Nordcypern</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Pohjois-Kypros</skos:prefLabel>
  </skos:Concept>
