    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Sauvonjoki eli Poutajoki saa alkunsa useammasta pienestä ojasta, jotka yhdistyvät Paimion Kevolan alueella; joki laskee mereen Sauvonlahden kautta Eistilänlahdessa.</skos:note>
    <skos:note xml:lang="sv">Sauvonjoki eller Poutajoki får sin början av flere små diken som sammanstrålar i Pemar, Kevola ; ån rinner ut i havet i Eistiläviken.</skos:note>
    <skos:prefLabel xml:lang="fi">Sauvonjoki</skos:prefLabel>
