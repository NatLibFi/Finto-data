    <skos:altLabel xml:lang="sv">Pyhäjärvi Ol.</skos:altLabel>
    <skos:altLabel xml:lang="fi">Pyhäsalmi</skos:altLabel>
    <skos:altLabel xml:lang="sv">Pyhäsalmi</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94346"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10168912"/>
