  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p197138">
    <dc:source xml:lang="fi">Nenonen, Kaisu-Maija, Historian suursanakirja; Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-02-21</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:altLabel xml:lang="sv">Viborgs guvernement</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q2487972"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y49297"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y197138"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Benämning på det s.k. Gamla Finlands område som hörde till Ryssland 1743-1783. Efter freden i Åbo 1743 bildades Viborgs guvernement som en administrativ helhet av Viborg, Kexholm och Kymmenegårds provinser.</skos:note>
    <skos:note xml:lang="fi">Venäjän valtaan kuuluneesta ns. Vanhan Suomen alueesta 1743-1783 käytetty nimitys. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus Viipurin kuvernementti.</skos:note>
    <skos:prefLabel xml:lang="sv">Viborgska guvernementet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Viipurin kuvernementti</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p197139"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p197140"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94473"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p197139">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-02-21</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-10T09:08:27</dct:modified>
    <skos:altLabel xml:lang="sv">Viborgs provins</skos:altLabel>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y49296"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y197139"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Uudenkaupungin rauhassa 1721 siirtyivät Käkisalmen läänin etelä- ja keskiosat sekä pääosa Viipurin läänistä Venäjän haltuun. Alue muodosti hallinnollisesti Pietarin kuvernementtiin kuuluneen Viipurin ja Käkisalmen provinssin. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus, Viipurin kuvernementti.</skos:note>
    <skos:prefLabel xml:lang="sv">Viborgska provinsen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Viipurin provinssi</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p197138"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p197140">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-02-21</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-01-02T15:09:53</dct:modified>
    <skos:altLabel xml:lang="sv">Keksholms provins</skos:altLabel>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y48961"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y197140"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Uudenkaupungin rauhassa 1721 siirtyivät Käkisalmen läänin etelä- ja keskiosat sekä pääosa Viipurin läänistä Venäjän haltuun. Alue muodosti hallinnollisesti Pietarin kuvernementtiin kuuluneen Viipurin ja Käkisalmen provinssin. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus, Viipurin kuvernementti.</skos:note>
    <skos:note xml:lang="sv">Vid freden i Nystad 1721 blev de södra och mellersta delarna av Kexholms län samt huvuddelen av Viborgs län en del av Ryssland. Området bildade förvaltningsmässigt Viborgs och Kexholms provins, som tillhörde guvernementet Sankt Petersburg. Efter freden i Åbo 1743 bildades av Viborgs, Kexholms och Kymmenegårds provinser en förvaltningsmässig helhet, Viborgs guvernement.</skos:note>
    <skos:prefLabel xml:lang="sv">Kexholms provins</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Käkisalmen provinssi</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p197138"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
