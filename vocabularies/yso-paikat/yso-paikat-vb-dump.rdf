  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p167802">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-10</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q106955"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y44766"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y167802"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Område i Kaukasien. Administrativt är Ossetien uppdelat i Nordossetien-Alanien som hör till Ryska federationen och Sydossetien som officiellt tillhör Georgien, men de facto är självständigt.</skos:note>
    <skos:note xml:lang="fi">Ossetia on alue Kaukasuksella. Hallinollisesti Ossetia on jaettu Venäjän federaatioon kuuluvaan Pohjois-Ossetia-Alanian tasavaltaan sekä virallisesti Georgiaan kuuluvaan, mutta de facto itsenäiseen Etelä-Ossetiaan</skos:note>
    <skos:prefLabel xml:lang="fi">Ossetia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Ossetien</skos:prefLabel>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p167803">
    <dc:source xml:lang="fi">Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-09-10</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p106264"/>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p167802"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p106264"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p167802"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q23427"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y44768"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y167803"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Etelä-Ossetia on alue Kaukasiassa. Se on julistautunut itsenäiseksi nimellä Etelä-Ossetian tasavalta. YK:n jäsenvaltioista vain Venäjä ja Nicaragua ovat tunnustaneet sen itsenäisyyden (tilanne syyskuussa 2009)</skos:note>
    <skos:note xml:lang="sv">Område i Kaukasien, som förklarat sig självständigt med namnet Republiken Sydossetien.</skos:note>
    <skos:prefLabel xml:lang="fi">Etelä-Ossetia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Sydossetien</skos:prefLabel>
  </skos:Concept>
