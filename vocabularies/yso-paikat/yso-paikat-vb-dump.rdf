  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p106280">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1992-07-08</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:altLabel xml:lang="fi">Länsipohja (Västerbotten)</skos:altLabel>
    <skos:altLabel xml:lang="sv">Västerbotten (landskap)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Västerbotten (maakunta)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q211652"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y32936"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y106280"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso-update/"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Historiskt landskap i Sverige-Finland, samt nutida landskap i Sverige. Västerbotten kallas också området på bägge sidor om Torne älv och Muonio älv, med i huvudsak finskspråkig befolkning, i finska Lappland och svenska Norrbotten.</skos:note>
    <skos:note xml:lang="fi">Ruotsi-Suomen historiallinen maakunta sekä Ruotsin nykyinen maakunta. Länsipohjaksi kutsutaan myös Tornionjoen ja Muonionjoen molemmin puolin olevaa, äidinkieleltään kokonaan tai pääasiallisesti suomenkielisen väestön asuttamaa aluetta Suomen Lapissa ja Ruotsin Norrbottenissa.</skos:note>
    <skos:prefLabel xml:lang="fi">Västerbotten</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Västerbotten</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p508705"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
