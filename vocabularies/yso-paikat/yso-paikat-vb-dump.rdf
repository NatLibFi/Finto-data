  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p94473">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1990-05-16</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q440068"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y34787"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y94473"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="sv">Gamla Finland, även Ryska Finland eller Viborgska guvernementet, de delar av Finland som avträddes till Ryssland genom frederna i Nystad 1721 och Åbo 1743. Området returnerades till Finland 1812 och bildade då Viborgs län.</skos:note>
    <skos:note xml:lang="fi">Tarkoittaa niitä Kaakkois-Suomen alueita, jotka Venäjä sai Ruotsi-Suomelta Uudenkaupungin rauhassa 1721 ja Turun rauhassa 1743. Alue palautettiin muun Suomen yhteyteen 1812 ja siitä muodostettiin uusi Viipurin lääni. Vanhan Suomen alueesta käytettiin 1743-1783 nimitystä Viipurin kuvernementti.</skos:note>
    <skos:prefLabel xml:lang="sv">Gamla Finland</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Vanha Suomi</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p107950"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p197138"/>
    <skos:topConceptOf rdf:resource="http://www.yso.fi/onto/yso/places"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p94474">
    <dc:source xml:lang="fi">Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Kunta, kaupunki</dc:source>
