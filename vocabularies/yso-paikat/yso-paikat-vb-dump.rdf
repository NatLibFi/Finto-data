  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p110633">
    <dc:source xml:lang="fi">Kielikello 2/1998</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1997-10-01</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-02-19T11:18:36</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94080"/>
    <skos:altLabel xml:lang="fi">Brazzavillen Kongo</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kongo (Kongon tasavalta)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kongo-Brazzaville</skos:altLabel>
    <skos:altLabel xml:lang="sv">Kongo-Brazzaville</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kongon kansantasavalta</skos:altLabel>
    <skos:altLabel xml:lang="sv">Republiken Kongo</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94080"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q971"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y32466"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y110633"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso-update/"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Kongon tasavalta itsenäistyi vuonna 1960. Sitä ennen alue kuului ensin Ranskan Kongona ja myöhemmin Ranskan Keski-Afrikkana tunnettuun siirtomaa-alueeseen, johon sisältyivät lisäksi nykyisen Gabonin ja Keski-Afrikan tasavallan sekä myöhemmin myös Tsadin alueet.</skos:note>
    <skos:note xml:lang="sv">Republiken Kongo blev självständig år 1960. Före det hörde området till ett kolonialområde först känt som Franska Kongo och senare som Franska Ekvatorialafrika, i vilket även områden i nuvarande Gabon och Centralafrikanska republiken samt senare också Tchad ingick.</skos:note>
    <skos:prefLabel xml:lang="sv">Kongo (Brazzaville)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kongon tasavalta</skos:prefLabel>
  </skos:Concept>
