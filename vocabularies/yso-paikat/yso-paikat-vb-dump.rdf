  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p168591">
    <dc:source xml:lang="fi">Web-Facta; Wikipedia</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2009-10-15</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-10T13:52:22</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p105573"/>
    <skos:altLabel xml:lang="fi">Nikaia</skos:altLabel>
    <skos:altLabel xml:lang="sv">Nikaia (Nicaea)</skos:altLabel>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p105573"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q739037"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y44776"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y168591"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso-update/"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Alkujaan kreikkalainen siirtokunta ja kaupunki Vähässä-Aasiassa. Nikea perustettiin noin v. 316 eKr. Kaupungissa pidettiin vuosina 325 ja 787 ekumeeniset kirkolliskokoukset. Nikea oli Nikean keisarikunnan pääkaupunki 1300-luvulle asti, jolloin sen valloittivat turkkilaiset. Nykyään samalla paikalla sijaitsee İznikin kaupunki.</skos:note>
    <skos:note xml:lang="sv">Forntida stad i Mindre Asien, grundad år 316 f.Kr. Numera finns på samma plats staden Iznik.</skos:note>
    <skos:prefLabel xml:lang="sv">Nicaea</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Nikea</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p509077"/>
  </skos:Concept>
