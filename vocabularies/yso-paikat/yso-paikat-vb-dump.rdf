  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p111725">
    <dc:source xml:lang="fi">Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Lääni (2009)</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1999-01-14</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94426"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94426"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10899555"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q192759"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y31158"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y111725"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Länsi-Suomen lääni perustettiin 1.9.1997. Lääni muodostuu entisestä Hämeen läänin pohjoisosasta, Keski-Suomen läänistä, Turun ja Porin läänistä ja Vaasan läänistä. Länsi-Suomen lääni lakkautettiin 31.12.2009 valtion aluehallintouudistuksen yhteydessä. Aluehallintovirastot (AVI) ja elinkeino- liikenne- ja ympäristökeskukset (ELY) hoitavat 1.1.2010 alkaen alueilla tehtäviä, joita tähän asti ovat hoitaneet lääninhallitukset, TE-keskukset, alueelliset ympäristökeskukset, ympäristölupavirastot, tiepiirit ja työsuojelupiirien työsuojelutoimistot</skos:note>
    <skos:note xml:lang="sv">Västra Finlands län grundades 1.9.1997. Det bildades av tidigare Tavastehus läns norra del, Mellersta Finlands län, Åbo och Björneborgs län och Vasa län</skos:note>
    <skos:prefLabel xml:lang="fi">Länsi-Suomen lääni</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Västra Finlands län</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105117"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105120"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105946"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94448"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94467"/>
  </skos:Concept>
  <skos:Concept rdf:about="http://www.yso.fi/onto/yso/p111726">
    <dc:source xml:lang="fi">Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Lääni (2009)</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1999-01-14</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-25</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p94426"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p94426"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10899564"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q188752"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/allars/Y31148"/>
    <skos:exactMatch rdf:resource="http://www.yso.fi/onto/ysa/Y111726"/>
    <skos:inScheme rdf:resource="http://www.yso.fi/onto/yso/places"/>
    <skos:note xml:lang="fi">Etelä-Suomen lääni perustettiin 1.9.1997. Lääni muodostuu entisestä Hämeen läänin eteläosasta, Kymen läänistä ja Uudenmaan läänistä. Lisäksi suurlääniin liitettiin entisestä Mikkelin läänistä Heinola, Sysmä ja Hartola. Etelä-Suomen lääni lakkautettiin 31.12.2009 valtion aluehallintouudistuksen yhteydessä. Aluehallintovirastot (AVI) ja elinkeino- liikenne- ja ympäristökeskukset (ELY) hoitavat 1.1.2010 alkaen alueilla tehtäviä, joita tähän asti ovat hoitaneet lääninhallitukset, TE-keskukset, alueelliset ympäristökeskukset, ympäristölupavirastot, tiepiirit ja työsuojelupiirien työsuojelutoimistot</skos:note>
    <skos:note xml:lang="sv">Södra Finlands län grundades 1.9.1977. Det bildades av  tidigare Tavastehus läns södra del, Kymmene län och Nylands län. Till det nya storlänet anslöts även Heinola, Sysmä och  Gustav Adolfs från tidigare S:t Michels län.</skos:note>
    <skos:prefLabel xml:lang="fi">Etelä-Suomen lääni</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Södra Finlands län</skos:prefLabel>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105108"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105117"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p105917"/>
    <skos:related rdf:resource="http://www.yso.fi/onto/yso/p94460"/>
  </skos:Concept>
