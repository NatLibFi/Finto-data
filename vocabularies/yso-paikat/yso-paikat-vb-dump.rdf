    <skos:altLabel xml:lang="sv">Lasarettsholmen (Uleåborg)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Maaherransaari</skos:altLabel>
    <skos:altLabel xml:lang="fi">Polttimosaari</skos:altLabel>
    <skos:altLabel xml:lang="fi">Rysänsaari</skos:altLabel>
