    <dc:source xml:lang="fi">Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Kylä, kaupunginosa tai kulmakunta</dc:source>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1993-09-13</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-13T15:20:23</dct:modified>
    <iso-thes:broaderPartitive rdf:resource="http://www.yso.fi/onto/yso/p105479"/>
    <skos:broader rdf:resource="http://www.yso.fi/onto/yso/p105479"/>
    <skos:closeMatch rdf:resource="http://paikkatiedot.fi/so/1000772/10622699"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q10706627"/>
