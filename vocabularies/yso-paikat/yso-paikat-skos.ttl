yso:p161556 a skos:Concept ;
    dct:created "2008-10-09"^^xsd:date ;
    dct:modified "2024-09-25"^^xsd:date ;
    skos:altLabel "Raja-Karjala"@fi,
        "Gränskarelen"@sv,
        "Ladoga-Karelen"@sv ;
    skos:closeMatch wd:Q3436524 ;
    skos:exactMatch allars:Y38120,
        ysa:Y161556 ;
    skos:inScheme yso:places ;
    skos:note "Laatokan luoteis-, pohjois- ja koillispuolinen osa, joka kuului ennen talvi- ja jatkosotaa Suomen Karjalaan. Laatokan Karjala alkaa Kurkijoesta ja ulottuu Korpiselän ja Ilomantsin kaakkoisosiin saakka. Laatokan Karjalan itäisintä osaa on kutsuttu Raja-Karjalaksi. Nykyään alue kuuluu Karjalan tasavaltaan."@fi,
        "Området nordväst, norr och nordost om Ladoga som före vinterkriget hörde till Finland. Ladogakarelen börjar från Kurkijoki och sträcker sig till sydöstra delarna av Korpiselkä och Ilomants. Ladogakarelens östligaste del kallas Gränskarelen. Området hör nu till Karelska republiken."@sv ;
    skos:prefLabel "Ladoga Karelia"@en,
        "Laatokan Karjala"@fi,
        "Ladogakarelen"@sv ;
    skos:related yso:p94192 ;
    skos:topConceptOf yso:places ;
    skosxl:prefLabel <http://www.yso.fi/onto/yso/p161556#en> .

