yso:p98845 a skos:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "1987-02-01"^^xsd:date ;
    dct:modified "2024-09-25"^^xsd:date ;
    iso-thes:broaderPartitive yso:p105024,
        yso:p94080,
        yso:p94111 ;
    skos:broader yso:p105024,
        yso:p94080,
        yso:p94111 ;
    skos:closeMatch wd:Q36288 ;
    skos:exactMatch allars:Y25808,
        ysa:Y98845 ;
    skos:inScheme yso:places ;
    skos:note "Joukko yhteenliittyneitä kauppareittejä, jotka kulkivat Aasian halki Kiinan Chang-ansta (nyk. Xian) Syyrian Antiokiaan ja muihin Lähi-idän ja Euroopan kohteisiin. Silkkitien kautta kuljetettiin silkkiä ja muita kauppatavaroita, kuten norsunluuta, kultaa ja jalokiviä pääasiassa karavaaneilla."@fi,
        "Historiskt nätverk handelsvägar som gick genom Asien, från Chang’an (numera Xi’an) till Antiochia i Syrien och andra platser i Mellanöstern och Europa. Via Sidenvägen transporterades silke och andra handelsvaror, såsom elfenben, guld och ädelstenar, i huvudsak med karavaner."@sv ;
    skos:prefLabel "Silk Road"@en,
        "Silkkitie"@fi,
        "Sidenvägen"@sv ;
    skosxl:prefLabel <http://www.yso.fi/onto/yso/p98845#en> .

