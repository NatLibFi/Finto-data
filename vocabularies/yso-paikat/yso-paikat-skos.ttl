    skos:altLabel "Konungariket Jerusalem"@sv ;
    skos:closeMatch wd:Q55502 ;
    skos:exactMatch allars:Y44802,
        ysa:Y149458 ;
    skos:inScheme yso:places ;
    skos:note "Ristiretkeläisten v. 1099 perustama valtio, joka käsitti laajimmillaan Palestiinan, Tripoliin, Antiokian ja Edessan ja joka hajosi lopullisesti v. 1291 kristittyjen menetettyä Akkan"@fi,
        "Stat grundad av korstågsfararna år 1099. När staten var som störst omfattade den Palestina, Tripoli, Antiokia och Edessa, men den upplöstes efter att de kristna år 1291 förlorat Akko."@sv ;
    skos:prefLabel "Kingdom of Jerusalem"@en,
        "Jerusalemin kuningaskunta"@fi,
        "Kungariket Jerusalem"@sv ;
    skos:topConceptOf yso:places ;
    skosxl:prefLabel <http://www.yso.fi/onto/yso/p149458#en> .

