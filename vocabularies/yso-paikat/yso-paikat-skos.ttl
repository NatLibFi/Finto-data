yso:p111726 a skos:Concept ;
    dc:source "Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Lääni (2009)"@fi ;
    dct:created "1999-01-14"^^xsd:date ;
    dct:modified "2024-09-25"^^xsd:date ;
    iso-thes:broaderPartitive yso:p94426 ;
    skos:broader yso:p94426 ;
    skos:closeMatch pnr:10899564,
        wd:Q188752 ;
    skos:exactMatch allars:Y31148,
        ysa:Y111726 ;
    skos:inScheme yso:places ;
    skos:note "Etelä-Suomen lääni perustettiin 1.9.1997. Lääni muodostuu entisestä Hämeen läänin eteläosasta, Kymen läänistä ja Uudenmaan läänistä. Lisäksi suurlääniin liitettiin entisestä Mikkelin läänistä Heinola, Sysmä ja Hartola. Etelä-Suomen lääni lakkautettiin 31.12.2009 valtion aluehallintouudistuksen yhteydessä. Aluehallintovirastot (AVI) ja elinkeino- liikenne- ja ympäristökeskukset (ELY) hoitavat 1.1.2010 alkaen alueilla tehtäviä, joita tähän asti ovat hoitaneet lääninhallitukset, TE-keskukset, alueelliset ympäristökeskukset, ympäristölupavirastot, tiepiirit ja työsuojelupiirien työsuojelutoimistot"@fi,
        "Södra Finlands län grundades 1.9.1977. Det bildades av  tidigare Tavastehus läns södra del, Kymmene län och Nylands län. Till det nya storlänet anslöts även Heinola, Sysmä och  Gustav Adolfs från tidigare S:t Michels län."@sv ;
    skos:prefLabel "Southern Finland Province"@en,
        "Etelä-Suomen lääni"@fi,
        "Södra Finlands län"@sv ;
    skos:related yso:p105108,
        yso:p105117,
        yso:p105917,
        yso:p94460 ;
    skosxl:prefLabel <http://www.yso.fi/onto/yso/p111726#en> .

yso:p111745 a skos:Concept ;
    dc:source "Maanmittauslaitoksen paikannimirekisteri; tyyppitieto: Lääni (2009)"@fi ;
