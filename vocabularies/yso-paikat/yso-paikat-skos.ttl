yso:p197139 a skos:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2014-02-21"^^xsd:date ;
    dct:modified "2025-01-10T09:08:27"^^xsd:dateTime ;
    skos:altLabel "Viborgs provins"@sv ;
    skos:exactMatch allars:Y49296,
        ysa:Y197139 ;
    skos:inScheme yso:places ;
    skos:note "Uudenkaupungin rauhassa 1721 siirtyivät Käkisalmen läänin etelä- ja keskiosat sekä pääosa Viipurin läänistä Venäjän haltuun. Alue muodosti hallinnollisesti Pietarin kuvernementtiin kuuluneen Viipurin ja Käkisalmen provinssin. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus, Viipurin kuvernementti."@fi ;
    skos:prefLabel "Viipurin provinssi"@fi,
        "Viborgska provinsen"@sv ;
    skos:related yso:p197138 ;
    skos:topConceptOf yso:places .

yso:p197140 a skos:Concept ;
    dct:created "2014-02-21"^^xsd:date ;
    dct:modified "2026-01-02T15:09:53"^^xsd:dateTime ;
    skos:altLabel "Keksholms provins"@sv ;
    skos:exactMatch allars:Y48961,
        ysa:Y197140 ;
    skos:inScheme yso:places ;
    skos:note "Uudenkaupungin rauhassa 1721 siirtyivät Käkisalmen läänin etelä- ja keskiosat sekä pääosa Viipurin läänistä Venäjän haltuun. Alue muodosti hallinnollisesti Pietarin kuvernementtiin kuuluneen Viipurin ja Käkisalmen provinssin. Turun rauhan jälkeen 1743 Viipurin, Käkisalmen ja Kyminkartanon provinsseista muodostettiin yksi hallinnollinen kokonaisuus, Viipurin kuvernementti."@fi,
        "Vid freden i Nystad 1721 blev de södra och mellersta delarna av Kexholms län samt huvuddelen av Viborgs län en del av Ryssland. Området bildade förvaltningsmässigt Viborgs och Kexholms provins, som tillhörde guvernementet Sankt Petersburg. Efter freden i Åbo 1743 bildades av Viborgs, Kexholms och Kymmenegårds provinser en förvaltningsmässig helhet, Viborgs guvernement."@sv ;
    skos:prefLabel "Käkisalmen provinssi"@fi,
        "Kexholms provins"@sv ;
    skos:related yso:p197138 ;
    skos:topConceptOf yso:places .

