yso:p105157 a skos:Concept ;
    dct:created "1990-07-13"^^xsd:date ;
    dct:modified "2024-05-26"^^xsd:date ;
    skos:exactMatch allars:Y33917,
        ysa:Y105157 ;
    skos:inScheme yso:places ;
    skos:note "Venäläisten rakentama Ruotsinsalmen linnoituskaupunki. Englantilaiset tuhosivat kaupungin Krimin sodassa 1855. Nykyään paikalla sijaitsee Kotkan kaupunki"@fi,
        "Fästningsstad vid Svensksund, byggd av ryssar. Engelsmännen förstörde staden i Krimkriget 1855. Numera finns Kotka stad på platsen."@sv ;
    skos:prefLabel "Ruotsinsalmi"@fi,
        "Svensksund"@sv ;
    skos:topConceptOf yso:places .

