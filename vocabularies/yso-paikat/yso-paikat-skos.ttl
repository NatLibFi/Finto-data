        "Näset (Karelska näset)"@sv ;
    skos:closeMatch wd:Q209010 ;
    skos:exactMatch allars:Y34135,
        ysa:Y149659 ;
    skos:inScheme yso:places ;
    skos:note "Tarkoittaa luonnonmaantieteellistä aluetta, joka erottaa Laatokan ja Suomenlahden toisistaan. Kannaksen kaakkoisraja on Neva ja luoteisraja kulkee Viipurinlahdesta Laatokan läntisimpään lahteen."@fi,
        "Naturgeografiskt område som åtskiljer Ladoga och Finska viken. Näset avgränsas i sydost av Neva och nordvästgränsen går från Viborgska viken till viken längst i väster i Ladoga."@sv ;
    skos:prefLabel "Karelian Isthmus"@en,
        "Karjalankannas"@fi,
        "Karelska näset"@sv ;
    skos:related yso:p94192 ;
    skos:topConceptOf yso:places ;
    skosxl:prefLabel <http://www.yso.fi/onto/yso/p149659#en> .

