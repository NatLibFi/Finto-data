yso:p166876 a skos:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2009-07-16"^^xsd:date ;
    dct:modified "2024-09-25"^^xsd:date ;
    skos:closeMatch wd:Q11888758 ;
    skos:exactMatch allars:Y45527,
        ysa:Y166876 ;
    skos:inScheme yso:places ;
    skos:note "Uudenmaan maakunnan itäisen puoliskon käsittänyt Suomen paikallishallintoalue, joka tunnetaan jo 1400-luvulla. Porvoon linnalääni oli Viipurin linnan alaisena voutikuntana 1500-luvun alussa, jolloin siihen kuuluivat Helsingin, Sipoon, Porvoon, Pernajan ja Pyhtään pitäjät. Ennen vuonna 1619 tapahtunutta Turun linnalääniin liittämistä sen rajoja muutettiin useaan kertaan. Vuonna 1620 se yhdistettiin Hämeen ja Uudenmaan lääniin."@fi,
        "Historiskt förvaltningsområde som omfattade Nylands östra del, känt sedan 1400-talet. År 1620 sammanslogs det med Nylands och Tavastehus län."@sv ;
    skos:prefLabel "Slottslän of Porvoo"@en,
        "Porvoon lääni"@fi,
        "Borgå län"@sv ;
    skos:topConceptOf yso:places ;
    skosxl:prefLabel <http://www.yso.fi/onto/yso/p166876#en> .

