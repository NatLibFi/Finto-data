yso:Y373091 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-05-26"^^xsd:date ;
    dct:modified "2010-05-26"^^xsd:date ;
    dct:source "Julkaisu: Wikberg, O. Leniency v. kartellit"@fi ;
    skos:inScheme yse: ;
    skos:note "Viime aikoina komissio (EU:n komission kartelliosasto) on kehittänyt kahta kartellien torjunnassa tärkeää välinettä: ns. leniency- eli sakkoimmuniteettitiedonantoa ja sakotusohjeita. Uusilla sakotusohjeilla sakkojen määrä tulee todennäköisesti nousemaan edelleen.  Korotetut sakot antavat yrityksille kimmokkeen lopettaa kartellitoiminta ja raportoida kartelleista, joihin ne ovat osallistuneet. Näin menetellen ne voivat saada sakoista alennusta tai välttää ne jopa kokonaan leniency-tiedonannon mukaisesti (http://www.kilpailuvirasto.fi/cgi-bin/suomi.cgi?sivu=uut/u-2007-2-2)"@fi ;
    skos:prefLabel "leniency"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2842> .

