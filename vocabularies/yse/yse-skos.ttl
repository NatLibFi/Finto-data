yso:Y352786 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2007-06-07"^^xsd:date ;
    dct:modified "2007-06-07"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Historiallinen avantgarde toimi perustana feministiselle taiteelle, joka kommentoi ilmiöitä, yhteiskuntaa ja elämää toisen sukupuolen näkökulmasta. Se on avoimen poliittista ja sitoutunutta ja pyrkii kyseenalaistamaan autonomiaestetiikkaa. Tässä feministinen taide on osa yleistä taiteen politisoitumisen trendiä, joka saavutti huippunsa 1970-luvulla. Autonomiaestetiikan universaali kauneus ymmärretään feministisessä estetiikassa valkoisen länsimaisen miehen kauneudeksi (googlesta löytynyttä tietoa)"@fi ;
    skos:prefLabel "feministinen taide"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1952> .

