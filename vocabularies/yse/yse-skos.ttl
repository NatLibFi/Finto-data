yso:Y322328 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2002-12-18"^^xsd:date ;
    dct:modified "2002-12-18"^^xsd:date,
        "2003-02-10"^^xsd:date,
        "2003-08-13"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: http://www.om.fi/haaste/14358.htm"@fi ;
    skos:inScheme yse: ;
    skos:note "Oikeusministeriölle maaliskuussa mietintönsä luovuttanut toimikunta ehdottaa uutta sopimushoito -nimistä rangaistusta kokeiltavaksi kolmen vuoden aikana Espoon, Kotkan, Kuopion, Lahden, Porin, Oulun, Seinäjoen ja Turun käräjäoikeuksissa. Sopimushoitoa voidaan tuomita enintään kahdeksan kuukauden ehdottoman vankeusrangaistuksen sijasta samoin kuin yhdyskuntapalveluakin. Hoidon pituus olisi vähintään kuusi kuukautta ja enintään kaksi vuotta. Sopimushoito on tarkoitettu lähinnä niille, joita ei päihdeongelmansa takia voida tuomita yhdyskuntapalveluun. Nykyisin he suorittavat rangaistuksensa vankilassa. Sopimushoito tulisi  käytännössä sovellettavaksi lähinnä toistuviin rattijuopumuksiin sekä omaisuusrikoksiin ja lievempiin  väkivaltarikoksiin syyllistyneille päihdeongelmaisille"@fi ;
    skos:prefLabel "sopimushoito"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/870> .

