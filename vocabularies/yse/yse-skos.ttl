yso:Y365983 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2009-05-19"^^xsd:date ;
    dct:modified "2009-05-19"^^xsd:date ;
    dct:source "Julkaisu: The roll panorama"@fi ;
    skos:inScheme yse: ;
    skos:note "Wikipedia:   Liikkuva panoraama oli suurikokoinen ja jopa satoja metrejä pitkä rullamaalaus, jonka kuvat esityksen aikana kulkivat yleisön silmien editse. Esitystä kommentoi luennoitsija, ja siihen liittyi usein myös musiikkia ja ääniefektejä. Tällaiset esitykset olivat erityisen suosittuja Yhdysvalloissa ja Englannissa. Liikkuvat panoraamat nauttivat suurta suosiota 1800-luvulla, mutta ovat sittemmin vaipuneet lähes täydelliseen unohdukseen"@fi ;
    skos:prefLabel "liikkuvat panoraamat"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2527> .

