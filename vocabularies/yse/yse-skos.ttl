yso:Y352882 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2007-06-08"^^xsd:date ;
    dct:modified "2007-06-08"^^xsd:date,
        "2013-11-19"^^xsd:date ;
    dct:source "Lähde: Tarinasäveltämisen taito"@fi ;
    skos:inScheme yse: ;
    skos:note "Tarinasäveltäminen on vapaaseen musiikilliseen ilmaisuun ja vuorovaikutukseen perustuva sekä   musiikillisen ja sanallisen kohtaamisen ja jakamisen mahdollistava kehittämäni työtapa, jonka idea on noussut esiin käytännön työssä lasten parissa. Se soveltuu luovan ilmaisun keinoksi, soiton- ja   musiikinopetuksen menetelmäksi - myös erityistä tukea tarvitseville henkilöille sekä musiikkiterapian lähestymistavaksi. Sillä on monia erilaisia sovellusmahdollisuuksia sekä yksilö- että ryhmätyöskentelyyn (Googlesta löytynyttä tietoa)"@fi ;
    skos:prefLabel "tarinasäveltäminen"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2017> .

