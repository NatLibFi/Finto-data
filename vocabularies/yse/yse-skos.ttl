yso:Y513796 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2025-07-08"^^xsd:date ;
    skos:broadMatch yso:p1632,
        yso:p4634 ;
    skos:inScheme yse: ;
    skos:note "\"Monikulttuurinen psykologia on psykologian osa-alue, joka tutkii ja ottaa huomioon ihmisten kulttuuritaustan vaikutuksen psyykkisiin prosesseihin, käyttäytymiseen ja mielenterveyteen.\" lähde: googlen AI"@fi ;
    skos:prefLabel "multicultural psychology"@en,
        "monikulttuurinen psykologia"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/13796> .

yso:Y513797 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2025-07-08"^^xsd:date ;
    skos:broadMatch yso:p1632,
        yso:p4634 ;
    skos:inScheme yse: ;
    skos:note "\"Kulttuurienvälinen psykologia tutkii ihmisten psyykkisten toimintojen ja käyttäytymisen eroavaisuuksia ja yhtäläisyyksiä eri kulttuureissa. Se tarkastelee, miten kulttuuri vaikuttaa ajatteluun, tunteisiin ja sosiaaliseen vuorovaikutukseen. Kulttuurienvälinen psykologia on osa psykologian laajempaa alaa ja se pyrkii ymmärtämään ihmisen toimintaa monimuotoisessa maailmassa.\" lähde: google AI"@fi ;
    skos:prefLabel "cross-cultural psychology"@en,
        "kulttuurienvälinen psykologia"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/13797> .

