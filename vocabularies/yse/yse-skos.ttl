yso:Y390382 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-12-21"^^xsd:date ;
    dct:modified "2012-12-21"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Turvataidot tarkoittavat asioita, joita lapsi voi tehdä oman turvallisuutensa vahvistamiseksi ja itsensä suojaamiseksi esimerkiksi kiusaamis- tai ahdistelutilanteessa. Turvataidot kiteytyvät kolmeen tärkeään asiaan: miten sanoa ei, miten lähteä pois tilanteesta ja miten kertoa luotettavalle aikuisille huolestuttavista asioista (http://www.paihdelinkki.fi/mediassa/turvataidoista-selviytymisen-alkeita-lapsille)"@fi ;
    skos:prefLabel "turvataidot"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3804> .

