yso:Y375851 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-11-03"^^xsd:date ;
    dct:modified "2010-11-03"^^xsd:date ;
    dct:source "Julkaisu: Savirakennukset ja niiden korjaaminen"@fi ;
    skos:inScheme yse: ;
    skos:note "Savirakentamisella tarkoitetaan saven käyttöä asuin- ja muiden rakennusten materiaalina. Pelkän savi-hiekkaseoksen käyttöä kutsutaan massiivisavirakentamiseksi. Savi-olkiseoksen käyttöä kutsutaan kevytsavirakentamiseksi. Savirakentamiseen liittyy myös olkipaalirakentaminen eli suorakaiteen muotoisten olkipaalien käyttö seinien rakennusaineena. Olkipaalit päällystetään yleensä savirappauksella. Olkipaalirakentaminen on huomattavasti helpompaa kuin kevytsavirakentaminen, jossa oljen ja saven sekoittaminen on työlästä ja saven ja oljen sekoitussuhde vaikuttaa lämmöneristävyyteen (Wikipedia)"@fi ;
    skos:prefLabel "savirakentaminen"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2972> .

