yso:Y509263 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2021-06-21"^^xsd:date ;
    skos:broadMatch yso:p634 ;
    skos:inScheme yse: ;
    skos:note """"Sosioekologia on tieteellinen tutkimus siitä, miten organismin ympäristö vaikuttaa sosiaaliseen rakenteeseen ja organisaatioon."
https://fi.wikiqube.net/wiki/Socioecology"""@fi ;
    skos:prefLabel "socioecology"@en,
