yso:Y375886 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-11-04"^^xsd:date ;
    dct:modified "2010-11-04"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Teoksessa käsitellään Ammattiopisto Luovin antamaa valmentavaa ja kuntouttavaa opetusta ja koulutusta, joka julkaisun mukaan on ammatillisen peruskoulutuksen yhteydessä annettavaa koulutusta, joka perustuu ammatillisesta koulutuksesta annettuun lakiin 639/98 ja asetukseen 811/89. Koulusta järjestetään ammatillisissa erityisoppilaitoksissa sekä niissä tavallisissa ammatillisissa oppilaitoksissa, jotka ovat saaneet luvan valmentavan koulutuksen järjestämiseen. Valmentavan koulutuksen tehtävänä on antaa erityisopiskelijoille valmiuksia ammatilliseen koulutukseen, työhön sijoittumiseen ja oman elämän hallintaan   (Mun mahdollisuus : Luovin valmentavassa koulutuksessa)"@fi ;
    skos:prefLabel "valmentava koulutus"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2995> .

