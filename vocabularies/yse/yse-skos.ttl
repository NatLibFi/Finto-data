    dct:source "Julkaisu: Arduino"@fi ;
    skos:inScheme yse: ;
    skos:note "Fyysinen tietojenkäsittely käyttää elekroniikkaa suunnittelijoille ja taiteilijoille tarkoitettujen uusien ratkaisujen kehittämiseen. Sen avulla suunnitellaan laitteita, joiden kanssa ihminen voi olla vuorovaikutuksessa sensorien ja käyttölaitteiden avulla ja joiden toimintaa ohjaa mikrokontrolleri (pienen tietokoneen sisältämä mikropiiri)"@fi ;
    skos:prefLabel "fyysinen tietojenkäsittely"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3428> .

