yso:Y335017 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2004-12-20"^^xsd:date ;
    dct:modified "2004-12-20"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Pirttijärvi. M. Numerical modeling and inversion.."@fi ;
    skos:inScheme yse: ;
    skos:note "Useita merkityksiä (web-Facta):  1. Toisinpäin kääntäminen tai kääntyminen.   2. Biologiassa kääntymä; mutaatio.   3. Kemiassa molekyylin muutos, joka aiheuttaa optisesti aktiivisen yhdisteen kiertosuunnan muuttumisen päinvastaiseksi, kuten esim. inverttisokerissa.   4.  Etenkin tyylikeinona käytetty sanojen tavanomaisen järjestyksen muuttaminen.   5. Intervallin käännös.   6. Yksilön käyttäytymisen (vars. sukupuolikäyttäytymisen) muuntuminen vastakkaisen sukupuolen käyttäytymisen kaltaiseksi.   7. Meteorologiassa ilmakehän kerros, jossa lämpötila päinvastoin kuin yl. ilmakehän alaosissa kohoaa ylöspäin siirryttäessä.   8.  (Elinten) nurinkääntyneisyys, vastasuuntaus, vastasijainti; esim. inversio testis, kiveskiertymä; inversio uteri, kohdun kääntyminen nurin; inversio viscerum, sisäelinten peilikuvasijainti.   9.  Käänteinen sanajärjestys, lauseen sanojen muuttunut järjestys, mikä muuttaa sen merkitystä (esim. väite - kysymys)"@fi ;
    skos:prefLabel "inversio"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1266> .

