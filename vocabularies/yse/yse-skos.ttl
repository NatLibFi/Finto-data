yso:Y386501 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    dct:source "Julkaisu: Systemia"@fi ;
    skos:altLabel "vanhemman vieraannuttamis -oireyhtymä"@fi ;
    skos:inScheme yse: ;
    skos:note "Parental alienation syndrome (abbreviated as PAS) is term coined by Richard A. Gardner in the early 1980s to refer to what he describes as a disorder in which a child, on an ongoing basis, belittles and insults one parent without justification, due to a combination of factors, including indoctrination by the other parent (almost exclusively as part of a child custody dispute) and the child's own attempts to denigrate the target parent.[1] Gardner introduced the term in a 1985 paper, describing a cluster of symptoms he had observed during the early 1980s (Wikipedia)"@fi ;
    skos:prefLabel "PAS"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3556> .

