yso:Y382650 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-11-16"^^xsd:date ;
    dct:modified "2011-11-16"^^xsd:date ;
    dct:source "Julkaisu: Terveyskioski palveluinnovaationa"@fi ;
    skos:inScheme yse: ;
    skos:note "Terveyskioski on ihmisten päivittäiseen ympäristöön sijoitettu hoitajavetoinen, matalan kynnyksen terveydenhuollon palvelupiste. Terveyskioskeista saa apua perusterveydenhoidon tarpeisiin, ennaltaehkäisevää opastusta ja neuvontaa. Kaikille avoimiin hoitajatasoisiin palveluihin pääsee ilman ajanvarausta, ja ne ovat maksuttomia. Terveyskioskit sijaitsevat tyypillisesti kauppakeskuksissa ja ostoskeskuksissa. Terveyskioski toimii terveyskeskuksen alaisena yksikkönä osana kunnan perusterveydenhuollon palvelukokonaisuutta (Wikipedia)"@fi ;
    skos:prefLabel "terveyskioskit"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3304> .

