yso:Y322276 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2002-12-17"^^xsd:date ;
    dct:modified "2002-12-17"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: http://www.info.tampere.fi/y/tesoma/ci-int.htm"@fi ;
    skos:inScheme yse: ;
    skos:note "Moniulotteinen opiskelu-menetelmä on Amerikassa, Standfordin yliopistossa työskentelevän kasvatustieteen professori Elizabeth Cohenin kehittämä ja pohjautuu jo yli 20 vuotta kestäneeseen tutkimustyöhön. Moniulotteisessa opiskelussa otetaan huomioon oppilaiden eri lahjakkuusalueet ja näin pystytään antamaan jokaiselle oppilaalle onnistumisen elämyksiä. Tehtävien avulla kehitetään myös oppilaiden syvällisempää ajattelua. Opiskelu on projektiluonteista eli opittava aines koostuu yhden tai useamman eri aineen oppisisällöstä ja suunnitellaan varta vasten oman koulun tarpeisiin mielekkäiden kokonaisuuksien opettamiseksi. Tällä tavoin koulun opetussuunnitelmaa pystytään toteuttamaan entistä mielekkäämmällä tavalla"@fi ;
    skos:prefLabel "moniulotteinen opiskelu"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/852> .

