yso:Y382663 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-11-16"^^xsd:date ;
    dct:modified "2011-11-16"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Entisajan uimahuoneet olivat rannalla sijaitsevia rakennuksia, joissa saattoi olla useampia huoneita sekä uima-allas. Uima-allas oli lautasumppu, joka nostettiin talveksi ylös vedestä. Useimmiten uimahuoneessa oli kuitenkin vain yksi huone. Uimahuoneiden alkuperäisenä ideana oli vaatteiden riisuminen ja peseytyminen sisätilassa ja uiminen rajatussa altaassa. Uimahuoneet yleistyivät 1800-luvun puolivälin jälkeen, jolloin huviloita alettiin rakentaa merenrannoille. Uimahuoneiden ulkoasussa näkyi ajalle yleinen koristeellisuus, jota käytettiin huvittelu- ja vapaa-ajanarkkitehtuurissa. Uimahuoneperinne jatkui 1900-luvun puolelle, mutta 1920-luvulle tultaessa niiden koko oli pienentynyt ja usein rannalla sijaitsevalla uimahuoneella tarkoitettiin vain pukuhuonetta (http://weegee.espoo.fi/museot/verkko/huvila/uima.htm)"@fi ;
    skos:prefLabel "uimahuoneet"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3317> .

