yso:Y361907 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2008-10-17"^^xsd:date ;
    dct:modified "2008-10-17"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    skos:altLabel "digitaaliset lehdet, elektroniset lehdet, sähköiset lehdet"@fi ;
    skos:inScheme yse: ;
    skos:note "Digilehdet on käsittääkseni laajempi käsite kuin verkkolehdet. Eli digitaaliset lehdet/aineistot ovat yhtä kuin elektroniset aineistot, jotka pitävät sisällään verkkoaineistojen lisäksi e-tallenteet, esim. lehdet cd-rommilla. Ensiksi suosituin termi oli elektroninen, sitten se käännettiin sähköiseksi ja ymmärtääkseni nyt digitaalinen on muodikkain termi. Digilehdet-käsite sisältää mahdollisesti myös digitoidut lehdet, vaikkakin luulen, että yleisessä keskustelussa digilehdet yleensä tarkoittaa verkkolehtiä ja online-muodossa alunperin syntyneitä (M-LS/KK)"@fi ;
    skos:prefLabel "digilehdet"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2287> .

