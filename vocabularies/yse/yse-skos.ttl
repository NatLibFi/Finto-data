yso:Y380085 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-06-15"^^xsd:date ;
    dct:modified "2011-06-15"^^xsd:date ;
    dct:source "Julkaisu: Uskali. Innovaatiot ja journalismi"@fi ;
    skos:inScheme yse: ;
    skos:note "Innovaatiojournalismi on uusi journalistinen genre tai lähestymistapa, jossa innovaatioita käsitellään laajemmalla, yleisemmällä tasolla, ei yksittäisiä innovaatioita. Se kertoo esimerkiksi tieteen ja tekniikan kehityssuunnista, teollisuuden tuotantoprosesseista, immateriaalioikeuksista. Sen ajatus on syntynyt Ruotsissa 2003 Suomen Tekesiä paljolti vastaavan Vinnovan innovaatiojournalismiprojektissa (Wikipedia)"@fi ;
    skos:prefLabel "innovaatiojournalismi"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3142> .

