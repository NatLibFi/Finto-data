yso:Y511126 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2023-01-31"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Metsäbiotalous (vihreä biotalous) kattaa erilaisia teollisuuden ja tuotannon aloja ja toimintoja, jotka pohjautuvat puuhun tai metsiin. Metsäbiotalouteen kuuluu esimerkiksi metsäbiomassan jalostaminen metsä-, energia-, kemian- tai elintarviketeollisuudessa."@fi ;
