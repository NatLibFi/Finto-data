yso:Y510129 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2022-02-10"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note """Genominmuokkaus on joukko geenitekniikoita, jolla organismin perimää voidaan
muokata lisäämällä, poistamalla, muuntamalla tai korvaamalla DNA:ta. Genominmuokkaustekniikoita on kehitetty useita erilaisia (ks. alla uudet mutageneesitekniikat). Julkaisu: Uusien genominmuokkaustekniikoiden hyödyntäminen Suomessa s. 11.  Valtioneuvoston selvitys- ja tutkimustoiminnan julkaisuja 2021:37"""@fi ;
    skos:prefLabel "genominmuokkaus"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/10129> .

