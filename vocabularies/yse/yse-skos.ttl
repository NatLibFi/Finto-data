yso:Y385787 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-04-25"^^xsd:date ;
    dct:modified "2012-04-25"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Kognitiiviset radioverkot pystyvät joustavasti ja tehokkaasti hyödyntämään niitä taajuuksia, jotka eivät ole tietyllä hetkellä, tietyssä paikassa muiden radioverkkojen käytössä. Kognitiivisten radioverkkojen arvioidaan siten tehostavan taajuuksien kokonaiskäyttöä. Taajuudet ovat rajallinen luonnonvara. (http://www.itviikko.fi/pdf/200926016)"@fi ;
    skos:prefLabel "kognitiiviset radioverkot"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3460> .

