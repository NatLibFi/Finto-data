yso:Y371673 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-03-15"^^xsd:date ;
    dct:modified "2010-03-15"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Ei-tietoinen eli implisiittinen tieto on sellaista, joka ei ole koskaan tullutkaan tietoiseksi. Se  rakentuu motorisista toiminnoista, affektikaavioista, odotuksista ja jopa ajattelun kaavioista. Myös  esimerkiksi suureksi osaksi se tieto, miten olla muiden kanssa on implisiittistä suhdetietoa (http://www.kognitiivinenpsykoterapia.org/ktanterotoskala.pdf)"@fi ;
    skos:prefLabel "implisiittinen tieto"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2708> .

yso:Y371674 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-03-15"^^xsd:date ;
    dct:modified "2010-03-15"^^xsd:date ;
