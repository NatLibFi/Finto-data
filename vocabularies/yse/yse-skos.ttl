yso:Y375799 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-11-03"^^xsd:date ;
    dct:modified "2010-11-03"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Helsingin nuorisoasiainkeskuksen työryhmän määritelmän mukaan kulttuurinen nuorisotyö vahvistaa nuorten ilmaisutaitoja ja luovaa osaamista. Se on osallistumista tukevaa, omaehtoista sekä nuorten kasvua ja oppimista edistävää toimintaa, jossa nuoret toimivat ensisijaisesti subjekteina.  Termi on vakiintunut yleiseksi nimitykseksi ja tunnistettaneen sekä kulttuuri- että nuorisoalalla (http://www.kulttuurinennuorisotyo.net/; http://www.kommentti.fi/sivu.php?artikkeli_id=228)"@fi ;
    skos:prefLabel "kulttuurinen nuorisotyö"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2934> .

