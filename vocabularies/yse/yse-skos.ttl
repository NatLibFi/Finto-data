yso:Y348467 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2006-10-04"^^xsd:date ;
    dct:modified "2006-10-04"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Ohjeet vara arvioimisesta erityisäitiysvapaan tarvetta harkittaessa"@fi ;
    skos:inScheme yse: ;
    skos:note "Äidillä on oikeus erityisäitiysrahaan, jos hänen työhönsä tai työpaikkansa olosuhteisiin liittyvän kemiallisen aineen, säteilyn tai tarttuvan taudin arvioidaan aiheuttavan vaaraa sikiön kehitykselle tai raskaudelle. Lisäksi edellytetään, ettei hänelle voida järjestää muuta työtä ja että hän joutuu tämän vuoksi olemaan poissa"@fi ;
    skos:prefLabel "erityisäitiysraha"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1755> .

yso:Y348468 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2006-10-04"^^xsd:date ;
    dct:modified "2006-10-04"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Ohjeet vara arvioimisesta erityisäitiysvapaan tarvetta harkittaessa"@fi ;
    skos:inScheme yse: ;
    skos:note "Tarkoitettu tilanteisiin, joissa raskaana olevan henkilön työ voi vaarantaa hänen tai sikiön terveyden eikä hänelle pystytä järjestämään riskitöntä työtä. Vaarallisena pidetään muun muassa työtehtäviä tai työolosuhteita, joissa raskaana oleva alistuu kemiallisille aineille, säteilylle, tarttuville taudeille tai tupakan savulle (Sos. ja terveysministeriön sivut)"@fi ;
    skos:prefLabel "erityisäitiysvapaa"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1756> .

