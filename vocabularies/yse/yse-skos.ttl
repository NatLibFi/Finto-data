yso:Y369456 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2009-11-18"^^xsd:date ;
    dct:modified "2009-11-18"^^xsd:date ;
    dct:source "Lähde:  Aluehallinnon uudistaminen Etelä-Karjalan näkökulmasta"@fi ;
    skos:altLabel "maakunnan yhteistyöryhmä, maakunnan yhteistyöryhmät, MYR"@fi ;
    skos:inScheme yse: ;
    skos:note "EU-ohjelmien myötä perustetut maakuntien yhteistyöryhmät (MYR) ovat pyrkineet   koordinoimaan maakuntien aluekehitykseen vaikuttavia määrärahoja.  Niiden kokoonpano on kuitenkin kansanvaltaisesta järjestelmästä poikkeava siten, että kolmannes jäsenistä edustaa kuntasektoria, kolmannes sosiaalipartnereita (työnantaja ja -tekijäjärjestöt yms.) ja kolmannes valtion piirihallinnon virkamiehiä.  MYR:ien rooli vaihtelee jonkin verran maakunnittain, eikä MYR:ien voi katsoa edustavan kansanvaltaista päätöksentekoa.  Ne ovat kuitenkin hyödyllisiä aluekehityksen läpinäkyvyyden varmistamiseksi ja tiedonkulun ja yhteistoiminnan kannalta."@fi ;
    skos:prefLabel "maakuntien yhteistyöryhmät"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2619> .

