yso:Y390339 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-12-20"^^xsd:date ;
    dct:modified "2012-12-20"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Olemuskieleksi voidaan kutsua sitä ei-kielellistä vuorovaikutusta, joka ihmisen normaalikehityksessä edeltää puhetta (Pulli ym. 2005). Olemuskieleen kuuluvat esimerkiksi ilmeet ja eleet, ääntely ja äänensävyt, toiminta, itku ja nauru sekä kehon asennot. http://papunet.net/tietoa/eleet-ja-olemuskieli"@fi ;
    skos:prefLabel "olemuskieli"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3764> .

