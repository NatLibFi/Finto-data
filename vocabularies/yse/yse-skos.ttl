yso:Y338174 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2005-05-19"^^xsd:date ;
    dct:modified "2005-05-19"^^xsd:date,
        "2005-05-24"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Web-Facta (M-teoria ks.superjousiteoria); Kosmoksen rakenne"@fi ;
    skos:altLabel "superjousiteoria"@fi ;
    skos:inScheme yse: ;
    skos:note "Eräs yhtenäiskenttäteoria, jonka tavoitteena on yhdistää luonnon neljä perusvoimaa: painovoima, sähkömagnetismi, heikko ydinvoima ja vahva ydinvoima. Superjousiteorian perusoletus on, että äärimmäisen pienessä Planckin mittakaavassa alkeishiukkaset eivät olekaan pistemäisiä vaan pitkänomaisia tai silmukan muotoisia \"jousia\" tai \"säikeitä\". Edward Witten, John Schwarz ja Michael Green osoittivat 1984, että superjousiteoria toimii matemaattisesti 10-ulotteisessa aika-avaruudessa. Muita todisteita teorian toimivuudesta ei vielä ole esitetty. Nyk. yhtenäisteorian ratkaisua etsitään 11-ulotteisesta aika-avaruudesta. Tämä ns. M-teoria yrittää ratkaista aik. 10-ulotteisen superjousiteorian kohtaamat vaikeudet yhden lisäulottuvuuden avulla"@fi ;
    skos:prefLabel "supersäieteoria"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1452> .

