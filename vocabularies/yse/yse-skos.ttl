yso:Y369501 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2009-11-18"^^xsd:date ;
    dct:modified "2009-11-18"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Tietotekniikkatutkinnalla tarkoitetaan toimintoa, joka kattaa tietoteknisen tutkinnan (tietoteknisen todistusaineiston esille haun) sekä tietotekniikkarikosten tutkinnan. Tietotekninen tutkinta on toiminto, jonka avulla pääasiassa tuetaan ja varmennetaan poliisin suorittamaa esitutkintaa. Toiminnan keskeisenä periaatteena tulee olla oikeusvarman ja laadukkaan palvelun tuottaminen poliisin organisaation sekä sen asiakkaiden käyttöön (http://www.intermin.fi/intermin/biblio.nsf/vwbytype/7C3469C39AC916E4C225753C0048F68D)"@fi ;
    skos:prefLabel "tietotekniikkatutkinta"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2650> .

