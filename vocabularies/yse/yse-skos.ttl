yso:Y382608 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-11-15"^^xsd:date ;
    dct:modified "2011-11-15"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Wikipedia: Tärkein ja lähes ainoa nykyisin käytössä oleva logografinen eli sanakirjoitusjärjestelmä on kiinan kirjoitusjärjestelmä, jota on käytetty pienin muutoksin kiinassa, japanissa, koreassa, vietnamissa ja eräissä muissa itäaasialaisissa kielissä.  Sanakirjoituksen perusyksikkö logogrammi on kirjoitusmerkki, joka esittää kokonaista kieliopillista sanaa. Useimpia kiinan kirjoitusmerkkejä pidetään logogrammeina. Kun kukin kirjoitusmerkki vastaa yhtä sanaa (tai tarkemmin morfeemia), tarvitaan erilaisia logogrammeja suuri määrä. Kirjoitusmerkkien suuri määrä ja niiden opiskelun hankaluus onkin sanakirjoituksen heikkous aakkosjärjestelmiin verrattuna."@fi ;
    skos:prefLabel "sanakirjoitus"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3277> .

