yso:Y386491 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Erä, joka syntyy ostajan kirjanpitoon, kun tavaran tai palveluksen myyjä myöntää asiakkaalle maksuaikaa. Tilikauden aikana ostovelkoja seurataan kirjanpidossa ostoreskontrassa. Ostovelat esitetään yrityksen taseessa omana lyhytaikaisten velkojen eränä. Mikäli maksuaika on yli vuoden, ostovelka kirjataan pitkäaikaisiin velkoihin. Aiemmin puhuttiin tiliveloista (Taloussanasto)"@fi ;
    skos:prefLabel "ostovelat"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3548> .

