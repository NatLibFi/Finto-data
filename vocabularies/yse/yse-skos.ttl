yso:Y373067 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-05-25"^^xsd:date ;
    dct:modified "2010-05-25"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Jäynä on yleensä teekkareiden suorittama käytännön kepponen tai tapahtuma joiden tarkoitus on aiheuttaa riemua jäynääjissä sekä myös jäynän kohteissa ja suuressa yleisössä. Jäynällä on ominaista, että se pyrkii käyttämään hyväksi tekniikkaa joskus hyvinkin mitättömän asian aikaansaamiseksi. Jäynä ei saa olla poliittisesti tai uskonnollisesti kantaa ottava. Hyvä jäynä liittyy kuitenkin usein yhteiskunnan ajankohtaisiin asioihin ja tapahtumiin. Jäynän tarkoitus ei ole myöskään turmella, rienata, tuhota tai varastaa (Wikipedia)"@fi ;
    skos:prefLabel "jäynät"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2833> .

