yso:Y504460 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2016-06-15"^^xsd:date ;
    dct:modified "2016-06-15"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "”…sellaiseen kapitalistisen kasautumisen muotoon, jossa ihmisen yleiset tietokyvyt, tietäminen, ovat taloudellisen hyödyntämisen ja riiston kohteina. Tietokykykapitalismi kuvaa ”uutta kapitalistisen kasautumisen muotoa, jossa ihmisen yleiset tietokyvyt (Marxin General intellect), tietäminen eikä tieto tai informaatio on taloudellisen hyödyntämisen ja riiston kohteina” (Vähämäki 2009, 80).” Lähde: Tietojohtaminen ja tietokapitalismi - Maija Jussilainen (Informaatiotutkimus Vol 29, Nro 4/2010)"@fi ;
    skos:prefLabel "tietokykykapitalismi"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/4460> .

