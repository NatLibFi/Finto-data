yso:Y356885 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2008-02-04"^^xsd:date ;
    dct:modified "2008-02-04"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    skos:altLabel "SFA, Substance Flow Analysis"@fi ;
    skos:inScheme yse: ;
    skos:note "Ainevirta-analyysi (Substance Flow Analysis, SFA) perustuu teollisen metabolismin paradigmaan ja on yksi materiaalivirta-analyysin (Material Flow Analysis, MFA) tyyppi. Ainevirta-analyysi tarkastelee vain yhtä ainetta kerrallaan (kuten typpi tai fosfori). Materiaalivirta-analyysin avulla voidaan tarkastella tiettyjen aineiden lisäksi materiaaleja ja tuotteita sekä näihin liittyen yrityksiä, tuotantosektoreita tai alueita (http://www.helsinki.fi/biosci/environment/opinnaytteet/2000/2004-Saikku.pdf)"@fi ;
    skos:prefLabel "ainevirta-analyysi"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2119> .

yso:Y356886 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2008-02-04"^^xsd:date ;
    dct:modified "2008-02-04"^^xsd:date,
        "2008-12-16"^^xsd:date,
        "2009-01-12"^^xsd:date ;
    skos:altLabel "Material Flow Analysis, MFA"@fi ;
    skos:inScheme yse: ;
    skos:note "Ainevirta-analyysi (Substance Flow Analysis, SFA) perustuu teollisen metabolismin paradigmaan ja on yksi materiaalivirta-analyysin (Material Flow Analysis, MFA) tyyppi. Ainevirta-analyysi tarkastelee vain yhtä ainetta kerrallaan (kuten typpi tai fosfori). Materiaalivirta-analyysin avulla voidaan tarkastella tiettyjen aineiden lisäksi materiaaleja ja tuotteita sekä näihin liittyen yrityksiä, tuotantosektoreita tai alueita (http://www.helsinki.fi/biosci/environment/opinnaytteet/2000/2004-Saikku.pdf)"@fi ;
    skos:prefLabel "materiaalivirta-analyysi"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2120> .

