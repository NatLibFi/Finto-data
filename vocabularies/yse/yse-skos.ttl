yso:Y386596 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Kansallinen uhritutkimus selvittää suomalaisten tapaturmien ja väkivallan uhriksi joutumista 15 vuotta täyttäneessä väestössä ja mittaa sitä kautta väestön fyysisen turvallisuuden tilaa. Tapaturmien kannalta uhrihaastattelututkimuksia tehdään, jotta saadaan tietoa erityisesti seurauksiltaan lievemmistä tapaturmista. Tulokset eivät koske laitoksissa asuvaa väestöä (http://www.thl.fi/fi_FI/web/pistetapaturmille-fi/tilastot/tapaturmatilastointi-suomessa/kansallinen-uhritutkimus)"@fi ;
    skos:prefLabel "uhritutkimus"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3638> .

