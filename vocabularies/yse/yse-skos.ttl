yso:Y386579 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Transmodernismi on ajattelutapa, jonka sen kannattajat sanovat seuraavan postmodernismia. Transmodernismi vastustaa postmodernismin kehityspessimismiä, täydellistä relativismia ja tieteenvastaisuutta ja kannattaa optimismia, absoluuttisia arvoja ja tiedettä, siirtyen tässä suhteessa takaisin modernismin suuntaan. Toisaalta transmodernismi huomioi jälkiteollisen yhteiskunnan ominaispiirteet, kuten yhteiskunnan pirstaloitumisen samoin kuin kehitykseen liittyvät ympäristö- ym. ongelmat ja eroaa siten postmodernia kritisoivasta (uus)modernismista. Toisin kuin jotkut modernismin muodot, transmodernismi ei aja yhteiskunnan täyttä sekularisaatiota, vaan hyväksyy perinteiset filosofiat ja uskonnot aatteina muiden joukossa.  Transmodernismi on yritys korvata sekä modernismi että postmodernismi sulauttamalla ajattelutapoja molemmista (Wikipedia)"@fi ;
    skos:prefLabel "transmodernismi"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3624> .

