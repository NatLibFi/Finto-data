yso:Y511524 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2023-05-11"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "\"Finansialisaatio tarkoittaa yleisesti finanssimarkkinoiden roolin kasvua kotitalouksien, yritysten ja valtioiden rahoittajana mutta myös rahoitusmarkkinoiden kontrollia taloudellisista prosesseista ja talouspoliittisista päätöksistä.\" Hoivapalveluiden finansialisaatio Suomessa, Olli Karsio, Minna Zechner, Lena Näre, Hanna-Kaisa Hoppania & Tiina Vaittinen. Teoksessa Hoivan pimeä puoli (toim. Tiina Sihto & Paula Vasara). \"Hoivan finansialisaatio tarkoittaa rahoitusmarkkinoiden roolin ja kontrollin kasvua hoivapalveluissa. Finansialisoidussa hoivassa voittoa tavoitellaan rahoitusmarkkinoilla, ei tuotteilla tai palveluilla. Tavoitteena ei ole laadukkaan palvelun tuottaminen ja myynti, vaan luvattujen tuottojen takaaminen sijoittajille. \" https://politiikasta.fi/hoivan-finansialisaatio-vanhuspalveluissa/"@fi ;
    skos:prefLabel "financialisation/financialization"@en,
        "finansialisaatio"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/11524> .

yso:Y511525 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2023-05-11"^^xsd:date ;
    skos:altLabel "markkinaistaminen, markkinoistuminen, markkinaistuminen"@fi ;
    skos:inScheme yse: ;
    skos:note "\"Hoivan markkinaistaminen tarkoittaa sitä, että julkisrahoitteisten palvelujen järjestämisessä hyödynnetään markkinamekanismeja ja yksityisiä voittoa tavoittelevia toimijoita sekä yritysmäisiä tuotannon tapoja. Julkisrahoitteisten palveluiden tuotantoa ulkoistetaan tai kilpailutetaan yritysten tuotettaviksi. \" https://politiikasta.fi/hoivan-finansialisaatio-vanhuspalveluissa/"@fi ;
    skos:prefLabel "markkinoistaminen"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/11525> .

