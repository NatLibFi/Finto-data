yso:Y377888 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-03-07"^^xsd:date ;
    dct:modified "2011-03-07"^^xsd:date ;
    skos:altLabel "algoritminen suunnittelu"@fi ;
    skos:inScheme yse: ;
    skos:note "Algoritmisella arkkitehtuurilla tarkoitetaan käskysarjoilla eli skripteillä luotua arkkitehtuuria. Skriptit ovat tekstimuotoisia komentosarjoja, jotka pystyvät arvioimaan ja muuttamaan omaa kulkuaan, käyttäjältä saatua tietoa sekä käsittelemään monimutkaisia tehtäviä. Arkkitehtuurissa skriptausta voidaan hyödyntää monipuolisesti erilaisiin tarkoituksiin aina yksinkertaisten tehtävien automatisoinnista koko suunnitteluprosessin hallintaan (http://www.generate.fi/fi/lyhyesti_fi.html)"@fi ;
    skos:prefLabel "algoritminen arkkitehtuuri"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3004> .

