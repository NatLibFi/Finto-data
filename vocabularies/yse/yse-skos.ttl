yso:Y359310 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2008-05-28"^^xsd:date ;
    dct:modified "2008-05-28"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Juklkaisu: Elävä kirjasto"@fi ;
    skos:inScheme yse: ;
    skos:note "Elävä kirjasto toimii kuten tavallinen kirjasto, paitsi että sieltä saa lainata tavallisten kirjojen sijasta ”eläviä kirjoja” eli ihmisiä. Elävän kirjaston ydinajatuksen mukaan ihmisillä on usein ennakkoluuloja sellaisia ihmisryhmiä kohtaan, joita he eivät ole henkilökohtaisesti kohdanneet. Elävä kirjasto antaa mahdollisuuden kohdata kasvokkain sellaisiin ryhmiin kuuluvia ihmisiä, jotka kohtaavat paljon ennakkoluuloja jokapäiväisessä elämässään. Siten se edesauttaa stereotypioiden murtumista (Googlesta löytynyttä tietoa"@fi ;
    skos:prefLabel "elävä kirjasto"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2187> .

