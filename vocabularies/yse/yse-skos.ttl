yso:Y351411 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2007-03-09"^^xsd:date ;
    dct:modified "2007-03-09"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Minne matka, luova talous"@fi ;
    skos:inScheme yse: ;
    skos:note "Ambience design merkitsee uuden tyyppistä suunnittelukulttuuria, jopa paradigman vaihdosta. Ambience designissa suunnittelijat kommunikoivat tutkijoiden kanssa. Ambience design -prosessissa suunnittelu ei ole pelkästään suunnittelijan persoonallisen kädenjäljen varaan rakentuvaa, vaan suunnittelutyö perustuu tietämykseen siitä, miten moniaistinen ympäristö/tunnelma vaikuttaa ihmisiin. Ambience design -projektissa osaamista kehitetään vuorovaikutuksessa monen alan ammattilaisten kanssa. Tulokset dokumentoidaan huolellisesti."@fi ;
    skos:prefLabel "ambience design"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1838> .

