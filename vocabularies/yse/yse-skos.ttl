yso:Y386557 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Taide-elokuvat ovat elokuvia, joiden tarkoituksena on olla taiteellisesti korkealaatuisia, eikä välttämättä saavuttaa suuren yleisön suosiota tai olla viihdyttäviä. Tämän vuoksi ne ovat usein vain pienen harrastajaryhmän tuntemia. Taide-elokuvia näytetään usein vain suurimpien kaupunkien niin sanotuissa art house -elokuvateattereissa, jotka ovat erikoistuneet niiden esittämiseen. Taide-elokuvat voivat kuitenkin olla myös tunnettuja, kuten Stanley Kubrickin 2001: Avaruusseikkailu ja Kellopeliappelsiini, sekä Andrei Tarkovskin elokuva Andrei Rublev (1965) (Wikipedia)"@fi ;
    skos:prefLabel "taide-elokuvat"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3604> .

yso:Y386558 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    skos:altLabel "koston laki, Talio-laki"@fi ;
    skos:inScheme yse: ;
    skos:note "Talio-periaate eli koston laki on oikeustieteellinen periaate, joka esiintyi ensi kerran muinaisessa Babyloniassa Hammurabin laissa. Samaa periaatetta on myös sovellettu niin raamatullisessa laissa, 1 Moos. 9:6 (\"Joka ihmisen veren vuodattaa, hänen verensä on ihminen vuodattava\"), kuin varhaisessa roomalaisessakin laissa. Sen mukaan rikollisen pitää saada samanlainen rangaistus kuin minkä hän on aiheuttanut uhrilleen. Tätä silmä silmästä -periaatetta on sovellettu vanhoissa kulttuureissa usein kirjaimellisesti (Wikipedia)"@fi ;
    skos:prefLabel "Talio-periaate"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3605> .

