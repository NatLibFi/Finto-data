yso:Y369409 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2009-11-17"^^xsd:date ;
    dct:modified "2009-11-17"^^xsd:date ;
    skos:altLabel "digitaalinen voimistuminen"@fi ;
    skos:inScheme yse: ;
    skos:note "Tutkimuksessa käytetään käsitettä digitaalinen voimistuminen kuvaamaan mahdollistavaa kehitystä, jossa digitaalisia välineitä kuten uutta viestintäteknologiaa sovelletaan voimistumiskehityksen tukena. Tutkimuksessa keskeisinä ovat toimintamallit, joilla lisätään osallisuuden mahdollisuuksia. Tämän tyyppisinä toimintamalleina käsitellään yhteisöllisiä uuden viestintäteknologian hankkeita, joilla pyritään yhteisöjä voimistaviin vaikutuksiin (Esittely kirjasta ”Digitaalinen voimistaminen paikallisyhteisöjen näkökulmasta”  http://www.bookplus.fi/product.php?isbn=9789514476419)"@fi ;
    skos:prefLabel "digitaalinen voimistaminen"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2586> .

