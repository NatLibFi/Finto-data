yso:Y351432 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2007-03-12"^^xsd:date ;
    dct:modified "2007-03-12"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Mikkola, T. Fidusiaarivastuu"@fi ;
    skos:inScheme yse: ;
    skos:note "Fidusiaarivastuu käsitteen angloamerikkalaisessa merkityksessä on oikeudessamme tuntematon vastuuperuste. Se kohdistuu nykyisin yhä merkittävämmin kansainvälisiin oikeussuhteisiin, erityisesti liikesuhteisiin, ja tuo kansainvälisiin oikeustoimiin lisävaatimuksia rehdistä ja reilusta vaihdannasta. Fidusiaarioikeus yhdistyy usein sopimus- ja vahingonkorvausoikeudellisiin oppeihin, mutta vastuuperusteidensa ja oikeussuojakeinojensa suhteen se on erotettava muista siviilioikeudellisista oppirakennelmista.”"@fi ;
    skos:prefLabel "fidusiaarivastuu"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1847> .

yso:Y351433 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2007-03-12"^^xsd:date ;
    dct:modified "2007-03-12"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Bio-oikeus lääketieteessä"@fi ;
    skos:inScheme yse: ;
    skos:note "Geneettinen tieto on olemassa alun perin kemiallisena koodina osana solua. Analysoitaessa kudosnäytettä biologinen informaatio muuttuu muilla tekniikoilla käsiteltävissä olevaksi tiedoksi: Näin saatua tietoa sen eri muodoissa koskevat lainsäädännön määräykset tiedon hyödyntämisoikeuksista sekä salassapidosta. Tunnistettavaan henkilöön yhdistettäessä oleva geneettinen informaatio on lainsäädännön tarkoittama henkilötieto"@fi ;
    skos:prefLabel "geneettinen tieto"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1848> .

