yso:Y366048 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2009-05-20"^^xsd:date ;
    dct:modified "2009-05-20"^^xsd:date ;
    dct:source "Lähde: Julkaisu: Yhteisötelevisiosta totta?"@fi ;
    skos:altLabel "alueellinen televisio, yhteisöllinen televisio"@fi ;
    skos:inScheme yse: ;
    skos:note "Eräs uuden teknologian mahdollistama kanava on yhteisötelevisio, jonka kautta yhteisön viestintää voidaan tehokkaasti välittää. Yhteisöilläei kuitenkaan ole teknistä taitoa toteuttaa tällaista palvelua. Yhteisöille, kuten pk-yrityksille, kouluille, seuroille, yhdistyksille ja jopa yksittäisille ihmisille, tuleekin pystyä tarjoamaan valmis konsepti, joka on helposti heidän käytettävissään (https://oa.doria.fi/handle/10024/30204)"@fi ;
    skos:prefLabel "yhteisötelevisio"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2577> .

