yso:Y382622 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-11-15"^^xsd:date ;
    dct:modified "2011-11-15"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Suosiolahja on perittävän elinaikanaan antama lahja, jolla hän haluaa suosia lahjan saajaa rintaperillisen tai rintaperillisten vahingoksi. Tällainen lahja tai lahjanluonteinen etuus otetaan huomioon laskettaessa lakiosaa. Lahja arvioidaan suosiolahjaksi sen määrän ja lahjanluonteisuuden perusteella. Arvioinnin pohjaksi ei tarvita näyttöä perittävän aikomuksesta suosia lahjan saajaa (Wikipedia)"@fi ;
    skos:prefLabel "suosiolahja"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3289> .

