yso:Y355211 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2007-10-29"^^xsd:date ;
    dct:modified "2007-10-29"^^xsd:date,
        "2008-07-25"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Kontinen, T. Learning challenges of NGOs in development"@fi ;
    skos:inScheme yse: ;
    skos:note "Ekspansiivisen oppimisen lähtökohtana on, että joku toimintajärjestelmän yksilö lähtee toiminnallaan kehittämään olemassa olevia käytäntöjä. Ekspansiivisessa oppimisessa on kyse toiminnan kehittymisestä ja uuden toimintatavan siirtyminen toisiin tilanteisiin sekä levittymiseen toimintajärjestelmään. Teoria selittääkin erityisesti sellaista oppimista, jossa luodaan uusia käytäntöjä kulkemalla toimintajärjestelmän yhteisen lähikehityksen vyöhykkeen läpi. Näin ollen avainasemassa ovat totutuista käytännöistä poikkeavat teot sekä toimintaa ja toimintajärjestelmää uudistavat innovaatiot (http://tievie.oulu.fi/verkkopedagogiikka/luku_4/toiminnan_teoria.htm)"@fi ;
    skos:prefLabel "ekspansiivinen oppiminen"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2039> .

