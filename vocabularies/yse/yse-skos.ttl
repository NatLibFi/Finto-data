yso:Y386605 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "\"Uutisoituminen” eli laajeneva ja fragmentoituva uutiskulttuuri....tutkimuksessa kiinnitetään huomio myös uutisoitumiseksi kutsuttuun trendiin, joka kytkeytyy uutisten aihepiirien muutoksiin ja erilaisten verkkolähteiden lisääntymiseen. Yksi tällaisen uutisoitumisen merkki näyttäisi olevan se, että uutisten aihepiirit ovat laajenneet yksityisen alueelle hämmentäen rajaa julkisen ja yksityisen välillä. Toinen uutisoitumisen ilmentymä on internetin yleistymisen myötä syntynyt jatkuva ja fragmentaarinen uutiskulttuuri: miltei kaikki poliitikoista lukiolaisiin tuottavat uutisia omasta arjestaan, mielipiteistään, tai uutisaineistoa siepataan milloin minkin mediayrityksen tuotannosta (http://www.uta.fi/laitokset/tiedotus/jourtutkimus/tutkimus/lama.php)"@fi ;
    skos:prefLabel "uutisoituminen"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3644> .

yso:Y386607 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Valmentava dialogi perustuu toisen ihmisen arvostukselle, kuuntelemiselle, kysymyksille ja palautteenannolle. Valmentavan dialogin taito on tärkeää varsinkin muutostilanteissa. Johtoryhmissä se taas monipuolistaa ajattelua ja auttaa keskittymään olennaiseen. Valmentava dialogi vauhdittaa myös väsähtäneen ryhmätoiminnan uuteen vauhtiin (Julkaisu: Kaikkien aivot käyttöön)"@fi ;
    skos:prefLabel "valmentava dialogi"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3645> .

