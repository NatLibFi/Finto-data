yso:Y348564 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2006-10-05"^^xsd:date ;
    dct:modified "2006-10-05"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Suomen malli"@fi ;
    skos:inScheme yse: ;
    skos:note "Yleensä tarkoitetaan Suomessa harjoitettuja, hyvinvointivaltion käsitteeseen kiinnittyviä erilaisia instituutioita ja politiikkoja. Tulosten mukaan Suomessa ja muissa pohjoismaisissa hyvinvointivaltioissa on vuosituhannen alkuvuosina saatu sovitettua menestyksekkäästi yhteen talouskasvu, hyvä kilpailukyky, korkea työllisyys sekä laajat julkisen vallan ylläpitämät koulutus- ja sosiaalipoliittiset järjestelmät. Lisäksi niissä on kyetty tehokkaasti edistämään sekä tietoyhteiskuntaan siirtymistä että kestävän kehityksen politiikkaa. Monella alueella Suomi on esikuva muille Euroopan unionin jäsenmaille"@fi ;
    skos:prefLabel "Suomen malli"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1828> .

