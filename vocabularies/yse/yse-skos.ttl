yso:Y386504 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    dct:source "Lähde: Wikipedia"@fi ;
    skos:inScheme yse: ;
    skos:note "Suurjänniteverkko on sähkönsiirron runkoverkko, joiden nimellisjännite on Suomessa 110-, 220- ja 400 kV.  Keskijänniteverkko siirtää sähkön suurjänniteverkosta 1–35 kV:n jännitteellä pienjänniteverkkoon johtaville jakelumuuntajille, jotka sijaitsevat esimerkiksi asutuksen läheisyydessä  Pienjänniteverkot vastaavat lopullisesta sähkön levityksestä pienkuluttajille 100 - 1 000 V:n jännitteellä. Keskijännite muunnetaan 230/400 volttiin ja sitä kautta kotitalouksille, liikerakennuksille ja virastoille toimitetaan sähköä"@fi ;
    skos:prefLabel "pienjänniteverkot"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3559> .

