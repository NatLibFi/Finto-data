yso:Y390278 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-12-20"^^xsd:date ;
    dct:modified "2012-12-20"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "\"Tarkoittaa sitä, että jotain kieltä ei enää käytetä digitaalisessa maailmassa. Jos vaikkapa suomenkielinen kieliteknologia, kuten älypuhelimet, navigaattorit ja käännöskoneet eivät toimi tarpeeksi hyvin, ihmiset käyttävät mukavuudenhalusta englantia, koska se on helpompaa.- - - - Jos suomea ei käytetä digitaalisesti, kielen käyttöala kapeutuu. Kieli säilyy elinvoimaisena, kun sitä käytetään monipuolisesti ja moninaisissa yhteyksissä.”  - Julkaisu: Helsingin Sanomat 26.9.2012"@fi ;
    skos:prefLabel "digitaalinen sukupuutto"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3707> .

