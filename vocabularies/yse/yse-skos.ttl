yso:Y513986 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2025-09-12"^^xsd:date ;
    skos:broadMatch yso:p2587 ;
    skos:inScheme yse: ;
    skos:note "\"Näyttöön perustuva psykoterapia (NPT) on terveydenhuollon toimintatapa, jossa käytetään parasta saatavilla olevaa ja ajantasaista tietoa potilaan hoidossa ja läheisten huomioimisessa, tavoitteena on tunnistaa ja käyttää vaikuttaviksi todettuja hoitomenetelmiä ja -käytäntöjä potilaiden tarpeisiin vastaamiseksi\" lähde: Google AI"@fi ;
