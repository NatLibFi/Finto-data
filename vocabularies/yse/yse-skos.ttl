yso:Y377950 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-03-09"^^xsd:date ;
    dct:modified "2011-03-09"^^xsd:date ;
    dct:source "Lähde: Sosiaalisen median sanasto"@fi ;
    skos:altLabel "sisältöön kohdistuva mainonta, sisältöön kohdennettu mainonta"@fi ;
    skos:inScheme yse: ;
    skos:note "Kohdennetussa mainonnassa esitettävä sisältö voidaan ratkaista esiintymisympäristön mukaan: esimerkiksi sähköpostipalvelussa voidaan kunkin sähköpostiviestin katselun yhteydessä esittää eri mainos viestin sisältämien sanojen perusteella. Esiintymisympäristön mukaan muuttuvasta mainonnasta voidaan voidaan käyttää termiä kontekstuaalinen mainonta. Myös ilmaisuja ”sisältöön kohdistuva mainonta” ja ”sisältöön kohdennettu mainonta” on käytetty"@fi ;
    skos:prefLabel "kontekstuaalinen mainonta"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3037> .

