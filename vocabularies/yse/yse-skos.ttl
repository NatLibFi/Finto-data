yso:Y380081 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-06-15"^^xsd:date ;
    dct:modified "2011-06-15"^^xsd:date ;
    dct:source "Bengtsson, Åsa & Mattila, Mikko: Suoran demokratian ja häivedemokratian kannatus Suomessa"@fi ;
    skos:inScheme yse: ;
    skos:note "Häivedemokratia: 1) Keskeistä päätöksenteon tehokkuus ja erityisasiantuntemuksen käyttö. 2) Kansalaiskeskustelu tai suora osallistuminen ei keskeistä. 3) Suuri osa kansalaisista ei halua osallistua itse päätöksentekoon vaan jättäisi sen valituille edustajille. 4) Politiikan ei tule olla merkittävässä asemassa tavallisten ihmisten arkielämässä. 5) Pohjimmiltaan kyse on edustuksellisen demokratian toimivuudesta"@fi ;
    skos:prefLabel "häivedemokratia"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3138> .

