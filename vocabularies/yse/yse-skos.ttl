yso:Y335078 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2004-12-21"^^xsd:date ;
    dct:modified "2004-12-21"^^xsd:date,
        "2008-06-04"^^xsd:date,
        "2008-07-22"^^xsd:date,
        "2008-12-16"^^xsd:date ;
    dct:source "Lähde: Korhonen, A. Maisteriohjelmat - tulevaisuuden peruspilarit korkeakoulutuksessa?"@fi ;
    skos:altLabel "maisterikoulutusohjelmat"@fi ;
    skos:inScheme yse: ;
    skos:note "Maisteriohjelma on käsitteenä ongelmallinen ja selkiintymätön. Koulutusohjelmien nimitykset vaihtelevat yliopistoittain ja jopa niiden sisällä. Muuntokoulutus, maisteriohjelma, täydennyskoulutus, PD-koulutus, Master's Programme, koulutusohjelma ja monet muut nimikkeet ovat vakiintumattomia ja vaihtelevasti käytettyjä korkeakoulumaailmassa. Nykyisin sekä opiskelijoiden että työnantajien on vaikea erottaa täydennyskoulutuksena tarjottavia, usein englanninkielisiä Master's- ohjelmia ylempään korkeakoulututkintoon johtavista maisteriohjelmista.   Korkeakoulujen arviointineuvoston toimeenpaneman valtakunnallisen maisteriohjelmien arviointiprojektin yhteydessä maisteriohjelma-käsite määriteltiin seuraavasti:  Maisteriohjelmat ovat ylempään korkeakoulututkintoon johtavia, 1-4-vuotisia yksi- tai monialaisia ohjelmia, joihin voivat hakea alemman korkeakoulututkinnon, ammattikorkeakoulu- tai opistotutkinnon tai muita aikaisempia yliopisto-opintoja kotimaassa tai ulkomailla suorittaneet ja joihin on erillishaku. Ylempään korkeakoulututkintoon johtavat muuntokoulutusohjelmat sisältyvät maisteriohjelmiin"@fi ;
    skos:prefLabel "maisteriohjelmat"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/1303> .

