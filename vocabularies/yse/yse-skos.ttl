yso:Y385782 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-04-25"^^xsd:date ;
    dct:modified "2012-04-25"^^xsd:date,
        "2015-10-27"^^xsd:date ;
    skos:inScheme yse: ;
    skos:note "Wikipedia:  Kirjastokimppa tarkoittaa itsenäisten kunnan- ja kaupunginkirjastojen välistä yhteistyötä yli kuntarajojen. Kirjastokimpan muodostaa yleensä fyysisesti lähekkäin sijaitsevat kirjastot ja sen tavoitteena on hyödyttää kaikkia osapuolia ja asiakkaita. Kimpan kirjastot käyttävät useimmiten samaa kirjastojärjestelmää, tekevät yhteiset aineiston hankintasopimukset sekä tekevät yhteistyötä monilla muillakin aloilla, mm. tapahtumien järjestelyissä. Asiakkaalle näkyvin yhteistyn muoto on kirjastojen väliset kirjakuljetukset, joilla parannetaan aineiston saatavuutta."@fi ;
    skos:prefLabel "kirjastokimpat"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3455> .

