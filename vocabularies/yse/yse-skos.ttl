yso:Y377892 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2011-03-07"^^xsd:date ;
    dct:modified "2011-03-07"^^xsd:date ;
    dct:source "Lähde: Sosiaalisen median sanasto"@fi ;
    skos:altLabel "avoin tuotekehitys"@fi ;
    skos:inScheme yse: ;
    skos:note "Termillä avoin kehittäminen viitataan tyypillisesti internetin välityksellä tapahtuvaan kehittämiseen. Avoin kehittäminen voi olla niin aineellisten hyödykkeiden, kuten lelujen, kuin aineettomienkin hyödykkeiden, kuten palveluiden tai tietokoneohjelmistojen, kehittämistä. Esimerkki jälkimmäisestä on tietokoneohjelman beetaversion testaus.  Avoimen kehittämisen tavoitteena voi olla kehittää kaupallisesti hyödynnettävä tuote. Toiminta voi myös olla epäkaupallista; esimerkiksi avoimen lähdekoodin ohjelmistojen kehittäminen."@fi ;
    skos:prefLabel "avoin kehittäminen"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3007> .

