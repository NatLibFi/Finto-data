yso:Y375839 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2010-11-03"^^xsd:date ;
    dct:modified "2010-11-03"^^xsd:date ;
    dct:source "Julkaisu: Keskuskaupungin ja kehyskunnan jännitteiset kytkennät"@fi ;
    skos:inScheme yse: ;
    skos:note "Käsite liittyy teknologisten innovaatioiden menestymiseen, esim. tietyt standardit yleistyvät, vaikka eivät välttämättä ole parhaita. Polkuriippuvuuden näkökulmasta olennaista on pikemminkin se, että esimerkiksi VHS (videojärjestelmä) sattui olemaan oikeassa paikassa oikeaan aikaan vallatakseen markkinat ja voittaakseen kilpailun Beta-järjestelmää vastaan. Historia tekee tietyistä kehityspoluista hallitsevia samalla, kun toisista tulee marginaalisia tai kokonaan mahdottomia. Tiettyä polkua riittävän pitkään edenneiden prosessien kohdalla tapahtunutta ei enää saa tapahtumattomaksi  - tai ainakin polun vaihtaminen tulee hyvin kalliiksi"@fi ;
    skos:prefLabel "polkuriippuvuus"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/2964> .

