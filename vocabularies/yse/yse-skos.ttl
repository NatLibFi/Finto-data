    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3606> .

yso:Y386560 a skos:Concept,
        ysemeta:Concept ;
    dct:created "2012-06-08"^^xsd:date ;
    dct:modified "2012-06-08"^^xsd:date ;
    dct:source "Julkaisu: Luoma, Terhi, Nonparametric event study tests for testing cumulative abnormal returns"@fi ;
    skos:inScheme yse: ;
    skos:note "Rahoitustutkimuksen keskeinen työväline markkinareaktioiden tutkimiseen uuden tiedon yhteydessä. Yleisesti mielenkiinnon kohteena on ilmoituksen (esim. osakeanti tai fuusio) vaikutus yrityksen arvoon. Tapahtumatutkimusta käytetään yleisesti myös markkinoiden (keskivahvan) tehokkuuden testaamisessa. (Rahoitusalan sanasto/ Mika Vaihekoski, Lappeenrannan teknillinen yliopisto)"@fi ;
    skos:prefLabel "tapahtumatutkimus"@fi ;
    foaf:homepage <https://github.com/Finto-ehdotus/YSE/issues/3607> .

