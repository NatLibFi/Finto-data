    dct:modified "2025-08-23"^^xsd:date ;
    skos:broader :m4872 ;
    skos:closeMatch yso:p9470 ;
    skos:definition "Liittovaltion osa tai sen toimialue, jota kutsutaan osavaltioksi."@fi,
        "Del av förbundsstat eller dess verksamhetsområde som kallas delstat."@sv ;
    skos:example "Alaska (Yhdysvallat); Hessen (Saksa)"@fi,
        "Alaska (Förenta staterna); Hessen (Tyskland)"@sv ;
