:m314 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m417 ;
    skos:definition "Valmistusmenetelmä, jossa hopeapäällysteinen kuparilevy valotetaan kamerassa, kehitetään (yleisimmin elohopeahöyryllä) ja kiinnitetään suolalla. Näin saadaan positiivikuva."@fi,
        "Produktionsmetod, i vilken en silverbelagd kopparplatta exponeras i en kamera, framkallas (vanligen med kvicksilverånga) och fixeras med salt. På så vis fås en positivbild."@sv ;
    skos:exactMatch rdapm:1004 ;
    skos:inScheme : ;
    skos:prefLabel "daguerreotype process"@en,
        "dagerrotypia-menetelmä"@fi,
        "dagerrotypi"@sv .

