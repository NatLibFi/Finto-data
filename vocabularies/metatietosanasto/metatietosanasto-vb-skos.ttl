    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m777 ;
    skos:definition "Viestin sisältää liikkuvaa kuvaa tai stillkuvia ja on suunniteltu käytettäväksi toistolaitteen, kuten videokasettinauhurin tai DVD-soittimen avulla. Käsittää sekä digitaalisesti koodattua että analogista kuvaa sisältävät viestimet."@fi,
        "Rörlig bild eller stillbilder som betraktas med hjälp av en bildåtergivande apparat, såsom en videobandspelare eller dvd-spelare. Termen video anknyter till både digitalt och analogt material. Resurser som används med hjälp av videoapparat."@sv ;
    skos:exactMatch rdamt:1008 ;
    skos:inScheme : ;
    skos:prefLabel "video"@en,
        "video"@fi,
        "video"@sv .

:m1064 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m580 ;
    skos:definition "Myönnetään edellisen vuoden merkittävän kaunokirjallisen teoksen erinomaisesta suomennoksesta. Palkinnon myöntää Suomen kääntäjien ja tulkkien liitto. Palkinto perustettiin 1957."@fi,
        "Utdelas för en utmärkt finskspråkig översättning av ett framstående skönlitterärt verk från föregående år. Priset utdelas av Finlands översättar- och tolkförbund. Priset instiftades år 1957."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Mikael Agricola -palkinto, 2020"@fi,
        "I MARC 21-formatet: 586 ## ‡a Mikael Agricola-priset, 2020"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Mikael Agricola -palkinto"@fi,
        "Mikael Agricola-priset"@sv .

:m1065 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m346 ;
    skos:definition """Tietokoneen käsiteltäväksi tarkoitettu digitaalinen sisältö. Esimerkiksi numeerinen data, ympäristödata jne., jota käytetään keskiarvojen, korrelaatioiden jne. laskemiseen tai mallien tms. tuottamiseen, mutta jota tavallisesti ei esitetä sellaisenaan raakamateriaalina.
Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m1592'>liikenotaatio</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m362'>nuottikirjoitus</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m447'>stillkuva</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1620'>teksti</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m450'>kolmiulotteinen muoto</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m912'>kolmiulotteinen liikkuva kuva</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1440'>kaksiulotteinen liikkuva kuva</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m549'>esitetty musiikki</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m478'>ääni</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1105'>puhe</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m4351'>kartografinen data</a>."""@fi,
        "Digitalt innehåll avsett att bearbetas med dator. T.ex. numerisk data eller miljödata som används för att räkna medelvärden, korrelationer o.s.v., och som inte är avsett att återges som sådant. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m1592'>rörelsenotation</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m362'>noterad musik</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m447'>stillbild</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1620'>text</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m450'>tredimensionell form</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m912'>tredimensionell rörlig bild</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1440'>tvådimensionell rörlig bild</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m549'>framförd musik</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m478'>ljud</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1105'>tal</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m4351'>kartografisk data</a>."@sv ;
    skos:exactMatch rdaco:1007 ;
    skos:inScheme : ;
    skos:prefLabel "computer dataset"@en,
        "digitaalinen data"@fi,
        "digitalt dataset"@sv .

