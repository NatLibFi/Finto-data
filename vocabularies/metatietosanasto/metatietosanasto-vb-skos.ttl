        "Sångarens framförande kan vara med eller utan riktiga ord."@sv .

:m5270 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-22"^^xsd:date ;
    skos:altLabel "tekstiteoksen kirjoittaja (yhteisö)"@fi,
