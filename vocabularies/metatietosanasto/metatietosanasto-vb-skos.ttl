    skos:inScheme : ;
    skos:prefLabel "single sides"@en,
        "yksipuolinen"@fi,
        "enkelsidig"@sv .

:m1616 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "Vuoden tiedekirja -palkinto"@fi,
        "Priset Årets vetenskapliga bok"@sv,
        "Årets vetenskapliga bok"@sv ;
    skos:broader :m580 ;
    skos:definition "Tieteellisten seuran valtuuskunnan ja Suomen tiedekustantajien liiton myöntämä kirjallisuuspalkinto Suomessa julkaistulle tutkimuskirjallisuudelle. Palkinto myönnettiin ensimmäisen kerran 1989."@fi,
        "Litteraturpris för forskningslitteratur som publicerats i Finland, beviljat av Vetenskapliga samfundets delegation och Förbundet för vetenskapspublicering i Finland rf. Priset utdelades första gången år 1989."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Vuoden tiedekirja, 2020"@fi,
        "I MARC 21-formatet: 586 ## ‡a Årets vetenskapsbok, 2020"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Vuoden tiedekirja"@fi,
        "Årets vetenskapsbok"@sv .

:m1617 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-07-04"^^xsd:date ;
    skos:altLabel "director of photography"@en,
        "kuvaaja (suhde)"@fi,
