    skos:broader :m5313 ;
    skos:definition "Aggregaattiin kuuluvaan sisältöön liittyvää taustatietoa antava henkilö televisio-ohjelmassa tai elokuvassa."@fi,
        "Person som ger bakgrundsinformation i tv-program eller film, i anslutning till innehåll som hör till ett aggregat."@sv ;
    skos:inScheme : ;
    skos:prefLabel "esittelijä"@fi,
        "presentatör"@sv .

:m5636 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-22"^^xsd:date ;
    skos:altLabel "televisio-ohjelman musiikin säveltäjä (henkilö)"@fi,
        "kompositör (person) av musik till tv-program"@sv ;
    skos:broader :m5464 ;
    skos:definition "A person who is responsible for creating a television program music work that complements a musical work."@en,
        "Henkilö, joka on vastuussa televisio-ohjelmaa täydentävän musiikin luomisesta."@fi,
        "Person som svarar för skapandet av musik som kompletterar ett tv-program."@sv ;
    skos:inScheme : ;
    skos:prefLabel "composer person of television program music work"@en,
        "televisio-ohjelman musiikin säveltäjä"@fi,
        "kompositör av musik till tv-program"@sv .

:m5637 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen panelisti (henkilö)"@fi,
        "deltagare (person) i paneldiskussion som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5313 ;
    skos:definition "Aggregaattiin sisältyvään keskusteluohjelmaan osallistuva henkilö. Paneelikeskusteluissa käsitellään eri aiheita usein niitä tuntevien asiantuntijoiden kesken."@fi,
        "Person som deltar i ett diskussionsprogram som ingår i ett aggregat. I paneldiskussioner behandlas olika ämnen, ofta mellan experter i ämnena."@sv ;
    skos:inScheme : ;
    skos:prefLabel "panelisti"@fi,
        "deltagare i paneldiskussion"@sv .

:m5639 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-03"^^xsd:date ;
    skos:altLabel "collotypist corporate body"@en,
        "kollotypian valmistaja (yhteisö)"@fi,
        "framställare av ljustryck (institution)"@sv ;
    skos:broader :m5654 ;
    skos:definition "Yhteisö, joka on vastuussa manifestaation valmistamisesta tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja. (RDA Registry)"@fi,
        "Institution som svarar för tillverkning av en manifestation, genom att göra fotografiska avtryck direkt från härdad gelatinfilm eller annat material med bläckmottagande och bläckavvisande ytor."@sv ;
    skos:exactMatch rdam:P30415 ;
    skos:inScheme : ;
    skos:prefLabel "collotyper corporate body"@en,
        "kollotypian valmistaja"@fi,
        "framställare av ljustryck"@sv .

:m5642 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-04"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen kuvaaja (henkilö)"@fi,
        "filmfotograf (person) som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5313 ;
    skos:definition "Aggregaattiin sisältyvän liikkuvan kuvan joko digitaalisesti, filmille tai videolle tallentava henkilö. Voi hoitaa myös valaistuksen. Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."@fi,
        "Person som spelar in rörlig bild som ingår i ett aggregat antingen digitalt, på film eller på video. Kan även sköta belysning."@sv ;
    skos:inScheme : ;
    skos:prefLabel "kuvaaja"@fi,
        "filmfotograf"@sv .

:m5643 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
    skos:altLabel "videon musiikin säveltäjä (yhteisö)"@fi,
        "kompositör (institution) av videomusik"@sv ;
    skos:broader :m5350 ;
    skos:definition "A corporate body who is responsible for creating a video music work that complements a musical work."@en,
        "Yhteisö, joka on vastuussa videota täydentävän musiikin luomisesta."@fi,
        "Institution som svarar för skapandet av musik som kompletterar en video."@sv ;
    skos:inScheme : ;
    skos:prefLabel "composer corporate body of video music work"@en,
        "videon musiikin säveltäjä"@fi,
        "kompositör av videomusik"@sv .

:m5644 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
    skos:altLabel "toimituspäällikkö (henkilö)"@fi,
        "redaktionschef (person)"@sv ;
    skos:broader :m5514 ;
    skos:definition "Henkilö, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä. (RDA Registry)"@fi,
        "Person som har ett juridiskt eller kunskapsmässigt ansvar, men inte kreativt ansvar för ett diakroniskt verks redaktionella linje och innehåll."@sv ;
    skos:exactMatch rdaw:P10417 ;
    skos:inScheme : ;
    skos:prefLabel "editorial director person"@en,
        "toimituspäällikkö"@fi,
        "redaktionschef"@sv ;
    skos:scopeNote "Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta. (RDA Registry)"@fi,
        "Gäller inte justering, förtydligande eller annan ändring av innehållet i ett verks uttryck."@sv .

:m565 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-04-12"^^xsd:date ;
    skos:altLabel "författarens signatur"@sv,
        "skaparens signatur"@sv,
        "upphovsmannens signatur"@sv ;
    skos:broader :m653 ;
    skos:inScheme : ;
    skos:prefLabel "tekijän signeeraus"@fi,
        "upphovspersonens signatur"@sv .

:m5652 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "puhuja (yhteisö)"@fi,
        "talare (institution)"@sv ;
    skos:broader :m5266 ;
    skos:definition "Yhteisö, joka on esittäjä, joka osallistuu teoksen ekspression tekemiseen puhumalla sanoja. (RDA Registry)"@fi,
        "Institution som är en framförare som deltar i utförandet av ett verks uttryck genom att tala ord."@sv ;
    skos:exactMatch rdae:P20498 ;
    skos:inScheme : ;
    skos:prefLabel "speaker corporate body"@en,
        "puhuja"@fi,
        "talare"@sv ;
    skos:scopeNote "Sisältää luennon tai puheen. (RDA Registry)"@fi,
        "Inbegriper en föreläsning eller ett tal."@sv .

:m5656 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
    skos:altLabel "editor"@en,
        "editor agent of text"@en,
        "toimittaja (toimija)"@fi,
        "redaktör (aktör)"@sv ;
    skos:broader :m5684 ;
    skos:definition "Toimija, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi. (RDA Registry)"@fi,
        "Aktör som deltar i utförandet av ett uttryck, genom att justera innehåll som skapats av andra aktörer, för att uppfylla utgivnings- och andra bruksstandarder."@sv ;
    skos:exactMatch rdae:P20330 ;
    skos:inScheme : ;
    skos:prefLabel "editor agent"@en,
        "toimittaja"@fi,
        "redaktör"@sv ;
    skos:scopeNote "Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti. (RDA Registry)"@fi,
        "Till innehåll hör rörelsenotation, taktil rörelsenotation, taktil musiknotation, taktil text och text."@sv .

:m5657 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "puhuja (henkilö)"@fi,
        "talare (person)"@sv ;
    skos:broader :m5289 ;
    skos:definition "Henkilö, joka on esittäjä, joka osallistuu teoksen ekspression tekemiseen puhumalla sanoja. (RDA Registry)"@fi,
        "Person som är en framförare som deltar i utförandet av ett verks uttryck genom att tala ord."@sv ;
    skos:exactMatch rdae:P20380 ;
    skos:inScheme : ;
    skos:prefLabel "speaker person"@en,
        "puhuja"@fi,
        "talare"@sv ;
    skos:scopeNote "Sisältää luennon tai puheen. (RDA Registry)"@fi,
        "Inbegriper en föreläsning eller ett tal."@sv .

:m5658 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-04-16"^^xsd:date ;
    skos:altLabel "animaattori (henkilö)"@fi,
        "animatör (person)"@sv ;
    skos:broader :m5302 ;
    skos:definition "Henkilö, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin. (RDA Registry)"@fi,
        "Person som deltar i skapandet av ett uttryck genom att ge skenbar rörelse åt livlösa objekt eller teckningar."@sv ;
    skos:exactMatch rdae:P20394 ;
    skos:inScheme : ;
    skos:prefLabel "animator person"@en,
        "animaattori"@fi,
        "animatör"@sv ;
    skos:scopeNote "Ei koske animaatiopiirrosten tekijää. (RDA Registry)"@fi,
        "Gäller inte skapare av animationsteckningar."@sv .

:m5659 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-15"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen opettaja (yhteisö)"@fi,
        "lärare (institution) som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5470 ;
    skos:definition "Aggregaattiin sisältyvässä AV-aineistossa opettava tai asiaa esittelevä yhteisö."@fi,
        "Institution som undervisar eller förevisar en sak i AV-material som ingår i ett aggregat."@sv ;
    skos:inScheme : ;
    skos:prefLabel "opettaja"@fi,
        "lärare"@sv .

:m566 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-03-13"^^xsd:date ;
    skos:broader :m654 ;
    skos:definition "Epämetallisista mineraaleista kuten savesta muodostuva pohjamateriaali, joka on poltettu korkeassa lämpötilassa, tuloksena kova, hauras, kuumuuden ja kulutuksenkestävä materiaali."@fi,
        "Basmaterial bildat av icke-metalliska mineraler såsom lera, som bränts i hög temperatur med ett hårt och skört, värmetåligt och slitstarkt material som resultat."@sv ;
    skos:exactMatch rdamat:1007 ;
    skos:inScheme : ;
    skos:prefLabel "ceramic"@en,
        "keramiikka"@fi,
        "keramik"@sv .

:m5661 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-21"^^xsd:date ;
    skos:altLabel "säilyttäjä (yhteisö)"@fi,
        "förvaltare"@sv,
        "förvarare (institution)"@sv ;
    skos:broader :m5779 ;
    skos:definition "Yhteisö, jolla on kappaleen laillinen säilyttämisoikeus. (RDA Registry)"@fi,
        "Institution som har juridisk förvaringsrätt till ett exemplar."@sv ;
    skos:exactMatch rdai:P40135 ;
    skos:inScheme : ;
    skos:prefLabel "custodian corporate body"@en,
        "säilyttäjä"@fi,
        "förvarare"@sv .

:m5662 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-15"^^xsd:date ;
    skos:altLabel "digitaaliseen sisältöön osallinen ohjelmoija (yhteisö)"@fi,
        "programmerare (institution) som är bidragsgivare till digitalt innehåll"@sv ;
    skos:broader :m5298 ;
    skos:definition "Aggregaattiin sisältyvän digitaalisen sisällön yhteisötekijä."@fi,
        "Upphovsinstitution till digitalt innehåll som ingår i ett aggregat."@sv ;
    skos:inScheme : ;
    skos:prefLabel "ohjelmoija"@fi,
        "programmerare"@sv .

:m5663 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-04"^^xsd:date ;
    skos:altLabel "lavastaja (yhteisö)"@fi,
        "scenograf (institution)"@sv ;
    skos:broader :m5499 ;
    skos:definition "Yhteisö, joka osallistuu ekspression tekemiseen valvomalla taiteilijoita ja käsityöläisiä, jotka rakentavat lavasteita elokuvatuotantoihin. (RDA Registry)"@fi,
        "Institution som deltar i utförandet av ett uttryck, genom att övervaka konstnärer och hantverkare som bygger kulisser för filmproduktioner."@sv ;
    skos:exactMatch rdae:P20468 ;
    skos:inScheme : ;
    skos:prefLabel "art director corporate body"@en,
        "lavastaja"@fi,
        "scenograf"@sv .

:m5664 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-27"^^xsd:date ;
    skos:altLabel "äänituottaja (yhteisö)"@fi,
        "ljudproducent (institution)"@sv ;
    skos:broader :m5326 ;
    skos:definition "Yhteisö, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta. (RDA Registry)"@fi,
        "Institution som är en producent, som svarar för skötseln av de flesta kommersiella uppgifterna kring en ljudinspelning."@sv ;
    skos:exactMatch rdaw:P10515 ;
    skos:inScheme : ;
    skos:prefLabel "audio producer corporate body"@en,
        "äänituottaja"@fi,
        "ljudproducent"@sv .

:m5665 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-19"^^xsd:date ;
    skos:altLabel "sovittaja (henkilö)"@fi,
        "arrangör (person)"@sv ;
    skos:broader :m5548 ;
    skos:definition "Henkilö, joka osallistuu teoksen ekspression tekemiseen muokkaamalla sävellyksen alkuperäisteoksesta poikkeavalle esityskokoonpanolle. (RDA Registry)"@fi,
        "Person som deltar i utförandet av ett verks uttryck, genom att omarbeta kompositionen för en musikalisk besättning som avviker från originalverket."@sv ;
    skos:exactMatch rdae:P20365 ;
    skos:inScheme : ;
    skos:prefLabel "arranger person of music"@en,
        "sovittaja"@fi,
        "arrangör"@sv ;
    skos:scopeNote "Sovittaja voi myös muokata teosta samalle esityskokoonpanolle tms. säilyttäen alkuperäisen sävellyksen musiikillisen sisällön olennaisilta osin muuttumattomana. Tähän ei sisälly laaja muokkaaminen, joka johtaa uuden musiikkiteoksen luomiseen. (RDA Registry)"@fi,
        "En arrangör kan också bearbeta verket för samma musikaliska besättning eller dylikt och bevara originalkompositionens musikaliska innehåll till sina väsentliga delar oförändrade. I detta ingår inte omfattande ändringar som leder till skapandet av ett nytt musikverk."@sv .

:m5667 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "panelisti (henkilö)"@fi,
        "deltagare (person) i paneldiskussion"@sv,
        "paneldeltagare"@sv ;
    skos:broader :m5289 ;
    skos:definition "Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)"@fi,
        "Person som är en framförare som deltar i utförandet av ett uttryck, genom att delta i ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter inom ämnen som relaterar till diskussionen."@sv ;
    skos:exactMatch rdae:P20375 ;
    skos:inScheme : ;
    skos:prefLabel "panelist person"@en,
        "panelisti"@fi,
        "deltagare i paneldiskussion"@sv .

:m5668 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "paperinvalmistaja (henkilö)"@fi,
        "pappersmakare"@sv,
        "papperstillverkare (person)"@sv ;
    skos:broader :m5972 ;
    skos:definition "Henkilö, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta. (RDA Registry)"@fi,
        "Person som svarar för tillverkningen av papper som använts i en manifestation."@sv ;
    skos:exactMatch rdam:P30364 ;
    skos:inScheme : ;
    skos:prefLabel "papermaker person"@en,
        "paperinvalmistaja"@fi,
        "papperstillverkare"@sv .

:m5671 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-05"^^xsd:date ;
    skos:altLabel "litografi (yhteisö)"@fi,
        "litograf (institution)"@sv ;
    skos:broader :m5487 ;
    skos:definition "Yhteisö, joka on vastuussa manifestaation valmistamisesta valmistamalla litografiassa käytetyn kivilaatan tai muun painolaatan. (RDA Registry)"@fi,
        "Institution som svarar för tillverkning av en manifestation, genom att tillverka en stenplatta eller någon annan tryckplåt som används i litografi."@sv ;
    skos:exactMatch rdam:P30412 ;
    skos:inScheme : ;
    skos:prefLabel "lithographer corporate body"@en,
        "litografi"@fi,
        "litograf"@sv ;
    skos:scopeNote "Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle. (RDA Registry)"@fi,
        "Avser också grafiker som gör en teckning direkt på en yta som används för tryckning."@sv .

:m5673 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-05"^^xsd:date ;
    skos:altLabel "litografi (henkilö)"@fi,
        "litograf (person)"@sv ;
    skos:broader :m5563 ;
    skos:definition "Henkilö, joka on vastuussa manifestaation valmistamisesta valmistamalla litografiassa käytetyn kivilaatan tai muun painolaatan. (RDA Registry)"@fi,
        "Person som svarar för tillverkning av en manifestation, genom att tillverka en stenplatta eller någon annan tryckplåt som används i litografi."@sv ;
    skos:exactMatch rdam:P30354 ;
    skos:inScheme : ;
    skos:prefLabel "lithographer person"@en,
        "litografi"@fi,
        "litograf"@sv ;
    skos:scopeNote "Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle. (RDA Registry)"@fi,
        "Avser också grafiker som gör en teckning direkt på en yta som används för tryckning."@sv .

:m5676 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-19"^^xsd:date ;
    skos:altLabel "radiotuottaja (henkilö)"@fi,
        "radioproducent (person)"@sv ;
    skos:broader :m5817 ;
    skos:definition "Henkilö, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta. (RDA Registry)"@fi,
        "Person som är en producent, som svarar för största delen av affärsverksamheten kring ett radioprogram."@sv ;
    skos:exactMatch rdaw:P10423 ;
    skos:inScheme : ;
    skos:prefLabel "radio producer person"@en,
        "radiotuottaja"@fi,
        "radioproducent"@sv .

:m5678 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-21"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen taltioija (yhteisö)"@fi,
        "inspelande aktör (institution) som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5470 ;
    skos:definition "Aggregaattiin sisältyvää ääntä tai videota tallennuslaitteen avulla taltioiva yhteisö. Esimerkiksi luonnonäänten, folkloren, musiikin tms. kenttätallennukset."@fi,
        "Institution som spelar in ljud eller video som ingår ett aggregat, med hjälp av en inspelningsapparat. T.ex. fältinspelningar av naturljud, folklore, musik eller dylikt."@sv ;
    skos:inScheme : ;
    skos:prefLabel "taltioija"@fi,
        "inspelande institution"@sv .

