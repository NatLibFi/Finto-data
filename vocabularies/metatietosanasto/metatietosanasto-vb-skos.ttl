    skos:broader :m5282 ;
    skos:definition "Henkilö, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville. (RDA Registry)"@fi,
        "Person som svarar för distributionen av en film eller annan dylik manifestation till biografer eller andra distributionskanaler."@sv ;
    skos:exactMatch rdam:P30348 ;
    skos:inScheme : ;
    skos:prefLabel "film distributor person"@en,
