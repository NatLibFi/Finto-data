:m1078 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m346 ;
    skos:definition "Kielen merkkijärjestelmällä esitetty sisältö, joka on tarkoitettu kosketeltavaksi. Esimerkiksi pistekirjoitus ja muut taktiilit tekstinkirjoitusmuodot."@fi,
        "Innehåll uttryckt med teckensystem för språk, avsett att vidröras. T.ex. punktskrift och andra former av taktil text."@sv ;
    skos:exactMatch rdaco:1018 ;
    skos:inScheme : ;
