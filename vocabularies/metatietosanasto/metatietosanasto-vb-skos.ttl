:m362 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:altLabel "notated music"@en,
        "musiknotation"@sv,
        "notskrift"@sv ;
    skos:broader :m346 ;
    skos:definition """Musiikkinotaationa esitetty sisältö, joka on tarkoitettu katsottavaksi. Sisältää kaikki muut kuin kosketeltavassa muodossa olevat musiikkinotaatiot.
Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m586'>taktiili nuottikirjoitus</a>."""@fi,
        "Innehåll uttryckt med hjälp av musiknotation, avsett att betraktas. Omfattar alla former av musiknotation, med undantag för notation avsedd att vidröras. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m586'>taktil musiknotation</a>."@sv ;
    skos:exactMatch rdaco:1010 ;
    skos:inScheme : ;
    skos:prefLabel "nuottikirjoitus"@fi,
        "noterad musik"@sv .

