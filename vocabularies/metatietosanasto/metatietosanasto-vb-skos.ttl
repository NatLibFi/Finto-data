:m6033 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2025-09-05"^^xsd:date ;
    dct:modified "2025-10-18"^^xsd:date ;
    skos:broader :m1990 ;
    skos:definition "Nuottikirjoituksen tyyppi, joka on yleensä luettavissa myös viivastonuottikirjoituksena, jossa sävelkorkeudet merkitään käyttämällä nuottien päissä esimerkiksi erilaisia geometrisia muotoja ja värejä."@fi,
        "Typ av notskrift, som vanligen även kan läsas som traditionell västerländsk notskrift och i vilken tonhöjderna anges genom att använda olika geometriska former och färger."@sv ;
    skos:inScheme : ;
    skos:prefLabel "kuvionuottikirjoitus"@fi,
        "figurnotation"@sv .

