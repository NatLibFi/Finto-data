        "sisarukset (suku)"@fi,
        "suku (suvun kategoria)"@fi,
        "sukulaiset"@fi,
        "talonpoikaissuku"@fi,
        "adelssläkt"@sv,
        "adelsätt"@sv,
        "allmogesläkt"@sv,
        "bondesläkt"@sv,
