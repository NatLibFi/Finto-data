        "korrigeringsblad"@sv ;
    skos:broader :m8 ;
    skos:definition "Laajuuden yksikkö joka koostuu arkista, johon on koottu julkaisussa havaittujen virheiden luettelo oikaisuineen."@fi,
        "Enhet som består av ett ark, med en förteckning över fel som observerats i publikationen, jämte rättelser av dessa."@sv ;
    skos:inScheme : ;
    skos:prefLabel "korjauslehti"@fi,
        "rättelseblad"@sv .

:m4964 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
