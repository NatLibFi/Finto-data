:m5342 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-27"^^xsd:date ;
    skos:altLabel "ääninäyttelijä (henkilö)"@fi,
        "röstskådespelare (person)"@sv ;
    skos:broader :m5645 ;
    skos:definition "Henkilö, joka on näyttelijä, joka osallistuu ekspression tekemiseen antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms. (RDA Registry)"@fi,
        "Person som är en skådespelare, som deltar i utförandet av ett uttryck, genom att ge röst åt karaktärer i radio- och ljudproduktioner och animerade karaktärer i filmverk, samt genom att framträda i radio- och tv-reklarm, i dubbade uttryck etc."@sv ;
    skos:exactMatch rdae:P20384 ;
    skos:inScheme : ;
    skos:prefLabel "voice actor person"@en,
        "ääninäyttelijä"@fi,
        "röstskådespelare"@sv .

:m5345 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-05"^^xsd:date ;
    skos:altLabel "lyhentäjä (yhteisö)"@fi,
        "förkortad av (institution)"@sv ;
    skos:broader :m5739 ;
    skos:definition "Yhteisö, joka osallistuu ekspression tekemiseen lyhentämällä siihen liittyvän teoksen ekspressiota muuttamatta esityksen yleistä sisältöä tai tyyliä. (RDA Registry)"@fi,
        "Institution som deltar i skapandet av ett uttryck, genom att förkorta ett relaterat verks uttryck utan att förändra framställningens allmänna innehåll eller stil."@sv ;
    skos:exactMatch rdae:P20475 ;
    skos:inScheme : ;
    skos:prefLabel "abridger corporate body"@en,
        "lyhentäjä"@fi,
        "förkortad av"@sv ;
    skos:scopeNote "Ei koske oleellista muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)"@fi,
        "Gäller inte betydande ändringar, som leder till skapandet av ett nytt verk."@sv .

:m5346 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
