        "undervisnings- och kulturministeriet, skolstyrelsen, Riksarkivet, Museiverket, folkskoleinspektörer, Finlands Akademi, biblioteksinspektörer, skolverk"@sv ;
    skos:inScheme : ;
    skos:prefLabel "opetus- ja kulttuurihallinto"@fi,
        "undervisnings- och kulturförvaltning"@sv .

:m3616 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p19511 ;
    skos:altLabel "kulttuuriala"@fi,
        "kulttuuritoiminta"@fi,
        "peliala"@fi,
        "taideala"@fi,
        "viihde"@fi,
        "konstbranschen"@sv,
        "kultur- och underhållningsbranschen"@sv,
        "kulturbranschen"@sv,
        "kulturverksamhet"@sv,
        "spelbranschen"@sv,
        "underhållning"@sv ;
    skos:broader :m3661 ;
    skos:definition "Kirjastot, arkistot, museot ja muut kulttuurilaitokset, viihdelaitokset sekä muut kulttuuri- ja viihdepalveluja, mukaan lukien rahapeli-, vedonlyönti- ja videopelipalveluja tuottavat toimijat. Pääluokkaan eivät kuulu urheilu- ja virkistyspalveluja tuottavat toimijat (ks. urheilu- ja virkistystoiminta)."@fi,
        "Bibliotek, arkiv, muséer och andra kulturinstitutioner, institutioner för underhållning samt aktörer som producerar andra kultur- och underhållningstjänster, inklusive spel om pengar, vadslagnings-, och videospelstjänster. Till huvudkategorin hör inte aktörer som producerar idrotts- och rekreationstjänster (se idrotts- och rekreationsverksamhet)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "kulttuuri- ja viihdeala"@fi,
        "kultur- och nöjesbranschen"@sv .

:m3617 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
