        "koloni"@sv,
        "protektorat"@sv ;
    skos:broader :m4872 ;
    skos:closeMatch yso:p8709 ;
    skos:definition "Jonkin valtion alainen, yleensä sen rajojen ulkopuolinen epäitsenäinen alue. Myös aluetta hallinnoiva yhteisö."@fi,
        "Osjälvständigt område i någon stats besittning, vanligtvis utanför statens egna gränser. Även institution som förvaltar området."@sv ;
    skos:example "Kapmaa; Saksan Uusi-Guinea; Uusi-Ranska"@fi,
