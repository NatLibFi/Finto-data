        "mikrofichekassett"@sv ;
    skos:scopeNote "Mikromuotoinen tallenne."@fi,
        "Mikroformsbärare."@sv .

:m2039 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-07-05"^^xsd:date ;
    skos:broader :m8 ;
    skos:definition "Populaari- tai kansanmusiikin nuottiaineisto, joka koostuu sävelmänuoteista eli vokaali- ja/tai soitinteosten yksinkertaistetuista nuotinnoksista (sisältävät yleensä pelkästään melodian ja sointumerkit tai melodian yksinkertaistetulla pianosäestyksellä)."@fi,
        "Notmaterial för populär- eller folkmusik, bestående av melodinoter, alltså förenklade noter för vokala och/eller instrumentala verk (innehåller vanligen endast melodi och ackordbeteckningar eller melodi med förenklat pianoackompanjemang)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "sävelmäkokoelma"@fi,
        "melodisamling"@sv .

