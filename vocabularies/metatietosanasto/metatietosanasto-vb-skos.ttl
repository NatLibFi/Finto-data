:m4868 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2021-11-26"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:altLabel "kuningasperhe"@fi,
        "kungafamilj"@sv ;
    skos:broader :m4865 ;
    skos:closeMatch yso:p9666 ;
    skos:definition "Hallitsijasuku, jota kutsutaan dynastiaksi. Laajemmin hallitsevasta, määräävässä asemassa olevasta ryhmästä (Kielitoimiston sanakirja)."@fi,
        "Regentsläkt som benämns dynasti. Vidare om härskande grupp i dominerande ställning."@sv ;
    skos:example "Pahlavi (dynastia : 1925-1979); Romanov (dynastia : 1613-1917)"@fi,
        "Pahlavi (dynasti : 1925-1979); Romanov (dynasti : 1613-1917)"@sv ;
    skos:inScheme : ;
    skos:prefLabel "dynasty"@en,
        "dynastia"@fi,
        "dynasti"@sv .

:m4869 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2021-11-26"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:altLabel "kuningasperhe"@fi,
        "kuningassuku"@fi,
        "kungafamilj"@sv,
        "kungasläkt"@sv ;
    skos:broader :m4865 ;
    skos:closeMatch yso:p9662 ;
    skos:definition "Kuningasperhe tai -suku (Kielitoimiston sanakirja). Termiä käytetään, kun viitataan hallitsevassa asemassa olevaan kuningasperheeseen tai -sukuun. Kuningashuoneen mahdollisesti muodostamasta dynastiasta käytetään termiä <a href='http://urn.fi/URN:NBN:fi:au:mts:m4868'>dynastia</a>."@fi,
        "Kungafamilj eller -släkt. Termen används när man hänvisar till en regerande kungafamilj eller -släkt. Om dynasti som ett kungahus eventuellt bildar används termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m4868'>dynasti</a>."@sv ;
    skos:example "Bernadotte (kuningashuone : 1818- : Ruotsi); Bourbon (kuningashuone); Windsor (kuningashuone : 1917- : Iso-Britannia)"@fi,
        "Bernadotte (kungahus : 1818- : Sverige); Bourbon (kungahus); Windsor (kungahus : 1917- : Storbritannien)"@sv ;
    skos:inScheme : ;
    skos:prefLabel "royal house"@en,
        "kuningashuone"@fi,
        "kungahus"@sv .

