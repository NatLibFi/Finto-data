:m1091 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "tre gånger i veckan"@sv ;
    skos:broader :m291 ;
    skos:definition "Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kolme kertaa viikossa."@fi,
        "Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras tre gånger i veckan."@sv ;
    skos:exactMatch rdafr:1002 ;
    skos:inScheme : ;
    skos:prefLabel "three times a week"@en,
        "kolme kertaa viikossa"@fi,
        "tre gånger per vecka"@sv .

:m1096 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
    skos:altLabel "transcriber"@en,
        "transkr. (transkriboija)"@fi,
        "transkriboija (toimija)"@fi,
        "transkr. (transkriberare)"@sv,
        "transkriberare (aktör)"@sv ;
    skos:broader :m5705 ;
    skos:definition "Toimija, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen. (RDA Registry)"@fi,
        "Aktör som deltar i utförandet av ett uttryck, genom att uppteckna eller skriva ner noter för ett oskrivet eller onoterat innehåll eller ändra dess notationssystem till ett annat."@sv ;
    skos:exactMatch rdae:P20034 ;
    skos:inScheme : ;
    skos:prefLabel "transcriber agent"@en,
        "transkriboija"@fi,
        "transkriberare"@sv ;
    skos:scopeNote "Tähän ei kuulu musiikkiteoksen transkribointi eri soittimelle tai esitysryhmälle. (RDA Registry)"@fi,
        "Hit hör inte transkribering av ett musikverk för ett annat instrument eller en annan framförande grupp."@sv .

:m1099 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m653 ;
    skos:inScheme : ;
    skos:prefLabel "exlibris"@fi,
        "exlibris"@sv ;
    skos:scopeNote "Henkilön/yhteisön nimi"@fi,
        "Persons/institutions namn"@sv .

:m1105 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-11-04"^^xsd:date ;
    skos:altLabel "tal (ljudinnehåll)"@sv ;
    skos:broader :m346 ;
    skos:definition "Kuunneltavaksi tarkoitettu kielellinen sisältö. Sisältää esim. puheäänitteet, runonlausunnat, puheet, haastattelut, suulliset tarinat, tietokoneella tuotetun puheen jne."@fi,
        "Språkligt innehåll avsett att lyssnas på. Omfattar inbandade tal, poesiuppläsning, tal (föredrag), intervjuer, muntliga berättelser, tal producerat på dator o.s.v."@sv ;
    skos:exactMatch rdaco:1013 ;
    skos:inScheme : ;
    skos:prefLabel "spoken word"@en,
        "puhe"@fi,
        "tal"@sv .

:m1111 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-10-04"^^xsd:date ;
    skos:broader :m417 ;
    skos:inScheme : ;
    skos:prefLabel "valopaino"@fi,
        "ljustryck"@sv .

:m1114 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m580 ;
    skos:definition "Kirjallisuuspalkinto, jota Kirjakauppaliitto, Libro ja Suomen Kirjastoseura ovat jakaneet vuodesta 1966. Palkinto annetaan kotimaiselle kirjailijalle, jonka edellisen vuoden suomen- tai ruotsinkielinen teos on elähdyttänyt kaunokirjallisuutta."@fi,
        "Litteraturpris som har utdelats av Bokhandelsförbundet, Libro och Finlands biblioteksförening sedan 1966. Priset utdelas åt en inhemsk författare, som föregående år gett ut ett stimulerande skönlitterärt verk på finska eller svenska."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Kiitos kirjasta -mitali, 1966"@fi,
        "I MARC 21-formatet: 586 ## ‡a Tack för boken-medaljen, 1966"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Kiitos kirjasta -mitali"@fi,
        "Tack för boken-medaljen"@sv .

:m1116 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "magneettiset partikkelit"@fi,
        "magnetiska partiklar"@sv ;
    skos:broader :m654 ;
    skos:definition "Materiaali, joka on luonnollista tai synteettistä epäorgaanista yhdistettä ja joka muodostuu erittäin magneettisista partikkeleista. Käytetään tavallisesti binaaristen tai analogisten tietojen tallentamiseen."@fi,
        "Material som är naturlig eller syntetisk oorganisk förening och som bildas av mycket magnetiska partiklar. Används vanligen gällande lagring av binär eller analog data."@sv ;
    skos:exactMatch rdamat:1021 ;
    skos:inScheme : ;
    skos:prefLabel "magnetic particles"@en,
        "magneettijauhe"@fi,
        "magnetpulver"@sv .

:m1118 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "panelist"@en,
        "panelisti (toimija)"@fi,
        "deltagare i paneldiskussion (aktör)"@sv,
        "paneldeltagare"@sv ;
    skos:broader :m1060 ;
    skos:definition "Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)"@fi,
        "Aktör som är en framförare som deltar i utförandet av ett uttryck, genom att delta i ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter inom ämnen som relaterar till diskussionen."@sv ;
    skos:exactMatch rdae:P20019 ;
    skos:inScheme : ;
    skos:prefLabel "panelist agent"@en,
        "panelisti"@fi,
        "deltagare i paneldiskussion"@sv .

:m1122 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-03-13"^^xsd:date ;
    skos:broader :m654 ;
    skos:definition "Materiaali, joka on valmistettu prosessoimalla keinotekoisia materiaaleja, yleensä luonnollisten materiaalien korvaajana."@fi,
        "Material som har tillverkats genom att bearbeta konstgjorda material, vanligen som ersättning för naturliga material."@sv ;
    skos:exactMatch rdamat:1037 ;
    skos:inScheme : ;
    skos:prefLabel "synthetic"@en,
        "synteettinen"@fi,
        "syntetisk"@sv .

:m1123 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m580 ;
    skos:definition "Jaetaan vuosittain ansiokkaan romaanin kirjoittajalle. Palkinto perustettiin vuonna 1984. Alun perin palkinto myönnettiin mille tahansa kaunokirjalliselle teokselle mutta vuodesta 1993 sen on voinut saada vain romaani."@fi,
        "Utdelas årligen åt en författare som skrivit en meriterad roman. Priset grundades år 1984. Ursprungligen utdelades priset åt vilken skönlitterär genre som helst, men från och med år 1993 har endast romaner kunnat få priset."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Finlandia-palkinto, 2020"@fi,
        "I MARC 21-formatet: 586 ## ‡a Finlandiapriset, 2020"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Finlandia-palkinto"@fi,
        "Finlandiapriset"@sv .

