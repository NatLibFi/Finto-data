        "oppilaskunta"@fi,
        "osakunta"@fi,
        "paliskunta"@fi,
        "riistanhoitoyhdistys"@fi,
        "uittoyhdistys"@fi,
        "elevkår"@sv,
        "fiskeriområde"@sv,
        "flottningsförening"@sv,
