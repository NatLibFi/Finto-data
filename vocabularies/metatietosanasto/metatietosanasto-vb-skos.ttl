:m2209 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2018-06-01"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m1374 ;
    skos:definition "Kahta tai usempaa kohteeseen sisältyvää teosta tai teoksen osaa identifioidessa merkitään auktorisoitu hakutieto tai vakiintunut kokoava nimeke, jota seuraa sana Valikoima. Valikoima voidaan merkitä myös kahta tai useampaa numeroimatonta tai muuta kuin peräkkäistä osaa identifioitaessa osien ensisijaiseksi nimekkeeksi"@fi,
        "För att identifiera ett objekt i vilket två eller flera verk eller delar av verk ingår används auktoriserad sökterm eller grupptitel, följd av ordet Urval. Urval kan också användas som föredragen titel för att identifiera två eller flera onumrerade delar eller delar som inte är efterföljande."@sv ;
    skos:example "Homeros. Ilias. Valikoima."@fi,
        "Sullivan, Arthur, 1842-1900. Oopperat. Valikoima. Libretot."@fi,
        "The Simpsons (televisio-ohjelma). Valikoima."@fi,
        "Homeros. Illiaden. Urval."@sv,
        "Sullivan, Arthur, 1842-1900. Operor. Urval. Libretton."@sv ;
    skos:inScheme : ;
    skos:prefLabel "Valikoima"@fi,
        "Urval"@sv .

:m2210 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2018-06-01"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m580 ;
    skos:definition "Myönnetään suomen- tai ruotsinkieliselle lastenkirjalle, jonka kohderyhmänä ovat 6-9-vuotiaat lapset. Palkinto myönnettiin ensimmäisen kerran 5.2.2017"@fi,
        "Priset tilldelas en finsk- eller svenskspråkig barnbok som riktas till åldergruppen 6-9 år. Det utdelades första gången den 5.2.2017."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Runeberg Junior -palkinto, 2020"@fi,
        "I MARC 21-formatet: 586 ## ‡a Runeberg Junior-priset, 2020"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Runeberg Junior -palkinto"@fi,
        "Runeberg Junior-priset"@sv .

