:m3613 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p13916,
        yso:p26126 ;
    skos:altLabel "hyvinvointiala"@fi,
        "sosiaaliala"@fi,
        "terveysala"@fi,
        "hälso- och socialvårdssektorn"@sv,
        "hälsovårdsbranschen"@sv,
        "socialvårdsbranschen"@sv ;
    skos:broader :m3661 ;
    skos:definition "Terveydenhuollon laitospalveluita, lääkäripalveluita ja muita terveys- ja hyvinvointipalveluita (esim. fysioterapia, psykoterapia, laboratoriotutkimukset, sairaankuljetus, kauneudenhoito) sekä sosiaalihuollon laitos- ja avopalveluja tuottavat toimijat. Pääluokkaan kuuluvat myös toimijat, jotka tarjoavat terveys- ja sosiaalipalveluja muiden pääluokkien edustamien toimialojen viiteryhmille."@fi,
        "Aktörer som producerar hälsovårdens anstaltsvård, läkartjänster och andra hälsovårds- och välfärdstjänster (t.ex. fysioterapi, psykoterapi, laboratorieundersökningar, sjuktransport, skönhetsvård), samt socialvårdens anstalts- och öppenvårdstjänster. Till huvudkategorin hör även aktörer som erbjuder hälso- och socialvårdstjänster till referensgrupper inom verksamhetsområden som representeras av andra huvudkategorier."@sv ;
    skos:inScheme : ;
    skos:prefLabel "terveys- ja sosiaaliala"@fi,
        "hälso- och socialvårdsbranschen"@sv .

:m3614 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
