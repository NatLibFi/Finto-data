    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m245 ;
    skos:definition "Negatiivisen polariteetin filmi, joka on valotettu kamerassa ja joka siksi yleensä on parempilaatuinen kuin seuraava sukupolvi tai johdannainen."@fi,
        "Film med negativ polaritet som har exponerats i kameran, och som därför vanligen är av bättre kvalitet än nästa generation eller härledning."@sv ;
    skos:exactMatch rdagen:1013 ;
    skos:inScheme : ;
    skos:prefLabel "original negative"@en,
        "alkuperäinen negatiivi"@fi,
        "originalnegativ"@sv .

:m4363 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-26"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m291 ;
    skos:definition "Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kaksi kertaa vuodessa."@fi,
        "Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras två gånger i året."@sv ;
    skos:exactMatch rdafr:1012 ;
    skos:inScheme : ;
    skos:prefLabel "semiannual"@en,
        "kaksi kertaa vuodessa"@fi,
        "två gånger per år"@sv .

:m4364 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-26"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "vertailukopio"@fi ;
    skos:broader :m245 ;
    skos:definition "Sukupolven määrite, joka on elokuvan tuottajan ja ohjaajan hyväksymä koevedos."@fi,
        "Bestämning av generation, som är en referenskopia godkänd av filmproducent och -regissör."@sv ;
    skos:exactMatch rdagen:1011 ;
    skos:inScheme : ;
    skos:prefLabel "reference print"@en,
        "koevedos"@fi,
        "referenskopia"@sv .

:m4365 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-26"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m245 ;
    skos:definition "Sukupolven määrite, joka on aikaisemman sukupolven negatiivifilmistä valmistettu positiivivedos, ja jota käytetään negatiivikopioiden valmistamiseksi kuvien sijaan."@fi,
        "Bestämning av generation, som är en positivkopia tillverkad av en tidigare generations negativfilm, och som används för att tillverka negativkopior i stället för bilder."@sv ;
    skos:exactMatch rdagen:1012 ;
    skos:inScheme : ;
    skos:prefLabel "master positive"@en,
        "master-positiivi"@fi,
        "master positiv"@sv .

:m4366 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-26"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m245 ;
    skos:definition "Sukupolven määrite, joka on alkuperäisen kuvan tai ääniraidan jäljitelmä, tavallisesti negatiivisella polariteetilla, jossa negatiivinen duplikaatti on valmistettu master-positiivista, joka vuorostaan on valmistettu aiemmasta negatiivista."@fi,
        "Bestämning av generation, som är en efterbildning av en originalbild eller ett originalljudspår, vanligen med negativ polaritet, i vilken ett negativt duplikat har tillverkats från ett masterpositiv, som i sin tur är tillverkad från ett tidigare negativ."@sv ;
    skos:exactMatch rdagen:1003 ;
    skos:inScheme : ;
    skos:prefLabel "duplicate"@en,
        "duplikaatti"@fi,
        "duplikat"@sv .

:m4367 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-26"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m291 ;
    skos:definition "Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kerran kahdessa vuodessa."@fi,
        "Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras vartannat år."@sv ;
    skos:exactMatch rdafr:1014 ;
    skos:inScheme : ;
    skos:prefLabel "biennial"@en,
        "kerran kahdessa vuodessa"@fi,
        "vartannat år"@sv .

:m4368 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-27"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m654 ;
    skos:definition "Ei-magneettinen metallinen alkuaine, joka on taipuisa ja muokattava, väriltään harmaan tai hopean sävyinen."@fi,
        "Icke-magnetiskt metalliskt grundämne som är böjligt och formbart, till sin färg grått eller silverskiftande."@sv ;
    skos:exactMatch rdamat:1003 ;
    skos:inScheme : ;
    skos:prefLabel "aluminium"@en,
        "alumiini"@fi,
        "aluminium"@sv .

:m4369 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m654 ;
    skos:definition "Materiaali, joka koostuu synteettisistä tai orgaanisista polymeereistä ja jolla on suuri joustavuus ja kimmoisuus."@fi,
        "Material som består av syntetiska eller organiska polymerer och har stor elasticitet och spänst."@sv ;
    skos:exactMatch rdamat:1032 ;
    skos:inScheme : ;
    skos:prefLabel "rubber"@en,
        "kumi"@fi,
        "gummi"@sv .

:m437 a mts-meta:Hierarchy,
        skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-10-21"^^xsd:date ;
    rdfs:seeAlso rdaw:P10086 ;
    skos:broader :m1568 ;
    skos:definition "Teoksen nimeke, jota ei ole valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa."@fi,
        "Titel för verk, som inte har valts till primär i en viss tillämpning eller kontext."@sv ;
    skos:inScheme : ;
    skos:prefLabel "Variant title for work"@en,
        "Teoksen varianttinimeke"@fi,
        "Varianttitel för verket"@sv .

:m4370 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-28"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m4372 ;
    skos:definition "Julkaisutapa, jossa manifestaatio ilmestyy toisiaan seuraavina ja yleensä numeroituina osina ja jonka ilmestyminen on periaatteessa päättymätöntä."@fi,
        "Utgivningssätt, i vilket en manifestation utkommer i delar som följer på varandra och som vanligen är numrerade, samt utkommer i princip oändligen."@sv ;
    skos:exactMatch rdami:1003 ;
    skos:inScheme : ;
    skos:prefLabel "serial"@en,
        "sarja-aineisto"@fi,
        "seriell resurs"@sv .

:m4371 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-28"^^xsd:date ;
    dct:modified "2024-04-13"^^xsd:date ;
    skos:altLabel "en enhet"@sv ;
    skos:broader :m4372 ;
    skos:definition "Julkaisutapa, jossa manifestaatio ilmestyy yhtenä fyysisenä yksikkönä tai yhtenä loogisena aineettomana kokonaisuutena."@fi,
        "Utgivningssätt, i vilket en manifestation utkommer som en fysisk enhet eller som en logisk immateriell helhet."@sv ;
    skos:exactMatch rdami:1001 ;
    skos:inScheme : ;
    skos:prefLabel "single unit"@en,
        "yhtenä yksikkönä ilmestyvä aineisto"@fi,
        "resurs utkommen som en enhet"@sv .

:m4373 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-28"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m4372 ;
    skos:definition "Julkaisutapa, jossa manifestaatio ilmestyy kahtena tai useampana joko samanaikaisesti tai peräkkäin ilmestyvänä osana ja jonka ilmestyminen on päättynyt tai on tarkoitettu päättymään rajalliseen määrään osia."@fi,
        "Utgivningssätt som innebär att en manifestation utkommer i två eller flera delar, antingen samtidigt eller efter varandra, och på så vis att utgivningen är avslutad eller avsedd att upphöra efter ett begränsat antal delar."@sv ;
    skos:exactMatch rdami:1002 ;
    skos:inScheme : ;
    skos:prefLabel "multipart monography"@en,
        "moniosainen monografia"@fi,
        "monografi i flera delar"@sv .

:m4374 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-28"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m4372 ;
    skos:definition "Julkaisutapa, jossa manifestaatiota kartutetaan ja muokataan päivityksillä, jotka eivät jää erillisiksi vaan integroituvat kokonaisuuteen."@fi,
        "Utgivningssätt, i vilket en manifestation berikas och redigeras med uppdateringar som inte lämnas skilda utan integreras i helheten."@sv ;
    skos:exactMatch rdami:1004 ;
    skos:inScheme : ;
    skos:prefLabel "integrating resource"@en,
        "päivittyvä aineisto"@fi,
        "integrerande resurs"@sv .

:m4375 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-29"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m417 ;
    skos:definition "Valmistusmenetelmä, jossa tehdään merkkejä ja symboleja pohjamateriaaliin sen pintaa leikkaamalla."@fi,
        "Produktionsmetod, i vilken tecken och symboler i ett bottenmaterial görs genom att skära i dess yta."@sv ;
    skos:exactMatch rdapm:1016 ;
    skos:inScheme : ;
    skos:prefLabel "inscribing"@en,
        "inscribing"@fi,
        "inscribing"@sv .

:m4376 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-29"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m417 ;
    skos:definition "Valmistusmenetelmä tuntoaistiin perustuville aineistoille, joissa kuva on painettu erikoispaperille. Paperissa on alkoholia sisältäviä mikrokapseleita, jotka reagoivat lämpöön laajenemalla."@fi,
        "Produktionsmetod för material som grundar sig på känselsinnet och i vilka en bild är tryckt på specialpapper. I pappret finns mikrokapslar som innehåller alkohol och som reagerar på värme genom att utvidga sig."@sv ;
    skos:exactMatch rdapm:1021 ;
    skos:inScheme : ;
    skos:prefLabel "thermoform"@en,
        "lämpömuovaus"@fi,
        "termoform"@sv .

:m4377 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-29"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m417 ;
    skos:definition "Valmistusmenetelmä, jossa paineen avulla painetaan jälki materiaalin pintaan"@fi,
        "Produktionsmetod, i vilken tryck påförs för att lämna ett avtryck i ett materials yta."@sv ;
    skos:exactMatch rdapm:1017 ;
    skos:inScheme : ;
    skos:prefLabel "stamping"@en,
        "leimaus"@fi,
        "stämpling"@sv .

:m4378 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-29"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "kollotypi"@sv ;
    skos:broader :m417 ;
    skos:definition "Valmistusmenetelmä, jossa painatus perustuu dikromaattiluoksen kemialliseen reaktioon, joka kovettaa gelatiinin sen altistuessa ultraviolettivalolle ja tuottaa positiivisen alkuperäislaatan, jota käytetään myöhemmin litografiaprosessissa."@fi,
        "Produktionsmetod, i vilken tryckningen grundar sig på en dikromatlösnings kemiska reaktion, som härdar gelatinet när det utsätts för ultaviolettljus och producerar en positiv originalplatta, som används senare i litografiprocessen."@sv ;
    skos:exactMatch rdapm:1003 ;
    skos:inScheme : ;
    skos:prefLabel "collotype"@en,
        "kollotypia"@fi,
        "ljustryck"@sv .

:m4379 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-29"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m417 ;
    skos:definition "Valmistusmenetelmä, jossa kuva tai teksti siirretään tallenteelta toisen aineiston pinnalle, usein siirrettävällä materiaalilla katetun laatan, kiven tai kuvapinnan avulla. Sisältää valokuvavedosten sekä tallennetun tietokoneaineiston paperitulosteiden valmistamisen."@fi,
        "Produktionsmetod, i vilken bild eller text överförs från en upptagning till ett annat materials yta, ofta med hjälp av överförbart material, platta, sten eller bildyta. Inkluderar tillverkningen av fotokopior och pappersutskrifter av lagrat datormaterial."@sv ;
    skos:exactMatch rdapm:1010 ;
    skos:inScheme : ;
    skos:prefLabel "printing"@en,
        "painaminen"@fi,
        "tryckning"@sv .

:m4380 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-04-29"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m417 ;
    skos:definition "Valmistusmenetelmä, jossa painatus perustuu diatsoniumsuolan ja atsovärin kemialliseen reaktioon, joka muuttaa läpikuultamattomat sävyt tai värit siniseksi neutraalilla taustalla."@fi,
        "Produktionsmetod, i vilken tryckning grundar sig på en kemisk reaktion mellan diazoniumsalt och azofärg, som ändrar opaka nyanser eller färger till blått på en neutral bakgrund."@sv ;
    skos:exactMatch rdapm:1001 ;
    skos:inScheme : ;
    skos:prefLabel "blueline process"@en,
        "blueline-menetelmä"@fi,
        "blueline-metod"@sv .

:m4381 a skos:Concept ;
    dc:source "RDA-termi"@fi,
