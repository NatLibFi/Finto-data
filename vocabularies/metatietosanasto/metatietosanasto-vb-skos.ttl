        "kolmoset"@fi,
        "neloset"@fi,
        "fyrling"@sv,
        "trilling"@sv,
        "tvilling"@sv ;
    skos:broader :m5264 ;
    skos:closeMatch agrelon:hasMultipleBirthSibling ;
    skos:definition "Kuvailtavan henkilön sisarus, joka on syntynyt saman raskauden tuloksena. Koskee kaksosia, kolmosia ja muita monikkolapsia."@fi,
        "Syskon till en beskriven person, som har fötts ur samma graviditet. Gäller tvillingar, trillingar och andra flerlingsbarn."@sv ;
    skos:inScheme : ;
    skos:prefLabel "has multiple birth sibling"@en,
        "monikkosisarus"@fi,
        "flerling"@sv .

:m4601 a skos:Concept ;
    dc:source "AgRelOn, an Agent Relationship Ontology",
        "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2021-01-27"^^xsd:date ;
    dct:modified "2025-08-28"^^xsd:date ;
    skos:broader :m5264 ;
    skos:closeMatch agrelon:hasAcquaintance ;
    skos:definition "Henkilö, jonka kuvailtava henkilö tuntee yksityisesti."@fi,
        "Person som en beskriven person känner privat."@sv ;
    skos:inScheme : ;
    skos:prefLabel "has acquaintance"@en,
        "tuttava"@fi,
        "bekant"@sv .

:m4604 a skos:Concept ;
    dc:source "AgRelOn, an Agent Relationship Ontology",
