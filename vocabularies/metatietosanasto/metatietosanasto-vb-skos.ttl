    dct:modified "2024-05-24"^^xsd:date ;
    skos:altLabel "kauppala"@fi,
        "köping"@sv ;
    skos:broader :m196 ;
    skos:definition "Suomessa nykyisin kunta, joka on ottanut käyttöön kaupunki-nimityksen. Aiemmin kaupungit perustettiin hallitsijan päätöksellä, Suomen itsenäistyttyä asetuksella (Wikipedia). Käytetään myös entisistä kauppaloista, joista myöhemmin on tullut kaupunkeja."@fi,
        "I Finland numera kommun som tagit i bruk benämningen stad. Tidigare grundades städer genom regenters beslut, och efter att Finland blev självständigt genom förordning. Används även om tidigare köpingar, som senare blivit städer."@sv ;
    skos:example "Varkaus (kaupunki)"@fi,
        "Nykarleby (stad)"@sv ;
    skos:inScheme : ;
    skos:prefLabel "kaupunki"@fi,
        "stad"@sv ;
    skos:related :m4778,
        :m5054,
        :m604 .

