        "librettist (relation)"@sv ;
    skos:broader :m552 ;
    skos:definition "Toimija, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja. (RDA Registry)"@fi,
        "Aktör som är författare till texten i ett musikaliskt eller koreografiskt verk, såsom en opera, en balett eller något annat musikaliskt sceniskt verk eller oratorium."@sv ;
    skos:exactMatch rdaw:P10205 ;
    skos:inScheme : ;
    skos:prefLabel "librettist agent"@en,
        "libretisti"@fi,
        "librettist"@sv ;
    skos:scopeNote "Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa. (RDA Registry)"@fi,
        "Gäller inte författare till texter i enbart musikalsånger."@sv .

