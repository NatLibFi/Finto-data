        "videokuvaaja"@fi,
        "filmfotograf (aktör)"@sv,
        "filmfotograf (relation)"@sv,
        "videofilmare"@sv,
        "videofotograf"@sv ;
    skos:broader :m5278 ;
    skos:definition "Toimija, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen. (RDA Registry)"@fi,
        "Aktör som spelar in bilder antingen elektroniskt, eller på film eller video, och ofta väljer och arrangerar belysningen."@sv ;
    skos:exactMatch rdaw:P10068 ;
    skos:inScheme : ;
    skos:prefLabel "director agent of photography"@en,
        "kuvaaja"@fi,
        "filmfotograf"@sv ;
    skos:scopeNote "Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi. (RDA Registry)"@fi .

:m1618 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-08-27"^^xsd:date ;
    skos:altLabel "yhdistynyt yhteisöön"@fi,
        "sammanslagits med institutionen"@sv ;
    skos:broader :m4455 ;
    skos:definition "Yhteisö, joka muodostaa uuden yhteisön yhdistymällä yhden tai useamman muun yhteisön kanssa. (RDA Registry)"@fi,
        "Institution som bildar en ny institution, genom att gå samman med en eller flera andra institutioner."@sv ;
    skos:exactMatch rdaa:P50232 ;
    skos:inScheme : ;
    skos:prefLabel "component of merger"@en,
        "yhdistynyt yhteisö"@fi,
        "sammanslagen institution"@sv .

:m1620 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m346 ;
    skos:definition "Kielen merkkijärjestelmällä esitetty sisältö, joka on tarkoitettu katsottavaksi. Sisältää kaikki muut kielen merkkijärjestelmät, paitsi kosketeltavaksi tarkoitetun tekstin. Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m1078'>taktiili teksti</a>."@fi,
        "Med språkets teckensystem uttryckt innehåll, avsett att betraktas. Innehåller alla språks teckensystem förutom text som är avsedd att vidröras. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m1078'>taktil text</a>."@sv ;
    skos:exactMatch rdaco:1020 ;
    skos:inScheme : ;
    skos:prefLabel "text"@en,
        "teksti"@fi,
        "text"@sv .

:m1621 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m580 ;
    skos:definition "1946 perustettu palkinto, jolla pyritään nostamaan esiin korkeatasoista suomen- tai ruotsinkielistä lasten- ja nuortenkirjallisuutta."@fi,
        "Pris instiftat år 1946, med syfte att lyfta fram kvalitativt högtstående finsk- eller svenskspråkig barn- och ungdomslitteratur."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Topelius-palkinto, 2020"@fi,
        "I MARC 21-formatet: 586 ## ‡a Topeliuspriset (ungdomsböcker), 2020"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Topelius-palkinto"@fi,
        "Topeliuspriset (ungdomsböcker)"@sv .

:m1622 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-06-11"^^xsd:date ;
    skos:altLabel "presenter"@en,
        "esittämisestä vastaava"@fi,
        "ansvarig för framförande"@sv ;
    skos:broader :m1060 ;
    skos:definition "Toimija, joka sisältyy merkintään \"X esittää:\" ekspression sisältävän manifestaation alku- tai lopputeksteissä ja joka liittyy todennäköisesti liikkuvan kuvan teoksen ekspression tuotantoon, rahoitukseen tai jakeluun jollakin tavoin. (RDA Registry)"@fi,
        "Aktör som ingår i texten \"X presenterar:\" i för- och eftertexter i en manifestation som innehåller ett uttryck, och som troligtvis på något vis relaterar till produktion, finansiering eller distribution av ett uttryck för rörlig bild."@sv ;
    skos:exactMatch rdae:P20054 ;
    skos:inScheme : ;
    skos:prefLabel "presenter agent"@en,
        "esittämisestä vastaava toimija"@fi,
        "ansvarig aktör för framförande"@sv .

