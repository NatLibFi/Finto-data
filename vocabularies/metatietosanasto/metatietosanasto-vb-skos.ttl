    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen puvustaja (yhteisö)"@fi,
        "kostymör (institution) som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5470 ;
    skos:definition "Aggregaattiin sisältyvän elokuvan, musiikki- tai näytelmäesityksen puvustuksen suunnitellut yhteisö."@fi,
        "Institution som planerat kostymdesignen i en film, ett musikaliskt eller sceniskt framförande, som ingår i ett aggregat."@sv ;
    skos:inScheme : ;
    skos:prefLabel "puvustaja"@fi,
        "kostymör"@sv .

:m5599 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-02"^^xsd:date ;
    skos:altLabel "kaivertaja (henkilö)"@fi,
        "gravör (person)"@sv ;
    skos:broader :m5563 ;
    skos:definition "Henkilö, joka on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle. (RDA Registry)"@fi,
        "Person som svarar för tillverkningen av en manifestation, genom att gravera bokstäver, mönster eller andra tecken på en yta som används vid tryck, såsom en trä- eller metallyta."@sv ;
    skos:exactMatch rdam:P30350 ;
    skos:inScheme : ;
    skos:prefLabel "engraver person"@en,
        "kaivertaja"@fi,
        "gravör"@sv .

