    dct:created "2021-01-27"^^xsd:date ;
    dct:modified "2025-08-28"^^xsd:date ;
    skos:broader :m5264 ;
    skos:closeMatch agrelon:hasAdoptiveSibling ;
    skos:definition "Kuvailtavan henkilön sisarus, kun vähintään toinen sisaruksista on yhteisten vanhempien adoptiolapsi."@fi,
        "Syskon till en beskriven person, då åtminstone ett av syskonen är adoptivbarn till gemensamma föräldrar."@sv ;
    skos:inScheme : ;
    skos:prefLabel "has adoptive sibling"@en,
        "adoptiosisarus"@fi,
        "adoptivsyskon"@sv .

