        "MARC 21: 300## ‡a 9 spel (flera delar) + ‡e Lärarens info (23 sidor : illustrationer)"@sv ;
    skos:inScheme : ;
    skos:narrower :m1010,
        :m1578 ;
    skos:prefLabel "game"@en,
        "peli"@fi,
        "spel"@sv .

