    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m1374 ;
    skos:definition "Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat runot. Jos kokoelmassa ei ole kaikkia runoja, tietoon lisätään termi <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Valikoima</a>."@fi,
        "Grupptitel för en samling som innefattar alla dikter skrivna av en aktör. Om samlingen inte innehåller alla dikter, anges också termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Urval</a>"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Poems"@en,
        "Runot"@fi,
        "Dikter"@sv .

:m2107 a skos:Concept ;
