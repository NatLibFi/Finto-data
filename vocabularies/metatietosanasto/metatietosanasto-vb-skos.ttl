:m5928 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-19"^^xsd:date ;
    skos:altLabel "sensori (yhteisö)"@fi,
        "censor (institution)"@sv ;
    skos:broader :m5739 ;
    skos:definition "Yhteisö, joka osallistuu ekspression tekemiseen tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi. (RDA Registry)"@fi,
        "Institution som deltar i utförandet av ett uttryck, genom att granska innehållet i ett annat uttryck för att dölja kontroversiellt innehåll på moraliska, politiska, militära eller andra grunder, men ändå låta det ursprungliga verkets karaktär och allmänna innehåll till sina väsentliga delar förbli oförändrat."@sv ;
    skos:exactMatch rdae:P20474 ;
    skos:inScheme : ;
    skos:prefLabel "censor corporate body"@en,
        "sensori"@fi,
        "censor"@sv ;
    skos:scopeNote "Ei koske laajaa muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)"@fi,
        "Gäller inte omfattande redigering, som leder till skapandet av ett nytt verk."@sv .

:m5930 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
