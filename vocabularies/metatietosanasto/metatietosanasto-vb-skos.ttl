        "Aktör som är en dirigent som deltar i utförandet av ett uttryck, genom att leda en instrumentgrupp i en musik- eller dramaföreställning."@sv ;
    skos:exactMatch rdae:P20286 ;
    skos:inScheme : ;
    skos:prefLabel "instrumental conductor agent"@en,
        "kapellimestari"@fi,
        "kapellmästare"@sv .

:m359 a skos:Concept ;
    dc:source "RDA-termi"@fi,
