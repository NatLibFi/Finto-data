    dct:created "2020-11-27"^^xsd:date ;
    dct:modified "2024-11-14"^^xsd:date ;
    skos:altLabel "filmat framförande"@sv ;
    skos:broader :m991 ;
    skos:inScheme : ;
    skos:prefLabel "videoitu esitys"@fi,
        "filmat framträdande"@sv ;
    skos:scopeNote "Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset."@fi,
        "Verkets form-termer används för att åtskilja verk med samma namn."@sv .

:m4595 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-11-27"^^xsd:date ;
