    skos:inScheme : ;
    skos:prefLabel "onscreen presenter corporate body"@en,
        "esittelijä"@fi,
        "presentatör"@sv ;
    skos:scopeNote "Koskee ei-fiktiivisessä elokuvassa tai fiktiivisen elokuvan johdannossa esiintymistä. Ei koske esiintymistä ruudussa ei-esittävässä roolissa. (RDA Registry)"@fi,
        "Gäller framträdande i icke-fiktiv film eller i inledning till fiktiv film."@sv .

