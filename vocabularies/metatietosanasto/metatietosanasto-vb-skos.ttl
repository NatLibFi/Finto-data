:m4635 a skos:Concept ;
    dc:source "AgRelOn, an Agent Relationship Ontology",
        "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2021-01-27"^^xsd:date ;
    dct:modified "2025-08-28"^^xsd:date ;
    skos:broader :m5264 ;
    skos:closeMatch agrelon:hasRelative ;
    skos:definition "Henkilö, jolle kuvailtava henkilö on sukua. Ei viittaa vain biologiseen sukulaisuuteen, vaan myös avioliiton, adoption tai kasvatuksen kautta muodostuneisiin suhteisiin."@fi,
        "Person med vilken en beskriven person är släkt. Hänvisar inte enbart till biologiskt släktskap, utan även relationer som bildats genom äktenskap, adoption eller fostran."@sv ;
    skos:inScheme : ;
    skos:prefLabel "has relative"@en,
        "sukulainen"@fi,
        "släkting"@sv .

