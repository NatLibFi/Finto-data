:m4468 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-05-14"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m1374 ;
    skos:definition "Vakiintunut kokoava nimeke Teokset merkitään ensisijaiseksi nimekkeeksi sellaiselle teosten koosteelle, joka sisältää tai jonka on tarkoitus sisältää toimijan kootut teokset. Jos kokoelmassa ei ole kaikkia teoksia, tietoon lisätään termi <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Valikoima</a>."@fi,
        "Grupptiteln Verk anges som föredragen titel för en sådan sammanställning av verk som innehåller, eller är avsedd att innehålla, en aktörs samlade verk. Om sammanställningen inte innehåller alla verk anges också termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Urval</a>."@sv ;
    skos:example """MARC 21 -esimerkki
100 1# ‡a Snellman, Johan Vilhelm, ‡d 1806-1881, ‡e kirjoittaja. ‡0 (FI-ASTERI-N)000059409
240 10 ‡a Teokset"""@fi,
        """MARC 21 -esimerkki
240 10 ‡a Teokset. ‡k Valikoima, ‡l suomi"""@fi,
        """MARC 21-exempel
100 1# ‡a Snellman, Johan Vilhelm, ‡d 1806-1881, ‡e författare. ‡0 (FI-ASTERI-N)000059409
240 10 ‡a Verk"""@sv,
        """MARC 21-exempel
240 10 ‡a Verk. ‡k Urval, ‡l svenska"""@sv ;
    skos:inScheme : ;
    skos:prefLabel "Teokset"@fi,
        "Verk"@sv .

