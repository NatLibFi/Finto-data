    skos:altLabel "rakastajatar"@fi,
        "älskarinna"@sv ;
    skos:broader :m5264 ;
    skos:closeMatch agrelon:hasLover ;
    skos:definition "Henkilö, jonka kanssa kuvailtavalla henkilöllä on rakkaussuhde eivätkä he ole keskenään naimisissa."@fi,
        "Person med vilken en beskriven person har ett kärleksförhållande, utan att vara gifta."@sv ;
    skos:inScheme : ;
    skos:prefLabel "has lover"@en,
