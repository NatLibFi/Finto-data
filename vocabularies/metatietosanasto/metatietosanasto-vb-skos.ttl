    skos:broader :m5899 ;
    skos:definition "Henkilö, joka julkaisee teoksen. (RDA Registry)"@fi,
        "Person som ger ut ett verk."@sv ;
    skos:exactMatch rdaw:P10456 ;
    skos:inScheme : ;
    skos:prefLabel "issuing person"@en,
        "julkaisija"@fi,
        "utgivare"@sv .

:m5386 a skos:Concept ;
