:m1592 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m346 ;
    skos:definition "Liikettä kuvailevan merkkijärjestelmän avulla esitetty sisältö, joka on tarkoitettu katsottavaksi. Sisältää kaikki muut kuin kosketeltavassa muodossa olevat liikenotaatiot. Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m1019'>taktiili liikenotaatio</a>."@fi,
        "Innehåll som presenteras med teckensystem som beskriver rörelse och som är avsett att beskådas. Innehåller allt annat än rörelsenotationer som är i taktil form. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m1019'>taktil noterad rörelse</a>."@sv ;
    skos:exactMatch rdaco:1009 ;
    skos:inScheme : ;
    skos:prefLabel "notated movement"@en,
        "liikenotaatio"@fi,
        "rörelsenotation"@sv .

:m1596 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
    skos:altLabel "draftsman"@en,
        "piirt. (piirtäjä)"@fi,
        "piirtäjä (toimija)"@fi,
        "ritare (aktör)"@sv ;
    skos:broader :m5684 ;
    skos:definition "Toimija, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista. (RDA Registry)"@fi,
        "Aktör som deltar i utförandet av ett uttryck skapat av en arkitekt, designer eller annan dylik aktör, genom att skapa precisa planer eller ritningar av byggnader, fartyg, flygplan, apparater, föremål eller andra kreationer."@sv ;
    skos:exactMatch rdae:P20033 ;
    skos:inScheme : ;
    skos:prefLabel "draftsman agent"@en,
        "piirtäjä"@fi,
        "ritare"@sv .

:m1599 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m8 ;
    skos:definition "Laajuuden yksikkö, kartta-aineisto, joka perustuu kaukokartoitusmittalaitteen etäältä havaitsemaan ja mittaamaan heijastuneeseen ja/tai säteilleeseen elektromagneettiseen säteilyyn tai, kaikuluotaimen ollessa kyseessä, heijastuneisiin vedenalaisiin ääniaaltoihin."@fi,
        "Enhet, kartografisk resurs som avser bildframställning av reflekterad och/eller utstrålad elektromagnetisk strålning, observerad och mätt på avstånd med hjälp av fjärranalysinstrument, och, i fråga om ekolod, ljudvågor som reflekteras under vatten."@sv ;
    skos:exactMatch rdacarx:1033 ;
    skos:inScheme : ;
    skos:prefLabel "remote-sensing image"@en,
        "kaukokartoituskuva"@fi,
        "fjärranalysbild"@sv .

:m1604 a skos:Concept ;
