:m5284 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-03"^^xsd:date ;
    skos:altLabel "kappaleen entisöijä (henkilö)"@fi,
        "konservator (person) av exemplar"@sv,
