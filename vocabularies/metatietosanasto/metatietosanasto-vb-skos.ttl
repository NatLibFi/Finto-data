    skos:broader :m5428 ;
    skos:definition "Kappaleen aiempi omistajayhteisö, joka lahjoittaa sen toiselle omistajalle. (RDA Registry)"@fi,
        "Tidigare ägarinstitution till ett exemplar, som donerar det till en annan ägare."@sv ;
    skos:exactMatch rdai:P40140 ;
    skos:inScheme : ;
    skos:prefLabel "donor corporate body"@en,
        "lahjoittaja"@fi,
        "donator"@sv .

:m5381 a skos:Concept ;
