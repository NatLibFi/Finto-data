:m2139 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2018-04-04"^^xsd:date ;
    dct:modified "2026-02-03"^^xsd:date ;
    skos:broader :m8 ;
    skos:definition "Laajuuden yksikkö on niteen alayksiköksi sidottu tai muuten kiinnitetty yksittäinen arkki. Lehti koostuu lehden kahdella puolelle sijoittuvista sivuista, joista jompikumpi tai molemmat voivat olla tyhjiä."@fi,
        "Enhet som är ett ark som sammanbundits eller på annat sätt sammanfogats till en underordnad enhet av en volym. Ett blad består av sidorna på bägge sidor av bladet, av vilka en eller bägge kan vara tomma."@sv ;
    skos:exactMatch rdacarx:1018 ;
    skos:example "21 lehteä, 1 taitelehti : kuvitettu ; 44 cm"@fi,
        "21 blad, 1 folder : illustrationer ; 44 cm"@sv ;
    skos:inScheme : ;
    skos:prefLabel "leaf"@en,
        "lehti"@fi,
        "blad"@sv ;
    skos:scopeNote "Monikossa lehteä."@fi .

