    skos:scopeNote "Ei koske animaatiopiirrosten tekijää. (RDA Registry)"@fi,
        "Gäller inte skapare av animationsteckningar."@sv .

:m568 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-05-09"^^xsd:date ;
    skos:altLabel "tvärsektion"@sv ;
    skos:broader :m8 ;
    skos:definition "Laajuuden yksikkö on mittakaavassa ja tavallisesti tasossa esitetty pystysuora pinta, joka kuvaa sekä taivaankappaleen pinnan tai käsitteellisen mallin poikkileikkaavan profiilin että poikkaleikatun tason alla olevat kerrokset."@fi,
        "Enhet som är en skalenlig framställning av en vertikal yta, vanligen ett plan, och som visar både profilen där den genomskär en himlakropps yta, eller en konceptuell modell, och de underliggande strukturerna längs det genomskurna planet."@sv ;
    skos:exactMatch rdacarx:1035 ;
    skos:inScheme : ;
    skos:prefLabel "section"@en,
        "poikkileikkaus"@fi,
        "tvärsnitt"@sv .

