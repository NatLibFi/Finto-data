    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m196 ;
    skos:closeMatch yso:p22408 ;
    skos:definition "Suomen evankelis-luterilaisen kirkon tai Suomen ortodoksisen kirkon seurakuntien muodostama yhteistyöorganisaatio, joka hoitaa sen perussäännössä määritellyt tehtävät seurakuntien puolesta (Wikipedia)."@fi,
        "Samarbetsorganisation bildad av församlingar i Evangelisk-lutherska kyrkan i Finland eller Ortodoxa kyrkan i Finland, som sköter bestämda uppgifter för församlingarnas del."@sv ;
    skos:inScheme : ;
    skos:prefLabel "seurakuntayhtymä"@fi,
        "kyrklig samfällighet"@sv .

