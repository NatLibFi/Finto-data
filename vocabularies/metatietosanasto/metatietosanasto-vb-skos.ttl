:m4754 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2021-04-20"^^xsd:date ;
    dct:modified "2025-10-30"^^xsd:date ;
    skos:altLabel "elinkeinopiiri"@fi,
        "kutsuntapiiri"@fi,
        "rajoni"@fi,
        "rajooni"@fi,
        "sotilaspiiri"@fi,
        "suojeluskuntapiiri"@fi,
        "tiepiiri"@fi,
        "tuomiokunta (tuomiopiiri)"@fi,
        "vesipiiri"@fi,
        "domsaga"@sv,
        "militärdistrikt"@sv,
        "näringsdistrikt"@sv,
        "rajon"@sv,
        "skyddskårsdistrikt"@sv,
        "uppbådskrets"@sv,
        "vattendistrikt"@sv,
        "vägdistrikt"@sv ;
    skos:broader :m4872 ;
    skos:definition "Aluehallinnon yksikkö tai sen toimialue, jota kutsutaan piiriksi."@fi,
        "Enhet eller verksamhetsområde för regional förvaltning."@sv ;
    skos:example "Savon tie- ja vesipiiri; Kainuun elinkeinopiiri; Oulun suojeluskuntapiiri; Piippolan tuomiokunta; Viipurin posti- ja lennätinpiiri; Jyväskylän asutuspiiri"@fi,
        "Savolax väg- och vattendistrikt; Kajanalands näringsdistrikt; Uleåborgs skyddskårsdistrikt; Piippola domsaga"@sv ;
    skos:inScheme : ;
    skos:prefLabel "piiri (hallintoalue)"@fi,
        "distrikt (förvaltningsområde)"@sv ;
    skos:related :m4881,
        :m4882,
        :m4884,
        :m4885 ;
    skos:scopeNote """Voidaan käyttää valitun yhteisön kategorian lisäksi täsmentämään, että ko. julkishallinnollinen yhteisö on piiritason organisaatio.

Suomen kielessä yleisesti piirikunniksi kutsutuista useiden maiden aluehallinnon yksiköistä käytä termiä <a href='http://urn.fi/URN:NBN:fi:au:mts:m4884'>piirikunta</a>. Nimismiespiiriä johtaneesta  viranomaisesta käytä yhteisön kategorian historiallista termiä <a href='http://urn.fi/URN:NBN:fi:au:mts:m4724'>nimismies (viranomainen)</a>."""@fi,
        """Kan användas utöver en vald kategori av institution för att precisera att den offentligrättsliga institutionen i fråga är en organisation på distriktsnivå. 

Om liknande förvaltningsenhet i flera engelskspråkiga länder används termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m4884'>county</a>. Om myndighet som ledde ett länsmansdistrikt används den historiska termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m4724'>länsman (myndighet)</a> som kategori av institution."""@sv .

