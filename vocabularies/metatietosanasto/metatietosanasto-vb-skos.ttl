        "filmfotograf (person)"@sv ;
    skos:broader :m5514 ;
    skos:definition "Henkilö, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen. (RDA Registry)"@fi,
        "Person som spelar in bilder antingen elektroniskt, eller på film eller video, och ofta väljer och arrangerar belysningen."@sv ;
    skos:exactMatch rdaw:P10415 ;
    skos:inScheme : ;
    skos:prefLabel "director person of photography"@en,
        "kuvaaja"@fi,
        "filmfotograf"@sv ;
    skos:scopeNote "Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi. (RDA Registry)"@fi .

:m5388 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-04"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen kuvaaja (yhteisö)"@fi,
        "filmfotograf (institution) som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5470 ;
    skos:definition "Aggregaattiin sisältyvän liikkuvan kuvan joko digitaalisesti, filmille tai videolle tallentava yhteisö. Voi hoitaa myös valaistuksen. Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."@fi,
        "Institution som spelar in rörlig bild som ingår i ett aggregat antingen digitalt, på film eller på video. Kan även sköta belysning."@sv ;
    skos:inScheme : ;
    skos:prefLabel "kuvaaja"@fi,
        "filmfotograf"@sv .

