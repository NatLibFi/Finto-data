:m5261 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-04"^^xsd:date ;
    skos:altLabel "musiikkiin osallinen laulaja (yhteisö)"@fi,
        "sångare (institution) som är bidragsgivare till musik"@sv ;
    skos:broader :m5883 ;
    skos:definition "Aggregaattiin sisältyvässä musiikissa ääntään käyttämällä, säestyksellä tai ilman, esiintyvä yhteisö. Lauluesitys voi sisältää tai olla sisältämättä todellisia sanoja."@fi,
        "Institution som uppträder i musik som ingår i ett aggregat, genom att använda sin röst, med eller utan ackompanjemang. Sångframförandet kan vara med eller utan riktiga ord."@sv ;
    skos:inScheme : ;
    skos:prefLabel "laulaja"@fi,
        "sångare"@sv .

:m5265 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-19"^^xsd:date ;
    skos:altLabel "soittaja (yhteisö)"@fi,
        "instrumentalist (institution)"@sv ;
    skos:broader :m5266 ;
    skos:definition "Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta. (RDA Registry)"@fi,
        "Institution som är en framförare, som deltar i utförandet av ett uttryck genom att spela ett instrument."@sv ;
    skos:exactMatch rdae:P20494 ;
    skos:inScheme : ;
    skos:prefLabel "instrumentalist corporate body"@en,
        "soittaja"@fi,
        "instrumentalist"@sv .

:m527 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-07-04"^^xsd:date ;
    skos:altLabel "singer"@en,
        "laulaja (suhde)"@fi,
        "laulaja (toimija)"@fi,
        "sångare (aktör)"@sv,
        "sångare (relation)"@sv ;
    skos:broader :m1060 ;
    skos:definition "Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia. (RDA Registry)"@fi,
        "Aktör som är en framförare, som deltar i utförandet av ett uttryck, genom att använda sin röst, med eller utan instrumentalackompanjemang, för att producera musik."@sv ;
    skos:exactMatch rdae:P20025 ;
    skos:inScheme : ;
    skos:prefLabel "singer agent"@en,
        "laulaja"@fi,
        "sångare"@sv ;
