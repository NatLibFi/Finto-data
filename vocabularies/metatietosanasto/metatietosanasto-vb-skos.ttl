:m3607 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    skos:altLabel "jätehuolto"@fi,
        "vesihuolto"@fi,
        "avfallshantering"@sv,
        "vattenförsörjning"@sv,
        "vattentjänster och miljövård"@sv ;
    skos:broader :m3661 ;
    skos:definition "Veden ottoa, puhdistusta ja jakelua, jätteiden keruuta, käsittelyä ja loppusijoitusta, jätevesien keräämistä, kuljetusta ja puhdistusta sekä maaperän ja vesistöjen puhdistusta ja kunnostusta harjoittavat toimijat. Pääluokkaan eivät kuulu maa- ja vesirakennusta tai ympäristörakentamista harjoittavat toimijat (ks. rakennusala)."@fi,
        "Aktörer som utövar vattentäkt, vattenrening och -distribution, avfallsinsamling, -hantering och slutförvaring, uppsamling, transport och rening av avfallsvatten samt rening och restaurering av mark och vattendrag. Till huvudkategorin hör inte anläggningsverksamhet eller miljötekniskt byggande (se byggnadsbranschen)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "vesi- ja ympäristönhuolto"@fi,
        "vattenförsörjning och miljövård"@sv .

