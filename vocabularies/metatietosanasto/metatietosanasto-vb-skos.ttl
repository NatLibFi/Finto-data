    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-06-13"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen haastateltava (yhteisö)"@fi,
        "intervjuobjekt (institution) som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5470 ;
    skos:definition "Aggregaattiin sisältyvään liikkuvan kuvan aineistoon tietoja keräävälle haastattelijalle (tavallisesti toimittaja tai mielipidemittauksen tekijä) vastauksia antava yhteisö."@fi,
        "Institution som ger svar åt en intervjuare (vanligen en journalist eller opinionsmätare), som samlar information till material med rörlig bild som ingår i ett aggregat."@sv ;
    skos:inScheme : ;
    skos:prefLabel "haastateltava"@fi,
        "intervjuobjekt"@sv .

:m5598 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
