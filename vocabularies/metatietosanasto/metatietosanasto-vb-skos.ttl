    skos:prefLabel "Betacam"@en,
        "Betacam"@fi,
        "Betacam"@sv .

:m1633 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m580 ;
    skos:definition "Myönnetään vuosittain kaunokirjalliselle teokselle ja sen myöntää Pohjoismaiden neuvosto. Vaatimuksena on, että teos on kirjoitettu jollakin pohjoismaisella kielellä."@fi,
        "Utdelas årligen av Nordiska rådet till ett skönlitterärt verk. Verket bör vara skrivet på något av de nordiska språken."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Pohjoismaiden neuvoston kirjallisuuspalkinto, 2019"@fi,
