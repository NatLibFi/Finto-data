        "Institution som en person grundat."@sv ;
    skos:exactMatch rdaa:P50112 ;
    skos:inScheme : ;
    skos:prefLabel "founded corporate body of person"@en,
        "henkilön perustama yhteisö"@fi,
        "institution grundad av person"@sv .

:m5384 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-28"^^xsd:date ;
    skos:altLabel "DJ (henkilö)"@fi,
        "DJ (person)"@sv,
        "discjockey"@sv,
        "diskjockey"@sv ;
    skos:broader :m5302 ;
    skos:definition "Henkilö, joka osallistuu ekspression tekemiseen miksaamalla ääniraitoja yhteen yhtäjaksoiseksi raidaksi live-esityksessä tai äänitysstudiossa. (RDA Registry)"@fi,
        "Person som deltar i utförandet av ett uttryck genom att mixa ljudspår till ett sammanhängande spår under ett liveframträdande eller i en inspelningsstudio."@sv ;
    skos:exactMatch rdae:P20349 ;
    skos:inScheme : ;
    skos:prefLabel "DJ person"@en,
        "DJ"@fi,
        "DJ"@sv ;
    skos:scopeNote "Ei koske uudelleenmiksauksia, jotka olennaisesti muuttavat alkuperäisen teoksen luonnetta ja sisältöä, mikä johtaa uuteen teokseen, eikä äänitteen useampien raitojen miksaamista ja yhdistelyä. (RDA Registry)"@fi,
        "Gäller inte remixer som väsentligen ändrar det ursprungliga verkets karaktär och innehåll, vilket leder till ett nytt verk, och inte heller mixning och kombinering av flera spår i en ljudinspelning."@sv .

:m5385 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-01"^^xsd:date ;
