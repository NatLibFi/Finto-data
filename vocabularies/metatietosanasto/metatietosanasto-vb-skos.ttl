        "Person som svarar för de flesta uppgifter som hör till utdelandet av roller och uppgifter för framträdare."@sv ;
    skos:exactMatch rdaw:P10453 ;
    skos:inScheme : ;
    skos:prefLabel "casting director person"@en,
        "roolittaja"@fi,
