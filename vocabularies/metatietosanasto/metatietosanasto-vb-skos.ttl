:m5461 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-11-25"^^xsd:date ;
    skos:altLabel "remiksaaja (yhteisö)"@fi,
        "uudelleenmiksaaja (yhteisö)"@fi,
        "remixer (institution)"@sv ;
    skos:broader :m5607 ;
    skos:definition "Yhteisö, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä. (RDA Registry)"@fi,
        "Institution som svarar för skapandet av ett ljudverk, genom att manipulera, kombinera, blanda och återproducera tidigare inspelade ljud."@sv ;
    skos:exactMatch rdaw:P10543 ;
    skos:inScheme : ;
    skos:prefLabel "remix artist corporate body"@en,
        "uudelleenmiksaaja"@fi,
        "remixer"@sv ;
    skos:scopeNote "Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi. (RDA Registry)"@fi,
        "Gäller inte remixande som inte väsentligen ändrar det ursprungliga verkets karaktär och innehåll, och inte sammanfogande av tidigare inspelade musikstycken till ett musikstycke."@sv .

