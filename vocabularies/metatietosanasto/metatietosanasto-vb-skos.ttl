    skos:example "kansanhuoltoministeriö, elintarvikehallitus, kansanhuoltopiirit, elintarviketoimistot, Suomen Huolto"@fi,
        "folkförsörjningsministeriet, livsmedelsstyrelsen, folkförsörjningsdistrikt, livsmedelsbyråer, Finlands Folkhjälp"@sv ;
    skos:inScheme : ;
    skos:prefLabel "kansanhuolto ja elintarvikehuolto"@fi,
        "folkförsörjning och livsmedelsförsörjning"@sv .

:m3618 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p23197 ;
    skos:altLabel "rahoitusala"@fi,
        "rahoitustoiminta"@fi,
        "vakuutusala"@fi,
        "vakuutustoiminta"@fi,
        "finansieringsbranschen"@sv,
        "finansverksamhet"@sv,
        "försäkringsbranschen"@sv,
        "försäkringsverksamhet"@sv ;
    skos:broader :m3661 ;
    skos:definition "Rahoitus- ja sijoituspalveluita tarjoavat sekä pankki-, vakuutus-, jälleenvakuutus- ja eläkerahastointitoimintaa, varojen hallinnointia (ks. hallintayhtiöt, säätiöt, rahastot), pörssitoimintaa ja arvopapereiden välitystä yms. harjoittavat toimijat. Pääluokkaan eivät kuulu pakollista sosiaalivakuutustoimintaa harjoittavat toimijat (ks. sosiaalivakuutus)."@fi,
        "Aktörer som erbjuder finansierings- och placeringstjänster samt utövar bank-, försäkrings-, återförsäkrings-, och pensionsfondsverksamhet, medelsförvaltning (se holdingbolag, stiftelser, fonder), börsverksamhet och värdepappersförmedling etc. Till huvudgruppen hör inte aktörer som utövar obligatorisk socialförsäkringsverksamhet (se socialförsäkring)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "finanssiala"@fi,
        "finansbranschen"@sv .

