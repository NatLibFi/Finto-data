    skos:broader :m5699 ;
    skos:definition "Henkilö, jolle kappale on omistettu. (RDA Registry)"@fi,
        "Person som ett exemplar är tillägnat."@sv ;
    skos:exactMatch rdai:P40097 ;
    skos:inScheme : ;
    skos:prefLabel "dedicatee person of item"@en,
        "kappaleen omistuksen kohde"@fi,
        "exemplaret dedicerat till"@sv .

:m5288 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-07-03"^^xsd:date ;
    skos:altLabel "kertoja (henkilö)"@fi,
        "berättare (person)"@sv ;
    skos:broader :m5289 ;
    skos:definition "Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen lukemalla ääneen tai kertomalla toiminnasta, tapauksesta tai muusta tapahtumasta. (RDA Registry)"@fi,
        "Person som är en framförare, som deltar i utförandet av ett uttryck genom att högläsa eller berätta om en handling, en händelse eller något annat förlopp."@sv ;
    skos:exactMatch rdae:P20378 ;
    skos:inScheme : ;
    skos:prefLabel "narrator person"@en,
        "kertoja"@fi,
        "berättare"@sv .

:m5294 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-19"^^xsd:date ;
    skos:altLabel "sensori (henkilö)"@fi,
        "censor (person)"@sv ;
    skos:broader :m5548 ;
    skos:definition "Henkilö, joka osallistuu ekspression tekemiseen tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi. (RDA Registry)"@fi,
        "Person som deltar i utförandet av ett uttryck, genom att granska innehållet i ett annat uttryck för att dölja kontroversiellt innehåll på moraliska, politiska, militära eller andra grunder, men ändå låta det ursprungliga verkets karaktär och allmänna innehåll till sina väsentliga delar förbli oförändrat."@sv ;
    skos:exactMatch rdae:P20356 ;
    skos:inScheme : ;
    skos:prefLabel "censor person"@en,
        "sensori"@fi,
        "censor"@sv ;
    skos:scopeNote "Ei koske laajaa muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)"@fi,
        "Gäller inte omfattande redigering, som leder till skapandet av ett nytt verk."@sv .

:m5295 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
