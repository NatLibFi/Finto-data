:m1978 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-24"^^xsd:date ;
    dct:modified "2025-11-25"^^xsd:date ;
    skos:altLabel "remix artist"@en,
        "remiksaaja (toimija)"@fi,
        "uudelleenmiksaaja (toimija)"@fi,
        "äänitaiteilija"@fi,
        "ljudkonstnär"@sv,
        "remixer (aktör)"@sv ;
    skos:broader :m5278 ;
    skos:definition "Toimija, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä. (RDA Registry)"@fi,
        "Aktör som svarar för skapandet av ett ljudverk, genom att manipulera, kombinera, blanda och återproducera tidigare inspelade ljud."@sv ;
    skos:exactMatch rdaw:P10306 ;
    skos:inScheme : ;
    skos:prefLabel "remix artist agent"@en,
        "uudelleenmiksaaja"@fi,
        "remixer"@sv ;
    skos:scopeNote "Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi. (RDA Registry)"@fi,
        "Gäller inte remixande som inte väsentligen ändrar det ursprungliga verkets karaktär och innehåll, och inte sammanfogande av tidigare inspelade musikstycken till ett musikstycke."@sv .

:m1979 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-02-24"^^xsd:date ;
    dct:modified "2025-01-08"^^xsd:date ;
    skos:broader :m5302 ;
    skos:definition "Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen, tekemällä taidetta äänestä, käyttäen ääntä sekä sen mediumina että aiheena."@fi,
        "Sammankopplar uttryck med en person som deltar i utförandet av ett uttryck genom att skapa konst av ljud och använda ljudet både som medium och som ämne."@sv ;
    skos:inScheme : ;
    skos:prefLabel "äänitaiteilija (ekspressio)"@fi,
        "ljudkonstnär (uttryck)"@sv .

:m1980 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-24"^^xsd:date ;
    dct:modified "2025-07-02"^^xsd:date ;
    skos:altLabel "calligrapher"@en,
        "kalligrafi (toimija)"@fi,
        "kalligraf (aktör)"@sv ;
    skos:broader :m511 ;
    skos:definition "Toimija, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä. (RDA Registry)"@fi,
        "Aktör som är en konstnär som svarar för kalligrafi, i vilken huvudvikten ligger vid de estetiska värdena i handskrift eller grafisk konst, oberoende av om samma aktör också svarar för den skrivna texten."@sv ;
    skos:exactMatch rdaw:P10253 ;
    skos:inScheme : ;
    skos:prefLabel "calligrapher agent"@en,
        "kalligrafi"@fi,
        "kalligraf"@sv .

:m1982 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1990 ;
    skos:definition "Länsimaisessa taidemusiikissa laajasti käytössä oleva nuottikirjoitusjärjestelmä, jossa sävelkorkeus ja kesto ilmaistaan useista samansuuntaisista viivoista koostuvalla viivastolla usein muiden nuottiviivastojen kanssa olevassa yhdistelmässä. Tavallisessa nuottiviivastossa on viisi viivaa, lyömäsoittimien nuoteissa voi olla 1–4-viivaisia viistoja."@fi,
        "Notskriftssystem som är i allmänt bruk inom västerländsk konstmusik. I ett vanligt notsystem finns fem linjer, för slaginstrument 1-4 linjer."@sv ;
    skos:exactMatch rdafmn:1007 ;
    skos:inScheme : ;
    skos:prefLabel "staff notation"@en,
        "viivastonuottikirjoitus"@fi,
        "traditionell västerländsk notskrift"@sv .

:m1983 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m2003 ;
    skos:definition "Tuntoaistiin perustuva kirjoitustapa tietotekniikkaan liittyvissä aineistoissa, mahdollistaa symbolien ja ASCII-merkistön esittämisen."@fi,
        "Skrivsätt som baserar sig på känselsinnet, i material som relaterar till datorteknik. Möjliggör visande av symboler och ASCII-tecken."@sv ;
    skos:exactMatch rdaftn:1002 ;
    skos:inScheme : ;
    skos:prefLabel "computing braille code"@en,
        "pistekirjoitus (8-pisteinen)"@fi,
        "punktskrift (8-punkt)"@sv .

:m1984 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "kombination"@sv ;
    skos:broader :m1988 ;
    skos:definition "Kuvasuhde liikkuvaa kuvaa sisältävälle aineistolle, joka käsittää useita eri kuvasuhteita."@fi,
        "Kombination av bildförhållandena full screen och wide screen."@sv ;
    skos:exactMatch rdaar:1003 ;
    skos:inScheme : ;
    skos:prefLabel "mixed aspect ratio"@en,
        "yhdistelmä (kuvasuhde)"@fi,
        "blandade bildförhållanden"@sv .

:m1985 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "johtoääni"@fi ;
    skos:broader :m2002 ;
    skos:definition "Pienehköissä orkestereissa yleisesti käytetty tärkeimpien äänien tiivistelmä, jota myös instrumenttia soittava orkesterin johtaja voi käyttää parituurin sijasta. Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m2036'>pianojohtostemma</a> ja <a href='http://urn.fi/URN:NBN:fi:au:mts:m2023'>viulujohtostemma</a>."@fi,
        "Ett sammandrag av de viktigaste stämmorna i en mindre orkester. Kan också användas av orkesterledaren i stället för partitur. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m2036'>pianodirektion</a> och <a href='http://urn.fi/URN:NBN:fi:au:mts:m2023'>violindirektion</a>."@sv ;
    skos:inScheme : ;
    skos:prefLabel "conductor score"@en,
        "johtostemma"@fi,
        "dirigentstämma"@sv .

:m1986 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "mensuralnotskrift"@sv ;
    skos:broader :m1990 ;
    skos:definition "Mensuraalinotaatio eli mensuraalinuottikirjoitus (lat. mensura 'mitta') osoittaa musiikin rytmiä nuottien aika-arvoilla. Järjestelmä oli käytössä 1200–1600-luvulla, ja se on nykyisen viivastonotaation edeltäjä. (Lähde: Wikipedia.)"@fi,
        "Mensuralnotation anger musikens rytm med hjälp av noters tidsvärde. Systemet användes mellan 1200- och 1600-talet, och det är föregångare till den moderna notskriften."@sv ;
    skos:exactMatch rdafmn:1003 ;
    skos:inScheme : ;
    skos:prefLabel "mensural notation"@en,
        "mensuraalinuottikirjoitus"@fi,
        "mensuralnotation"@sv .

:m1987 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Tanssinotaatio, jossa abstrakteilla symboleilla esitetään kehon ja raajojen asentoja takaapäin nähtynä. Notaatio merkitään pystysuoralle kolmiriviselle viivastolle. Kehitetty Yhdysvalloissa ja Iso-Britanniassa 1900-luvun keskivaiheilla."@fi,
        "Dansnotation som med abstrakta symboler visar kroppens och extremiteterna positioner sedda bakifrån. Notationen anges i ett vertikalt linjesystem med tre rader. Utvecklat i USA och Storbritannien vid mitten av 1900-talet."@sv ;
    skos:exactMatch rdafnv:1002 ;
    skos:inScheme : ;
    skos:prefLabel "Labanotation"@en,
        "Laban-notaatio"@fi,
        "Labanotation"@sv .

:m1989 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Liikenotaatio, jossa käytetään pallokoordinaatistoa ilmaisemaan kehon ja raajojen asentoa."@fi,
        "Rörelsenotation, i vilken ett system med sfäriska koordinater används för att ange kroppens och extremiteternas positioner."@sv ;
    skos:exactMatch rdafnv:1005 ;
    skos:inScheme : ;
    skos:prefLabel "Eshkol-Wachman movement notation"@en,
        "Eshkol-Wachman-liikenotaatio"@fi,
        "Eshkol-Wachmannotation"@sv .

:m1991 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2024-05-09"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Liikenotaation tyyppi, jossa abstrakteilla symboleilla esitetään kehon ja raajojen asentoja ja liikkeitä."@fi,
        "Typ av rörelsenotation, i vilken kroppens positioner och rörelser beskrivs med abstrakta symboler."@sv ;
    skos:exactMatch rdafnv:1009 ;
    skos:inScheme : ;
    skos:prefLabel "action stroke-dansnotation"@en,
        "action stroke -tanssinotaatio"@fi,
        "action stroke dance notation"@sv .

:m1992 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m2003 ;
    skos:definition "Tuntoaistiin perustuva nuottikirjoitustapa, jossa käytetään pistekirjoitussoluja."@fi,
        "Notskriftsmetod som grundar sig på känselsinnet och i vilken brailleceller används."@sv ;
    skos:exactMatch rdaftn:1005 ;
    skos:inScheme : ;
    skos:prefLabel "music braille code"@en,
        "pistenuottikirjoitus"@fi,
        "punktskrift för musik"@sv .

:m1993 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Tanssinotaatio, jossa abstrakteilla symboleilla esitetään kehon ja raajojen asentoja takaapäin nähtynä."@fi,
        "Dansnotation, i vilken kroppens och extremiteternas positioner visas sedda bakifrån och med abstrakta symboler."@sv ;
    skos:exactMatch rdafnv:1007 ;
    skos:inScheme : ;
    skos:prefLabel "Benesh movement notation"@en,
        "Benesh-liikenotaatio"@fi,
        "Beneshnotation"@sv .

:m1994 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "tabit"@fi,
        "tablaruuri"@fi,
        "täbit"@fi,
        "tabbar"@sv,
        "tablatur"@sv ;
    skos:broader :m1990 ;
    skos:definition "Tabulatuuri (usein myös muodossa tablatuuri, tabit tai täbit) on erityisesti kielisoittimelle tarkoitettu soitto-ohje, joka on verrattavissa pianon nuotteihin. Tabulatuureissa käytetään yleensä kirjain- ja numerosymboleita merkitsemään soitossa käytettävien sormien asettelua. Tabulatuureja käytetään soitto-ohjeina muun muassa kitaralle, bassolle, rummuille, huuliharpulle ja ukulelelle. (Lähde: Wikipedia.)"@fi,
        "Med tabulatur avses spelanvisningar som är avsedda speciellt för stränginstrument. I tabulaturskrift används vanligtvis bokstavs- och siffersymboler för att ange hur fingrarna positioneras i spelandet. Tabulatur används vid anvisningar för t.ex. gitarr-, bas-, trum-, munspels- och ukulelespelning."@sv ;
    skos:exactMatch rdafmn:1008 ;
    skos:inScheme : ;
    skos:prefLabel "tablature"@en,
        "tabulatuuri"@fi,
        "tabulatur"@sv .

:m1995 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "neumskrift"@sv ;
    skos:broader :m1990 ;
    skos:definition "Yksiäänisessä bysanttilaisessa, ortodoksisessa ja katolisessa kirkkolaulussa käytetty nuottikirjoitus, jossa rytmiä ei yleensä merkitä. (Lähde: englanninkielinen Wikipedia.)"@fi,
        "Notskrift använd i enstämmig bysantisk, ortodox och katolsk kyrkosång. Neumer anger vanligtvis inte rytm."@sv ;
    skos:exactMatch rdafmn:1010 ;
    skos:inScheme : ;
    skos:prefLabel "neumatic notation"@en,
        "neumikirjoitus"@fi,
        "neumer"@sv .

:m1997 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Tanssinotaatio, jossa musiikkinotaatiota käytetään esittämään kehon yksittäisten osien liikettä."@fi,
        "Dansnotation, i vilken musiknotation används för att visa rörelse i enskilda delar av kroppen."@sv ;
    skos:exactMatch rdafnv:1001 ;
    skos:inScheme : ;
    skos:prefLabel "Stepanov dance notation"@en,
        "Stepanov-tanssinotaatio"@fi,
        "Stepanovnotation"@sv .

:m1999 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "vokaalipartituuri (kuoropartituuri)"@fi,
        "vokalpartitur (körpartitur)"@sv ;
    skos:broader :m2002 ;
    skos:definition "Kuoron harjoituskäyttöön tarkoitettu, kuorolle ja soittimille, mahdollisesti myös solistisille lauluäänille sävelletyn teoksen partituuri, jossa kuoroäänet on merkitty omille viivastoilleen, ja josta soitinsäestys on joko jätetty kokonaan pois tai sisällytetty osittain ja pelkistetysti kosketinsoittimelle tai muille sointusoittimille sovitettuna. Jos soitinsäestys on merkitty täydellisenä, käytetään termiä <a href='http://urn.fi/URN:NBN:fi:au:mts:m2020'>partituuri</a>. Jos teos on alun perin sävelletty säestyksettömälle kuorolle, käytetään termiä <a href='http://urn.fi/URN:NBN:fi:au:mts:m2020'>partituuri</a>."@fi,
        "Partitur avsett för körövning, innehållande körens, instrumentens och möjligtvis även solistens stämmor. Körens stämmor är noterade i separata notsystem och ackompanjemanget är bortlämnat helt eller ingår delvis i arrangemang för tangent- eller andra instrument. Om ackompanjemanget är noterat i sin helhet, används termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2020'>partitur</a>. Ifall verket ursprungligen är komponerat för kör utan ackompanjemang, används termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2020'>partitur</a>."@sv ;
    skos:exactMatch rdafnm:1002 ;
    skos:inScheme : ;
    skos:prefLabel "chorus score"@en,
        "kuoropartituuri"@fi,
        "körpartitur"@sv .

:m2 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-12-18"^^xsd:date ;
    skos:altLabel "selostaja (suhde)"@fi,
        "referent (relation)"@sv ;
    skos:broader :m5289 ;
    skos:definition "Esittäjä, joka osallistuu ekspression tekemiseen selostamalla, esim. urheiluselostaja."@fi,
        "Framförande person som deltar i utförandet av ett uttryck genom att referera, t.ex. sportkommentator."@sv ;
    skos:inScheme : ;
    skos:prefLabel "selostaja"@fi,
        "referent"@sv .

:m2000 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m2003 ;
    skos:definition "Tuntoaistiin perustuva kirjoitustapa, jossa kirjoitusmerkit muodostuvat kuuden pisteen kohokuvioista."@fi,
        "Skrivsätt baserat på känselsinnet, i vilket skrivtecknen utgörs av upphöjda mönster med sex punkter."@sv ;
    skos:exactMatch rdaftn:1001 ;
    skos:inScheme : ;
    skos:prefLabel "braille code"@en,
        "pistekirjoitus (6-pisteinen)"@fi,
        "punktskrift (6-punkt)"@sv .

:m2001 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "bokstavsnotation"@sv,
        "bokstavsnotskrift"@sv ;
    skos:broader :m1990 ;
    skos:definition "Nuottikirjoitus, jossa sävelkorkeudet on merkitty kirjaimin."@fi,
        "Notation som anger tonhöjd med hjälp av bokstäver."@sv ;
    skos:exactMatch rdafmn:1002 ;
    skos:inScheme : ;
    skos:prefLabel "letter notation"@en,
        "kirjainnuottikirjoitus"@fi,
        "bokstavsnotering"@sv .

:m2005 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "kosketeltava nuottikirjoitus"@fi ;
    skos:broader :m2003 ;
    skos:definition "Tuntoaistiin perustuva nuottikirjoitustapa musiikille."@fi,
        "Musiknotation som avläses genom beröring."@sv ;
    skos:exactMatch rdaftn:1006 ;
    skos:inScheme : ;
    skos:prefLabel "tactile musical notation"@en,
        "taktiili nuottikirjoitus"@fi,
        "taktil musiknotation"@sv .

:m2006 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "grafisk notering"@sv,
        "grafisk notskrift"@sv ;
    skos:broader :m1990 ;
    skos:definition "Nuottikirjoitus, jossa musiikkia merkitään perinteisessä nuottikirjoituksessa käytettävistä symboleista eroavien visuaalisten symbolien avulla. (Lähde: englanninkielinen Wikipedia.)"@fi,
        "Noterad musik som uttrycker musik med hjälp av grafiska symboler, annorlunda än i traditionell noterad musik."@sv ;
    skos:exactMatch rdafmn:1001 ;
    skos:inScheme : ;
    skos:prefLabel "graphic notation"@en,
        "graafinen nuottikirjoitus"@fi,
        "grafisk notation"@sv .

:m2007 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Tanssinotaatio, jossa abstraktit symbolit esittävät jalkojen liikkeitä yhdistettynä samaan aikaan esitettävän musiikin kanssa."@fi,
        "Dansnotation i vilken abstrakta symboler visar fötternas rörelser, förenade med musiken som ska framföras samtidigt."@sv ;
    skos:exactMatch rdafnv:1008 ;
    skos:inScheme : ;
    skos:prefLabel "Beauchamp-Feuillet notation"@en,
        "Beauchamp-Feuillet-notaatio"@fi,
        "Feuilletnotation"@sv .

:m2009 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Liikenotaatio pelaajien tai pelinappuloiden asemien tallentamiseksi pelin aikana."@fi,
        "Rörelsenotation för att lagra spelarnas eller spelknapparnas positioner under spelets gång."@sv ;
    skos:exactMatch rdafnv:1004 ;
    skos:inScheme : ;
    skos:prefLabel "game play notation"@en,
        "pelinotaatio"@fi,
        "spelnotation"@sv .

:m201 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m346 ;
    skos:definition "Viivana, muotona, varjostuksena tms. esitetty kartografinen sisältö, joka on tarkoitettu katsottavaksi kaksiulotteisena stillkuvana tai -kuvina. Esimerkiksi kartat, näkymäkartat, kartastot, kaukokartoituskuvat jne."@fi,
        "Kartografiskt innehåll uttryckt som linje, form, skugga e.d., avsett att ses som tvådimensionell stillbild eller -bilder. T.ex. kartor, utsiktskartor, kartböcker och fjärranalysbilder."@sv ;
    skos:exactMatch rdaco:1002 ;
    skos:inScheme : ;
    skos:prefLabel "cartographic image"@en,
        "kartografinen kuva"@fi,
        "kartografisk bild"@sv .

:m2010 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "bredbild"@sv ;
    skos:broader :m1988 ;
    skos:definition "Liikkuvan kuvan kuvasuhde, joka on 1.5:1 tai suurempi"@fi,
        "Bildförhållande i rörlig bild, som är 1.5:1 eller större."@sv ;
    skos:exactMatch rdaar:1002 ;
    skos:inScheme : ;
    skos:prefLabel "wide screen"@en,
        "wide screen"@fi,
        "wide screen"@sv .

:m2011 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1988 ;
    skos:definition "Liikkuvan kuvan kuvasuhde, joka on pienempi kuin 1.5:1"@fi,
        "Bildförhållande för rörlig bild, som är mindre än 1.5:1."@sv ;
    skos:exactMatch rdaar:1001 ;
    skos:inScheme : ;
    skos:prefLabel "full screen"@en,
        "full screen"@fi,
        "normalbild"@sv .

:m2012 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Tanssinotaatio, jossa esittävin ja abstraktein symbolein esitetään kehon ja raajojen asentoja ja liikkeitä."@fi,
        "Dansnotation, i vilken kroppens och extremiteternas positioner och rörelser visas med deskriptiva och abstrakta symboler."@sv ;
    skos:exactMatch rdafnv:1006 ;
    skos:inScheme : ;
    skos:prefLabel "DanceWriting"@en,
        "DanceWriting"@fi,
        "DanceWriting"@sv .

:m2013 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2024-04-12"^^xsd:date ;
    skos:altLabel "numeronuottikirjoitus"@fi,
        "numerisk notation"@sv,
        "siffernotskrift"@sv ;
    skos:broader :m1990 ;
    skos:definition "Nuottikirjoituksen tyyppi, jossa sävelkorkeus ilmaistaan numeroilla, jotka edustavat asteikon säveliä, kosketinsoittimen koskettimia, kielisoittimen otteita tai nauhoja tai puhallinsoittimen reikiä tai venttiilejä."@fi,
        "Notation i vilken tonhöjder är markerade med siffror. Siffernotation har också använts för att markera tonklasser eller intervall med siffror i teoriböcker som behandlar tolvtonssystem."@sv ;
    skos:exactMatch rdafmn:1004 ;
    skos:inScheme : ;
    skos:prefLabel "number notation"@en,
        "numeronotaatio"@fi,
        "siffernotation"@sv .

:m2015 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m1981 ;
    skos:definition "Tanssinotaatio, jossa abstrakteilla symboleilla merkitään pystysuoralle kolmiriviselle viivastolle kehon ja raajojen liikkeitä takaapäin nähtynä. Kehitetty Euroopassa 1900-luvun keskivaiheilla."@fi,
        "Dansnotation, i vilken kroppens rörelser anges sedda bakifrån, med abstrakta symboler på ett lodrätt treradigt linjesystem. Utvecklat i Europa i mitten av 1900-talet."@sv ;
    skos:exactMatch rdafnv:1010 ;
    skos:inScheme : ;
    skos:prefLabel "Kinetography Laban"@en,
        "Kinetography Laban -notaatio"@fi,
        "Kinetography Laban-notation"@sv .

:m2016 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m2003 ;
    skos:definition "Tuntoaistiin perustuva kirjoitustapa, joka perustuu yksinkertaistettuihin kirjainmerkkeihin."@fi,
        "Skrivsätt som baserar sig på känselsinnet och på förenklade skrivtecken."@sv ;
    skos:exactMatch rdaftn:1004 ;
    skos:inScheme : ;
    skos:prefLabel "Moon code"@en,
        "Moonin kirjoitus"@fi,
        "Moonskrift"@sv .

:m2017 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m2003 ;
    skos:definition "Tuntoaistiin perustuvan kirjoitustavan muoto, jota käytetään matemaattisen ja tieteellisen tiedon kirjoittamiseen."@fi,
        "Form av skrivsätt som baserar sig på känselsinnet och används för författandet av matematiska eller e.d. vetenskapliga texter."@sv ;
    skos:exactMatch rdaftn:1003 ;
    skos:inScheme : ;
    skos:prefLabel "mathematics braille code"@en,
        "matematiikan pistekirjoitus"@fi,
        "matematisk punktskrift"@sv .

:m2018 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-02-28"^^xsd:date ;
    dct:modified "2024-10-03"^^xsd:date ;
    skos:altLabel "taktil grafik"@sv ;
    skos:broader :m2003 ;
    skos:definition "Tuntoaistiin perustuva merkintätapa, jossa käytetään kohotettua versiota painetusta kuvasta."@fi,
        "Märkning som baserar sig på känselsinnet och i vilket en upphöjd version av en tryckt bild används."@sv ;
    skos:exactMatch rdaftn:1007 ;
    skos:inScheme : ;
    skos:prefLabel "tactile graphic"@en,
        "kohokuva"@fi,
        "relief"@sv .

:m2019 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "ääni"@fi ;
    skos:broader :m2002 ;
    skos:definition "Sellaisen nuottiaineiston muoto, joka sisältää nuotit yhdelle tai useammalle, mutta ei kaikille esittäjille (esimerkiksi viulukonserton viulustemma tai orkesteriteoksen harppustemma)."@fi,
        "Notmaterial bestående av noter för en eller flera, men inte alla, framförare (t.ex. violinstämmorna i en violinkonsert eller harpstämman i ett orkesterverk.)"@sv ;
    skos:exactMatch rdafnm:1004 ;
    skos:inScheme : ;
    skos:prefLabel "part"@en,
        "stemma"@fi,
        "stämma"@sv .

:m202 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m88 ;
    skos:inScheme : ;
    skos:prefLabel "CAD"@fi,
        "CAD"@sv .

:m2020 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "score"@en ;
    skos:broader :m2002 ;
    skos:definition "Sellaisen nuottiaineiston muoto, joka koostuu graafisesta, symbolisesta tai sanallisesta nuottikirjoituksesta, ja johon sisältyy kokoonpanon kaikkien stemmojen sisältö. Nuottiaineistosta, joka edustaa teosta yhdelle soittimelle tai yhdelle soittajalle, käytetään termiä <a href='http://urn.fi/URN:NBN:fi:au:mts:m2037'>soolonuotti</a>."@fi,
        "Nottryck som består av grafisk, symbolisk eller verbal notskrift, och i vilken hela orkesterbesättningens stämmor ingår. För notskrift för ett instrument eller för en musiker används termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2037'>solonot</a>."@sv ;
    skos:exactMatch rdafnm:1007 ;
    skos:inScheme : ;
    skos:prefLabel "(full) score"@en,
        "partituuri"@fi,
        "partitur"@sv .

:m2021 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:broader :m2002 ;
    skos:definition "Partituuri, jossa nuottiviivastojen määrä on rajattu kahteen tai muutamaan, yleensä soitinryhmittäin järjestettynä ja usein sisältäen viittauksia yksittäisiin ääniin."@fi,
        "Partitur i vilket notlinjernas mängd har begränsats till två eller några, vanligen ordnade i instrumentgrupper och ofta innehållande hävisningar till enskilda stämmor."@sv ;
    skos:exactMatch rdafnm:1003 ;
    skos:inScheme : ;
    skos:prefLabel "condensed score"@en,
        "partituurin tiivistelmä"@fi,
        "reducerat partitur"@sv .

:m2022 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m8 ;
    skos:definition "Soitonopetusaineistoa sisältävä nuottiaineisto."@fi,
        "Resurs för musikundervisning innehållande notmaterial."@sv ;
    skos:inScheme : ;
    skos:prefLabel "soitonopas"@fi,
        "instrumentskola"@sv ;
    skos:scopeNote "Soitonoppaan kaltaiset aineistot, joissa nuottiaineiston osuus on tekstiaineistoon verrattuna vähäinen, käsitellään tekstiaineistona."@fi,
        "Resurser som påminner om instrumentskolor, men har mindre notmaterial än textmaterial, bör behandlas på samma sätt som textresurser."@sv .

:m2023 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:broader :m2002 ;
    skos:definition "Yhtyeen tai orkesterin viulistin esitysstemma, jossa on viitteitä muihin soittimiin, jotta stemman soittaja voi myös johtaa yhtyettä. Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m1985'>johtostemma</a> ja <a href='http://urn.fi/URN:NBN:fi:au:mts:m2036'>pianojohtostemma</a>."@fi,
        "Framförandestämma för en ensembles eller orkesters violinist, i vilken hänvisningar till övriga instrument framkommer så att violinisten kan leda ensemblen. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m1985'>dirigentstämma</a> och <a href='http://urn.fi/URN:NBN:fi:au:mts:m2036'>pianodirektion</a>."@sv ;
    skos:exactMatch rdafnm:1010 ;
    skos:inScheme : ;
    skos:prefLabel "violin conductor part"@en,
        "viulujohtostemma"@fi,
        "violindirektion"@sv .

:m2024 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "sävelmänuotinnos"@fi ;
    skos:broader :m2002 ;
    skos:definition "Populaari- tai kansanmusiikin nuottiaineisto, joka sisältää vokaali- ja/tai soitinteoksen yksinkertaistetun nuotinnoksen (sisältää yleensä pelkästään melodian ja sointumerkit tai melodian yksinkertaistetulla pianosäestyksellä)."@fi,
        "Notmaterial för populär- eller folkmusik, som innehåller förenklad notation för ett vokalt och/eller instrumentalt verk (innehåller vanligen endast melodi och ackordbeteckningar eller melodi med förenklat pianoackompanjemang)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "sävelmänuotti"@fi,
        "melodinoter"@sv .

:m2025 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "compressed score"@en,
        "short score"@en ;
    skos:broader :m2002 ;
    skos:definition "Muutamalle (2–5) viivastolle pelkistetty yhtye- tai orkesteriteoksen partituuri, jota käytetään esimerkiksi sävellys- ja sovitustyössä ennen varsinaisen partituurin kirjoittamista. Termiä on syytä käyttää vain silloin, kun se esiintyy itse julkaisussa."@fi,
        "Förenklad ensemble- eller orkesterpartitur på 2-5 linjer som används i t.ex. tonsättning eller arrangemang innan skrivandet av det egentliga partituret. Används endast ifall termen anges i själva publikationen."@sv ;
    skos:inScheme : ;
    skos:prefLabel "close score"@en,
        "partiselli"@fi,
        "particell"@sv .

:m2027 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "korbok"@sv ;
    skos:broader :m2002 ;
    skos:definition "Suuri, kuoron eteen telineelle asetettava nuottikirja. Jokainen ääni on nuotinnettu erikseen yleensä noudattaen asetelmaa, jossa avoinna olevassa kirjassa lehden kääntöpuolella ovat sopraano- ja tenoriäänet ja seuraavan lehden etupuolella altto- ja bassoäänet."@fi,
        "Stor bok med notskrift som placeras på notställ framför kör. Varje stämma är separat noterad. Vanligtvis är sopran- och tenorstämmorna uppställda på uppslagets vänstra sida, alt- och basstämmorna på uppslagets högra sida."@sv ;
    skos:exactMatch rdafnm:1001 ;
    skos:inScheme : ;
    skos:prefLabel "choir book"@en,
        "kuorokirja"@fi,
        "körbok"@sv .

:m2029 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "vokaalipartituuri (pianopartituuri)"@fi,
        "klaverutdrag"@sv,
        "vokalpartitur (pianopartitur)"@sv ;
    skos:broader :m2002 ;
    skos:definition "Ensisijaisesti harjoituskäyttöön tarkoitettu, soololauluäänille/kuorolle ja/tai solistisille soittimille ja orkesterille sävelletyn teoksen pelkistys versioksi, jossa laulu- ja soolosoitinäänet ovat partituurimuodossa ja koko teoksen orkesterisäestys on sovitettu kosketinsoittimelle. Kuoron harjoituskäyttöön tarkoitetusta partituurista käytetään termiä <a href='http://urn.fi/URN:NBN:fi:au:mts:m1999'>kuoropartituuri</a>. Termiä vokaalipartituuri ei käytetä nuottiaineiston muodon merkitsemisessä"@fi,
        "I första hand ämnad för övning, en förenklad version av ett verk komponerat för soloröst/kör och/eller soloinstrument/orkester i vilket sång- och soloinstrumentstämman är i partiturformat och hela verkets orkesterackompanjemang är anpassat till tangentinstrument. För partitur avsett för körövning används termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m1999'>körpartitur</a>."@sv ;
    skos:exactMatch rdafnm:1006 ;
    skos:inScheme : ;
    skos:prefLabel "pianopartituuri"@fi,
        "pianopartitur"@sv .

:m203 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-10-04"^^xsd:date ;
    skos:broader :m417 ;
    skos:definition "Käytetään manifestaatiosta, jonka sisältämän teoksen tai teosten vastuullisuustekijä tai -tekijät on itse kirjoittanut käsin."@fi,
        "Anges om en manifestation som innehåller verk som en upphovsman själv skrivit ner för hand."@sv ;
    skos:inScheme : ;
    skos:prefLabel "holograph"@en,
        "omakätinen käsikirjoitus"@fi,
        "egenhändig handskrift"@sv .

:m2030 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2025-01-08"^^xsd:date ;
    skos:broader :m5302 ;
    skos:definition "Henkilö, joka osallistuu ekspression tekemiseen sovittamalla draamallisen teoksen esitykseksi."@fi,
        "Person som deltar i utförandet av ett uttryck genom att bearbeta ett dramatiskt verk till en föreställning."@sv ;
    skos:inScheme : ;
    skos:prefLabel "dramaturgi (ekspressio)"@fi,
        "dramaturg (uttryck)"@sv .

:m2031 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m8 ;
    skos:definition "Musiikinteorian opetusaineistoa sisältävä nuottiaineisto."@fi,
        "Notmaterial som innehåller undervisningsmaterial för musikteori."@sv ;
    skos:inScheme : ;
    skos:prefLabel "teorianopas"@fi,
        "teoribok"@sv ;
    skos:scopeNote "Musiikinteorian aineistot, joissa nuottiaineiston osuus on tekstiaineistoon verrattuna vähäinen, käsitellään tekstiaineistona."@fi,
        "Musikteoretiskt material, i vilket notmaterialets andel är liten jämfört med textmaterialets, behandlas som textmaterial."@sv .

:m2032 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:broader :m2002 ;
    skos:definition "Nuottikirja, joka on tehty asetettavaksi pöydälle ja näytettäväksi siten, että esittäjät voivat lukea stemmansa istuessaan tai seistessään pöydän ympärillä. Jokainen stemma nuotinnetaan erikseen ja asetellaan yleensä siten, että kirjan ollessa auki eri stemmat esitetään käännetyssä ja/tai kohtisuorassa asennossa."@fi,
        "Bok med notskrift, avsedd att läggas fram på ett bord på ett sådant sätt att framförarna kan avläsa sin stämma sittande eller stående runt bordet. Varje stämma noteras skilt och arrangeras vanligtvis så, att när boken ligger öppen står olika stämmor upp och nedvänt och/eller vinkelrätt mot varandra."@sv ;
    skos:exactMatch rdafnm:1009 ;
    skos:inScheme : ;
    skos:prefLabel "table book"@fi,
        "table book"@sv .

:m2034 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "miniature score"@en,
        "fickpartitur"@sv ;
    skos:broader :m2002 ;
    skos:definition "Pienennetyssä muodossa julkaistu partituuri, ei tarkoitettu ensisijaisesti esityskäyttöön. Aineistossa esiintyy tavallisesti kuvaileva ilmaus, kuten \"pienoispartituuri\", \"Miniature score\", \"Taschenpartitur\", \"Partition de poche\" tms."@fi,
        "Partitur som publicerats i förminskat format, inte avsett i första hand för användning vid framförande. I materialet förekommer vanligen någon beskrivande fras, såsom \"studiepartitur\", \"Miniature score\", \"Taschenpartitur\", \"Partition de poche\" e.d."@sv ;
    skos:exactMatch rdafnm:1008 ;
    skos:inScheme : ;
    skos:prefLabel "study score"@en,
        "pienoispartituuri"@fi,
        "Partition de poche"@fr,
        "studiepartitur"@sv .

:m2035 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2025-01-08"^^xsd:date ;
    skos:altLabel "kuvatoimittaja (suhde)"@fi,
        "bildredaktör (relation)"@sv ;
    skos:broader :m5352 ;
    skos:definition "Lehtien toimituksissa tai kustantamoissa työskentelevä kuvituksesta ja kuvien hankinnasta vastaava toimittaja; kuvatoimistossa työskentelevä kuvien hankkija. (Lähde: Kielitoimiston sanakirja)."@fi,
        "Redaktör som arbetar vid tidningars redaktioner eller förlag och ansvarar för illustrationer eller förvärv av bilder; person som arbetar vid bildbyrå och ansvarar för förvärv av bilder."@sv ;
    skos:inScheme : ;
    skos:prefLabel "kuvatoimittaja"@fi,
        "bildredaktör"@sv .

:m2036 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:broader :m2002 ;
    skos:definition "Yhtyeen tai orkesterin pianistin esitysstemma, jossa on viitteitä muihin soittimiin, jotta stemman soittaja voi myös johtaa yhtyettä. Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m1985'>johtostemma</a> ja <a href='http://urn.fi/URN:NBN:fi:au:mts:m2023'>viulujohtostemma</a>."@fi,
        "Framförandestämma för ensemblens eller orkesterns pianist, i vilken hänvisningar till övriga instrument framkommer så att pianisten kan leda ensemblen. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m1985'>dirigentstämma</a> och <a href='http://urn.fi/URN:NBN:fi:au:mts:m2023'>violindirektion</a>."@sv ;
    skos:exactMatch rdafnm:1005 ;
    skos:inScheme : ;
    skos:prefLabel "piano conductor part"@en,
        "pianojohtostemma"@fi,
        "pianodirektion"@sv .

:m2037 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2017-03-01"^^xsd:date ;
    dct:modified "2024-10-02"^^xsd:date ;
    skos:altLabel "soolonuotinnos"@fi,
        "solonoter"@sv,
        "solostämma"@sv ;
    skos:broader :m2002 ;
    skos:definition "Nuottiaineisto, joka sisältää yhdelle soittimelle tai yhdelle esittäjälle tarkoitetun musiikkiteoksen nuotinnoksen (esimerkiksi Beethovenin Für Elise (pianolle), Messiaenin Le banquet céleste (uruille), Xenakiksen Pléïades (lyömäsoittimille) ja Debussyn Syrinx (huilulle))"@fi,
        "Nottryck som består av notskrift för ett instrument eller en framförare, t.ex. Beethovens Für Elise (för piano), Messiaens Le banquet céleste (för orgel), Xenakis Pléïades (för slaginstrument) och Debussys Syrinx (för flöjt)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "soolonuotti"@fi,
        "solonot"@sv .

