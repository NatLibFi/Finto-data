    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m580 ;
    skos:definition """Myönnetään kotimaiselle tekijälle yksin tai yhdessä toisen osapuolen kanssa tekemästä ansiokkaasta sarjakuva-albumista.
Tunnustuspalkinto myönnetään vuosittain keväällä Tampere Kuplii -sarjakuvatapahtumassa."""@fi,
        "Utdelas åt en inhemsk författare som ensam eller med en annan part gett ut ett meriterat seriealbum. Hederspriset utdelas varje vår under seriefestivalen Tampere Kuplii."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Sarjakuva-Finlandia-palkinto, 2010"@fi,
        "I MARC 21-formatet: 586 ## ‡a Serie-Finlandiapriset, 2010"@sv ;
