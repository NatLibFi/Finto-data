    dct:modified "2025-05-27"^^xsd:date ;
    skos:altLabel "liikkuvaan kuvaan osallinen dubbausohjaaja (henkilö)"@fi,
        "dubbningsregissör (person) som är bidragsgivare till rörlig bild"@sv ;
    skos:broader :m5313 ;
    skos:definition "Aggregaattiin sisältyvää ääniraitaa täydentävän dialogin tai muiden äänien lisäämisen yleisestä johtamisesta ja valvonnasta vastaava henkilö."@fi,
        "Person som svarar för allmän ledning och övervakning av tillägget av dialog eller andra röster, som kompletterar ett ljudspår som ingår i ett aggregat."@sv ;
    skos:inScheme : ;
    skos:prefLabel "dubbausohjaaja"@fi,
        "dubbningsregissör"@sv .

:m5304 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-19"^^xsd:date ;
    skos:altLabel "sovittaja (yhteisö)"@fi,
        "arrangör (institution)"@sv ;
    skos:broader :m5739 ;
    skos:definition "Yhteisö, joka osallistuu teoksen ekspression tekemiseen muokkaamalla sävellyksen alkuperäisteoksesta poikkeavalle esityskokoonpanolle. (RDA Registry)"@fi,
        "Institution som deltar i utförandet av ett verks uttryck, genom att omarbeta kompositionen för en musikalisk besättning som avviker från originalverket."@sv ;
    skos:exactMatch rdae:P20483 ;
    skos:inScheme : ;
    skos:prefLabel "arranger corporate body of music"@en,
        "sovittaja"@fi,
        "arrangör"@sv ;
    skos:scopeNote "Sovittaja voi myös muokata teosta samalle esityskokoonpanolle tms. säilyttäen alkuperäisen sävellyksen musiikillisen sisällön olennaisilta osin muuttumattomana. Tähän ei sisälly laaja muokkaaminen, joka johtaa uuden musiikkiteoksen luomiseen. (RDA Registry)"@fi,
        "En arrangör kan också bearbeta verket för samma musikaliska besättning eller dylikt och bevara originalkompositionens musikaliska innehåll till sina väsentliga delar oförändrade. I detta ingår inte omfattande ändringar som leder till skapandet av ett nytt musikverk."@sv .

