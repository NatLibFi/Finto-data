:m77 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-03-13"^^xsd:date ;
    skos:broader :m654 ;
    skos:definition "Materiaali, joka on kemiallinen yhdistelmä eläin-, kasvi- ja mineraalipohjaisia tai synteettisiä aineita. Vaha on muokattavissa ympäristön lämpötilassa, se tuntuu liukkaalta, sillä on alhainen sulamispiste ja yleensä läpikuultava, vettä hylkivä pinta ja se liukenee orgaanisiin liuottimiin."@fi,
        "Material som är en kemisk förening av djur-, växt-, mineralbaserade eller syntetiska ämnen. Vax kan bearbetas i omgivningens temperatur, det känns glatt, har en låg smältpunkt och vanligen en genomskinlig, vattenavstötande yta, samt upplöses i organiska lösningsmedel."@sv ;
    skos:exactMatch rdamat:1044 ;
    skos:inScheme : ;
    skos:prefLabel "vax"@en,
        "vaha"@fi,
        "vax"@sv .

