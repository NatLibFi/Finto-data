    skos:broader :m3609 ;
    skos:closeMatch yso:p11876 ;
    skos:example "kirkolliskokous, kirkkohallitus, Suomen ortodoksinen kirkollishallitus, tuomiokapitulit, rovastikunnat, evankelis-luterilaiset ja ortodoksiset seurakunnat"@fi,
        "kyrkomötet, kyrkostyrelsen, kyrkostyrelsen för Finlands ortodoxa kyrka, domkapitel, prosterier, evangelisk-lutherska och ortodoxa församlingar"@sv ;
