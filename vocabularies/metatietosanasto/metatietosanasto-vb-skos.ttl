    skos:exactMatch rdai:P40020 ;
    skos:inScheme : ;
    skos:prefLabel "custodian agent"@en,
        "säilyttäjä"@fi,
        "förvarare"@sv .

:m447 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m346 ;
    skos:definition """Viivoina, muotoina, varjostuksina jne. esitetty sisältö, joka on tarkoitettu katsottavaksi kaksiulotteisena stillkuvana tai -kuvina. Esimerkiksi piirrokset, maalaukset, diagrammit, valokuvat jne.
Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m201'>kartografinen kuva</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m948'>taktiili kuva</a>."""@fi,
        "Innehåll presenterat som streck, former, skuggningar etc. som är avsett att betraktas som en eller flera tvådimensionella stillbilder. Till exempel ritningar, målningar, diagram, fotografier etc. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m201'>kartografisk bild</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m948'>taktil bild</a>."@sv ;
    skos:exactMatch rdaco:1014 ;
    skos:inScheme : ;
    skos:prefLabel "still image"@en,
        "stillkuva"@fi,
        "stillbild"@sv .

:m448 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-08-15"^^xsd:date ;
    skos:altLabel "instructor"@en,
        "opettaja (suhde)"@fi,
        "opettaja (toimija)"@fi,
        "lärare (aktör)"@sv,
        "lärare (relation)"@sv ;
    skos:broader :m1060 ;
    skos:definition "Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen opettamalla tai pitämällä havaintoesityksen. (RDA Registry)"@fi,
        "Aktör som är en framförare, som deltar i utförandet av ett uttryck, genom att undervisa eller hålla en demonstration."@sv ;
    skos:exactMatch rdae:P20015 ;
    skos:inScheme : ;
    skos:prefLabel "instructor agent"@en,
        "opettaja"@fi,
        "lärare"@sv .

:m4498 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "YSO-termi"@fi,
        "ALLFO-term"@sv,
        "Nationell RDA-term"@sv ;
    dct:created "2020-05-16"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m3764 ;
    skos:closeMatch yso:p23164 ;
    skos:definition "Yhteisöpedagogit ovat järjestö- ja nuorisotyön ammattilaisia ja asiantuntijoita, jotka työskentelevät kunnissa, järjestöissä, laitoksissa ja yrityksissä ohjaajina, kouluttajina, suunnittelijoina ja koordinaattoreina. (https://www.humak.fi/opiskelijaksi/yhteisopedagogi/)"@fi,
        "Professionella specialister inom organisations- och ungdomsarbete, som kan arbeta i kommuner, organisationer, anstalter och företag som handledare, utbildare, planerare och koordinatorer."@sv ;
    skos:inScheme : ;
    skos:prefLabel "yhteisöpedagogi"@fi,
        "samhällspedagog"@sv .

:m450 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-05"^^xsd:date ;
    skos:broader :m346 ;
    skos:definition """Muotona tai muotoina esitetty sisältö, joka on tarkoitettu katsottavaksi kolmiulotteisena. Esimerkiksi veistokset, mallit, luonnonesineet, hologrammit jne.
Katso myös <a href='http://urn.fi/URN:NBN:fi:au:mts:m905'>kartografinen kolmiulotteinen muoto</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1131'>taktiili kolmiulotteinen muoto</a>."""@fi,
        "Innehåll uttryckt som form eller former avsedda att betraktas som tredimensionella. T.ex. skulpturer, modeller, naturliga föremål, hologram. Se även <a href='http://urn.fi/URN:NBN:fi:au:mts:m905'>kartografisk tredimensionell form</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m1131'>taktil tredimensionell form</a>."@sv ;
    skos:exactMatch rdaco:1021 ;
    skos:inScheme : ;
    skos:prefLabel "three-dimensional form"@en,
        "kolmiulotteinen muoto"@fi,
        "tredimensionell form"@sv .

:m455 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m439 ;
    skos:definition "Kuvasisältö, joka esittää taulukon tai kaavion muodossa henkilön tai suvun sukujuuret."@fi,
        "Illustrativt innehåll som visar en persons eller släkts härkomst i form av en tabell eller schematisk bild."@sv ;
    skos:exactMatch rdaill:1004 ;
    skos:inScheme : ;
    skos:prefLabel "genealogical table"@en,
        "sukutaulu"@fi,
        "släkttavla"@sv ;
    skos:scopeNote "Monikossa: sukutauluja, xx sukutaulua"@fi,
        "I plural: släkttavlor, xx släkttavlor"@sv .

:m4575 a mts-meta:Hierarchy,
        skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-06-06"^^xsd:date ;
    dct:modified "2024-10-04"^^xsd:date ;
    skos:broader :m176 ;
    skos:inScheme : ;
    skos:prefLabel "Sexual orientation"@en,
        "Seksuaalinen suuntautuneisuus"@fi,
        "Sexuell läggning"@sv ;
    skos:scopeNote "Käytetään määrittämään ryhmän jäsenten seksuaalista suuntautumista kuvaavia termejä (esim. biseksuaalit, heteroseksuaalit, homot, lesbot). Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä <a href='http://www.yso.fi/onto/yso/p487'>väestöryhmään liittyvä rooli</a>."@fi,
        "Används för att bestämma termer som beskriver sexuell läggning hos medlemmar i en grupp (t.ex. bisexuella, heterosexuella, homosexuella män, lesbiska). Vid val av enskilda termer används ALLFO-termer ur gruppen <a href='http://www.yso.fi/onto/yso/p487'>roll relaterad till befolkningsgrupp</a>."@sv .

:m4576 a mts-meta:Hierarchy,
        skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-06-06"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m176 ;
    skos:inScheme : ;
    skos:prefLabel "Medical, psychological, and disability"@en,
        "Terveys/toimintakyky"@fi,
        "Hälsa/funktionsförmåga"@sv ;
    skos:scopeNote "Käytetään määrittämään ryhmän jäsenten terveydellistä tilaa tai toimintakykyä kuvaavia termejä (esim. kuulovammaiset, psyykkisesti sairaat, päihdekuntoutujat, sokeat)."@fi,
        "Används för att bestämma termer som anger hälsotillstånd eller funktionsförmåga hos medlemmar av en grupp (t.ex. personer med hörselskada, psykiskt sjuka, klienter i missbrukarrehabilitering, blinda)."@sv .

:m4577 a mts-meta:Hierarchy,
        skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-06-06"^^xsd:date ;
    dct:modified "2024-10-04"^^xsd:date ;
    skos:broader :m176 ;
    skos:inScheme : ;
    skos:prefLabel "National/regional"@en,
        "Kansallisuus/asuinalue"@fi,
        "Nationalitet/bosättningsområde"@sv ;
    skos:scopeNote "Käytetään määrittämään ryhmän jäsenten kansallisuutta tai maantieteellistä asuinaluetta kuvaavia termejä (esim. keskisuomalaiset, neuvostoliittolaiset, romanialaiset, suomalaiset, yhdysvaltalaiset). Mikäli ryhmän etnisyyttä kuvaava termi ei ole samalla maantieteellinen termi, valitaan kokoavaksi yleistermiksi Etnisyys [eth]. Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä <a href='http://www.yso.fi/onto/yso/p487'>väestöryhmään liittyvä rooli</a>."@fi,
        "Används för att bestämma termer som beskriver nationalitet eller geografiskt bosättningsområde för medlemmar i en grupp (t.ex. invånare i Mellersta Finland, sovjetmedborgare, rumäner, finländare, amerikanska medborgare). Om termen som beskriver gruppens etnicitet inte samtidigt är en geografisk term, väljs Etnicitet [eth] som samlande allmänterm. Vid val av enskilda termer används ALLFO-termer ur gruppen <a href='http://www.yso.fi/onto/yso/p487'>roll relaterad till befolkningsgrupp</a>."@sv .

:m4578 a mts-meta:Hierarchy,
        skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-06-06"^^xsd:date ;
    dct:modified "2024-10-04"^^xsd:date ;
    skos:broader :m176 ;
    skos:inScheme : ;
    skos:prefLabel "Religion"@en,
        "Uskonto"@fi,
        "Religion"@sv ;
    skos:scopeNote "Käytetään määrittämään ryhmän jäsenten uskonnolliseen ryhmään kuulumista kuvaavia termejä (esim. buddhalaiset, katoliset, luterilaiset, sikhit). Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä <a href='http://www.yso.fi/onto/yso/p687'>uskontoon liittyvä rooli</a>."@fi,
        "Används för att bestämma termer som beskriver tillhörighet till en religiös grupp hos medlemmar i en grupp (t.ex. buddhister, katoliker, lutheraner, sikher). Vid val av enskilda termer används ALLFO-termer ur gruppen <a href='http://www.yso.fi/onto/yso/p687'>roll relaterad till religion</a>."@sv .

:m4579 a mts-meta:Hierarchy,
        skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-06-06"^^xsd:date ;
    dct:modified "2024-10-04"^^xsd:date ;
    skos:broader :m176 ;
    skos:inScheme : ;
    skos:prefLabel "Ethnic/cultural"@en,
        "Etnisyys"@fi,
        "Etnicitet"@sv ;
    skos:scopeNote "Käytetään määrittämään ryhmän jäsenten etnistä identiteettiä kuvaavia termejä (esim. baskit, kanadansuomalaiset, romanit, sorbit, suomenruotsalaiset, tuaregit, vironruotsalaiset). Mikäli ryhmän etnisyyttä kuvaava termi on myös maantieteellinen termi, valitaan kokoavaksi yleistermiksi Kansallisuus/asuinalue [nat]. Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä <a href='http://www.yso.fi/onto/yso/p487'>väestöryhmään liittyvä rooli</a>."@fi,
        "Används för att bestämma termer som beskriver etnisk identitet hos medlemmar av en grupp (t.ex. basker, finländare i Kanada, romer, sorber, finlandssvenskar, tuareger, estlandssvenskar). Om termen som beskriver en grupps etnicitet också är en geografisk term, väljs Nationalitet/bosättningsområde [nat] som samlande allmänterm. Vid val av enskilda termer används ALLFO-termer ur gruppen <a href='http://www.yso.fi/onto/yso/p487'>roll relaterad till befolkningsgrupp</a>."@sv .

:m4580 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-06-15"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:altLabel "Predikosamlingar"@sv ;
    skos:broader :m1374 ;
    skos:definition "Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan pitämät saarnat. Jos kokoelmassa ei ole kaikkia puheita. tietoon lisätään termi <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Valikoima</a>."@fi,
        "Grupptitel för en samling som omfattar alla predikningar en aktör har hållit. Om samlingen inte innehåller alla predikningar anges också termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Urval</a>."@sv ;
    skos:example "MARC 21 -formaatissa 240 10 ‡a Saarnat. ‡k Valikoima"@fi,
        "I MARC 21 -formatet 240 10 ‡a Predikningar. ‡k Urval"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Sermons"@en,
        "Saarnat"@fi,
        "Predikningar"@sv .

:m4581 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-08-13"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m1374 ;
    skos:definition "Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat sarjakuvat. Jos kokoelmassa ei ole kaikkia sarjakuvia, tietoon lisätään termi <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Valikoima</a>."@fi,
        "Grupptitel för en samling som innehåller alla tecknade serier som en aktör gjort. Om samlingen inte innehåller alla serier anges också termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Urval</a>."@sv ;
    skos:inScheme : ;
    skos:prefLabel "Sarjakuvat"@fi,
        "Tecknade serier"@sv .

:m4582 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-08-26"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m1374 ;
    skos:definition "Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kertomat sadut. Jos kokoelmassa ei ole kaikkia satuja, tietoon lisätään termi <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Valikoima</a>."@fi,
        "Grupptitel för en samling som innehåller alla sagor som en aktör skrivit. Om samlingen inte omfattar alla sagor anges också termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Urval</a>."@sv ;
    skos:example "MARC 21 -formaatissa 240 10 ‡a Sadut. ‡k Valikoima"@fi,
        "I MARC 21-formatet 240 10 ‡a Sagor. ‡k Urval"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Sadut"@fi,
        "Sagor"@sv .

:m4589 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-11-02"^^xsd:date ;
    dct:modified "2024-11-14"^^xsd:date ;
    skos:broader :m991 ;
    skos:inScheme : ;
    skos:prefLabel "nettiohjelma"@fi,
        "nätprogram"@sv ;
    skos:scopeNote "Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset."@fi,
        "Voidaan käyttää kun ohjelman tai ohjelmasarjan alkuperäinen levityskanava on ollut internet."@fi,
        "Kan användas när den ursprungliga distributionskanalen för ett program eller en programserie är internet."@sv,
        "Verkets form-termer används för att åtskilja verk med samma namn."@sv .

:m4590 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2020-11-02"^^xsd:date ;
    dct:modified "2025-08-21"^^xsd:date ;
    skos:altLabel "säätävä lainkäyttöalue"@fi,
        "verkställande jurisdiktion"@sv ;
    skos:broader :m5607 ;
    skos:definition "Yhteisö, joka on teoksen, joka on laki, asetus, perustuslaki, tuomioistuinta koskeva sääntö tai muu säädös, säätävä hallintoelin. (RDA Registry)"@fi,
        "Institution som är stadgande förvaltningsorgan för ett verk som är en lag, en förordning, en grundlag, en regel som gäller domstol, eller någon annan rättsakt."@sv ;
    skos:exactMatch rdaw:P10017 ;
    skos:inScheme : ;
    skos:prefLabel "enacting government"@en,
        "säätävä hallintoelin"@fi,
        "stadgande förvaltningsorgan"@sv .

:m4593 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-11-21"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "Pro Oeconomia"@fi,
        "Pro Oeconomia"@sv ;
    skos:broader :m580 ;
    skos:definition "Suomen Ekonomien kirjallisuuspalkinto jaetaan noin kahden vuoden välein parhaalle suomalaiselle yrityskirjalle. Vuoteen 2008 asti palkinnon nimi oli Pro Oeconomia."@fi,
        "Finlands Ekonomers litteraturpris utdelas ungefär vartannat år till den bästa finländska företagsboken. Fram till år 2008 var prisets namn Pro Oeconomia."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Suomen Ekonomien kirjallisuuspalkinto, 2008"@fi,
        "I MARC 21-formatet: 586 ## ‡a Finlands Ekonomers litteraturpris, 2008"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Suomen Ekonomien kirjallisuuspalkinto"@fi,
        "Finlands Ekonomers litteraturpris"@sv .

