        "Föremål format som en rulle, på vars yta ljudsignaler skurits eller ristats in i ett enhetligt, cirkulärt spår. T.ex. vaxcylinder."@sv ;
    skos:exactMatch rdact:1003 ;
    skos:inScheme : ;
    skos:prefLabel "audio cylinder"@en,
        "äänisylinteri"@fi,
        "ljudcylinder"@sv ;
    skos:scopeNote "Äänitallenne."@fi,
        "Ljudbärare."@sv .

