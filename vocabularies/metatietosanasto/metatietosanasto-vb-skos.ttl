    skos:broader :m5264 ;
    skos:closeMatch agrelon:hasStepSibling ;
    skos:definition "Kuvailtavan henkilön sisarus, kun vähintään toinen sisaruksista ei ole kummankaan yhteisen vanhemman biologinen lapsi."@fi,
        "Syskon till en beskriven person, då åtminstone ett av syskonen inte är biologiskt barn till någon av de gemensamma föräldrarna."@sv ;
    skos:inScheme : ;
    skos:prefLabel "has stepsibling"@en,
        "ottosisarus"@fi,
        "styvsyskon"@sv .

:m4605 a skos:Concept ;
    dc:source "AgRelOn, an Agent Relationship Ontology",
