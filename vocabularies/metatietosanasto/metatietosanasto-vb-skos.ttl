:m278 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-08-28"^^xsd:date ;
    skos:altLabel "DJ"@en,
        "DJ (toimija)"@fi,
        "DJ-miks. (DJ-miksaaja)"@fi,
        "DJ-miksaaja"@fi,
        "DJ (aktör)"@sv,
        "DJ-mix. (DJ-mixer)"@sv,
        "DJ-mixer"@sv,
        "discjockey"@sv,
        "diskjockey"@sv ;
    skos:broader :m5579 ;
    skos:definition "Toimija, joka osallistuu ekspression tekemiseen miksaamalla ääniraitoja yhteen yhtäjaksoiseksi raidaksi live-esityksessä tai äänitysstudiossa. (RDA Registry)"@fi,
        "Aktör som deltar i utförandet av ett uttryck genom att mixa ljudspår till ett sammanhängande spår under ett liveframträdande eller i en inspelningsstudio."@sv ;
    skos:exactMatch rdae:P20296 ;
    skos:inScheme : ;
    skos:prefLabel "DJ agent"@en,
        "DJ"@fi,
        "DJ"@sv ;
    skos:scopeNote "Ei koske uudelleenmiksauksia, jotka olennaisesti muuttavat alkuperäisen teoksen luonnetta ja sisältöä, mikä johtaa uuteen teokseen, eikä äänitteen useampien raitojen miksaamista ja yhdistelyä. (RDA Registry)"@fi,
        "Gäller inte remixer som väsentligen ändrar det ursprungliga verkets karaktär och innehåll, vilket leder till ett nytt verk, och inte heller mixning och kombinering av flera spår i en ljudinspelning."@sv .

