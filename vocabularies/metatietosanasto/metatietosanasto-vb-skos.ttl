        "pappersmakare"@sv,
        "papperstillverkare (institution)"@sv ;
    skos:broader :m5619 ;
    skos:definition "Yhteisö, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta. (RDA Registry)"@fi,
        "Institution som svarar för tillverkningen av papper som använts i en manifestation."@sv ;
    skos:exactMatch rdam:P30422 ;
    skos:inScheme : ;
    skos:prefLabel "papermaker corporate body"@en,
        "paperinvalmistaja"@fi,
        "papperstillverkare"@sv .

:m5355 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
    skos:altLabel "editor corporate body of text"@en,
        "tekstin toimittaja (yhteisö)"@fi,
        "toimittaja (yhteisö)"@fi,
        "redaktör (institution)"@sv,
        "redaktör (institution) för text"@sv ;
    skos:broader :m5805 ;
    skos:definition "Yhteisö, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi. (RDA Registry)"@fi,
        "Institution som deltar i utförandet av ett uttryck, genom att justera innehåll som skapats av andra aktörer, för att uppfylla utgivnings- och andra bruksstandarder."@sv ;
    skos:exactMatch rdae:P20456 ;
    skos:inScheme : ;
    skos:prefLabel "editor corporate body"@en,
        "toimittaja"@fi,
        "redaktör"@sv ;
    skos:scopeNote "Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti. (RDA Registry)"@fi,
        "Till innehåll hör rörelsenotation, taktil rörelsenotation, taktil musiknotation, taktil text och text."@sv .

:m5356 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-15"^^xsd:date ;
