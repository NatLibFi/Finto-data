    dct:modified "2025-03-04"^^xsd:date ;
    skos:broader :m6023 ;
    skos:inScheme : ;
    skos:prefLabel "kielletty alle 18-vuotiailta"@fi,
        "förbjuden under 18 år"@sv .

:m5351 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
    skos:altLabel "colorist person"@en,
        "värittäjä (henkilö)"@fi,
        "färgläggare (person)"@sv ;
    skos:broader :m5352 ;
    skos:definition "Henkilö, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, liikkuvia kuvia tai muuta sisältöä. (RDA Registry)"@fi,
        "Person som deltar i utförandet av ett uttryck, genom att färglägga ritningar, råkopior, fotografier, kartor, rörliga bilder eller annat innehåll."@sv ;
    skos:exactMatch rdae:P20340 ;
    skos:inScheme : ;
    skos:prefLabel "colourist person"@en,
        "värittäjä"@fi,
        "färgläggare"@sv .

:m5353 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-28"^^xsd:date ;
    skos:altLabel "DJ (yhteisö)"@fi,
        "DJ (institution)"@sv,
        "discjockey"@sv,
        "diskjockey"@sv ;
    skos:broader :m5499 ;
    skos:definition "Yhteisö, joka osallistuu ekspression tekemiseen miksaamalla ääniraitoja yhteen yhtäjaksoiseksi raidaksi live-esityksessä tai äänitysstudiossa. (RDA Registry)"@fi,
        "Institution som deltar i utförandet av ett uttryck genom att mixa ljudspår till ett sammanhängande spår under ett liveframträdande eller i en inspelningsstudio."@sv ;
    skos:exactMatch rdae:P20467 ;
    skos:inScheme : ;
    skos:prefLabel "DJ corporate body"@en,
        "DJ"@fi,
        "DJ"@sv ;
    skos:scopeNote "Ei koske uudelleenmiksauksia, jotka olennaisesti muuttavat alkuperäisen teoksen luonnetta ja sisältöä, mikä johtaa uuteen teokseen, eikä äänitteen useampien raitojen miksaamista ja yhdistelyä. (RDA Registry)"@fi,
        "Gäller inte remixer som väsentligen ändrar det ursprungliga verkets karaktär och innehåll, vilket leder till ett nytt verk, och inte heller mixning och kombinering av flera spår i en ljudinspelning."@sv .

:m5354 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2024-12-18"^^xsd:date ;
    dct:modified "2025-08-16"^^xsd:date ;
