:m4873 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2021-12-04"^^xsd:date ;
    dct:modified "2025-08-23"^^xsd:date ;
    skos:broader :m4872 ;
    skos:definition "Voudin toimialue Ruotsin hallinnossa 1500-luvun alkupuolelta 1630-luvulle, jolloin siirryttiin läänin- ja kihlakuntahallintoon ja voutikunnat lakkasivat olemasta."@fi,
        "Verksamhetsområde för fogde, inom Sveriges administration från början av 1500-talet till 1630-talet. Efter det övergick man till läns- och häradsförvaltning och fögderierna avskaffades."@sv ;
    skos:example "Pohjanmaan eteläinen voutikunta"@fi,
        "Österbottens södra fögderi"@sv ;
    skos:inScheme : ;
    skos:prefLabel "voutikunta"@fi,
        "fögderi"@sv .

