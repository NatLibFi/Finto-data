    skos:altLabel "idrottssällskap"@sv,
        "sportförening"@sv ;
    skos:broader :m196 ;
    skos:closeMatch yso:p2041 ;
    skos:definition "Yhteisö, joka on perustettu jäsentensä yhteisellä sopimuksella urheilun harjoittamiseksi. Urheiluseura voi olla rekisteröity tai rekisteröimätön yhdistys tai yhtiö."@fi,
        "Institution som grundats genom medlemmarnas gemensamma överenskommelse, för att utöva idrott eller sport. Sammanslutningen kan vara en registrerad eller oregistrerad förening eller ett bolag."@sv ;
    skos:inScheme : ;
    skos:prefLabel "urheiluseura"@fi,
        "idrottsförening"@sv .

