:m2128 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2018-04-04"^^xsd:date ;
    dct:modified "2024-04-12"^^xsd:date ;
    skos:broader :m8 ;
    skos:definition "Laajuuden yksikkö on mittakaavassa esitetty poikkileikkaus pystysuorasta pinnasta, joka voi olla tasossa oleva kuvaus maanpinnasta tai liittyä jatkuvasti jakautuvien ilmiöiden kolmiulotteiseen malliin."@fi,
        "Enhet som är en skalenlig framställning av skärningspunkten mellan en vertikal yta och markytan, eller skärningspunkten mellan en sådan vertikal yta och en tredimensionell modell som representerar fenomen med kontinuerlig utbredning."@sv ;
    skos:exactMatch rdacarx:1031 ;
    skos:inScheme : ;
    skos:prefLabel "profile"@en,
        "profiili"@fi,
        "profil"@sv .

