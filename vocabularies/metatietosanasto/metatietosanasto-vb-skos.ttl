    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m169 ;
    skos:definition "Elokuvafilmin esitysformaatti, joka luo kolmiulotteisuuden vaikutelman käyttämällä stereoskooppisia kuvia."@fi,
        "Visningsformat för film, som skapar ett tredimensionellt intryck genom användning av stereoskopiska bilder."@sv ;
    skos:exactMatch rdapf:1010 ;
    skos:inScheme : ;
    skos:prefLabel "stereoscopic"@en,
