        "Institution som deltar i utförandet av ett uttryck genom att fungera som intervjuare, journalist, opinionsmätare eller någon annan aktör som samlar in information."@sv ;
    skos:exactMatch rdae:P20455 ;
    skos:inScheme : ;
    skos:prefLabel "interviewer corporate body of expression"@en,
