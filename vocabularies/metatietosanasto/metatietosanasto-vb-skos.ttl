    skos:altLabel "software developer"@en,
        "ohjelmistokehittäjä (suhde)"@fi,
        "ohjelmistokehittäjä (toimija)"@fi,
        "programutvecklare (aktör)"@sv,
        "programutvecklare (relation)"@sv ;
    skos:broader :m5684 ;
    skos:definition "Toimija, joka osallistuu ekspression tekemiseen tutkimalla, suunnittelemalla, toteuttamalla tai testaamalla ohjelmistoa. (RDA Registry)"@fi,
        "Aktör som deltar i skapandet av ett uttryck, genom att undersöka, planera, förverkliga eller testa en programvara."@sv ;
    skos:exactMatch rdae:P20280 ;
    skos:inScheme : ;
    skos:prefLabel "software developer agent"@en,
        "ohjelmistokehittäjä"@fi,
        "programutvecklare"@sv .

:m3591 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2019-03-02"^^xsd:date ;
    dct:modified "2025-07-05"^^xsd:date ;
    skos:altLabel "on-screen participant"@en,
        "liikkuvaan kuvaan osallistuja (toimija)"@fi,
        "osallistuja"@fi,
        "deltagare"@sv,
        "deltagare (aktör) i rörlig bild"@sv ;
    skos:broader :m5579 ;
    skos:definition "Toimija, joka osallistuu ei-fiktiivisen liikkuvan kuvan teoksen ekspression tekemiseen ottamalla aktiivisen roolin osallistujana. (RDA Registry)"@fi,
        "Aktör som deltar i utförandet av ett uttryck av ett icke-fiktivt verk med rörlig bild, genom att ta en aktiv roll som deltagare."@sv ;
    skos:exactMatch rdae:P20279 ;
    skos:inScheme : ;
    skos:prefLabel "onscreen participant agent"@en,
        "liikkuvaan kuvaan osallistuja"@fi,
        "deltagare i rörlig bild"@sv ;
    skos:scopeNote "Ei koske esiintymistä lisä- tai taustatietojen kertojana. (RDA Registry)"@fi,
        "Gäller inte uppträdande som berättare av tilläggs- eller bakgrundsinformation."@sv .

:m3592 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2019-03-02"^^xsd:date ;
    dct:modified "2025-08-14"^^xsd:date ;
    skos:broader :m1060 ;
    skos:definition "Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen juontamalla (usein lähetettyä) ohjelmaa, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)"@fi,
        "Aktör som är en framförare som deltar i utförandet av ett uttryck, genom att leda ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter i ämnen som relaterar till diskussionen."@sv ;
    skos:exactMatch rdae:P20017 ;
    skos:inScheme : ;
    skos:prefLabel "moderator agent"@en,
        "moderoija"@fi,
        "moderator"@sv .

:m3593 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2019-03-02"^^xsd:date ;
    dct:modified "2025-07-04"^^xsd:date ;
    skos:altLabel "choral conductor"@en,
        "kuoronjohtaja (suhde)"@fi,
        "kuoronjohtaja (toimija)"@fi,
        "kördirigent (aktör)"@sv,
        "kördirigent (relation)"@sv,
        "körledare"@sv ;
    skos:broader :m1577 ;
    skos:definition "Toimija, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla kuoroa musiikki- tai näytelmäesityksessä. (RDA Registry)"@fi,
        "Aktör som är en dirigent som deltar i utförandet av ett uttryck, genom att leda en kör i en musik- eller dramaföreställning."@sv ;
    skos:exactMatch rdae:P20285 ;
    skos:inScheme : ;
    skos:prefLabel "choral conductor agent"@en,
        "kuoronjohtaja"@fi,
        "kördirigent"@sv .

:m3595 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2019-03-02"^^xsd:date ;
    dct:modified "2025-05-27"^^xsd:date ;
    skos:altLabel "dubbing director"@en,
        "dubbausohjaaja (toimija)"@fi,
        "dubbningsregissör (aktör)"@sv ;
    skos:broader :m5579 ;
    skos:definition "Toimija, joka vastaa uuden dialogin tai muiden äänien lisäämisprosessin yleisestä johtamisesta ja valvonnasta ekspression ääniraidan täydentämiseksi. (RDA Registry)"@fi,
        "Aktör som svarar för ledning och övervakning av tillägget av ny dialog eller andra röster för att komplettera ett uttrycks ljudspår."@sv ;
    skos:exactMatch rdae:P20295 ;
    skos:inScheme : ;
    skos:prefLabel "dubbing director agent"@en,
        "dubbausohjaaja"@fi,
        "dubbningsregissör"@sv .

:m3597 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p84 ;
    skos:altLabel "kasvatusala"@fi,
        "opetusala"@fi,
        "utbildningsbranschen"@sv ;
    skos:broader :m3661 ;
    skos:definition "Koulutusta oppilaitoksissa eri koulutusasteilla ja eri ammatteja varten sekä aikuiskoulutusta ja erityisopetusta harjoittavat ja koulutukseen liittyviä palveluja tuottavat toimijat. Pääluokkaan kuuluvat myös toimijat, jotka tarjoavat koulutusta muiden pääluokkien edustamien toimialojen viiteryhmille."@fi,
        "Aktörer som bedriver utbildning vid utbildningsanstalter på olika utbildningsnivåer och för olika yrken, vuxenutbildning och specialundervisning samt producerar utbildningsrelaterade tjänster. Till huvudkategorin hör också aktörer som erbjuder utbildning till referensgrupper inom verksamhetsområden som representeras av andra huvudkategorier."@sv ;
    skos:inScheme : ;
    skos:prefLabel "koulutus"@fi,
        "utbildning"@sv .

:m3598 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p2113,
        yso:p2114 ;
    skos:altLabel "majoitusala"@fi,
        "matkailuala"@fi,
        "ravitsemisala"@fi,
        "siivousala"@fi,
        "förplägnadsbranschen"@sv,
        "inkvarteringsbranschen"@sv,
        "kosthållsbranschen"@sv,
        "städbranschen"@sv,
        "turistbranschen"@sv ;
    skos:broader :m3661 ;
    skos:definition "Lyhytaikaista majoitusta ja välittömästi nautittavaksi valmistettuja aterioita ja anniskeltuja juomia sekä ateriapalveluja tarjoavat toimijat. Pääluokkaan eivät kuulu elintarvikkeiden teollista valmistamista (ks. elintarviketeollisuus) eikä niiden vähittäiskauppaa (ks. kauppa-ala) harjoittavat toimijat."@fi,
        "Aktörer som erbjuder kortvarig inkvartering, måltider som tillagats och drycker som serverats för att förtäras direkt, samt måltidstjänster. Till huvudkategorin hör inte aktörer som bedriver industriell tillverkning av livsmedel (se livsmedelsindustri) eller detaljhandel med livsmedel (se handelsbranschen)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "majoitus- ja ravitsemisala"@fi,
        "inkvarterings- och kosthållsbranschen"@sv .

:m3599 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    skos:altLabel "konepajateollisuus"@fi,
        "metalliteollisuus"@fi,
        "maskinverkstadsindustri"@sv,
        "metalindustri"@sv ;
    skos:broader :m3602 ;
    skos:closeMatch yso:p5363,
        yso:p6643 ;
    skos:inScheme : ;
    skos:prefLabel "metalli- ja konepajateollisuus"@fi,
        "metall- och maskinverkstadsindustri"@sv .

:m3600 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p18932 ;
    skos:altLabel "rakennustoiminta"@fi,
        "rakentaminen"@fi,
        "byggnad"@sv,
        "byggnadsverksamhet"@sv ;
    skos:broader :m3661 ;
    skos:definition "Talonrakennusta, maa- ja vesirakennusta (mm. tiet, rautatiet, vesiväylät, lentokentät, vesi- , viemäri-, tietoliikenne-, kaasu-, lämpö- ja sähköverkostot), ympäristörakentamista, koneiden ja laitteiden rakentamista, LVI- ja sähkö- ja eristystöitä, purkutöitä sekä muita rakentamiseen kiinteästi liittyviä töitä ja rakennussuunnittelua harjoittavat toimijat."@fi,
        "Aktörer som utövar husbyggnad, anläggningsverksamhet (bl.a. vägar, järnvägar, vattenvägar, flygfält, datakommunikationsnät, vatten-, avlopps-, gas-, värme-, och elnätverk), miljötekniskt byggande, maskin- och apparatbyggnad, VVS-, el- och isoleringsarbeten, rivningsarbeten samt andra arbeten som är nära sammanhörande med byggnad och byggnadsplanering."@sv ;
    skos:inScheme : ;
    skos:prefLabel "rakennusala"@fi,
        "byggnadsbranschen"@sv .

:m3601 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p5709,
        yso:p5711 ;
    skos:altLabel "informaatioala"@fi,
        "julkaisutoiminta"@fi,
        "kustannusala"@fi,
        "mainonta"@fi,
        "media-ala"@fi,
        "teleala"@fi,
        "viestintäala"@fi,
        "förlagsbranschen"@sv,
        "informationsbranschen"@sv,
        "mediebranschen"@sv,
        "publikationsbranschen"@sv,
        "reklam"@sv,
        "telebranschen"@sv ;
    skos:broader :m3661 ;
    skos:definition "Kustannustoimintaa, radio- ja televisiotoimintaa, elokuva-, musiikki- ja ohjelmatuotantoa, televiestintää, tiedonvälitystä, mainontaa, tietotekniikka- ja tietojenkäsittelypalveluita harjoittavat toimijat. Pääluokkaan eivät kuulu postitoimintaa (ks. logistiikka-ala), eivätkä painamista, jäljentämistä ja monentamista (ks. graafinen teollisuus) harjoittavat toimijat."@fi,
        "Aktörer som sysslar med förlagsverksamhet, radio- och tv-verksamhet, film-, musik-, och programproduktion, telekommunikation, informationsförmedling, reklam, informationsteknik och databehandling. Till huvudkategorin hör inte postverksamhet (se logistikbranschen) och inte heller aktörer som sysslar med tryckning, kopiering och mångfaldigande (se grafisk industri)."@sv ;
    skos:inScheme : ;
    skos:prefLabel "informaatio- ja viestintäala"@fi,
        "informations- och kommunikationsbranschen"@sv .

:m3603 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    skos:altLabel "social- och hälsoförvaltning"@sv ;
    skos:broader :m3609 ;
    skos:closeMatch yso:p2813 ;
    skos:example "sosiaali- ja terveysministeriö, lääkintöhallitus, lääkelaitos, sosiaalihallitus, piirilääkärit, työsuojelupiirit, ammattientarkastajat"@fi,
        "social- och hälsovårdsministeriet, medicinalstyrelsen, läkemedelsverket, socialstyrelsen, distriktsläkare, arbetarskyddsdistrikt, yrkesinspektörer"@sv ;
    skos:inScheme : ;
    skos:prefLabel "sosiaali- ja terveyshallinto"@fi,
        "social- och hälsovårdsförvaltning"@sv .

:m3604 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    skos:altLabel "jalkineteollisuus"@fi,
