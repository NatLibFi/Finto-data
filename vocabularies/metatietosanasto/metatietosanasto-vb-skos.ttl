        "Layout som består av textrader som varvas med notrader sammanhörande med föregående text."@sv ;
    skos:exactMatch rdalay:1007 ;
    skos:inScheme : ;
    skos:prefLabel "line by line"@en,
        "säkeet peräkkäin"@fi,
        "rad för rad"@sv .

