    skos:broader :m5470 ;
    skos:definition "Aggregaattiin sisältyvään liikkuvan kuvan aineistoon tietoa keräävä yhteisö. Haastattelee, raportoi, tekee kyselytutkimusta tai kerää ihmisiltä tietoa muulla tavoin."@fi,
        "Institution som samlar information till material med rörlig bild som ingår i ett aggregat, genom att intervjua, rapportera, göra gallup eller på annat sätt samla in uppgifter från människor."@sv ;
    skos:inScheme : ;
    skos:prefLabel "haastattelija"@fi,
