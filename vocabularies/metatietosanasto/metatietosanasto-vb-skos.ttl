    skos:exactMatch rdacarx:1014 ;
    skos:example "MARC 21: 300## ‡a 1 peli (useita osia kotelossa) ‡c 13 x 18 x 4 cm + ‡e 2 taitelehteä (16 x 12 cm)"@fi,
        "MARC 21: 300## ‡a 9 peliä (useita osia) + ‡e Opettajan info (23 sivua : kuvitettu)"@fi,
