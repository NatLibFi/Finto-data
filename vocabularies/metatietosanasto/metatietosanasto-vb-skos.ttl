        "Nationell RDA-term"@sv ;
    dct:created "2018-03-30"^^xsd:date ;
    dct:modified "2024-05-24"^^xsd:date ;
    skos:broader :m1374 ;
    skos:definition "Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat libretot. Jos kokoelmassa ei ole kaikkia librettoja, tietoon lisätään termi <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Valikoima</a>."@fi,
        "Grupptitel för en samling som innefattar alla libretton som skrivits av samma aktör. Om samlingen inte innehåller alla libretton anges också termen <a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'>Urval</a>."@sv ;
    skos:inScheme : ;
    skos:prefLabel "Libretot"@fi,
        "Libretton"@sv .

:m2108 a skos:Concept ;
