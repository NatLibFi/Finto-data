    skos:definition "Toimija, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta. (RDA Registry)"@fi,
        "Aktör som är en arkitekt och svarar för skapandet av landskapsverk."@sv ;
    skos:exactMatch rdaw:P10200 ;
    skos:inScheme : ;
    skos:prefLabel "landscape architect agent"@en,
