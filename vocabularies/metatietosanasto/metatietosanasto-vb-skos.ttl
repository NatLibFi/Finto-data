    dct:created "2020-04-30"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m4396 ;
    skos:definition "Aineisto koostuu useammasta eri mittakaavassa olevasta kuvasta, kartasta jne."@fi,
