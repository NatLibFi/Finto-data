    skos:broader :m196 ;
    skos:closeMatch yso:p6946 ;
    skos:definition "Valtionhallinnon pysyvä toimielin, jolle on säädöksillä annettu toimivalta ja velvollisuus tiettyjen tehtävien hoitamiseen omalla toimialallaan: virasto tai laitos, tai yksittäinen virkamies kuten tasa-arvovaltuutettu (Wikipedia)."@fi,
        "Bestående organ för statsförvaltning, som genom författningar ålagts att sköta vissa uppgifter på sitt förvaltningsområde."@sv ;
    skos:inScheme : ;
    skos:narrower :m4779 ;
    skos:prefLabel "viranomainen"@fi,
        "myndighet"@sv ;
    skos:scopeNote "Kunnallisista viranomaisista käytä termiä: <a href='http://urn.fi/URN:NBN:fi:au:mts:m604'>kunta</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m4703'>kuntayhtymä</a> tai <a href='http://urn.fi/URN:NBN:fi:au:mts:m358'>kaupunki</a>."@fi,
        "Om kommunala myndigheter används termen: <a href='http://urn.fi/URN:NBN:fi:au:mts:m604'>kommun</a>, <a href='http://urn.fi/URN:NBN:fi:au:mts:m4703'>samkommun</a> eller <a href='http://urn.fi/URN:NBN:fi:au:mts:m358'>stad</a>."@sv .

:m4728 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
