    skos:definition "Useissa maissa aluehallinnon yksikkö tai sen toimialue, jota suomen kielessä yleisesti kutsutaan piirikunnaksi."@fi,
        "I flera engelskspråkiga länder regional förvaltningsenhet."@sv ;
    skos:example "DeKalbin piirikunta (Yhdysvallat)"@fi,
        "DeKalb county (Förenta staterna)"@sv ;
    skos:inScheme : ;
