    dct:modified "2024-04-13"^^xsd:date ;
    rdfs:seeAlso rdam:P30122 ;
    skos:altLabel "Mikrofilm- och mikrokortemulsion"@sv ;
    skos:broader :m138 ;
    skos:definition "Mikrofilmin tai mikrokortin valoherkkiä kemikaaleja sisältävä pinnoite."@fi,
        "Ytbeläggning som innehåller ljuskänsliga kemikalier på mikrofilm eller mikrofiche."@sv ;
    skos:inScheme : ;
    skos:prefLabel "Emulsion on microfilm and microfiche"@en,
        "Mikrofilmin ja mikrokortin emulsio"@fi,
        "Emulsion på mikrofilm och mikrofiche"@sv ;
    skos:scopeNote "Kuvailussa käytetään käsiteryhmässä <a href='http://urn.fi/URN:NBN:fi:au:mts:m654'>Materiaali</a> olevia käsitteitä."@fi,
        "Vid beskrivning används begrepp ur begreppsgruppen <a href='http://urn.fi/URN:NBN:fi:au:mts:m654'>Material</a>."@sv .

:m422 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2024-03-13"^^xsd:date ;
    skos:broader :m654 ;
    skos:definition """Emulsio, joka koostuu yhdestä tai useammasta valoherkästä diazonium-suolakerroksesta polyesteri- tai asetaattipohjalla ja josta saadaan dye-coupling-menetelmällä atsovärikuva.
Materiaali, jota tavallisesti käytetään mikrofilmin tai mikrokortin pohjamateriaalina."""@fi,
        "Emulsion som består av en eller flera lager av ljuskänsligt diazoniumsalt på polyester- eller acetatbotten och från vilket man får azofärgbild med dye-coupling-metoden. Material som vanligtvis används som bottenmaterial för mikrofilm eller mikrofiche."@sv ;
    skos:exactMatch rdamat:1046 ;
    skos:inScheme : ;
    skos:prefLabel "diazo emulsion"@en,
        "diatso"@fi,
        "diazo"@sv .

