:m3602 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2019-03-13"^^xsd:date ;
    dct:modified "2026-05-06"^^xsd:date ;
    rdfs:seeAlso yso:p998 ;
    skos:broader :m3661 ;
    skos:definition "Alkutuotannosta saatuja materiaaleja ja komponentteja uusiksi tuotteiksi mekaanisesti, kemiallisesti tai biologisesti muuntamalla valmistavat toimijat. Pääluokka jakaantuu alaluokkiin teollisuuden alan mukaan. Pääluokkaan liitetään ne teollisuuden toimijat, joita ei päätoimialansa mukaan voida liittää mihinkään teollisuuden alaluokista, esim. monialaisen teollisen toiminnan harjoittajat."@fi,
        "Aktörer som producerar nya produkter av material och komponenter som erhållits ur primärproduktion, genom att mekaniskt, kemiskt eller biologiskt omvandla dem. Huvudkategorin indelas i underavdelningar enligt industrigren. I huvudkategorin placeras de industriella aktörer som enligt sitt huvudsakliga verksamhetsområde inte kan placeras i någon av underavdelningarna för industri, t.ex. sådana som utövar branschövergripande industriverksamhet."@sv ;
    skos:inScheme : ;
    skos:narrower :m3599,
        :m3604,
        :m3620,
        :m3624,
        :m3625,
        :m3627,
        :m3631,
        :m3636,
        :m3663 ;
    skos:prefLabel "teollisuus"@fi,
        "industri"@sv .

