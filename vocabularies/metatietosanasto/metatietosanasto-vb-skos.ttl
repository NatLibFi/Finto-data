:m4128 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-01-09"^^xsd:date ;
    dct:modified "2024-07-02"^^xsd:date ;
    skos:altLabel "Jarl Hellemann -käännöskirjapalkinto"@fi,
        "Jarl Hellemanns översättningspris"@sv ;
    skos:broader :m580 ;
    skos:definition "Jarl Hellemann -käännöskirjapalkinto on Tammen perustama kirjallisuuspalkinto, joka jaetaan vuosittain korkeatasoisen kaunokirjallisen teoksen laadukkaasta suomennoksesta. Palkinto on nimetty Tammen aiemman toimitusjohtajan ja Keltaisen kirjaston perustajan Jarl Hellemannin mukaan. Palkinto jaettiin ensimmäisen kerran 2015."@fi,
        "Litteraturpris som grundats av förlaget Tammi och som utdelas årligen till en kvalitativ finskspråkig översättning av ett högklassigt skönlitterärt verk. Priset är namngivet efter den tidigare direktören och grundaren av Keltainen kirjasto - Jarl Hellemann. Priset utdelades första gången 2015."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Jarl Hellemann -palkinto, 2015"@fi,
        "I MARC 21-formatet: 586 ## ‡a Jarl Hellemann-priset, 2015"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Jarl Hellemann -palkinto"@fi,
        "Jarl Hellemann-priset"@sv .

:m4129 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2020-01-11"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:altLabel "Vuoden luontokirja -palkinto"@fi,
        "Årets naturbok-priset"@sv ;
    skos:broader :m580 ;
    skos:definition "WWF Suomen vuosittain valitsema teos, joka sopii suurelle yleisölle, edistää luonnonsuojelun viestiä ja on korkealaatuinen. Palkinto myönnettiin ensimmäisen kerran 1978."@fi,
        "Verk utvalt årligen av WWF Finland som passar för en bred publik och främjar budskapet om naturskydd, samt är högklassigt. Priset utdelades första gången 1978."@sv ;
    skos:example "MARC 21 -formaatissa: 586 ## ‡a Vuoden luontokirja, 2020"@fi,
        "I MARC 21-formatet: 586 ## ‡a Årets naturbok, 2020"@sv ;
    skos:inScheme : ;
    skos:prefLabel "Vuoden luontokirja"@fi,
        "Årets naturbok"@sv .

