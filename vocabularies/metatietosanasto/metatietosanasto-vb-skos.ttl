    skos:broader :m417 ;
    skos:definition "Käytetään mistä tahansa käsikirjoitusaineistosta, jota vastuullisuustekijä ei ole itse kirjoittanut."@fi,
        "Används om vilket som helst manuskriptmaterial som den ansvariga upphovsmannen inte själv har skrivit."@sv ;
    skos:inScheme : ;
    skos:prefLabel "manuscript"@en,
        "käsikirjoitus"@fi,
        "manuskript"@sv .

:m1606 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2023-05-17"^^xsd:date ;
    skos:broader :m58 ;
    skos:definition "Layout, joka koostuu sointumerkeistä ja melodiasta kappaleisiin jaettuina, ja jossa sointumerkit on merkitty pistekirjoituksella."@fi,
        "Layout som består av ackordsymboler och melodi indelad i stycken, och i vilken ackordsymbolerna anges med punktskrift."@sv ;
    skos:exactMatch rdalay:1009 ;
    skos:inScheme : ;
    skos:prefLabel "melody chord system"@en,
        "melody chord system"@fi,
        "melody chord system"@sv .

