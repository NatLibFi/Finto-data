:m1740 a skos:Concept ;
    dc:source "Kansallinen RDA-termi"@fi,
        "Nationell RDA-term"@sv ;
    dct:created "2016-11-03"^^xsd:date ;
    dct:modified "2025-04-10"^^xsd:date ;
    skos:altLabel "författare till sångtext (uttryck)"@sv ;
    skos:broader :m5302 ;
    skos:definition "Liittää ekspression henkilöön, joka osallistuu musiikkiteoksen ekspression tekemiseen kirjoittamalla sanoituksen teokseen, johon ei aikaisemmin sisältynyt tekstiä tai kirjoittamalla uuden sanoituksen korvaamaan teoksen aikaisemman tekstin tai täydentämään olemassa olevaa tekstiä. Sanoituksesta, joka on tehty yhteistyössä säveltäjän kanssa alkuperäiseen teokseen, katso <a href='http://urn.fi/URN:NBN:fi:au:mts:m384'>sanoittaja</a>."@fi,
        "Sammankopplar uttryck med en person som deltar i utförandet av ett musikverks uttryck genom att skriva sångtext till ett verk, i vilket tidigare inte ingått text, eller genom att skriva en ny sångtext som ersätter ett verks tidigare text, eller som kompletterar redan existerande text. För sångtext som har skapats för det originala verket i samarbete med kompositören, se <a href='http://urn.fi/URN:NBN:fi:au:mts:m384'>sångtextförfattare</a>."@sv ;
    skos:inScheme : ;
    skos:prefLabel "sanoittaja (ekspressio)"@fi,
        "sångtextförfattare (uttryck)"@sv .

