    skos:broader :m5266 ;
    skos:definition "Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen kertomalla tarinan draamallisella tai teatraalisella tulkinnalla. (RDA Registry)"@fi,
        "Institution som är en framförare, som deltar i utförandet av ett uttryck genom att framföra en berättelse med en dramatisk eller teatralisk tolkning."@sv ;
    skos:exactMatch rdae:P20497 ;
    skos:inScheme : ;
    skos:prefLabel "storyteller corporate body"@en,
        "tarinankertoja"@fi,
        "historieberättare"@sv .

