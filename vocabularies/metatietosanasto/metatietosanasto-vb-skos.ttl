    skos:broader :m196 ;
    skos:closeMatch yso:p13271,
        yso:p4084 ;
    skos:definition "Valtiollinen organisaatio, jonka tehtävänä on huolehtia valtio- ja yhteiskuntajärjestyksen sekä yleisen järjestyksen ja turvallisuuden säilymisestä (Arkistojen portti)."@fi,
