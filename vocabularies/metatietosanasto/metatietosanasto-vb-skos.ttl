    dct:created "2016-01-08"^^xsd:date ;
    dct:modified "2025-10-04"^^xsd:date ;
    skos:broader :m291 ;
    skos:inScheme : ;
    skos:prefLabel "yksi-kaksi kertaa vuodessa"@fi,
        "en-två gånger per år"@sv .

:m163 a skos:Concept ;
    dc:source "RDA-termi"@fi,
        "RDA-term"@sv ;
    dct:created "2016-01-08"^^xsd:date ;
