    <skos:definition xml:lang="fi">Henkilö, joka säveltää uutta musiikkia täydentämään olemassa olevaa musiikkia.</skos:definition>
    <skos:definition xml:lang="sv">Person som komponerar ny musik för att komplettera redan befintlig musik.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kompletterare av komposition</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sävellyksen täydentäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6067">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5350"/>
    <skos:definition xml:lang="sv">Institution som komponerar ny musik för att komplettera redan befintlig musik.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka säveltää uutta musiikkia täydentämään olemassa olevaa musiikkia.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kompletterare av komposition</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sävellyksen täydentäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6068">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
