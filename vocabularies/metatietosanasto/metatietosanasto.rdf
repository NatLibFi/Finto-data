    <skos:definition xml:lang="fi">Teos, joka on oratorio, joka perustuu toiseen teokseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett oratorium, som grundar sig på ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10289"/>
