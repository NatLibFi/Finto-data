    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5410"/>
    <skos:prefLabel xml:lang="sv">Exemplars relationer till uttryck</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kappaleen suhteet ekspressioon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6007">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fotograf (person) till verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen valokuvaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa valokuvateoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett fotografiskt verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10445"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fotograf till verk</skos:prefLabel>
    <skos:prefLabel xml:lang="en">photographer person of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen valokuvaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6008">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dedikationsförfattare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">omistuksen tekijä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som dedicerar ett verk till erkännande för en relaterad aktörs inspiration eller stöd.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka nimittää teoksen tunnustukseksi siihen liittyvän toimijan innoituksesta tai tuesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10508"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dedicator corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen omistuksen tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verkets dedikationsförfattare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6009">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5098"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen yhteisö, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Institution som bidragit till ett aggregat och skapat ett uttryck av ett talverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30400"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (institution) till tal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor corporate body of speech</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puheeseen osallinen yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6010">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">färgläggare (institution) som är bidragsgivare till stillbild</skos:altLabel>
    <skos:altLabel xml:lang="fi">stillkuvaan osallinen värittäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6016"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän stillkuvan värityksen yhteisötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsinstitution till färgläggning av stillbild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">färgläggare av stillbild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">stillkuvan värittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6011">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">piirtäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ritare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck skapat av en arkitekt, designer eller annan dylik aktör, genom att skapa precisa planer eller ritningar av byggnader, fartyg, flygplan, apparater, föremål eller andra kreationer.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20339"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">draftsman person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piirtäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ritare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6012">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen käsikirjoittaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">manusförfattare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän käsikirjoituksen tai kohtauksen kirjoittanut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som skrivit ett manus eller en scen som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">käsikirjoittaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">manusförfattare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6013">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">intervjuobjekt (institution) som är bidragsgivare till text i verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen teoksen haastateltava (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä tietoja keräävälle haastattelijalle (tavallisesti toimittaja tai mielipidemittauksen tekijä) vastauksia antava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som ger svar åt en intervjuare (vanligen en journalist eller opinionsmätare), som samlar information som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastateltava</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuobjekt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6014">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">konstnär (person) som är bidragsgivare till stillbild</skos:altLabel>
    <skos:altLabel xml:lang="fi">stillkuvaan osallinen taiteilija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5648"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. henkilötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsperson till en ursprunglig grafisk design, teckning, målning eller dylikt, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">konstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taiteilija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6015">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som ingår i texten "X presenterar:" i för- och eftertexter i en manifestation som innehåller ett uttryck, och som troligtvis på något vis relaterar till produktion, finansiering eller distribution av ett uttryck för rörlig bild.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka sisältyy merkintään "X esittää:" ekspression sisältävän manifestaation alku- tai lopputeksteissä ja joka liittyy todennäköisesti liikkuvan kuvan teoksen ekspression tuotantoon, rahoitukseen tai jakeluun jollakin tavoin. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20506"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ansvarig institution för framförande</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">esittämisestä vastaava yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="en">presenter corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6016">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5098"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen yhteisö, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Institution som bidragit till ett aggregat och skapat ett uttryck av ett stillbildsverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30401"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
