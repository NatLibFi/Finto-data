    <skos:prefLabel xml:lang="sv">finansförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">finanssihallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4949">
