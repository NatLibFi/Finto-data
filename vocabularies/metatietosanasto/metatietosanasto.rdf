  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5335">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen lavastaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">scenograf (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän elokuvan tuotannon lavasteiden rakentajia valvova henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som övervakar byggare av kulisser i en filmproduktion som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">lavastaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">scenograf</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5336">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Henkilö, joka liittyy yhteisöön. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som relaterar till en institution.</skos:definition>
