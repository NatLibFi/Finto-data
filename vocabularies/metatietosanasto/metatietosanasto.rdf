    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m190"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m241"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m619"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m643"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m711"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m89"/>
    <skos:prefLabel xml:lang="fi">Esitysformaatti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Filmprojektionssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Presentation format</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1691">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista stereografisista tallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd typ av stereografisk bärare passar in på det material som beskrivs, anges termen annan stereografisk bärare.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan stereografisk bärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu stereografinen tallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod ez.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi ez.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1693">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista mikromuotoisista tallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd mikroformsbärartyp passar in på det material som beskrivs, anges annan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan mikroformsbärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu mikromuotoinen tallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod hz.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi hz.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1694">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista äänitallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd ljudbärartyp passar in på det material som beskrivs, anges annan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan ljudbärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu äänitallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod sz.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi sz.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1695">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista ilman laitetta käytettävistä tallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd typ av omedierad bärare passar in på det material som beskrivs, anges annan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan omedierad bärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu ilman laitetta käytettävä tallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod nz.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi nz.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1697">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista videotallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd videobärartyp lämpar sig för att beskriva materialets innehåll anges annan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan videobärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu videotallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod vz.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi vz.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1699">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista tietokonetallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd datorbärartyp passar in på det material som beskrivs, anges termen annan datorbärare.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan datorbärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu tietokonetallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod cz.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi cz.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m17">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">röstskådespelare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">voice actor</skos:altLabel>
    <skos:altLabel xml:lang="fi">ääninäyttelijä (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1241"/>
    <skos:definition xml:lang="sv">Aktör som är en skådespelare, som deltar i utförandet av ett uttryck, genom att ge röst åt karaktärer i radio- och ljudproduktioner och animerade karaktärer i filmverk, samt genom att framträda i radio- och tv-reklarm, i dubbade uttryck etc.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on näyttelijä, joka osallistuu ekspression tekemiseen antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20070"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">röstskådespelare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">voice actor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääninäyttelijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m170">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen nauhan Betacam-formaattiin perustuva videoformaatti, joka nostaa horisontaalisen resoluution 340:een raitaan.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för analogt band, som grundar sig på Betacam-format och som höjer den horisontella upplösningen till 340 spår.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/videoFormat/1016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Betacam SP</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Betacam SP</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Betacam SP</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1703">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista mikroskooppisista tallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd typ av mikroskopisk bärare passar in på det material som beskrivs, anges annan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan mikroskopisk bärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu mikroskooppinen tallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod pz.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi pz.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1704">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Silmukanmuotoinen joustava muovi- tai magneettikalvo, jolle äänisignaaleja tallennetaan mekaanisesti. Tunnetaan yleisesti tuotenimellä Dictabelt.</skos:definition>
    <skos:definition xml:lang="sv">Slinga av elastisk plast- eller magnetfilm, på vilken ljudsignaler upptas mekaniskt. Går vanligvis under produktnamnet Dictabelt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1070"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio belt</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudslinga</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänihihna</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1708">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jos mikään sanastossa olevista heijastettavista kuvatallennetyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään muu.</skos:definition>
    <skos:definition xml:lang="sv">Om ingen tidigare nämnd typ av bärare för projicerbara bilder passar in på det material som beskrivs, anges annan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">annan bärare för projicerbara bilder</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu heijastettava kuvatallenne</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">MARC 21 bärartypens kod mz.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">MARC 21 tallennetyypin koodi mz.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m171">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">skapare (aktör) av visuella effekter</skos:altLabel>
    <skos:altLabel xml:lang="fi">visuaalisten tehosteiden tekijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">visual effects provider</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck av ett verk med rörlig bild, genom att planera och skapa visuella effekter i postproduktionsfasen.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu liikkuvan kuvan teoksen ekspression tekemiseen suunnittelemalla ja luomalla visuaaliset tehosteet jälkituotantovaiheessa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20257"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">skapare av visuella effekter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">visuaalisten tehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">visual effects provider agent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1710">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kelalla tai rullalla oleva teräksinen tai ruostumatonta terästä oleva lanka, jolle äänisignaaleja tallennetaan magneettisesti.</skos:definition>
    <skos:definition xml:lang="sv">Tråd på rulle eller spole, gjord av stål eller rostfritt stål och på vilken ljudsignaler upptas magnetiskt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1071"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio wire reel</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudtråd</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänilankakela</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1711">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som består av stillbild.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka koostuu stillkuvasta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1014"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">illustration</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">illustration</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1712">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fiktiv karaktär</skos:altLabel>
    <skos:altLabel xml:lang="sv">sagofigur</skos:altLabel>
    <skos:altLabel xml:lang="sv">sagogestalt</skos:altLabel>
    <skos:altLabel xml:lang="fi">satuhahmo</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">fiktiivinen hahmo</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fiktiv gestalt</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei ole RDA:n mukainen toimija.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Är inte en aktör i enlighet med RDA.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1713">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">make-up artist</skos:altLabel>
    <skos:altLabel xml:lang="sv">makeupartist</skos:altLabel>
    <skos:altLabel xml:lang="sv">makeupartist (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">maskeeraaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">maskör (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">meikkitaiteilija</skos:altLabel>
    <skos:altLabel xml:lang="fi">meikkitaiteilija (suhde)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att svara för maskering i en film, en musikal eller ett sceniskt verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen vastaamalla elokuvan, musikaalin tai näyttämöteoksen maskeerauksesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20284"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">makeup artist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maskeeraaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">maskör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1714">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aineiston sisältöön liittyvä värillisyys, joka koostuu yhden värin sävyistä, tai mustasta ja valkoisesta, tai mustasta tai valkoisesta ja muusta väristä.</skos:definition>
    <skos:definition xml:lang="sv">Kulörthet i samband med ett materials innehåll, som kan vara enfärgat, svart och vitt eller någon annan färg.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAColourContent/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">enfärgad</skos:prefLabel>
    <skos:prefLabel xml:lang="en">monochrome</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yksivärinen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1715">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">flera färger</skos:altLabel>
    <skos:altLabel xml:lang="sv">flerfärgad</skos:altLabel>
    <skos:definition xml:lang="fi">Aineiston sisältöön liittyvä värillisyys, joka koostuu kahdesta väristä, joista kumpikaan ei ole musta tai valkoinen, tai useammasta kuin kahdesta väristä.</skos:definition>
    <skos:definition xml:lang="sv">Färginnehåll samhörande med ett materials innehåll, som består av två färger, av vilka ingendera är svart eller vit, eller av fler än två färger.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAColourContent/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">monivärinen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">polychrome</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">polykrom</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m173">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kasetti, joka sisältää videonauhan.</skos:definition>
    <skos:definition xml:lang="sv">Kassett som innehåller videoband.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1052"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">videocassette</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">videokasetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">videokassett</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Videobärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Videotallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1730">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förbjuden under 12 år</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kielletty alle 12-vuotiailta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1735">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="sv">Annan</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Muu</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Unspecified</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver annan social inbördes likhet hos medlemmar av en grupp (t.ex. skilsmässobarn, socialister, krigsänkor, utbytesstuderande, fångar).</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten muuta sosiaalista keskinäistä samankaltaisuutta kuvaavia termejä (esim. erolapset, sosialistit, sotalesket, vaihto-opiskelijat, vangit).</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1740">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare till sångtext (uttryck)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Liittää ekspression henkilöön, joka osallistuu musiikkiteoksen ekspression tekemiseen kirjoittamalla sanoituksen teokseen, johon ei aikaisemmin sisältynyt tekstiä tai kirjoittamalla uuden sanoituksen korvaamaan teoksen aikaisemman tekstin tai täydentämään olemassa olevaa tekstiä. Sanoituksesta, joka on tehty yhteistyössä säveltäjän kanssa alkuperäiseen teokseen, katso &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m384'&gt;sanoittaja&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar uttryck med en person som deltar i utförandet av ett musikverks uttryck genom att skriva sångtext till ett verk, i vilket tidigare inte ingått text, eller genom att skriva en ny sångtext som ersätter ett verks tidigare text, eller som kompletterar redan existerande text. För sångtext som har skapats för det originala verket i samarbete med kompositören, se &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m384'&gt;sångtextförfattare&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sanoittaja (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångtextförfattare (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1741">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">engraver</skos:altLabel>
    <skos:altLabel xml:lang="sv">gravör (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">gravör (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaivert. (kaivertaja)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaivertaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaivertaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1747"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkningen av en manifestation, genom att gravera bokstäver, mönster eller andra tecken på en yta som används vid tryck, såsom en trä- eller metallyta.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30070"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">engraver agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gravör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaivertaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1742">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
