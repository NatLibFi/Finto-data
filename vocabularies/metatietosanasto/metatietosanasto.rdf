    <skos:definition xml:lang="sv">En trafikchef ansvarar för att trafiken löper på en viss plats, t.ex. i en hamn.</skos:definition>
    <skos:definition xml:lang="fi">Liikennepäällikkö vastaa liikenteen sujuvuudesta tietyssä paikassa (esimerkiksi satamassa).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikennepäällikkö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">trafikchef</skos:prefLabel>
  </owl:Class>
