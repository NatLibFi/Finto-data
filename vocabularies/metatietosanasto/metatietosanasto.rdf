  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2076">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av flöjt, oboe, klarinett, valthorn och fagott.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: huilu, oboe, klarinetti, käyrätorvi, fagotti.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blåskvintett</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puhallinkvintetti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2077">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av 2 violiner, viola och violoncell.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: 2 viulua, alttoviulu, sello.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jousikvartetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stråkkvartett</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2078">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
