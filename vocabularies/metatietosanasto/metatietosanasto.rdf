    <skos:prefLabel xml:lang="sv">designer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">designer corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5995">
