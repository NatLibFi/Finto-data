    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasAuntUncle"/>
    <skos:definition xml:lang="sv">En beskriven persons faster, moster, farbror eller morbror.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön täti, setä tai eno.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förälders syskon</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has aunt or uncle</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vanhemman sisarus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4639">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
