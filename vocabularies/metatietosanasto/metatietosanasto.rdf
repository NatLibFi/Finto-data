  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5841">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">gjutare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5486"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation valmistamisesta muovaamalla sulatettua tai nestemäistä ainetta muotin avulla. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av en manifestation, genom att forma smält eller flytande ämne med hjälp av en form.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30353"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">caster person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gjutare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5842">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">försäljare</skos:altLabel>
    <skos:altLabel xml:lang="fi">myyjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">säljare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5990"/>
    <skos:definition xml:lang="fi">Kappaleen aiempi henkilöomistaja, joka myy kappaleen toiselle omistajalle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Tidigare personägare till ett exemplar, som säljer ett exemplar till en annan ägare.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40109"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">myyjä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">seller person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">säljare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5843">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5515"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5507"/>
    <skos:definition xml:lang="fi">Teos, joka on kappaleen metatietoteos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett metadataverk för ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40164"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">item described with metadata by</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaletta metatiedoilla kuvaileva teos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verk som beskriver exemplaret med metadata</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5844">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelningstekniker (institution) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljudtekniker för musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen äänittäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän äänityksen teknistä toteutusta valvova yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som övervakar det tekniska förverkligandet av en ljudinspelning som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelningstekniker för musik</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikin äänittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5845">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">protokollförare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">pöytäkirjan laatija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka vastaa kokouksen pöytäkirjan laatimisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för sammanställandet av ett protokoll för ett möte.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20392"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">minute taker person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">protokollförare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pöytäkirjan laatija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5846">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arkitekt (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">arkkitehti (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som ansvarar för skapandet av en arkitektplan, inklusive en bildpresentation över hur en byggnad eller en annan konstruktion ska se ut när den är färdig.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10532"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">architect corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">arkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">arkkitehti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5847">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">radioproducent (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">radiotuottaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5326"/>
    <skos:definition xml:lang="sv">Institution som är en producent, som svarar för största delen av affärsverksamheten kring ett radioprogram.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10517"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">radio producer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">radioproducent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">radiotuottaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5848">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">musiikillinen johtaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikalisk ledare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att koordinera kompositörers, ljudklippares och ljudmixares verksamhet i en filmproduktion eller i ett musikaliskt eller sceniskt uppförande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20342"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">musical director person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikillinen johtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikalisk ledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5849">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">aggregaattori (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">aggregerad av (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett aggregerande verk, genom att välja och ordna uttryck av andra verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10448"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">aggregator person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aggregerad av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">koostaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5850">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">käsikirjoittaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">manusförfattare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5497"/>
    <skos:definition xml:lang="sv">Institution som skrivit ett manus eller en scen.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on käsikirjoituksen tai kohtauksen kirjoittaja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10523"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">käsikirjoittaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">manusförfattare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">screenwriter corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5851">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">librettist (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen libretisti (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin liittyvän musiikin tai koreografian, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanat kirjoittanut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som skrivit texten till ett musikaliskt eller koreografiskt verk, såsom en opera, en balett eller något annat musikaliskt sceniskt verk eller oratorium, som relaterar till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">libretisti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">librettist</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5852">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tekstiin osallinen kääntäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">översättare (person) som är bidragsgivare till text</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5814"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää tekstiä alkuperäisestä sisällöstä poikkeavaan kieleen kääntänyt henkilö. Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä.</skos:definition>
    <skos:definition xml:lang="sv">Person som översatt en text som ingår i ett aggregat, till ett språk som avviker från det ursprungliga innehållet. En översättare kan också översätta språkligt innehåll mellan olika former av samma språk från olika tidsperioder.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kääntäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">översättare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5853">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">digitaaliseen sisältöön osallinen ohjelmoija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programmerare (person) som är bidragsgivare till digitalt innehåll</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5894"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän digitaalisen sisällön henkilötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsperson till digitalt innehåll som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ohjelmoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programmerare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5854">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kapellimestari (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kapellmästare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5543"/>
    <skos:definition xml:lang="fi">Henkilö, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla soitinryhmää musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en dirigent som deltar i utförandet av ett uttryck, genom att leda en instrumentgrupp i en musik- eller dramaföreställning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20368"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">instrumental conductor person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kapellimestari</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kapellmästare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5855">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">instrumentalist (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">soittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare, som deltar i utförandet av ett uttryck genom att spela ett instrument.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20376"/>
