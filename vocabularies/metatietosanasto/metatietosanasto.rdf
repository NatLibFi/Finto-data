    <skos:altLabel xml:lang="sv">arbetscentral</skos:altLabel>
    <skos:altLabel xml:lang="fi">työkeskus</skos:altLabel>
    <skos:altLabel xml:lang="sv">verksamhetscentral</skos:altLabel>
