  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4036">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Specialist med universitetsexamen som ansvarar för ett museums guide- och övrig verksamhet samt samarbete med läroanstalter.</skos:definition>
    <skos:definition xml:lang="fi">Yliopistotutkinnon suorittanut asiantuntija, joka vastaa museon opastus- ja oheistoiminnasta sekä yhteistyöstä oppilaitosten kanssa (Lähde: Kielitoimiston sanakirja).</skos:definition>
