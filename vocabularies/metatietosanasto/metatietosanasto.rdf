    <skos:altLabel xml:lang="sv">sonson</skos:altLabel>
    <skos:altLabel xml:lang="fi">tyttärenpoika</skos:altLabel>
    <skos:altLabel xml:lang="fi">tyttärentytär</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasGrandChild"/>
    <skos:definition xml:lang="sv">Barnbarn till en beskriven person.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön lapsen lapsi.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">barnbarn</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has grandchild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lapsenlapsi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4645">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasFosterSibling"/>
    <skos:definition xml:lang="sv">En beskriven persons syskon, då åtminstone ett av syskonen är fosterbarn till en gemensam förälder.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön sisarus, kun vähintään toinen sisaruksista on yhteisen vanhemman kasvattilapsi.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fostersyskon</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has foster sibling</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kasvattisisarus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4646">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4627"/>
    <skos:altLabel xml:lang="sv">adopterat barn</skos:altLabel>
    <skos:altLabel xml:lang="fi">ottolapsi</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasAdoptiveChild"/>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön adoptoima henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som adopterats av en beskriven person.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">adoptiolapsi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">adoptivbarn</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has adoptive child</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4647">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">amma</skos:altLabel>
    <skos:altLabel xml:lang="sv">amma</skos:altLabel>
    <skos:altLabel xml:lang="sv">andlig fader</skos:altLabel>
    <skos:altLabel xml:lang="sv">andlig moder</skos:altLabel>
    <skos:altLabel xml:lang="fi">guru</skos:altLabel>
    <skos:altLabel xml:lang="sv">guru</skos:altLabel>
    <skos:altLabel xml:lang="fi">hengellinen isä</skos:altLabel>
    <skos:altLabel xml:lang="fi">hengellinen vanhempi</skos:altLabel>
    <skos:altLabel xml:lang="fi">hengellinen äiti</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasSpiritualContact"/>
    <skos:definition xml:lang="fi">Henkilö tai hengellinen entiteetti, johon kuvailtavalla henkilöllä tai hengellisellä entiteetillä on hengellinen yhteys. Yhteys voi olla esim. kanavointia, guru-oppilas- tai psykoanalyytikko-potilas-suhde</skos:definition>
    <skos:definition xml:lang="sv">Person eller andlig entitet, med vilken en beskriven person eller andlig entitet har andlig kontakt. Kontakten kan ske via kanalisering, som ett förhållande mellan guru och elev eller mellan psykoanalytiker och patient.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">andlig kontakt</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has spiritual contact</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">hengellinen kontakti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4648">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4621"/>
    <skos:altLabel xml:lang="sv">mördad</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasMurderee"/>
    <skos:definition xml:lang="fi">Henkilö, jonka kuvailtava henkilö on murhannut.</skos:definition>
    <skos:definition xml:lang="sv">Person som en beskriven person har mördat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has murder victim</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mordoffer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">murhattu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4649">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4600"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasPatron"/>
    <skos:definition xml:lang="fi">Henkilö, joka tukee tai suosii kuvailtavaa henkilöä (esim. taiteilijaa).</skos:definition>
    <skos:definition xml:lang="sv">Person som stöder eller gynnar en beskriven person (t.ex. en konstnär).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has patron</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mecenat</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mesenaatti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4651">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Ersätter uppgifter om tidigare utgivningsfrekvens, om tidigare angivelser är fler än tre.</skos:definition>
    <skos:definition xml:lang="fi">Korvaa aikaisemman ilmestymistiheyden merkinnät, jos aikaisempia merkintöjä on enemmän kuin kolme.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ilmestymistiheys vaihtelee</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">varierande utgivningsfrekvens</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4653">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">forskarskola</skos:altLabel>
    <skos:altLabel xml:lang="sv">forskarteam</skos:altLabel>
    <skos:altLabel xml:lang="sv">forskningsenhet</skos:altLabel>
    <skos:altLabel xml:lang="sv">forskningsgrupp</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkijakoulu</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkijaryhmä</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkijayhteisö</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkimusyhteisö</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkimusyksikkö</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9161"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">forskargrupp</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tutkimusryhmä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4654">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p20297"/>
    <skos:definition xml:lang="sv">Läroanstalt som erbjuder undervisning till elever som p.g.a. funktionshinder, sjukdom, fördröjning i utvecklingen eller annan motsvarande orsak behöver särskilt stöd.</skos:definition>
    <skos:definition xml:lang="fi">Oppilaitos, jonka opetus on tarkoitettu vammaisuuden, sairauden, kehityksessä viivästymisen tai muun vastaavan syyn vuoksi erityistä tukea tarvitsevalle oppijalle (Opetus- ja koulutussanasto).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erityiskoulu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">specialskola</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4655">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">hallitsija (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">monark</skos:altLabel>
    <skos:altLabel xml:lang="fi">monarkki</skos:altLabel>
    <skos:altLabel xml:lang="sv">president (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">presidentti (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">regent (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="sv">statschef</skos:altLabel>
    <skos:altLabel xml:lang="sv">statsöverhuvud (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valtion päämies (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valtionpäämies (yhteisötyyppi)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p8251"/>
    <skos:definition xml:lang="sv">En stats formellt högsta politiska makthavare.</skos:definition>
    <skos:definition xml:lang="fi">Valtion muodollisesti ylin poliittinen vallankäyttäjä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">statsöverhuvud</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valtionpäämies</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används om en person som fungerar i myndighetsställning och som institution.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään viranomaisasemassa toimivasta henkilöstä, jonka tulkitaan toimivan yhteisönä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4656">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11027"/>
    <skos:definition xml:lang="sv">Myndighet som ansvarar för en hamns verksamhet, och som är namngiven enligt hamnen.</skos:definition>
    <skos:definition xml:lang="fi">Sataman toiminnasta vastaava viranomainen, joka on nimetty sataman mukaan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">hamn</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">satama</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4657">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">elevkår</skos:altLabel>
    <skos:altLabel xml:lang="sv">fiskeriområde</skos:altLabel>
    <skos:altLabel xml:lang="sv">flottningsförening</skos:altLabel>
    <skos:altLabel xml:lang="sv">forstförening</skos:altLabel>
    <skos:altLabel xml:lang="sv">handelskammare</skos:altLabel>
    <skos:altLabel xml:lang="sv">jaktvårdsförening</skos:altLabel>
    <skos:altLabel xml:lang="fi">julkisoikeudellinen yhdistys</skos:altLabel>
    <skos:altLabel xml:lang="fi">kalatalousalue</skos:altLabel>
    <skos:altLabel xml:lang="fi">kauppakamari</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsänhoitoyhdistys</skos:altLabel>
    <skos:altLabel xml:lang="sv">nation</skos:altLabel>
    <skos:altLabel xml:lang="sv">offentligrättslig förening</skos:altLabel>
    <skos:altLabel xml:lang="fi">opiskelijakunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">oppilaskunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">osakunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">paliskunta</skos:altLabel>
    <skos:altLabel xml:lang="sv">renbeteslag</skos:altLabel>
    <skos:altLabel xml:lang="fi">riistanhoitoyhdistys</skos:altLabel>
    <skos:altLabel xml:lang="sv">skogsvårdsförening</skos:altLabel>
    <skos:altLabel xml:lang="sv">studentkår</skos:altLabel>
    <skos:altLabel xml:lang="fi">uittoyhdistys</skos:altLabel>
    <skos:altLabel xml:lang="sv">viltvårdsförening</skos:altLabel>
    <skos:definition xml:lang="fi">Julkisoikeudelliset yhdistykset ovat yhdistyksiä, joiden toiminta perustuu erityiseen lakiin tai asetukseen. Tällaisilla yhdistyksillä voi olla julkisoikeudellisia hallintotehtäviä, kuten lupa-asioiden hoitoa, kurinpitovaltaa tai valvontavaltaa. (Wikipedia.)</skos:definition>
    <skos:definition xml:lang="sv">Offentligrättsliga föreningar är föreningar vars verksamhet grundar sig på lag eller förordning. Sådana föreningar kan ha offentligrättsliga förvaltningsuppgifter, såsom skötsel av tillståndsärenden, disciplinär makt eller övervakningsbefogenhet.</skos:definition>
    <skos:example xml:lang="sv">Finlands röda kors</skos:example>
    <skos:example xml:lang="fi">Suomen Punainen Risti</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förening (offentligrättslig)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhdistys (julkisoikeudellinen)</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m401"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m594"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4658">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4691"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5047"/>
    <skos:definition xml:lang="sv">Grupp som har getts i uppgift att undersöka något ärende och vars arbete resulterar i ett betänkande.</skos:definition>
    <skos:definition xml:lang="fi">Ryhmä, jolle on asetettu tehtäväksi tutkia jotain asiaa ja jonka työn tuloksena on mietintö (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">komitea</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommitté</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4666"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4667"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4659">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kunnan liikelaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuntayhtymän liikelaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikelaitoskuntayhtymä</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4686"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p15251"/>
    <skos:definition xml:lang="fi">Kunnan tai kuntayhtymän omistama liiketoimintaa harjoittava organisaatio.</skos:definition>
    <skos:definition xml:lang="sv">Organisation som utövar affärsverksamhet och ägs av kommun eller kommunsamfällighet.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kommunalt affärsverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kunnallinen liikelaitos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m466">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kort med stereografiska bilder.</skos:definition>
    <skos:definition xml:lang="fi">Kortti, jolla on stereografisia kuvia.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1042"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">stereografinen kortti</skos:prefLabel>
