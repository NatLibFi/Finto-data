    <skos:altLabel xml:lang="fi">kameraseurat</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsästysjärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsästysseurat</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsästysyhdistykset</skos:altLabel>
    <skos:altLabel xml:lang="fi">nimikkoseurat</skos:altLabel>
    <skos:altLabel xml:lang="sv">personsällskap</skos:altLabel>
    <skos:altLabel xml:lang="fi">pursiseurat</skos:altLabel>
    <skos:altLabel xml:lang="sv">segelsällskap</skos:altLabel>
    <skos:altLabel xml:lang="fi">veneilyseurat</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:definition xml:lang="sv">Organisationer som erbjuder hobbyverksamhet på fritiden och ordnar stödverksamhet för sådan.</skos:definition>
    <skos:definition xml:lang="fi">Vapaa-ajan harrastustoimintaa tarjoavat ja kannattajatoimintaa harjoittavat järjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">harrastusjärjestöt</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">hobbyorganisationer</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4902"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4908"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4917"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4921"/>
    <skos:scopeNote xml:lang="fi">Kulttuuri- ja sivistys- ja opintotoimintaa harjoittavista järjestöistä käytä termiä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4902'&gt;kulttuurijärjestöt&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om organisationer som främjar släktforskning och upprätthåller släkttradition och -sammanhållning används termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4921'&gt;släktföreningar&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om organisationer som främjar sport- och idrottsverksamhet används termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4908'&gt;idrottsorganisationer&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om organisationer som utövar kultur-, bildnings-, eller studieverksamhet används termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4902'&gt;kulturorganisationer&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om organisationer som utövar lokal eller regional traditions- och kulturverksamhet används termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4917'&gt;hembygdsföreningar&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Paikallista tai alueellista perinne- ja kulttuuritoimintaa harjoittavista järjestöistä käytä termiä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4917'&gt;kotiseutuyhdistykset&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sukututkimusta edistävistä sekä sukuperinnettä ja suvun yhteenkuuluvuutta ylläpitävistä järjestöistä käytä termiä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4921'&gt;sukuseurat&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Urheilu- ja liikuntatoimintaa edistävistä järjestöistä käytä termiä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4908'&gt;liikuntajärjestöt&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
