    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p7518"/>
    <skos:example xml:lang="sv">kommunfullmäktige; kommunala nämnder; kommunala förvaltningsnämnder</skos:example>
    <skos:example xml:lang="fi">kunnanvaltuustot; kunnalliset lautakunnat; kunnalliset hoitokunnat</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kommunalförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kunnallishallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4926">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
