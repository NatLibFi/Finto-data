    <skos:definition xml:lang="sv">Syskon till en beskriven person, då åtminstone ett av syskonen inte är biologiskt barn till någon av de gemensamma föräldrarna.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has stepsibling</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ottosisarus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">styvsyskon</skos:prefLabel>
  </owl:Class>
