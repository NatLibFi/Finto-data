    <skos:prefLabel xml:lang="fi">Ekspression suhteet toimijaan</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Uttrycks relationer till aktörer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1532">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">1,4 m/s</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">1,4 m/s</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1536">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">porträtt (visuella alster)</skos:altLabel>
    <skos:definition xml:lang="sv">Illustrativt innehåll som föreställer en eller flera personer eller djur och eftersträvande känd eller förmodad likhet, särskilt i personens ansikte.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka esittää yhtä tai useampia henkilöitä tai eläimiä, tavoitteena tunnettu tai oletettu näköisyys, erityisesti henkilön kasvoissa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">muotokuva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">portrait</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">porträtt</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: porträtt, xx porträtt</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: muotokuvia, xx muotokuvaa</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1537">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Lasten- ja nuortenkirjallisuuspalkinto. Palkinnon myöntää joka 3. vuosi IBBY Finland (ent. Suomen nuortenkirjaneuvosto). Palkinto jaettiin ensimmäisen kerran 1961. Palkittavan teoksen täytyy olla Suomessa julkaistu, korkeatasoinen, suomen- tai ruotsinkielinen lasten- tai nuortenkirja.</skos:definition>
    <skos:definition xml:lang="sv">Litteraturpris för barn- och ungdomslitteratur. Priset delas ut vart tredje år av IBBY Finland (f.d. Finska ungdomsboksrådet). Priset utdelades första gången år 1961. Det verk som erhåller priset bör vara publicerat i Finland och vara en kvalitativt högtstående finsk- eller svenskspråkig barn- eller ungdomsbok.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Anni Swan-medaljen, 2019</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Anni Swan -mitali, 2019</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Anni Swan -mitali</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Anni Swan-medaljen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1538">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">miniatyrmodell</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pienoismalli</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1541">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4283"/>
    <skos:altLabel xml:lang="fi">alkuperäinen painos</skos:altLabel>
    <skos:altLabel xml:lang="sv">nytryck av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="sv">originalupplaga</skos:altLabel>
    <skos:altLabel xml:lang="en">reprint of (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">uusintapainos manifestaatiosta</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4296"/>
    <skos:definition xml:lang="sv">Manifestation i tryckt form, som används som grund för ett återtryck av en manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Painetussa muodossa oleva manifestaatio, jota käytetään manifestaation uusintajulkaisun pohjana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30093"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">nytryck av materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reprint of manifestation of</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">uusintapainos aineistosta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1544">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p18952"/>
    <skos:definition xml:lang="fi">Hallitsijahuoneen naispuolinen ei-hallitseva jäsen.</skos:definition>
    <skos:definition xml:lang="sv">Icke-härskande kvinnlig medlem i furstehus.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">prinsessa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">prinsessa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1545">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3445"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1399"/>
    <skos:definition xml:lang="sv">Föremål för hänvisning är ett verk, utgående från vilket den lättlästa versionen som är föremål för beskrivning gjorts.</skos:definition>
    <skos:definition xml:lang="fi">Viittauksen kohde on teos, josta kuvailun kohteena oleva selkokielinen versio on tehty.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lättläst version baserad på (verk)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">selkokielisen version perustana (teos)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1546">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Helsingin Sanomain kirjallisuuspalkinto</skos:altLabel>
    <skos:definition xml:lang="sv">Ett pris som sedan 1995 delats ut årligen av Helsingin Sanomat, för årets bästa finskspråkiga debutverk.</skos:definition>
    <skos:definition xml:lang="fi">Helsingin Sanomien vuodesta 1995 vuosittain jakama palkinto vuoden parhaalle suomenkieliselle esikoisteokselle.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Helsingin Sanomats litteraturpris, 1995</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Helsingin Sanomien kirjallisuuspalkinto, 1995</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Helsingin Sanomats litteraturpris</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Helsingin Sanomien kirjallisuuspalkinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1549">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Avokelalla oleva rullattu filmi, jolle ääni on tallennettu.</skos:definition>
    <skos:definition xml:lang="sv">Film på spole med inspelat ljud.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">filmljudspole</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sound-track reel</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääniraitakela</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m155">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen nauhan videoformaatti joka on osa 8 mm -formaattia.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för analogt band, som är en del av 8 mm-formatet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/videoFormat/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Hi-8 mm</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Hi-8 mm</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Hi-8 mm</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1553">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p4934"/>
    <skos:example xml:lang="fi">Halosenniemi (museo)</skos:example>
    <skos:example xml:lang="sv">Halosenniemi (museum)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">museo</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">museum</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1555">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Audio-CD</skos:altLabel>
    <skos:altLabel xml:lang="sv">Audio-CD</skos:altLabel>
    <skos:altLabel xml:lang="fi">CDDA</skos:altLabel>
    <skos:altLabel xml:lang="sv">CDDA</skos:altLabel>
    <skos:definition xml:lang="sv">Inspelningsmedium för optisk digital data. Inspelningsformat som används för ljud på CD-skivor.</skos:definition>
    <skos:definition xml:lang="fi">Optinen digitaalisen datan tallennusmedia. CD-levyissä käytettävä äänen tallennusformaatti.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">CD-DA</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">CD-DA</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Kodningsformat för ljud.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänen koodausmuoto.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m156">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">court reporter</skos:altLabel>
    <skos:altLabel xml:lang="sv">domstolssekreterare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuomioistuimen kirjuri (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5684"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett verks uttryck, genom att förbereda en domstols utlåtande för publicering.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu teoksen ekspression tekemiseen valmistelemalla tuomioistuimen lausunnon julkaistavaksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20040"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">court reporter agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">domstolssekreterare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuomioistuimen kirjuri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1563">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Hopean ja halogeenin (kloori, bromi, jodi tai fluori) yhdisteen ja sideaineen (yleensä gelatiini) muodostama valoherkkä kerros.
Materiaali, jota tavallisesti käytetään mikrofilmin tai mikrokortin pohjamateriaalina.</skos:definition>
    <skos:definition xml:lang="sv">Ljuskänsligt lager bildat av en förening av silver och halogen (klor, brom, jod, fluor) och ett bindemedel (vanligen gelatin). Material som vanligtvis används som bottenmaterial för mikrofilm eller mikrofiche.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1047"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">hopeahalidi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silver halide emulsion</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">silverhalid</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1564">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aikuisopiskelu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vuxenstudier</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1566">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3422"/>
    <skos:altLabel xml:lang="sv">nyproduktion baserad på</skos:altLabel>
    <skos:altLabel xml:lang="sv">nyproduktion baserad på (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">uusintaproduktion perustana</skos:altLabel>
    <skos:altLabel xml:lang="fi">uusintaproduktion perustana (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5784"/>
    <skos:definition xml:lang="fi">Uuden elokuvan, televisio-ohjelman, radio-ohjelman tai videon perustana käytetty teos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som använts som grund för en ny film, ett tv-program, ett radioprogram eller en video.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10185"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">nyproduktion av verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">remake of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">uusintaproduktio teoksesta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1568">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m83"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10088"/>
    <skos:definition xml:lang="fi">Luonnollisella kielellä ja sanamuodolla oleva, yleisessä kielessä käytetty teoksen nimitys.</skos:definition>
    <skos:definition xml:lang="sv">Titel för verk, som är på naturligt språk och har en ordalydelse som används i allmänt språkbruk.</skos:definition>
    <skos:prefLabel xml:lang="fi">Teoksen nimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Title of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Verkets titel</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1573">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">Den dansande björnen</skos:altLabel>
    <skos:altLabel xml:lang="fi">Tanssiva karhu</skos:altLabel>
    <skos:definition xml:lang="sv">Ett pris som utdelas av Rundradion Ab för ett kvalitativt högtstående inhemskt diktverk. Utdelat sedan år 1994.</skos:definition>
    <skos:definition xml:lang="fi">Yleisradio oy:n jakama palkinto korkeatasoiselle kotimaiselle runoteokselle. Jaettu vuodesta 1994 alkaen.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Den dansande björnen-priset, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Tanssiva karhu -runopalkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Den dansande björnen-priset</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tanssiva karhu -runopalkinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1574">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken en fotoreproduktion i makroform framställs med strålningsenergi via beröring eller reflektion direkt på ett ogenomskinligt material.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa tuotetaan makromuotoinen valojäljitelmä suoraan läpinäkymättömälle materiaalille säteilyenergialla, kosketuksen tai heijastamisen kautta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fotokopia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">photocopying</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valokopio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1575">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
