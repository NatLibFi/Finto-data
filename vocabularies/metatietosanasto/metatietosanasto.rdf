  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4684">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p14946"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Suomen suuriruhtinaskunnan ylin hallitusvaltaa käyttävä ja oikeutta jakava elin, sen osastot ja toimikunnat sekä niiden seuraajat vuoden 1918 sodan aikana.</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Högsta styrande organ i Storfurstendömet Finland, även dess avdelningar och kommittéer, samt efterträdare till dessa under kriget 1918.</skos:definition>
    <skos:example xml:lang="fi">Keisarillinen Suomen senaatti</skos:example>
    <skos:example xml:lang="sv">Kejserliga senaten för Finland</skos:example>
    <skos:example xml:lang="sv">Senatens ekonomiedepartement</skos:example>
    <skos:example xml:lang="sv">Senatens justitiedepartement</skos:example>
    <skos:example xml:lang="fi">Suomen senaatin kulkulaitostoimituskunta</skos:example>
    <skos:example xml:lang="fi">Suomen senaatin oikeusosasto</skos:example>
    <skos:example xml:lang="fi">Vaasan senaatin talousosasto</skos:example>
    <skos:example xml:lang="fi">Vaasan senaatti</skos:example>
    <skos:example xml:lang="sv">Vasasenaten</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">senaatti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">senat</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4685">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2083"/>
    <skos:definition xml:lang="fi">Armeijan perusyksikkö, jolla on yhteinen huolto ja talous (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Grundenhet i armé, med gemensamt underhåll och gemensam ekonomi.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kompani</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">komppania</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4686">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">julkinen liikelaitos</skos:altLabel>
    <skos:altLabel xml:lang="sv">offentligt affärsverk</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p15252"/>
    <skos:definition xml:lang="fi">Julkisen elimen omistama liiketoimintaa harjoittava organisaatio (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Organisation ägd av ett offentligt organ som utövar affärsverksamhet.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">affärsverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikelaitos</skos:prefLabel>
  </owl:Class>
