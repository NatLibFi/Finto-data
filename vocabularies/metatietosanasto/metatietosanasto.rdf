    <skos:altLabel xml:lang="sv">ljusdesigner (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljussättare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä valokomponentteja suunnitteleva ja tekevä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som planerar och skapar ljuskomponenter, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
