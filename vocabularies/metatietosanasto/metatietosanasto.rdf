    <skos:altLabel xml:lang="sv">beställare</skos:altLabel>
    <skos:altLabel xml:lang="en">commissioning body</skos:altLabel>
    <skos:altLabel xml:lang="fi">teettäjä</skos:altLabel>
    <skos:altLabel xml:lang="fi">tilaaja</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimeksiantaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppdragsgivare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5482"/>
    <skos:definition xml:lang="sv">Aktör som svarar för beställandet av ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa teoksen teettämisestä. (RDA Registry)</skos:definition>
