    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen äänisuunnittelija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljuddesigner (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän liikkuvan kuvan ääniä suunnitteleva ja tekevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som planerat och utfört ljud i rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan äänisuunnittelija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljuddesigner för rörlig bild</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5972">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">manifestaatioon liittyvä henkilö</skos:altLabel>
    <skos:altLabel xml:lang="sv">person relaterad till manifestationen</skos:altLabel>
    <skos:definition xml:lang="fi">Henkilö, joka liittyy manifestaatioon. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som relaterar till en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30268"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5097"/>
    <skos:prefLabel xml:lang="fi">aineistoon liittyvä henkilö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">person relaterad till materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related person of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5973">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dedikationsmottagare</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen omistuksen kohde (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">verket dedicerat till (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5899"/>
    <skos:definition xml:lang="fi">Henkilö, jolle teos on omistettu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som ett verk tillägnats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10412"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dedicatee person of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen omistuksen kohde</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verket dedicerat till</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5974">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dansare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen tanssija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="sv">Institution som dansar i rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka tanssii aggregaattiin sisältyvässä liikkuvassa kuvassa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dansare i rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan tanssija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5975">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deltagare (institution) i paneldiskussion som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen panelisti (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">paneldeltagare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvään keskusteluohjelmaan osallistuva yhteisö. Paneelikeskusteluissa käsitellään eri aiheita usein niitä tuntevien asiantuntijoiden kesken.</skos:definition>
    <skos:definition xml:lang="sv">Institution som deltar i ett diskussionsprogram som ingår i ett aggregat. I paneldiskussioner behandlas olika ämnen, ofta mellan experter i ämnena.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i paneldiskussion</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">panelisti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5976">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5666"/>
    <skos:definition xml:lang="sv">Släkt som fortsätter eller följer på en annan släkt.</skos:definition>
    <skos:definition xml:lang="fi">Suku, joka jatkaa tai seuraa toista sukua. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50424"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">efterföljande släkt</skos:prefLabel>
    <skos:prefLabel xml:lang="en">successor of family</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">suvun seuraaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5977">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deponent</skos:altLabel>
    <skos:altLabel xml:lang="sv">deponerat av (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tallettaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5293"/>
    <skos:definition xml:lang="fi">Kappaleen nykyinen henkilöomistaja, joka tallettaa kappaleen toisen toimijan huostaan omistajuudesta luopumatta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Nuvarande ägarperson till ett exemplar, som förvarar exemplaret hos en annan aktör, utan att överlåta ägarskapet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40107"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deponerat av</skos:prefLabel>
    <skos:prefLabel xml:lang="en">depositor person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tallettaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5978">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m875"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5896"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5966"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5989"/>
    <skos:prefLabel xml:lang="sv">Institutioners relationer till aktörer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Yhteisön suhteet toimijaan</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5979">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förläggare</skos:altLabel>
    <skos:altLabel xml:lang="fi">kustantaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">utgivare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5323"/>
    <skos:definition xml:lang="sv">Institution som svarar för förläggande, utgivning eller utkommande av en publicerad manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa julkaistun manifestaation kustantamisesta, julkaisemisesta tai ilmestymisestä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30420"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kustantaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">publisher corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utgivare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5980">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dirigent (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen johtaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän musiikkiesityksen tai näytelmän esiintyjäryhmää johtava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som dirigerar en uppträdande grupp i en musikföreställning eller ett skådespel.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dirigent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">johtaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5981">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">etsaaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">etsare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5487"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av en manifestation genom att etsa metall, glas eller någon annan yta med hjälp av syra eller något annat frätande ämne.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation valmistamisesta etsaamalla metallia, lasia tai muuta pintaa hapon tai muun syövyttävän aineen avulla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30414"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">etcher corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">etsaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">etsare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5982">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">skapare (institution) av visuella effekter</skos:altLabel>
    <skos:altLabel xml:lang="fi">visuaalisten tehosteiden tekijä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck av ett verk med rörlig bild, genom att planera och skapa visuella effekter i postproduktionsfasen.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu liikkuvan kuvan teoksen ekspression tekemiseen suunnittelemalla ja luomalla visuaaliset tehosteet jälkituotantovaiheessa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20479"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">skapare av visuella effekter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">visuaalisten tehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">visual effects provider corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5983">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kalligraf (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kalligrafi (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5732"/>
    <skos:definition xml:lang="sv">Institution som är en konstnär som svarar för kalligrafi, i vilken huvudvikten ligger vid de estetiska värdena i handskrift eller grafisk konst, oberoende av om samma aktör också svarar för den skrivna texten.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama yhteisö myös vastuussa kirjoitetusta tekstistä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10520"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">calligrapher corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kalligraf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kalligrafi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5984">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (institution) till text i musikverk</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiteoksen tekstin kirjoittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5497"/>
    <skos:definition xml:lang="en">A corporate body who is responsible for writing a textual work that is basis of a non-dramatic musical work, other than an oratorio.</skos:definition>
    <skos:definition xml:lang="sv">Institution som är författare till en text som är grunden för ett icke-dramatiskt musikverk (annat än oratorium).</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on ei-näytelmällisen musiikkiteoksen (muun kuin oratorion) pohjalla olevan tekstin kirjoittaja.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">author corporate body of musical work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare till text i musikverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikkiteoksen tekstin kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5985">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen televisio-ohjaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-regissör (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän TV-ohjelman yleisestä johtamisesta ja valvomisesta vastaava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för allmän ledning och övervakning av ett tv-program som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">televisio-ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-regissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5986">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kadenssin (teos) säveltäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kompositör (institution) av kadens (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5350"/>
    <skos:definition xml:lang="en">A corporate body who is responsible for creating a cadenza work that augments a musical work.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av en kadens som utvidgar ett musikverk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa musiikkiteosta laajentavan kadenssin luomisesta.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer corporate body of cadenza work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kadenssin säveltäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör av kadens</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5987">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4813"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5315"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5797"/>
    <skos:prefLabel xml:lang="fi">Ekspression suhteet manifestaatioon</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Uttrycks relationer till manifestationer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5988">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kuvanveistäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skulptör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5732"/>
    <skos:definition xml:lang="sv">Institution som är en konstnär som svarar för skapandet av ett tredimensionellt verk, genom att modellera, skära eller använda någon liknande teknik.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10521"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
