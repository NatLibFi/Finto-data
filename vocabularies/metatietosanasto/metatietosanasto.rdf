    <skos:definition xml:lang="en">A person who is responsible for creating a television program music work that complements a musical work.</skos:definition>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa televisio-ohjelmaa täydentävän musiikin luomisesta.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av musik som kompletterar ett tv-program.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer person of television program music work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör av musik till tv-program</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">televisio-ohjelman musiikin säveltäjä</skos:prefLabel>
  </owl:Class>
