    <skos:prefLabel xml:lang="en">related item of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teokseen liittyvä kappale</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5293">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">nuvarande ägare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">nykyinen omistaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5320"/>
    <skos:definition xml:lang="fi">Henkilö, joka tällä hetkellä laillisesti omistaa kappaleen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som för tillfället juridiskt äger ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40101"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">current owner person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">nuvarande ägare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">nykyinen omistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5294">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">censor (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sensori (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5548"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att granska innehållet i ett annat uttryck för att dölja kontroversiellt innehåll på moraliska, politiska, militära eller andra grunder, men ändå låta det ursprungliga verkets karaktär och allmänna innehåll till sina väsentliga delar förbli oförändrat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20356"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">censor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">censor person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sensori</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske laajaa muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte omfattande redigering, som leder till skapandet av ett nytt verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5295">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen moderoija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">moderator (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää keskusteluohjelmaa juontava yhteisö audiovisuaalisessa aineistossa.</skos:definition>
    <skos:definition xml:lang="sv">Institution som leder ett diskussionsprogram i audiovisuellt material som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">moderator</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">moderoija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5296">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression haastattelija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuare (institution) i uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">version haastattelija</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck genom att fungera som intervjuare, journalist, opinionsmätare eller någon annan aktör som samlar in information.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonain muuna toimijana, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20455"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastattelija (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">interviewer corporate body of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuare (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5297">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5344"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2295"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka laajentaa toisen teoksen ekspression kerrontaa ajassa taaksepäin. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, som utvidgar ett annat verks uttrycks berättelse bakåt i tiden.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20334"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esiosa (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">prequel (uttryck)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">prequel expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5298">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5098"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen yhteisö, joka on luonut aggregaattiin sisältyvän digitaalisen sisällön ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Institution som bidragit till ett aggregat och som skapat ett uttryck med digitalt innehåll som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30404"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (institution) till digitalt innehåll</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor corporate body of computer content</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">digitaaliseen sisältöön osallinen yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5299">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvan jakelija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmdistributör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5282"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för distributionen av en film eller annan dylik manifestation till biografer eller andra distributionskanaler.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30348"/>
