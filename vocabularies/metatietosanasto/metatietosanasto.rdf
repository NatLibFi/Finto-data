  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1273">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Hyvälaatuisesta selluloosasta tai lumppumassasta valmistettu materiaali, joka vaihtelee suuresti tyypiltään ja vahvuudeltaan, ja joka on paksuudeltaan vähintään 0.1524 mm.</skos:definition>
    <skos:definition xml:lang="sv">Material tillverkat av kvalitativ cellulosa eller lumpmassa, som till sin typ och styrka varierar och vars tjocklek är minst 0.1524 mm.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">cardboard</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pahvi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">papp och kartong</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1274">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Används om manifestation, som innehåller verk som en ansvarig upphovsman själv skrivit ned på maskin.</skos:definition>
    <skos:definition xml:lang="fi">Käytetään manifestaatiosta, jonka sisältämän teoksen tai teosten vastuullisuustekijä tai -tekijät on itse kirjoittanut koneella.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">koneella kirjoitettu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">maskinskriven</skos:prefLabel>
    <skos:prefLabel xml:lang="en">typescript</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1279">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Förminskningsgrad för en upptagning i mikroform, då bildens relation till den ursprungliga bilden är mer än 90x.</skos:definition>
    <skos:definition xml:lang="fi">Pienennyssuhde mikromuotoiselle tallenteelle, kun kuvan suhde alkuperäiseen kuvaan on enemmän kuin 90x.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAReductionRatio/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">hyvin voimakas pienennys</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ultra high reduction</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ultrastark förminskning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1280">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen televisiojärjestelmän lähetysstandardi joka oli käytössä suurimmassa osassa Amerikkaa sekä kaukoidässä, nimetty National Television System Committeen mukaan.</skos:definition>
    <skos:definition xml:lang="sv">Sändningsstandard för analogt televisionssystem, som användes i större delen av Amerika samt i Fjärran Östern. Förkortning av National Television System Committee.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/broadcastStand/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">NTSC</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">NTSC</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">NTSC</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1283">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">SGML</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">SGML</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1285">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Material (papper, film, band e.d.) som lindats upp på rulle.</skos:definition>
    <skos:definition xml:lang="fi">Rullalle kääritty aineisto (paperia, filmiä, nauhaa tms.).</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1047"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">roll</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rulla</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">rulle</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ilman laitetta käytettävä tallennetyyppi.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omedierad bärartyp.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1288">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">määrittelemätön</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ospecificerad</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används då medietypen eller -typerna som passar in på den beskrivna resursen, inte enkelt kan fastställas.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään kun mediatyyppiä tai -tyyppejä, jotka soveltuvat kuvailtavaan aineistoon, ei voida helposti todentaa.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1289">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Avokela, jossa on mikrofilmin lukijalla katsottava mikrofilmi.</skos:definition>
    <skos:definition xml:lang="sv">Spole med mikrofilm avsedd att läsas i mikrofilmsläsare.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1026"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">microfilm reel</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mikrofilmikela</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mikrofilmsspole</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Mikroformsbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Mikromuotoinen tallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1290">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka valmistetaan kutomalla, huovuttamalla, sitomalla, punomalla tai muulla tavalla käsittelemällä luonnollisia tai synteettisiä kuituja niin että ne kiinnittyvät toisiinsa.</skos:definition>
    <skos:definition xml:lang="sv">Material som tillverkas genom att väva, tova, binda, fläta eller på annat sätt behandla naturliga eller syntetiska fibrer så att de fästs vid varandra.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1039"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tekstiili</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textil</skos:prefLabel>
    <skos:prefLabel xml:lang="en">textile</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1291">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">JPEG</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">JPEG</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1294">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4256"/>
    <skos:altLabel xml:lang="sv">digital reproduktion (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">digital reproduktion av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="sv">digitalisering av manifestation</skos:altLabel>
    <skos:altLabel xml:lang="fi">digitoitu jäljenne (manifestaatio)</skos:altLabel>
    <skos:altLabel xml:lang="fi">digitoitu manifestaatiosta</skos:altLabel>
    <skos:altLabel xml:lang="en">electronic reproduction (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation digitoitu jäljenne</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m93"/>
    <skos:definition xml:lang="fi">Digitaalisessa muodossa oleva manifestaatio, joka analogisen manifestaatio muunnoksen tulos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">En manifestation i digital form, som är resultat av omvandlingen av en analog manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston digitoitu jäljenne</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">digital reproduktion av materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">electronic reproduction of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1298">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">prod. (producent)</skos:altLabel>
    <skos:altLabel xml:lang="sv">producent (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">producer</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuott. (tuottaja)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuottaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för största delen av de kommersiella uppgifterna kring en film-, ljudupptagnings-, tv-, streaming- eller dylik produktion.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka vastaa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10064"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1170"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1216"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4460"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m813"/>
    <skos:prefLabel xml:lang="sv">producent</skos:prefLabel>
    <skos:prefLabel xml:lang="en">producer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuottaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En producent svarar typiskt för skaffande av finansiering, ledning av produktion, anställning av nyckelpersonal, ordning av distributörer etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m130">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">minute taker</skos:altLabel>
    <skos:altLabel xml:lang="sv">protokollförare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">pöytäkirjan laatija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5684"/>
    <skos:definition xml:lang="sv">Aktör som svarar för sammanställandet av ett protokoll för ett möte.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka vastaa kokouksen pöytäkirjan laatimisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20058"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
