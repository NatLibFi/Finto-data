  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m380">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Myönnetään kotimaiselle tekijälle yksin tai yhdessä toisen osapuolen kanssa tekemästä ansiokkaasta sarjakuva-albumista.
Tunnustuspalkinto myönnetään vuosittain keväällä Tampere Kuplii -sarjakuvatapahtumassa.</skos:definition>
    <skos:definition xml:lang="sv">Utdelas åt en inhemsk författare som ensam eller med en annan part gett ut ett meriterat seriealbum. Hederspriset utdelas varje vår under seriefestivalen Tampere Kuplii.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Serie-Finlandiapriset, 2010</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Sarjakuva-Finlandia-palkinto, 2010</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Sarjakuva-Finlandia-palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Serie-Finlandiapriset</skos:prefLabel>
  </owl:Class>
