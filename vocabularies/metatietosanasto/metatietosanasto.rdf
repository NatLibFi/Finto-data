    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5285"/>
    <skos:definition xml:lang="fi">Henkilö, joka vastaa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä, joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tekniska, redaktionella och kunskapsmässiga åtgärder, vilkas syfte är att återställa ett exemplar i dåligt skick så nära som möjligt dess ursprungliga skick.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40111"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleen entisöijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konservator av exemplar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restorationist person of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5285">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bearbetare (person)</skos:altLabel>
