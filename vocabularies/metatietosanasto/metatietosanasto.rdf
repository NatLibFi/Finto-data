    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka nimittää teoksen tunnustukseksi siihen liittyvän toimijan innoituksesta tai tuesta. (RDA Registry)</skos:definition>
