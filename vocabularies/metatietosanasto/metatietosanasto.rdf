    <skos:prefLabel xml:lang="fi">oopperasovitus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">operabearbetning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2298">
