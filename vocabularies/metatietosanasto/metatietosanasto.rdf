    <skos:definition xml:lang="sv">Titel för uttryck, som har valts till primär i en viss tillämpning eller kontext.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ekspression ensisijainen nimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">föredragen titel för uttrycket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">preferred title of expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6038">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m261"/>
