    <skos:prefLabel xml:lang="fi">originaali</skos:prefLabel>
    <skos:prefLabel xml:lang="en">original</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">original</skos:prefLabel>
  </owl:Class>
