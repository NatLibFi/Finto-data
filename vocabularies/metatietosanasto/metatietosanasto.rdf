    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2286"/>
    <skos:altLabel xml:lang="fi">aiempi ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="fi">edeltävä ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">föregående uttryck</skos:altLabel>
    <skos:altLabel xml:lang="sv">föregående version av verk</skos:altLabel>
    <skos:altLabel xml:lang="sv">tidigare uttryck</skos:altLabel>
