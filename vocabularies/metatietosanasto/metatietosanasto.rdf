    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasParent"/>
    <skos:definition xml:lang="sv">Förälder till en beskriven person, oberoende biologiskt släktskap.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön vanhempi, riippumatta biologisesta sukulaisuudesta.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förälder</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has parent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vanhempi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4630">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4632"/>
