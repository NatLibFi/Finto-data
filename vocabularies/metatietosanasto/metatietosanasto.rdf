    <skos:definition xml:lang="fi">Musiikkiteoksen ekspressio, joka toimii näytelmän tai muun puhutun näyttämöteoksen näytelmämusiikkina. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av musikverk, som fungerar som skådespelsmusik till ett skådespel eller något annat talat sceniskt verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20085"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
