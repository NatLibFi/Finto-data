  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5940">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tekstaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">textare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu sarjakuvan, sarjakuvaromaanin tms. ekspression tekemiseen piirtämällä tekstin ja graafiset äänitehosteet. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck av en tecknad serie, grafisk roman eller dylikt, genom att rita texten och grafiska ljudeffekter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20387"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">letterer person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5941">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">landskapsarkitekt (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">maisema-arkkitehti (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5846"/>
    <skos:definition xml:lang="sv">Institution som är en arkitekt och svarar för skapandet av landskapsverk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10519"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">landscape architect corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">landskapsarkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maisema-arkkitehti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5942">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">animatör (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen animaattori (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän animaation tekijä eli näennäistä liikettä esineisiin tai piirroksiin tuottava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Skapare av animation, det vill säga person som ger skenbar rörelse åt föremål eller teckningar, som ingår i aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">animaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">animatör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5943">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljuddesigner (institution) som är bidragsgivare till tal</skos:altLabel>
    <skos:altLabel xml:lang="fi">puheeseen osallinen äänisuunnittelija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6009"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän puhesisällön äänikomponentteja suunnitteleva ja tekevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som planerar och gör ljudkomponenter i ett talinnehåll som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljuddesigner för tal</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puheen äänisuunnittelja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5944">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
