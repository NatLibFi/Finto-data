    <skos:altLabel xml:lang="sv">gjutare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5586"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkningen av en manifestation, genom att forma smält eller flytande ämne med hjälp av en form.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation valmistamisesta muovaamalla sulatettua tai nestemäistä ainetta muotin avulla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30073"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">caster agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gjutare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1746">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
