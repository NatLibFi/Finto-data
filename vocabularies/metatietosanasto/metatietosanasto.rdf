    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän elokuvan tekijä, joka vastaa itse koko elokuvan ideoinnista ja toteutuksesta.</skos:definition>
    <skos:definition xml:lang="sv">Skapare av film som ingår i ett aggregat, och som svarar för idén till och förverkligandet av en hel film.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvantekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmskapare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5522">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
