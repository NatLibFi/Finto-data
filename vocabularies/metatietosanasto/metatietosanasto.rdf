  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m10">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">jumbo punktskrift</skos:altLabel>
    <skos:definition xml:lang="fi">Kirjasinkoko, joka on tarkoitettu auttamaan lukijoita, joilla on vaikeuksia lukea tavallisen kokoista tekstiä.</skos:definition>
    <skos:definition xml:lang="sv">Typgrad, som är avsedd att underlätta för läsare som har svårigheter att läsa text i vanlig storlek.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/fontSize/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">isopistekirjoitus</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jumbo braille</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">storstilspunktskrift</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1001">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, tredimensionellt föremål som beskriver ett verkligt eller fiktivt objekt.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kolmiulotteinen esine, joka kuvaa todellista tai kuvitteellista objektia.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1022"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">malli</skos:prefLabel>
    <skos:prefLabel xml:lang="en">model</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">modell</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1007">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">overheadbild</skos:altLabel>
    <skos:altLabel xml:lang="sv">stordia</skos:altLabel>
    <skos:altLabel xml:lang="sv">transparang</skos:altLabel>
    <skos:definition xml:lang="sv">Genomskinligt ark, eventuellt inom ramar, som innehåller bilder eller text och som är avsett för användning med overheadprojektor; ett enskilt ark kan också ha överlappande ark.</skos:definition>
    <skos:definition xml:lang="fi">Kuvia tai tekstiä sisältävä läpinäkyvä arkki, joka voi olla kehyksissä, ja joka on suunniteltu käytettäväksi piirtoheittimellä; yksittäisellä kalvolla voi olla päällekkäiskalvoja.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1039"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">OH-bild</skos:prefLabel>
    <skos:prefLabel xml:lang="en">overhead transparency</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piirtoheitinkalvo</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Bärare för projicerbara bilder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Heijastettava kuvatallenne.</skos:scopeNote>
  </owl:Class>
