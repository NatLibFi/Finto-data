  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m346">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m261"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/e/P20001"/>
    <skos:definition xml:lang="fi">Liittää ekspression jaotteluun, joka ilmaisee sisällön esitysmuodon ja sen, minkä aistin välityksellä sisältö on tarkoitus vastaanottaa. Jos mikään alla olevista RDA:n sisältötyypeistä ei sovellu kuvaamaan aineiston sisältöä, merkitään 'muu'.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar uttryck med en indelning som anger visningsform för innehållet och med vilket sinne innehållet är avsett att mottagas. Om ingen av RDA-innehållstyperna nedan kan användas för att beskriva materialets innehåll anges "annan".</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1019"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1065"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1078"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1105"/>
