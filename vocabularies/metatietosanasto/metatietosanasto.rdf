  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m876">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod för material som grundar sig på känselsinnet, i vilken en bild har tryckts på specialpapper. I pappret finns mikrokapslar som innehåller alkohol och som reagerar på värme genom att utvidga sig.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä tuntoaistiin perustuville aineistoille, joissa kuva on painettu erikoispaperille. Paperissa on alkoholia sisältäviä mikrokapseleita, jotka reagoivat lämpöön laajenemalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1020"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuohupaperi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">svällpapper</skos:prefLabel>
    <skos:prefLabel xml:lang="en">swell paper</skos:prefLabel>
  </owl:Class>
