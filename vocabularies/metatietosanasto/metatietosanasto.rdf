    <skos:prefLabel xml:lang="sv">hus (institution)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">talo (yhteisö)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4737">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förvaltningsrätt</skos:altLabel>
    <skos:altLabel xml:lang="fi">hallinto-oikeus</skos:altLabel>
    <skos:altLabel xml:lang="sv">länsrätt</skos:altLabel>
    <skos:altLabel xml:lang="fi">lääninoikeus</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1646"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9411"/>
    <skos:definition xml:lang="sv">Domstol som behandlar förvaltningsrättsliga ärenden.</skos:definition>
    <skos:definition xml:lang="fi">Hallinto-oikeudellisia asioita käsittelevä tuomioistuin (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förvaltningsdomstol</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">hallintotuomioistuin</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4738">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40341"/>
    <skos:definition xml:lang="fi">Itsenäisiin sotatoimiin pystyvä armeijan sotatoimiyhtymä, johon kuuluu kaikkia sen tehtävään tarvitsemia maavoimien aselajeja (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Militärt förband med förmåga till självständiga krigsoperationer och med alla de arméns vapenslag som behövs för uppgiften.</skos:definition>
    <skos:example xml:lang="sv">Finlands I armékår (fortsättningskriget)</skos:example>
    <skos:example xml:lang="fi">Suomen I armeijakunta (jatkosota)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">armeijakunta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">armékår</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4739">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">asiamies (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="fi">edustaja</skos:altLabel>
    <skos:altLabel xml:lang="sv">ombudsman</skos:altLabel>
    <skos:altLabel xml:lang="fi">valtuutettu</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p21148"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3771"/>
    <skos:definition xml:lang="fi">Hallituksen poliittinen, sotilaallinen tai kaupallinen edustaja tai jotakin viranomaista edustava virkailija, jota kutsutaan asiamieheksi.</skos:definition>
    <skos:definition xml:lang="sv">Politiskt, militärt eller kommersiellt ombud, eller tjänsteman som representerar någon myndighet och som benämns ombud.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asiamies (viranomainen)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ombud (myndighet)</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används om en person som handlar i myndighetsställning och som fungerar som institution.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään viranomaisasemassa toimivasta henkilöstä, jonka tulkitaan toimivan yhteisönä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4740">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">centralkriminalpolis</skos:altLabel>
    <skos:altLabel xml:lang="fi">keskusrikospoliisi</skos:altLabel>
    <skos:altLabel xml:lang="fi">poliisi (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="fi">poliisilaitos</skos:altLabel>
    <skos:altLabel xml:lang="sv">polis (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="sv">polisinrättning</skos:altLabel>
    <skos:altLabel xml:lang="sv">skyddspolis</skos:altLabel>
    <skos:altLabel xml:lang="fi">suojelupoliisi</skos:altLabel>
    <skos:altLabel xml:lang="sv">säkerhetspolis</skos:altLabel>
    <skos:altLabel xml:lang="fi">turvallisuuspoliisi</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p13271"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p4084"/>
    <skos:definition xml:lang="sv">Statlig organisation som ansvarar för upprätthållandet av ordning och säkerhet.</skos:definition>
    <skos:definition xml:lang="fi">Valtiollinen organisaatio, jonka tehtävänä on huolehtia valtio- ja yhteiskuntajärjestyksen sekä yleisen järjestyksen ja turvallisuuden säilymisestä (Arkistojen portti).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">poliisi (organisaatio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">polis (organisation)</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används även om polisinrättningar ansvariga för upprätthållandet av ordning i städerna. Används inte om länsmän som svarade för polisväsendet på landsbygden före häradsreformen 1996.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään myös kaupungeissa järjestyksenpidosta vastanneista poliisilaitoksista. Ei käytetä maaseudulla poliisitoimesta ennen vuoden 1996 kihlakuntauudistusta vastanneista nimismiehistä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4741">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">hoitokoti</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommunalhem</skos:altLabel>
    <skos:altLabel xml:lang="fi">kunnalliskoti</skos:altLabel>
    <skos:altLabel xml:lang="fi">vaivaiskoti</skos:altLabel>
    <skos:altLabel xml:lang="fi">vanhainkoti</skos:altLabel>
    <skos:altLabel xml:lang="sv">vårdhem</skos:altLabel>
    <skos:altLabel xml:lang="sv">vårdinstitution för åldringar</skos:altLabel>
    <skos:altLabel xml:lang="sv">äldrehem</skos:altLabel>
    <skos:altLabel xml:lang="sv">ålderdomshem</skos:altLabel>
    <skos:altLabel xml:lang="sv">åldringshem</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4668"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p281"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">vanhustenhuoltolaitos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vårdinrättning för äldre</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4742">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9197"/>
    <skos:definition xml:lang="sv">Avser tillfällig förvaltning av tillgångar, delad mellan konkursborgenärer och boförvaltare.</skos:definition>
    <skos:definition xml:lang="fi">Konkurssipesällä tarkoitetaan konkurssivelkojien ja pesänhoitajan kesken jaettua varallisuuden luonteeltaan väliaikaista hallintoa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">konkursbo</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">konkurssipesä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4743">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tågstation</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p16083"/>
    <skos:definition xml:lang="sv">Myndighet som ansvarar för en järnvägsstations verksamhet, och som är namngiven enligt järnvägsstationens namn.</skos:definition>
    <skos:definition xml:lang="fi">Rautatieaseman toiminnasta vastaava viranomainen, joka on nimetty rautatieaseman nimen mukaan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">järnvägsstation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rautatieasema</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4744">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">artilleridivision</skos:altLabel>
    <skos:altLabel xml:lang="sv">sektion (militär)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40342"/>
    <skos:definition xml:lang="fi">Pataljoonaa vastaava tykistön joukkoyksikkö, johon kuuluu yleensä kolme tulipatteria sekä esikunta- ja huoltopatteri (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Truppenhet inom artilleri.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">patteristo</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sektion</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4745">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">barnträdgård</skos:altLabel>
    <skos:altLabel xml:lang="fi">lastentarha</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4668"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p282"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">daghem</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">päiväkoti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4746">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">henkikirjoittaja (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">häradsskrivare (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kihlakunnankirjuri (viranomainen)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kihlakunnankirjuri (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">mantalsskrivare</skos:altLabel>
    <skos:altLabel xml:lang="sv">registerbyrå</skos:altLabel>
    <skos:altLabel xml:lang="fi">rekisteritoimisto</skos:altLabel>
    <skos:definition xml:lang="fi">Historiallinen termi. Kihlakuntahallinnossa kruununvoutien apuna toiminut virkamies, jonka tehtäviin kuului mm. vero- ja maksuluetteloiden laatiminen, verokannon tarkastaminen ja vuodesta 1779 henkikirjojen laatiminen. Myöhemmin henkikirjoittaja on vastannut myös siviili-, yritys- ja kaupparekisterin pidosta. Henkikirjoittajan kansliat muutettiin vuonna 1970 rekisteritoimistoiksi, joista osa yhdistettiin vuonna 1996 kihlakunnanvirastoihin, osasta tuli uusia maistraatteja. (Arkistojen portti.)</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Tjänsteman som fungerade som stöd för kronofogdar i häradsförvaltning och till vars uppgifter hörde bl.a. upprättande av skattelängder och tariffer, kontroll av skatteuppbörd och fr.o.m. år 1779 sammanställande av mantalslängder. Senare har häradsskrivare också svarat för upprätthållande av civil-, företags- och handelsregister.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">henkikirjoittaja (viranomainen)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">häradsskrivare (myndighet)</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används om person som fungerar i myndighetsställning och som institution.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään viranomaisasemassa toimivasta henkilöstä, jonka tulkitaan toimivan yhteisönä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4747">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p22408"/>
    <skos:definition xml:lang="sv">Samarbetsorganisation bildad av församlingar i Evangelisk-lutherska kyrkan i Finland eller Ortodoxa kyrkan i Finland, som sköter bestämda uppgifter för församlingarnas del.</skos:definition>
    <skos:definition xml:lang="fi">Suomen evankelis-luterilaisen kirkon tai Suomen ortodoksisen kirkon seurakuntien muodostama yhteistyöorganisaatio, joka hoitaa sen perussäännössä määritellyt tehtävät seurakuntien puolesta (Wikipedia).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kyrklig samfällighet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">seurakuntayhtymä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4748">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ridderskap</skos:altLabel>
    <skos:altLabel xml:lang="fi">ritaristo</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5956"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Hengellinen ritarikunta on uskonnollinen ja kirkon tai uskonnollisen yhteisön hallinnoima, ristiretkien aikana syntynyt järjestö, jonka jäsenet noudattivat ritarikunnan sääntöjä (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. En andlig riddarorden var en organisation styrd av kyrkan eller ett annnat religiöst samfund, som uppstod under korstågstiden.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">riddarorden</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ritarikunta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4749">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fältsjukhus</skos:altLabel>
    <skos:altLabel xml:lang="fi">kenttäsairaala</skos:altLabel>
    <skos:altLabel xml:lang="sv">soldatsjukhus</skos:altLabel>
    <skos:altLabel xml:lang="fi">sotilassairaala</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4673"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1665"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1666"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1667"/>
    <skos:definition xml:lang="sv">Enhet för medicinalvård under krigstid.</skos:definition>
    <skos:definition xml:lang="fi">Sodanaikainen lääkintähuoltoyksikkö.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">krigssjukhus</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sotasairaala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4750">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3884"/>
    <skos:definition xml:lang="sv">Militär enhet som består av stab och vanligen armékårer, som vidare är indelade i divisioner eller brigader.</skos:definition>
    <skos:definition xml:lang="fi">Sotatoimiyhtymä, joka koostuu esikunnasta ja yleensä armeijakunnista, jotka on edelleen jaettu divisiooniin tai prikaateihin (Wikipedia).</skos:definition>
    <skos:example xml:lang="fi">Kannaksen armeija</skos:example>
    <skos:example xml:lang="sv">Näsets armé</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">armeija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">armé</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4751">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p16678"/>
    <skos:definition xml:lang="sv">Administrativ enhet vid universitet eller annan höskola.</skos:definition>
    <skos:definition xml:lang="fi">Yliopiston tai muun korkeakoulun hallinnollinen perusyksikkö (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fakultet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tiedekunta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4752">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">merimieshuonelaitos</skos:altLabel>
    <skos:definition xml:lang="fi">Merimieshuoneet välittivät työtä laivoille, varmistivat oikean suuruisen palkan maksamisen sekä maksoivat eläkettä ja avustuksia työkyvyttömille ja vanhoille merimiehille ja heidän perheilleen. Suomessa merimieshuoneita toimi 1752-1937. (Arkistojen portti.)</skos:definition>
    <skos:definition xml:lang="sv">Sjömanshus förmedlade arbete till sjöfarten, kontrollerade att rätt löner betalades, och betalade ut pensioner och stöd till arbetsoförmögna och gamla sjömän och deras familjer. I Finland verkade sjömanshus åren 1752-1937.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">merimieshuone</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sjömanshus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4753">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m400"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p19581"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sinfoniaorkesteri</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">symfoniorkester</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4754">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">domsaga</skos:altLabel>
    <skos:altLabel xml:lang="fi">elinkeinopiiri</skos:altLabel>
    <skos:altLabel xml:lang="fi">kutsuntapiiri</skos:altLabel>
    <skos:altLabel xml:lang="sv">militärdistrikt</skos:altLabel>
    <skos:altLabel xml:lang="sv">näringsdistrikt</skos:altLabel>
    <skos:altLabel xml:lang="sv">rajon</skos:altLabel>
    <skos:altLabel xml:lang="fi">rajoni</skos:altLabel>
    <skos:altLabel xml:lang="fi">rajooni</skos:altLabel>
    <skos:altLabel xml:lang="sv">skyddskårsdistrikt</skos:altLabel>
    <skos:altLabel xml:lang="fi">sotilaspiiri</skos:altLabel>
    <skos:altLabel xml:lang="fi">suojeluskuntapiiri</skos:altLabel>
    <skos:altLabel xml:lang="fi">tiepiiri</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuomiokunta (tuomiopiiri)</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppbådskrets</skos:altLabel>
    <skos:altLabel xml:lang="sv">vattendistrikt</skos:altLabel>
    <skos:altLabel xml:lang="fi">vesipiiri</skos:altLabel>
    <skos:altLabel xml:lang="sv">vägdistrikt</skos:altLabel>
    <skos:definition xml:lang="fi">Aluehallinnon yksikkö tai sen toimialue, jota kutsutaan piiriksi.</skos:definition>
    <skos:definition xml:lang="sv">Enhet eller verksamhetsområde för regional förvaltning.</skos:definition>
    <skos:example xml:lang="sv">Savolax väg- och vattendistrikt; Kajanalands näringsdistrikt; Uleåborgs skyddskårsdistrikt; Piippola domsaga</skos:example>
    <skos:example xml:lang="fi">Savon tie- ja vesipiiri; Kainuun elinkeinopiiri; Oulun suojeluskuntapiiri; Piippolan tuomiokunta; Viipurin posti- ja lennätinpiiri; Jyväskylän asutuspiiri</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">distrikt (förvaltningsområde)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piiri (hallintoalue)</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4881"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4882"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4884"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4885"/>
    <skos:scopeNote xml:lang="sv">Kan användas utöver en vald kategori av institution för att precisera att den offentligrättsliga institutionen i fråga är en organisation på distriktsnivå. &#xD;
&#xD;
Om liknande förvaltningsenhet i flera engelskspråkiga länder används termen [http://urn.fi/URN:NBN:fi:au:mts:m4884]. Om myndighet som ledde ett länsmansdistrikt används den historiska termen [http://urn.fi/URN:NBN:fi:au:mts:m4724] som kategori av institution.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää valitun yhteisön kategorian lisäksi täsmentämään, että ko. julkishallinnollinen yhteisö on piiritason organisaatio.&#xD;
&#xD;
Suomen kielessä yleisesti piirikunniksi kutsutuista useiden maiden aluehallinnon yksiköistä käytä termiä [http://urn.fi/URN:NBN:fi:au:mts:m4884]. Nimismiespiiriä johtaneesta  viranomaisesta käytä yhteisön kategorian historiallista termiä [http://urn.fi/URN:NBN:fi:au:mts:m4724].</skos:scopeNote>
  </owl:Class>
