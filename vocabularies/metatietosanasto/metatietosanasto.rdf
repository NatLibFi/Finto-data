    <skos:prefLabel xml:lang="fi">sisar</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">syster</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1307">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
