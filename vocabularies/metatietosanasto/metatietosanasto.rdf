    <skos:altLabel xml:lang="sv">illuminator (person)</skos:altLabel>
    <skos:altLabel xml:lang="sv">illuminatör</skos:altLabel>
    <skos:altLabel xml:lang="fi">illuminoinnin tekijä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5285"/>
    <skos:definition xml:lang="fi">Henkilö, joka koristelee yksittäisen kappaleen käyttäen jalometalleja tai värejä, usein yksityiskohtaisissa kuvioissa tai motiiveissa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som dekorerar ett enskilt exemplar genom att använda ädelmetaller eller färger, ofta i detaljerade mönster eller motiv.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40100"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">illuminator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">illuminator person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">illuminoinnin tekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5862">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
