    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3441"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3554"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m575"/>
    <skos:prefLabel xml:lang="en">adapted as work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mukaelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">omarbetning</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Omfattar både ändringar som gäller formen för ett verk och helt omarbetade verk i samma form.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tämä elementti soveltuu muutoksiin muodossa tai samassa muodossa kokonaan uudelleenmuokattuihin teoksiin. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m744">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Ett eller flera inbundna eller häftade blad, som tillsammans utgör en separat enhet.</skos:definition>
    <skos:definition xml:lang="fi">Yksi tai useampia toisiinsa sidottuja tai kiinnitettyjä lehtiä, joista muodostuu erillinen yksikkö.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1049"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">volume</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">volym</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ilman laitetta käytettävä tallenne.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omedierad bärare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m746">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">affiliation of</skos:altLabel>
    <skos:altLabel xml:lang="sv">medlem</skos:altLabel>
    <skos:altLabel xml:lang="en">member</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5336"/>
    <skos:definition xml:lang="fi">Henkilö, joka on yhteisön jäsen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är medlem i en institution.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50030"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
