    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5467"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen kieliyleisöä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra den språkliga målgruppen för ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10385"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
