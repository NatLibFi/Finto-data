    <skos:prefLabel xml:lang="en">disc master</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">originaalilevy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">originalskiva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1034">
