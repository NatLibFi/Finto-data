    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">högkvarter</skos:altLabel>
    <skos:altLabel xml:lang="fi">päämaja</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40168"/>
    <skos:definition xml:lang="fi">Asevoimien johto-organisaatio, joka toimii komentajan apuna (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Ledningsorganisation för väpnade styrkor, som biträder kommendören.</skos:definition>
    <skos:example xml:lang="fi">ilmavoimien esikunta</skos:example>
    <skos:example xml:lang="fi">maavoimien esikunta</skos:example>
    <skos:example xml:lang="fi">merivoimien esikunta</skos:example>
    <skos:example xml:lang="sv">staben för landstridskrafterna</skos:example>
    <skos:example xml:lang="sv">staben för luftstridskrafterna</skos:example>
    <skos:example xml:lang="sv">staben för sjöstridskrafterna</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esikunta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stab</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4727">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kronomagasin</skos:altLabel>
    <skos:altLabel xml:lang="fi">kruuunmakasiini</skos:altLabel>
    <skos:altLabel xml:lang="fi">lainajyvästö</skos:altLabel>
    <skos:altLabel xml:lang="fi">lainamakasiini</skos:altLabel>
    <skos:altLabel xml:lang="sv">länsmagasin</skos:altLabel>
    <skos:altLabel xml:lang="fi">lääninmakasiini</skos:altLabel>
    <skos:altLabel xml:lang="sv">lånemagasin</skos:altLabel>
    <skos:altLabel xml:lang="fi">pitäjänmakasiini</skos:altLabel>
    <skos:altLabel xml:lang="sv">sockenmagasin</skos:altLabel>
    <skos:altLabel xml:lang="sv">spannmålslager</skos:altLabel>
    <skos:altLabel xml:lang="sv">spannmålsmagasin (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">viljamakasiini</skos:altLabel>
    <skos:altLabel xml:lang="fi">viljavarasto (yhteisötyyppi)</skos:altLabel>
    <skos:definition xml:lang="sv">Inrättning som regionalt eller lokalt hade hand om att förvara spannmål och utsäde, för eventuella nödår.</skos:definition>
    <skos:definition xml:lang="fi">Katovuosien varalta alueellisesti tai paikallisesti syömä- ja siemenviljan tallettamisesta huolehtinut laitos.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">spannmålsmagasin</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">viljavarasto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4728">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">laboratorio (laboratoriopalvelu)</skos:altLabel>
    <skos:altLabel xml:lang="sv">laboratorium (laboratorietjänster)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p8598"/>
    <skos:definition xml:lang="sv">Inrättning eller avdelning som erbjuder laboratorietjänster inom hälso- och sjukvård.</skos:definition>
    <skos:definition xml:lang="fi">Laitos tai osasto, joka tarjoaa terveydenhuollon laboratoriopalveluita.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
