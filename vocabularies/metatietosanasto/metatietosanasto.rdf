  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3948">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Tidigare hörde husföreståndarinnor till det ansedda tjänstefolket som hade underordnade. Numera används termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2985'&gt;hemvårdare&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vanh. Ennen emännöitsijä kuuluu arvostettuun palvelusväkeen, jolla oli alaisia. Nykyisin käytettävä termi on &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2985'&gt;kodinhoitaja&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">emännöitsijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">husföreståndarinna</skos:prefLabel>
    <skos:prefLabel xml:lang="en">matron</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3949">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
