    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3463"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3465"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3466"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3468"/>
