    <skos:prefLabel xml:lang="fi">kappale kokoelmassa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5678">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelande aktör (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen taltioija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää ääntä tai videota tallennuslaitteen avulla taltioiva yhteisö. Esimerkiksi luonnonäänten, folkloren, musiikin tms. kenttätallennukset.</skos:definition>
    <skos:definition xml:lang="sv">Institution som spelar in ljud eller video som ingår ett aggregat, med hjälp av en inspelningsapparat. T.ex. fältinspelningar av naturljud, folklore, musik eller dylikt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelande institution</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taltioija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5679">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">animaattori (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">animatör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i skapandet av ett uttryck genom att ge skenbar rörelse åt livlösa objekt eller teckningar.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20512"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">animaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="en">animator corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">animatör</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske animaatiopiirrosten tekijää. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte skapare av animationsteckningar.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m568">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tvärsektion</skos:altLabel>
    <skos:definition xml:lang="sv">Enhet som är en skalenlig framställning av en vertikal yta, vanligen ett plan, och som visar både profilen där den genomskär en himlakropps yta, eller en konceptuell modell, och de underliggande strukturerna längs det genomskurna planet.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö on mittakaavassa ja tavallisesti tasossa esitetty pystysuora pinta, joka kuvaa sekä taivaankappaleen pinnan tai käsitteellisen mallin poikkileikkaavan profiilin että poikkaleikatun tason alla olevat kerrokset.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1035"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">poikkileikkaus</skos:prefLabel>
    <skos:prefLabel xml:lang="en">section</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tvärsnitt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5680">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5439"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen toimija, joka on luonut aggregaattiin sisältyvän liikkuvan kuvan teoksen ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Aktör som bidragit till ett aggregat, genom att skapa ett uttryck av ett verk med rörlig bild, som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30326"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent of moving image</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvaan kuvaan osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5681">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bokkonstnär (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjataiteilija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5267"/>
    <skos:definition xml:lang="fi">Henkilö, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en konstnär, som svarar för utnyttjande av bokens form eller ändring av dess fysiska struktur.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10428"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bokkonstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="en">book artist person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjataiteilija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5682">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">composer (expression)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kompositör (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">säveltäjä (ekspressio)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5439"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen toimija, joka on luonut aggregaattiin sisältyvän musiikkiteoksen ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Aktör som bidragit till ett aggregat och skapat ett musikverks uttryck som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30311"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till musik</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent of music</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikkiin osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5683">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
