    <skos:prefLabel xml:lang="sv">flygvapnet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ilmavoimat</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4927">
