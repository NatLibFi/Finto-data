    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5509"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5785"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5877"/>
    <skos:prefLabel xml:lang="fi">Henkilön suhteet yhteisöön</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Personers relationer till institutioner</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5807">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5948"/>
    <skos:altLabel xml:lang="en">critiqued in (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kritik av manifestationen i</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation kritiikki</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5707"/>
    <skos:definition xml:lang="fi">Teos, joka on kriittinen arviointi manifestaatiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en kritisk bedömning av en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30257"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston kritiikki</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kritik av materialet i</skos:prefLabel>
    <skos:prefLabel xml:lang="en">manifestation critiqued by</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5808">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">färgläggare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen värittäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän liikkuvan kuvan värityksen yhteisötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Institution som färglagt rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">färgläggare av rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan värittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5809">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelningstekniker (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">äänittäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5540"/>
    <skos:definition xml:lang="fi">Henkilö, joka on ääniteknikko, joka osallistuu ekspression äänisisällön tekemiseen valvomalla äänityksen teknistä toteutusta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en ljudtekniker, som deltar i utförandet av ljudinnehållet i ett uttryck, genom att övervaka det tekniska utförandet av en ljudinspelning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20386"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelningstekniker</skos:prefLabel>
    <skos:prefLabel xml:lang="en">recording engineer person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m581">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Tanssivan karhun kääntäjä -palkinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">Översättarbjörnen-priset</skos:altLabel>
    <skos:definition xml:lang="sv">Pris för årets bästa översättning. Utdelat sedan år 1994.</skos:definition>
    <skos:definition xml:lang="fi">Vuoden paras käännöskokoelma. Jaettu vuodesta 1994 alkaen.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Översättarbjörnen, 2018</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Kääntäjäkarhu-palkinto, 2018</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Kääntäjäkarhu-palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Översättarbjörnen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5810">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">annan aktör relaterad till exemplaret</skos:altLabel>
    <skos:altLabel xml:lang="fi">kappaleeseen liittyvä muu toimija</skos:altLabel>
    <skos:altLabel xml:lang="en">other agent associated with item</skos:altLabel>
    <skos:definition xml:lang="sv">Aktör som relaterar till ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka liittyy kappaleeseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40072"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1765"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2178"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4467"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4469"/>
    <skos:prefLabel xml:lang="sv">aktör relaterad till exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleeseen liittyvä toimija</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related agent of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5811">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvatuottaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmproducent (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5326"/>
    <skos:definition xml:lang="sv">Institution som är en producent, som svarar för största delen av affärsverksamheten kring en filmproduktion.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10516"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvatuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">film producer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmproducent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5812">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljudtekniker (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ääniteknikko (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att sköta de tekniska aspekterna på ljud under inspelnings-, mixnings- och ljudåtergivningsprocesser.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen huolehtimalla äänen teknisistä näkökohdista äänitys-, miksaus- ja äänentoistoprosessien aikana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20466"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio engineer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudtekniker</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääniteknikko</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5813">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmfotograf (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som spelar in bilder antingen digitalt, på film eller på video, och ofta väljer och arrangerar belysningen.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10509"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">director corporate body of photography</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmfotograf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5814">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5097"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen henkilö, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat och skapat ett uttryck av ett textverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30344"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (person) till text</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor person of text</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstiin osallinen henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5815">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">painaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5937"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa painetun tekstin, nuottiaineiston tai muun sisällön manifestaation valmistamisesta painolaatalta tai -levyltä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av tryckt text, notmaterial eller något annat innehålls manifestation, med tryckplåt eller dylikt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30358"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">painaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">printer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Omfattar tillverkning av böcker, dagstidningar, tidskrifter, planscher eller partitur.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää kirjan, sanomalehden, aikakauslehden, julisteen tai partituurin valmistuksen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5816">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvantekijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmskapare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av en självständig eller personlig film.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10450"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvantekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">filmmaker person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmskapare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Skaparen svarar själv till alla delar för idén till och förverkligandet av filmen.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5817">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">producent (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuottaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för största delen av de kommersiella uppgifterna kring en film-, ljudupptagnings-, tv-, streaming- eller dylik produktion.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10454"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">producent</skos:prefLabel>
    <skos:prefLabel xml:lang="en">producer person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuottaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En producent svarar typiskt för skaffande av finansiering, ledning av produktion, anställning av nyckelpersonal, ordning av distributörer etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5818">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5462"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m783"/>
    <skos:definition xml:lang="fi">Teos, jota täydentää teos, joka on tekstiteos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som kompletteras av ett verk som är ett textverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10372"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3490"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3497"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3516"/>
    <skos:prefLabel xml:lang="fi">teksti teokseen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">text for work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">text till verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5819">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen käsikirjoittaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">manusförfattare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän käsikirjoituksen tai kohtauksen kirjoittanut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som skrivit ett manus eller en scen som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">käsikirjoittaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">manusförfattare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m582">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Layout som fortsätter i samma skala på båda sidorna av ett ark.</skos:definition>
    <skos:definition xml:lang="fi">Layout, joka jatkuu samassa mittakaavassa arkin tai arkkien molemmilla puolilla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">both sides</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">molemmilla puolilla</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">på båda sidorna</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5820">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kommentaattori (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommentator (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare som deltar i skapandet av ett uttryck, genom att tolka, analysera eller diskutera ett ämne i en ljudupptagning, en film eller annat audiovisuellt material.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20495"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">commentator corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kommentaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentator</skos:prefLabel>
  </owl:Class>
