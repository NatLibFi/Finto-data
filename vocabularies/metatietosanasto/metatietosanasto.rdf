    <skos:altLabel xml:lang="fi">esittäjä (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">esittäjä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">framförare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">performer</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett verk genom att framföra musik, skådespela, dansa, tala, eller fungera i andra roller, ofta i ett musikaliskt eller dramatiskt framförande.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu teoksen ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla tai muissa rooleissa usein musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20039"/>
