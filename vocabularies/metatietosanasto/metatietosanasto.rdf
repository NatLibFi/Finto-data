    <skos:definition xml:lang="sv">Förminskningsgrad för material i mikroform, då förhållandet till den ursprungliga bilden är 61x-90x.</skos:definition>
    <skos:definition xml:lang="fi">Pienennyssuhde mikromuotoiselle aineistolle, kun suhde alkuperäiseen kuvaan on 61x–90x.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAReductionRatio/1004"/>
