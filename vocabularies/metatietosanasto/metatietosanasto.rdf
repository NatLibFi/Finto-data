    <skos:prefLabel xml:lang="en">image file</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvatiedosto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1175">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">I djuptrycksmetoden ligger den tryckande delen lägre ner än den otryckta ytan. Tryckfärgen överförs till det tryckta materialet ur rasterkoppar, alltså fördjupningar i tryckytan.</skos:definition>
    <skos:definition xml:lang="fi">Syväpainomenetelmässä painopinnan painava osa on painamatonta pintaa alempana. Painoväri siirtyy painettavaan materiaaliin rasterikupeista eli painopinnan syvennyksistä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">djuptryck</skos:prefLabel>
    <skos:prefLabel xml:lang="en">intaglio</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">syväpainomenetelmä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1176">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Brusreduceringssystem för analogt inspelat ljud, utvecklat av CBS Laboratories i slutet av 1970-talet.</skos:definition>
    <skos:definition xml:lang="fi">CBS Laboratoriesin 1970-luvun lopulla kehittämä melunvaimennusjärjestelmä analogisesti tallennetulle äänelle.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/specPlayback/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">CX</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">CX</skos:prefLabel>
    <skos:prefLabel xml:lang="en">CX encoded</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1178">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">GIF</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">GIF</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1189">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">anim. (animaattori)</skos:altLabel>
    <skos:altLabel xml:lang="fi">animaattori (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">animaattori (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">animator</skos:altLabel>
    <skos:altLabel xml:lang="sv">animatör (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">animatör (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i skapandet av ett uttryck genom att ge skenbar rörelse åt livlösa objekt eller teckningar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20028"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">animaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="en">animator agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">animatör</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske animaatiopiirrosten tekijää. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte skapare av animationsteckningar.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1190">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Lagringsmedium, i vilket en kombination av laservärmning och varierande magnetfält används för att skriva data på en skiva.</skos:definition>
    <skos:definition xml:lang="fi">Tallennusmedia, jossa käytetään laserkuumennuksen ja vaihtelevan magneettikentän yhdistelmää datan kirjoittamiseksi levylle.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/recMedium/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">magnet-optisk</skos:prefLabel>
    <skos:prefLabel xml:lang="en">magneto-optical</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">magneto-optinen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1192">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">pappismunkki (arvonimi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">prästmunk (hederstitel)</skos:altLabel>
    <skos:definition xml:lang="fi">Ortodoksisessa kirkossa papiksi vihitty munkki.</skos:definition>
    <skos:definition xml:lang="sv">Prästvigd munk i ortodoxa kyrkan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">pappismunkki</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">prästmunk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1193">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">lighting designer</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljusdesigner (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valosuunnittelija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att planera och skapa ljuskomponenter.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen suunnittelemalla ja luomalla valokomponentteja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20277"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">lighting designer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljusdesigner</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valosuunnittelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1201">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">puhuja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">speaker</skos:altLabel>
    <skos:altLabel xml:lang="sv">talare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i utförandet av ett verks uttryck genom att tala ord.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu teoksen ekspression tekemiseen puhumalla sanoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20024"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puhuja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">speaker agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">talare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Inbegriper en föreläsning eller ett tal.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää luennon tai puheen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1202">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kasett som innehåller slingartad film.</skos:definition>
    <skos:definition xml:lang="fi">Kasetti, joka sisältää silmukkamaisen elokuvafilmin.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1032"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">film cartridge</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">filmisilmukkakasetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmmagasin</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Bärare för projicerbara bilder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Heijastettava kuvatallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1203">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p14340"/>
    <skos:example xml:lang="fi">F19 (rykmentti)</skos:example>
    <skos:example xml:lang="sv">IR 61:an (regemente)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">regemente</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rykmentti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1205">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arr. (arrangör av musikalisk komposition)</skos:altLabel>
    <skos:altLabel xml:lang="en">arranger of music</skos:altLabel>
    <skos:altLabel xml:lang="sv">arrangör av musikalisk komposition (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">arrangör av musikalisk komposition (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikin sovittaja</skos:altLabel>
    <skos:altLabel xml:lang="fi">sov. (sovittaja)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sovittaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sovittaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5705"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett verks uttryck, genom att omarbeta kompositionen för en musikalisk besättning som avviker från originalverket.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu teoksen ekspression tekemiseen muokkaamalla sävellyksen alkuperäisteoksesta poikkeavalle esityskokoonpanolle. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20029"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">arranger agent of music</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">arrangör av musikalisk komposition</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En arrangör kan också bearbeta verket för samma musikaliska besättning eller dylikt och bevara originalkompositionens musikaliska innehåll till sina väsentliga delar oförändrade. I detta ingår inte omfattande ändringar som leder till skapandet av ett nytt musikverk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sovittaja voi myös muokata teosta samalle esityskokoonpanolle tms. säilyttäen alkuperäisen sävellyksen musiikillisen sisällön olennaisilta osin muuttumattomana. Tähän ei sisälly laaja muokkaaminen, joka johtaa uuden musiikkiteoksen luomiseen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1207">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Filmirulla, joka koostuu sarjasta kuvia, jotka esitetään yksitellen. Voi sisältää myös ääntä.</skos:definition>
    <skos:definition xml:lang="sv">Filmlängd innehållande en följd av bilder avsedda för visning en i taget som stillbilder. Kan även innehålla ljud.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1036"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bildband</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">raina</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Bärare för projicerbara bilder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Heijastettava kuvatallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1209">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Förminskningsgrad för material i mikroform, som är mindre än 16x.</skos:definition>
    <skos:definition xml:lang="fi">Pienennyssuhde mikromuotoiselle aineistolle, joka on pienempi kuin 16x.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAReductionRatio/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">low reduction</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">låg förminskning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vähäinen pienennys</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m121">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m551"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/a/P50110"/>
    <skos:definition xml:lang="en">A word or phrase indicative of royalty, nobility, rank, honour, or office, or a term of address for a person of religious vocation.</skos:definition>
    <skos:definition xml:lang="sv">Ord eller fras som påvisar kunglig eller adlig titel, kyrkligt ämbete eller kyrklig ställning, eller annan titel i anslutning till religiös uppgift.</skos:definition>
    <skos:definition xml:lang="fi">Sana tai ilmaus, joka osoittaa kuninkaallista tai aatelisarvoa, kirkollista virkaa tai asemaa tai uskonnolliseen tehtävään liittyvää puhuttelua.</skos:definition>
    <skos:prefLabel xml:lang="sv">hederstitel</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">henkilön arvonimi tai asema</skos:prefLabel>
    <skos:prefLabel xml:lang="en">term of rank or honour or office</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1211">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">editor of moving image work</skos:altLabel>
    <skos:altLabel xml:lang="sv">klippare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">leikk. (leikkaaja)</skos:altLabel>
    <skos:altLabel xml:lang="fi">leikkaaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">redigerare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som svarar för samling, ordnande och klippning av film, video eller andra format för rörlig bild, både beträffande bild och ljud.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20055"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editor agent of moving image work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">klippare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">leikkaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1212">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, kort med tryckta ord, siffror och/eller bilder som används för att förverkliga en särskild aktivitet. (eng. activity card)</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kortti, johon on painettu sanoja, numeroita, tai/ja kuvia, ja jota käytetään tietyn toiminnan toteuttamisessa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">activity card</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aktivitetskort</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimintakortti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1216">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">producent av radioprogram</skos:altLabel>
    <skos:altLabel xml:lang="en">radio producer</skos:altLabel>
    <skos:altLabel xml:lang="sv">radioproducent (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">radiotuottaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1298"/>
    <skos:definition xml:lang="sv">Aktör som är en producent, som svarar för största delen av affärsverksamheten kring ett radioprogram.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10074"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">radio producer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">radioproducent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">radiotuottaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1218">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, kartografisk resurs som är en geografisk representation av numerisk data eller händelser, processer eller verkningar.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kartta-aineisto, joka on numeerisen tiedon tai jonkin tapahtuman tai prosessin etenemisen tai vaikutusten maantieteellinen esitysmuoto.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">diagram</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">diagram</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">diagrammi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m122">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Benämning på manlig medlem i munkorden.</skos:definition>
    <skos:definition xml:lang="fi">Munkkikunnan miespuolinen jäsenen nimitys.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">broder</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">veli</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1224">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Spole med videoband, avsedd att användas i rullbandspelare.</skos:definition>
    <skos:definition xml:lang="fi">Videonauhan sisältävä avokela, jota käytetään videokelanauhurilla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1053"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">videokela</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">videospole</skos:prefLabel>
    <skos:prefLabel xml:lang="en">videotape reel</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Videobärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Videotallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1226">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30206"/>
    <skos:altLabel xml:lang="sv">Typ av lagringsmedium för ljud</skos:altLabel>
    <skos:definition xml:lang="fi">Liittää manifestaation menetelmään, jolla ääni tallennetaan äänitteelle.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med metod för inspelning av ljud på ett lagringsmedium.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1035"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1190"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m955"/>
    <skos:prefLabel xml:lang="sv">Inspelningssätt</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Recording medium</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Äänen tallennusmedian tyyppi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1228">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3432"/>
    <skos:altLabel xml:lang="fi">televisiosovituksen perustana</skos:altLabel>
    <skos:altLabel xml:lang="fi">televisiosovituksen perustana (teos)</skos:altLabel>
    <skos:altLabel xml:lang="fi">televisioversion perustana</skos:altLabel>
    <skos:altLabel xml:lang="fi">televisioversion perustana (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-bearbetning baserad på</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-bearbetning baserad på (verk)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-version baserad på</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-version baserad på (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1399"/>
    <skos:definition xml:lang="fi">Teos, joka on sovitettu televisio-ohjelmaksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har bearbetats till ett tv-program.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10132"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">television adaptation of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">televisiosovitus teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-bearbetning av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1229">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Brusreduceringssystem som är en kombinerad version av Dolby-A och Dolby-B avsedd för användning i analogt magnetband, utvecklat av Dolby Laboratories år 1980.</skos:definition>
    <skos:definition xml:lang="fi">Dolby Laboratoriesin vuonna 1980 kehittämä melunvaimennusjärjestelmä, joka on Dolby-A:n ja Dolby-B:n yhdistetty versio käytettäväksi analogisessa magneettinauhassa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/specPlayback/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Dolby C</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Dolby C</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Dolby-C encoded</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1233">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, tvådimensionell stillbild.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kaksiulotteinen liikkumaton kuva.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1026"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">picture</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1235">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p28870"/>
    <skos:definition xml:lang="fi">Arvoltaan patriarkan ja arkkipiispan välinen ortodoksinen piispa; katolisessa kirkossa arkkipiispasta.</skos:definition>
    <skos:definition xml:lang="sv">Ortodox biskop mellan patriark och ärkebiskop i rang; i katolska kyrkan om ärkebiskop.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">metropoliitta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">metropolit</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1236">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Magasin som innehåller datorband.</skos:definition>
    <skos:definition xml:lang="fi">Silmukkamaisen tietonauhan sisältävä kasetti.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">computer tape cartrigde</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">datorbandmagasin</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tietonauhan silmukkakasetti</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Datorbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tietokonetallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1237">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">täckfärg</skos:altLabel>
    <skos:definition xml:lang="fi">Materiaali, joka koostuu väriaineesta ja sideaineesta, johon on toisinaan lisätty myös kiinteää ainetta. Muodostaa läpinäkymättömän, värillisen, vesiliukoisen pinnan.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av färg- och bindemedel, i vilket ibland även ett fast ämne tillfogats. Bildar en ogenomskinlig, vattenlöslig yta i färg.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">gouache</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gouache</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">guassi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1238">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">QuickTime</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">QuickTime</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1239">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30199"/>
    <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiossa esiintyvien merkkien sekä symbolien kokoon.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med storleken på tecken och symboler som förekommer i manifestationen.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m10"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m96"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m982"/>
    <skos:prefLabel xml:lang="en">Font size</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kirjasinkoko</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Teckenstorlek</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Jos aineiston kirjasinkoko on tarkoitettu näkövammaisille, merkitään kirjasinkoko käyttämällä soveltuvaa termiä seuraavasta luettelosta:</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om resursens teckenstorlek är avsedd för synskadade, anges denna genom att använda en lämplig term från följande lista:</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1241">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">actor</skos:altLabel>
    <skos:altLabel xml:lang="fi">näytt. (näyttelijä)</skos:altLabel>
    <skos:altLabel xml:lang="fi">näyttelijä (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">näyttelijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skåd. (skådespelare)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skådespelare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skådespelare (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i utförandet av ett uttryck, genom att skådespela i ett musikaliskt eller dramatiskt uppförande.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen näyttelemällä musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m17"/>
    <skos:prefLabel xml:lang="en">actor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">näyttelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skådespelare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1247">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">andelsaffär</skos:altLabel>
    <skos:altLabel xml:lang="sv">andelsförening</skos:altLabel>
    <skos:altLabel xml:lang="sv">andelshandel</skos:altLabel>
    <skos:altLabel xml:lang="sv">andelskassa</skos:altLabel>
    <skos:altLabel xml:lang="sv">andelsmejeri</skos:altLabel>
    <skos:altLabel xml:lang="sv">arbetsandelslag</skos:altLabel>
    <skos:altLabel xml:lang="fi">asunto-osuuskunta</skos:altLabel>
    <skos:altLabel xml:lang="sv">bostadsrättsförening</skos:altLabel>
    <skos:altLabel xml:lang="sv">kooperativ</skos:altLabel>
    <skos:altLabel xml:lang="sv">kooperativ förening</skos:altLabel>
    <skos:altLabel xml:lang="fi">osuuskassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">osuuskauppa</skos:altLabel>
    <skos:altLabel xml:lang="fi">osuusliike</skos:altLabel>
    <skos:altLabel xml:lang="fi">osuusmeijeri</skos:altLabel>
    <skos:altLabel xml:lang="fi">työosuuskunta</skos:altLabel>
    <skos:altLabel xml:lang="sv">vattenandelslag</skos:altLabel>
    <skos:altLabel xml:lang="fi">vesiosuuskunta</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m941"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11631"/>
    <skos:definition xml:lang="sv">Bolagsform som definieras i lagen om andelslag, och vars medlemsantal och kapital är på förhand obestämda. Syftet med ett andelslags verksamhet är att i avsikt att stödja medlemmarnas ekonomi eller näringsutövning driva ekonomisk verksamhet så att medlemmarna nyttjar andelslagets tjänster eller tjänster som andelslaget tillhandahåller med hjälp av en dottersammanslutning eller på annat sätt.</skos:definition>
    <skos:definition xml:lang="fi">Yhtiömuoto, joka määritellään osuuskuntalaissa. Osuuskunta on yhteisö, jonka jäsenmäärää ja osuuspääomaa ei ole ennalta määrätty. Osuuskunnan tarkoituksena on jäsenten taloudenpidon tai elinkeinon tukemiseksi harjoittaa taloudellista toimintaa siten, että jäsenet käyttävät hyväkseen osuuskunnan tarjoamia palveluita taikka palveluita, jotka osuuskunta järjestää tytäryhteisönsä avulla tai muulla tavalla (Liiketoimintaontologia).</skos:definition>
    <skos:example xml:lang="sv">Forum Box (andelslag)</skos:example>
    <skos:example xml:lang="fi">Forum Box (osuuskunta)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">andelslag</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">osuuskunta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1249">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">120 kierr./min</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">120 varv/min</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m125">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, jolle on tyypillistä hyvät sähkön- ja lämmönjohto-ominaisuudet, läpinäkymättömyys, ominaisuuksiin kuuluvat myös kiilto, helppo sulatettavuus ja muokattavuus ja taottavuus.</skos:definition>
    <skos:definition xml:lang="sv">Material för vilket god ström- och värmeledning, opacitet, glans, smältbarhet, formbarhet och smidbarhet är typiska.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1022"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">metal</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">metall</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">metalli</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1259">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka kuulee ja päättää oikeusasioista tuomioistuimessa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som hör och fattar beslut om juridiska saker i en domstol.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10044"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">domare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">judge</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuomari</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1260">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
