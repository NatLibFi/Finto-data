    <skos:prefLabel xml:lang="fi">Litaniat</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Litanior</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1972">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
