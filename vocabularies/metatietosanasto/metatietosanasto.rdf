    <skos:altLabel xml:lang="fi">erityishuoltopiiri</skos:altLabel>
    <skos:altLabel xml:lang="fi">kansanterveystyön kuntayhtymä</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommunalförbund</skos:altLabel>
    <skos:altLabel xml:lang="fi">koulutuskuntayhtymä</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuntainliitto</skos:altLabel>
    <skos:altLabel xml:lang="sv">landskapsförbund</skos:altLabel>
    <skos:altLabel xml:lang="fi">maakuntaliitto</skos:altLabel>
    <skos:altLabel xml:lang="sv">regionplaneförbund</skos:altLabel>
    <skos:altLabel xml:lang="fi">sairaanhoitopiiri</skos:altLabel>
    <skos:altLabel xml:lang="sv">samkommun för social- och hälsovård</skos:altLabel>
    <skos:altLabel xml:lang="fi">seutukaavaliitto</skos:altLabel>
    <skos:altLabel xml:lang="sv">sjukvårdsdistrikt</skos:altLabel>
    <skos:altLabel xml:lang="fi">sosiaali- ja terveyskuntayhtymä</skos:altLabel>
    <skos:altLabel xml:lang="sv">specialomsorgsdistrikt</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p719"/>
    <skos:definition xml:lang="fi">Kuntien muodostama yhteenliittymä, joka hoitaa määrättyjen toimien tehtäviä siihen liittyneiden kuntien puolesta.</skos:definition>
    <skos:definition xml:lang="sv">Sammanslutning bildad av kommuner, som sköter bestämda uppgifter för kommunerna som är inkluderade.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuntayhtymä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">samkommun</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4778"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5054"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4704">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arbets- och korrektionsinrättning</skos:altLabel>
    <skos:altLabel xml:lang="sv">arbetsanstalt</skos:altLabel>
    <skos:altLabel xml:lang="sv">arbetsläger</skos:altLabel>
    <skos:altLabel xml:lang="sv">korrektionsinrättning</skos:altLabel>
    <skos:altLabel xml:lang="fi">ojennuslaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">työ- ja ojennuslaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">työleiri</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p4104"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Huoltolaitos, johon voitiin määrätä työhön sijoitettavaksi irtolaislainsäädännön nojalla ja myöhemmin kunnan myöntämän huoltoavun korvaamiseksi. Myös työleiri, johon vuodesta 1934 sijoitettiin ehdonalaiseen vapauteen päässeitä henkilöitä.</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Anstalt på vilken personer kunde placeras utgående från lösdriverilagstiftningen, och senare för att ersätta försörjningsbidrag beviljat av kommuner. Även om arbetsläger i vilka personer som blivit villkorligt frigivna placerades fr.o.m. år 1934.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arbetsinrättning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">työlaitos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4705">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ensikoti</skos:altLabel>
    <skos:altLabel xml:lang="sv">mödrahem</skos:altLabel>
    <skos:altLabel xml:lang="sv">skyddshem</skos:altLabel>
    <skos:altLabel xml:lang="fi">turvakoti</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4668"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p16647"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p18450"/>
    <skos:definition xml:lang="fi">Perheväkivallan uhreja tilapäisesti majoittava asuntola (turvakoti) tai laitos jossa varsinkin yksinhuoltajaäidit lapsineen saavat hoitoa synnytyksen aikoihin (ensikoti) (Kielitoimiston sanakirja).</skos:definition>
    <skos:definition xml:lang="sv">Tillfälligt hem för familjevåldsoffer eller inrättning var särskilt ensamstående mödrar med barn får vård kring tiden för förlossning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">skyddshem/mödrahem</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">turvakoti/ensikoti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4706">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5904"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Suurisuuntainen tuonti- ja vientiliike, jonka toiminimi oli yleensä yhden suvun hallussa.</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Import- och exportrörelse, vars verksamhetsnamn vanligen var i en släkts besittning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">handelshus</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kauppahuone</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4707">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p6636"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Etuoikeutettu suurkaupan yhtymä.</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Priviligerad sammanslutning för omfattande handel.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">handelskompani</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kauppakomppania</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4708">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p7337"/>
    <skos:definition xml:lang="fi">Kiinteä sotilasalue, jonka tehtävänä on palvella sinne sijoitettuja joukkoja, sotilaslaitoksia ja esikuntia (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Permanent militärområde med service för de militära styrkor, anläggningar och staber som är förlagda dit.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">garnison</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">varuskunta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4709">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p17463"/>
    <skos:definition xml:lang="fi">Kirkolliskokous on kirkon ylin päättävä elin, joka päättää kirkon opista (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Kyrkans högsta beslutande organ som besluter om kyrkans läror.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kirkolliskokous</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kyrkomöte</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4710">
