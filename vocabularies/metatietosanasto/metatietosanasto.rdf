    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Megadots</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Megadots</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m994">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Liittää ekspression esittäjään, joka osallistuu teoksen ekspressioon lukemalla tekstin ääneen.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar uttryck med en aktör som deltar i ett uttryck av ett verk, genom att läsa upp text högt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">lukija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppläsare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m997">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">idé, koncept av</skos:altLabel>
    <skos:broadMatch rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Teoksen hahmot yms. perustuvat henkilön aikaisempaan luontiin.</skos:definition>
    <skos:definition xml:lang="sv">Verkets karaktärer etc. grundar sig på en persons tidigare skapelse.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alkuperäisidean luoja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av originalidé</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets skapare</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m999">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">dedicatee</skos:altLabel>
    <skos:altLabel xml:lang="sv">dedikationsmottagare</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen omistuksen kohde (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen omistuskirjoituksen kohde</skos:altLabel>
    <skos:altLabel xml:lang="sv">verket dedicerat till (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5482"/>
    <skos:definition xml:lang="sv">Aktör som tillägnats ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jolle teos on omistettu. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10069"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dedicatee agent of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen omistuksen kohde</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verket dedicerat till</skos:prefLabel>
  </owl:Class>
