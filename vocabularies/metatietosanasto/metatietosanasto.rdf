  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m407">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Levy, jolle on kaiverrettu tai uurrettu modulaatioiksi tai pulsseiksi tallennettuja äänisignaaleja yhtenäiseksi spiraalimaiseksi uraksi.</skos:definition>
    <skos:definition xml:lang="sv">Skiva på vilken ljudsignaler, upptagna som modulationer och pulser e.d., har ristats eller skurits in så att de bildar ett enhetligt spiralformat spår.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio disc</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudskiva</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänilevy</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
