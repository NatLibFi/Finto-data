    <skos:prefLabel xml:lang="en">variant title of item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">varianttitel för exemplaret</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6043">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/e/P20316"/>
    <skos:definition xml:lang="fi">Ekspression nimeke, jota ei ole valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
    <skos:definition xml:lang="sv">Titel för uttryck, som inte har valts till primär i en viss tillämpning eller kontext.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ekspression varianttinimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">variant title of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">varianttitel för uttrycket</skos:prefLabel>
  </owl:Class>
