    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat, genom att skapa ett uttryck av ett verk med rörlig bild, som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30340"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
