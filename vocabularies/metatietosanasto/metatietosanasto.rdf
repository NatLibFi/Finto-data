    <skos:prefLabel xml:lang="sv">libretto till versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">libretto versioon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m428">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Spåregenskap för analog skiva, vars spårbredd typiskt är 120-160 spår/cm eller mer (300 eller 400 spår/tum eller mer). Vanligen pressad i vinyl och i användning efter år 1945.</skos:definition>
    <skos:definition xml:lang="fi">Uran ominaisuus analogiselle levylle, jonka uranleveys on tyypillisesti 120–160 uraa/cm tai enemmän (300 tai 400 uraa/tuuma tai enemmän), tavallisesti puristettuna vinyyliin, käytössä vuoden 1945 jälkeen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/grooveWidth/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
