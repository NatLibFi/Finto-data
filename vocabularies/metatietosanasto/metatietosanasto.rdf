    <skos:prefLabel xml:lang="en">research supervisor</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tutkimuksen ohjaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5913">
