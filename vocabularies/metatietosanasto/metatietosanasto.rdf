    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4323"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m608"/>
    <skos:prefLabel xml:lang="fi">aineistoon liittyvä aineisto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">material relaterat till materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related manifestation of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5857">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
