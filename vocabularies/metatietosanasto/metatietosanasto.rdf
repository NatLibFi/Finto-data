  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5403">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kostymör (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen puvustaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän elokuvan, musiikki- tai näytelmäesityksen puvustuksen suunnitellut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som planerat kostymdesignen i en film, ett musikaliskt eller sceniskt framförande, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kostymör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puvustaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5404">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bidragsgivare (person) till kartografi</skos:altLabel>
    <skos:altLabel xml:lang="fi">kartografiaan osallinen henkilö</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5097"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen henkilö, joka on luonut aggregaattiin sisältyvän kartografisen teoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat, genom att skapa ett uttryck av ett kartografiskt verk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30338"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">contributor person of cartography</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kartantekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kartograf</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5405">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deltagare (institution) i rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallistuja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck av ett icke-fiktivt verk med rörlig bild, genom att ta en aktiv roll som deltagare.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ei-fiktiivisen liikkuvan kuvan teoksen ekspression tekemiseen ottamalla aktiivisen roolin osallistujana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20481"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvaan kuvaan osallistuja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">onscreen participant corporate body</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske esiintymistä lisä- tai taustatietojen kertojana. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte uppträdande som berättare av tilläggs- eller bakgrundsinformation.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5406">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">moderator (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">moderoija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen juontamalla (usein lähetettyä) ohjelmaa, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som deltar i utförandet av ett uttryck, genom att leda ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter i ämnen som relaterar till diskussionen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20373"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">moderator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">moderator person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">moderoija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5407">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3578"/>
    <skos:definition xml:lang="sv">Institution mot vilken talan väckts.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jota vastaan on nostettu kanne. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10395"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">civil defendant corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">institution som svarande i civilmål</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisövastaaja siviilioikeudessa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5408">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5574"/>
    <skos:definition xml:lang="sv">Institution som ett verk handlar om.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jota teos koskee. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10263"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aiheena oleva yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">behandlad institution</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subject corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5409">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kuoronjohtaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kördirigent (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5655"/>
    <skos:definition xml:lang="sv">Institution som är en dirigent som deltar i utförandet av ett uttryck, genom att leda en kör i en musik- eller dramaföreställning.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla kuoroa musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20454"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">choral conductor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuoronjohtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kördirigent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5410">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5787"/>
    <skos:altLabel xml:lang="fi">kappaleeseen liittyvä ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">uttryck relaterat till exemplaret</skos:altLabel>
    <skos:definition xml:lang="fi">Ekspressio, joka liittyy kappaleeseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som relaterar till ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40070"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleeseen liittyvä versio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related expression of item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">version relaterad till exemplaret</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5411">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression haastattelija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuare (person) i uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">version haastattelija</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonain muuna toimijana, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck genom att fungera som intervjuare, journalist, opinionsmätare eller någon annan aktör som samlar in information.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20337"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastattelija (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">interviewer person of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuare (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5412">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">domstolssekreterare (institution) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen tuomioistuimen kirjuri (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän tuomioistuimen lausunnon julkaistavaksi valmisteleva yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som förbereder en domstols utlåtande, som ingår i ett aggregat, för publicering.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">domstolssekreterare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuomioistuimen kirjuri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5413">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5098"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen yhteisö, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Institution som bidragit till ett aggregat och skapat ett uttryck av ett textverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30402"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (institution) till text</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor corporate body of text</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstiin osallinen yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5414">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fotograf (institution) till verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen valokuvaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett fotografiskt verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa valokuvateoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10539"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fotograf till verk</skos:prefLabel>
    <skos:prefLabel xml:lang="en">photographer corporate body of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen valokuvaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5415">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tekstiin osallinen kääntäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">översättare (institution) som är bidragsgivare till text</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää tekstiä alkuperäisestä sisällöstä poikkeavaan kieleen kääntänyt yhteisö. Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä.</skos:definition>
    <skos:definition xml:lang="sv">Institution som översatt en text som ingår i ett aggregat, till ett språk som avviker från det ursprungliga innehållet. En översättare kan också översätta språkligt innehåll mellan olika former av samma språk från olika tidsperioder.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kääntäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">översättare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5416">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelande aktör (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen taltioija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän tallenteen äänityksen teknistä puolta valvova henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som övervakar den tekniska delen av upptagningen av en ljudinspelning som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelande person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taltioija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5417">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dubbningsregissör (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen dubbausohjaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää ääniraitaa täydentävän dialogin tai muiden äänien lisäämisen yleisestä johtamisesta ja valvonnasta vastaava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för allmän ledning och övervakning av tillägget av dialog eller andra röster, som kompletterar ett ljudspår som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">dubbausohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dubbningsregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5418">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5418"/>
    <skos:altLabel xml:lang="en">derivative work relationship</skos:altLabel>
    <skos:altLabel xml:lang="en">referential work relationship</skos:altLabel>
    <skos:altLabel xml:lang="en">sequential work relationship</skos:altLabel>
    <skos:altLabel xml:lang="en">whole-part work relationship</skos:altLabel>
    <skos:definition xml:lang="fi">Teos, joka liittyy teokseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som relaterar till ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10198"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1443"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2261"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2264"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2266"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3458"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3470"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3474"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3477"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3483"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3521"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m783"/>
    <skos:prefLabel xml:lang="en">related work of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teokseen liittyvä teos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verk relaterat till verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5419">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dedikationsmottagare</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen omistuksen kohde (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">verket dedicerat till (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5574"/>
    <skos:definition xml:lang="sv">Institution som ett verk tillägnats.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jolle teos on omistettu. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10506"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dedicatee corporate body of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen omistuksen kohde</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verket dedicerat till</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5420">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">forskare (person) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen tutkija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5814"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän tutkimuksen henkilötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsperson till forskning som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">forskare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tutkija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5421">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">redaktionschef (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimituspäällikkö (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som har ett juridiskt eller kunskapsmässigt ansvar, men inte kreativt ansvar, för ett diakroniskt verks redaktionella linje och innehåll.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10511"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editorial director corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redaktionschef</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimituspäällikkö</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte justering, förtydligande eller annan ändring av innehållet i ett verks uttryck.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5422">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5647"/>
    <skos:altLabel xml:lang="sv">förteckning över manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="fi">luettelo manifestaatiolle</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5970"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on kokoelmamanifestaatio, jota metatietokokonaisuus kuvailee. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en samlingsmanifestation, som en metadatahelhet beskriver.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10624"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">finding aid of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förteckning över materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">luettelo aineistolle</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5423">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tekstiin osallinen tekstaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">textare (person) som är bidragsgivare till text</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5814"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän sarjakuvasisällön tekstin ja graafiset äänitehosteet piirtävä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som ritar text och grafiska ljudeffekter i serieinnehåll som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tekstaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5424">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esineeseen osallinen keksijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppfinnare (person) som är bidragsgivare till föremål</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5425"/>
    <skos:definition xml:lang="fi">Aggregaattiin liittyvän uuden välineen tai menetelmän luonut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som skapat ett nytt redskap eller en ny metod som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">keksijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppfinnare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5425">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5097"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen henkilö, joka on luonut aggregaattiin sisältyvän esineteoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat, som skapat ett uttryck av ett föremålsverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30345"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (person) till föremål</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor person of object</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">esineeseen osallinen henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5426">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen puhuja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">talare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä liikkuvassa kuvassa puhuva yhteisö. Esimerkiksi luennon tai puheen pitäjä.</skos:definition>
    <skos:definition xml:lang="sv">Institution som talar i rörlig bild som ingår i ett aggregat. Till exempel föredrags- eller talhållare.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan puhuja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">talare i rörlig bild</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5427">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
