    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa musiikkiteosta laajentavan kadenssin luomisesta.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av en kadens som utvidgar ett musikverk.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer person of cadenza work</skos:prefLabel>
