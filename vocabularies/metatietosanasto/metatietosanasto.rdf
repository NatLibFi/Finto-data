    <skos:altLabel xml:lang="sv">Priset Årets kristna bok</skos:altLabel>
    <skos:altLabel xml:lang="fi">Vuoden kristillinen kirja -palkinto</skos:altLabel>
    <skos:definition xml:lang="fi">Kristilliset kustantajat ry:n järjestämä kilpailu, jonka voittaja on viime vuosina valittu Helsingin kirjamessujen yhteydessä.</skos:definition>
    <skos:definition xml:lang="sv">Tävling ordnad av Kristilliset kustantajat ry, vars vinnare under de senaste åren utsetts i samband med Helsingfors bokmässa.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Årets kristna bok, 1994</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Vuoden kristillinen kirja, 1994</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Vuoden kristillinen kirja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Årets kristna bok</skos:prefLabel>
  </owl:Class>
