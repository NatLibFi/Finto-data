    <skos:prefLabel xml:lang="sv">partners syskon</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puolison sisarus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4637">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4644"/>
    <skos:altLabel xml:lang="sv">far- eller morförälder</skos:altLabel>
    <skos:altLabel xml:lang="sv">farförälder</skos:altLabel>
    <skos:altLabel xml:lang="fi">isoisä</skos:altLabel>
    <skos:altLabel xml:lang="fi">isoäiti</skos:altLabel>
    <skos:altLabel xml:lang="sv">mor- eller farförälder</skos:altLabel>
    <skos:altLabel xml:lang="sv">morförälder</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasGrandParent"/>
    <skos:definition xml:lang="sv">Farfar, morfar, farmor eller mormor till en beskriven person. Kan även vara fader eller moder till en adoptions- eller fosterförälder.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön isoisä tai isoäiti. Voi olla myös adoptio-, kasvatti- tai ottovanhemman isä tai äiti.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">farförälder/morförälder</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has grandparent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">isovanhempi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4638">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
