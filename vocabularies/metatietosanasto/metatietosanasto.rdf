    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3574">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Liittää ekspression henkilöön, joka osallistuu ekspression sisältämään keskusteluosuuteen toimimalla keskustelijana.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar uttryck med en person, som deltar i diskussionsdelen i ett uttryck genom att fungera som debattör.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">debattör (uttryck)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">keskustelija (ekspressio)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3575">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
