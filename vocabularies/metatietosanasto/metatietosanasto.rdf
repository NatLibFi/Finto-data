    <skos:prefLabel xml:lang="fi">yhteisöön liittyvä henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5337">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5098"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen yhteisö, joka on luonut aggregaattiin sisältyvän esineteoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Institution som bidragit till ett aggregat, som skapat ett uttryck av ett föremålsverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30403"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (institution) till föremål</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor corporate body of object</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">esineeseen osallinen yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5338">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5512"/>
