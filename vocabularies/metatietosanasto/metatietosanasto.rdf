    <skos:definition xml:lang="fi">Selittävien tai kriittisten huomautusten joukon perustana käytetty kappale. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10270"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
