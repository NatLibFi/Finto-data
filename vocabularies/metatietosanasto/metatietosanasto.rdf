    <skos:prefLabel xml:lang="en">radio producer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">radioproducent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">radiotuottaja</skos:prefLabel>
  </owl:Class>
