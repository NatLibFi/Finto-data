    <skos:altLabel xml:lang="fi">pakkotyöleiri</skos:altLabel>
    <skos:altLabel xml:lang="fi">sotavankileiri</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p145"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fångläger</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vankileiri</skos:prefLabel>
