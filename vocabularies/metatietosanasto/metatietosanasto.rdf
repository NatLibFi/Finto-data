  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m206">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Hederstitel för präster e.d. andliga män, särskilt inom katolska eller ortodoxa kyrkan.</skos:definition>
    <skos:definition xml:lang="fi">Varsinkin katolisten tai ortodoksisten pappien tai muiden hengenmiehien arvonimi.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fader</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">isä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2062">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4332"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m175"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on erillinen osa toista manifestaatiota. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en skild del av en annan manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30022"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bilaga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">insert</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liite</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar t.ex. en kart-, illustrations- eller reklambilaga, som inte är en fast del av den övriga manifestationen.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Liite käsittää esim. kartan tai kuvitus- tai mainosliitteen, joka ei ole kiinteä osa muuta manifestaatiota. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2063">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
