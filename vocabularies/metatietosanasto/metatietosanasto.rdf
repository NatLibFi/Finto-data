    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasStepChild"/>
    <skos:definition xml:lang="sv">Barn till en beskriven persons partner.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön puolison lapsi.</skos:definition>
