    <skos:altLabel xml:lang="sv">mötesarrangör</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som ordnar en konferens, en utställning eller något annat evenemang som ger upphov till ett verk.</skos:definition>
