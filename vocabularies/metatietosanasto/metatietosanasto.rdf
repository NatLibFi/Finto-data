    <skos:altLabel xml:lang="fi">taiteellinen tuottaja</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa ekspression taiteellisen sisällön tuottamisesta (esim. äänitteen tuottaja).</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för produktionen av ett uttrycks konstnärliga innehåll (t.ex. producent för en ljudinspelning).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
