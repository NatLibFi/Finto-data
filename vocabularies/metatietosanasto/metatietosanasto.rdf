    <skos:altLabel xml:lang="sv">arbetarorganisationer</skos:altLabel>
    <skos:altLabel xml:lang="sv">partier (verksamhetsområde)</skos:altLabel>
    <skos:altLabel xml:lang="sv">partiorganisationer</skos:altLabel>
    <skos:altLabel xml:lang="fi">protestiliikkeet</skos:altLabel>
    <skos:altLabel xml:lang="sv">proteströrelser</skos:altLabel>
    <skos:altLabel xml:lang="fi">puolueet (toimiala)</skos:altLabel>
    <skos:altLabel xml:lang="fi">puoluejärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">työväenjärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">työväenyhdistykset</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p829"/>
    <skos:definition xml:lang="fi">Poliittiset puolueet, niiden paikallisyhdistykset, nais-, nuoriso- ja seniorijärjestöt ja muut aatteellisia ja laaja-alaisesti yhteiskunnallisia asioita ajavat järjestöt ja liikkeet.</skos:definition>
    <skos:definition xml:lang="sv">Politiska partier, deras lokalföreningar, kvinno-, ungdoms-, och seniororganisationer, samt andra organisationer och rörelser som driver ideella och övergripande samhälleliga frågor.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">poliittiset järjestöt</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">politiska organisationer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4893">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arbetsgivarorganisationer</skos:altLabel>
    <skos:altLabel xml:lang="sv">företagarorganisationer</skos:altLabel>
    <skos:altLabel xml:lang="sv">handelns organisationer</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaupan järjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsänhoitoyhdistykset</skos:altLabel>
    <skos:altLabel xml:lang="sv">näringsorganisationer</skos:altLabel>
    <skos:altLabel xml:lang="sv">skogsvårdsföreningar</skos:altLabel>
    <skos:altLabel xml:lang="fi">talous- ja elinkeinojärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">työnantajajärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">yrittäjäjärjestöt</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:definition xml:lang="sv">Intresseorganisationer och sammanslutningar av sådana som främjar näringsverksamhet inom en viss bransch, arbetsgivarorganisationer, samt organisationer som främjar ekonomisk verksamhet och företagsamhet, oberoende av bransch.</skos:definition>
    <skos:definition xml:lang="fi">Tietyn toimialan elinkeinotoiminnan edistämistä ajavat etujärjestöt ja niiden yhteenliittymät, työnantajajärjestöt sekä taloudellista toimintaa ja yrittäjyyttä toimialasta riippumatta edistävät järjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elinkeinojärjestöt</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">näringslivsorganisationer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4894">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">yrkessammanslutningar</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12211"/>
    <skos:definition xml:lang="sv">Intresseorganisationer för vissa yrken, vetenskapsgrenar eller tekniska branscher.</skos:definition>
    <skos:definition xml:lang="fi">Tietyn ammatin, tieteenalan tai teknisen alan asioita ajavat etujärjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
