  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5505">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ohjelmistokehittäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programutvecklare (person)</skos:altLabel>
