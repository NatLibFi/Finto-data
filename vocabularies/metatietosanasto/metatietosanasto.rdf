    <skos:definition xml:lang="sv">Institution som stöder eller gynnar en beskriven person (t.ex. en konstnär).</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka tukee tai suosii kuvailtavaa henkilöä (esim. taiteilijaa).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has patron</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mecenat</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mesenaatti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5252">
