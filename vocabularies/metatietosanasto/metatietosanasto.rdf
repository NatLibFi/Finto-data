    <skos:altLabel xml:lang="fi">opiston opettaja</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2413"/>
    <skos:definition xml:lang="fi">Aikuiskasvatus- ja aikuisopiston opettaja.</skos:definition>
    <skos:definition xml:lang="sv">Lärare vid vuxenutbildningsinstitut.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lärare vid institut</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opistonopettaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3953">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2532"/>
    <skos:definition xml:lang="fi">(Maaseutu)kunnan hallinnon sihteerintehtäviä hoitava virkamies (Lähde: Kielitoimiston sanakirja).</skos:definition>
    <skos:definition xml:lang="sv">Tjänsteman som sköter förvaltningens sekreteraruppgifter i (landsorts)kommun.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kommunsekreterare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kunnansihteeri</skos:prefLabel>
    <skos:prefLabel xml:lang="en">municipal secretary</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3954">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tvätterska</skos:altLabel>
    <skos:definition xml:lang="fi">Esim. pyykinpesijä, ravintolan astianpesijä.</skos:definition>
    <skos:definition xml:lang="sv">T.ex. tvättare av byk, diskare vid restaurang.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">pesijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tvättare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3955">
