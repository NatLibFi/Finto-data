    <skos:prefLabel xml:lang="en">software developer person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5506">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">laulaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare, som deltar i utförandet av ett uttryck, genom att använda sin röst, med eller utan instrumentalackompanjemang, för att producera musik.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20500"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laulaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">singer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Sångarens framförande kan vara med eller utan riktiga ord.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5507">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
