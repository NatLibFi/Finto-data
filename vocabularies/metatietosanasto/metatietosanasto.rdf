    <skos:prefLabel xml:lang="fi">arkkimandriitta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1310">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljuddesigner (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">sound designer</skos:altLabel>
