    <skos:prefLabel xml:lang="sv">utställning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4680">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">handelshögskola</skos:altLabel>
    <skos:altLabel xml:lang="sv">högskola (universitet, institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kauppakorkeakoulu</skos:altLabel>
    <skos:altLabel xml:lang="fi">korkeakoulu (yliopisto, yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="fi">teknillinen korkeakoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">teknisk högskola</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p10895"/>
    <skos:definition xml:lang="fi">Koulutusorganisaatio, jonka tehtävänä on edistää vapaata tutkimusta ja tieteellistä ja taiteellista sivistystä sekä antaa tutkimukseen perustuvaa korkeinta opetusta (Opetus- ja koulutussanasto).</skos:definition>
    <skos:definition xml:lang="sv">Utbildningsorganisation med uppgift att främja fri forskning och vetenskaplig och konstnärlig bildning, samt ge forskningsbaserad undervisning på högsta nivå.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">universitet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yliopisto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4681">
