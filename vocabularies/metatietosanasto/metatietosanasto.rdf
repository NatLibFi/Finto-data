  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3662">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p1861"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p4503"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p4802"/>
    <skos:altLabel xml:lang="sv">fiskeri</skos:altLabel>
    <skos:altLabel xml:lang="sv">jordbruk</skos:altLabel>
    <skos:altLabel xml:lang="sv">jordbruk, skogsbruk och fiskerinäring</skos:altLabel>
    <skos:altLabel xml:lang="fi">kalatalous</skos:altLabel>
    <skos:altLabel xml:lang="fi">maatalous</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsätalous</skos:altLabel>
    <skos:altLabel xml:lang="sv">skogsbruk</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar och betjänar primärproduktion inom jordbruk, skogsbruk och fiskeri, alltså växtodling, husdjursuppfödning, skogvsvård, drivning, jakt, fiske, och fiskodling. Till huvudkategorin hör inte veterinärer (se hälso- och socialvårdsbranschen), företag inom lantgårdsturism (se inkvarterings- och kosthållsbranschen) eller aktörer som bedriver trävarutransport (se logistikbranschen) eller vidareförädling av produkter (se industri).</skos:definition>
    <skos:definition xml:lang="fi">Maatalouden, metsätalouden ja kalatalouden alkutuotantoa eli kasvinviljelyä, kotieläinten kasvatusta, metsänhoitoa, puunkorjuuta, metsästystä, kalastusta ja kalanviljelyä harjoittavat ja palvelevat toimijat. Pääluokkaan eivät kuulu eläinlääkärit (ks. terveys- ja sosiaaliala), maatilamatkailuyritykset (ks. majoitus- ja ravitsemisala) eivätkä puutavaran kuljetusta (ks. logistiikka-ala) tai tuotteiden jatkojalostusta (ks. teollisuus) harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">jordbruk, skogsbruk och fiskeri</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maa-, metsä- ja kalatalous</skos:prefLabel>
  </owl:Class>
