    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3491"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3502"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3508"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3513"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3529"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3533"/>
    <skos:prefLabel xml:lang="en">augmentation of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">laajennus teokseen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utvidgning av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1445">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka on tiheästi kudottua tekstiiliä, usein pellavaa, hamppua, juuttia tai puuvillaa ja jota käytetään öljyvärimaalausten pohjana.</skos:definition>
    <skos:definition xml:lang="sv">Material som är tätt vävd textil, ofta linne, hampa, jute eller bomull, och som används som botten till oljefärgsmålningar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">canvas</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kangas</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tyg</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1447">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Elokuvafilmin esitysformaatti, jonka kuvasuhde on enintään 2.76:1 ja joka käyttää alun perin kolmea synkronoitua projektoria.</skos:definition>
    <skos:definition xml:lang="sv">Visningsformat för film, vars bildförhållande är högst 2.76:1 och som ursprungligen använder tre synkroniserade projektorer.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/presFormat/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Cinerama</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Cinerama</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Cinerama</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1448">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">autuas</skos:altLabel>
    <skos:altLabel xml:lang="sv">heliga</skos:altLabel>
    <skos:altLabel xml:lang="sv">helige</skos:altLabel>
    <skos:altLabel xml:lang="fi">pyhittäjä</skos:altLabel>
    <skos:altLabel xml:lang="sv">salig</skos:altLabel>
    <skos:altLabel xml:lang="sv">salige</skos:altLabel>
    <skos:definition xml:lang="fi">Pyhimysten nimitys.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">helgon</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pyhä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1449">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">takter efter varandra</skos:altLabel>
    <skos:definition xml:lang="fi">Layout, joka koostuu sisennetyissä kappaleissa esitetystä nuottikirjoituksesta, ja jossa jokaisen tahdin stemmat on merkitty peräkkäin.</skos:definition>
    <skos:definition xml:lang="sv">Layout, som består av notskrift förevisad i indragna stycken, och i vilken varje takts stämmor har angetts i följd efter varandra.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">bar by bar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tahdit peräkkäin</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">takt för takt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m145">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Ljudkanal som består av flera än fyra kanaler, för surround-ljud.</skos:definition>
    <skos:definition xml:lang="fi">Useammasta kuin neljästä kanavasta koostuva surround-äänen äänikanava.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/configPlayback/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">surround</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">surround</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1454">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka muodostuu kiviaineksesta sen luonnollisessa muodossa tai leikattuna, muotoiltuna, murskattuna tai muulla tavalla muokattuna.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av sten i dess naturliga form eller i skuren, formad, krossad eller på annat sätt bearbetad form.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1036"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kivi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sten</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stone</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1456">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Vuoden johtolanka -palkinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">Årets ledtråd-priset</skos:altLabel>
    <skos:definition xml:lang="sv">Pris beviljat av Finska deckarsällskapet för ett betydande litterärt verk inom deckargenren.</skos:definition>
    <skos:definition xml:lang="fi">Suomen dekkariseuran myöntämä palkinto edellisen vuoden merkittävästä dekkariteoksesta tai dekkariteosta.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Årets ledtråd, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Vuoden johtolanka, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Vuoden johtolanka</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Årets ledtråd</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1461">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1004"/>
    <skos:definition xml:lang="sv">Benämning på medlem i nunneorden.</skos:definition>
    <skos:definition xml:lang="fi">Nunnakunnan jäsenen nimitys.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nunna</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">nunna</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1462">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">3D-esitysformaatti</skos:altLabel>
    <skos:altLabel xml:lang="sv">3D-visningsformat</skos:altLabel>
    <skos:definition xml:lang="fi">Elokuvafilmin esitysformaatti, joka luo kolmiulotteisuuden vaikutelman.</skos:definition>
    <skos:definition xml:lang="sv">Visningsformat för film, som skapar ett tredimensionellt intryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/presFormat/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">3D</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">3D</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">3D</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1463">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kontinuerlig uppdatering</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">päivitetään jatkuvasti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppdateras kontinuerligt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1466">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka muodostuu puiden ja niiden kaltaisten kasvien pääkudoksesta.</skos:definition>
    <skos:definition xml:lang="sv">Material som bildas av huvudvävnaden i träd och andra liknande växter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1045"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">trä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">wood</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1468">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, stillbild tecknad på bottenmaterial, oftast papper, med hjälp av penna, kol, krita eller annat teckningsredskap. I teckningar framhävs form mer än färg.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, piirtämällä tehty liikkumaton kuva pohjamateriaalille, usein paperille, käyttäen kynää, hiiltä, liitua tai puuta piirustusvälinettä ja korostaen muotoa ennemmin kuin värejä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">drawing</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piirustus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">teckning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1475">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30128"/>
    <skos:definition xml:lang="fi">Manifestaation nimeke, jota ei ole valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
    <skos:definition xml:lang="sv">Titel för manifestation, som inte har valts till primär i en viss tillämpning eller kontext.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">manifestaation varianttinimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">variant title of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">varianttitel</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1476">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dockspelare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">nukettaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">puppeteer</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i utförandet av ett uttryck genom att hantera, kontrollera eller styra dockor eller marionetter i en filmproduktion eller ett musikaliskt eller sceniskt uppförande.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen käsittelemällä, kontrolloimalla tai ohjaamalla nukkeja tai marionetteja elokuvatuotannossa tai musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20018"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dockspelare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">nukettaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">puppeteer agent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1477">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">hardback</skos:altLabel>
    <skos:altLabel xml:lang="sv">inbunden</skos:altLabel>
    <skos:altLabel xml:lang="fi">sidottu</skos:altLabel>
    <skos:altLabel xml:lang="sv">sydd limbindning</skos:altLabel>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, jossa arkit ommellaan tai liimataan ryhmiksi, jotka liimataan yhteen litteäksi selkämykseksi. Arkkien ryhmät kiinnitetään kansipapereihin, jotka puolestaan kiinnitetään jäykkään päällykseen.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, i vilken arken sys eller limmas till grupper, som limmas samman till en platt rygg. Grupperna av ark fästs vid omslagspapper, som i sin tur fästs vid ett styvt omslag.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">case binding</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ommeltu liimasidonta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tråd- och limbindning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1479">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4253"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">linkki</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">länk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m148">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">manufacturer</skos:altLabel>
    <skos:altLabel xml:lang="sv">tillverkare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valmistaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5586"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tryckningen, mångfaldigandet, gjutandet av typer eller något annat framställningssätt för en utgiven manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa julkaistun manifestaation painamisesta, monistamisesta, kirjasinten valamisesta tai muusta valmistustavasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30082"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1748"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1755"/>
    <skos:prefLabel xml:lang="en">manufacturer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tillverkare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valmistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1480">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">audio engineer</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljudtekniker (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ääniteknikko (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att sköta de tekniska aspekterna på ljud under inspelnings-, mixnings- och ljudåtergivningsprocesser.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen huolehtimalla äänen teknisistä näkökohdista äänitys-, miksaus- ja äänentoistoprosessien aikana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20292"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1354"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m240"/>
    <skos:prefLabel xml:lang="en">audio engineer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudtekniker</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääniteknikko</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1483">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Polariteetti, jossa kuvan värit ja valoisuus ovat ihmissilmän normaalisti näkemässä muodossa.</skos:definition>
    <skos:definition xml:lang="sv">Polaritet, i vilken en bilds färg och ljus är i den form människoögat normalt ser den.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAPolarity/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">positiivi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">positiv</skos:prefLabel>
    <skos:prefLabel xml:lang="en">positive</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1486">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">designer</skos:altLabel>
    <skos:altLabel xml:lang="sv">designer (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">designer (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för design eller formgivning av ett objekt.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa kohteen suunnittelusta tai muotoilusta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10051"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">designer</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">designer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">designer agent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1488">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Polariteetti, jossa kuvan värit ja valoisuus ovat ihmissilmin nähtävien värien ja valoisuuden vastakohtia.</skos:definition>
    <skos:definition xml:lang="sv">Polaritet, i vilken bildens färg och ljus är de motsatta till dem som ses med människoögat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAPolarity/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">negatiivi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">negativ</skos:prefLabel>
    <skos:prefLabel xml:lang="en">negative</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m149">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, föremål som finns i utställningsliknande miljö, inklusive föremål som fodral, etikett m.m.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, esine joka on esillä näyttelynomaisessa ympäristössä mukaan lukien kotelo, etiketti tms.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">exhibit</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">näyttelyesine</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utställningsföremål</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1491">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:example xml:lang="sv">MARC 21 562 ## ‡a Ex. 3: Titelsida saknas.</skos:example>
    <skos:example xml:lang="fi">MARC 21 562 ## ‡a Kpl 3: Nimiösivu puuttuu.</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nimiösivu puuttuu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">titelsida saknas</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1494">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">provupplaga</skos:altLabel>
    <skos:definition xml:lang="sv">Bestämning av generation för en ljudupptagnings upplaga som görs för att kontrollera fel innan en full upplaga tillverkas.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolven määrite äänitteen painoserälle, joka tehdään virheiden tarkistamiseksi ennen täyden painoksen valmistamista.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1017"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">koepainos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">provtryck</skos:prefLabel>
    <skos:prefLabel xml:lang="en">test pressing</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1495">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka kostuu sideaineeseen sekoitetusta väriaineesta, yleensä puikkomaisessa muodossa.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av färgämne blandat i bindemedel, vanligen i stickform.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1027"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">pastel</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">pastell</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pastelli</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1498">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen nauhan videoformaatti, jonka Ampex ja Sony kehittivät ammattilaiskäyttöön vuonna 1976.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för analogt band, som Ampex och Sony utvecklade för professionellt bruk år 1976.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/videoFormat/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">C-tyyppi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Type C</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Type C</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m15">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Spåregenskap för analog ljudcylinder, vars spårfördelning är 40 varv/cm (100 varv/tum).</skos:definition>
    <skos:definition xml:lang="fi">Uran ominaisuus analogiselle äänilieriölle, jonka urajako on 40 kierrosta/cm (100 kierrosta/tuuma).</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/groovePitch/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">standard</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">standard</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">standardi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1500">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9665"/>
    <skos:definition xml:lang="fi">Keisarin puoliso; keisarikuntaa hallitseva naispuolinen monarkki.</skos:definition>
    <skos:definition xml:lang="sv">Kejsarens gemål; kvinnlig monark som regerar över kejsardöme.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">keisarinna</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kejsarinna</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1502">
