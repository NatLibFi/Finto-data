    <skos:prefLabel xml:lang="fi">muunnos genressä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by genre</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av genre</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5529">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (person) till text i musikverk</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiteoksen tekstin kirjoittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5362"/>
    <skos:definition xml:lang="en">A person who is responsible for writing a textual work that is basis of a non-dramatic musical work, other than an oratorio.</skos:definition>
    <skos:definition xml:lang="fi">Henkilö, joka on ei-näytelmällisen musiikkiteoksen (muun kuin oratorion) pohjalla olevan tekstin kirjoittaja.</skos:definition>
    <skos:definition xml:lang="sv">Person som är författare till en text som är grunden för ett icke-dramatiskt musikverk (annat än oratorium).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">author person of musical work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare till text i musikverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikkiteoksen tekstin kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m553">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">En upphängningsmekanism för ett block på en eller flera sidor, utformad för användning på staffli.</skos:definition>
    <skos:definition xml:lang="fi">Ripustettava yhden tai useamman sivun sisältävä paperilehtiö, jota käytetään jalustalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1046"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blädderblock</skos:prefLabel>
    <skos:prefLabel xml:lang="en">flipchart</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lehtiötaulu</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ilman laitetta käytettävä tallennetyyppi.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omedierad bärartyp.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5530">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
