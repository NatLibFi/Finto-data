    <skos:prefLabel xml:lang="en">respondent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">respondent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">respondentti</skos:prefLabel>
  </owl:Class>
