    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4613"/>
    <skos:altLabel xml:lang="fi">anoppi</skos:altLabel>
    <skos:altLabel xml:lang="fi">appi</skos:altLabel>
    <skos:altLabel xml:lang="fi">puolison isä</skos:altLabel>
    <skos:altLabel xml:lang="fi">puolison äiti</skos:altLabel>
    <skos:altLabel xml:lang="sv">svärfader</skos:altLabel>
    <skos:altLabel xml:lang="sv">svärfar</skos:altLabel>
    <skos:altLabel xml:lang="sv">svärmoder</skos:altLabel>
    <skos:altLabel xml:lang="sv">svärmor</skos:altLabel>
