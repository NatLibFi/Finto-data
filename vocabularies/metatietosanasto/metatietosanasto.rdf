    <skos:definition xml:lang="fi">Selittävien tai kriittisten huomautusten joukon perustana käytetty teos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som använts som grund för en samling förklarande eller kritiska anmärkningar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10187"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
