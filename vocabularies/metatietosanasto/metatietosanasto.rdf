    <skos:prefLabel xml:lang="sv">distributör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">jakelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5751">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">asiantuntija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">expert (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som erbjuder experttjänster och ofta ger rekommendationer åt en aktör, som är upphovsperson till ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10552"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asiantuntija</skos:prefLabel>
    <skos:prefLabel xml:lang="en">consultant corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">expert</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5752">
