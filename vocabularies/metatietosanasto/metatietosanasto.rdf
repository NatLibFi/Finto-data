    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5699"/>
    <skos:definition xml:lang="fi">Henkilö, joka tekee muutoksia kappaleeseen luomatta uutta manifestaatiota. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som gör ändringar i ett exemplar, utan att skapa en ny manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40112"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1757"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1758"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1773"/>
    <skos:prefLabel xml:lang="sv">bearbetare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">modifier person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muokkaaja</skos:prefLabel>
  </owl:Class>
