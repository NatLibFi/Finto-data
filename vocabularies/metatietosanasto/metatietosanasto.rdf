    <skos:altLabel xml:lang="fi">kappaleen omistuksen kohde (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5779"/>
    <skos:definition xml:lang="sv">Institution som ett exemplar är tillägnat.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jolle kappale on omistettu. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40129"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dedicatee corporate body of item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">exemplaret dedicerat till</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleen omistuksen kohde</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5779">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Institution som relaterar till ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka liittyy kappaleeseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40075"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">institution relaterad till exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleeseen liittyvä yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related corporate body of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5780">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">painolaatan valmistaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckplåtstillverkare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5486"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation valmistamisesta valmistamalla painettujen kuvien tai tekstin valmistuksessa käytettäviä painolaattoja tai -levyjä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av en manifestation, genom att tillverka tryckplåtar eller dylikt, för användning vid tillverkningen av tryckta bilder eller texter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30355"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">painolaatan valmistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">platemaker person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckplåtstillverkare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5781">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">historieberättare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tarinankertoja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen kertomalla alkuperäisen tarinan draamallisella tai teatraalisella tulkinnalla. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare, som deltar i utförandet av ett uttryck genom att framföra en berättelse med en dramatisk eller teatralisk tolkning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20379"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">historieberättare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">storyteller person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tarinankertoja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5782">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5601"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5433"/>
    <skos:definition xml:lang="sv">Metadataverk som en manifestation ger bevis för.</skos:definition>
    <skos:definition xml:lang="fi">Metatietoteos, jonka todisteena manifestaatio on. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30334"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">konsulterad källa i metadataverket</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">käytetty lähde metatietoteoksessa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">source consulted of</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5783">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">miksaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">mixer (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5540"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression äänisisällön tekemiseen käsittelemällä, miksaamalla ja yhdistelemällä useampia äänitteen raitoja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i skapandet av ett uttrycks ljudinnehåll, genom att behandla, mixa och kombinera flera spår i en ljudinspelning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20385"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">miksaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mixer</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mixing engineer person</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske uudelleenmiksauksia, jotka olennaisesti muuttavat alkuperäisen teoksen luonnetta ja sisältöä, mikä johtaa uuteen teokseen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte remixer som väsentligen ändrar det ursprungliga verkets karaktär och innehåll, vilket leder till ett nytt verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5784">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5526"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5702"/>
    <skos:definition xml:lang="fi">Teos, jolla on tyyli, jota on muutettu teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk med en stil som har ändrats för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10341"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1566"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3467"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3473"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3478"/>
    <skos:prefLabel xml:lang="fi">muunnos tyylissä teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by style of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av stil för verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5785">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5944"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5383"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasMurderer"/>
    <skos:definition xml:lang="sv">Institution som har mördat en beskriven person.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön murhannut yhteisö.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has murderer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">murhaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mördare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5786">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">censor (institution) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen sensori (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää tekstiä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein tarkastanut yhteisö. Sensori tarkastaa sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein. Alkuperäisen teoksen luonteen ja yleisen sisällön sensori jättää olennaisilta osiltaan muuttumattomaksi.</skos:definition>
    <skos:definition xml:lang="sv">Institution som granskat text som ingår i ett aggregat, för att dölja kontroversiellt innehåll på moraliska, politiska, militära eller andra grunder. Censorn lämnar det ursprungliga verkets karaktär och allmänna innehåll till sina väsentliga delar oförändrat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">censor</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sensori</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5787">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5410"/>
    <skos:altLabel xml:lang="fi">ekspressioon liittyvä kappale</skos:altLabel>
    <skos:altLabel xml:lang="sv">exemplar relaterat till uttrycket</skos:altLabel>
    <skos:definition xml:lang="sv">Exemplar som relaterar till ett uttryck.</skos:definition>
    <skos:definition xml:lang="fi">Kappale, joka liittyy ekspressioon. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20300"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">exemplar relaterat till versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related item of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">versioon liittyvä kappale</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5788">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">designer (person) som är bidragsgivare till föremål</skos:altLabel>
    <skos:altLabel xml:lang="fi">esineeseen osallinen designer (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5425"/>
    <skos:definition xml:lang="fi">Aggregaattiin liittyvän kohteen suunnitellut tai muotoillut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som designat eller formgett ett objekt som relaterar till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">designer</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">designer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5789">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">julkaisemattoman manifestaation tuottaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">producent (person) för opublicerad manifestation</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5486"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa julkaisemattoman manifestaation kaiverruksesta, valmistuksesta, kokoonpanosta tms. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för gravering, tillverkning, sammansättning eller annat tillverkningssätt för en opublicerad manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30360"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">julkaisemattoman aineiston tuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">producent för opublicerat material</skos:prefLabel>
    <skos:prefLabel xml:lang="en">producer person of unpublished manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5790">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">festskriftsföremål</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5699"/>
    <skos:definition xml:lang="fi">Henkilö, jota kappaleella kunnioitetaan. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är tillägnad ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40110"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">exemplar tillägnat personen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">honouree person of item</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleella kunnioitettu henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5791">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5715"/>
    <skos:definition xml:lang="fi">Henkilö, joka on akateeminen ohjaaja, joka on vastuussa opiskelijan suorittaman, teokseen johtavan projektin neuvonnasta tai ohjaamisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en akademisk handledare, som ansvarar för rådgivning och handledning av ett projekt som en studerande genomför och som leder till ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10408"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">project supervisor</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">projekthandledare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">projektin ohjaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5792">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5979"/>
    <skos:definition xml:lang="sv">Institution som svarar för sändning av en manifestation för en publik i radio, television, som direktsändning eller i något annat sändningsmedium.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation lähettämisestä yleisölle radiossa, televisiossa, suoratoistolähetyksenä tai muuna lähetysmediana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30405"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">broadcaster corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lähetyksestä vastaava yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sändningsansvarig institution</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5793">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">näyttelijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skådespelare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare som bidrar till utförandet av ett uttryck, genom att skådespela i ett musikaliskt eller sceniskt uppförande.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen näyttelemällä musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20487"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">actor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">näyttelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skådespelare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5794">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5449"/>
    <skos:definition xml:lang="sv">Aktör som ett metadataverk beskriver.</skos:definition>
    <skos:definition xml:lang="fi">Metatietoteoksen kuvailema toimija. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10610"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">metadata description of agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">metadatabeskrivning av aktören</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">metatietokuvailu toimijasta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5795">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">cataloguer agent</skos:altLabel>
    <skos:altLabel xml:lang="en">collection registrar</skos:altLabel>
    <skos:altLabel xml:lang="fi">kokoelman luetteloija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">samlingsregistrator (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1037"/>
