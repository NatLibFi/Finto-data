    <skos:altLabel xml:lang="en">former owner</skos:altLabel>
    <skos:altLabel xml:lang="sv">tidigare ägare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4467"/>
    <skos:definition xml:lang="sv">Aktör som tidigare juridiskt ägt ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on aiemmin laillisesti omistanut kappaleen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40019"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
