    <skos:altLabel xml:lang="sv">uppdelad i uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppdelad på</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppdelad på (uttryck)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2286"/>
    <skos:definition xml:lang="fi">Sellaisen teoksen ekspressio, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen osittaista sisältöä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av ett sådant verk som är ett diakroniskt verk, som fortsätter det partiella innehållet i ett annat, färdigt diakroniskt verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20200"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jakautunut versioon</skos:prefLabel>
    <skos:prefLabel xml:lang="en">split into expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppdelad i versionen</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Detta element lämpar sig vanligen för successivt utkommande uttryck.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvän teoksen ekspressioon. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4258">
