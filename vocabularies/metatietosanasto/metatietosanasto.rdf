  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5629">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">libretisti (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">librettist (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5497"/>
    <skos:definition xml:lang="sv">Institution som är författare till texten i ett musikaliskt eller koreografiskt verk, såsom en opera, en balett eller något annat musikaliskt sceniskt verk eller oratorium.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10525"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">libretisti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">librettist</skos:prefLabel>
    <skos:prefLabel xml:lang="en">librettist corporate body</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte författare till texter i enbart musikalsånger.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5630">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tekstiin osallinen transkriboija (henkilö)</skos:altLabel>
