    <skos:altLabel xml:lang="sv">beskriven i verket (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="en">described in (expression)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspressiota kuvaava teos</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvattu teoksessa (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">verk som beskriver uttrycket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5512"/>
