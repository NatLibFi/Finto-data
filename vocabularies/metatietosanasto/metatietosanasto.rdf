    <skos:definition xml:lang="sv">Person som svarar för maskering i en film, en musikal eller ett sceniskt verk som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
