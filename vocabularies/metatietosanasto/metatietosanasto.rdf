  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2291">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m960"/>
    <skos:altLabel xml:lang="sv">fortsättes av (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">seuraaja (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2274"/>
    <skos:definition xml:lang="fi">Teos, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen sisältöä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett diakroniskt verk, som fortsätter innehållet i ett annat färdigt diakroniskt verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10191"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">continued by work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fortsättes av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">seuraaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Detta element lämpar sig vanligen för successivt utkommande verk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvään teokseen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2292">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3448"/>
