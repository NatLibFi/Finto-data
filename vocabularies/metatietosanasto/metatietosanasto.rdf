    <skos:definition xml:lang="sv">Person vars biologiska förälder en beskriven person är.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">biologinen lapsi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">biologiskt barn</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has biological child</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4609">
