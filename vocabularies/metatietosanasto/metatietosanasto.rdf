    <skos:definition xml:lang="fi">Henkilö, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en producent, som svarar för största delen av affärsverksamheten kring ett radioprogram.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10423"/>
