    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4687"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4729">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">direktoraatti</skos:altLabel>
    <skos:altLabel xml:lang="sv">direktorat</skos:altLabel>
    <skos:altLabel xml:lang="fi">johtajisto</skos:altLabel>
    <skos:altLabel xml:lang="sv">ledning</skos:altLabel>
    <skos:altLabel xml:lang="sv">styrgrupp</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4691"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p23210"/>
    <skos:definition xml:lang="sv">Grupp bestående av lägre chefer och andra medlemmar ur personalen, som stöder chefen i ledningen.</skos:definition>
    <skos:definition xml:lang="fi">Johtajaa johtamisessa tukeva, alemmista johtajista ja muista henkilöstön jäsenistöstä koostuva ryhmä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">johtoryhmä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ledningsgrupp</skos:prefLabel>
  </owl:Class>
