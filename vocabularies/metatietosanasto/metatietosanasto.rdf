    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4236"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisältöä täydennetään suppealla sisällöllä siihen liittyvän teoksen ekspressiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk vars innehåll kompletteras med kortfattat innehåll från ett relaterat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20177"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">addenda to expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lisäykset teoksen versioon</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tillägg till versionen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4266">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m243"/>
    <skos:altLabel xml:lang="sv">faksimil av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="sv">faksimil av materialet</skos:altLabel>
