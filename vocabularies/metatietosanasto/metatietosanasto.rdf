    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2286"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisältö osittain korvaa ja tekee vanhentuneeksi toisen teoksen ekspression sisällön. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, vars innehåll delvis ersätter innehållet i ett annat verks uttryck, och gör det föråldrat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20075"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">delvis ersatt av versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">osittain korvattu versiolla</skos:prefLabel>
    <skos:prefLabel xml:lang="en">replaced in part by expression</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Detta element lämpar sig vanligen för ett statiskt verks uttryck.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tämä elementti soveltuu yleensä staattisen teoksen ekspressioon. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4261">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
