    <skos:prefLabel xml:lang="en">former owner corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tidigare ägare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5429">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esineeseen osallinen piirtäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ritare (person) som är bidragsgivare till föremål</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5425"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä laatinut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som utarbetat precisa planer eller ritningar av byggnader, fartyg, flygplan, apparater eller föremål, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">piirtäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ritare</skos:prefLabel>
  </owl:Class>
