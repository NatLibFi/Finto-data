    <skos:altLabel xml:lang="sv">sammanslagen med uttrycket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2295"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka on yhdistynyt yhden tai useamman ekspression kanssa ja muodostanut uuden ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, som har sammanslagits med ett eller flera uttryck och bildat ett nytt uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20201"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
