    <dct:language rdf:resource="http://lexvo.org/id/iso639-3/swe"/>
    <dct:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <dct:license rdf:resource="http://creativecommons.org/publicdomain/zero/1.0/"/>
