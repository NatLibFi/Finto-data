    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisältö laajentaa siihen liittyvän teoksen ekspressiota. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk vars innehåll utvidgar ett relaterat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20118"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
