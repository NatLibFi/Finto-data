    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av piano, violin, viola och violoncell.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: piano, viulu, alttoviulu, sello.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">pianokvartett</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pianokvartetti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2079">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m400"/>
    <skos:definition xml:lang="sv">Ensemble som består av instrument från minst två instrumentfamiljer och i vilken det finns högst 25 instrumentalister.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano, joka koostuu vähintään kahden soitinperheen jäsenistä ja jossa on korkeintaan 25 soittajaa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kamariorkesteri</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kammarorkester</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2080">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av piano, violin och violoncell.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: piano, viulu, sello.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">pianotrio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">pianotrio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2081">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av 2 violiner, 2 violor och violoncell.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: 2 viulu, 2 alttoviulu, sello.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jousikvintetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stråkkvintett</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2083">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av piano, 2 violiner, viola och violoncell.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: piano, 2 viulua, alttoviulu, sello.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">pianokvintett</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pianokvintetti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2084">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">instrumentalband</skos:altLabel>
    <skos:altLabel xml:lang="sv">instrumentalgrupp</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1100"/>
    <skos:definition xml:lang="sv">Ensemble bestående av en besättning på 2-9 instrumentalister.</skos:definition>
    <skos:definition xml:lang="fi">Nimitys 2–9 hengen suuruisille soitinkokoonpanoille.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">instrumentalensemble</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">soitinyhtye</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2085">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av violin, viola och violoncell.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: viulu, alttoviulu, sello.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jousitrio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stråktrio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2086">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m400"/>
    <skos:definition xml:lang="sv">Ensemble bestående av fler än nio personer, ursprungligen avsedd för framförande av västerländsk konstmusik och vars instrumentuppsättning består av stråkinstrument (kan innehålla continuo och några slaginstrument). Fr.o.m. 1900-talet har besättningen använts rikligt också i populärmusik.</skos:definition>
    <skos:definition xml:lang="fi">Länsimaisen taidemusiikin esittämiseen alun perin tarkoitettu yli yhdeksän hengen esityskokoonpano, jonka soittimisto koostuu jousisoittimista (voi sisältää continuon ja muutamia lyömäsoittimia). 1900-luvulta alkaen kokoonpanoa on käytetty runsaasti myös populaarimusiikissa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jousiorkesteri</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stråkorkester</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Jos orkesterissa on mukana myös muihin soitinryhmiin kuuluvia soittimia, mutta kyseessä ei ole täysimittainen sinfoniaorkesteri, katso &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2079'&gt;kamariorkesteri&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om det i orkestern också är med instrument som hör till andra instrumentgrupper, men det inte är frågan om en fullskalig sinfoniorkester, se &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2079'&gt;kammarorkester&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2087">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2084"/>
    <skos:definition xml:lang="sv">Ensemble bestående av flöjt, oboe, klarinett och fagott.</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano: huilu, oboe, klarinetti, fagotti.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puupuhallinkvartetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">träblåskvartett</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2088">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">sånggrupp</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1100"/>
    <skos:definition xml:lang="fi">2-9 laulajan muodostaman esityskokoonpano. Suuremmasta kokoonpanosta katso &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m197'&gt;kuoro&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="sv">Ensemble bestående av 2-9 sångare. För större besättning se &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m197'&gt;kör&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">lauluyhtye</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångensemble</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2089">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m197"/>
    <skos:definition xml:lang="sv">Ensemble som består av endast kvinnliga sångstämmor (sopraner, mezzosopraner och altar).</skos:definition>
    <skos:definition xml:lang="fi">Esityskokoonpano, jossa on vain naisäänisiä laulajia (sopraanoja, mezzosopraanoja ja alttoja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">damkör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">naiskuoro</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2090">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m197"/>
    <skos:definition xml:lang="fi">Kuoro, jonka kaikki jäsenet laulavat samaa stemmaa.</skos:definition>
    <skos:definition xml:lang="sv">Kör, i vilken alla medlemmar sjunger samma stämma.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">unison kör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">unisonokuoro</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2091">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m197"/>
    <skos:definition xml:lang="fi">Kuoro, joka koostuu nuorista, mutta ei enää lapsi-ikäisistä laulajista.</skos:definition>
    <skos:definition xml:lang="sv">Kör som består av ungdomar.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nuorisokuoro</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ungdomskör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2092">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m197"/>
    <skos:definition xml:lang="fi">Kuoro, jossa on vain miesäänisiä laulajia (tenoreita, baritoneja ja bassoja).</skos:definition>
    <skos:definition xml:lang="sv">Kör som består av bara manliga sångstämmor (tenorer, barytoner och basar).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">manskör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mieskuoro</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2093">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m197"/>
    <skos:definition xml:lang="fi">Kuorokokoonpano, jossa on vain lapsiäänisiä laulajia (sopraanoja ja alttoja).</skos:definition>
    <skos:definition xml:lang="sv">Kör som består av bara barns sångstämmor (sopraner och altar).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">barnkör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lapsikuoro</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2094">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p20849"/>
    <skos:definition xml:lang="sv">Greves maka; greves dotter (som är eller har varit gift).</skos:definition>
    <skos:definition xml:lang="fi">Kreivin puoliso; (naimisissa oleva tai ollut) kreivin tytär.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">grevinna</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kreivitär</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2095">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p21276"/>
    <skos:definition xml:lang="fi">Eräiden ylhäisten aatelissukujen päämies tai miespuolinen jäsen, eräiden pienten valtioiden hallitsijasta; yleensä miespuolinen hallitsija tai hallitsijahuoneen jäsen.</skos:definition>
    <skos:definition xml:lang="sv">Huvudman för eller manlig medlem i vissa förnäma adelssläkter, om vissa mindre staters regent; vanligen manlig regent eller medlem i furstehus.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">furste</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ruhtinas</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2098">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:example xml:lang="fi">1 laatikko (5 opetustaulua)</skos:example>
    <skos:example xml:lang="sv">1 låda (5 skolplanscher)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laatikko</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">låda</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2099">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, består av låda som innehåller inbundna eller oinbundna resurser.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, muodostuu sidottuja tai sitomattomia aineistoja sisältävästä laatikosta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1003"/>
    <skos:example xml:lang="sv">1 fodral (52 spelkort)</skos:example>
    <skos:example xml:lang="fi">Esim. 1 kotelo (25 korttia) tai 1 kotelo (52 pelikorttia)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">case</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fodral</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kotelo</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2100">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4253"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">julkaistu aiemmin erillisinä niteinä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tidigare utgiven i separata volymer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2101">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">planerare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">suunnittelija (suhde)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5770"/>
    <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa kuvailun kohteena olevan teoksen suunnittelusta.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med en person som svarar för planeringen av verket som beskrivs.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">planerare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">suunnittelija</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets skapare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2102">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">designare</skos:altLabel>
    <skos:altLabel xml:lang="sv">designer</skos:altLabel>
    <skos:altLabel xml:lang="sv">formgivare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">industriell formgivare</skos:altLabel>
    <skos:altLabel xml:lang="fi">muotoilija (suhde)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5770"/>
    <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa kuvailun kohteena olevan teoksen muotoilusta.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med en person som svarar för formgivningen av verket som är föremål för beskrivning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">formgivare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muotoilija</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets skapare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2106">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla dikter skrivna av en aktör. Om samlingen inte innehåller alla dikter, anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat runot. Jos kokoelmassa ei ole kaikkia runoja, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Dikter</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Poems</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Runot</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2107">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla libretton som skrivits av samma aktör. Om samlingen inte innehåller alla libretton anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat libretot. Jos kokoelmassa ei ole kaikkia librettoja, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Libretot</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Libretton</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2108">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innehåller alla brev som en aktör skrivit. Om samlingen inte innehåller alla brev anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat kirjeet. Jos kokoelmassa ei ole kaikkia kirjeitä, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Correspondence</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kirjeet</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Korrespondens</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2109">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">Tal (föredrag)</skos:altLabel>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla tal skrivna av en aktör. Om samlingen inte innehåller alla tal anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan pitämät puheet. Jos kokoelmassa ei ole kaikkia puheita, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet 240 10 ‡a Tal. ‡k Urval</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa 240 10 ‡a Puheet. ‡k Valikoima</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Puheet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Speeches</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tal</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m211">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression haastateltava</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression haastateltava (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">interviewee (expression)</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuobjekt i uttryck</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuobjekt i uttryck (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuobjekt i version</skos:altLabel>
    <skos:altLabel xml:lang="fi">version haastateltava</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett verks uttryck, genom att svara en intervjuare, vanligen en journalist, opinionsmätare eller någon annan aktör, som samlar information.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu teoksen ekspression tekemiseen vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jollekin muulle toimijalle, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20047"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastateltava (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">interviewee agent of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuobjekt (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2110">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla skådespel skrivna av en aktör. Om samlingen inte innehåller alla skådespel anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat näytelmät. Jos kokoelmassa ei ole kaikkia näytelmiä, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Dramatik</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Näytelmät</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Plays</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2113">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla prosaverk skrivna av samma aktör. Om samlingen inte innehåller alla prosaverk anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat proosateokset. Jos kokoelmassa ei ole kaikkia proosateoksia, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Proosateokset</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Prosa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Prose works</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2114">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla sångtexter skrivna av en aktör. Om samlingen inte innehåller alla sångtexter anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat sanoitukset. Jos kokoelmassa ei ole kaikkia sanoituksia, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Lyrics</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Sanoitukset</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Sångtexter</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2117">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla romaner skrivna av en aktör. Om samlingen inte innehåller alla romaner anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat romaanit. Jos kokoelmassa ei ole kaikkia romaaneja, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Novels</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Romaanit</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Romaner</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2120">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla essäer skrivna av en aktör. Om samlingen inte innehåller alla essäer anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat esseet. Jos kokoelmassa ei ole kaikkia esseitä, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Essays</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Esseet</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Essäer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2122">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innefattar alla noveller skrivna av samma aktör. Om samlingen inte innehåller alla noveller anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat novellit. Jos kokoelmassa ei ole kaikkia novelleja, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Noveller</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Novellit</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Short stories</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2125">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet som utgörs av lösa kort som förvaras tillsammans i en packe.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, joka on muodostuu irrallisten korttien säilyttämiseen pakkana.</skos:definition>
    <skos:example xml:lang="sv">302 sidor : illustrerad ; 25 cm + 1 kortlek (78 kort)</skos:example>
    <skos:example xml:lang="fi">302 sivua : kuvitettu ; 25 cm + 1 korttipakka (78 korttia)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kortlek</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">korttipakka</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2127">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4332"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bilaga till</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liitteenä aineistossa</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">RDA-kuvailussa käytettävä termi.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Termen används i RDA-beskrivning.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2128">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet som är en skalenlig framställning av skärningspunkten mellan en vertikal yta och markytan, eller skärningspunkten mellan en sådan vertikal yta och en tredimensionell modell som representerar fenomen med kontinuerlig utbredning.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö on mittakaavassa esitetty poikkileikkaus pystysuorasta pinnasta, joka voi olla tasossa oleva kuvaus maanpinnasta tai liittyä jatkuvasti jakautuvien ilmiöiden kolmiulotteiseen malliin.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1031"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">profiili</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">profil</skos:prefLabel>
    <skos:prefLabel xml:lang="en">profile</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2129">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, textstycke som utgör en del av vertikal indelning av sidans text i två eller flera stycken.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kahdelle tai useammalle pystysuoralle saman sivun osalle jaetun tekstin yksi pystysuora osa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">column</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kolumn</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">palsta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2132">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4253"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">painettu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckt</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">RDA-kuvailussa käytettävä termi.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Termen används i RDA-beskrivning.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2134">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">konditionsredskap</skos:altLabel>
    <skos:altLabel xml:lang="sv">träningsredskap</skos:altLabel>
    <skos:example xml:lang="fi">1 kuntoiluväline</skos:example>
    <skos:example xml:lang="sv">1 motionsredskap</skos:example>
    <skos:example xml:lang="fi">3 kuntoiluvälinettä (1 kahvakuula, 2 käsipainoa)</skos:example>
    <skos:example xml:lang="sv">3 motionsredskap (1 kettlebell, 2 hantlar)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuntoiluväline</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">motionsredskap</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Allmän term eller mer specifika termer kan användas, t.ex. kettlebell, hantlar etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää yleistermiä tai tarkempia termejä, esim. kahvakuula, käsipaino jne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2136">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">portfolio</skos:altLabel>
    <skos:definition xml:lang="sv">Enhet, som är fodral för förvaring av löst material. Utgörs vanligen av två pärmar som är förenade i ryggen.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, joka on kotelo irrallisen aineiston säilyttämiseen. Koostuu yleensä kahdesta kannesta jotka on liitetty takana yhteen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1027"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kansio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mapp</skos:prefLabel>
    <skos:prefLabel xml:lang="en">portfolio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2137">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">digital reproduktion av tryck</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4296"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">digitalisering av tryck</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">digitoitu painetusta</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">RDA-kuvailussa käytettävä termi.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Termen används i RDA-beskrivning.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2138">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arbetsverktyg</skos:altLabel>
    <skos:example xml:lang="sv">3 arbetsredskap</skos:example>
    <skos:example xml:lang="sv">3 arbetsredskap (1 såg, 1 trädgårdssax)</skos:example>
    <skos:example xml:lang="fi">3 työvälinettä</skos:example>
    <skos:example xml:lang="fi">3 työvälinettä (1 saha, 1 puutarhasakset)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arbetsredskap</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">työväline</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Allmän term eller mer specifika termer kan användas, t.ex. såg, trädgårdssax etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää yleistermiä tai tarkempia termejä, esim. roskapihdit, puutarhasakset jne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2139">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet som är ett ark som sammanbundits eller på annat sätt sammanfogats till en underordnad enhet av en volym. Ett blad består av sidorna på bägge sidor av bladet, av vilka en eller bägge kan vara tomma.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö on niteen alayksiköksi sidottu tai muuten kiinnitetty yksittäinen arkki. Lehti koostuu lehden kahdella puolelle sijoittuvista sivuista, joista jompikumpi tai molemmat voivat olla tyhjiä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1018"/>
    <skos:example xml:lang="sv">21 blad, 1 folder : illustrationer ; 44 cm</skos:example>
    <skos:example xml:lang="fi">21 lehteä, 1 taitelehti : kuvitettu ; 44 cm</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blad</skos:prefLabel>
    <skos:prefLabel xml:lang="en">leaf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lehti</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Monikossa lehteä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m214">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">edge track</skos:altLabel>
    <skos:definition xml:lang="sv">Ljudspår som placerats nära filmrullens kant.</skos:definition>
    <skos:definition xml:lang="fi">Ääniraita, joka on sijoitettu lähelle filmirullan reunaa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/trackConfig/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">edge track</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">edge track</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kantspår</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2141">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, omfattar den ena ytan av ett tvåsidigt blad.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, muodostuu lehden yhdestä puolesta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1023"/>
    <skos:example xml:lang="sv">1 nätresurs (34 sidor)</skos:example>
    <skos:example xml:lang="fi">1 verkkoaineisto (34 sivua)</skos:example>
    <skos:example xml:lang="sv">66 sidor : illustrationer, kartor ; 28 cm</skos:example>
    <skos:example xml:lang="fi">66 sivua : kuvitettu, karttoja ; 28 cm</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">page</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sida</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sivu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m215">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Föremål format som en rulle, på vars yta ljudsignaler skurits eller ristats in i ett enhetligt, cirkulärt spår. T.ex. vaxcylinder.</skos:definition>
    <skos:definition xml:lang="fi">Rullamainen esine, jonka pintaan on kaiverrettu tai uurrettu äänisignaaleja yhtenäiseksi kiertäväksi uraksi. Esim. vahasylinterit yms.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio cylinder</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudcylinder</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänisylinteri</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m217">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Layout molemmin puolin arkkia.</skos:definition>
    <skos:definition xml:lang="sv">Layout på båda sidorna av ett ark.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">double sided</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dubbelsidig</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaksipuolinen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2178">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">exemplar tillägnat</skos:altLabel>
    <skos:altLabel xml:lang="sv">festskriftsföremål</skos:altLabel>
    <skos:altLabel xml:lang="en">honoree of item</skos:altLabel>
    <skos:altLabel xml:lang="en">honouree (item)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kappaleella kunnioitettu</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5810"/>
    <skos:definition xml:lang="sv">Aktör som är tillägnad ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jota kappaleella kunnioitetaan. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40022"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">exemplar tillägnat aktören</skos:prefLabel>
    <skos:prefLabel xml:lang="en">honouree agent of item</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleella kunnioitettu toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m218">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Läpinäkyvänä tai värillisenä pinnoitteena käytettävä materiaali, joka koostuu haihtuvien orgaanisten yhdisteiden tai muista liuoksista muodostetuista polyymeereistä tai akryyliyhdisteistä. Muodostaa kuivuneena kovan ja kestävän pinnan.</skos:definition>
    <skos:definition xml:lang="sv">Transparent eller färgat material använt som ytbeläggning, som består av avdunstande organiska föreningar eller polymerer och akrylföreningar som består av andra lösningar. Bildar som torkad en hård och beständig yta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1019"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lack</skos:prefLabel>
    <skos:prefLabel xml:lang="en">lacquer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lakka</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2181">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">festskriftsföremål</skos:altLabel>
    <skos:altLabel xml:lang="en">honoree agent of work</skos:altLabel>
    <skos:altLabel xml:lang="en">honouree</skos:altLabel>
    <skos:altLabel xml:lang="fi">kunnianosoituksen kohde</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksella kunnioitettu</skos:altLabel>
    <skos:altLabel xml:lang="sv">verk tillägnat</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5482"/>
    <skos:definition xml:lang="sv">Aktör till vilkens ära ett verk har gjorts.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jonka kunniaksi teos on tehty. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10049"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">honouree agent of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksella kunnioitettu toimija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verk tillägnat aktören</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2194">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1564"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2214"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2215"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2216"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2217"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2218"/>
    <skos:prefLabel xml:lang="en">Educational level</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Opiskelutaso</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Utbildningsnivå</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver utbildningsnivå hos medlemmar av en grupp (t.ex. vuxenstudier, grundskola, gymnasium).</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten opiskelutasoa kuvaavia termejä (esim. aikuisopiskelu, peruskoulu, lukio).</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2195">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="fi">Kieli</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Language</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Språk</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver språk hos medlemmar av en grupp (t.ex. engelskspråkiga, svenskspråkiga, finskspråkiga) ur ALLFO &lt;a href='http://www.yso.fi/onto/yso/p2200'&gt;roll relaterad till språk&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten kielellisyyttä kuvaavia termejä (esim. englanninkieliset, ruotsinkieliset, suomenkieliset) YSO-sanastosta &lt;a href='http://www.yso.fi/onto/yso/p2200'&gt;kieleen liittyvä rooli&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2196">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1088"/>
    <skos:prefLabel xml:lang="en">Age</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Ikä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Ålder</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver kronologisk ålder hos medlemmar av en grupp (t.ex. Åldersrekommendation: för över 3-åringar). Även termer ur ALLFO kan användas &lt;a href='http://www.yso.fi/onto/yso/p5591'&gt;roll relaterad till ålder&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten kronologista ikää kuvaavia termejä (esim. Ikäsuositus: yli 3-vuotiaille). Voidaan käyttää myös YSOn termejä &lt;a href='http://www.yso.fi/onto/yso/p5591'&gt;ikään liittyvä rooli&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m22">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">MPEG-4</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">MPEG-4</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m220">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30203"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">parallel title proper</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">parallell huvudtitel</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rinnakkainen päänimeke</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Huvudtitel på ett annat språk och/eller skriftsystem.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Päänimeke toisella kielellä ja/tai kirjoitusjärjestelmällä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2206">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">mykkä</skos:altLabel>
    <skos:altLabel xml:lang="sv">stum</skos:altLabel>
    <skos:altLabel xml:lang="sv">tyst</skos:altLabel>
    <skos:definition xml:lang="sv">Uppgift om ljudinnehåll för resurser som inte innehåller ljud.</skos:definition>
    <skos:definition xml:lang="fi">Äänisisältömerkintä aineistolle, joka ei sisällä ääntä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/soundCont/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljudlös</skos:prefLabel>
    <skos:prefLabel xml:lang="en">silent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänetön</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2207">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30454"/>
    <skos:definition xml:lang="fi">Liittää manifestaation ilmaukseen manifestaation sisältämän äänen mukanaolosta tai puuttumisesta.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med en uppgift om ljud som manifestationen innehåller, eller som den saknar.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2206"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2208"/>
    <skos:prefLabel xml:lang="sv">Ljudinnehåll</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Sound content</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Äänisisältö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2208">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Uppgift om ljudinnehåll för resurser som innehåller ljud.</skos:definition>
    <skos:definition xml:lang="fi">Äänisisältömerkintä aineistolle, joka sisältää ääntä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/soundCont/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljud</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sound</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääni</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2209">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">För att identifiera ett objekt i vilket två eller flera verk eller delar av verk ingår används auktoriserad sökterm eller grupptitel, följd av ordet Urval. Urval kan också användas som föredragen titel för att identifiera två eller flera onumrerade delar eller delar som inte är efterföljande.</skos:definition>
    <skos:definition xml:lang="fi">Kahta tai usempaa kohteeseen sisältyvää teosta tai teoksen osaa identifioidessa merkitään auktorisoitu hakutieto tai vakiintunut kokoava nimeke, jota seuraa sana Valikoima. Valikoima voidaan merkitä myös kahta tai useampaa numeroimatonta tai muuta kuin peräkkäistä osaa identifioitaessa osien ensisijaiseksi nimekkeeksi</skos:definition>
    <skos:example xml:lang="fi">Homeros. Ilias. Valikoima.</skos:example>
    <skos:example xml:lang="sv">Homeros. Illiaden. Urval.</skos:example>
    <skos:example xml:lang="fi">Sullivan, Arthur, 1842-1900. Oopperat. Valikoima. Libretot.</skos:example>
    <skos:example xml:lang="sv">Sullivan, Arthur, 1842-1900. Operor. Urval. Libretton.</skos:example>
    <skos:example xml:lang="fi">The Simpsons (televisio-ohjelma). Valikoima.</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Urval</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Valikoima</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2210">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Myönnetään suomen- tai ruotsinkieliselle lastenkirjalle, jonka kohderyhmänä ovat 6-9-vuotiaat lapset. Palkinto myönnettiin ensimmäisen kerran 5.2.2017</skos:definition>
    <skos:definition xml:lang="sv">Priset tilldelas en finsk- eller svenskspråkig barnbok som riktas till åldergruppen 6-9 år. Det utdelades första gången den 5.2.2017.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Runeberg Junior-priset, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Runeberg Junior -palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Runeberg Junior -palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Runeberg Junior-priset</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2212">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
