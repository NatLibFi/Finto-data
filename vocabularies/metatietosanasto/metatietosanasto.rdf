    <skos:definition xml:lang="fi">Aggregaattiin osallinen toimija, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Aktör som bidragit till ett aggregat och skapat ett uttryck av ett talverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30331"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till tal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent of speech</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puheeseen osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5439">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bidragsgivare (agent) till aggregat</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5669"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett verks uttryck som ingår i ett aggregat.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa aggregaattiin sisältyvän teoksen ekspression luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30327"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aggregaattiin osallinen toimija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till aggregat</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent to aggregate</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5440">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5457"/>
    <skos:altLabel xml:lang="fi">ekspression toteuttama teos</skos:altLabel>
    <skos:altLabel xml:lang="sv">verk förverkligat i uttryck</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5513"/>
    <skos:definition xml:lang="fi">Teos, joka toteutuu ekspression kautta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som förverkligas genom ett uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20231"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">teos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verk</skos:prefLabel>
    <skos:prefLabel xml:lang="en">work expressed</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5441">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelningstekniker (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen äänittäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän äänityksen teknistä toteutusta valvova henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som övervakar det tekniska förverkligandet av en ljudinspelning som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelningstekniker för musik</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikin äänittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5442">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5097"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen henkilö, joka on luonut aggregaattiin sisältyvän musiikkiteoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat och skapat ett musikverks uttryck som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30341"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (person) till musik</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor person of music</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikkiin osallinen henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5443">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5444"/>
    <skos:altLabel xml:lang="fi">kritiikki ekspressiosta</skos:altLabel>
    <skos:altLabel xml:lang="sv">kritik av uttrycket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5518"/>
    <skos:definition xml:lang="fi">Ekspressio, johon kriittinen arviointi perustuu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som en kritisk bedömning grundar sig på.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10281"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">critique of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kritiikki versiosta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kritik av versionen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5444">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5443"/>
    <skos:altLabel xml:lang="en">critiqued in (expression)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression kritiikki</skos:altLabel>
    <skos:altLabel xml:lang="sv">kritik av uttrycket i</skos:altLabel>
    <skos:altLabel xml:lang="sv">kritiserad i verket (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kritisoitu teoksessa (ekspressio)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5762"/>
    <skos:definition xml:lang="fi">Teos, joka on ekspression kriittinen arviointi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en kritisk utvärdering av ett uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20272"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">expression critiqued by</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kritik av versionen i</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">version kritiikki</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5445">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression tekijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare (person) av uttryck</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5932"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa teoksen toteutuksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för förverkligandet av ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20389"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">creator person of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av version</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen version tekijä</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ekspression tekijään kuuluvat kääntäjä, sovittaja, esittäjä jne. Ekspression toteuttaman teoksen tekijä on myös ekspression tekijä. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till skapare av ett uttryck hör översättare, arrangör, framförande aktör etc. Skapare av ett verk som förverkligas av ett uttryck är också skapare av ett uttryck.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5446">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5541"/>
    <skos:altLabel xml:lang="en">finding aid of, hierarchic</skos:altLabel>
    <skos:altLabel xml:lang="sv">hierarkisk förteckning till manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="fi">hierarkkinen luettelo manifestaatiolle</skos:altLabel>
    <skos:altLabel xml:lang="fi">luettelo manifestaatiolle, hierarkkinen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5422"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on kokoelmamanifestaatio, jolla on siihen kuuluvia alakokoelmia ja kappaleita koskeva metatietokokonaisuus. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en samlingsmanifestation och som har en metadatahelhet som rör delsamlingar och exemplar som ingår i den.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10626"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">hierarchic finding aid of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">hierarkisk förteckning till materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">hierarkkinen luettelo aineistolle</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kokoelmaan kuuluu arkistokokoelma. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till samling hör en arkivsamling.</skos:scopeNote>
  </owl:Class>
