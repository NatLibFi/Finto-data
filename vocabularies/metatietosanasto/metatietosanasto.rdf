    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasFosterChild"/>
    <skos:definition xml:lang="sv">Barn som en beskriven person fostrat, men som inte är personens biologiska barn.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön kasvattama lapsi, joka ei ole hänen biologinen lapsensa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
