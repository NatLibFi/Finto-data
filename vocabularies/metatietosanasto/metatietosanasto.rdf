    <skos:altLabel xml:lang="sv">samlare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett samlingsverk, genom att välja och ordna exemplar som representerar uttryck för andra verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka vastaa kokoelmateoksen luomisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10629"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">collector agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kokoelman muodostaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">samlare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5495">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5924"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5702"/>
    <skos:definition xml:lang="fi">Teos, jolla on toiminta-ala tai toimituslinja, jota on muutettu teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk med ett verksamhetsfält eller en redaktionell linje, som har ändrats för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10345"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2275"/>
    <skos:prefLabel xml:lang="fi">muunnos linjassa teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by policy of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av policy för verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5496">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">designer (institution) som är bidragsgivare till föremål</skos:altLabel>
    <skos:altLabel xml:lang="fi">esineeseen osallinen designer (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5337"/>
    <skos:definition xml:lang="fi">Aggregaattiin liittyvän kohteen suunnitellut tai muotoillut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som designat eller formgett ett objekt som relaterar till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">designer</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">designer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5497">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjoittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett textverk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa tekstiteoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10530"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">author corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjoittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar skapandet av ett nytt verk genom att omarbeta, redigera eller arrangera ett verk av en annan upphovsperson, såvida ändringen väsentligen har ändrat originalets karaktär och innehåll eller uttrycksform.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5498">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">musiikillinen johtaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikalisk ledare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att koordinera kompositörers, ljudklippares och ljudmixares verksamhet i en filmproduktion eller i ett musikaliskt eller sceniskt uppförande.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20460"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">musical director corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikillinen johtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikalisk ledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5499">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5805"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett sådant uttryck som är ett framförande.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu sellaisen ekspression tekemiseen, joka on esitys. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20484"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (institution) till framförande</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor corporate body to performance</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">esitykseen osallinen yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m55">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bildtavla</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvataulu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5500">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">lärare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">opettaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen opettamalla tai pitämällä havaintoesityksen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare, som deltar i utförandet av ett uttryck, genom att undervisa eller hålla en demonstration.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20381"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">instructor person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">lärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opettaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5501">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">landskapsarkitekt (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">maisema-arkkitehti (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5273"/>
    <skos:definition xml:lang="fi">Henkilö, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta. (RDA Registry)</skos:definition>
