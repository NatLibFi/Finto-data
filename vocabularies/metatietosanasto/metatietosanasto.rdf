    <skos:prefLabel xml:lang="sv">institutionsmedlem i institutionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisön yhteisöjäsen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4459">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5389"/>
    <skos:definition xml:lang="sv">Institution som är en konferens, som arrangeras tillsammans med en annan konferens.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on konferenssi, joka järjestetään yhdessä toisen konferenssin kanssa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50303"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">gemensam konferens</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jointly held conference</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteiskonferenssi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4460">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">audio producer</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljudproducent (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">äänituottaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1298"/>
    <skos:definition xml:lang="sv">Aktör som är en producent, som svarar för skötseln av de flesta kommersiella uppgifterna kring en ljudinspelning.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10304"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio producer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudproducent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänituottaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4461">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">signatär</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som har undertecknat, ratifierat eller anslutit sig till ett fördrag.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on allekirjoittanut, ratifioinut tai liittynyt valtiosopimukseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10292"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">participant in treaty</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">undertecknare av fördrag</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valtiosopimuksen allekirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4467">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">omistaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">owner</skos:altLabel>
    <skos:altLabel xml:lang="sv">ägare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5810"/>
    <skos:definition xml:lang="sv">Aktör som har juridisk äganderätt till ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jolla on kappaleen laillinen omistusoikeus. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40021"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1743"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1768"/>
    <skos:prefLabel xml:lang="fi">omistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">owner agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ägare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4468">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptiteln Verk anges som föredragen titel för en sådan sammanställning av verk som innehåller, eller är avsedd att innehålla, en aktörs samlade verk. Om sammanställningen inte innehåller alla verk anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke Teokset merkitään ensisijaiseksi nimekkeeksi sellaiselle teosten koosteelle, joka sisältää tai jonka on tarkoitus sisältää toimijan kootut teokset. Jos kokoelmassa ei ole kaikkia teoksia, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:example xml:lang="fi">MARC 21 -esimerkki
100 1# ‡a Snellman, Johan Vilhelm, ‡d 1806-1881, ‡e kirjoittaja. ‡0 (FI-ASTERI-N)000059409
240 10 ‡a Teokset</skos:example>
    <skos:example xml:lang="fi">MARC 21 -esimerkki
240 10 ‡a Teokset. ‡k Valikoima, ‡l suomi</skos:example>
    <skos:example xml:lang="sv">MARC 21-exempel
100 1# ‡a Snellman, Johan Vilhelm, ‡d 1806-1881, ‡e författare. ‡0 (FI-ASTERI-N)000059409
240 10 ‡a Verk</skos:example>
    <skos:example xml:lang="sv">MARC 21-exempel
240 10 ‡a Verk. ‡k Urval, ‡l svenska</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Teokset</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Verk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4469">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bevarare</skos:altLabel>
    <skos:altLabel xml:lang="en">custodian</skos:altLabel>
    <skos:altLabel xml:lang="sv">depositarie</skos:altLabel>
    <skos:altLabel xml:lang="sv">förvaltare</skos:altLabel>
    <skos:altLabel xml:lang="sv">förvarare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">säilyttäjä (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5810"/>
    <skos:definition xml:lang="sv">Aktör som har juridisk förvaringsrätt till ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jolla on kappaleen laillinen säilyttämisoikeus. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40020"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">custodian agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förvarare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säilyttäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m447">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll presenterat som streck, former, skuggningar etc. som är avsett att betraktas som en eller flera tvådimensionella stillbilder. Till exempel ritningar, målningar, diagram, fotografier etc. Se även &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m201'&gt;kartografisk bild&lt;/a&gt;, &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m948'&gt;taktil bild&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Viivoina, muotoina, varjostuksina jne. esitetty sisältö, joka on tarkoitettu katsottavaksi kaksiulotteisena stillkuvana tai -kuvina. Esimerkiksi piirrokset, maalaukset, diagrammit, valokuvat jne.
Katso myös &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m201'&gt;kartografinen kuva&lt;/a&gt;, &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m948'&gt;taktiili kuva&lt;/a&gt;.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1014"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">still image</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stillbild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">stillkuva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m448">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">instructor</skos:altLabel>
    <skos:altLabel xml:lang="sv">lärare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">lärare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">opettaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">opettaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare, som deltar i utförandet av ett uttryck, genom att undervisa eller hålla en demonstration.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen opettamalla tai pitämällä havaintoesityksen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">instructor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">lärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opettaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4498">
    <dc11:source xml:lang="sv">ALLFO-term</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <dc11:source xml:lang="fi">YSO-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p23164"/>
    <skos:definition xml:lang="sv">Professionella specialister inom organisations- och ungdomsarbete, som kan arbeta i kommuner, organisationer, anstalter och företag som handledare, utbildare, planerare och koordinatorer.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisöpedagogit ovat järjestö- ja nuorisotyön ammattilaisia ja asiantuntijoita, jotka työskentelevät kunnissa, järjestöissä, laitoksissa ja yrityksissä ohjaajina, kouluttajina, suunnittelijoina ja koordinaattoreina. (https://www.humak.fi/opiskelijaksi/yhteisopedagogi/)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">samhällspedagog</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisöpedagogi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m450">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll uttryckt som form eller former avsedda att betraktas som tredimensionella. T.ex. skulpturer, modeller, naturliga föremål, hologram. Se även &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m905'&gt;kartografisk tredimensionell form&lt;/a&gt;, &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1131'&gt;taktil tredimensionell form&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Muotona tai muotoina esitetty sisältö, joka on tarkoitettu katsottavaksi kolmiulotteisena. Esimerkiksi veistokset, mallit, luonnonesineet, hologrammit jne.
Katso myös &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m905'&gt;kartografinen kolmiulotteinen muoto&lt;/a&gt;, &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1131'&gt;taktiili kolmiulotteinen muoto&lt;/a&gt;.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1021"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kolmiulotteinen muoto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">three-dimensional form</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tredimensionell form</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m455">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som visar en persons eller släkts härkomst i form av en tabell eller schematisk bild.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka esittää taulukon tai kaavion muodossa henkilön tai suvun sukujuuret.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">genealogical table</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släkttavla</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukutaulu</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: släkttavlor, xx släkttavlor</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: sukutauluja, xx sukutaulua</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4574">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30184"/>
    <skos:definition xml:lang="fi">Liittää manifestaation äänityksessä käytettyjen äänikanavien määrään.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med det antal ljudkanaler som använts vid inspelning.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1344"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m145"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m395"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m920"/>
    <skos:prefLabel xml:lang="sv">Antal ljudkanaler</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Configuration of playback channels</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Toistokanavien määrä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4575">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="fi">Seksuaalinen suuntautuneisuus</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Sexual orientation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Sexuell läggning</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver sexuell läggning hos medlemmar i en grupp (t.ex. bisexuella, heterosexuella, homosexuella män, lesbiska). Vid val av enskilda termer används ALLFO-termer ur gruppen &lt;a href='http://www.yso.fi/onto/yso/p487'&gt;roll relaterad till befolkningsgrupp&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten seksuaalista suuntautumista kuvaavia termejä (esim. biseksuaalit, heteroseksuaalit, homot, lesbot). Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä &lt;a href='http://www.yso.fi/onto/yso/p487'&gt;väestöryhmään liittyvä rooli&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4576">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="sv">Hälsa/funktionsförmåga</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Medical, psychological, and disability</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Terveys/toimintakyky</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som anger hälsotillstånd eller funktionsförmåga hos medlemmar av en grupp (t.ex. personer med hörselskada, psykiskt sjuka, klienter i missbrukarrehabilitering, blinda).</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten terveydellistä tilaa tai toimintakykyä kuvaavia termejä (esim. kuulovammaiset, psyykkisesti sairaat, päihdekuntoutujat, sokeat).</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4577">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="fi">Kansallisuus/asuinalue</skos:prefLabel>
    <skos:prefLabel xml:lang="en">National/regional</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Nationalitet/bosättningsområde</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver nationalitet eller geografiskt bosättningsområde för medlemmar i en grupp (t.ex. invånare i Mellersta Finland, sovjetmedborgare, rumäner, finländare, amerikanska medborgare). Om termen som beskriver gruppens etnicitet inte samtidigt är en geografisk term, väljs Etnicitet [eth] som samlande allmänterm. Vid val av enskilda termer används ALLFO-termer ur gruppen &lt;a href='http://www.yso.fi/onto/yso/p487'&gt;roll relaterad till befolkningsgrupp&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten kansallisuutta tai maantieteellistä asuinaluetta kuvaavia termejä (esim. keskisuomalaiset, neuvostoliittolaiset, romanialaiset, suomalaiset, yhdysvaltalaiset). Mikäli ryhmän etnisyyttä kuvaava termi ei ole samalla maantieteellinen termi, valitaan kokoavaksi yleistermiksi Etnisyys [eth]. Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä &lt;a href='http://www.yso.fi/onto/yso/p487'&gt;väestöryhmään liittyvä rooli&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4578">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="en">Religion</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Religion</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Uskonto</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver tillhörighet till en religiös grupp hos medlemmar i en grupp (t.ex. buddhister, katoliker, lutheraner, sikher). Vid val av enskilda termer används ALLFO-termer ur gruppen &lt;a href='http://www.yso.fi/onto/yso/p687'&gt;roll relaterad till religion&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten uskonnolliseen ryhmään kuulumista kuvaavia termejä (esim. buddhalaiset, katoliset, luterilaiset, sikhit). Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä &lt;a href='http://www.yso.fi/onto/yso/p687'&gt;uskontoon liittyvä rooli&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4579">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="en">Ethnic/cultural</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Etnicitet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Etnisyys</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver etnisk identitet hos medlemmar av en grupp (t.ex. basker, finländare i Kanada, romer, sorber, finlandssvenskar, tuareger, estlandssvenskar). Om termen som beskriver en grupps etnicitet också är en geografisk term, väljs Nationalitet/bosättningsområde [nat] som samlande allmänterm. Vid val av enskilda termer används ALLFO-termer ur gruppen &lt;a href='http://www.yso.fi/onto/yso/p487'&gt;roll relaterad till befolkningsgrupp&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten etnistä identiteettiä kuvaavia termejä (esim. baskit, kanadansuomalaiset, romanit, sorbit, suomenruotsalaiset, tuaregit, vironruotsalaiset). Mikäli ryhmän etnisyyttä kuvaava termi on myös maantieteellinen termi, valitaan kokoavaksi yleistermiksi Kansallisuus/asuinalue [nat]. Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä &lt;a href='http://www.yso.fi/onto/yso/p487'&gt;väestöryhmään liittyvä rooli&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4580">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">Predikosamlingar</skos:altLabel>
    <skos:definition xml:lang="sv">Grupptitel för en samling som omfattar alla predikningar en aktör har hållit. Om samlingen inte innehåller alla predikningar anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan pitämät saarnat. Jos kokoelmassa ei ole kaikkia puheita. tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21 -formatet 240 10 ‡a Predikningar. ‡k Urval</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa 240 10 ‡a Saarnat. ‡k Valikoima</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Predikningar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Saarnat</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Sermons</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4581">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innehåller alla tecknade serier som en aktör gjort. Om samlingen inte innehåller alla serier anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kirjoittamat sarjakuvat. Jos kokoelmassa ei ole kaikkia sarjakuvia, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Sarjakuvat</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tecknade serier</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4582">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Grupptitel för en samling som innehåller alla sagor som en aktör skrivit. Om samlingen inte omfattar alla sagor anges också termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Urval&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Vakiintunut kokoava nimeke kokoelmalle, joka käsittää kaikki toimijan kertomat sadut. Jos kokoelmassa ei ole kaikkia satuja, tietoon lisätään termi &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2209'&gt;Valikoima&lt;/a&gt;.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet 240 10 ‡a Sagor. ‡k Urval</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa 240 10 ‡a Sadut. ‡k Valikoima</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Sadut</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Sagor</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4584">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4585"/>
    <skos:altLabel xml:lang="sv">intertextuell hänvisning baserad på (uttryck)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1117"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">intertekstuaalisen viittauksen perustana (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intertextuell referens baserad på (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4585">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4584"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m731"/>
    <skos:example xml:lang="sv">I MARC 21 -formatet:
700 1# ‡i Intertextuell relation (uttryck): ‡a Perec, Georges. ‡t Talvinen matka, ‡l finska.</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa:
700 1# ‡i Intertekstuaalinen suhde (ekspressio): ‡a Perec, Georges. ‡t Talvinen matka, ‡l suomi.</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">intertekstuaalinen suhde (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intertextuell relation (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4589">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nettiohjelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">nätprogram</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Kan användas när den ursprungliga distributionskanalen för ett program eller en programserie är internet.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää kun ohjelman tai ohjelmasarjan alkuperäinen levityskanava on ollut internet.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4590">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">säätävä lainkäyttöalue</skos:altLabel>
    <skos:altLabel xml:lang="sv">verkställande jurisdiktion</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som är stadgande förvaltningsorgan för ett verk som är en lag, en förordning, en grundlag, en regel som gäller domstol, eller någon annan rättsakt.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on teoksen, joka on laki, asetus, perustuslaki, tuomioistuinta koskeva sääntö tai muu säädös, säätävä hallintoelin. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10017"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">enacting government</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stadgande förvaltningsorgan</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säätävä hallintoelin</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4593">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Pro Oeconomia</skos:altLabel>
    <skos:altLabel xml:lang="sv">Pro Oeconomia</skos:altLabel>
    <skos:definition xml:lang="sv">Finlands Ekonomers litteraturpris utdelas ungefär vartannat år till den bästa finländska företagsboken. Fram till år 2008 var prisets namn Pro Oeconomia.</skos:definition>
    <skos:definition xml:lang="fi">Suomen Ekonomien kirjallisuuspalkinto jaetaan noin kahden vuoden välein parhaalle suomalaiselle yrityskirjalle. Vuoteen 2008 asti palkinnon nimi oli Pro Oeconomia.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Finlands Ekonomers litteraturpris, 2008</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Suomen Ekonomien kirjallisuuspalkinto, 2008</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Finlands Ekonomers litteraturpris</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Suomen Ekonomien kirjallisuuspalkinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4594">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmat framförande</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">filmat framträdande</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">videoitu esitys</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4595">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">musiikkivideo</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikvideo</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4596">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">anställd (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">työntekijä (suhde)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m746"/>
    <skos:definition xml:lang="fi">Henkilö, joka on työntekijänä yhteisössä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är arbetstagare i en institution.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50026"/>
