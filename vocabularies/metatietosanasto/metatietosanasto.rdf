    <skos:definition xml:lang="sv">Verk som relaterar till ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40069"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleeseen liittyvä teos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related work of item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verk relaterat till exemplaret</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5292">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
