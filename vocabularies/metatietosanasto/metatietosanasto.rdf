    <skos:prefLabel xml:lang="fi">viranomainen</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kunnallisista viranomaisista käytä termiä: &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m604'&gt;kunta&lt;/a&gt;, &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4703'&gt;kuntayhtymä&lt;/a&gt; tai &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m358'&gt;kaupunki&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om kommunala myndigheter används termen: &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m604'&gt;kommun&lt;/a&gt;, &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4703'&gt;samkommun&lt;/a&gt; eller &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m358'&gt;stad&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4670">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">laajennettu piispainkokous</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p19691"/>
    <skos:definition xml:lang="sv">Kyrkligt förvaltningsorgan bestående av biskopar.</skos:definition>
    <skos:definition xml:lang="fi">Piispojen muodostama kirkollinen hallintoelin.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">biskopsmöte</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piispainkokous</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4671">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p20801"/>
    <skos:definition xml:lang="sv">Militär operativ enhet.</skos:definition>
    <skos:definition xml:lang="fi">Nykyaikaisissa asevoimissa pienin itsenäisiin sotatoimiin pystyvä armeijan sotatoimiyhtymä (Wikipedia).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">brigad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">prikaati</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4672">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">domsaga (underrätt)</skos:altLabel>
    <skos:altLabel xml:lang="sv">häradsrätt</skos:altLabel>
    <skos:altLabel xml:lang="fi">kihlakunnanoikeus</skos:altLabel>
    <skos:altLabel xml:lang="fi">käräjäoikeus</skos:altLabel>
    <skos:altLabel xml:lang="fi">raastuvanoikeus</skos:altLabel>
    <skos:altLabel xml:lang="sv">rådstuvurätt</skos:altLabel>
    <skos:altLabel xml:lang="sv">tingsrätt</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuomiokunta (alioikeus)</skos:altLabel>
    <skos:altLabel xml:lang="sv">underdomstol</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1646"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5023"/>
    <skos:definition xml:lang="sv">Allmän underrätt. Lägsta instans i domstolsväsendet. I Finland fungerar tingsrätter sedan år 1993 som allmänna underrätter, i vilka tviste- och brottsmål vanligen inleds.</skos:definition>
    <skos:definition xml:lang="fi">Yleinen alioikeus. Alioikeus on oikeuslaitoksen alin oikeusaste. Suomessa yleisinä alioikeuksina ovat vuodesta 1993 lähtien toimineet käräjäoikeudet, joissa riita- ja rikosasiat yleensä pannaan vireille. (Wikipedia.)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alioikeus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">underrätt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4673">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">lasarett</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1090"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sairaala</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sjukhus</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4687"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4674">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fältdomstol</skos:altLabel>
    <skos:altLabel xml:lang="sv">fältkrigsrätt</skos:altLabel>
    <skos:altLabel xml:lang="fi">kenttäoikeus</skos:altLabel>
    <skos:altLabel xml:lang="sv">krigsrätt</skos:altLabel>
    <skos:altLabel xml:lang="fi">sotaoikeus</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1646"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12264"/>
    <skos:definition xml:lang="sv">Domstol under krigstid, som behandlar främst militära brott.</skos:definition>
    <skos:definition xml:lang="fi">Sodanaikainen lähinnä sotilasrikoksia käsittelevä tuomioistuin.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">krigsdomstol</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sotatuomioistuin</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4675">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40318"/>
    <skos:definition xml:lang="fi">Ilmavoimien sotilasyksikkö, johon kuuluu useampi lentokone, niiden miehistö ja kenttähenkilöstö (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Militär enhet inom flygvapnet, till vilken hör flera flygplan, manskap och fältpersonal.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">flyggrupp</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lentue</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4676">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">siirtoseurakunta</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3029"/>
    <skos:definition xml:lang="fi">Itsehallinnollinen kirkollinen yhdyskunta, jolla on julkisoikeudellinen asema.</skos:definition>
    <skos:definition xml:lang="sv">Självstyrt kyrkligt samfund, som har en offentligrättslig ställning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">församling</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">seurakunta</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används om församlingar inom evangelisk-lutherska kyrkan och ortodoxa kyrkan i Finland.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään Suomen evankelis-luterilaisen ja ortodoksisen kirkon seurakunnista.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4677">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ala-alkeiskoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">flickskola</skos:altLabel>
    <skos:altLabel xml:lang="fi">kansalaiskoulu (oppikoulu)</skos:altLabel>
    <skos:altLabel xml:lang="fi">keskikoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">lyceum</skos:altLabel>
    <skos:altLabel xml:lang="fi">lyseo (oppikoulu)</skos:altLabel>
    <skos:altLabel xml:lang="sv">lärdomsskola</skos:altLabel>
    <skos:altLabel xml:lang="sv">medborgarskola (läroverk)</skos:altLabel>
    <skos:altLabel xml:lang="sv">mellanskola</skos:altLabel>
    <skos:altLabel xml:lang="fi">reaalikoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">realskola</skos:altLabel>
    <skos:altLabel xml:lang="sv">samskola</skos:altLabel>
    <skos:altLabel xml:lang="fi">triviaalikoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">trivialskola</skos:altLabel>
    <skos:altLabel xml:lang="fi">tyttökoulu</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhteiskoulu</skos:altLabel>
    <skos:altLabel xml:lang="fi">yläalkeiskoulu</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p4972"/>
    <skos:definition xml:lang="sv">Läroverk (officiellt även lärdomsskola) var i Finland statliga, kommunala eller privata läroinrättningar som grundats för högre skolbildning, och som kunde bestå av mellanskola och gymnasium. I sin helhet utgjorde läroverk en åttaårig utbildning. Läroverket som skolform upphävdes i samband med grundskolereformen på 1970-talet.</skos:definition>
    <skos:definition xml:lang="fi">Oppikoulu oli Suomessa ennen peruskoulu-uudistuksen voimaantuloa valtioneuvoston luvalla ylempää koulusivistystä varten perustettu valtion, kunnallinen tai yksityinen oppilaitos, johon voivat kuulua ylioppilastutkintoon johtava ja sitä kautta korkeakouluopintoihin valmentava lukio, sekä keskiasteen opintoihin oikeuttava keskikoulu. Kokonaisuutena oppikoulu oli kahdeksanvuotinen oppilaitos, joka lakkautettiin peruskoulu-uudistuksen yhteydessä 1970-luvulla. (Wikipedia.)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">läroverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">oppikoulu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4678">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förband</skos:altLabel>
    <skos:altLabel xml:lang="fi">joukko-osasto</skos:altLabel>
    <skos:altLabel xml:lang="fi">joukkue</skos:altLabel>
    <skos:altLabel xml:lang="sv">militärenhet</skos:altLabel>
    <skos:altLabel xml:lang="sv">militärpatrull</skos:altLabel>
    <skos:altLabel xml:lang="sv">pluton</skos:altLabel>
    <skos:altLabel xml:lang="fi">sotilaspartio</skos:altLabel>
    <skos:altLabel xml:lang="fi">sotilasryhmä</skos:altLabel>
    <skos:altLabel xml:lang="sv">stridsgrupp</skos:altLabel>
    <skos:altLabel xml:lang="fi">taisteluosasto</skos:altLabel>
    <skos:altLabel xml:lang="sv">truppavdelning</skos:altLabel>
    <skos:altLabel xml:lang="sv">truppförband</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p22577"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3948"/>
    <skos:definition xml:lang="fi">Asevoimien organisaatio.</skos:definition>
    <skos:definition xml:lang="sv">Organisation inom vapenmakt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">militär enhet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sotilasyksikkö</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används när närmare beskrivande termer för en militär enhet saknas eller inte anses nödvändiga.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään kun tarkempaa sotilasyksikköä kuvaavaa termiä ei ole tai sitä ei nähdä tarpeelliseksi käyttää.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4679">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">konstutställning</skos:altLabel>
    <skos:altLabel xml:lang="fi">taidenäyttely</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m863"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5121"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
