    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5972"/>
    <skos:definition xml:lang="sv">Framförare relaterad till notmaterial.</skos:definition>
    <skos:definition xml:lang="fi">Nuottiaineistoon liittyvä esittäjä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framförare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">performer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4116">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Nuottikirjoituksen tyyppi, jossa käytetään pystysuuntaisesti järjestettyjä numeroita ja symboleja, jotka ilmaisevat harmoniat bassolinjan yläpuolisina intervalleina.</skos:definition>
    <skos:definition xml:lang="sv">Typ av notskrift, med siffror och symboler ordnade vertikalt, som uttrycker harmonier som intervall över en baslinje.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/MusNotation/1014"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">figured bas</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">generalbas</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kenraalibasso</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4117">
