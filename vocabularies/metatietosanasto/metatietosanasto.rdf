  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m28">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Mörkgrått restmaterial som bildas av kol och den aska som blir kvar när vatten och andra avdunstande föreningar ur animaliskt eller vegetabiliskt material avlägsnas.</skos:definition>
    <skos:definition xml:lang="fi">Tummanharmaa jäännösmateriaali, joka muodostuu hiilestä ja jäljelle jääneestä tuhkasta, kun eläin- tai kasviperäisestä aineksesta poistetaan vesi ja muut haihtuvat yhdisteet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">charcoal</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">hiili</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kol</skos:prefLabel>
  </owl:Class>
