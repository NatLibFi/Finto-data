  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3415">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4979"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/c/C10002"/>
    <skos:altLabel xml:lang="sv">Agent</skos:altLabel>
    <skos:definition xml:lang="en">An entity who is capable of deliberate actions, of being granted rights, and of being held accountable for its actions.</skos:definition>
    <skos:definition xml:lang="fi">Entiteetti, joka kykenee tarkoituksellisiin toimintoihin, jolle voidaan myöntää oikeuksia ja joka on vastuussa toimistaan.</skos:definition>
    <skos:definition xml:lang="sv">Entitet som är kapabel till avsiktliga handlingar, som kan beviljas rättigheter och som kan hållas ansvarig för sina handlingar.</skos:definition>
    <skos:prefLabel xml:lang="sv">Aktör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3419">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laajuuden yksikkönä pieni arkki jäykkää paperia, ohutta pahvia tms. läpinäkymätöntä materiaalia.</skos:definition>
    <skos:definition xml:lang="sv">Som enhet litet ark styvt papper, tunn papp e.d. ogenomskinligt material.</skos:definition>
    <skos:example xml:lang="sv">1 fodral (30 kort)</skos:example>
    <skos:example xml:lang="fi">1 kotelo (30 korttia)</skos:example>
    <skos:example xml:lang="sv">302 sidor : illustrationer ; 25 cm + 1 kortlek (78 kort)</skos:example>
    <skos:example xml:lang="fi">302 sivua : kuvitettu ; 25 cm + 1 korttipakka (78 korttia)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kort</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kortti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m342">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">puukaiverrus</skos:altLabel>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken en figur skärs in i ett trästyckes yta som används för trycka.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa kuvio leikataan puukappaleen pintaan ja painetaan puukappaleen pinnasta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puuleikkaus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">träsnitt</skos:prefLabel>
    <skos:prefLabel xml:lang="en">woodcut making</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3420">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3476"/>
    <skos:altLabel xml:lang="sv">sammandrag</skos:altLabel>
    <skos:altLabel xml:lang="sv">sammanfattning (verk)</skos:altLabel>
    <skos:altLabel xml:lang="en">summarized as work</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhteenveto (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5371"/>
    <skos:definition xml:lang="fi">Teos, joka on teoksen lyhyt kuvaus. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en kort beskrivning av ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10109"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2278"/>
    <skos:prefLabel xml:lang="sv">sammanfattning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">summary</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteenveto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3421">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3478"/>
    <skos:altLabel xml:lang="fi">parafraasi (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">parafras (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5526"/>
    <skos:definition xml:lang="fi">Teos, joka toisintaa toisen teoksen sisällön eri muodossa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som återger ett annat verks innehåll i en annan form.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10166"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">parafraasi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">parafras</skos:prefLabel>
    <skos:prefLabel xml:lang="en">paraphrased as work</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3422">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1566"/>
    <skos:altLabel xml:lang="sv">nyproduktion (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">uusintaproduktio (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5526"/>
    <skos:definition xml:lang="fi">Teos, joka on uusi elokuva, radio-ohjelma, televisio-ohjelma tai video, joka perustuu aiempaan teokseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en ny film, ett radioprogram, ett tv-program eller en video, som grundar sig på ett tidigare verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10032"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">nyproduktion</skos:prefLabel>
    <skos:prefLabel xml:lang="en">remade as work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">uusintaproduktio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3423">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2262"/>
    <skos:altLabel xml:lang="fi">runomukaelma (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">versbearbetning (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m743"/>
    <skos:definition xml:lang="fi">Teos, joka on toisesta teoksesta runomuotoon sovitettu teos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är bearbetat till versform utgående från ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10023"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted in verse as work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">runomukaelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">versbearbetning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3424">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3480"/>
    <skos:altLabel xml:lang="sv">musik baserad på texten (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin perustuva musiikki (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m530"/>
    <skos:definition xml:lang="fi">Teos, joka on ei-näytelmällinen musiikkiteos (muu kuin oratorio), jonka teksti on peräisin toisesta teoksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett icke-dramatiskt musikverk (annat än oratorium) och vars text är från ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10033"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">musik baserad på texten</skos:prefLabel>
    <skos:prefLabel xml:lang="en">set to music as work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstiin perustuva musiikki</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3425">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3468"/>
    <skos:altLabel xml:lang="fi">videopelisovitus (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">videospelsbearbetning (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m743"/>
    <skos:definition xml:lang="fi">Teos, joka on videopeli, joka perustuu toiseen teokseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett videospel, som grundar sig på ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10249"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as video game work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">videopelisovitus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">videospelsbearbetning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3426">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laajuuden yksikkönä kehykseen asetettu, projektorin tai diojen katselulaitteen avulla katseltava kaksiulotteinen, läpinäkyvä kuva pienellä läpinäkyvällä arkilla.</skos:definition>
    <skos:definition xml:lang="sv">Som enhet tvådimensionell genomskinlig bild på ett litet genomskinligt ark, som är placerat i en ram och som ska beskådas med hjälp av en projektor eller en visningsapparat för diabilder.</skos:definition>
    <skos:example xml:lang="fi">MARC 21: 300 ## ‡a 19 diaa (9 min) + ‡e 2 CD-äänilevyä, 2 tekstilipuketta (10, 7 sivua)</skos:example>
    <skos:example xml:lang="sv">MARC 21: 300 ## ‡a 19 diabilder (9 min) + ‡e 2 CD-ljudskivor, 2 texthäften (10, 7 sidor)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">dia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">diabild</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3427">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3471"/>
    <skos:altLabel xml:lang="sv">anpassad förkortning (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">mukautettu lyhennelmä (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m530"/>
    <skos:definition xml:lang="fi">Teos, joka systemaattisesti, kokonaisuudessaan ja mukaillen tiivistää siihen liittyvän teoksen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som systematiskt och i sin helhet anpassar och förkortar ett relaterat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10171"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">anpassad förkortning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">digested as work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mukautettu lyhennelmä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3428">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3456"/>
    <skos:altLabel xml:lang="sv">radiobearbetning (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">radiosovitus (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m743"/>
    <skos:definition xml:lang="fi">Teos, joka on toiseen teokseen perustuva radio-ohjelma. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett radioprogram som grundar sig på ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10076"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as radio program work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">radiobearbetning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">radiosovitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3429">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3473"/>
    <skos:altLabel xml:lang="sv">fri översättning (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">vapaamuotoinen käännös (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5526"/>
    <skos:definition xml:lang="fi">Teos, joka on sekä toisen teoksen muokkaus että käännös toiselle kielelle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är både en bearbetning av ett annat verk och en översättning till ett annat språk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10099"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">freely translated as work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fri översättning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vapaamuotoinen käännös</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3431">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m613"/>
    <skos:altLabel xml:lang="fi">romaanimukaelma (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">romanbearbetning (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m743"/>
    <skos:definition xml:lang="fi">Teos, joka on toisesta teoksesta sovitettu romaani. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en roman bearbetad utgående från ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10034"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
