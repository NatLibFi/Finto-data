    <skos:definition xml:lang="sv">Församling representanter med beslutanderätt i en institution.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisössä päätösvaltaa käyttävä edustajisto (Kielitoimiston sanakirja).</skos:definition>
