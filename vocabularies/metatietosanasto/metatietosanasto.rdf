    <skos:prefLabel xml:lang="fi">sarjakuvaversio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tecknad serie-version</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1170">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">producent av tv-program</skos:altLabel>
    <skos:altLabel xml:lang="en">television producer</skos:altLabel>
    <skos:altLabel xml:lang="fi">televisiotuottaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1298"/>
    <skos:definition xml:lang="sv">Aktör som är en producent, som svarar för största delen av affärsverksamheten kring ett tv-program.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on tuottaja, joka on vastuussa suurimmasta osasta televisio-ohjelman liiketoiminnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10075"/>
