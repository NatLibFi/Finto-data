    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3577">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">editorial director</skos:altLabel>
    <skos:altLabel xml:lang="sv">redaktionschef (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimituspäällikkö (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som har ett juridiskt eller kunskapsmässigt ansvar, men inte kreativt ansvar, för ett diakroniskt verks redaktionella linje och innehåll.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10298"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editorial director agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redaktionschef</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimituspäällikkö</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte justering, förtydligande eller annan ändring av innehållet i ett verks uttryck.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3578">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som är åtalad i en straffprocess eller mot vilken talan väckts.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10285"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5407"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5590"/>
    <skos:prefLabel xml:lang="en">defendant corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">institution som svarande</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisövastaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3579">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">person som tilltalad</skos:altLabel>
    <skos:altLabel xml:lang="sv">person som åtalad</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är åtalad i en straffprocess eller mot vilken talan väckts.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10286"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5683"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5769"/>
    <skos:prefLabel xml:lang="en">defendant person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">henkilövastaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">person som svarande</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m358">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kauppala</skos:altLabel>
    <skos:altLabel xml:lang="sv">köping</skos:altLabel>
    <skos:definition xml:lang="sv">I Finland numera kommun som tagit i bruk benämningen stad. Tidigare grundades städer genom regenters beslut, och efter att Finland blev självständigt genom förordning. Används även om tidigare köpingar, som senare blivit städer.</skos:definition>
    <skos:definition xml:lang="fi">Suomessa nykyisin kunta, joka on ottanut käyttöön kaupunki-nimityksen. Aiemmin kaupungit perustettiin hallitsijan päätöksellä, Suomen itsenäistyttyä asetuksella (Wikipedia). Käytetään myös entisistä kauppaloista, joista myöhemmin on tullut kaupunkeja.</skos:definition>
    <skos:example xml:lang="sv">Nykarleby (stad)</skos:example>
    <skos:example xml:lang="fi">Varkaus (kaupunki)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kaupunki</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stad</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4778"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5054"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m604"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3580">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">forskare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">researcher</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som stöder uppkomsten av ett verk med sin forskning.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka tukee teoksen syntymistä tutkimuksellaan. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10293"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">forskare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">researcher agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tutkija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3581">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">founder of work</skos:altLabel>
    <skos:altLabel xml:lang="sv">grundare (aktör) av verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen perustaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för igångsättningen av ett diakroniskt verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa diakronisen teoksen alullepanosta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10299"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">founder agent of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">grundare av verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen perustaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3583">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deponent</skos:altLabel>
    <skos:altLabel xml:lang="sv">deponerat av (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">depositor</skos:altLabel>
    <skos:altLabel xml:lang="sv">depositor</skos:altLabel>
    <skos:altLabel xml:lang="fi">tallettaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1768"/>
    <skos:definition xml:lang="fi">Kappaleen nykyinen omistaja, joka tallettaa kappaleen toisen toimijan huostaan omistajuudesta luopumatta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Nuvarande ägare till ett exemplar, som förvarar exemplaret hos en annan aktör, utan att överlåta ägarskapet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deponerat av</skos:prefLabel>
    <skos:prefLabel xml:lang="en">depositor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tallettaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3584">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">censor</skos:altLabel>
    <skos:altLabel xml:lang="sv">censor (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sensori (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5705"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att granska innehållet i ett annat uttryck för att dölja kontroversiellt innehåll på moraliska, politiska, militära eller andra grunder, men ändå låta det ursprungliga verkets karaktär och allmänna innehåll till sina väsentliga delar förbli oförändrat.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20287"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">censor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">censor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sensori</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske laajaa muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte omfattande redigering, som leder till skapandet av ett nytt verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3585">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m176"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:prefLabel xml:lang="fi">Ammatti/harrastus</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Occupation/field of activity</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Yrke/intresse</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Harrastusryhmistä voidaan käyttää YSOn termejä &lt;a href='http://www.yso.fi/onto/yso/p2901'&gt;harrastukset&lt;/a&gt;; ammateista Metatietosanaston termejä ryhmästä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2332'&gt;ammatti tai tehtävä&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om hobbygrupper kan ALLFO-termerna &lt;a href='http://www.yso.fi/onto/yso/p2901'&gt;hobbyer&lt;/a&gt; användas; om yrken termer ur gruppen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m2332'&gt;yrke eller uppgift&lt;/a&gt; i Metadataordlistan.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3586">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esittelijä (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">esittelijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">introduktör</skos:altLabel>
    <skos:altLabel xml:lang="en">on-screen presenter</skos:altLabel>
    <skos:altLabel xml:lang="sv">presentatör (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare, som deltar i utförandet av ett uttryck genom att framträda i tv eller film med bakgrundsinformation.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen esiintymällä televisiossa tai elokuvassa taustatiedon antajana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">onscreen presenter agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">presentatör</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Gäller framträdande i icke-fiktiv film eller i inledning till fiktiv film.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Koskee ei-fiktiivisessä elokuvassa tai fiktiivisen elokuvan johdannossa esiintymistä. Ei koske esiintymistä ruudussa ei-esittävässä roolissa. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3587">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">erikoistehosteiden tekijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare av specialeffekter (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">special effects provider</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av uttryck av rörlig bild eller ljudverk, genom att planera eller skapa specialeffekter som sker under inspelning, såsom mekaniska effekter och optiska effekter skapade med kamera.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu liikkuvan kuvan tai ääniteoksen ekspression tekemiseen suunnittelemalla ja luomalla taltioinnin aikana tapahtuvat erikoistehosteet, kuten mekaaniset tehosteet ja kameralla toteutettavat optiset tehosteet. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20258"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erikoistehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av specialeffekter</skos:prefLabel>
    <skos:prefLabel xml:lang="en">special effects provider agent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3588">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">music programmer</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiohjelmoija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikprogrammerare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i skapandet av ett musikverks uttryck, genom att producera ljud med elektriska ljudenheter eller datorprogram.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu musiikkiteoksen ekspression tekemiseen tuottamalla ääniä sähköisillä äänilaitteilla tai tietokoneohjelmilla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20294"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">music programmer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikkiohjelmoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikprogrammerare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske uuden musiikkiteoksen luomista. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte skapandet av ett nytt musikverk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3589">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">instrumental conductor</skos:altLabel>
    <skos:altLabel xml:lang="fi">kapellimestari (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kapellimestari (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kapellmästare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kapellmästare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">orkesterdirigent</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1577"/>
    <skos:definition xml:lang="sv">Aktör som är en dirigent som deltar i utförandet av ett uttryck, genom att leda en instrumentgrupp i en musik- eller dramaföreställning.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla soitinryhmää musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20286"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">instrumental conductor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kapellimestari</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kapellmästare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m359">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">lavastussuunnittelija</skos:altLabel>
    <skos:altLabel xml:lang="en">production designer</skos:altLabel>
    <skos:altLabel xml:lang="sv">produktionsdesigner (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuotantosuunnittelija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som svarar för designen i det visuella helhetsuttrycket för en filmproduktion.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka vastaa elokuvatuotannon visuaalisen kokonaisilmeen suunnittelusta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20056"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">production designer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">produktionsdesigner</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuotantosuunnittelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3590">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ohjelmistokehittäjä (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ohjelmistokehittäjä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programutvecklare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programutvecklare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="en">software developer</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5684"/>
    <skos:definition xml:lang="sv">Aktör som deltar i skapandet av ett uttryck, genom att undersöka, planera, förverkliga eller testa en programvara.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen tutkimalla, suunnittelemalla, toteuttamalla tai testaamalla ohjelmistoa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20280"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ohjelmistokehittäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programutvecklare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">software developer agent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3591">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deltagare</skos:altLabel>
    <skos:altLabel xml:lang="sv">deltagare (aktör) i rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallistuja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">on-screen participant</skos:altLabel>
    <skos:altLabel xml:lang="fi">osallistuja</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck av ett icke-fiktivt verk med rörlig bild, genom att ta en aktiv roll som deltagare.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ei-fiktiivisen liikkuvan kuvan teoksen ekspression tekemiseen ottamalla aktiivisen roolin osallistujana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20279"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvaan kuvaan osallistuja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">onscreen participant agent</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske esiintymistä lisä- tai taustatietojen kertojana. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte uppträdande som berättare av tilläggs- eller bakgrundsinformation.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3592">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i utförandet av ett uttryck, genom att leda ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter i ämnen som relaterar till diskussionen.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen juontamalla (usein lähetettyä) ohjelmaa, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20017"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">moderator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">moderator agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">moderoija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3593">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">choral conductor</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuoronjohtaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuoronjohtaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kördirigent (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kördirigent (relation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">körledare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1577"/>
    <skos:definition xml:lang="sv">Aktör som är en dirigent som deltar i utförandet av ett uttryck, genom att leda en kör i en musik- eller dramaföreställning.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla kuoroa musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20285"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">choral conductor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuoronjohtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kördirigent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3595">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">dubbausohjaaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">dubbing director</skos:altLabel>
    <skos:altLabel xml:lang="sv">dubbningsregissör (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som svarar för ledning och övervakning av tillägget av ny dialog eller andra röster för att komplettera ett uttrycks ljudspår.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka vastaa uuden dialogin tai muiden äänien lisäämisprosessin yleisestä johtamisesta ja valvonnasta ekspression ääniraidan täydentämiseksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20295"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">dubbausohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dubbing director agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dubbningsregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3597">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p84"/>
    <skos:altLabel xml:lang="fi">kasvatusala</skos:altLabel>
    <skos:altLabel xml:lang="fi">opetusala</skos:altLabel>
    <skos:altLabel xml:lang="sv">utbildningsbranschen</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som bedriver utbildning vid utbildningsanstalter på olika utbildningsnivåer och för olika yrken, vuxenutbildning och specialundervisning samt producerar utbildningsrelaterade tjänster. Till huvudkategorin hör också aktörer som erbjuder utbildning till referensgrupper inom verksamhetsområden som representeras av andra huvudkategorier.</skos:definition>
    <skos:definition xml:lang="fi">Koulutusta oppilaitoksissa eri koulutusasteilla ja eri ammatteja varten sekä aikuiskoulutusta ja erityisopetusta harjoittavat ja koulutukseen liittyviä palveluja tuottavat toimijat. Pääluokkaan kuuluvat myös toimijat, jotka tarjoavat koulutusta muiden pääluokkien edustamien toimialojen viiteryhmille.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">koulutus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utbildning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3598">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p2113"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p2114"/>
    <skos:altLabel xml:lang="sv">förplägnadsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">inkvarteringsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">kosthållsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">majoitusala</skos:altLabel>
    <skos:altLabel xml:lang="fi">matkailuala</skos:altLabel>
    <skos:altLabel xml:lang="fi">ravitsemisala</skos:altLabel>
    <skos:altLabel xml:lang="fi">siivousala</skos:altLabel>
    <skos:altLabel xml:lang="sv">städbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">turistbranschen</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som erbjuder kortvarig inkvartering, måltider som tillagats och drycker som serverats för att förtäras direkt, samt måltidstjänster. Till huvudkategorin hör inte aktörer som bedriver industriell tillverkning av livsmedel (se livsmedelsindustri) eller detaljhandel med livsmedel (se handelsbranschen).</skos:definition>
    <skos:definition xml:lang="fi">Lyhytaikaista majoitusta ja välittömästi nautittavaksi valmistettuja aterioita ja anniskeltuja juomia sekä ateriapalveluja tarjoavat toimijat. Pääluokkaan eivät kuulu elintarvikkeiden teollista valmistamista (ks. elintarviketeollisuus) eikä niiden vähittäiskauppaa (ks. kauppa-ala) harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inkvarterings- och kosthållsbranschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">majoitus- ja ravitsemisala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3599">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">konepajateollisuus</skos:altLabel>
    <skos:altLabel xml:lang="sv">maskinverkstadsindustri</skos:altLabel>
    <skos:altLabel xml:lang="sv">metalindustri</skos:altLabel>
    <skos:altLabel xml:lang="fi">metalliteollisuus</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5363"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p6643"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">metall- och maskinverkstadsindustri</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">metalli- ja konepajateollisuus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3600">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p18932"/>
    <skos:altLabel xml:lang="sv">byggnad</skos:altLabel>
    <skos:altLabel xml:lang="sv">byggnadsverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="fi">rakennustoiminta</skos:altLabel>
    <skos:altLabel xml:lang="fi">rakentaminen</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar husbyggnad, anläggningsverksamhet (bl.a. vägar, järnvägar, vattenvägar, flygfält, datakommunikationsnät, vatten-, avlopps-, gas-, värme-, och elnätverk), miljötekniskt byggande, maskin- och apparatbyggnad, VVS-, el- och isoleringsarbeten, rivningsarbeten samt andra arbeten som är nära sammanhörande med byggnad och byggnadsplanering.</skos:definition>
    <skos:definition xml:lang="fi">Talonrakennusta, maa- ja vesirakennusta (mm. tiet, rautatiet, vesiväylät, lentokentät, vesi- , viemäri-, tietoliikenne-, kaasu-, lämpö- ja sähköverkostot), ympäristörakentamista, koneiden ja laitteiden rakentamista, LVI- ja sähkö- ja eristystöitä, purkutöitä sekä muita rakentamiseen kiinteästi liittyviä töitä ja rakennussuunnittelua harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">byggnadsbranschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rakennusala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3601">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p5709"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p5711"/>
    <skos:altLabel xml:lang="sv">förlagsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">informaatioala</skos:altLabel>
    <skos:altLabel xml:lang="sv">informationsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">julkaisutoiminta</skos:altLabel>
    <skos:altLabel xml:lang="fi">kustannusala</skos:altLabel>
    <skos:altLabel xml:lang="fi">mainonta</skos:altLabel>
    <skos:altLabel xml:lang="fi">media-ala</skos:altLabel>
    <skos:altLabel xml:lang="sv">mediebranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">publikationsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">reklam</skos:altLabel>
    <skos:altLabel xml:lang="fi">teleala</skos:altLabel>
    <skos:altLabel xml:lang="sv">telebranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">viestintäala</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som sysslar med förlagsverksamhet, radio- och tv-verksamhet, film-, musik-, och programproduktion, telekommunikation, informationsförmedling, reklam, informationsteknik och databehandling. Till huvudkategorin hör inte postverksamhet (se logistikbranschen) och inte heller aktörer som sysslar med tryckning, kopiering och mångfaldigande (se grafisk industri).</skos:definition>
    <skos:definition xml:lang="fi">Kustannustoimintaa, radio- ja televisiotoimintaa, elokuva-, musiikki- ja ohjelmatuotantoa, televiestintää, tiedonvälitystä, mainontaa, tietotekniikka- ja tietojenkäsittelypalveluita harjoittavat toimijat. Pääluokkaan eivät kuulu postitoimintaa (ks. logistiikka-ala), eivätkä painamista, jäljentämistä ja monentamista (ks. graafinen teollisuus) harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">informaatio- ja viestintäala</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">informations- och kommunikationsbranschen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3602">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p998"/>
    <skos:definition xml:lang="sv">Aktörer som producerar nya produkter av material och komponenter som erhållits ur primärproduktion, genom att mekaniskt, kemiskt eller biologiskt omvandla dem. Huvudkategorin indelas i underavdelningar enligt industrigren. I huvudkategorin placeras de industriella aktörer som enligt sitt huvudsakliga verksamhetsområde inte kan placeras i någon av underavdelningarna för industri, t.ex. sådana som utövar branschövergripande industriverksamhet.</skos:definition>
    <skos:definition xml:lang="fi">Alkutuotannosta saatuja materiaaleja ja komponentteja uusiksi tuotteiksi mekaanisesti, kemiallisesti tai biologisesti muuntamalla valmistavat toimijat. Pääluokka jakaantuu alaluokkiin teollisuuden alan mukaan. Pääluokkaan liitetään ne teollisuuden toimijat, joita ei päätoimialansa mukaan voida liittää mihinkään teollisuuden alaluokista, esim. monialaisen teollisen toiminnan harjoittajat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">industri</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teollisuus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3603">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">social- och hälsoförvaltning</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2813"/>
    <skos:example xml:lang="sv">social- och hälsovårdsministeriet, medicinalstyrelsen, läkemedelsverket, socialstyrelsen, distriktsläkare, arbetarskyddsdistrikt, yrkesinspektörer</skos:example>
    <skos:example xml:lang="fi">sosiaali- ja terveysministeriö, lääkintöhallitus, lääkelaitos, sosiaalihallitus, piirilääkärit, työsuojelupiirit, ammattientarkastajat</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">social- och hälsovårdsförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sosiaali- ja terveyshallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3604">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">jalkineteollisuus</skos:altLabel>
    <skos:altLabel xml:lang="sv">klädindustri</skos:altLabel>
    <skos:altLabel xml:lang="sv">läderindustri</skos:altLabel>
    <skos:altLabel xml:lang="fi">nahkateollisuus</skos:altLabel>
    <skos:altLabel xml:lang="sv">pälsindustri</skos:altLabel>
    <skos:altLabel xml:lang="sv">skoindustri</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiiliteollisuus</skos:altLabel>
    <skos:altLabel xml:lang="sv">textil- och beklädnadsindustri</skos:altLabel>
    <skos:altLabel xml:lang="sv">textil- och klädindustri</skos:altLabel>
    <skos:altLabel xml:lang="sv">textilindustri</skos:altLabel>
    <skos:altLabel xml:lang="fi">turkisteollisuus</skos:altLabel>
    <skos:altLabel xml:lang="fi">vaatetusteollisuus</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p16888"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tekstiili- ja vaatetusteollisuus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textil- och konfektionsindustri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3605">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p18903"/>
    <skos:example xml:lang="sv">inrikesministeriet, länsstyrelser, regionförvaltningsverk, polisinrättningar, länsmansdistrikt, kommuner, samkommuner, myndigheter för vård av de evakuerade, Statens flyktinghjälpcentral, mantalsskrivare, magistrater, kronofogdar, gränsbevakningsavdelningar</skos:example>
    <skos:example xml:lang="fi">sisäasiainministeriö, lääninhallitukset, aluehallintovirastot, poliisilaitokset, nimismiespiirit, kunnat, kuntayhtymät, siirtoväen huollon viranomaiset, Valtion pakolaisavustuskeskus, henkikirjoittajat, maistraatit, kruununvuodit, rajavartiostot</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inrikesförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sisäasiainhallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3606">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3682"/>
    <skos:example xml:lang="sv">jord- och skogsbruksministeriet, kolonisationsstyrelsen, lantmäteristyrelsen, forststyrelsen, jordbruksstyrelsen, kolonisationsförvaltningens distrikts-, och lokala myndigheter, landsbygdsnäringsdistrikt, forstrevir, lantmäteriförvaltningens distriktsmyndigheter, jaktvårdsföreningar, delägarlag, renbeteslag</skos:example>
    <skos:example xml:lang="fi">maa- ja metsätalousministeriö, asutushallitus, maanmittaushallitus, metsähallitus, maatilahallitus, asutushallinnon piiri- ja paikallisviranomaiset, maaseutuelinkeinopiirit, metsänhoitoalueet, maanmittaushallinnon piiriviranomaiset, riistanhoitoyhdistykset, osakaskunnat, paliskunnat</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">jord- och skogsbruksförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maa- ja metsätaloushallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3607">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">avfallshantering</skos:altLabel>
    <skos:altLabel xml:lang="fi">jätehuolto</skos:altLabel>
    <skos:altLabel xml:lang="sv">vattenförsörjning</skos:altLabel>
    <skos:altLabel xml:lang="sv">vattentjänster och miljövård</skos:altLabel>
    <skos:altLabel xml:lang="fi">vesihuolto</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar vattentäkt, vattenrening och -distribution, avfallsinsamling, -hantering och slutförvaring, uppsamling, transport och rening av avfallsvatten samt rening och restaurering av mark och vattendrag. Till huvudkategorin hör inte anläggningsverksamhet eller miljötekniskt byggande (se byggnadsbranschen).</skos:definition>
    <skos:definition xml:lang="fi">Veden ottoa, puhdistusta ja jakelua, jätteiden keruuta, käsittelyä ja loppusijoitusta, jätevesien keräämistä, kuljetusta ja puhdistusta sekä maaperän ja vesistöjen puhdistusta ja kunnostusta harjoittavat toimijat. Pääluokkaan eivät kuulu maa- ja vesirakennusta tai ympäristörakentamista harjoittavat toimijat (ks. rakennusala).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">vattenförsörjning och miljövård</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vesi- ja ympäristönhuolto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3608">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p8589"/>
    <skos:example xml:lang="fi">ulkoasiainministeriö, edustustot</skos:example>
    <skos:example xml:lang="sv">utrikesministeriet, representationer</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ulkoasiainhallinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utrikesförvaltning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3609">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p775"/>
    <skos:definition xml:lang="fi">Julkisoikeudellista ja erityisesti julkishallinnollista tehtävää suorittavat tai sisäisestä turvallisuudesta ja järjestyksestä huolehtivat organisaatiot sekä pakollisen sosiaalivakuutustoiminnan toimijat. Pääluokkaan eivät kuulu ne julkishallinnon toimijat, joiden toiminta luetaan luonteensa puolesta toiseen pääluokkaan, esim. sotilasyksiköt (ks. puolustusvoimat), oppilaitokset (ks. koulutus), terveyden- ja sosiaalihuollon laitokset (ks. terveys- ja sosiaaliala), kulttuuri- ja urheilulaitokset (ks. kulttuuri- ja viihdeala, urheilu- ja virkistystoiminta), sekä eri toimialojen tutkimuslaitokset ja liikelaitokset. Pääluokka jakaantuu alaluokkiin hallinnonalan mukaan. Pääluokkaan liitetään ne julkishallinnon toimijat, joita ei päätoimialansa mukaan voida liittää mihinkään julkisen hallinnon alaluokista, esim. valtionhallinnon ylimmät viranomaiset.</skos:definition>
    <skos:definition xml:lang="sv">Organisationer som utför offentligrättsliga uppgifter och särskilt uppgifter inom offentlig förvaltning, eller ansvarar för inre säkerhet och ordning, samt aktörer inom obligatorisk socialförsäkringsverksamhet. Till huvudkategorin hör inte de aktörer inom offentlig förvaltning, vars verksamhet p.g.a. sin karaktär räknas till en annan huvudkategori, t.ex. militära enheter (se försvarsmakten), läroanstalter (se utbildning), anstalter för hälso- och socialvård (se hälso- och socialvårdsbranschen), kultur- och idrottsanläggningar (se kultur- och nöjesbranschen, idrotts- och rekreationsverksamhet) samt forskningsanstalter och affärsinrättningar inom olika verksamhetsområden. Huvudkategorin indelas i underavdelningar enligt förvaltningsområde. Med huvudkategorin sammankopplas de aktörer inom offentlig förvaltning som inte kan sammankopplas enligt sitt huvudsakliga verksamhetsområde med någon av underavdelningarna inom offentlig förvaltning, t.ex. de högsta myndigheterna för statsförvaltning.</skos:definition>
    <skos:example xml:lang="fi">eduskunta, valtioneuvoston kanslia, kenraalikuvernöörin kanslia, Suomen senaatti, Vaasan senaatti, Suomen kansanvaltuuskunta, komiteat, oikeuskanslerinvirasto, tasavallan presidentin kanslia</skos:example>
    <skos:example xml:lang="sv">riksdagen, statsrådets kansli, generalguvernörskansliet, Kejserliga Senaten för Finland, Vasasenaten, Finska folkdelegationen, kommittéer, justitiekanslersämbetet, republikens presidents kansli</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">julkinen hallinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">offentlig förvaltning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3610">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">byggnadsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikennehallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">rakennushallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">trafikförvaltning</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p18754"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3953"/>
    <skos:example xml:lang="fi">kulkulaitosten ja yleisten töiden ministeriö, liikenne- ja viestintäministeriö, rakennushallitus, tie- ja vesirakennushallitus, merenkulkuhallitus, posti- ja telelaitos, ajoneuvohallinnon viranomaiset, rakennushallinnon piiriviranomaiset, rautatiehallinnon piiri- ja paikallisviranomaiset, luotsipiirit, tie- ja vesirakennuspiirit, postin piiri- ja paikallisviranomaiset, lento-asemat, majakat</skos:example>
    <skos:example xml:lang="sv">ministeriet för kommunikationsväsendet och allmänna arbetena, kommunikationsministeriet, byggnadsstyrelsen, väg- och vattenbyggnadsstyrelsen, sjöfartsstyrelsen, post- och televerket, fordonsförvaltningens myndigheter, byggnadsförvaltningens distriktsmyndigheter, järnvägsförvaltningens distrikts- och lokala myndigheter, lotsfördelningar, väg- och vattenbyggnadsdistrikt, postens distrikts- och lokala myndigheter, flygplatser, fyrar</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikenne- ja rakennushallinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">trafik- och byggnadsförvaltning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3611">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">asuntohallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">bostadsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaavoitushallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">miljövårdsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">vatten- och miljöförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">vattenförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">vesi- ja ympäristöhallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">vesihallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">ympäristönsuojeluhallinto</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5171"/>
    <skos:example xml:lang="sv">miljöministeriet, miljöcentraler, lantbruksingenjörsdistrikt och vattendistrikt</skos:example>
    <skos:example xml:lang="fi">ympäristöministeriö, ympäristökeskukset, maanviljelysinsinööripiirit ja vesipiirit</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">miljö- och vattenförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ympäristö- ja vesihallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3612">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3090"/>
    <skos:example xml:lang="sv">Folkpensionsanstalten, Kommunernas pensionsförsäkring</skos:example>
    <skos:example xml:lang="fi">Kansaneläkelaitos, Kuntien eläkevakuutus</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">socialförsäkring</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sosiaalivakuutus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3613">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p13916"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p26126"/>
    <skos:altLabel xml:lang="fi">hyvinvointiala</skos:altLabel>
    <skos:altLabel xml:lang="sv">hälso- och socialvårdssektorn</skos:altLabel>
    <skos:altLabel xml:lang="sv">hälsovårdsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">socialvårdsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">sosiaaliala</skos:altLabel>
    <skos:altLabel xml:lang="fi">terveysala</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som producerar hälsovårdens anstaltsvård, läkartjänster och andra hälsovårds- och välfärdstjänster (t.ex. fysioterapi, psykoterapi, laboratorieundersökningar, sjuktransport, skönhetsvård), samt socialvårdens anstalts- och öppenvårdstjänster. Till huvudkategorin hör även aktörer som erbjuder hälso- och socialvårdstjänster till referensgrupper inom verksamhetsområden som representeras av andra huvudkategorier.</skos:definition>
    <skos:definition xml:lang="fi">Terveydenhuollon laitospalveluita, lääkäripalveluita ja muita terveys- ja hyvinvointipalveluita (esim. fysioterapia, psykoterapia, laboratoriotutkimukset, sairaankuljetus, kauneudenhoito) sekä sosiaalihuollon laitos- ja avopalveluja tuottavat toimijat. Pääluokkaan kuuluvat myös toimijat, jotka tarjoavat terveys- ja sosiaalipalveluja muiden pääluokkien edustamien toimialojen viiteryhmille.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">hälso- och socialvårdsbranschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">terveys- ja sosiaaliala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3614">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">idrottsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">konstförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">kouluhallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">kulttuurihallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">kulturförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">skolförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">taidehallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">tiedehallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">urheiluhallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">vetenskapsförvaltning</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11749"/>
    <skos:example xml:lang="fi">opetus- ja kulttuuriministeriö, kouluhallitus, Kansallisarkisto, Museovirasto, kansakouluntarkastajat, Suomen Akatemia, kirjastontarkastajat, kouluvirastot</skos:example>
    <skos:example xml:lang="sv">undervisnings- och kulturministeriet, skolstyrelsen, Riksarkivet, Museiverket, folkskoleinspektörer, Finlands Akademi, biblioteksinspektörer, skolverk</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">opetus- ja kulttuurihallinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">undervisnings- och kulturförvaltning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3615">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">föreningsverksamhet</skos:altLabel>
    <skos:definition xml:lang="fi">Erityisten ryhmien etuja tai aatteita ajavat ja toimintaa edistävät yhdistykset, säätiöt tms. järjestäytyneet toimijat. Pääluokkaan eivät kuulu julkisen hallinnon organisaatiot (ks. julkinen hallinto), eri toimialojen yritykset eivätkä urheiluseurat (ks. urheilu- ja virkistystoiminta).</skos:definition>
    <skos:definition xml:lang="sv">Föreningar, stiftelser e.d. organiserade aktörer som driver vissa gruppers intressen och främjar deras verksamhet. Till huvudgruppen hör inte organisationer inom den offentliga förvaltningen (se offentlig förvaltning), företag inom olika branscher, eller idrottsföreningar (se idrotts- och rekreationsverksamhet).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">järjestötoiminta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">organisationsverksamhet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3616">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p19511"/>
    <skos:altLabel xml:lang="sv">konstbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">kulttuuriala</skos:altLabel>
    <skos:altLabel xml:lang="fi">kulttuuritoiminta</skos:altLabel>
    <skos:altLabel xml:lang="sv">kultur- och underhållningsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">kulturbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">kulturverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="fi">peliala</skos:altLabel>
    <skos:altLabel xml:lang="sv">spelbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">taideala</skos:altLabel>
    <skos:altLabel xml:lang="sv">underhållning</skos:altLabel>
    <skos:altLabel xml:lang="fi">viihde</skos:altLabel>
    <skos:definition xml:lang="sv">Bibliotek, arkiv, muséer och andra kulturinstitutioner, institutioner för underhållning samt aktörer som producerar andra kultur- och underhållningstjänster, inklusive spel om pengar, vadslagnings-, och videospelstjänster. Till huvudkategorin hör inte aktörer som producerar idrotts- och rekreationstjänster (se idrotts- och rekreationsverksamhet).</skos:definition>
    <skos:definition xml:lang="fi">Kirjastot, arkistot, museot ja muut kulttuurilaitokset, viihdelaitokset sekä muut kulttuuri- ja viihdepalveluja, mukaan lukien rahapeli-, vedonlyönti- ja videopelipalveluja tuottavat toimijat. Pääluokkaan eivät kuulu urheilu- ja virkistyspalveluja tuottavat toimijat (ks. urheilu- ja virkistystoiminta).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kulttuuri- ja viihdeala</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kultur- och nöjesbranschen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3617">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elintarvikehuolto</skos:altLabel>
    <skos:altLabel xml:lang="sv">folkförsörjning</skos:altLabel>
    <skos:altLabel xml:lang="fi">kansanhuolto</skos:altLabel>
    <skos:altLabel xml:lang="sv">livsmedelsförsörjning</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p15143"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p6689"/>
    <skos:example xml:lang="sv">folkförsörjningsministeriet, livsmedelsstyrelsen, folkförsörjningsdistrikt, livsmedelsbyråer, Finlands Folkhjälp</skos:example>
    <skos:example xml:lang="fi">kansanhuoltoministeriö, elintarvikehallitus, kansanhuoltopiirit, elintarviketoimistot, Suomen Huolto</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">folkförsörjning och livsmedelsförsörjning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kansanhuolto ja elintarvikehuolto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3618">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p23197"/>
    <skos:altLabel xml:lang="sv">finansieringsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">finansverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="sv">försäkringsbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">försäkringsverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="fi">rahoitusala</skos:altLabel>
    <skos:altLabel xml:lang="fi">rahoitustoiminta</skos:altLabel>
    <skos:altLabel xml:lang="fi">vakuutusala</skos:altLabel>
    <skos:altLabel xml:lang="fi">vakuutustoiminta</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som erbjuder finansierings- och placeringstjänster samt utövar bank-, försäkrings-, återförsäkrings-, och pensionsfondsverksamhet, medelsförvaltning (se holdingbolag, stiftelser, fonder), börsverksamhet och värdepappersförmedling etc. Till huvudgruppen hör inte aktörer som utövar obligatorisk socialförsäkringsverksamhet (se socialförsäkring).</skos:definition>
    <skos:definition xml:lang="fi">Rahoitus- ja sijoituspalveluita tarjoavat sekä pankki-, vakuutus-, jälleenvakuutus- ja eläkerahastointitoimintaa, varojen hallinnointia (ks. hallintayhtiöt, säätiöt, rahastot), pörssitoimintaa ja arvopapereiden välitystä yms. harjoittavat toimijat. Pääluokkaan eivät kuulu pakollista sosiaalivakuutustoimintaa harjoittavat toimijat (ks. sosiaalivakuutus).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">finansbranschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">finanssiala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3619">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:example xml:lang="sv">försvarsministeriet</skos:example>
    <skos:example xml:lang="fi">puolustusministeriö</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">försvarsförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puolustushallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m362">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">musiknotation</skos:altLabel>
    <skos:altLabel xml:lang="en">notated music</skos:altLabel>
    <skos:altLabel xml:lang="sv">notskrift</skos:altLabel>
    <skos:definition xml:lang="sv">Innehåll uttryckt med hjälp av musiknotation, avsett att betraktas. Omfattar alla former av musiknotation, med undantag för notation avsedd att vidröras. Se även &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m586'&gt;taktil musiknotation&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Musiikkinotaationa esitetty sisältö, joka on tarkoitettu katsottavaksi. Sisältää kaikki muut kuin kosketeltavassa muodossa olevat musiikkinotaatiot.
Katso myös &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m586'&gt;taktiili nuottikirjoitus&lt;/a&gt;.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">noterad musik</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">nuottikirjoitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3620">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p10705"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">metsäteollisuus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skogsindustri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3621">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arbetsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">arbetskraftsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">elinkeinohallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">elintarvikehallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">handels- och industriförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">handelsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">industriförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">kauppa- ja teollisuushallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">kauppahallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">kilpailuhallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">konkurrensförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">konsumentförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuluttajahallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">livsmedelsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">näringsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">teollisuushallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">työhallinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">työvoimahallinto</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12657"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2815"/>
    <skos:example xml:lang="sv">handels- och industriministeriet, patent- och registerstyrelsen, arbetsministeriet, arbets- och näringscentraler, arbetskraftsförvaltningens distrikts- och lokala myndigheter, yrkeskårer, sjömanshus, Delegationen för krigsskadeståndsindustrin</skos:example>
    <skos:example xml:lang="fi">kauppa- ja teollisuusministeriö; patentti- ja rekisterihallitus; työministeriö; työ- ja elinkeinokeskukset; työvoimahallinnon piiri- ja paikallisviranomaiset; ammattikunnat; merimieshuoneet; Sotakorvausteollisuuden valtuuskunta; työasiamiehet; työvoimapiirit; työvoimatoimistot; työ- ja elinkeinotoimistot; työvoimapäälliköt; ammatinvalinnanohjauksen piiritoimistot; työriitojen piirisovittelijat; työvoima- ja elinkeinokeskukset; elinkeino-, liikenne- ja ympäristökeskukset; teollisuuspiirit; pienteollisuuspiirit; yrityspalvelun piiritoimistot; sähköhuollon aluetoimikunnat; elintarvikevirastot</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arbets- och näringsförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">työ- ja elinkeinohallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3623">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p731"/>
    <skos:definition xml:lang="sv">Försvarsmaktens (arméns, marinens och flygvapnets) ledande organisationer, förband och andra truppavdelningar, garnisoner och depåer, samt trupper under den svenska tiden, autonoma tiden och krigstiderna. Till huvudkategorin hör inte försvarsministeriet och försvarsförvaltningens aktörer som det leder (se försvarsförvaltning), militärbranschens skolor (se utbildning), krigsrätter (se justitieförvaltning), militärsjukhus (se hälso- och socialvårdsbranschen), gränsbevakningsväsendet (se inrikesförvaltning).</skos:definition>
    <skos:definition xml:lang="fi">Puolustusvoimien (maa-, meri- ja ilmavoimien) johto-organisaatiot, sotilasyksiköt ja muut joukko-osastot, varuskunnat ja varikot sekä Ruotsin vallan ajan, autonomian ajan ja sota-aikojen joukot. Pääluokkaan eivät kuulu puolustusministeriö ja sen johtaman puolustushallinnon toimijat (ks. puolustushallinto), sotilasalan koulut (ks. koulutus), sotaoikeudet (ks. oikeushallinto), sotilassairaalat (ks. terveys- ja sosiaaliala), rajavartiosto (ks. sisäasiainhallinto)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">försvarsmakten</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puolustusvoimat</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3624">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">boktryckarbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjapainoala</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9124"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">graafinen teollisuus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">grafisk industri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3625">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elektroniikkateollisuus</skos:altLabel>
    <skos:altLabel xml:lang="sv">elektronikindustri</skos:altLabel>
    <skos:altLabel xml:lang="sv">elindustri</skos:altLabel>
    <skos:altLabel xml:lang="fi">sähköteollisuus</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p14317"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p14318"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elektroniikka- ja sähköteollisuus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">elektronik- och elindustri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3626">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">gruvindustri</skos:altLabel>
    <skos:altLabel xml:lang="sv">gruvverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaivosteollisuus</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaivostoiminta</skos:altLabel>
    <skos:altLabel xml:lang="fi">louhinta</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar och betjänar primärproduktion av malm och andra mineral, guldvaskning samt produktion av råolja och naturgas. Till huvudkategorin hör inte aktörer som utövar transport av mineral (se logistik) eller vidareförädling av råmaterial (se industri).</skos:definition>
    <skos:definition xml:lang="fi">Malmien ja muiden kaivannaisten alkutuotantoa eli kaivuuta ja louhintaa, kullanhuuhdontaa sekä raakaöljyn ja maakaasun tuotantoa harjoittavat ja palvelevat toimijat. Pääluokkaan eivät kuulu kaivannaisten kuljetusta (ks. logistiikka) tai raaka-aineiden jatkojalostusta (ks. teollisuus) harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">gruvbranschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaivosala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3627">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3373"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elintarviketeollisuus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">livsmedelsindustri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3628">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">asiantuntijapalvelut</skos:altLabel>
    <skos:altLabel xml:lang="sv">bokföring</skos:altLabel>
    <skos:altLabel xml:lang="sv">expertserviceverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="sv">experttjänster</skos:altLabel>
    <skos:altLabel xml:lang="sv">forskningstjänster</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjanpito</skos:altLabel>
    <skos:altLabel xml:lang="fi">lakiasiainpalvelut</skos:altLabel>
    <skos:altLabel xml:lang="fi">laskentatoimi</skos:altLabel>
    <skos:altLabel xml:lang="sv">redovisning</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekniset alat</skos:altLabel>
    <skos:altLabel xml:lang="sv">tekniska områden</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkimuspalvelut</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som erbjuder forsknings-, advokat-, och redovisningstjänster, konsultation och andra tjänster som kräver vetenskaplig eller teknisk specialkompetens. Till huvudgruppen hör inte forskningsinstitutioner som utför uppgifter inom offentlig förvaltning, arkitekt- och byggnadsbyråer (se byggnadsbranschen), reklambyråer (se information och kommunikation) eller aktörer som producerar förvaltnings- och stödtjänster (se förvaltnings- och stödtjänstverksamhet).</skos:definition>
    <skos:definition xml:lang="fi">Muille toimijoille tutkimus-, lakiasiain- ja laskentatoimen palveluja, konsultointia sekä muita tieteellistä tai teknistä erityisosaamista vaativia palveluja tarjoavat toimijat. Pääluokkaan eivät kuulu tutkimuslaitokset, jotka suorittavat julkishallinnollista tehtävää, arkkitehti- ja rakennustoimistot (ks. rakennusala), mainostoimistot (ks. informaatio ja viestinä) eivätkä hallinto- ja tukipalveluja tuottavat toimijat (ks. hallinto- ja tukipalvelutoiminta).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asiantuntijapalvelutoiminta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">experttjänstverksamhet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3629">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p17954"/>
    <skos:altLabel xml:lang="sv">fastighetsverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="fi">kiinteistönhoito</skos:altLabel>
    <skos:altLabel xml:lang="fi">kiinteistötoiminta</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar handel med och uthyrning av fastigheter, fastighetsförmedling samt fastighetsbesittning och -förvaltning. Till huvudkategorin hör inte aktörer som utövar husbyggnad (se byggbranschen) eller fastighetsskötsel (se förvaltnings- och stödtjänstverksamhet).</skos:definition>
    <skos:definition xml:lang="fi">Kiinteistöjen kauppaa ja vuokrausta, kiinteistönvälitystä sekä kiinteistöjen hallintaa ja isännöintiä harjoittavat toimijat. Pääluokkaan eivät kuulu talonrakennusta (ks. rakennustala) eivätkä kiinteistönhuoltoa (ks. hallinto- ja tukipalvelutoiminta) harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fastighetsbranschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kiinteistöala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3630">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p14776"/>
    <skos:altLabel xml:lang="sv">detaljhandel</skos:altLabel>
    <skos:altLabel xml:lang="sv">partihandel</skos:altLabel>
    <skos:altLabel xml:lang="fi">tukkukauppa</skos:altLabel>
    <skos:altLabel xml:lang="fi">vähittäiskauppa</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar partihandel med varor, trading och detaljhandel. Till huvudkategorin hör inte aktörer som utövar kreditverksamhet, försäkringsförsäljning, värdepappershandel (se finansbranschen) eller fastighetshandel (se fastighetsbranschen).</skos:definition>
    <skos:definition xml:lang="fi">Tavaroiden tukkukauppaa, välityskauppaa ja vähittäiskauppaa harjoittavat toimijat. Pääluokkaan eivät kuulu luottotoimintaa, vakuutusmyyntiä, arvopaperikauppaa (ks. finanssiala) tai kiinteistökauppaa (ks. kiinteistöala) harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">handelsbranschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kauppa-ala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3631">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kemiindustri</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1221"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kemianteollisuus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kemisk industri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3632">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">hallintopalvelut</skos:altLabel>
    <skos:altLabel xml:lang="fi">suojeluala</skos:altLabel>
    <skos:altLabel xml:lang="fi">tukipalvelut</skos:altLabel>
    <skos:altLabel xml:lang="fi">turvallisuuspalvelut</skos:altLabel>
    <skos:altLabel xml:lang="fi">työllistämistoiminta</skos:altLabel>
    <skos:altLabel xml:lang="fi">vuokraustoiminta</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som producerar uthyrnings-, sysselsättnings-, säkerhets-, fastighetsservice-, och kontorstjänster samt andra rutinmässiga förvaltnings- och stödtjänster åt andra aktörer. Till huvudgruppen hör inte aktörer som producerar tjänster som kräver vetenskaplig eller teknisk specialkompetens (se experttjänstverksamhet).</skos:definition>
    <skos:definition xml:lang="fi">Muille toimijoille vuokraus-, työllistämis-, turvallisuus-, kiinteistönhuolto-, toimisto- ja muita luonteeltaan rutiininomaisia hallinto- ja tukipalveluita tuottavat toimijat. Pääluokkaan eivät kuulu tieteellistä tai teknistä erityisosaamista vaativia palveluja tuottavat toimijat (ks. asiantuntijapalvelutoiminta).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förvaltnings- och stödtjänstverksamhet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">hallinto- ja tukipalvelutoiminta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3633">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">annan bransch</skos:altLabel>
    <skos:altLabel xml:lang="fi">muu toimiala</skos:altLabel>
    <skos:altLabel xml:lang="sv">okänd bransch</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuntematon toimiala</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer, vars huvudsakliga verksamhetsområde inte kan placeras i någon av de namngivna verksamhetsområdesklasserna, eller vars huvudsakliga verksamhetsområde är okänt.</skos:definition>
    <skos:definition xml:lang="fi">Toimijat, joita ei päätoimialansa puolesta voi sijoittaa nimettyihin toimialaluokkiin tai joiden päätoimialaa ei tunneta.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">määrittelemätön toimiala</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ospecificerad bransch</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3634">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">rättsförvaltning</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p320"/>
    <skos:example xml:lang="sv">justitieministeriet, högsta domstolen, hovrätter, förvaltningsdomstolar, singulärrätter, tingslag, domsagor, fängelser, krigsfångeläger, stadsfiskaler</skos:example>
    <skos:example xml:lang="fi">oikeusministeriö, korkein oikeus, hovioikeudet, hallinto-oikeudet, erikoisoikeudet, käräjäkunnat, tuomiokunnat, vankilat, sotavankileirit, kaupunginviskaalit</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">justitieförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">oikeushallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3635">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kyrklig förvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">kyrkoförvaltning</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11876"/>
    <skos:example xml:lang="fi">kirkolliskokous, kirkkohallitus, Suomen ortodoksinen kirkollishallitus, tuomiokapitulit, rovastikunnat, evankelis-luterilaiset ja ortodoksiset seurakunnat</skos:example>
    <skos:example xml:lang="sv">kyrkomötet, kyrkostyrelsen, kyrkostyrelsen för Finlands ortodoxa kyrka, domkapitel, prosterier, evangelisk-lutherska och ortodoxa församlingar</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kirkon hallinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kyrkans förvaltning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3636">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3602"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11187"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">läkemedelsindustri</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lääketeollisuus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3637">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p24014"/>
    <skos:altLabel xml:lang="sv">förpackningsindustri</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuljetusala</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikenne-ala</skos:altLabel>
    <skos:altLabel xml:lang="fi">pakkausteollisuus</skos:altLabel>
    <skos:altLabel xml:lang="sv">post</skos:altLabel>
    <skos:altLabel xml:lang="fi">posti</skos:altLabel>
    <skos:altLabel xml:lang="sv">trafikbranschen</skos:altLabel>
    <skos:altLabel xml:lang="sv">transportbranschen</skos:altLabel>
    <skos:altLabel xml:lang="fi">varastointi</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar person- och godstrafik via järnvägar, landsvägar, vattenvägar och flygledes, verksamhet som betjänar lagring och annan trafik, samt postverksamhet. Till huvudkategorin hör inte aktörer som utövar datakommunikation (se informations- och kommunikationsbranschen), byggnad av infrastruktur och transportmedel (se byggnadsbranschen) och service (se förvaltnings- och stödtjänstverksamhet), eller sjuktransport (se hälso- och socialvårdsbranschen).</skos:definition>
    <skos:definition xml:lang="fi">Henkilö- ja tavaraliikennettä rautateitse, maanteitse, vesiteitse ja ilmateitse harjoittavat toimijat, varastointia ja muuta liikennettä palvelevaa toimintaa sekä postitoimintaa harjoittavat toimijat. Pääluokkaan eivät kuulu tietoliikennettä (ks. informaatio- ja viestintäala), infrastruktuurien ja kuljetusvälineiden rakentamista (ks. rakennusala) ja huoltoa (ks. hallinto- ja tukipalvelutoiminta) eivätkä sairaankuljetusta (ks. terveys- ja sosiaaliala) harjoittavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">logistiikka-ala</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">logistikbranschen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3638">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p12441"/>
    <skos:altLabel xml:lang="sv">idrott</skos:altLabel>
    <skos:altLabel xml:lang="sv">rekreationsverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="sv">sport</skos:altLabel>
    <skos:altLabel xml:lang="sv">sport- och rekreationsverksamhet</skos:altLabel>
    <skos:altLabel xml:lang="fi">urheilu</skos:altLabel>
    <skos:altLabel xml:lang="fi">virkistystoiminta</skos:altLabel>
    <skos:definition xml:lang="sv">Sport- och idrottsanläggningar, idrottslag och -föreningar, motionscenter, skidcentra, nöjes- och temaparker och andra aktörer som producerar idrotts- och rekreationstjänster. Till huvudkategorin hör inte aktörer som producerar kultur- och underhållningstjänster (se kultur- och nöjesbranschen).</skos:definition>
    <skos:definition xml:lang="fi">Urheilu- ja liikuntalaitokset, urheilujoukkueet ja -seurat, kuntokeskukset, hiihtokeskukset, huvi- ja teemapuistot ja muut urheilu- ja virkistyspalveluja tuottavat toimijat. Pääluokkaan eivät kuulu kulttuuri- ja viihdepalveluja (ks. kulttuuri- ja viihdeala) tuottavat toimijat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">idrotts- och rekreationsverksamhet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">urheilu- ja virkistystoiminta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3639">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3609"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p13465"/>
    <skos:example xml:lang="sv">finansministeriet, statskontoret, skattestyrelsen, tullstyrelsen, skatteförvaltningens distrikts- och lokala myndigheter, tullförvaltningens distrikts- och lokala myndigheter, statistikcentralen</skos:example>
    <skos:example xml:lang="fi">valtiovarainministeriö, valtiokonttori, verohallitus, tullihallitus, verohallinnon piiri- ja paikallisviranomaiset, tullihallinnon piiri- ja paikallisviranomaiset, tilastokeskus</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">statens finansförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valtiovarainhallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3640">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://www.yso.fi/onto/yso/p2385"/>
    <skos:altLabel xml:lang="fi">energiahuolto</skos:altLabel>
    <skos:altLabel xml:lang="sv">energiförsörjning</skos:altLabel>
    <skos:definition xml:lang="sv">Aktörer som utövar produktion, överföring och distribution av, samt handel med elektricitet, gas, värme och kyla. Till huvudgruppen hör inte aktörer som utövar byggnad av kraftverk, maskiner och nätverk och inte heller aktörer inom den elektrotekniska branschen (se byggnadsbranschen).</skos:definition>
    <skos:definition xml:lang="fi">Sähkön, kaasun sekä lämmön ja kylmän tuottamista, siirtoa, jakelua ja kauppaa harjoittavat toimijat. Pääluokkaan eivät kuulu voimalaitosten, koneiden ja verkostojen rakentamista harjoittavat toimijat eivätkä sähköteknisen alan toimijat (ks. rakennusala).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">energi-branschen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">energia-ala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3642">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">institution före uppdelning</skos:altLabel>
    <skos:altLabel xml:lang="fi">jakautumista edeltänyt yhteisö</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4455"/>
    <skos:definition xml:lang="sv">Institution som har uppdelats i en annan institution.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on jakautunut toiseen yhteisöön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50229"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jakautunut yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="en">predecessor of split</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppdelad institution</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3643">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p17100"/>
    <skos:definition xml:lang="fi">Aatelisen sotilassäädyn jäsen keskiajalla. Ritarimerkin saanut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Medlem i adligt soldatstånd på medeltiden. Person som tilldelats riddartecken.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">riddare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ritari</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3644">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p26037"/>
    <skos:definition xml:lang="fi">Kreiviä lähinnä alempi aatelismies useissa maissa; Suomessa vapaaherran puhuttelunimenä.</skos:definition>
    <skos:definition xml:lang="sv">Lägre adelsman närmast greve i flera länder; i Finland tilltalsnamn för friherre.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">baron</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">paroni</skos:prefLabel>
  </owl:Class>
