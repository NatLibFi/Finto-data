    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3422"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3429"/>
    <skos:prefLabel xml:lang="fi">muunnos tyylissä</skos:prefLabel>
