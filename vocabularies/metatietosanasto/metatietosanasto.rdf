  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m384">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare till sångtext</skos:altLabel>
    <skos:altLabel xml:lang="en">lyricist</skos:altLabel>
    <skos:altLabel xml:lang="fi">san. (sanoittaja)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sanoittaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sanoittaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångtextförfattare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">text. (sångtextförfattare)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m552"/>
    <skos:definition xml:lang="sv">Aktör som är författare till ord i en sång, även en musikalsång, som hör till populärmusik.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10204"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">lyricist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sanoittaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångtextförfattare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata pelkän musikaalin dialogin kirjoittajaa. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte författare till endast dialog i en musikal.</skos:scopeNote>
  </owl:Class>
