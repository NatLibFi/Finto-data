  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5054">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2274"/>
    <skos:definition xml:lang="sv">Ekonomiska regioner är områdeshelheter som utgörs av en eller flera kommuner och som bildades på basis av kommuners samarbete och arbetsmarknadsområden.</skos:definition>
    <skos:definition xml:lang="fi">Seutukunnat ovat yhden tai useamman kunnan muodostamia aluekokonaisuuksia, jotka muodostettiin lähinnä kuntien välisen yhteistyön ja työssäkäynnin perusteella ja joilla oli vuosina 1994–2014 virallinen asema aluepoliittisen tukialuejaon perusalueina.</skos:definition>
    <skos:example xml:lang="fi">Järviseudun seutukunta, Haapavesi-Siikalatvan seutukunta; Tampereen seutukunta; Jakobstadsregionen</skos:example>
    <skos:example xml:lang="sv">Järviseutu ekonomiska region; Haapavesi-Siikalatva ekonomiska region; Tammerfors ekonomiska region; Jakobstads ekonomiska region</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ekonomisk region</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">seutukunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m358"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4703"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4778"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4881"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4882"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m604"/>
  </owl:Class>
