    <skos:definition xml:lang="en">An agent who is an individual human being who lives or is assumed to have lived.</skos:definition>
    <skos:definition xml:lang="sv">Person eller identitet skapad av person (ensam eller tillsammans med en eller flera andra individer).</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on ihmisyksilö, joka on elossa tai jonka oletetaan olleen elossa.</skos:definition>
    <skos:prefLabel xml:lang="fi">Henkilö</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Person</skos:prefLabel>
  </owl:Class>
