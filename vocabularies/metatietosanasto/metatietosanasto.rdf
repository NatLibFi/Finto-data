    <skos:prefLabel xml:lang="fi">Uran leveys</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6036">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m61"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/i/P40082"/>
    <skos:definition xml:lang="fi">Kappaleen nimitys, joka on luonnollisen kielen ja yleisen kielen sanamuodon mukainen.</skos:definition>
    <skos:definition xml:lang="sv">Titel för ett exemplar, som är på ett naturligt språk och med en ordalydelse som används i allmänt språk.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6041"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6042"/>
    <skos:prefLabel xml:lang="sv">Exemplarstitel</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kappaleen nimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Title of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6037">
