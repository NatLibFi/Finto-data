    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4343"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4344"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4345"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m51"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m637"/>
    <skos:prefLabel xml:lang="fi">Bibliografinen koko</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Bibliographic format</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Bokens bibliografiska storlek</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Den bibliografiska storleken på gamla tryckta resurser anges genom att använda en lämplig term.</skos:scopeNote>
