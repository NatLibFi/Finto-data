  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1378">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som i grafisk form beskriver kvantitativa eller kvalitativa faktorer i ett informationsmaterial.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka kuvaa graafisessa muodossa tietoaineiston määrällisiä tai laadullisia tekijöitä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kaavio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">schematisk bild</skos:prefLabel>
