    <skos:altLabel xml:lang="fi">kasvatuslaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">koulukoti</skos:altLabel>
    <skos:altLabel xml:lang="fi">lastenkoti</skos:altLabel>
