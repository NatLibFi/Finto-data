    <skos:definition xml:lang="fi">Teos, joka tiivistää toisen teoksen sisällön. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som sammanfattar innehållet i ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10089"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
