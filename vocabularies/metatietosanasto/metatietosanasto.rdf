  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4730">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p22073"/>
    <skos:definition xml:lang="fi">Armeijan joukkoyksikkö, joka käsittää useamman perusyksikön. Pataljoonan komentajana toimii rauhan aikana everstiluutnantti tai majuri, sodan aikana kapteeni tai yliluutnantti (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Truppenhet i armé, som omfattar flera grundenheter och som under fredstid leds av en överstelöjtnant eller major och under krigstid av en kapten eller premiärlöjtnant.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bataljon</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pataljoona</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4731">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ammatilliset opettajakorkeakoulut</skos:altLabel>
    <skos:altLabel xml:lang="fi">korkeakoulu (ammattikorkeakoulu, yhteisötyyppi)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p10564"/>
    <skos:definition xml:lang="fi">Koulutusorganisaatio, jonka tehtävänä on tarjota työelämän vaatimuksiin sekä tutkimukseen, taiteellisiin ja sivistyksellisiin lähtökohtiin perustuvaa opetusta, joka tähtää ammatillisiin asiantuntijatehtäviin (Opetus- ja koulutussanasto).</skos:definition>
    <skos:definition xml:lang="sv">Utbildningsorganisation med uppgift att erbjuda undervisning som är grundad på arbetslivets krav, forskning, konstnärliga och utbildningsmässiga utgångspunkter, och som åsyftar professionella expertuppgifter.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ammattikorkeakoulu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">yrkeshögskola</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4732">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kokous (konferenssi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konferens</skos:altLabel>
    <skos:altLabel xml:lang="fi">konferenssi</skos:altLabel>
    <skos:altLabel xml:lang="sv">kongress</skos:altLabel>
    <skos:altLabel xml:lang="fi">kongressi</skos:altLabel>
    <skos:altLabel xml:lang="fi">opintopäivät</skos:altLabel>
    <skos:altLabel xml:lang="fi">seminaari</skos:altLabel>
    <skos:altLabel xml:lang="sv">seminarium</skos:altLabel>
    <skos:altLabel xml:lang="sv">symposium</skos:altLabel>
    <skos:altLabel xml:lang="fi">symposiumi</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m863"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p38203"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">konferens/seminarium</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">konferenssi/seminaari</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4733">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bogemenskap</skos:altLabel>
    <skos:altLabel xml:lang="sv">by (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="sv">bygemenskap</skos:altLabel>
    <skos:altLabel xml:lang="sv">ekoby</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekokylä</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekoyhteisö</skos:altLabel>
    <skos:altLabel xml:lang="fi">kibbutsi</skos:altLabel>
    <skos:altLabel xml:lang="sv">kibbutz</skos:altLabel>
    <skos:altLabel xml:lang="fi">kollektiivi (asuinyhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kollektiv (boendegemenskap)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kommuuni</skos:altLabel>
    <skos:altLabel xml:lang="fi">kylä (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kyläyhteisö</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p13779"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asuinyhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">boendegemenskap</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4734">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kirkkokunta</skos:altLabel>
    <skos:altLabel xml:lang="sv">kyrkosamfund</skos:altLabel>
    <skos:altLabel xml:lang="sv">religiös rörelse</skos:altLabel>
    <skos:altLabel xml:lang="fi">uskonnollinen liike</skos:altLabel>
    <skos:altLabel xml:lang="fi">uskonnollinen yhdyskunta</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5605"/>
    <skos:definition xml:lang="sv">Registrerade religiösa samfund, Finlands folkkyrkor, registrerade och oregistrerade religiösa sammanslutningar och internationella religiösa gemenskaper (t.ex. katolska kyrkan).</skos:definition>
    <skos:definition xml:lang="fi">Rekisteröidyt uskonnolliset yhdyskunnat, Suomen kansankirkot, rekisteröidyt ja rekisteröimättömät uskonnolliset yhteisöt ja kansainväliset uskonnolliset yhteisöt (esim. katolinen kirkko).</skos:definition>
    <skos:example xml:lang="fi">Katolinen kirkko Suomessa</skos:example>
    <skos:example xml:lang="sv">Katolska kyrkan i Finland</skos:example>
    <skos:example xml:lang="fi">Länsi-Suomen Rukoilevaisten Yhdistys</skos:example>
    <skos:example xml:lang="sv">Ortodoxa kyrkan i Finland</skos:example>
    <skos:example xml:lang="fi">Suomen ortodoksinen kirkko</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">religiöst samfund</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">uskonnollinen yhteisö</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske Suomen kansankirkkojen hallinnollisia yksiköitä (esim. seurakuntia). Rekisteröidyistä uskonnollisista yhdistyksistä termiä voi käyttää termin &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m594'&gt;yhdistys (rekisteröity)&lt;/a&gt; ohessa.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte finländska folkkyrkors förvaltningsenheter (t.ex. församlingar). Om registrerade religiösa föreningar kan termen användas vid sidan av termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m594'&gt;förening (registrerad)&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4735">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ala-aste</skos:altLabel>
    <skos:altLabel xml:lang="fi">alakoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">grundskola (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="sv">högstadium</skos:altLabel>
    <skos:altLabel xml:lang="sv">lågstadium</skos:altLabel>
    <skos:altLabel xml:lang="fi">peruskoulu (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="fi">yläaste</skos:altLabel>
    <skos:altLabel xml:lang="fi">yläkoulu</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2518"/>
    <skos:definition xml:lang="sv">Läroanstalt som erbjuder nioårig grundläggande utbildning.</skos:definition>
    <skos:definition xml:lang="fi">Oppilaitos, joka antaa yhdeksänvuotiseksi mitoitettua perusopetusta (Opetus- ja koulutussanasto).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">grundskola</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">peruskoulu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4736">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">boställe</skos:altLabel>
    <skos:altLabel xml:lang="sv">herrgård</skos:altLabel>
    <skos:altLabel xml:lang="fi">kartano</skos:altLabel>
    <skos:altLabel xml:lang="fi">keskikievari</skos:altLabel>
    <skos:altLabel xml:lang="sv">lantgård</skos:altLabel>
    <skos:altLabel xml:lang="fi">linna</skos:altLabel>
    <skos:altLabel xml:lang="fi">maatila</skos:altLabel>
    <skos:altLabel xml:lang="sv">slott</skos:altLabel>
    <skos:altLabel xml:lang="fi">virkatalo</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1786"/>
