    <skos:prefLabel xml:lang="fi">kommentaari kappaleesta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentar till exemplaret</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5999">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">etsaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">etsare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5563"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation valmistamisesta etsaamalla metallia, lasia tms. pintaa hapon tai muun syövyttävän aineen avulla. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av en manifestation genom att etsa metall, glas eller någon annan yta med hjälp av syra eller något annat frätande ämne.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30356"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">etcher person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">etsaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">etsare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6">
