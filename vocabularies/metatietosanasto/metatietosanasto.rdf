  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5449">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5481"/>
    <skos:definition xml:lang="sv">Aktör som ett verk beskriver.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jota teos kuvaa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10338"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">beskrivning av aktören</skos:prefLabel>
    <skos:prefLabel xml:lang="en">description of agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaus toimijasta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m545">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Mediet består av elektroniska filer och är avsett för att användas med dator. Omfattar både fjärranvändbara medier som används via filservrar och direktanvändbara medier såsom datorband och -skivor.</skos:definition>
    <skos:definition xml:lang="fi">Viestin sisältää elektronisia tiedostoja ja on tarkoitettu käytettäväksi tietokoneella. Käsittää sekä tiedostopalvelimien kautta käytettävät etäkäyttöiset viestimet että suorakäyttöiset viestimet kuten tietokonenauhat ja -levyt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMediaType/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">computer</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dator</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tietokonekäyttöinen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5450">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kompositör (person) av videomusik</skos:altLabel>
    <skos:altLabel xml:lang="fi">videon musiikin säveltäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5464"/>
    <skos:definition xml:lang="en">A person who is responsible for creating a video music work that complements a musical work.</skos:definition>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa videota täydentävän musiikin luomisesta.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av musik som kompletterar en video.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer person of video music work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör av videomusik</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">videon musiikin säveltäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5451">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmproducent (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen elokuvatuottaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän elokuvan tuotannon liiketoiminnasta ensisijaisesti vastaava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som i första hand svarar för affärsverksamheten kring produktionen av en film som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvatuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmproducent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5452">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">klippare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">leikkaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för samling, ordnande och klippning av film, video eller andra format för rörlig bild, både beträffande bild och ljud.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20390"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editor person of moving image work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">klippare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">leikkaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5453">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5453"/>
    <skos:altLabel xml:lang="sv">del-helhetsrelation för exemplar</skos:altLabel>
    <skos:altLabel xml:lang="fi">kappaleen osa-kokonaisuus-suhde</skos:altLabel>
    <skos:altLabel xml:lang="en">whole-part item relationship</skos:altLabel>
    <skos:definition xml:lang="sv">Exemplar som relaterar till ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Kappale, joka liittyy kappaleeseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40046"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4261"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4299"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4311"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4335"/>
    <skos:prefLabel xml:lang="sv">exemplar relaterat till exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleeseen liittyvä kappale</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related item of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5454">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">serieskapare (institution) som är bidragsgivare till stillbild</skos:altLabel>
    <skos:altLabel xml:lang="fi">stillkuvaan osallinen sarjakuvantekijä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6016"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän sarjakuvan kuvien yhteisötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsinstitution för bilder i tecknad serie som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sarjakuvantekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">serieskapare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5455">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5591"/>
    <skos:altLabel xml:lang="sv">källuttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">lähde-ekspressio</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Ekspressio, jota on muokattu uuden ekspression luomiseksi samasta teoksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som har bearbetats för att skapa ett nytt uttryck av samma verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20574"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3540"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3542"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3546"/>
    <skos:prefLabel xml:lang="sv">källversion</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lähdeversio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">source expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5456">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5632"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5467"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen tallennetta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra bärare av ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10387"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bärarversion</skos:prefLabel>
    <skos:prefLabel xml:lang="en">carrier version</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tallenneversio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5457">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5440"/>
    <skos:altLabel xml:lang="fi">teoksen ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">uttryck av verk</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5950"/>
    <skos:definition xml:lang="fi">Ekspressio, joka on teoksen toteutus, joka voi olla muodoltaan aakkosnumeerinen, musiikkinuotinnos, tanssinotaatio, ääntä, kuva, esine, liikettä tms. tai mikä tahansa tällaisten muotojen yhdistelmä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som är ett förverkligande av ett verk, som till sin form kan vara alfanumerisk, musiknotation, dansnotation, ljud, bild, föremål, rörelse eller dylikt, eller vilken som helst kombination av sådana former.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10078"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">expression of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen versio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">version av verk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5458">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fotograf (person) som är bidragsgivare till stillbild</skos:altLabel>
    <skos:altLabel xml:lang="fi">stillkuvaan osallinen valokuvaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5648"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän valokuvan henkilötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsperson till fotografi som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fotograf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valokuvaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5459">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen näyttelijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skådespelare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä musiikki- tai näytelmäesityksessä näyttelevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som skådespelar i ett musikaliskt eller sceniskt uppförande som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">näyttelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skådespelare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m546">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka muodostuu vinyyliryhmästä, tyypillisesti vinyylikloridista, johdetusta polymeeristä tai kopolymeeristä.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av polymer eller sampolymer som härletts från en vinylgrupp, typiskt vinylklorid.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1042"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">vinyl</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vinyl</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vinyyli</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5460">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">lantmätare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">maanmittari (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5287"/>
    <skos:definition xml:lang="sv">Institution som är delaktig aktör i kartografi och ger mått eller proportioner för ett geografiskt område.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka kartografiaan osallisena toimijana tuottaa maantieteellisen alueen mitat tai mittasuhteet. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30395"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lantmätare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maanmittari</skos:prefLabel>
    <skos:prefLabel xml:lang="en">surveyor corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5461">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">remiksaaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">remixer (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">uudelleenmiksaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett ljudverk, genom att manipulera, kombinera, blanda och återproducera tidigare inspelade ljud.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10543"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">remix artist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">remixer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">uudelleenmiksaaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte remixande som inte väsentligen ändrar det ursprungliga verkets karaktär och innehåll, och inte sammanfogande av tidigare inspelade musikstycken till ett musikstycke.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5462">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5818"/>
    <skos:altLabel xml:lang="sv">textuellt verk</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m783"/>
    <skos:definition xml:lang="fi">Teos, joka on tekstiteos, joka täydentää teosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett textverk, som kompletterar ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10371"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3488"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3489"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3501"/>
    <skos:prefLabel xml:lang="fi">tekstiteos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">text work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textverk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5463">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bokbindare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sitoja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5697"/>
    <skos:definition xml:lang="sv">Institution som binder ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka sitoo kappaleen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40130"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">binder corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">bokbindare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sitoja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5464">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kompositör (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">säveltäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa musiikkiteoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett musikverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10442"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säveltäjä</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar omarbetningen av ett annat musikaliskt verk, parafrasen av ett verk, skapandet av ett verk enligt en annan kompositörs allmänna stil eller skapandet av ett verk som grundar sig på en annan kompositörs musik, som gjorts för att bilda en tydlig variant.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5465">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5491"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5961"/>
    <skos:definition xml:lang="sv">Exemplar, vars struktur ett verk beskriver.</skos:definition>
    <skos:definition xml:lang="fi">Kappale, jonka rakennetta teos kuvaa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10266"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">analys av exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="en">analysis of item</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">analyysi kappaleesta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5466">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">intervjuare (institution) som är bidragsgivare till text i verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen teoksen haastattelija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä tietoja keräävä yhteisö. Haastattelee, raportoi, tekee kyselytutkimusta tai kerää ihmisiltä tietoa muulla tavoin.</skos:definition>
    <skos:definition xml:lang="sv">Institution som samlar information som ingår i ett aggregat, genom att intervjua, rapportera, göra gallup eller på annat sätt samla in uppgifter från människor.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastattelija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5467">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5377"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5536"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen yleisöä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra målgrupp för ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10383"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">muunnos yleisössä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by audience</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av målgrupp</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5468">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">asiantuntija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">expert (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som erbjuder experttjänster och ofta ger rekommendationer åt en aktör, som är upphovsperson till ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10458"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asiantuntija</skos:prefLabel>
    <skos:prefLabel xml:lang="en">consultant person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">expert</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5469">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dockspelare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen nukettaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä esityksessä tai filmissä nukkeja käsittelevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som hanterar dockor i en föreställning eller film som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dockspelare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">nukettaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5470">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5098"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen yhteisö, joka on luonut aggregaattiin sisältyvän liikkuvan kuvan teoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Institution som bidragit till ett aggregat, genom att skapa ett uttryck av ett verk med rörlig bild, som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30398"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (institution) till rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor corporate body of moving image</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvaan kuvaan osallinen yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5471">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">beställare</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimeksiantaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppdragsgivare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5574"/>
    <skos:definition xml:lang="sv">Institution som svarar för beställandet av ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa teoksen teettämisestä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10533"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">commissioning corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimeksiantaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppdragsgivare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5472">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deltagare (person) i rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallistuja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ei-fiktiivisen liikkuvan kuvan teoksen ekspression tekemiseen ottamalla aktiivisen roolin osallistujana. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck av ett icke-fiktivt verk med rörlig bild, genom att ta en aktiv roll som deltagare.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20363"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvaan kuvaan osallistuja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">onscreen participant person</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske esiintymistä lisä- tai taustatietojen kertojana. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte uppträdande som berättare av tilläggs- eller bakgrundsinformation.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5473">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare till sångtext</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen sanoittaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångtextförfattare (institution) som är bidragsgivare till musik</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvään populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanat kirjoittanut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som är författare till ord i en sång, även en musikalsång, som hör till populärmusik.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sanoittaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångtextförfattare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5474">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5621"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5924"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen laajennussuunnitelmaa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra utvidgningsplanen för ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10377"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">muunnos laajennussuunnitelmassa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by extension plan</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av utvidgningsplan</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5475">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4814"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5268"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5271"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5373"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5476"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5484"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5572"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5631"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5677"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5952"/>
    <skos:prefLabel xml:lang="sv">Exemplars relationer till manifestationer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kappaleen suhteet manifestaatioon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5476">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5946"/>
    <skos:altLabel xml:lang="sv">arkivbeständig kopia (exemplar)</skos:altLabel>
    <skos:altLabel xml:lang="en">preservation facsimile (item)</skos:altLabel>
    <skos:altLabel xml:lang="fi">säilytyskopio (kappale)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5268"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka koostuu kappaleen täsmällisestä jäljennöksestä. Jäljennöksen valmistuksessa on käytetty arkistokelpoista materiaalia, esim. arkistopaperia. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som består av en exakt reproduktion av ett exemplar. Reproduktionen har tillverkats med arkivbeständigt material, t.ex. arkivpapper.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40090"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arkivbeständig kopia av exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleen säilytyskopio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">preservation facsimile of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5477">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">musiikkiohjelmoija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikprogrammerare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu musiikkiteoksen ekspression tekemiseen tuottamalla ääniä sähköisillä äänilaitteilla tai tietokoneohjelmilla. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i skapandet av ett musikverks uttryck, genom att producera ljud med elektriska ljudenheter eller datorprogram.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20362"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">music programmer person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikkiohjelmoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikprogrammerare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske uuden musiikkiteoksen luomista. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte skapandet av ett nytt musikverk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5478">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression haastateltava (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuobjekt (person) i uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">version haastateltava</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu teoksen ekspression tekemiseen vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jollekin muulle toimijalle, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck av ett verk genom att svara en intervjuare, vanligen en journalist, opinionsmätare eller någon annan aktör, som samlar information.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20354"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastateltava (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">interviewee person of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuobjekt (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5479">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5767"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m783"/>
    <skos:definition xml:lang="fi">Teos, jota täydentää puheteos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som ett talverk kompletterar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10375"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puhe teokseen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spoken word for work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tal till verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5480">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">censor (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen sensori (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää liikkuvaa kuvaa tarkastava yhteisö. Sensori tarkastaa sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein. Alkuperäisen teoksen luonteen ja yleisen sisällön sensori jättää olennaisilta osiltaan muuttumattomaksi.</skos:definition>
    <skos:definition xml:lang="sv">Institution som granskar rörlig bild som ingår i ett aggregat. Censorn granskar innehållet för att dölja kontroversiellt innehåll på moraliska, politiska, militära eller andra grunder. Det ursprungliga verkets karaktär och allmänna innehåll lämnas till sina väsentliga delar oförändrat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">censor</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sensori</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5481">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">behandlad agent</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5482"/>
    <skos:definition xml:lang="sv">Aktör som ett verk handlar om.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jota teos koskee. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10319"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aiheena oleva toimija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">behandlad aktör</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subject agent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5482">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">annan aktör relaterad till verket</skos:altLabel>
    <skos:altLabel xml:lang="fi">muu teokseen liittyvä toimija</skos:altLabel>
    <skos:altLabel xml:lang="en">other agent associated with work</skos:altLabel>
    <skos:definition xml:lang="sv">Aktör som relaterar till ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka liittyy teokseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10311"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m184"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2063"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2181"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m518"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m696"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m999"/>
    <skos:prefLabel xml:lang="sv">aktör relaterad till verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related agent of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teokseen liittyvä toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5483">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">festskriftsföremål</skos:altLabel>
    <skos:altLabel xml:lang="en">honoree person of work</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5899"/>
    <skos:definition xml:lang="fi">Henkilö, jonka kunniaksi teos on tehty. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person till vilkens ära ett verk har gjorts.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10433"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">honouree person of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksella kunnioitettu henkilö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verk tillägnat personen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5484">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5596"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5631"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on jäljenne toista manifestaatiota edustavasta kappaleesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en reproduktion av ett exemplar som representerar en annan manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40092"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleen jäljenne</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reproduced as item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">reproduktion av exemplaret</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5485">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5097"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen henkilö, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat och skapat ett uttryck av ett talverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30342"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (person) till tal</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor person of speech</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puheeseen osallinen henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5486">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">manifestaation tekijä (henkilö)</skos:altLabel>
