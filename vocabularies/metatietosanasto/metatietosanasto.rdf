    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1772"/>
    <skos:prefLabel xml:lang="fi">aiempi omistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">former owner agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tidigare ägare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1744">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">lithographer</skos:altLabel>
    <skos:altLabel xml:lang="sv">litograf (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">litografi (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1747"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkning av en manifestation, genom att tillverka en stenplatta eller någon annan tryckplåt som används i litografi.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation valmistamisesta valmistamalla litografiassa käytetyn kivilaatan tai muun painolaatan. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30074"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">lithographer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">litograf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">litografi</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Avser också grafiker som gör en teckning direkt på en yta som används för tryckning.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1745">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
