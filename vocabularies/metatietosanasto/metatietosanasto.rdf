  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m679">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tahdit päällekkäin</skos:altLabel>
    <skos:altLabel xml:lang="sv">takt under takt</skos:altLabel>
    <skos:altLabel xml:lang="sv">takter på varandra</skos:altLabel>
    <skos:definition xml:lang="sv">Layout som består av takter som visas i parallella enheter, på så vis att början av varje stämmas takt är i vertikal linje med början av en annan stämma för samma takt.</skos:definition>
    <skos:definition xml:lang="fi">Layout, joka koostuu rinnakkaisissa yksiköissä esitetyistä tahdeista siten, että kunkin stemman tahdin alku on pystysuuntaisesti tasattu toisen stemman tai stemmojen saman tahdin alun kanssa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">bar over bar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tahdit allekkain</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">takt över takt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m682">
