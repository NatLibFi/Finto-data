    <skos:definition xml:lang="sv">Uttryck av verk som är en text till en opera, något annat musikaliskt sceniskt verk eller ett oratorium.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20163"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
