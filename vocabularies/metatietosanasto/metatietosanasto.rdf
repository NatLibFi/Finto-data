  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4700">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3822"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Ennen vuotta 2010 Suomessa toiminut aluehallintoviranomainen, jota johti maaherra ja jonka hallintoalueena oli lääni.</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Regionförvaltningsmyndighet i Finland före år 2010.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">länsstyrelse</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lääninhallitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4701">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dödsbodelägare</skos:altLabel>
    <skos:altLabel xml:lang="fi">perikunta</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9152"/>
    <skos:definition xml:lang="sv">Ekonomisk helhet som utgörs av en avliden persons tillgångar och skulder.</skos:definition>
    <skos:definition xml:lang="fi">Kuolinpesällä tarkoitetaan kuolleen henkilön varojen ja velkojen muodostamaa taloudellista kokonaisuutta. Tällainen pesä ei ole oikeushenkilö vaan osakkaidensa väliaikainen henkilöyhteenliittymä. (Wikipedia.)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dödsbo</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuolinpesä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4702">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arbetslöshetskassa</skos:altLabel>
    <skos:altLabel xml:lang="sv">arbetspensionsförsäkringsbolag</skos:altLabel>
    <skos:altLabel xml:lang="sv">arbetspensionskassa</skos:altLabel>
    <skos:altLabel xml:lang="sv">begravningshjälpskassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">eläkesäätiö</skos:altLabel>
    <skos:altLabel xml:lang="sv">försäkringsförening</skos:altLabel>
    <skos:altLabel xml:lang="sv">försäkringskassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">hautausavustuskassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">keskinäinen vakuutusyhtiö</skos:altLabel>
    <skos:altLabel xml:lang="sv">pensionsstiftelse</skos:altLabel>
    <skos:altLabel xml:lang="fi">sairauskassa</skos:altLabel>
    <skos:altLabel xml:lang="sv">sjukkassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">työeläkekassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">työeläkevakuutusyhtiö</skos:altLabel>
    <skos:altLabel xml:lang="fi">työttömyyskassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">vakuutuskassa</skos:altLabel>
    <skos:altLabel xml:lang="fi">vakuutusyhdistys</skos:altLabel>
    <skos:altLabel xml:lang="sv">ömsesidigt försäkringsbolag</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m941"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1453"/>
    <skos:definition xml:lang="sv">Inrättning som erbjuder försäkringar.</skos:definition>
    <skos:definition xml:lang="fi">Vakuutuksia antava laitos (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">försäkringsanstalt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vakuutuslaitos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4703">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
