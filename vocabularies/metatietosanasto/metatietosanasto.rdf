  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m814">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Lasten- ja nuortenkirjallisuuden Finlandia-palkinto</skos:altLabel>
    <skos:definition xml:lang="fi">Myönnetään ansiokkaalle lasten- tai nuortenkirjalle. Palkinnon myöntää Suomen Kirjasäätiö. Palkinto perustettiin 1997.</skos:definition>
    <skos:definition xml:lang="sv">Utdelas åt en meriterad barn- eller ungdomsbok. Priset utdelas av Finlands bokstiftelse. Priset grundades år 1997.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Finlandia Junior-priset, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Finlandia Junior -palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Finlandia Junior -palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Finlandia Junior-priset</skos:prefLabel>
  </owl:Class>
