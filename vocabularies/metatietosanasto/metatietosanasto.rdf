  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4756">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">normaalikoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">normalskola</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p13449"/>
    <skos:definition xml:lang="sv">Läroinrättning som hör till en pedagogisk fakultet vid ett universitet, där lärarstuderande praktiserar.</skos:definition>
    <skos:definition xml:lang="fi">Yliopistojen kasvatustieteelliseen tiedekuntaan kuuluva oppilaitos, jossa opettajakokelaat harjoittelevat. Ennen peruskoulu-uudistusta kansakoulunopettajien koulutuksesta vastanneiden opettajaseminaarien harjoittelukoulu.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">harjoittelukoulu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">övningsskola</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4757">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
