    <skos:prefLabel xml:lang="sv">exemplar av materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">exemplar of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m592">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet som utgörs av en enskild enhet eller ett modellexemplar som har valts ut för att representera en större totalmängd.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, joka muodostuu yksittäisestä yksiköstä tai mallikappaleesta, joka on valittu edustamaan suurempaa kokonaismäärää.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1036"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">näyte</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">prov</skos:prefLabel>
    <skos:prefLabel xml:lang="en">specimen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5920">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5965"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5549"/>
    <skos:definition xml:lang="fi">Metatietoteoksen kuvailema teos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som ett metadataverk beskriver.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10621"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">metadata description of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">metadatabeskrivning av verket</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">metatietokuvailu teoksesta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5921">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">keksijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppfinnare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa uuden välineen tai menetelmän luomisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett nytt redskap eller en ny metod.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10443"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">inventor person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">keksijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppfinnare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5922">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kommentaattori (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommentator (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som deltar i skapandet av ett uttryck, genom att tolka, analysera eller diskutera ett ämne i en ljudupptagning, en film eller annat audiovisuellt material.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20377"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">commentator person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kommentaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentator</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5923">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">pistekirjoituksen tekijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">punktskriftspräglare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5611"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av en manifestation, genom att producera punktskriftstecken med hjälp av en penna, en speciell präglingsskrivare eller någon annan apparat.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation valmistamisesta tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30409"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">braille embosser corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pistekirjoituksen tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">punktskriftspräglare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5924">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5495"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5536"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen toiminta-alaa tai toimituslinjaa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra ett verks verksamhetsfält eller redaktionella linje.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10344"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2274"/>
    <skos:prefLabel xml:lang="fi">muunnos linjassa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by policy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av policy</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5925">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">gravör (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaivertaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5487"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av en manifestation, genom att gravera bokstäver, mönster eller andra tecken på en yta som används vid tryck, såsom en trä- eller metallyta.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation valmistamisesata kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30408"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">engraver corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gravör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaivertaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5926">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">pistekirjoituksen tekijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">punktskriftspräglare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5937"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation valmistamisesta tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av en manifestation, genom att producera punktskriftstecken med hjälp av en penna, en speciell präglingsskrivare eller någon annan apparat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30351"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">braille embosser person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pistekirjoituksen tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">punktskriftspräglare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5927">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5646"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5474"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen laajennussuunnitelmaa päivittyvästä peräkkäiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra utvidgningsplanen för ett verk, från integrerande till successiv.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10379"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">peräkkäisversio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sequential version</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">successiv version</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5928">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">censor (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sensori (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5739"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att granska innehållet i ett annat uttryck för att dölja kontroversiellt innehåll på moraliska, politiska, militära eller andra grunder, men ändå låta det ursprungliga verkets karaktär och allmänna innehåll till sina väsentliga delar förbli oförändrat.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20474"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">censor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">censor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sensori</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske laajaa muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte omfattande redigering, som leder till skapandet av ett nytt verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5929">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5375"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5818"/>
    <skos:definition xml:lang="fi">Musiikkiteos, jota tekstiteos täydentää. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Musikverk som kompletteras av ett textverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10369"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">lyrics for work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sanoitus teokseen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångtext till verket</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Omfattar inte text till opera, något annat musikaliskt sceniskt verk eller oratorium.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sanoitus ei kata oopperan tai muun musiikillisen näyttämöteoksen tai oratorion tekstiä. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5930">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen ääninäyttelijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">röstskådespelare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvään dubbaukseen, mainokseen, äänituotantoon tai elokuvan animoidulle hahmolle tms. äänensä antava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som ger sin röst åt en karaktär i dubbning, reklam, ljudproduktion eller animerad film etc. som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">röstskådespelare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääninäyttelijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5932">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspressioon liittyvä henkilö</skos:altLabel>
    <skos:altLabel xml:lang="sv">person relaterad till uttrycket</skos:altLabel>
    <skos:definition xml:lang="fi">Henkilö, joka liittyy ekspressioon. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som relaterar till ett uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20302"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">person relaterad till versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related person of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">versioon liittyvä henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5933">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">dubbausohjaaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">dubbningsregissör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som svarar för allmän ledning och övervakning av tillägget av ny dialog eller andra röster, för att komplettera ett uttrycks ljudspår.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka vastaa uuden dialogin tai muiden äänien lisäämisprosessin yleisestä johtamisesta ja valvonnasta ekspression ääniraidan täydentämiseksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20511"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">dubbausohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dubbing director corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dubbningsregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5934">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">intervjuobjekt (person) i verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen haastateltava (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa teoksen luomisesta vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jonkinlaiselle muulle toimijalle, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett verk, genom att svara en intervjuare, vanligen en journalist, opinionsmätare eller någon annan aktör, som samlar information.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10447"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">interviewee person of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuobjekt i verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen haastateltava</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5935">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esineeseen osallinen piirtäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ritare (institution) som är bidragsgivare till föremål</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5337"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä laatinut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som utarbetat precisa planer eller ritningar av byggnader, fartyg, flygplan, apparater eller föremål, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">piirtäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ritare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5936">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m875"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4428"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5308"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5427"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5577"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5666"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5914"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5976"/>
    <skos:prefLabel xml:lang="sv">Släkters relationer till släkter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Suvun suhteet sukuun</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5937">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tillverkare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valmistaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5486"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa julkaistun manifestaation painamisesta, monistamisesta, kirjasinten valamisesta tai muusta valmistustavasta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tryckningen, mångfaldigandet, gjutandet av typer eller något annat framställningssätt för en utgiven manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30361"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">manufacturer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tillverkare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valmistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5938">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">domstolssekreterare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuomioistuimen kirjuri (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5805"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett verks uttryck, genom att förbereda en domstols utlåtande för publicering.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu teoksen ekspression tekemiseen valmistelemalla tuomioistuimen lausunnon julkaistavaksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20470"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">court reporter corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">domstolssekreterare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuomioistuimen kirjuri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5939">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen valosuunnittelija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljusdesigner (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljussättare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä valokomponentteja suunnitteleva ja tekevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som planerar och skapar ljuskomponenter, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
