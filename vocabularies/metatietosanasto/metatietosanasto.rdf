    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kritik av verket i</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen kritiikki</skos:prefLabel>
    <skos:prefLabel xml:lang="en">work critiqued by</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5917">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">librettist (institution) som är bidragsgivare till musik {@sv}</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen libretisti (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin liittyvän musiikin tai koreografian, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanat kirjoittanut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som skrivit texten till ett musikaliskt eller koreografiskt verk, såsom en opera, en balett eller något annat musikaliskt sceniskt verk eller oratorium, som relaterar till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">libretisti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">librettist</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5918">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen musiikkijohtaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikalisk ledare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä elokuvatuotannossa, musiikki- tai näytelmäesityksessä säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa koordinoiva yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som koordinerar kompositörers, ljudklippares och ljudmixares verksamhet i en filmproduktion eller i ett musikaliskt eller sceniskt uppförande som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">musiikillinen johtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikalisk ledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5919">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5572"/>
