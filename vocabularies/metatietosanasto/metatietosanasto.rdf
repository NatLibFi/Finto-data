  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1074">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Elokuvafilmin esitysformaatti, joka luo kolmiulotteisuuden vaikutelman käyttämällä stereoskooppisia kuvia.</skos:definition>
    <skos:definition xml:lang="sv">Visningsformat för film, som skapar ett tredimensionellt intryck genom användning av stereoskopiska bilder.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/presFormat/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">stereoscopic</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">stereoskooppinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stereoskopisk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1077">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ASCII</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ASCII</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1078">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll uttryckt med teckensystem för språk, avsett att vidröras. T.ex. punktskrift och andra former av taktil text.</skos:definition>
    <skos:definition xml:lang="fi">Kielen merkkijärjestelmällä esitetty sisältö, joka on tarkoitettu kosketeltavaksi. Esimerkiksi pistekirjoitus ja muut taktiilit tekstinkirjoitusmuodot.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1018"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">tactile text</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taktiili teksti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">taktil text</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1079">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30185"/>
    <skos:altLabel xml:lang="sv">Spårkonfiguration (ljudband)</skos:altLabel>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m0"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1146"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m183"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m300"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m667"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m832"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m857"/>
    <skos:prefLabel xml:lang="sv">Antal spår (ljudband)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Tape configuration</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Ääninauhan raitojen määrä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m108">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken kopior av en manifestation som registreras med känselsinnet tillverkas av antingen metall- eller plastplattor.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa joko metalli- tai muovilevystä valmistetaan tuntoaistilla havainnoitavan manifestaation kopioita.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1018"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">embossing</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kohopaino</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">relieftryck</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1082">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som vanligen består av en tvådimensionell karta i skala, som i sin helhet eller delvis är en beskrivning av ytan av ett objekt på jorden, stjärnhimlen eller en fiktiv plats.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka koostuu yleensä mittakaavassa ja kaksiulotteisena esitetystä kartasta, joka on maan tai muun tähtitaivaan kappaleen tai kuvitteellisen paikan pinnan kuvaus kokonaisuudessaan tai osittain.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">karta</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kartta</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: kartor, xx kartor</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: karttoja, xx karttaa</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1083">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Tunnt, hållbart, genomskinligt eller ogenomskinligt material tillverkat att kalv-, får-, eller getskinn, och på vilket man kan skriva eller som kan användas för andra ändamål.</skos:definition>
    <skos:definition xml:lang="fi">Vasikan, lampaan tai vuohennahasta valmistettu ohut, kestävä, läpikuultava tai läpinäkymätön materiaali, jolle voi kirjoittaa tai jota voi käyttää kirjansitomiseen tai muihin tarkoituksiin.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1026"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">parchment</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">pergament</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pergamentti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1084">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Lähetysstandardi, joka on Ranskassa ensin käytetyn analogisen television värikoodausjärjestelmä, nimetty Séquentiel couleur à mémoiren mukaan.</skos:definition>
    <skos:definition xml:lang="sv">Sändningsstandard och färgkodningssystem för analog television som först användes i Frankrike. Namngett enligt Séquentiel couleur à mémoire.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/broadcastStand/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">SECAM</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">SECAM</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">SECAM</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1086">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">landscape architect</skos:altLabel>
    <skos:altLabel xml:lang="sv">landskapsarkitekt (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">landskapsarkitekt (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">maisema-arkkitehti (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">maisema-arkkitehti (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m713"/>
    <skos:definition xml:lang="sv">Aktör som är en arkitekt och svarar för skapandet av landskapsverk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10200"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">landscape architect agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">landskapsarkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maisema-arkkitehti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1088">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:example xml:lang="fi">Ikäsuositus: 3–7-vuotiaille.</skos:example>
    <skos:example xml:lang="fi">Ikäsuositus: yli 10-vuotiaille.</skos:example>
    <skos:example xml:lang="sv">Åldersrekommendation: för 3–7-åringar.</skos:example>
    <skos:example xml:lang="sv">Åldersrekommendation: för över 10-åringar.</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Ikäsuositus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Åldersrekommendation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1089">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Optisen levyn laserluettava videoformaatti.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för optisk skiva som kan avläsas med laser.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/videoFormat/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Laser optical</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">optinen levy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">optisk skiva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1091">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tre gånger i veckan</skos:altLabel>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kolme kertaa viikossa.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras tre gånger i veckan.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kolme kertaa viikossa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">three times a week</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tre gånger per vecka</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1096">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">transcriber</skos:altLabel>
    <skos:altLabel xml:lang="sv">transkr. (transkriberare)</skos:altLabel>
    <skos:altLabel xml:lang="fi">transkr. (transkriboija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">transkriberare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">transkriboija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5705"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att uppteckna eller skriva ner noter för ett oskrivet eller onoterat innehåll eller ändra dess notationssystem till ett annat.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20034"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">transcriber agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">transkriberare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">transkriboija</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Hit hör inte transkribering av ett musikverk för ett annat instrument eller en annan framförande grupp.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tähän ei kuulu musiikkiteoksen transkribointi eri soittimelle tai esitysryhmälle. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1099">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">exlibris</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">exlibris</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Henkilön/yhteisön nimi</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Persons/institutions namn</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m110">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m61"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1020"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1651"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m285"/>
    <skos:prefLabel xml:lang="fi">Hankintatapa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1100">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">band</skos:altLabel>
    <skos:altLabel xml:lang="sv">ensemble</skos:altLabel>
    <skos:definition xml:lang="sv">Uppträdande grupp vanligtvis bestående av färre än tio musiker.</skos:definition>
    <skos:definition xml:lang="fi">Yleensä alle kymmenen muusikon esittäjäryhmä.</skos:definition>
    <skos:example xml:lang="sv">Beatles (musikgrupp)</skos:example>
    <skos:example xml:lang="fi">Beatles (yhtye)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">musikgrupp</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhtye</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1105">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tal (ljudinnehåll)</skos:altLabel>
    <skos:definition xml:lang="fi">Kuunneltavaksi tarkoitettu kielellinen sisältö. Sisältää esim. puheäänitteet, runonlausunnat, puheet, haastattelut, suulliset tarinat, tietokoneella tuotetun puheen jne.</skos:definition>
    <skos:definition xml:lang="sv">Språkligt innehåll avsett att lyssnas på. Omfattar inbandade tal, poesiuppläsning, tal (föredrag), intervjuer, muntliga berättelser, tal producerat på dator o.s.v.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puhe</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spoken word</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tal</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1111">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljustryck</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valopaino</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1114">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kirjallisuuspalkinto, jota Kirjakauppaliitto, Libro ja Suomen Kirjastoseura ovat jakaneet vuodesta 1966. Palkinto annetaan kotimaiselle kirjailijalle, jonka edellisen vuoden suomen- tai ruotsinkielinen teos on elähdyttänyt kaunokirjallisuutta.</skos:definition>
    <skos:definition xml:lang="sv">Litteraturpris som har utdelats av Bokhandelsförbundet, Libro och Finlands biblioteksförening sedan 1966. Priset utdelas åt en inhemsk författare, som föregående år gett ut ett stimulerande skönlitterärt verk på finska eller svenska.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Tack för boken-medaljen, 1966</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Kiitos kirjasta -mitali, 1966</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Kiitos kirjasta -mitali</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tack för boken-medaljen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1116">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">magneettiset partikkelit</skos:altLabel>
    <skos:altLabel xml:lang="sv">magnetiska partiklar</skos:altLabel>
    <skos:definition xml:lang="fi">Materiaali, joka on luonnollista tai synteettistä epäorgaanista yhdistettä ja joka muodostuu erittäin magneettisista partikkeleista. Käytetään tavallisesti binaaristen tai analogisten tietojen tallentamiseen.</skos:definition>
    <skos:definition xml:lang="sv">Material som är naturlig eller syntetisk oorganisk förening och som bildas av mycket magnetiska partiklar. Används vanligen gällande lagring av binär eller analog data.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1021"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">magneettijauhe</skos:prefLabel>
    <skos:prefLabel xml:lang="en">magnetic particles</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">magnetpulver</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1117">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m731"/>
    <skos:altLabel xml:lang="sv">baserat på uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="en">expression of source work</skos:altLabel>
    <skos:altLabel xml:lang="fi">lähdeteoksen ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="fi">lähdeteoksen versio</skos:altLabel>
    <skos:altLabel xml:lang="fi">perustuu ekspressioon</skos:altLabel>
    <skos:altLabel xml:lang="sv">uttryck för källverk</skos:altLabel>
    <skos:altLabel xml:lang="sv">version av källverk</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, jota on muokattu johdannaisteoksen ekspression luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, som har bearbetats för att skapa ett uttryck av ett härlett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20204"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3492"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3534"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3535"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3536"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3537"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3539"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3541"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3545"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3548"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3550"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3551"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4271"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4584"/>
    <skos:prefLabel xml:lang="en">based on expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ekspression perustana</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uttryck baserat på</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1118">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deltagare i paneldiskussion (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">paneldeltagare</skos:altLabel>
    <skos:altLabel xml:lang="en">panelist</skos:altLabel>
    <skos:altLabel xml:lang="fi">panelisti (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i utförandet av ett uttryck, genom att delta i ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter inom ämnen som relaterar till diskussionen.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20019"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i paneldiskussion</skos:prefLabel>
    <skos:prefLabel xml:lang="en">panelist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">panelisti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1122">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka on valmistettu prosessoimalla keinotekoisia materiaaleja, yleensä luonnollisten materiaalien korvaajana.</skos:definition>
    <skos:definition xml:lang="sv">Material som har tillverkats genom att bearbeta konstgjorda material, vanligen som ersättning för naturliga material.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1037"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">synteettinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">syntetisk</skos:prefLabel>
    <skos:prefLabel xml:lang="en">synthetic</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1123">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jaetaan vuosittain ansiokkaan romaanin kirjoittajalle. Palkinto perustettiin vuonna 1984. Alun perin palkinto myönnettiin mille tahansa kaunokirjalliselle teokselle mutta vuodesta 1993 sen on voinut saada vain romaani.</skos:definition>
    <skos:definition xml:lang="sv">Utdelas årligen åt en författare som skrivit en meriterad roman. Priset grundades år 1984. Ursprungligen utdelades priset åt vilken skönlitterär genre som helst, men från och med år 1993 har endast romaner kunnat få priset.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Finlandiapriset, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Finlandia-palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Finlandia-palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Finlandiapriset</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1125">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Avokela, jossa on ääninauha. Käytetään kelanauhurilaitteistolla.</skos:definition>
    <skos:definition xml:lang="sv">Spole som innehåller ljudband. Används i rullbandspelare.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audiotape reel</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudspole</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänikela</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1127">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken kopior framställs i en ljuskänslig process, som återger opaka toner eller färger som svarta eller färg på vit botten.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa valmistetaan kopioita valoherkässä prosessissa, joka toistaa läpinäkymättömät sävyt tai värit mustana tai värinä valkoisella taustalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">white print -menetelmä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">white print process</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">white print-metod</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1130">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laakapainomenetelmä, jossa kivi tai laatta käsitellään vettähylkivällä aineella, joka tekee osan laatasta vastaanottavaiseksi musteelle.</skos:definition>
    <skos:definition xml:lang="sv">Plantrycksmetod, i vilken en sten eller en platta behandlas med vattenavstötande ämne som gör en del av plattan mottagglig för bläck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">lithography</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">litografi</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">litografia</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1131">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll uttryckt som en form eller former, avsett att vidröras som en tredimensionell form.</skos:definition>
    <skos:definition xml:lang="fi">Muotona tai muotoina esitetty sisältö, joka on tarkoitettu kosketeltavaksi kolmiulotteiseksi muodoksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1019"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">taktiili kolmiulotteinen muoto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">taktil tredimensionell form</skos:prefLabel>
    <skos:prefLabel xml:lang="en">three-dimensional form</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1132">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DEM</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DEM</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1137">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">gravering</skos:altLabel>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken figurer i ett hårt materials yta görs genom att gravera med ett vasst redskap.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa tehdään kuvioita kovan materiaalin pintaan terävällä työkalulla kaivertamalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">engraving</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gravyr</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaiverrus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1139">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Brusreduceringssystem för analogt magnetband, som är en förenklad version av Dolby-A för konsumentbruk, utvecklat av Dolby Laboratories.</skos:definition>
    <skos:definition xml:lang="fi">Dolby Laboratoriesin analogiselle magneettinauhalle kehittämä melunvaimennusjärjestelmä, joka on Dolby-A:n yksinkertaistettu versio kuluttajakäyttöön.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/specPlayback/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Dolby B</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Dolby B</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Dolby-B encoded</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1141">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
