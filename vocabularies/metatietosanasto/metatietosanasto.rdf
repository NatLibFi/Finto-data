    <skos:prefLabel xml:lang="fi">meedio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m903">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, stillbild som består av ett meddelande, vanligtvis utsmyckat eller illustrerat, som avser att göra reklam för, främja eller informera om en verksamhet, händelse, produkt eller tjänst. (eng. poster)</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, liikkumaton kuva, joka sisältää ilmoituksen, yleensä koristeellinen tai kuvitettu, tarkoituksenaan mainostaa, edistää tai tiedottaa jostakin toiminnasta, tapahtumasta, tuotteesta tai palvelusta. (engl. poster)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1029"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">affisch</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">juliste</skos:prefLabel>
    <skos:prefLabel xml:lang="en">poster</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m905">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kartografiskt innehåll uttryckt som form eller former och avsett att ses på tredimensionellt. T.ex. glober och miniatyrmodeller.</skos:definition>
    <skos:definition xml:lang="fi">Muotona tai muotoina esitetty kartografinen sisältö, joka on tarkoitettu katsottavaksi kolmiulotteisena.
Esimerkiksi karttapallot, pienoismallit jne.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">cartographic three-dimensional form</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kartografinen kolmiulotteinen muoto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kartografisk tredimensionell form</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m906">
