  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1402">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">velin</skos:altLabel>
    <skos:definition xml:lang="fi">Hienolaatuista vasikan- tai lampaannahkaa oleva pergamentti.</skos:definition>
    <skos:definition xml:lang="sv">Kvalitativt pergament av kalv- eller lammskinn.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1041"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">veliini</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vellum</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">veläng</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1405">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka muodostuu eläimen, esimerkiksi lampaan, vuohen tai vasikan nyljetystä nahasta, jota on käsitelty eri tavoin karvojen poistamiseksi, kuivaamiseksi, värjäämiseksi tai muuten koristelemiseksi.</skos:definition>
    <skos:definition xml:lang="sv">Material som utgörs av skinn från t.ex. får, get eller kalv och som behandlats på olika sätt för att ta bort hår, torkas, färgas eller på annat sätt dekoreras.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1035"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">hud</skos:prefLabel>
    <skos:prefLabel xml:lang="en">skin</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vuota</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1407">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">host</skos:altLabel>
    <skos:altLabel xml:lang="fi">juont. (juontaja)</skos:altLabel>
    <skos:altLabel xml:lang="fi">juontaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">juontaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programledare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programledare (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i utförandet av ett uttryck, genom att leda ett (ofta utsänt) program, i vilket andra uppträdande deltar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen juontamalla (usein lähetettyä) ohjelmaa, johon osallistuu muita esiintyjiä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">host agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">juontaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m141">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Har utdelats sedan 1987. Priset utdelas av tidningen Uusimaa, Borgå stad, Suomen kirjailijaliitto, Finlands kritikerförbund och Finlands svenska författareförening.</skos:definition>
    <skos:definition xml:lang="fi">Jaettu vuodesta 1987 lähtien. Sen jakavat yhdessä sanomalehti Uusimaa, Porvoon kaupunki, Suomen kirjailijaliitto, Suomen arvostelijain liitto ja Finlands Svenska Författarföreningen.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Runebergspriset, 1987</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Runeberg-palkinto, 1987</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Runeberg-palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Runebergspriset</skos:prefLabel>
  </owl:Class>
