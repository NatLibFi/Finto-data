    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi Blu-ray -levylle, joka on koodattu toistettavaksi Euroopassa, Grönlannissa, Ranskan merentakaisilla alueilla, Lähi-idässä, Afrikassa, Australiassa ja Uudessa-Seelannissa.</skos:definition>
