    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tietyöntekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vägarbetare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4078">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">junanlähettäjä</skos:altLabel>
    <skos:altLabel xml:lang="fi">junasuorittaja</skos:altLabel>
    <skos:altLabel xml:lang="sv">trafikdirigerare</skos:altLabel>
    <skos:altLabel xml:lang="sv">tågklarerare</skos:altLabel>
    <skos:definition xml:lang="sv">En trafikledare ansvarar för dirigering och tryggande av järnvägstrafik. Tidigare användes facktermen tågklarerare.</skos:definition>
    <skos:definition xml:lang="fi">Liikenteenohjaaja vastaa rautatieliikenteen ohjaamisesta ja turvaamisesta. Ennen käytettiin ammattitermejä junanlähettäjä ja junasuorittaja.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikenteenohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">trafikledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4079">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kylmien ruokien valmistaja ravintolassa tms. (Lähde: Kielitoimiston sanakirja).</skos:definition>
    <skos:definition xml:lang="sv">Tillverkare av kalla rätter i restaurang e.d.</skos:definition>
