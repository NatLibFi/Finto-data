    <skos:definition xml:lang="sv">Orkester som i huvudsak består av bleckblåsinstrument.</skos:definition>
    <skos:definition xml:lang="fi">Pääosin vaskipuhaltimista koostuva orkesteri.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blåsorkester</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puhallinorkesteri</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Jos orkesteri koostuu pääosin puupuhaltimista, käytetään ensisijaisesti käsitettä kamariorkesteri.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om orkestern i huvudsak består av träblåsinstrument används i första hand begreppet kammarorkester.</skos:scopeNote>
  </owl:Class>
