    <skos:prefLabel xml:lang="fi">suvun kategoria</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4866">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">aatelisperhe</skos:altLabel>
    <skos:altLabel xml:lang="fi">aatelissuku</skos:altLabel>
    <skos:altLabel xml:lang="sv">adelssläkt</skos:altLabel>
    <skos:altLabel xml:lang="sv">adelsätt</skos:altLabel>
    <skos:altLabel xml:lang="sv">allmogesläkt</skos:altLabel>
    <skos:altLabel xml:lang="sv">bondesläkt</skos:altLabel>
    <skos:altLabel xml:lang="sv">borgarsläkt</skos:altLabel>
    <skos:altLabel xml:lang="sv">familj</skos:altLabel>
    <skos:altLabel xml:lang="sv">furstesläkt</skos:altLabel>
    <skos:altLabel xml:lang="fi">pappissuku</skos:altLabel>
    <skos:altLabel xml:lang="fi">perhe</skos:altLabel>
    <skos:altLabel xml:lang="fi">perhekunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">porvarisperhe</skos:altLabel>
    <skos:altLabel xml:lang="fi">porvarissuku</skos:altLabel>
    <skos:altLabel xml:lang="sv">prästsläkt</skos:altLabel>
    <skos:altLabel xml:lang="fi">ruhtinassuku</skos:altLabel>
    <skos:altLabel xml:lang="fi">sisarukset (suku)</skos:altLabel>
    <skos:altLabel xml:lang="sv">släktingar</skos:altLabel>
    <skos:altLabel xml:lang="fi">suku (suvun kategoria)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sukulaiset</skos:altLabel>
    <skos:altLabel xml:lang="sv">syskon (släkt)</skos:altLabel>
    <skos:altLabel xml:lang="fi">talonpoikaissuku</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p409"/>
    <skos:definition xml:lang="sv">Personer som härstammar från samma förfäder (och i vissa sammanhang även makar till personerna)</skos:definition>
    <skos:definition xml:lang="fi">Samasta esivanhemmasta polveutuvat henkilöt (ja joissakin yhteyksissä myös heidän puolisonsa) (Kielitoimiston sanakirja).</skos:definition>
    <skos:example xml:lang="sv">Gummerus (släkt); Romanov (släkt); Sinebrychoff (släkt); Sursill (släkt)</skos:example>
    <skos:example xml:lang="fi">Gummerus (suku); Romanov (suku); Sinebrychoff (suku); Sursill (suku)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">family</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släkt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">suku</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4867">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">sukuyhteisö (klaani)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p22042"/>
    <skos:definition xml:lang="sv">Släktgemenskap som benämns klan och som härstammar, eller anser sig härstamma, från en gemensam stamfader.</skos:definition>
    <skos:definition xml:lang="fi">Sukuyhteisö, jota kutsutaan klaaniksi ja joka polveutuu tai katsoo polveutuvansa yhteisestä kantaisästä (Kielitoimiston sanakirja).</skos:definition>
    <skos:example xml:lang="fi">Donald (klaani); Ramsay (klaani)</skos:example>
    <skos:example xml:lang="sv">Donald (klan); Ramsay (klan)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">clan</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">klaani</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">klan</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4868">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kungafamilj</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuningasperhe</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9666"/>
    <skos:definition xml:lang="fi">Hallitsijasuku, jota kutsutaan dynastiaksi. Laajemmin hallitsevasta, määräävässä asemassa olevasta ryhmästä (Kielitoimiston sanakirja).</skos:definition>
    <skos:definition xml:lang="sv">Regentsläkt som benämns dynasti. Vidare om härskande grupp i dominerande ställning.</skos:definition>
    <skos:example xml:lang="sv">Pahlavi (dynasti : 1925-1979); Romanov (dynasti : 1613-1917)</skos:example>
    <skos:example xml:lang="fi">Pahlavi (dynastia : 1925-1979); Romanov (dynastia : 1613-1917)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dynasti</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">dynastia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dynasty</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4869">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kungafamilj</skos:altLabel>
    <skos:altLabel xml:lang="sv">kungasläkt</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuningasperhe</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuningassuku</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9662"/>
    <skos:definition xml:lang="sv">Kungafamilj eller -släkt. Termen används när man hänvisar till en regerande kungafamilj eller -släkt. Om dynasti som ett kungahus eventuellt bildar används termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4868'&gt;dynasti&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Kuningasperhe tai -suku (Kielitoimiston sanakirja). Termiä käytetään, kun viitataan hallitsevassa asemassa olevaan kuningasperheeseen tai -sukuun. Kuningashuoneen mahdollisesti muodostamasta dynastiasta käytetään termiä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4868'&gt;dynastia&lt;/a&gt;.</skos:definition>
    <skos:example xml:lang="sv">Bernadotte (kungahus : 1818- : Sverige); Bourbon (kungahus); Windsor (kungahus : 1917- : Storbritannien)</skos:example>
    <skos:example xml:lang="fi">Bernadotte (kuningashuone : 1818- : Ruotsi); Bourbon (kuningashuone); Windsor (kuningashuone : 1917- : Iso-Britannia)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kungahus</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuningashuone</skos:prefLabel>
    <skos:prefLabel xml:lang="en">royal house</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m487">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Brusreduceringssystem för analogt magnetband och för professionellt bruk, utvecklat av Dolby Laboratories.</skos:definition>
    <skos:definition xml:lang="fi">Dolby Laboratoriesin kehittämä melunvaimennusjärjestelmä ammattimaiseen käyttöön analogisessa magneettinauhassa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/specPlayback/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Dolby A</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Dolby A</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Dolby-A encoded</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4872">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m281"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/a/P50238"/>
    <skos:altLabel xml:lang="sv">Typ av förvaltningsområde</skos:altLabel>
    <skos:altLabel xml:lang="fi">hallintoalueen tyyppi</skos:altLabel>
    <skos:altLabel xml:lang="sv">kategori för offentligrättslig institution</skos:altLabel>
    <skos:altLabel xml:lang="sv">typ av administrativ enhet</skos:altLabel>
    <skos:altLabel xml:lang="en">type of jurisdiction</skos:altLabel>
    <skos:definition xml:lang="en">A type to which a government belongs.</skos:definition>
    <skos:definition xml:lang="sv">Typ till vilken en offentligrättslig institution hör.</skos:definition>
    <skos:definition xml:lang="fi">Tyyppi, johon julkishallinnollinen yhteisö kuuluu.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4754"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4778"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4873"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4874"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4875"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4876"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4877"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4878"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4879"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4880"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4881"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4882"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4883"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4884"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4885"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4886"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5054"/>
    <skos:prefLabel xml:lang="en">category of government</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">julkishallinnollisen yhteisön kategoria</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kategori av offentligrättslig institution</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4873">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Verksamhetsområde för fogde, inom Sveriges administration från början av 1500-talet till 1630-talet. Efter det övergick man till läns- och häradsförvaltning och fögderierna avskaffades.</skos:definition>
    <skos:definition xml:lang="fi">Voudin toimialue Ruotsin hallinnossa 1500-luvun alkupuolelta 1630-luvulle, jolloin siirryttiin läänin- ja kihlakuntahallintoon ja voutikunnat lakkasivat olemasta.</skos:definition>
    <skos:example xml:lang="fi">Pohjanmaan eteläinen voutikunta</skos:example>
    <skos:example xml:lang="sv">Österbottens södra fögderi</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fögderi</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">voutikunta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4874">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">biskopsstift</skos:altLabel>
    <skos:altLabel xml:lang="sv">stift (kyrkan)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p17660"/>
    <skos:definition xml:lang="sv">Administrativ enhet eller verksamhetsområde för kyrkans regionalförvaltning.</skos:definition>
    <skos:definition xml:lang="fi">Kirkon aluehallinnon yksikkö tai sen toimialue.</skos:definition>
    <skos:example xml:lang="sv">Kuopio stift; Helsingfors ärkestift; Helsingfors katolska stift</skos:example>
    <skos:example xml:lang="fi">Kuopion hiippakunta; Helsingin arkkihiippakunta; Helsingin katolinen hiippakunta</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">hiippakunta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stift</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4877"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4875">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9470"/>
    <skos:definition xml:lang="sv">Del av förbundsstat eller dess verksamhetsområde som kallas delstat.</skos:definition>
    <skos:definition xml:lang="fi">Liittovaltion osa tai sen toimialue, jota kutsutaan osavaltioksi.</skos:definition>
    <skos:example xml:lang="sv">Alaska (Förenta staterna); Hessen (Tyskland)</skos:example>
    <skos:example xml:lang="fi">Alaska (Yhdysvallat); Hessen (Saksa)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">delstat</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">osavaltio</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4883"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4876">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">koloni</skos:altLabel>
    <skos:altLabel xml:lang="fi">kolonia (siirtomaa)</skos:altLabel>
    <skos:altLabel xml:lang="fi">protektoraatti</skos:altLabel>
    <skos:altLabel xml:lang="sv">protektorat</skos:altLabel>
    <skos:altLabel xml:lang="fi">siirtomaa</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p8709"/>
    <skos:definition xml:lang="fi">Jonkin valtion alainen, yleensä sen rajojen ulkopuolinen epäitsenäinen alue. Myös aluetta hallinnoiva yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Osjälvständigt område i någon stats besittning, vanligtvis utanför statens egna gränser. Även institution som förvaltar området.</skos:definition>
    <skos:example xml:lang="fi">Kapmaa; Saksan Uusi-Guinea; Uusi-Ranska</skos:example>
    <skos:example xml:lang="sv">Kapprovinsen; Tyska Nya Guinea; Nya Frankrike</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alusmaa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">besittning</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4879"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4877">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kontrakt (prosteri)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p20938"/>
    <skos:definition xml:lang="sv">Administrativ del av stift eller dess verksamhetsområde inom Evangelisk-lutherska kyrkan i Finland.</skos:definition>
    <skos:definition xml:lang="fi">Suomen evankelis-luterilaisen kirkon hiippakunnan hallinnollinen osa tai sen toimialue.</skos:definition>
    <skos:example xml:lang="sv">Tammerfors domprosteri; Kangasala prosteri</skos:example>
    <skos:example xml:lang="fi">Tampereen tuomiorovastikunta; Kangasalan rovastikunta</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">prosteri</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rovastikunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4874"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4878">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p13288"/>
    <skos:definition xml:lang="sv">Enhet eller verksamhetsområde för lokalförvaltning, som kallas härad.</skos:definition>
    <skos:definition xml:lang="fi">Paikallishallinnon yksikkö tai sen toimialue, jota kutsutaan kihlakunnaksi.</skos:definition>
    <skos:example xml:lang="sv">Ilomants härad; Karelens övre härad; Sodankylä häradsämbete</skos:example>
    <skos:example xml:lang="fi">Ilomantsin kihlakunta; Karjalan ylinen kihlakunta; Sodankylän kihlakunnanvirasto</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">härad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kihlakunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4778"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4882"/>
    <skos:scopeNote xml:lang="fi">Kruununvoudista ja henkikirjoittajasta, joiden virkapiirinä on ollut kihlakunta, käytä yhteisön kategorian historiallisia termejä [http://urn.fi/URN:NBN:fi:au:mts:m4721] ja [http://urn.fi/URN:NBN:fi:au:mts:m4746].</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Om kronofogde och häradsskrivare, vilkas ämbetsområde en härad har varit, används de historiska termerna [http://urn.fi/URN:NBN:fi:au:mts:m4721] och [http://urn.fi/URN:NBN:fi:au:mts:m4746] som kategori av institution.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4879">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">autonom region</skos:altLabel>
    <skos:altLabel xml:lang="sv">autonomt område</skos:altLabel>
    <skos:definition xml:lang="sv">Område tillhörande eller beroende av en stat, men med någon form av självstyre eller autonomi. Även självstyrande institution på området.</skos:definition>
    <skos:definition xml:lang="fi">Valtion hallinnollinen tai valtiosta riippuvainen alue, jolle on määritelty jonkinasteinen itsehallinto tai autonomia (Wikipedia). Myös alueella oleva itsehallinnollinen yhteisö.</skos:definition>
    <skos:example xml:lang="fi">Ahvenanmaa; Grönlanti</skos:example>
    <skos:example xml:lang="sv">Åland; Grönland</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">itsehallintoalue</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">självstyrelseområde</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4876"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4880">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förläning (friherreskap)</skos:altLabel>
    <skos:altLabel xml:lang="fi">läänitys (vapaaherrakunta)</skos:altLabel>
    <skos:definition xml:lang="sv">Avser feodala friherreskap och sådana förläningar som grundades i Finland på 1500-1600-talen.</skos:definition>
    <skos:definition xml:lang="fi">Tarkoitetaan Suomeen 1500- ja 1600-luvuilla perustettuja feodaalisia vapaaherrakuntia ja niiden läänityksiä.</skos:definition>
    <skos:example xml:lang="fi">Limingan vapaaherrakunta</skos:example>
    <skos:example xml:lang="sv">Limingo friherreskap</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">friherreskap</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vapaaherrakunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4886"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4881">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">provins</skos:altLabel>
    <skos:altLabel xml:lang="fi">provinssi</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p6819"/>
    <skos:definition xml:lang="fi">Aluehallinnon yksikkö tai sen toimialue, jota kutsutaan maakunnaksi. Myös maakunnaksi kutsuttu liittovaltion osa.</skos:definition>
    <skos:definition xml:lang="sv">Enhet eller verksamhetsområde för regional förvaltning, som benämns landskap.</skos:definition>
    <skos:example xml:lang="sv">Satakunta; Norra Savolax; Lappland</skos:example>
    <skos:example xml:lang="fi">Satakunta; Pohjois-Savo; Lappi</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">landskap</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maakunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4754"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4882"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4884"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4885"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5054"/>
    <skos:scopeNote xml:lang="sv">Kan användas utöver en vald kategori av institution för att precisera att den offentligrättsliga institutionen i fråga är en organisation på landskapsnivå.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää valitun yhteisön kategorian lisäksi täsmentämään, että ko. julkishallinnollinen yhteisö on maakunnallinen organisaatio.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4882">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kanton</skos:altLabel>
    <skos:altLabel xml:lang="fi">kantoni</skos:altLabel>
    <skos:altLabel xml:lang="sv">oblast</skos:altLabel>
    <skos:altLabel xml:lang="fi">oblasti</skos:altLabel>
    <skos:altLabel xml:lang="sv">område (förvaltningsområde)</skos:altLabel>
    <skos:definition xml:lang="fi">Aluehallinnon yksikkö tai sen toimialue, jota kutsutaan alueeksi. Myös alueeksi kutsuttu liittovaltion osa. Suomen valtion ylimmiksi aluehallinnon yksiköiksi perustettiin vuonna 2010 aluehallintovirastoja.</skos:definition>
    <skos:definition xml:lang="sv">Enhet eller verksamhetsområde för regional förvaltning.</skos:definition>
    <skos:example xml:lang="fi">Itä-Suomen aluehallintovirasto</skos:example>
    <skos:example xml:lang="sv">Regionförvaltningsverket i Östra Finland</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue (hallintoalue)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region (förvaltningsområde)</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4754"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4878"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4881"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4884"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4885"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5054"/>
    <skos:scopeNote xml:lang="sv">Kan användas utöver en vald kategori av institution för att precisera att den offentligrättsliga institutionen i fråga är en organisation på regional nivå. &#xD;
&#xD;
Om enheter på lokal nivå används termen [http://urn.fi/URN:NBN:fi:au:mts:m4778].</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää valitun yhteisön kategorian lisäksi täsmentämään, että ko. julkishallinnollinen yhteisö on aluetason organisaatio.&#xD;
&#xD;
Alueiksi nimetyistä paikallishallinnon yksiköistä käytä termiä [http://urn.fi/URN:NBN:fi:au:mts:m4778].</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4883">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">federation</skos:altLabel>
    <skos:altLabel xml:lang="sv">folkrepublik</skos:altLabel>
    <skos:altLabel xml:lang="sv">furstendöme</skos:altLabel>
    <skos:altLabel xml:lang="sv">förbundsstat</skos:altLabel>
    <skos:altLabel xml:lang="fi">kansantasavalta</skos:altLabel>
    <skos:altLabel xml:lang="fi">keisarikunta</skos:altLabel>
    <skos:altLabel xml:lang="sv">kejsardöme</skos:altLabel>
    <skos:altLabel xml:lang="sv">konungarike</skos:altLabel>
    <skos:altLabel xml:lang="sv">kungarike</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuningaskunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">liittovaltio</skos:altLabel>
    <skos:altLabel xml:lang="sv">republik</skos:altLabel>
    <skos:altLabel xml:lang="sv">rike</skos:altLabel>
    <skos:altLabel xml:lang="fi">ruhtinaskunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">tasavalta</skos:altLabel>
    <skos:altLabel xml:lang="fi">valtakunta</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3215"/>
    <skos:definition xml:lang="fi">Itsenäinen valtio tai sen hallinnoima alue.</skos:definition>
    <skos:definition xml:lang="sv">Självständig stat eller område som den besitter.</skos:definition>
    <skos:example xml:lang="sv">Finland; Storbritannien; Japan; Monaco; Nordkorea; Australien</skos:example>
    <skos:example xml:lang="fi">Suomi; Iso-Britannia; Japani; Monaco; Pohjois-Korea; Australia</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">stat (förvaltningsområde)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valtio (hallintoalue)</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4875"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4884">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">I flera engelskspråkiga länder regional förvaltningsenhet.</skos:definition>
    <skos:definition xml:lang="fi">Useissa maissa aluehallinnon yksikkö tai sen toimialue, jota suomen kielessä yleisesti kutsutaan piirikunnaksi.</skos:definition>
    <skos:example xml:lang="sv">DeKalb county (Förenta staterna)</skos:example>
    <skos:example xml:lang="fi">DeKalbin piirikunta (Yhdysvallat)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">county</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piirikunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4754"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4881"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4882"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4885"/>
    <skos:scopeNote xml:lang="fi">Suomen piirihallinnon yksiköistä käytä yhteisön tyyppinä termiä [http://urn.fi/URN:NBN:fi:au:mts:m4754].</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4885">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">linnalääni</skos:altLabel>
    <skos:altLabel xml:lang="sv">militärlän</skos:altLabel>
    <skos:altLabel xml:lang="sv">slottslän</skos:altLabel>
    <skos:altLabel xml:lang="fi">sotilaslääni</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p6817"/>
    <skos:definition xml:lang="fi">Aluehallinnon yksikkö tai sen toimialue, jota kutsutaan lääniksi. Suomessa valtion ylin aluehallinto järjestettiin lääninhallintona vuoden 2009 loppuun asti ja puolustusvoimien aluehallinto sotilaslääneinä eri muodoissa vuosina 1932-2014.</skos:definition>
    <skos:definition xml:lang="sv">Enhet eller verksamhetsområde för regional förvaltning.</skos:definition>
    <skos:example xml:lang="fi">Vaasan lääni; Käkisalmen lääni; Pohjois-Suomen sotilaslääni</skos:example>
    <skos:example xml:lang="sv">Vasa län; Kexholms län; Norra Finlands militärlän</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">län</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lääni</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4754"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4881"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4882"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4884"/>
    <skos:scopeNote xml:lang="sv">Kan användas utöver en vald kategori av institution för att precisera att den offentligrättsliga institutionen i fråga är en organisation på länsnivå.&#xD;
&#xD;
Om länsstyrelse som enhet för länsförvaltning används den historiska termen [http://urn.fi/URN:NBN:fi:au:mts:m4700] som kategori av institution.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää valitun yhteisön kategorian lisäksi täsmentämään, että ko. julkishallinnollinen yhteisö on läänitason organisaatio.&#xD;
&#xD;
Lääninhallituksesta lääninhallinnon yksikkönä käytä yhteisön kategorian historiallista termiä [http://urn.fi/URN:NBN:fi:au:mts:m4700].</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4886">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förläning (grevskap)</skos:altLabel>
    <skos:altLabel xml:lang="fi">läänitys (kreivikunta)</skos:altLabel>
    <skos:definition xml:lang="sv">Avser feodala grevskap och förläningar som grundades i Finland på 1500- och 1600-talen.</skos:definition>
    <skos:definition xml:lang="fi">Tarkoitetaan Suomeen 1500- ja 1600-luvuilla perustettuja feodaalisia kreivikuntia ja niiden läänityksiä.</skos:definition>
    <skos:example xml:lang="fi">Raaseporin kreivikunta</skos:example>
    <skos:example xml:lang="sv">Raseborgs grevskap</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">grevskap</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kreivikunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4880"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4887">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inredningsarkitekt (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sisustusarkkitehti (suhde)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka vastaa sisustuksen taiteellisesta suunnittelusta.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med en person som svarar för den konstnärliga planeringen av inredning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inredningsarkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sisustusarkkitehti</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets skapare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4891">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">recordist</skos:altLabel>
    <skos:altLabel xml:lang="fi">taltioija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att använda en inspelningsapparat för att lagra ljud eller video vid ett inspelningstillfälle.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen käyttämällä tallennuslaitetta äänen tai videon taltioimiseen tallennustilanteessa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20052"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelande aktör</skos:prefLabel>
    <skos:prefLabel xml:lang="en">recordist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taltioija</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Inbegriper fältinspelningar av naturljud, musikframföranden och andra evenemang.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää luonnonäänten, musiikkiesitysten ja muiden tapahtumien kenttätallennukset. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4892">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
