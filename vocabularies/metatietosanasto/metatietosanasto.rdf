    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasCousin"/>
    <skos:definition xml:lang="sv">Kusin till en beskriven person.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön serkku.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
