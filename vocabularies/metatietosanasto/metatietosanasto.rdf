  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m167">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kasetti, joka sisältää mikrofilmin.</skos:definition>
    <skos:definition xml:lang="sv">Kassett som innehåller mikrofilm.</skos:definition>
