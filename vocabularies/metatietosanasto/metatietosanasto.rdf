    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">illustratör (institution) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen kuvittaja (yhteisö)</skos:altLabel>
