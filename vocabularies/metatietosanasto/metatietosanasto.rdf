  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m434">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, helhet bestående av tredimensionella föremål, avsedd att användas enligt överenskomna regler i lekar, undervisning, som förströelse eller som terapi.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kolmiulotteisia objekteja sisältävä kokonaisuus, jota on tarkoitettu käytettäväksi sovittujen sääntöjen mukaisesti leikeissä opetuksessa, huviksi tai terapiassa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1014"/>
    <skos:example xml:lang="fi">MARC 21: 300## ‡a 1 peli (useita osia kotelossa) ‡c 13 x 18 x 4 cm + ‡e 2 taitelehteä (16 x 12 cm)</skos:example>
    <skos:example xml:lang="sv">MARC 21: 300## ‡a 1 spel (flera delar i fodral) ‡c 13 x 18 x 4 cm + ‡e 2 foldrar (16 x 12 cm)</skos:example>
    <skos:example xml:lang="fi">MARC 21: 300## ‡a 9 peliä (useita osia) + ‡e Opettajan info (23 sivua : kuvitettu)</skos:example>
    <skos:example xml:lang="sv">MARC 21: 300## ‡a 9 spel (flera delar) + ‡e Lärarens info (23 sidor : illustrationer)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">game</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">peli</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">spel</skos:prefLabel>
  </owl:Class>
