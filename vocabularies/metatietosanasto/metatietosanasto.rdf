  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m51">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Bibliografinen koko muodostuu yhdestä tai useammasta lehdestä, jotka ovat kooltaan 1/4 arkista.</skos:definition>
    <skos:definition xml:lang="sv">Bokens format består av ett eller flera blad som till sin storlek är 1/4 av ett tryckark.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/bookFormat/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">4:o</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">4:o</skos:prefLabel>
    <skos:prefLabel xml:lang="en">4to</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5100">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Julkaisutapa, jossa manifestaatio ilmestyy moniosaisena fyysisenä yksikkönä tai moniosaisena loogisena aineettomana kokonaisuutena.</skos:definition>
    <skos:definition xml:lang="sv">Utgivningssätt som innebär att en manifestation utkommer som en fysisk enhet i flera delar eller som en logisk immateriell helhet i flera delar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/ModeIssue/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">multiple unit</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">resurs utkommen som flera enheter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">useampana yksikkönä ilmestyvä aineisto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5101">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">solmisaatio</skos:altLabel>
    <skos:altLabel xml:lang="sv">stavelsenotation</skos:altLabel>
    <skos:altLabel xml:lang="fi">tonic sol-fa</skos:altLabel>
    <skos:definition xml:lang="fi">Nuottikirjoituksen tyyppi, jossa sävelkorkeus merkitään määrätyillä tavuilla.</skos:definition>
    <skos:definition xml:lang="sv">Typ av notskrift, i vilken tonhöjd anges med konventionella stavelser.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/MusNotation/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">syllabic notation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">syllabisk notation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tavunuottikirjoitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5102">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehållstyp som består av innehåll uttryckt genom koreografi i visuell form.</skos:definition>
    <skos:definition xml:lang="fi">Sisältötyyppi, joka koostuu visuaalisessa muodossa olevan koreografian kautta ilmaistusta sisällöstä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1024"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esitetty liike</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framförd rörelse</skos:prefLabel>
    <skos:prefLabel xml:lang="en">performed movement</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5103">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">negativkopia</skos:altLabel>
    <skos:definition xml:lang="sv">Generation som är ett negativ gjort av ett master positiv, något annat positiv eller ett originalnegativ. Duplikatnegativ används för tillverkning av positivkopior.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolvi, joka on master-positiivista, muusta positiivista tai alkuperäisestä negatiivista valmistettu negatiivi. Negatiivikopiota käytetään positiivivedosten valmistamiseen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1019"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">duplicate negative</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">duplikatnegativ</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">negatiivikopio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5105">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">illustrationer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvitettu</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">MARC 21 300 ‡b-kentässä: kuvitettu</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">MARC 21 i 300 ‡b-fältet: illustrationer</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5106">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">single line</skos:altLabel>
    <skos:definition xml:lang="sv">Layout i vilken enskilda musikinstruments stämmor eller solon presenteras i segment med två till fem rader i notskriften. Den första raden anger taktnummer eller övningsnummer.</skos:definition>
    <skos:definition xml:lang="fi">Layout, jossa yksittäisten musiikki-instrumenttien stemmat tai soolot on esitetty nuottikirjoituksessa kahden-viiden rivin lohkoissa. Ensimmäinen rivi osoittaa tahdin numeron tai harjoitusnumeron.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">enkelradig</skos:prefLabel>
    <skos:prefLabel xml:lang="en">single line</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yksirivinen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5107">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen linja, jossa lisätään kappaleita kokoelmaan, kun kappaleet kuuluvat kokoelman soveltamisalaan mutta on hankittu muista syistä.</skos:definition>
    <skos:definition xml:lang="sv">Metod för utökning av samling, som innebär att exemplar läggs till samlingen då exemplaren hör till samlingens tillämpningsområde, men är inskaffade av andra skäl.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualPolicy/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">passiivinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">passiv</skos:prefLabel>
    <skos:prefLabel xml:lang="en">passive</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5108">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m83"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10609"/>
    <skos:definition xml:lang="fi">Liittää teoksen kokoelmateoksen manifestaatioon lisättävien kappaleiden valitsemisen linjaan.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med policy för val av exemplar som ska läggas till en manifestation av ett samlingsverk.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5107"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5114"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5116"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5117"/>
    <skos:prefLabel xml:lang="sv">Accessionspolicy för samlingen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection accrual policy</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kokoelman kartuttamisen linja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5109">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen menetelmä, jossa lisätään kappaleita kokoelmaan määrätyksi tai avoimeksi ajanjaksoksi ilman omistusoikeuden siirtoa tai maksutapahtumaa.</skos:definition>
    <skos:definition xml:lang="sv">Metod för utökning av samling, som innebär att exemplar läggs till samlingen för en bestämd eller öppen tid, utan överföring av äganderätt eller betalningstransaktion.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualMethod/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laina</skos:prefLabel>
    <skos:prefLabel xml:lang="en">loan</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">lån</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m511">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">artist</skos:altLabel>
    <skos:altLabel xml:lang="sv">konstnär (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konstnär (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">taiteilija (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">taiteilija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av en ursprunglig grafisk design, teckning, målning eller dylikt.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10058"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1775"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1980"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m555"/>
    <skos:prefLabel xml:lang="en">artist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taiteilija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5110">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m83"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10608"/>
    <skos:definition xml:lang="fi">Liittää teoksen kokoelmateoksen manifestaatioon lisättävien kappaleiden haltijuuden siirron menetelmään.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med metod för byte av innehavare av exemplar som läggs till en manifestation av ett samlingsverk.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5109"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5111"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5112"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5113"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5115"/>
    <skos:prefLabel xml:lang="sv">Accessionsmetod för samlingen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Collection accrual method</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kokoelman kartuntamenetelmä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5111">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inköp</skos:altLabel>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen menetelmä, jossa lisätään kappaleita kokoelmaan pysyvästi omistusoikeuden siirrolla ja maksutapahtumalla.</skos:definition>
    <skos:definition xml:lang="sv">Metod för utökning av samling, som innebär att exemplar läggs till samlingen permanent med överföring av äganderätt och betalningstransaktion.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualMethod/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">köp</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">osto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">purchase</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5112">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen menetelmä, jossa lisätään kappaleita kokoelmaan määrätyksi tai avoimeksi ajanjaksoksi ilman omistusoikeuden siirtoa mutta maksutapahtumalla.</skos:definition>
    <skos:definition xml:lang="sv">Metod för utökning av samling, som innebär att exemplar läggs till samlingen för en bestämd eller öppen tid, utan överföring av äganderätt men med betalningstransaktion.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualMethod/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">licens</skos:prefLabel>
    <skos:prefLabel xml:lang="en">license</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lisenssi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5113">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen menetelmä, jossa lisätään kappaleita kokoelmaan pysyvästi ilman omistusoikeuden siirtoa tai maksutapahtumaa.</skos:definition>
    <skos:definition xml:lang="sv">Metod för utökning av samling, som innebär att exemplar läggs till samlingen perament utan överföring av äganderätt eller betalningstransaktion.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualMethod/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">deposit</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">deposition</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">talletus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5114">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen linja, jossa ei lisätä kappaleita kokoelmaan.</skos:definition>
    <skos:definition xml:lang="sv">Policy för utökning av samling, som innebär att exemplar inte läggs till samlingen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualPolicy/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">closed</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stängd</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">suljettu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5115">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen menetelmä, jossa lisätään kappaleita kokoelmaan pysyvästi omistusoikeuden siirrolla mutta ilman maksutapahtumaa.</skos:definition>
    <skos:definition xml:lang="sv">Metod för utökning av samling, som innebär att exemplar läggs till en samling permanent genom överföring av äganderätt, men utan betalningstransaktion.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualMethod/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">donation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">donation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lahjoitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5116">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen linja, jossa etsitään, hankitaan ja lisätään kappaleita kokoelmaan.</skos:definition>
    <skos:definition xml:lang="sv">Policy för utökning av samling, som innebär att man söker, förvärvar och lägger till exemplar till samlingen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualPolicy/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">active</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">aktiivinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aktiv</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5117">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kokoelman kartuttamisen linja, jossa lisätään kappaleita kokoelman yhteen tai useampaan alakokoelmaan.</skos:definition>
    <skos:definition xml:lang="sv">Policy för utökning av samling, som innebär att exemplar läggs till en eller flera av samlingens delsamlingar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACollectionAccrualPolicy/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">selective</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">selektiv</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valikoiva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5118">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4253"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">käytettävissä vapaakappalekirjastoissa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tillgänglig i friexemplarsbibliotek</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5119">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m83"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10365"/>
    <skos:altLabel xml:lang="sv">Utökningsplan</skos:altLabel>
    <skos:definition xml:lang="fi">Liittää teoksen luokitukseen, joka kuvastaa aikomusta laajentaa teoksen sisältöä.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med en kategorisering som beskriver en intention om att utvidga verkets innehåll.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5121"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5122"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5125"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5129"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5132"/>
    <skos:prefLabel xml:lang="en">Extension plan</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Laajennussuunnitelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Utvidgningsplan</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m512">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DVD-videolevy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DVD-videoskiva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5120">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Sidonnan tyyppi paksusta pahvista tehdyille arkeille ja kansille, jotka on taitettu ja sidottu selkämykseksi.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, med ark och pärmar av tjock kartong, som är vikta och bundna som en rygg.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">board book binding</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kartongbokbindning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pahvikirjan sidos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5121">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laajennussuunnitelma teokselle, joka on tarkoitettu toteutettavaksi useissa erillisissä ekspressiossa, jotka toteutuvat rajatun ajanjakson sisällä.</skos:definition>
    <skos:definition xml:lang="sv">Utvidgningsplan för ett verk som är avsett att förverkligas i flera skilda uttryck inom en begränsad tidsperiod.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAExtensionPlan/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">peräkkäinen määrätty suunnitelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">successiv bestämd plan</skos:prefLabel>
    <skos:prefLabel xml:lang="en">successive determinate plan</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5122">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laajennussuunnitelma teokselle, joka on tarkoitettu toteutettavaksi yhdessä erillisessä ekspressiossa, joka toteutuu avoimen ajanjakson sisällä.</skos:definition>
    <skos:definition xml:lang="sv">Utvidgningsplan för ett verk som är avsett att förverkligas i ett skilt uttryck inom en öppen tidsperiod.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAExtensionPlan/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">integrating indeterminate plan</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">integrerande obestämd plan</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">päivittyvä määrittämätön suunnitelma</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5123">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">klämrygg</skos:altLabel>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, joka puristaa jokaisen arkin reunan selkämykseen ja päällykseen kiinnitettyyn jouseen. Jousi voidaan aukaista arkin poistamiseksi tai lisäämiseksi.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, som klämmer åt varje arks kant med en fjäder som fästs i ryggen och omslaget. Fjädern kan öppnas för att ta bort eller lägga till ark.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jousiselkäinen sidos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">klämbindning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">springback binding</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5124">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, jossa useat lähekkäin sijoitetut ja taivutetut metalli- tai muoviliuskat on pujotettu läpi arkkien reunassa olevista reijistä.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, i vilken flera tätt placerade och böjda metall- eller plastremsor är trädda genom hål i arkens kanter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">comb binding</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kambindning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kampasidos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5125">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laajennussuunnitelma teokselle, joka on tarkoitettu toteutettavaksi yhdessä tai useammassa erillisessä ekspressiossa, jotka kaikki toteutuvat yhtäaikaisesti.</skos:definition>
    <skos:definition xml:lang="sv">Utvidgningsplan för ett verk som är avsett att förverkligas i ett eller flera uttryck, som alla förverkligas samtidigt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAExtensionPlan/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">staattinen suunnitelma</skos:prefLabel>
    <skos:prefLabel xml:lang="en">static plan</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">statisk plan</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5126">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m261"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/e/P20323"/>
    <skos:definition xml:lang="fi">Liittää ekspression sisällön kykyyn vastata käyttäjän suorittamiin toimintoihin.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar uttryck med förmåga hos innehåll att svara på aktiviteter som användaren utför.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5130"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5135"/>
    <skos:prefLabel xml:lang="en">Interactivity mode</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Interaktivitetsgrad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Vuorovaikutteisuuden aste</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5127">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, joka käyttää metallisia tai muovisia C-muotoon taivutettuja pätkiä, jotka liukuvat yli arkkien reunan kiinnittäen ne paikoilleen.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, med metall- eller plastbitar böjda i C-form, som glider över arkens kanter och fäster dem.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">glidande bindning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liukuva sidos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slide binding</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5128">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">sadelhäftning</skos:altLabel>
    <skos:altLabel xml:lang="sv">sadelhäftningsbindning</skos:altLabel>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, joka taittaa ja nitoo arkit taitokseksi, joka muodostaa selkämyksen.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, som viker och häftar arken till en vikning som bildar en rygg.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">saddle stitch binding</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sadelbindning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">satulaommelsidos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5129">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laajennussuunnitelma teokselle, joka on tarkoitettu toteutettavaksi yhdessä erillisessä ekspressiossa, joka toteutuu rajatun ajanjakson sisällä.</skos:definition>
    <skos:definition xml:lang="sv">Utvidgningsplan för ett verk som är avsett att förverkligas i ett skilt uttryck inom en bestämd tidsperiod.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAExtensionPlan/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">integrating determinate plan</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">integrerande bestämd plan</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">päivittyvä määrätty suunnitelma</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5130">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Interaktiivisuuden tila, joka osoittaa, että ekspression sisältö vastaa käyttäjän toimintaan.</skos:definition>
    <skos:definition xml:lang="sv">Status för interaktivitet, som anger att uttryckets innehåll svarar på användarens aktivitet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAInteractivityMode/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">interactive</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">interaktiivinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">interaktiv</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5131">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, joka käyttää useampaa kuin yhtä metallista tai muovista rengasta, jotka pujotetaan arkkien reunassa olevien reikien läpi. Sidos voidaan avata arkkien poistamiseksi tai lisäämiseksi.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, med fler än en ring i metall eller plast, som förs genom hål i arkens kanter. Bindningen kan öppnas för att ta bort eller lägga till ark.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">avoin rengasnidonta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">open ring binding</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">öppen ringbindning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5132">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Laajennussuunnitelma teokselle, joka on tarkoitettu toteutettavaksi useissa erillisissä ekspressiossa, jotka toteutuvat avoimen ajanjakson sisällä.</skos:definition>
    <skos:definition xml:lang="sv">Utvidgningsplan för ett verk som är avsett att förverkligas i flera skilda uttryck inom en öppen tidsperiod.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAExtensionPlan/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">peräkkäinen määrittämätön suunnitelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">successiv obestämd plan</skos:prefLabel>
    <skos:prefLabel xml:lang="en">successive indeterminate plan</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5133">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kierresidonta</skos:altLabel>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, joka käyttää yhtenäistä metalli- ja muovikierrettä, joka pujotetaan arkkien reunassa olevien reikien läpi.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, med en sammanhängande metall- eller plastspiral som är trädd genom hål i arkens kanter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kierrenidonta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spiral binding</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">spiralbindning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5134">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Sidonnan tyyppi, joka käyttää useampaa kuin yhtä metallista tai muovista rengasta, jotka pujotetaan arkkien reunassa olevien reikien läpi.</skos:definition>
    <skos:definition xml:lang="sv">Typ av bindning, med fler än en metall- eller plastringar, som är trädda genom hål i arkens kanter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDATypeOfBinding/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">closed ring binding</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sluten ringbindning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">suljettu rengasnidonta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5135">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ej interaktiv</skos:altLabel>
    <skos:definition xml:lang="fi">Interaktiivisuuden tila, joka osoittaa, että ekspression sisältö ei vastaa käyttäjän toimintaan.</skos:definition>
    <skos:definition xml:lang="sv">Status för interaktivitet, som anger att uttryckets innehåll inte svarar på användarens aktivitet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAInteractivityMode/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ei-interaktiivinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">icke-interaktiv</skos:prefLabel>
    <skos:prefLabel xml:lang="en">non-interactive</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5136">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">metallurg</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">metallurgi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5137">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m83"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10404"/>
    <skos:definition xml:lang="fi">Liittää teoksen metatietoteoksen tiedonlähteeseen, joka on rakenteistamaton kuvailu jäljennettynä manifestaatiosta, joka on kuvailtavana.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med informationskälla för ett metadataverk, som är en ostrukturerad beskrivning återgiven från manifestationen som beskrivs.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5138"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5139"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5140"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5141"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5142"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5143"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5144"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5145"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5146"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5147"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5148"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5149"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5150"/>
    <skos:prefLabel xml:lang="fi">Merkintälähde</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Recording source</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Uppgiftskälla</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5138">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och utgörs av ett skyddande omslag som kan lösgöras från volymen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä niteen irrotettava suojakääre.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">irtopäällys</skos:prefLabel>
    <skos:prefLabel xml:lang="en">jacket</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skyddsomslag</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5139">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och som utgörs av ett texttillägg till en stillbild, som innehåller information om titeln, en kort beskrivning eller annan information om manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä stillkuvan tekstilisä, joka sisältää tietoa nimekkeestä, lyhyen kuvauksen tai muuta tietoa manifestaatiosta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">caption</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förklaringstext</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">seliteteksti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5140">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och utgörs av en behållare, som fysiskt kan avskiljas från manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä kotelo, joka on fyysisesti erotettavissa manifestaatiosta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">behållare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">container</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kotelo</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5141">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">redaktionell ruta</skos:altLabel>
    <skos:altLabel xml:lang="sv">redaktionsruta</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimitustietolaatikko</skos:altLabel>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och som utgörs av en del av ledarsidan eller första sidan som utkommer i varje nummer av manifestionen, och som innehåller information om huvudtitel, upphov, utgivning eller annat gällande manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä osa pääkirjoitussivua tai ensimmäistä sivua, joka ilmestyy manifestaation joka numerossa, ja joka sisältää tietoa päänimekkeestä, vastuullisuudesta, julkaisusta tai muusta manifestaatioon liittyvästä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">masthead</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redaktionsuppgifter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimitustiedot</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5142">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inbyggda metadata</skos:altLabel>
    <skos:altLabel xml:lang="sv">inbäddade metadata</skos:altLabel>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och som utgörs av metadata som integrerats i en onlinemanifestation.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä verkkomanifestaatioon upotettuja metatietoja.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">embedded metadata</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">inbäddad metadata</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">upotetut metatiedot</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5143">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla i form av en filmruta som ingår i en manifestation, och som ger information om huvudtitel, upphov, utgivning eller annat som gäller manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä filmiruutu, joka sisältää tietoa päänimekkeestä, vastuullisuudesta, julkaisusta tai muusta manifestaatioon liittyvästä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nimiöruutu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">titelruta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">title frame</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5144">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och utgörs av ett ark i en arksamling, som innehåller information om en huvudtitel, upphov, utgivning eller annat gällande manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä arkki arkkikokoelmassa, joka sisältää tietoa päänimekkeestä, vastuullisuudesta, julkaisusta tai muusta manifestaatioon liittyvästä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nimiöarkki</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">titelark</skos:prefLabel>
    <skos:prefLabel xml:lang="en">title sheet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5145">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">pärm (omslag)</skos:altLabel>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och utgörs av volymens skyddande bindning.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä niteen suojaava sidos.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">cover</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kansi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">omslag</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kansi kattaa myös selän.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till omslag hör också en rygg.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5146">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och utgörs av en sida i en volym, som innehåller information om huvudtitel, upphov, utgivning eller annat gällande manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä niteeseen sisältyvä sivu, joka sisältää tietoa päänimekkeestä, vastuullisuudesta, julkaisusta tai muusta manifestaatioon liittyvästä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nimiösivu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">titelsida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">title page</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5147">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och som utgörs av en kompletterande titelsida, som innehåller seriens huvudtitel och andra uppgifter om ett verk som utkommer successivt, samt uppgifter gällande det verks nummer som ingår i manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvä tiedonlähde, joka on täydentävä nimiösivu, joka sisältää sarjan päänimekkeen ja muita tietoja perättäisesti ilmestyvästä teoksesta sekä manifestaatioon sisältyvän teoksen numeroon liittyviä tietoja.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sarjan nimiösivu</skos:prefLabel>
    <skos:prefLabel xml:lang="en">series title page</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">titelsida för serie</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5148">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och som utgörs av en människoläsbar etikett som är beständigt fäst vid manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvä tiedonlähde, joka on manifestaatioon pysyvästi kiinnitetty ihmisluettava etiketti.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">carrier label</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">etikett på bärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tallenteen etiketti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5149">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och utgörs av ett kort i en kortsamling, som innehåller information om huvudtitel, upphov, utgivning eller annat gällande manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä kortti korttikokoelmassa, joka sisältää tietoa päänimekkeestä, vastuullisuudesta, julkaisusta tai muusta manifestaatioon liittyvästä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nimiökortti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">titelkort</skos:prefLabel>
    <skos:prefLabel xml:lang="en">title card</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m515">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">televisiokanava</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-kanal</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p4002"/>
    <skos:definition xml:lang="sv">Anläggning med tv-sändare; även om tv-kanal.</skos:definition>
    <skos:definition xml:lang="fi">Laitos jossa on televisiolähetin; myös televisiokanavasta.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">televisioasema</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-station</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5150">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Informationskälla som ingår i en manifestation och utgörs av en digital manifestations skärmvy, som innehåller information om huvudtitel, upphov, utgivning eller annat gällande manifestationen.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatioon sisältyvänä tiedonlähteenä digitaalisen manifestaation näkymä, joka sisältää tietoa päänimekkeestä, vastuullisuudesta, julkaisusta tai muusta manifestaatioon liittyvästä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARecordingSources/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">nimiönäyttö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">titelskärm</skos:prefLabel>
    <skos:prefLabel xml:lang="en">title screen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5151">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4979"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/c/C10012"/>
    <skos:definition xml:lang="sv">Beteckning för vilken som helst RDA-entitet, förutom nomen.</skos:definition>
    <skos:definition xml:lang="fi">Nimike mille tahansa RDA-entiteetille nomenia lukuun ottamatta.</skos:definition>
    <skos:prefLabel xml:lang="en">Nomen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Nomen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Nomen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5152">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5151"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/n/P80168"/>
    <skos:altLabel xml:lang="sv">Identifiktationsstatus</skos:altLabel>
    <skos:altLabel xml:lang="sv">Status för identifikation</skos:altLabel>
    <skos:definition xml:lang="fi">Liittää nomenin ilmaukseen entiteetin nomenin oikeaksi todistamisen tasosta.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar nomen med en uppgift om identifikationsnivå för nomenet.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5153"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5154"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5155"/>
    <skos:prefLabel xml:lang="sv">Identifikationsnivå</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Status of identification</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tunnistamistaso</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5153">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">helt fastställd</skos:altLabel>
    <skos:definition xml:lang="sv">Identifikationsnivå som innebär att uppgifterna som bildar en auktoriserad sökingång är kompletta.</skos:definition>
    <skos:definition xml:lang="fi">Tunnistamistaso, kun auktorisoidun hakutiedon muodostavat tiedot ovat viimeistellyt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/statIdentification/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fullständig nivå</skos:prefLabel>
    <skos:prefLabel xml:lang="en">fully established</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">täydellinen taso</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5154">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ej kontrollerad</skos:altLabel>
    <skos:definition xml:lang="sv">Identifikationsnivå som innebär att uppgifterna som bildar en auktoriserad sökingång har erhållits från en annan beskrivning, utan tillgång till resursen som beskrivs.</skos:definition>
    <skos:definition xml:lang="fi">Tunnistamistaso, kun auktorisoidun hakutiedon muodostavat tiedot on otettu toisesta kuvailusta eikä käytettävissä ole kuvailtavaa aineistoa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/statIdentification/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alustava taso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">preliminary</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">preliminär nivå</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5155">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ofullständig nivå</skos:altLabel>
    <skos:altLabel xml:lang="sv">provisorisk nivå</skos:altLabel>
    <skos:definition xml:lang="sv">Identifikationsnivå som innebär att uppgifterna som bildar en auktoriserad sökingång inte är tillräckliga för tillfredsställande identifikation.</skos:definition>
    <skos:definition xml:lang="fi">Tunnistamistaso, kun auktorisoidun hakutiedon muodostavat tiedot eivät riitä entiteetin tyydyttävään tunnistamiseen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/statIdentification/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bristfällig nivå</skos:prefLabel>
    <skos:prefLabel xml:lang="en">provisional</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puutteellinen taso</skos:prefLabel>
  </owl:Class>
