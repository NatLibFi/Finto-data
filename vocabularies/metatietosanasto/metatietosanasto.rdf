    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett kartografiskt verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa kartografisen teoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10052"/>
