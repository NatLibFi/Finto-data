    <skos:scopeNote xml:lang="sv">Detta element lämpar sig vanligen för uttryck av ett statiskt eller integrerande verk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tämä elementti soveltuu yleensä staattisen teoksen tai päivittyvän teoksen ekspressioon. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4323">
