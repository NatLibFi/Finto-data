    <skos:prefLabel xml:lang="sv">säljare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1773">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5285"/>
    <skos:definition xml:lang="fi">Henkilö, jonka käsin kirjoitettu nimikirjoitus on kappaleessa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person vars handskrivna signatur finns i ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40016"/>
