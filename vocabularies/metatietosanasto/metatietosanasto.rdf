    <skos:prefLabel xml:lang="en">has foster child</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kasvattilapsi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4631">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
