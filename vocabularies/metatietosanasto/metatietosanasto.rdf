    <skos:altLabel xml:lang="fi">edeltäjä</skos:altLabel>
    <skos:altLabel xml:lang="sv">föregående</skos:altLabel>
    <skos:altLabel xml:lang="en">predecessor</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5389"/>
    <skos:definition xml:lang="sv">Institution som föregick en annan institution.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka edelsi toista yhteisöä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
