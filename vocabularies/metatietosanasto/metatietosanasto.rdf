    <skos:altLabel xml:lang="fi">korvaa ekspression</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2295"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisällön toisen teoksen ekspression sisältö korvaa ja tekee vanhentuneeksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk vars innehåll ett annat verks uttrycks innehåll ersätter och gör föråldrat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20199"/>
