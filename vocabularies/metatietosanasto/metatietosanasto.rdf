  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2299">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Audio Interchange File Format</skos:altLabel>
    <skos:altLabel xml:lang="sv">Audio Interchange File Format</skos:altLabel>
