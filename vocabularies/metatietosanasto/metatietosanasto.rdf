    <skos:altLabel xml:lang="fi">ammatillinen aikuiskoulutuskeskus</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammatillinen erityisoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammatti-instituutti</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammattikoulu</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammattikoulujen opettajaopisto</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammattiopisto</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammattioppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">hotelli- ja ravintolaoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">kauppaoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">kieli-instituutti</skos:altLabel>
    <skos:altLabel xml:lang="fi">koti- ja laitostalousoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">kotiteollisuusoppilaitos</skos:altLabel>
