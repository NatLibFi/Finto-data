  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5531">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelande aktör (institution) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen taltioija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän tallenteen äänityksen teknistä puolta valvova yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som övervakar den tekniska delen av upptagningen av en ljudinspelning som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelande institution</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taltioija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5532">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dirigent (institution) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen johtaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän musiikkiesityksen tai näytelmän esiintyjäryhmää johtava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som dirigerar en uppträdande grupp i ett musikuppträdande eller skådespel som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dirigent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">johtaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5533">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tekstaaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">textare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5805"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck av en tecknad serie, grafisk roman eller dylikt, genom att rita texten och grafiska ljudeffekter.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu sarjakuvan, sarjakuvaromaanin tms. ekspression tekemiseen piirtämällä tekstin ja graafiset äänitehosteet. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20505"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">letterer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5534">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5432"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5262"/>
    <skos:definition xml:lang="fi">Teoksen lyhyen arvioinnin perustana käytetty teos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som använts som grund för en kort bedömning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10178"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">arvostelu teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">recension av verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">review of work</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5535">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">gjutare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5323"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av en manifestation, genom att forma smält eller flytande ämne med hjälp av en form.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation valmistamisesta muovaamalla sulatettua tai nestemäistä ainetta muotin avulla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30411"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">caster corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gjutare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5536">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5702"/>
    <skos:altLabel xml:lang="sv">transformation</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5418"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen toiminta-alaa tai toimituslinjaa, genreä tai kirjallista muotoa, kohdeyleisöä tai tyyliä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som skapats genom att ändra ett verks verksamhetsfält eller redaktionella linje, genre eller litterära form, målgrupp eller stil.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10336"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">muunnos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5537">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esittelijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">presentatör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen esiintymällä televisiossa tai elokuvassa taustatiedon antajana. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare, som deltar i utförandet av ett uttryck genom att framträda i tv eller film med bakgrundsinformation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20370"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">onscreen presenter person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">presentatör</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Gäller framträdande i icke-fiktiv film eller i inledning till fiktiv film.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Koskee ei-fiktiivisessä elokuvassa tai fiktiivisen elokuvan johdannossa esiintymistä. Ei koske esiintymistä ruudussa ei-esittävässä roolissa. (RDA Registry)</skos:scopeNote>
  </owl:Class>
