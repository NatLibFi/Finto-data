    <skos:prefLabel xml:lang="sv">utökat radavstånd</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1306">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
