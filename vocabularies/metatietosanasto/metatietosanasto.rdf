    <skos:prefLabel xml:lang="fi">varatuomari</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vicehäradshövding</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Oppiarvona käytä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m3747'&gt;varatuomari&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Som lärdomsgrad använd &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m3747'&gt;vicehäradshövding&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5241">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">komposition</skos:prefLabel>
