  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1577">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">conductor</skos:altLabel>
    <skos:altLabel xml:lang="sv">dir. (dirigent)</skos:altLabel>
    <skos:altLabel xml:lang="sv">dirigent (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">dirigent (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">joht. (johtaja)</skos:altLabel>
    <skos:altLabel xml:lang="fi">johtaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">johtaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i utförandet av ett musikverks uttryck, genom att dirigera en uppträdande grupp i en musik- eller dramaföreställning.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3589"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3593"/>
    <skos:prefLabel xml:lang="en">conductor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dirigent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">johtaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1578">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m434"/>
    <skos:definition xml:lang="sv">Enhet, tredimensionella former skurna till olikformade bitar, vanligen av papp eller trä, som bilda en hopsättbar bild.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, yleensä pahvista tai puusta erimuotoisiksi paloiksi leikattuja kolmiulotteisia muotoja, joista muodostuu koottava kuva.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1017"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">jigsaw puzzle</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">palapeli</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">pussel</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1579">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1167"/>
    <skos:altLabel xml:lang="fi">sarjakuvaversion perustana</skos:altLabel>
    <skos:altLabel xml:lang="fi">sarjakuvaversion perustana (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">serieversion av verket</skos:altLabel>
    <skos:altLabel xml:lang="sv">tecknad serie-version baserad på</skos:altLabel>
    <skos:altLabel xml:lang="sv">tecknad serie-version baserad på (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1399"/>
    <skos:definition xml:lang="fi">Teos, joka on sovitettu sarjakuvaromaaniksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har bearbetats till grafisk roman.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10252"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">graphic novelization of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sarjakuvaversio teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tecknad serie-version av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m158">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">letterer</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstaaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">textare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5684"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck av en tecknad serie, grafisk roman eller dylikt, genom att rita texten och grafiska ljudeffekter.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu sarjakuvan, sarjakuvaromaanin tms. ekspression tekemiseen piirtämällä tekstin ja graafiset äänitehosteet. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20259"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">letterer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1585">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3542"/>
    <skos:altLabel xml:lang="sv">förnyad version</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5591"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka on päivitetty, korjattu tai laajennettu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, som är uppdaterat, korrigerat eller utvidgat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20211"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">reviderad version</skos:prefLabel>
    <skos:prefLabel xml:lang="en">revised as</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">uudistettu versio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1586">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">BMP</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">BMP</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1591">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Bibliografinen koko muodostuu yhdestä tai useammasta lehdestä, jotka ovat kooltaan 1/2 arkista.</skos:definition>
    <skos:definition xml:lang="sv">Bokens format består av ett eller flera blad som till sin storlek är 1/2 av ett tryckark.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/bookFormat/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">2:o</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">2:o</skos:prefLabel>
    <skos:prefLabel xml:lang="en">folio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1592">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll som presenteras med teckensystem som beskriver rörelse och som är avsett att beskådas. Innehåller allt annat än rörelsenotationer som är i taktil form. Se även &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1019'&gt;taktil noterad rörelse&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Liikettä kuvailevan merkkijärjestelmän avulla esitetty sisältö, joka on tarkoitettu katsottavaksi. Sisältää kaikki muut kuin kosketeltavassa muodossa olevat liikenotaatiot. Katso myös &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1019'&gt;taktiili liikenotaatio&lt;/a&gt;.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikenotaatio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">notated movement</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">rörelsenotation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1596">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">draftsman</skos:altLabel>
    <skos:altLabel xml:lang="fi">piirt. (piirtäjä)</skos:altLabel>
    <skos:altLabel xml:lang="fi">piirtäjä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ritare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5684"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck skapat av en arkitekt, designer eller annan dylik aktör, genom att skapa precisa planer eller ritningar av byggnader, fartyg, flygplan, apparater, föremål eller andra kreationer.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20033"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">draftsman agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piirtäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ritare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1599">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, kartografisk resurs som avser bildframställning av reflekterad och/eller utstrålad elektromagnetisk strålning, observerad och mätt på avstånd med hjälp av fjärranalysinstrument, och, i fråga om ekolod, ljudvågor som reflekteras under vatten.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kartta-aineisto, joka perustuu kaukokartoitusmittalaitteen etäältä havaitsemaan ja mittaamaan heijastuneeseen ja/tai säteilleeseen elektromagneettiseen säteilyyn tai, kaikuluotaimen ollessa kyseessä, heijastuneisiin vedenalaisiin ääniaaltoihin.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1033"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fjärranalysbild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaukokartoituskuva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">remote-sensing image</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1604">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">handskrift</skos:altLabel>
    <skos:altLabel xml:lang="fi">käsikirjoitus (valmistusmenetelmä)</skos:altLabel>
    <skos:altLabel xml:lang="sv">manus</skos:altLabel>
    <skos:definition xml:lang="sv">Används om vilket som helst manuskriptmaterial som den ansvariga upphovsmannen inte själv har skrivit.</skos:definition>
    <skos:definition xml:lang="fi">Käytetään mistä tahansa käsikirjoitusaineistosta, jota vastuullisuustekijä ei ole itse kirjoittanut.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">käsikirjoitus</skos:prefLabel>
    <skos:prefLabel xml:lang="en">manuscript</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">manuskript</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1606">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Layout som består av ackordsymboler och melodi indelad i stycken, och i vilken ackordsymbolerna anges med punktskrift.</skos:definition>
    <skos:definition xml:lang="fi">Layout, joka koostuu sointumerkeistä ja melodiasta kappaleisiin jaettuina, ja jossa sointumerkit on merkitty pistekirjoituksella.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">melody chord system</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">melody chord system</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">melody chord system</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m161">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Layout endast på ena sidan av ett ark.</skos:definition>
    <skos:definition xml:lang="fi">Layout vain arkin toisella puolella.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">enkelsidig</skos:prefLabel>
    <skos:prefLabel xml:lang="en">single sides</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yksipuolinen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1613">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m61"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1795"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1796"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1797"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1798"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1799"/>
    <skos:prefLabel xml:lang="fi">Aineiston käsittelyyn liittyvät termit ja fraasit</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Termer och fraser angående hantering av materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1616">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">Priset Årets vetenskapliga bok</skos:altLabel>
    <skos:altLabel xml:lang="fi">Vuoden tiedekirja -palkinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">Årets vetenskapliga bok</skos:altLabel>
    <skos:definition xml:lang="sv">Litteraturpris för forskningslitteratur som publicerats i Finland, beviljat av Vetenskapliga samfundets delegation och Förbundet för vetenskapspublicering i Finland rf. Priset utdelades första gången år 1989.</skos:definition>
    <skos:definition xml:lang="fi">Tieteellisten seuran valtuuskunnan ja Suomen tiedekustantajien liiton myöntämä kirjallisuuspalkinto Suomessa julkaistulle tutkimuskirjallisuudelle. Palkinto myönnettiin ensimmäisen kerran 1989.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Årets vetenskapsbok, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Vuoden tiedekirja, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Vuoden tiedekirja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Årets vetenskapsbok</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1617">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">director of photography</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmfotograf (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmfotograf (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvaaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvaaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">videofilmare</skos:altLabel>
    <skos:altLabel xml:lang="sv">videofotograf</skos:altLabel>
    <skos:altLabel xml:lang="fi">videokuvaaja</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som spelar in bilder antingen elektroniskt, eller på film eller video, och ofta väljer och arrangerar belysningen.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10068"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">director agent of photography</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmfotograf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1618">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">sammanslagits med institutionen</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhdistynyt yhteisöön</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4455"/>
    <skos:definition xml:lang="sv">Institution som bildar en ny institution, genom att gå samman med en eller flera andra institutioner.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka muodostaa uuden yhteisön yhdistymällä yhden tai useamman muun yhteisön kanssa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50232"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">component of merger</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sammanslagen institution</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhdistynyt yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1620">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kielen merkkijärjestelmällä esitetty sisältö, joka on tarkoitettu katsottavaksi. Sisältää kaikki muut kielen merkkijärjestelmät, paitsi kosketeltavaksi tarkoitetun tekstin. Katso myös &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1078'&gt;taktiili teksti&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="sv">Med språkets teckensystem uttryckt innehåll, avsett att betraktas. Innehåller alla språks teckensystem förutom text som är avsedd att vidröras. Se även &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1078'&gt;taktil text&lt;/a&gt;.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1020"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">teksti</skos:prefLabel>
    <skos:prefLabel xml:lang="en">text</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">text</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1621">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">1946 perustettu palkinto, jolla pyritään nostamaan esiin korkeatasoista suomen- tai ruotsinkielistä lasten- ja nuortenkirjallisuutta.</skos:definition>
    <skos:definition xml:lang="sv">Pris instiftat år 1946, med syfte att lyfta fram kvalitativt högtstående finsk- eller svenskspråkig barn- och ungdomslitteratur.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Topeliuspriset (ungdomsböcker), 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Topelius-palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Topelius-palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Topeliuspriset (ungdomsböcker)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1622">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ansvarig för framförande</skos:altLabel>
    <skos:altLabel xml:lang="fi">esittämisestä vastaava</skos:altLabel>
    <skos:altLabel xml:lang="en">presenter</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som ingår i texten "X presenterar:" i för- och eftertexter i en manifestation som innehåller ett uttryck, och som troligtvis på något vis relaterar till produktion, finansiering eller distribution av ett uttryck för rörlig bild.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka sisältyy merkintään "X esittää:" ekspression sisältävän manifestaation alku- tai lopputeksteissä ja joka liittyy todennäköisesti liikkuvan kuvan teoksen ekspression tuotantoon, rahoitukseen tai jakeluun jollakin tavoin. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20054"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ansvarig aktör för framförande</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">esittämisestä vastaava toimija</skos:prefLabel>
    <skos:prefLabel xml:lang="en">presenter agent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1624">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3440"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1399"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">barnversion baserad på (verk)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lastenversion perustana (teos)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1625">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">en-två gånger per år</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yksi-kaksi kertaa vuodessa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1628">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1568"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10223"/>
    <skos:altLabel xml:lang="sv">Verkets primära titel</skos:altLabel>
    <skos:definition xml:lang="fi">Teoksen nimeke, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
    <skos:definition xml:lang="sv">Titel för verk, som har valts till primär i en viss tillämpning eller kontext.</skos:definition>
    <skos:prefLabel xml:lang="sv">Föredragen titel för verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Preferred title for work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Teoksen ensisijainen nimeke</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m163">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen nauhan videoformaatti, jonka Sony kehitti ammattilaiskäyttöön vuonna 1982.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för analogt band, som Sony utvecklade för professionellt bruk år 1982.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/videoFormat/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Betacam</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Betacam</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Betacam</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1633">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Myönnetään vuosittain kaunokirjalliselle teokselle ja sen myöntää Pohjoismaiden neuvosto. Vaatimuksena on, että teos on kirjoitettu jollakin pohjoismaisella kielellä.</skos:definition>
    <skos:definition xml:lang="sv">Utdelas årligen av Nordiska rådet till ett skönlitterärt verk. Verket bör vara skrivet på något av de nordiska språken.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Nordiska rådets litteraturpris, 2019</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Pohjoismaiden neuvoston kirjallisuuspalkinto, 2019</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Nordiska rådets litteraturpris</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Pohjoismaiden neuvoston kirjallisuuspalkinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1635">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">levy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skiva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1638">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Layout som består av tecken för hand eller stämma, grupperade i den vänstra marginalen.</skos:definition>
    <skos:definition xml:lang="fi">Layout, joka koostuu käsi- tai stemmamerkeistä, jotka on ryhmitelty vasemmassa marginaalissa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">osat peräkkäin</skos:prefLabel>
    <skos:prefLabel xml:lang="en">section by section</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sektion för sektion</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1640">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen nauhan videoformaatti, jonka JVC kehitti kuluttajakäyttöön 1970-luvulla.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för analogt band, som JVC utvecklade för konsumentbruk på 1970-talet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/videoFormat/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">VHS</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">VHS</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">VHS</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1645">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy epäsäännöllisesti.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras oregelbundet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">epäsäännöllinen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">irregular</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">oregelbunden</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1646">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">hovioikeus</skos:altLabel>
    <skos:altLabel xml:lang="sv">hovrätt</skos:altLabel>
    <skos:altLabel xml:lang="sv">högsta domstolen</skos:altLabel>
    <skos:altLabel xml:lang="fi">korkein oikeus</skos:altLabel>
    <skos:altLabel xml:lang="fi">laamanninoikeus</skos:altLabel>
    <skos:altLabel xml:lang="sv">lagmansrätt</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3961"/>
    <skos:definition xml:lang="sv">Statlig myndighet och rättsvårdsorgan, vars huvuduppgift är att utöva domsrätt i tviste-, brott- och förvaltningsmål, rätt.</skos:definition>
    <skos:definition xml:lang="fi">Valtion viranomainen ja oikeudenhoitoelin, jonka päätehtävänä on käyttää tuomiovaltaa riita-, rikos- ja hallintoasioissa, oikeus (Kielitoimiston sanakirja).</skos:definition>
    <skos:example xml:lang="fi">Markkinaoikeus (tuomioistuin)</skos:example>
    <skos:example xml:lang="sv">Marknadsdomstolen</skos:example>
    <skos:example xml:lang="fi">Tuomioistuinvirasto</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">domstol</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuomioistuin</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m165">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kort bit mikrofilm som klippts från rulle.</skos:definition>
    <skos:definition xml:lang="fi">Mikrofilmirullasta leikattu lyhyt osa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1027"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">microfilm slip</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mikrofilmiliuska</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mikrofilmsremsa</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Mikroformsbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Mikromuotoinen tallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1651">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">vapaakappaleiden luovuttaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">överlåtare av friexemplar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1652">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka on valmistettu selluloosasta ja asetaattiestereiden lähteestä, tyypillisesti etikkahappoanhydridistä.</skos:definition>
    <skos:definition xml:lang="sv">Material som tillverkats av cellulosa och en källa för acetatestrar, vanligen ättiksyraanhydrid.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1040"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">triacetat</skos:prefLabel>
    <skos:prefLabel xml:lang="en">triacetate</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">triasetaatti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1655">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">paavi (arvonimi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">påve (hederstitel)</skos:altLabel>
    <skos:definition xml:lang="fi">Katolisen kirkon päämies.</skos:definition>
    <skos:definition xml:lang="sv">Överhuvud för katolska kyrkan.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">paavi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">påve</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1657">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kymmenen numeroa vuodessa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tio nummer per år</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1658">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">en gång i veckan</skos:altLabel>
    <skos:altLabel xml:lang="fi">kerran viikossa</skos:altLabel>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kerran viikossa.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras en gång i veckan.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">en gång per vecka</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">viikoittain</skos:prefLabel>
    <skos:prefLabel xml:lang="en">weekly</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m166">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
