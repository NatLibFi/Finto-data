  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3649">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Gemål eller dotter (som är eller har varit gift) till baron, friherrinna.</skos:definition>
    <skos:definition xml:lang="fi">Paronin puoliso tai (naimisissa oleva tai ollut) tytär, vapaaherratar.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">baronessa</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">paronitar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3650">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p26706"/>
    <skos:definition xml:lang="sv">Bojarerna var den högsta furstliga tjänsteklassens medlemmar i Ryssland före Peter den stores tid. Benämningen användes också bl.a. i Ungern och Rumänien.</skos:definition>
    <skos:definition xml:lang="fi">Pajarit olivat Venäjän ylimmän ruhtinaallisen palvelusluokan jäseniä ennen Pietari Suuren aikaa. Pajari-nimitystä käytettiin myös muun muassa Unkarin ja Romanian alueella.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bojar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pajari</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3651">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p25733"/>
    <skos:definition xml:lang="sv">Högsta adelstitel och kungliga prinsars titel i vissa länder.</skos:definition>
    <skos:definition xml:lang="fi">Korkein aatelisarvo ja kuninkaallisten prinssien arvonimi eräissä maissa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">hertig</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">herttua</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3652">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tsaritsa</skos:altLabel>
    <skos:definition xml:lang="fi">Tsaarin puoliso; tsaaria vastaava naispuolinen hallitsija.</skos:definition>
    <skos:definition xml:lang="sv">Tsarens gemål; kvinnlig motsvarighet till tsar.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tsaaritar</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tsarinna</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3653">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Keskiajan ritareiden ja pappien arvonimi.</skos:definition>
    <skos:definition xml:lang="sv">Titel för riddare och präster under medeltiden.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">herra</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">herre</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3654">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kalif (hederstitel)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kalifi (arvonimi)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p29154"/>
    <skos:definition xml:lang="sv">Högsta andliga och världsliga ledaren inom islam.</skos:definition>
    <skos:definition xml:lang="fi">Islamilaisten korkein hengellinen ja maallinen johtaja.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kalif</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kalifi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3655">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Friherres gemål eller dotter (som är eller har varit gift).</skos:definition>
    <skos:definition xml:lang="fi">Vapaaherran puoliso tai (naimisissa oleva tai ollut) tytär.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">friherrinna</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vapaaherratar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3656">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">prost (hederstitel)</skos:altLabel>
    <skos:altLabel xml:lang="fi">rovasti (arvonimi)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p4293"/>
    <skos:definition xml:lang="sv">Hederstitel som biskop tilldelat en meriterad präst.</skos:definition>
    <skos:definition xml:lang="fi">Piispan ansioituneelle papille myöntämä arvonimi.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">prost</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rovasti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3657">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p24079"/>
    <skos:definition xml:lang="fi">Arvoltaan kreiviä lähinnä alempi aatelismies.</skos:definition>
    <skos:definition xml:lang="sv">Lägre adelsman närmast greve i rang.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">friherre</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vapaaherra</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3658">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p25522"/>
    <skos:definition xml:lang="sv">Ledare av ortodoxt nunnekloster.</skos:definition>
    <skos:definition xml:lang="fi">Ortodoksisen nunnaluostarin johtajatar.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">igumenia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">igumenia</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3659">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p16399"/>
    <skos:definition xml:lang="sv">Hederstitel för judiska rättslärda och lärare.</skos:definition>
    <skos:definition xml:lang="fi">Juutalaisten lainoppineiden ja opettajien arvonimi.</skos:definition>
