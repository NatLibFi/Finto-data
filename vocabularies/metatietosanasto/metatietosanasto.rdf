    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasMuse"/>
    <skos:definition xml:lang="fi">Henkilö, joka inspiroi kuvailtavaa henkilöä taiteellisessa työssä.</skos:definition>
    <skos:definition xml:lang="sv">Person som inspirerar en beskriven person i konstnärligt arbete.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
