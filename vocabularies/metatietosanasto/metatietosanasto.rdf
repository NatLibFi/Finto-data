  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2068">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m197"/>
    <skos:definition xml:lang="fi">Kuoron esityskokoonpano, jossa on sopraano-, altto-, tenori- ja bassoääniä tai ainakin sekä nais- että miesääniä.</skos:definition>
    <skos:definition xml:lang="sv">Körsammansättning som utgörs av stämmorna sopran, alt, tenor och bas, eller åtminstone både kvinno- och mansstämmor.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blandad kör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sekakuoro</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2069">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Digital Cinema Package on nimitys standardoidulle tavalle tomittaa elokuvien esityskopiot teattereihin digitaalisessa muodossa.</skos:definition>
    <skos:definition xml:lang="sv">Digital Cinema Package är en benämning på ett standardiserat sätt att leverera filmers visningskopior i digitalt format till teatrar.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DCP</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DCP</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m207">
