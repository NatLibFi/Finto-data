    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2295"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisällön toisen teoksen ekspression sisältö osittain korvaa ja tekee vanhentuneeksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk vars innehåll ett annat verks innehåll delvis ersätter och gör föråldrat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20198"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ersätter delvis versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">korvaa osittain teoksen version</skos:prefLabel>
    <skos:prefLabel xml:lang="en">replacement in part of expression</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Detta element lämpar sig vanligen för uttryck av ett statiskt verk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tämä elementti soveltuu yleensä staattisen teoksen ekspressioon. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4314">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">equivalent manifestation relationship</skos:altLabel>
    <skos:altLabel xml:lang="sv">motsvarande manifestation</skos:altLabel>
    <skos:altLabel xml:lang="sv">motsvarande material</skos:altLabel>
    <skos:altLabel xml:lang="fi">vastaava manifestaatio</skos:altLabel>
    <skos:altLabel xml:lang="fi">vastaavan manifestaation suhde</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5856"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka sisältää saman teoksen ekspression kuin toinen manifestaatio. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som innehåller ett uttryck av samma verk som en annan manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30024"/>
