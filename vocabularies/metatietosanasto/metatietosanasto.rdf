  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6028">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">estenom</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">estenomi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6029">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ackordgrepp</skos:altLabel>
    <skos:altLabel xml:lang="fi">sointukaaviot</skos:altLabel>
    <skos:definition xml:lang="fi">Nuottikirjoituksen tyyppi, jossa käytetään ruudukolle järjestettyjä pisteitä tai muita symboleja edustamaan sormituksia, joita käytetään tietyn soinnun tuottamiseen otenauhallisella kielisoittimella.</skos:definition>
    <skos:definition xml:lang="sv">Typ av notskrift, i vilken punkter och andra symboler ordnade i rutfält används för att representera fingersättningar, som används för att producera ett visst ackord på stränginstrument med band.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/MusNotation/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ackorddiagram</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chord diagrams</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sointuotteet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6030">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ackordsymboler</skos:altLabel>
    <skos:definition xml:lang="fi">Nuottikirjoituksen tyyppi, jossa käytetään kirjaimia, numeroita ja symboleja ilmaisemaan musiikkikappaleen harmonista etenemistä nimeämällä sointuja niiden perussävelten, laadun (duurit, mollit, ylinousevat tai vähennetyt) ja lisättyjen tai muunnettujen sävelkorkeuksien osalta.</skos:definition>
    <skos:definition xml:lang="sv">Typ av notskrift, i vilken bokstäver, siffror och symboler används för att uttrycka ett musikstyckes harmoniska framskridande, genom att benämna ackord enligt deras grundton, kvalitet (dur, moll, överstigande eller förminskade) och tillagda eller varierade tonhöjder.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/MusNotation/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ackordbeteckningar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">chord symbols</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sointumerkit</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6031">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljudboksuppläsare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänikirjan lukija</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används endast om professionella uppläsare av ljudböcker. Används inte om en person som tillfälligt läser upp en ljudbok, till exempel då en författare själv läser upp sin egen bok.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään vain ammattimaisista äänikirjojen lukijoista. Ei käytetä, jos henkilö lukee satunnaisesti äänikirjan, esimerkiksi kun kirjailija lukee oman kirjansa äänikirjaksi.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6032">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">teaterrecensent</skos:altLabel>
    <skos:altLabel xml:lang="fi">teatteriarvostelija</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2386"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">teaterkritiker</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teatterikriitikko</skos:prefLabel>
    <skos:prefLabel xml:lang="en">theatre critic</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6033">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Nuottikirjoituksen tyyppi, joka on yleensä luettavissa myös viivastonuottikirjoituksena, jossa sävelkorkeudet merkitään käyttämällä nuottien päissä esimerkiksi erilaisia geometrisia muotoja ja värejä.</skos:definition>
    <skos:definition xml:lang="sv">Typ av notskrift, som vanligen även kan läsas som traditionell västerländsk notskrift och i vilken tonhöjderna anges genom att använda olika geometriska former och färger.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">figurnotation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvionuottikirjoitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6034">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30307"/>
    <skos:definition xml:lang="fi">Analogisen äänilieriön urajako.</skos:definition>
    <skos:definition xml:lang="sv">Spårdelning för en analog ljudcylinder.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m15"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m850"/>
    <skos:prefLabel xml:lang="en">Groove pitch</skos:prefLabel>
