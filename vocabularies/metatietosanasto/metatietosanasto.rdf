    <skos:prefLabel xml:lang="sv">skogsförman</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3956">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kalkyleringssekreterare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2532"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laskentasihteeri</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redovisningssekreterare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3957">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Asioitsija tarkoittaa lakimiestä, jolla ei ole lainopillista koulutusta. Asioitsijat hoitavat siviilioikeudellisia asioita eli toimittavat perunkirjoituksia, laativat kauppakirjoja, testamentteja, avioehtosopimuksia ja verovalituksia. Aiemmin asioitsijoiksi luettiin myös muun muassa vakuutusasiamiehet ja kauppaedustajat. (Lähde: Wikipedia.)</skos:definition>
    <skos:definition xml:lang="sv">Personer som inte har juridisk utbildning, men som sköter civilrättsliga ärenden, alltså förrättar bouppteckningar, skriver köpebrev, testamenten, äktenskapsförord och skattebesvär. Tidigare räknades också bl.a. skatteombud och handelsrepresentanter till sakförare.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asioitsija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sakförare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3958">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Hovioikeudenlaamanni on hovioikeuden osastoa johtava tuomari tai päällikkö (Lähde: Wikipedia).</skos:definition>
