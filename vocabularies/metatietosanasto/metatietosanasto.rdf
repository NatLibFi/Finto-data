    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa julkaistun manifestaation kustantamisesta, julkaisemisesta tai ilmestymisestä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för förläggande, utgivning eller utkommande av en publicerad manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30362"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
