    <skos:prefLabel xml:lang="sv">artikelsamling</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">artikkelikokoelma</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5066">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kartografinen tietotyyppi, joka käyttää pisteitä esittämään geospatiaalisia ominaisuuksia.</skos:definition>
    <skos:definition xml:lang="sv">Kartografisk datatyp, som använder punkter för att representera geospatiala egenskaper.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACartoDT/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">piste</skos:prefLabel>
    <skos:prefLabel xml:lang="en">point</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">punkt</skos:prefLabel>
  </owl:Class>
