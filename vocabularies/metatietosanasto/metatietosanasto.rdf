    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lantmäteriförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maanmittaushallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m495">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">abridger</skos:altLabel>
    <skos:altLabel xml:lang="sv">förkortad av (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">lyhentäjä (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5705"/>
    <skos:definition xml:lang="sv">Aktör som deltar i skapandet av ett uttryck, genom att förkorta ett relaterat verks uttryck utan att förändra framställningens allmänna innehåll eller stil.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen lyhentämällä siihen liittyvän teoksen ekspressiota muuttamatta esityksen yleistä sisältöä tai tyyliä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20049"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">abridger agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förkortad av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lyhentäjä</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske oleellista muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte betydande ändringar, som leder till skapandet av ett nytt verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4950">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3606"/>
    <skos:example xml:lang="fi">asukkaanottolautakunnat; asutuspiirit; asutustarkastajat; asutustoimikunnat; asutustoiminnan johtajat; maanhankinnan tarkastuspiirit; maankäyttötoimikunnat; maanlunastustoimikunnat; pika-asutustoimikunnat; virkatalojen tarkastajat; vuokratoimikunnat</skos:example>
    <skos:example xml:lang="sv">åbonämnder; kolonisationsdistrikt;  kolonisationsinspektörer; kolonisationskommissioner; markanvändningskommissioner; jordinlösningsnämnder; snabbkolonisationskommissioner; boställsinspektörer</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asutushallinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kolonisationsförvaltning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4951">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3610"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p8224"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ilmailuhallinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">luftfartsförvaltning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4952">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">exekutionsväsen</skos:altLabel>
    <skos:altLabel xml:lang="sv">utsökningsväsen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3634"/>
    <skos:example xml:lang="fi">kaupunginvoudit; ulosottovirastot</skos:example>
    <skos:example xml:lang="sv">stadsfogdar; exekutionsverk</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ulosottotoimi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utsökningsväsende</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4955">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="fi">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">MARC 21</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:definition xml:lang="sv">Hur ljudet ursprungligen spelades in och lagrades. Återutgivna ljudupptagningar kodas enligt hur ljudet ursprungligen spelades in och lagrades.</skos:definition>
    <skos:definition xml:lang="fi">Miten ääni alun perin taltioitiin ja tallennettiin. Uudelleenjulkaistu äänite koodataan sen mukaan, miten ääni alun perin taltioitiin ja tallennettiin.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4956"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4957"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4958"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4959"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4960"/>
    <skos:prefLabel xml:lang="fi">Alkuperäinen taltiointi- ja tallennustekniikka</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Original capture and storage technique</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Ursprunglig inspelnings- och lagringsteknik</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4956">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="fi">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Inspelning med mikrofon eller liknande apparat direkt till en masterskiva. Denna teknik användes för alla ljudinspelningar som spelades in med mikrofon eller liknande apparater från 1925 till slutet av 1940-talet. Tekniken har också använts i nyare ljudupptagningar, som är märkta med ”direct to disc” eller liknande. Även kallad elektromekanisk inspelning.</skos:definition>
    <skos:definition xml:lang="fi">Mikrofonilla tai vastaavalla laitteella tehty taltiointi suoraan masterlevylle. Tätä tekniikkaa käytettiin kaikilla äänitteillä, jotka taltioitiin mikrofoneilla tai vastaavilla laitteilla vuodesta 1925 aina 1940-luvun lopulle asti. Tätä tekniikkaa on käytetty myös uudemmissa äänitteissä, joissa on "direct to disc" tai vastaava merkintä. Tunnetaan myös nimellä sähkömekaaninen äänitys.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Electrical capture, analog direct storage</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Elektrisk inspelning, analog direkt lagring</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Sähköinen taltiointi, analoginen suora tallennus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4957">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="fi">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Digital lagring för ljudupptagningar togs i bruk på 1980-talet. Dessa ljudupptagningar kan ha märkningen ”digitally recorded” eller motsvarande. Märkningarna ”digital remastering” eller ”digital mixing” berör processer efter inspelning och lagring, och betyder inte att den ursprungliga inspelningen eller lagringen är digital.</skos:definition>
    <skos:definition xml:lang="fi">Äänitteiden digitaalinen tallennus tuli käyttöön 1980-luvulla. Näissä äänitteissä voi olla "digitally recorded" tai vastaava merkintä. Merkinnät "digital remastering" tai "digital mixing" koskevat taltioinnin ja tallennuksen jälkeisiä prosesseja. Tällaiset merkinnät eivät osoita, että alkuperäinen taltiointi tai tallennus olisivat olleet digitaalisia.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Electrical capture, digital storage</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Elektrisk inspelning, digital lagring</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Sähköinen taltiointi, digitaalinen tallennus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4958">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="fi">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Levy- tai lieriöäänite, joka on taltioitu käyttäen kuulotorvea ja välikalvoa sekä tallennettu suoraan masterin pinnalle. Ensimmäiset kaupalliset akustiset äänityslaitteet tulivat käyttöön 1877 alkaen ja niitä hyödynnettiin 1920-luvun loppupuolelle. 1925 alkaen niitä käytettiin rinnan sähköisten äänityslaitteiden kanssa.</skos:definition>
    <skos:definition xml:lang="sv">Skiv- eller cylinderljudupptagning som spelats in med akustiskt horn och membran, och som lagrats direkt på en masters yta. De första kommersiella akustiska inspelningsapparaterna togs i bruk fr.om. 1877 och de användes till slutet av 1920-talet. Efter 1925 användes de parallellt med elektriska inspelningsapparater.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Acoustical capture, analog direct storage</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Akustinen taltiointi, analoginen suora tallennus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Akustisk inspelning, analog direkt lagring</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4959">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="fi">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Elektriskt inspelad ljudupptagning som lagrats på magnetband eller motsvarande media. Till denna grupp hör största delen av ljudinspelningarna från slutet av 1940-talet fram till övergångsskedet till digital lagring som räckte ca 10 år, från början av 1980-talet till början av 1990-talet.</skos:definition>
    <skos:definition xml:lang="fi">Sähköisesti taltioitu äänite, joka on tallennettu magneettinauhalle tai vastaavalle medialle. Tähän ryhmään kuuluu suurin osa äänitteistä, jotka on tehty 1940-luvun lopulta siirtymävaiheeseen asti. Siirtymä digitaaliseen tallennukseen kesti noin kymmenen vuotta, 1980-luvun alusta 1990-luvun alkuun.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Electrical capture, analog electrical storage</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Elektrisk inspelning, analog elektrisk lagring</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Sähköinen taltiointi, analoginen sähköinen tallennus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4960">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="fi">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">MARC 21</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Alkuperäistä taltiointi- ja tallennustekniikkaa ei tunneta.</skos:definition>
    <skos:definition xml:lang="sv">Den ursprungliga inspelnings- och lagringstekniken är inte känd.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Okänd inspelning och lagring</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tuntematon taltiointi ja tallennus</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Unknown capture and storage</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4962">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">erratablad</skos:altLabel>
    <skos:altLabel xml:lang="sv">erratalista</skos:altLabel>
    <skos:altLabel xml:lang="sv">korrigeringsblad</skos:altLabel>
    <skos:definition xml:lang="sv">Enhet som består av ett ark, med en förteckning över fel som observerats i publikationen, jämte rättelser av dessa.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö joka koostuu arkista, johon on koottu julkaisussa havaittujen virheiden luettelo oikaisuineen.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">korjauslehti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">rättelseblad</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4963">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förlag (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kustantaja (yhteisö)</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förlag</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kustantamo</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4964">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">idrottssällskap</skos:altLabel>
    <skos:altLabel xml:lang="sv">sportförening</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2041"/>
    <skos:definition xml:lang="sv">Institution som grundats genom medlemmarnas gemensamma överenskommelse, för att utöva idrott eller sport. Sammanslutningen kan vara en registrerad eller oregistrerad förening eller ett bolag.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on perustettu jäsentensä yhteisellä sopimuksella urheilun harjoittamiseksi. Urheiluseura voi olla rekisteröity tai rekisteröimätön yhdistys tai yhtiö.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">idrottsförening</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">urheiluseura</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4965">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">gud</skos:altLabel>
    <skos:altLabel xml:lang="sv">gudaväsen</skos:altLabel>
    <skos:altLabel xml:lang="sv">gudom</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p7943"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">gudomligt väsen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">jumalolento</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei ole RDA:n mukainen toimija.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Är inte en aktör i enlighet med RDA.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4966">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
