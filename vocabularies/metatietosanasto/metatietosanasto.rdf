    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet som är ett ark, avsett att läsas vikt till sidor.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö on arkki, jota on tarkoitus lukea sivuiksi taiteltuna.</skos:definition>
