    <skos:scopeNote xml:lang="fi">Äänen koodausmuoto, tiedostopääte .aiff, .aif, .aifc</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m23">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">käänt. (kääntäjä)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kääntäjä (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kääntäjä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">translator</skos:altLabel>
    <skos:altLabel xml:lang="sv">translator</skos:altLabel>
    <skos:altLabel xml:lang="sv">övers. (översättare)</skos:altLabel>
    <skos:altLabel xml:lang="sv">översättare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">översättare (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5710"/>
    <skos:definition xml:lang="sv">Aktör som deltar i skapandet av ett uttryck, genom att uttrycka ett verks språkliga innehåll på ett språk som avviker från ett originalverks tidigare uttryck.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20037"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kääntäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">translator agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">översättare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En översättare kan också översätta språkligt innehåll mellan olika former av samma språk från olika tidsperioder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2300">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Audio Interchange File Format</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ACC</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ACC</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Kodningsformat för ljud, filändelse .m4a, .m4b, .m4p, .m4v, .m4r, .3gp, .mp4, .aac .</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänen koodausmuoto, tiedostopääte .m4a, .m4b, .m4p, .m4v, .m4r, .3gp, .mp4, .aac .</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2304">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare till lyckönskan</skos:altLabel>
    <skos:altLabel xml:lang="fi">onnittelun kirjoittaja</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5285"/>
    <skos:definition xml:lang="fi">Liittää kappaleen henkilöön, joka toimii gratulaation kirjoittajana.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar exemplar med en person som fungerar som författare till gratulation.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">författare till gratulation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">gratulaation kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2306">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5899"/>
    <skos:definition xml:lang="sv">Föremål för gratulation, om den är riktad till någon annan än verkets författare.</skos:definition>
    <skos:definition xml:lang="fi">Gratulaation kohdehenkilö, jos se on osoitettu jollekin muulle kuin teoksen kirjoittajalle.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">föremål för gratulation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">gratulaation kohde</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Annan aktör relaterad till verk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Teokseen liittyvä muu toimija.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2308">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Notskrift som grundar sig på tonfigurer och andra dylika beskrivande bokstäver, punkter och andra grafiska element som tillfogats i samband med text som ska sjungas.</skos:definition>
    <skos:definition xml:lang="fi">Nuottikirjoitus, joka perustuu laulettavan tekstin yhteyteen lisättyihin sävelkuvioita yms. kuvastaviin kirjaimiin, pisteisiin ja muihin graafisiin elementteihin.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ekfoneettinen nuottikirjoitus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ekfonetisk notation</skos:prefLabel>
  </owl:Class>
