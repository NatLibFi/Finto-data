    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Elokuvafilmin esitysformaatti, joka käyttää ääniraidallisen filmin projektoriaukon standardikokoa.</skos:definition>
    <skos:definition xml:lang="sv">Visningsformat för film, med ljudfilmens standardstorlek för projektoröppning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/presFormat/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">standard sound aperture</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">standardbildstorlek för ljudfilm</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänifilmin standardikuvakoko</skos:prefLabel>
  </owl:Class>
