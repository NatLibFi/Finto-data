  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m223">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Bokens format består av ett eller flera blad som till sin storlek är 1/12 av ett tryckark.</skos:definition>
    <skos:definition xml:lang="fi">Kirjan formaatti muodostuu yhdestä tai useammasta lehdestä, jotka ovat kooltaan 1/12 painoarkista.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/bookFormat/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">12:o</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">12:o</skos:prefLabel>
    <skos:prefLabel xml:lang="en">12mo</skos:prefLabel>
  </owl:Class>
