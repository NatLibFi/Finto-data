  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m732">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka koostuu väristä tai väriaineista jotka on sidottu akryylihartsia sisältäväksi emulsioksi.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av färg eller färgämnen, som är bundna till en emulsion med akrylharts.</skos:definition>
