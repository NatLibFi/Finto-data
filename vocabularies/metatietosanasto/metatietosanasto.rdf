  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m291">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m83"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10368"/>
    <skos:altLabel xml:lang="sv">Anmärkning om utgivningsfrekvens</skos:altLabel>
    <skos:altLabel xml:lang="fi">Huomautus ilmestymistiheydestä</skos:altLabel>
    <skos:altLabel xml:lang="en">Note on frequency</skos:altLabel>
    <skos:definition xml:lang="fi">Liittää manifestaation ilmestymistiheyteen, joka ilmaisee, millaisin aikavälein sarja-aineiston numerot tai osat ilmestyvät tai päivittyvän aineiston päivitykset tapahtuvat.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med en utgivningsfrekvens som anger med hurudana intervall nummer eller delar i en seriell resurs utkommer eller uppdateringar i en integrerande resurs sker.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1049"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1091"/>
