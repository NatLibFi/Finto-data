    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5824"/>
    <skos:definition xml:lang="fi">Kappaleen nykyinen omistajayhteisö, joka tallettaa kappaleen toisen toimijan huostaan omistajuudesta luopumatta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Nuvarande ägarinstitution till ett exemplar, som förvarar exemplaret hos en annan aktör, utan att överlåta ägarskapet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40139"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deponerat av</skos:prefLabel>
    <skos:prefLabel xml:lang="en">depositor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tallettaja</skos:prefLabel>
  </owl:Class>
