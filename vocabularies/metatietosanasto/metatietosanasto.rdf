    <skos:altLabel xml:lang="sv">katalogisatör (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kokoelman luetteloija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="fi">luetteloija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">samlingsregistrator (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5390"/>
