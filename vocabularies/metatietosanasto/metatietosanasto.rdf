    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat genom att skapa ett uttryck av ett koreografiskt verk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30339"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">choreographer (manifestation)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">koreograf (manifestation)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">koreografi (manifestaatio)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5284">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
