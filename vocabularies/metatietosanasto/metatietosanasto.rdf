    <skos:prefLabel xml:lang="en">preferred title of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6042">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/i/P40086"/>
    <skos:definition xml:lang="fi">Kappaleen nimeke, jota ei ole valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
    <skos:definition xml:lang="sv">Titel för exemplar, som inte har valts till primär i en viss tillämpning eller kontext.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
