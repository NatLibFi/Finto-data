    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-levylle, joka on koodattu toistettavaksi Kaakkois-Aasiassa ja Itä-Aasiassa, mukaan lukien Hong Kong.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning i Sydöstasien och Östasien, inklusive Hong Kong.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 3</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 3</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 3</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4399">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-videolevylle, joka on koodattu toistettavaksi laitteilla Yhdysvalloissa, Kanadassa, Bermudalla sekä Yhdysvaltain territorioissa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning med apparater i Förenta staterna och dess territorier, Kanada och Bermuda.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 1</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 1</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 1</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m440">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som visar en hel heraldisk vapensköld och dess tillbehör.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka sisältää koko näkymän kilvestä ja lisäkkeistä koostuvasta vaakunasta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">coat of arms</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vaakuna</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vapen (heraldik)</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: vapen, xx vapen.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: vaakunoita, xx vaakunaa.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4400">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
