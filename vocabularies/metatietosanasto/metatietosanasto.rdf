  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5493">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">konstnär (institution) som är bidragsgivare till stillbild</skos:altLabel>
    <skos:altLabel xml:lang="fi">stillkuvaan osallinen taiteilija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6016"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. yhteisötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsinstitution till en ursprunglig grafisk design, teckning, målning eller dylikt, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">konstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taiteilija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5494">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
