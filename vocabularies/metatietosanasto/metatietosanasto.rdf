  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5796">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esineeseen osallinen kuvanveistäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skulptör (institution) som är bidragsgivare till föremål</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5337"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän kolmiulotteisen teoksen muovaamalla, veistämällä tai vastaavalla tekniikalla luonut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som skapat ett tredimensionellt verk som ingår i ett aggregat, genom att modellera, skära eller använda någon liknande teknik.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuvanveistäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skulptör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5797">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
