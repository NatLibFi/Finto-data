    <skos:prefLabel xml:lang="sv">bilaga</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liite</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar referensförteckningar, statistiktabeller och förklaringar, som inte är nödvändiga för att innehållet ska vara fullständigt.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää viiteluettelot, tilastotaulut ja selitykset, jotka eivät ole välttämättömiä sisällön täydellisyydelle. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4260">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4313"/>
