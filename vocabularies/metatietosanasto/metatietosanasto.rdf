    <skos:altLabel xml:lang="sv">jaktförening (registrerad)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kerho (rekisteröity)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kilta (rekisteröity ainejärjestö)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjallisuuspiiri (rekisteröity)</skos:altLabel>
    <skos:altLabel xml:lang="sv">klubb (registrerad)</skos:altLabel>
    <skos:altLabel xml:lang="sv">litteraturcirkel (registrerad)</skos:altLabel>
