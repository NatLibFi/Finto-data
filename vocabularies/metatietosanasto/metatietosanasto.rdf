    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kaksi kertaa viikossa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">semiweekly</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">två gånger per vecka</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4358">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">en gång per dag</skos:altLabel>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kerran päivässä, yleensä arkipäivisin.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras en gång per dag, vanligen vardagar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dagligen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">daily</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">päivittäin</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4359">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kerran kahdessa kuukaudessa.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras varannan månad.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">bimonthly</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kerran kahdessa kuukaudessa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">varannan månad</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4360">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fyra gånger i året</skos:altLabel>
    <skos:altLabel xml:lang="fi">neljännesvuosittain</skos:altLabel>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy neljä kertaa vuodessa.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras fyra gånger per år.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fyra gånger per år</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">neljä kertaa vuodessa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quarterly</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4361">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kerran kolmessa vuodessa.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras vart tredje år.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kerran kolmessa vuodessa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">triennial</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vart tredje år</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4362">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Film med negativ polaritet som har exponerats i kameran, och som därför vanligen är av bättre kvalitet än nästa generation eller härledning.</skos:definition>
    <skos:definition xml:lang="fi">Negatiivisen polariteetin filmi, joka on valotettu kamerassa ja joka siksi yleensä on parempilaatuinen kuin seuraava sukupolvi tai johdannainen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alkuperäinen negatiivi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">original negative</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">originalnegativ</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4363">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kaksi kertaa vuodessa.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras två gånger i året.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kaksi kertaa vuodessa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">semiannual</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">två gånger per år</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4364">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">vertailukopio</skos:altLabel>
    <skos:definition xml:lang="sv">Bestämning av generation, som är en referenskopia godkänd av filmproducent och -regissör.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolven määrite, joka on elokuvan tuottajan ja ohjaajan hyväksymä koevedos.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">koevedos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reference print</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">referenskopia</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4365">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Bestämning av generation, som är en positivkopia tillverkad av en tidigare generations negativfilm, och som används för att tillverka negativkopior i stället för bilder.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolven määrite, joka on aikaisemman sukupolven negatiivifilmistä valmistettu positiivivedos, ja jota käytetään negatiivikopioiden valmistamiseksi kuvien sijaan.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">master positiv</skos:prefLabel>
    <skos:prefLabel xml:lang="en">master positive</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">master-positiivi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4366">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Bestämning av generation, som är en efterbildning av en originalbild eller ett originalljudspår, vanligen med negativ polaritet, i vilken ett negativt duplikat har tillverkats från ett masterpositiv, som i sin tur är tillverkad från ett tidigare negativ.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolven määrite, joka on alkuperäisen kuvan tai ääniraidan jäljitelmä, tavallisesti negatiivisella polariteetilla, jossa negatiivinen duplikaatti on valmistettu master-positiivista, joka vuorostaan on valmistettu aiemmasta negatiivista.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">duplicate</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">duplikaatti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">duplikat</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4367">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Ilmestymis- tai päivittymistiheys aineistolle, joka ilmestyy tai päivittyy kerran kahdessa vuodessa.</skos:definition>
    <skos:definition xml:lang="sv">Utgivnings- eller uppdateringsfrekvens för material som utkommer eller uppdateras vartannat år.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/frequency/1014"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">biennial</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kerran kahdessa vuodessa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vartannat år</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4368">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Ei-magneettinen metallinen alkuaine, joka on taipuisa ja muokattava, väriltään harmaan tai hopean sävyinen.</skos:definition>
    <skos:definition xml:lang="sv">Icke-magnetiskt metalliskt grundämne som är böjligt och formbart, till sin färg grått eller silverskiftande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alumiini</skos:prefLabel>
    <skos:prefLabel xml:lang="en">aluminium</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aluminium</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4369">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka koostuu synteettisistä tai orgaanisista polymeereistä ja jolla on suuri joustavuus ja kimmoisuus.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av syntetiska eller organiska polymerer och har stor elasticitet och spänst.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1032"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">gummi</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kumi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rubber</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m437">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1568"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10086"/>
    <skos:definition xml:lang="fi">Teoksen nimeke, jota ei ole valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
    <skos:definition xml:lang="sv">Titel för verk, som inte har valts till primär i en viss tillämpning eller kontext.</skos:definition>
    <skos:prefLabel xml:lang="fi">Teoksen varianttinimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Variant title for work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Varianttitel för verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4370">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Julkaisutapa, jossa manifestaatio ilmestyy toisiaan seuraavina ja yleensä numeroituina osina ja jonka ilmestyminen on periaatteessa päättymätöntä.</skos:definition>
    <skos:definition xml:lang="sv">Utgivningssätt, i vilket en manifestation utkommer i delar som följer på varandra och som vanligen är numrerade, samt utkommer i princip oändligen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/ModeIssue/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sarja-aineisto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">serial</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">seriell resurs</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4371">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">en enhet</skos:altLabel>
    <skos:definition xml:lang="fi">Julkaisutapa, jossa manifestaatio ilmestyy yhtenä fyysisenä yksikkönä tai yhtenä loogisena aineettomana kokonaisuutena.</skos:definition>
    <skos:definition xml:lang="sv">Utgivningssätt, i vilket en manifestation utkommer som en fysisk enhet eller som en logisk immateriell helhet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/ModeIssue/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">resurs utkommen som en enhet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">single unit</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhtenä yksikkönä ilmestyvä aineisto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4372">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30003"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4370"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4371"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4373"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4374"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5100"/>
    <skos:prefLabel xml:lang="fi">Julkaisutapa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Mode of issuance</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Utgivningssätt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4373">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Julkaisutapa, jossa manifestaatio ilmestyy kahtena tai useampana joko samanaikaisesti tai peräkkäin ilmestyvänä osana ja jonka ilmestyminen on päättynyt tai on tarkoitettu päättymään rajalliseen määrään osia.</skos:definition>
    <skos:definition xml:lang="sv">Utgivningssätt som innebär att en manifestation utkommer i två eller flera delar, antingen samtidigt eller efter varandra, och på så vis att utgivningen är avslutad eller avsedd att upphöra efter ett begränsat antal delar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/ModeIssue/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">moniosainen monografia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">monografi i flera delar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">multipart monography</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4374">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Julkaisutapa, jossa manifestaatiota kartutetaan ja muokataan päivityksillä, jotka eivät jää erillisiksi vaan integroituvat kokonaisuuteen.</skos:definition>
    <skos:definition xml:lang="sv">Utgivningssätt, i vilket en manifestation berikas och redigeras med uppdateringar som inte lämnas skilda utan integreras i helheten.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/ModeIssue/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">integrating resource</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">integrerande resurs</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">päivittyvä aineisto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4375">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken tecken och symboler i ett bottenmaterial görs genom att skära i dess yta.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa tehdään merkkejä ja symboleja pohjamateriaaliin sen pintaa leikkaamalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">inscribing</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">inscribing</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">inscribing</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4376">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod för material som grundar sig på känselsinnet och i vilka en bild är tryckt på specialpapper. I pappret finns mikrokapslar som innehåller alkohol och som reagerar på värme genom att utvidga sig.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä tuntoaistiin perustuville aineistoille, joissa kuva on painettu erikoispaperille. Paperissa on alkoholia sisältäviä mikrokapseleita, jotka reagoivat lämpöön laajenemalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1021"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">lämpömuovaus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">termoform</skos:prefLabel>
    <skos:prefLabel xml:lang="en">thermoform</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4377">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken tryck påförs för att lämna ett avtryck i ett materials yta.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa paineen avulla painetaan jälki materiaalin pintaan</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1017"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">leimaus</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stamping</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stämpling</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4378">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kollotypi</skos:altLabel>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken tryckningen grundar sig på en dikromatlösnings kemiska reaktion, som härdar gelatinet när det utsätts för ultaviolettljus och producerar en positiv originalplatta, som används senare i litografiprocessen.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa painatus perustuu dikromaattiluoksen kemialliseen reaktioon, joka kovettaa gelatiinin sen altistuessa ultraviolettivalolle ja tuottaa positiivisen alkuperäislaatan, jota käytetään myöhemmin litografiaprosessissa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">collotype</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kollotypia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljustryck</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4379">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken bild eller text överförs från en upptagning till ett annat materials yta, ofta med hjälp av överförbart material, platta, sten eller bildyta. Inkluderar tillverkningen av fotokopior och pappersutskrifter av lagrat datormaterial.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa kuva tai teksti siirretään tallenteelta toisen aineiston pinnalle, usein siirrettävällä materiaalilla katetun laatan, kiven tai kuvapinnan avulla. Sisältää valokuvavedosten sekä tallennetun tietokoneaineiston paperitulosteiden valmistamisen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">painaminen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">printing</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4380">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken tryckning grundar sig på en kemisk reaktion mellan diazoniumsalt och azofärg, som ändrar opaka nyanser eller färger till blått på en neutral bakgrund.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa painatus perustuu diatsoniumsuolan ja atsovärin kemialliseen reaktioon, joka muuttaa läpikuultamattomat sävyt tai värit siniseksi neutraalilla taustalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">blueline process</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">blueline-menetelmä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">blueline-metod</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4381">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-levylle, joka on koodattu toistettavaksi Japanissa, Euroopassa, Etelä-Afrikassa sekä Lähi-idässä, mukaan lukien Egypti.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning i Japan, Europa, Sydafrika samt Mellanöstern, inklusive Egypten.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 2</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 2</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 2</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4382">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aineiston mittakaava vaihtelee, eikä arvojen laajuutta pystytä määrittelemään.</skos:definition>
    <skos:definition xml:lang="sv">Materialets skala varierar och omfånget på värdena kan inte fastställas.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/scale/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">mittakaava vaihtelee</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scale varies</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">varierande skala</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4383">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi videopelitallenteelle, joka on koodattu toistettavaksi Yhdysvalloissa, Kanadassa, Meksikossa ja Etelä-Amerikassa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för videospel som är kodade för uppspelning i Förenta staterna, Kanada, Mexiko och Sydamerika.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1014"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue U/C</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region U/C</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region U/C</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4384">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aineisto koostuu useammasta eri mittakaavassa olevasta kuvasta, kartasta jne.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av bild, karta e.d. i flera olika skalor.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/scale/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">eri mittakaavoja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">olika skalor</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scales differ</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4385">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi videopelitallenteelle, joka on koodattu toistettavaksi Japanissa, Etelä-Koreassa, Taiwanissa, Hong Kongissa, Macaolla ja Kaakkois-Aasiassa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för videospel som är kodade för uppspelning i Japan, Sydkorea, Taiwan, Hong Kong, Macao och Sydöstasien.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue J</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region J</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region J</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4386">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi Blu-ray -levylle, joka on koodattu toistettavaksi Pohjois-Amerikassa, Keski-Amerikassa, Etelä-Amerikassa, Japanissa, Pohjois-Koreassa, Etelä-Koreassa, Taiwanissa, Hong Kongissa sekä Kaakkois-Aasiassa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för Blu-ray-skivor, som är kodade för uppspelning i Nordamerika, Centralamerika, Sydamerika, Japan, Nordkorea, Sydkorea, Taiwan, Hong Kong och Sydöstasien.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue A</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region A</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region A</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4387">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi Blu-ray -levylle, joka on koodattu toistettavaksi Intiassa, Nepalissa, Manner-Kiinassa, Venäjällä, Keski-Aasiassa ja Etelä-Aasiassa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för Blu-ray-skivor som är kodade för uppspelning i Indien, Nepal, Fastlandskina, Ryssland, Centralasien och Sydasien.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue C (Blu-ray)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region C (Blu-ray)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region C (Blu-ray)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4388">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi videopelille, joka on koodattu toistettavaksi Kiinassa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för videospel som är kodade för uppspelning i Kina.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue C (videopeli)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region C (video game)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region C (videospel)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4389">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-levylle, joka on koodattu toistettavaksi Australiassa, Uudessa-Seelannissa, Tyynenmeren saarilla, Keski-Amerikassa, Etelä-Amerikassa ja Karibialla.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning i Australien, Nya Zeeland, Stillahavsöarna, Centralamerika, Sydamerika och Karibien.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 4</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 4</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 4</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m439">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30453"/>
    <skos:altLabel xml:lang="sv">Illustration (illustrativt innehåll)</skos:altLabel>
    <skos:altLabel xml:lang="fi">Kuvitus (kuvasisältö)</skos:altLabel>
    <skos:definition xml:lang="fi">Liittää manifestaation ilmaukseen niistä kuvasisällön ekspressioista, jotka täydentävät laajennusaggregaatin sisältämiä pääekspressioita.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med en uppgift om uttryck för illustrativt innehåll, som kompletterar de huvuduttryck som ett utvidgat aggregat innehåller.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1082"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1378"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1436"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1536"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1671"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1672"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1673"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1711"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m275"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4350"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4352"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m440"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m455"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5105"/>
    <skos:prefLabel xml:lang="en">Illustrative content</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Illustrativt innehåll</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kuvasisältö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4390">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-levylle, joka on koodattu toistettavaksi kansainvälisillä alueilla, kuten lentokoneissa, risteilyaluksilla, avaruusaluksilla jne.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning på internationella områden, såsom i flygplan, kryssningsfartyg, rymdfarkoster etc.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 8</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 8</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 8</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4391">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-levylle, joka on koodattu toistettavaksi Itä-Euroopassa, Baltian maissa, Venäjällä, Keski- ja Etelä-Aasiassa, Intian niemimaalla, Afrikassa, Pohjois-Koreassa ja Mongoliassa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning i Östeuropa, Baltikum, Ryssland, Central- och Sydasien, Indiska halvön, Nordkorea och Mongoliet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 5</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 5</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 5</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4392">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-levylle, joka on koodattu toistettavaksi Kiinassa.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning i Kina.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 6</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 6</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 6</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4393">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi DVD-levylle, joka on koodattu toistettavaksi erityistarkoituksissa, kuten elokuva-alan ammattilaisille tai medialle lähetetyt suojatut kopiot</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för dvd-skivor som är kodade för uppspelning i specialsyften, såsom för professionella inom filmbranschen eller skyddade kopior skickade till media.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alue 7</skos:prefLabel>
    <skos:prefLabel xml:lang="en">region 7</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">region 7</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4394">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aluekoodi videolevylle tai videopelitallenteelle, joka sallii toiston maailmanlaajuisesti.</skos:definition>
    <skos:definition xml:lang="sv">Regionkod för videoskiva eller videospel som tillåter uppspelning över hela världen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDARegionalEncoding/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">all regions</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">alla regioner</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaikki alueet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4395">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aineiston mittakaavaa ei pystytä määrittelemään.</skos:definition>
    <skos:definition xml:lang="sv">Materialets skala kan inte fastställas.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/scale/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ei mittakaavatietoa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">scale not given</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skala ej angiven</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4396">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m261"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/e/P20291"/>
    <skos:definition xml:lang="fi">Liittää ekspression yleiseen määritteeseen kuvan tai kolmiulotteisen muodon ja niiden esittämän asian mittojen välisten mittasuhteiden puuttumisesta.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar uttryck med en allmän beteckning för saknaden av proportioner mellan måtten på en bild eller ett tredimensionellt föremål och det verkliga objekt den/det föreställer.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4382"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4384"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4395"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4397"/>
    <skos:prefLabel xml:lang="sv">Attribut till skala</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Mittakaavan määrite</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Scale designation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4397">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ej skalenligt</skos:altLabel>
    <skos:definition xml:lang="sv">Mått på stillbild eller tredimensionell form, som inte är skalenliga.</skos:definition>
    <skos:definition xml:lang="fi">Stillkuvan tai kolmiulotteisen muodon mitat, jotka eivät ole mittakaavassa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/scale/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ei mittakaavassa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ej skalriktigt</skos:prefLabel>
    <skos:prefLabel xml:lang="en">not drawn to scale</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4398">
