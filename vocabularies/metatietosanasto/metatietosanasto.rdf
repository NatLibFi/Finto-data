    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ammatilliset keskusjärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammattijärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammattiliitot</skos:altLabel>
    <skos:altLabel xml:lang="fi">ammattiosastot</skos:altLabel>
    <skos:altLabel xml:lang="sv">fackavdelningar</skos:altLabel>
    <skos:altLabel xml:lang="sv">fackförbund</skos:altLabel>
    <skos:altLabel xml:lang="sv">fackliga centralorganisationer</skos:altLabel>
    <skos:altLabel xml:lang="sv">fackorganisationer</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p15518"/>
    <skos:definition xml:lang="fi">Ammatin, alueen tai organisaatiorakenteen perusteella järjestäytyneet, jäsentensä palkkausta, työsuhteita ja työoloja ajavat työntekijäjärjestöt.</skos:definition>
    <skos:definition xml:lang="sv">Arbetstagarorganisationer som driver intressen gällande avlöning, anställning och arbetsförhållanden, för medlemmar organiserade utgående från yrke, område eller organisationsstruktur.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ammattiyhdistykset</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fackföreningar</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4894"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4916">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">garantiföreningar</skos:altLabel>
    <skos:altLabel xml:lang="sv">stödföreningar</skos:altLabel>
    <skos:altLabel xml:lang="sv">stödstiftelser</skos:altLabel>
    <skos:altLabel xml:lang="fi">tukisäätiöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">tukiyhdistykset</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1839"/>
    <skos:definition xml:lang="fi">Jotain toista yhteisöä henkisesti tai taloudellisesti tukevat järjestöt.</skos:definition>
    <skos:definition xml:lang="sv">Organisationer som intellektuellt eller ekonomiskt stöder en annan sammanslutning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kannatusyhdistykset</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">understödsföreningar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4917">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">byaföreningar</skos:altLabel>
    <skos:altLabel xml:lang="sv">byföreningar</skos:altLabel>
    <skos:altLabel xml:lang="fi">kyläyhdistykset</skos:altLabel>
    <skos:altLabel xml:lang="fi">perinnejärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="sv">traditionsföreningar</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3668"/>
    <skos:definition xml:lang="sv">Organisationer som utövar lokal eller regional traditions- och kulturverksamhet.</skos:definition>
    <skos:definition xml:lang="fi">Paikallista tai alueellista perinne- ja kulttuuritoimintaa harjoittavat järjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">hembygdsföreningar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kotiseutuyhdistykset</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4897"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4918">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p19335"/>
    <skos:definition xml:lang="sv">Organisationer som främjar jämställdhet mellan könen och kvinnors samhälleliga ställning.</skos:definition>
    <skos:definition xml:lang="fi">Sukupuolten välistä tasa-arvoa ja naisten yhteiskunnallista asemaa edistävät järjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kvinnosaksorganisationer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">naisasiajärjestöt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4919">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">egnahemsföreningar</skos:altLabel>
    <skos:altLabel xml:lang="sv">fastighetsföreningar</skos:altLabel>
    <skos:altLabel xml:lang="sv">invånarföreningar</skos:altLabel>
    <skos:altLabel xml:lang="fi">kiinteistöyhdistykset</skos:altLabel>
    <skos:altLabel xml:lang="fi">omakotiyhdistykset</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2252"/>
    <skos:definition xml:lang="sv">Organisationer som främjar ärenden gällande fastigheter och livsmiljö samt närdemokrati för invånarna på ett visst område.</skos:definition>
    <skos:definition xml:lang="fi">Tietyn alueen asukkaiden kiinteistö- ja elinympäristöasioita ja lähidemokratiaa edistävät järjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">asukasyhdistykset</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">boendeföreningar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m492">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">färgpulver</skos:altLabel>
    <skos:altLabel xml:lang="fi">värijauhe</skos:altLabel>
    <skos:definition xml:lang="sv">Material bestående av färg som lösts upp eller blandats i vätska.</skos:definition>
    <skos:definition xml:lang="fi">Nesteeseen liuenneesta tai sekoittuneesta väristä muodostuva materiaali, joka imeytyy pohjamateriaalin.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dye</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">färgämne</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">väriaine</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4920">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">maailmanjärjestöt</skos:altLabel>
    <skos:altLabel xml:lang="sv">vänskapsföreningar</skos:altLabel>
    <skos:altLabel xml:lang="sv">vänsällskap</skos:altLabel>
    <skos:altLabel xml:lang="sv">världsorganisationer</skos:altLabel>
    <skos:altLabel xml:lang="fi">ystävyysseurat</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p17837"/>
    <skos:definition xml:lang="fi">Erimaalaisista jäsenistä muodostuvat kansalaisjärjestöt, erimaalaisten kuntien ja kaupunkien sekä kansojen väliset ystävyysjärjestöt ja valtioiden väliset yhteistyöjärjestöt.</skos:definition>
    <skos:definition xml:lang="sv">Medborgarorganisationer som består av medlemmar från olika länder, vänskapsorganisationer mellan kommuner, städer och folk i olika länder, samt samarbetsorganisationer mellan stater.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">internationella organisationer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kansainväliset järjestöt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4921">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">släktsällskap</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p16360"/>
    <skos:definition xml:lang="sv">Organisationer som främjar släktforskning och upprätthåller släkttradition och -samhörighet.</skos:definition>
    <skos:definition xml:lang="fi">Sukututkimusta edistävät sekä sukuperinnettä ja suvun yhteenkuuluvuutta ylläpitävät järjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">släktföreningar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukuseurat</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4897"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4922">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">tiedesäätiöt</skos:altLabel>
    <skos:altLabel xml:lang="fi">tieteelliset seurat</skos:altLabel>
    <skos:altLabel xml:lang="sv">vetenskapliga organisationer</skos:altLabel>
    <skos:altLabel xml:lang="sv">vetenskapliga samfund</skos:altLabel>
    <skos:altLabel xml:lang="sv">vetenskapsstiftelser</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p15505"/>
    <skos:definition xml:lang="fi">Jonkin tieteenalan tai yleensä tieteen harjoittamista, tieteellistä tutkimusta ja opetusta sekä tiedon hyödyntämistä edistävät järjestöt.</skos:definition>
    <skos:definition xml:lang="sv">Organisationer som främjar en vetenskaplig disciplin eller överlag utövande av vetenskap, vetenskaplig forskning och undervisning, samt utnyttjande av kunskap.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tiedejärjestöt</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vetenskapsorganisationer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4923">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">multikulturella organisationer</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:definition xml:lang="fi">Maahanmuuttajien kulttuuria ylläpitävät ja suomalaisten ja maahanmuuttajien yhteisöllisyyttä edistävät järjestöt.</skos:definition>
    <skos:definition xml:lang="sv">Organisationer som upprätthåller invandrares kultur och främjar finländares och invandrares gemenskap.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">monikulttuuriset järjestöt</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mångkulturella organisationer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4924">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">patientföreningar</skos:altLabel>
    <skos:altLabel xml:lang="fi">potilasyhdistykset</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3615"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p24339"/>
    <skos:definition xml:lang="sv">Organisationer som bevakar patienters intressen samt erbjuder hälsorådgivning och kamratstöd.</skos:definition>
    <skos:definition xml:lang="fi">Potilaiden edunvalvontaa harjoittavat sekä terveysneuvontaa ja vertaistukea tarjoavat järjestöt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">hälsoorganisationer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">terveysjärjestöt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4925">
