    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5972"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa yhden tai useamman ekspression ilmiasusta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för ett eller flera uttrycks yttre form.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30363"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">creator person of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av material</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Manifestaation tekijä sisältää jakelijan, valmistajan, tuottajan ja kustantajan. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Skapare av manifestation innefattar distributör, tillverkare, producent och utgivare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5487">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">klichétillverkare</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvalaatan valmistaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckmakare</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckmakare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5323"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av en manifestation genom att tillverka tryckytan för relief, djuptryck eller plantryck.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation valmistamisesta valmistamalla kohokuvan, syväpainon tai laakapainon painopinnan. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30410"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
