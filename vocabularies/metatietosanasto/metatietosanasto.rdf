    <skos:prefLabel xml:lang="en">filer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">viilari</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m395">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kahdesta kanavasta koostuva stereofonisen äänen äänikanava.</skos:definition>
    <skos:definition xml:lang="sv">Ljudkanal för stereofoniskt ljud, som består av två kanaler.</skos:definition>
