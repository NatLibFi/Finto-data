    <skos:definition xml:lang="sv">Framförare i anslutning till notmaterial.</skos:definition>
    <skos:definition xml:lang="fi">Nuottiaineistoon liittyvä esittäjä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framförare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6025">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">fiktiivinen suku</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fiktiv släkt</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei ole RDA:n mukainen toimija.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Är inte en aktör i enlighet med RDA.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6026">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m258"/>
