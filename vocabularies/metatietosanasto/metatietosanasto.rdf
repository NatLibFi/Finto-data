    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Majakan toiminnasta vastaava viranomainen, joka on nimetty majakan nimen mukaan.</skos:definition>
    <skos:definition xml:lang="sv">Myndighet som ansvarar för en fyrs verksamhet, och som är namngiven enligt fyrens namn.</skos:definition>
