    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasAdoptiveSibling"/>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön sisarus, kun vähintään toinen sisaruksista on yhteisten vanhempien adoptiolapsi.</skos:definition>
    <skos:definition xml:lang="sv">Syskon till en beskriven person, då åtminstone ett av syskonen är adoptivbarn till gemensamma föräldrar.</skos:definition>
