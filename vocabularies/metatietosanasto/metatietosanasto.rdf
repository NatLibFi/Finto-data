    <skos:definition xml:lang="sv">Person som är en producent, som svarar för skötseln av de flesta kommersiella uppgifterna kring en ljudinspelning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10421"/>
