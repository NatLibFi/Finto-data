    <skos:altLabel xml:lang="en">architect</skos:altLabel>
    <skos:altLabel xml:lang="sv">arkitekt (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">arkitekt (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">arkkitehti (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">arkkitehti (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som ansvarar för skapandet av en arkitektplan, inklusive en bildpresentation över hur en byggnad eller en annan konstruktion ska se ut när den är färdig.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10062"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1086"/>
    <skos:prefLabel xml:lang="en">architect agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">arkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">arkkitehti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m721">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kehykseen asetettu, projektorin tai diojen katselulaitteen avulla katseltava kaksiulotteinen, läpinäkyvä kuva filmillä.</skos:definition>
    <skos:definition xml:lang="sv">Tvådimensionell och genomskinlig bild på film i ram, avsedd för användning i projektor eller betraktningsapparat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1040"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">dia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">diabild</skos:prefLabel>
    <skos:prefLabel xml:lang="en">slide</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Bärare för projicerbara bilder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Heijastettava kuvatallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m725">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kartografiskt innehåll uttryckt som linjer, former e.d., avsett att användas genom beröring som en tvådimensionell stillbild eller -bilder.</skos:definition>
    <skos:definition xml:lang="fi">Viivoina, muotoina tms. esitetty kartografinen sisältö, joka on tarkoitettu kosketeltavaksi kaksiulotteisena stillkuvana tai -kuvina.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
