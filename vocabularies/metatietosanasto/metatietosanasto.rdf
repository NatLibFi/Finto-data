  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1161">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on oppiarvoa tavoiteleva kandidaatti, joka akateemisessa väitöstilaisuudessa puolustaa tai opponoi preeseksen esittelemää väitöskirjaa. (RDA Registry)</skos:definition>
