    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:altLabel xml:lang="sv">annan bestämning relaterad till släkt</skos:altLabel>
    <skos:altLabel xml:lang="sv">annat epitet relaterat till släkt</skos:altLabel>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6025"/>
    <skos:prefLabel xml:lang="sv">annat attribut relaterat till släkt</skos:prefLabel>
