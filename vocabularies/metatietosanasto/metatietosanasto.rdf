    <skos:prefLabel xml:lang="en">printmaker corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckmakare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5489">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare till sångtext</skos:altLabel>
    <skos:altLabel xml:lang="fi">sanoittaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångtextförfattare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5497"/>
    <skos:definition xml:lang="sv">Institution som är författare till ord i en sång, även en musikalsång, som hör till populärmusik.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10524"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">lyricist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sanoittaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångtextförfattare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata pelkän musikaalin dialogin kirjoittajaa. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte författare till endast dialog i en musikal.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m549">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kuunneltavaksi tarkoitettu musiikki. Sisältää esim. musiikkiesitysten tallennukset, tietokoneella tuotetun musiikin jne.</skos:definition>
    <skos:definition xml:lang="sv">Musik avsedd att lyssnas på. Inbegriper upptagningar av musikframföranden, datorproducerad musik m.m.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esitetty musiikki</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framförd musik</skos:prefLabel>
    <skos:prefLabel xml:lang="en">performed music</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5490">
