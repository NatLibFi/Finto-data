    <skos:prefLabel xml:lang="fi">serkku</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4640">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4606"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasInfluenceDonor"/>
    <skos:definition xml:lang="fi">Henkilö, johon kuvailtava henkilö vaikuttaa.</skos:definition>
    <skos:definition xml:lang="sv">Person, som en beskriven person påverkar.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">is influenced by</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">påverkad av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vaikuttajana</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4641">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4642"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#isMuseOf"/>
    <skos:definition xml:lang="fi">Henkilö, jonka taiteellista työtä kuvailtava henkilö inspiroi.</skos:definition>
    <skos:definition xml:lang="sv">Person vars konstnärliga arbete en beskriven person inspirerar.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">is muse of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musa för</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muusana</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4642">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4641"/>
