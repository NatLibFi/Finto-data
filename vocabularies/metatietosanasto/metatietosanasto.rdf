    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5785"/>
    <skos:altLabel xml:lang="sv">mördad</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5336"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasMurderee"/>
    <skos:definition xml:lang="fi">Henkilö, jonka kuvailtava yhteisö on murhannut.</skos:definition>
    <skos:definition xml:lang="sv">Person som en beskriven institution har mördat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has murder victim</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mordoffer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">murhattu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5946">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5476"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5502"/>
    <skos:definition xml:lang="sv">Exemplar som använts som grund för en exakt och arkivbeständig reproduktion. Vid reproduktionens tillverkning har arkivbeständigt material, t.ex. arkivpapper, använts.</skos:definition>
    <skos:definition xml:lang="fi">Kappale, jota on käytetty täsmällisen ja arkistokelpoisen jäljennöksen pohjana. Jäljennöksen valmistuksessa on käytetty arkistokelpoista materiaalia, esim. arkistopaperia. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30301"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arkivbeständig kopia av exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="en">preservation facsimile of item of</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säilytyskopio kappaleesta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5947">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelande aktör (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">taltioija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att använda en inspelningsapparat för att lagra ljud eller video vid ett inspelningstillfälle.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen käyttämällä tallennuslaitetta äänen tai videon taltioimiseen tallennustilanteessa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20476"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelande institution</skos:prefLabel>
    <skos:prefLabel xml:lang="en">recordist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taltioija</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Inbegriper fältinspelningar av naturljud, musikframföranden och andra evenemang.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää luonnonäänten, musiikkiesitysten ja muiden tapahtumien kenttä-äänitykset. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5948">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5807"/>
    <skos:altLabel xml:lang="fi">kritiikki manifestaatiosta</skos:altLabel>
    <skos:altLabel xml:lang="sv">kritik av manifestationen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5359"/>
    <skos:definition xml:lang="fi">Manifestaatio, johon kriittinen arviointi perustuu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som en kritisk bedömning grundar sig på.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10275"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">critique of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kritiikki aineistosta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kritik av materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5949">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ohjaaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">regissör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för den allmänna ledningen av ett filmat framträdande, ett radio- eller tv-program eller dylikt.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10549"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">director corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">regissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m595">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">commentator</skos:altLabel>
    <skos:altLabel xml:lang="fi">kommentaattori (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare som deltar i skapandet av ett uttryck, genom att tolka, analysera eller diskutera ett ämne i en ljudupptagning, en film eller annat audiovisuellt material.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20021"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">commentator agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kommentaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentator</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5950">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5513"/>
    <skos:altLabel xml:lang="fi">teokseen liittyvä ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">uttryck relaterat till verket</skos:altLabel>
    <skos:definition xml:lang="fi">Ekspressio, joka liittyy teokseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som relaterar till ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10308"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">related expression of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teokseen liittyvä versio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">version relaterad till verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5951">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">maskeeraaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">maskör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen vastaamalla elokuvan, musikaalin tai näyttämöteoksen maskeerauksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att svara för maskering i en film, en musikal eller ett sceniskt verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20341"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">makeup artist person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maskeeraaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">maskör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5952">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5962"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5484"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on uusintajulkaisu toista painettua manifestaatiota edustavasta kappaleesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en återpublikation av ett exemplar som representerar en annan tryckt manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40091"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleen uusintapainos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">nytryck av exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reprinted as item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5953">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">färgläggare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen värittäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän liikkuvan kuvan värityksen henkilötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Person som färglagt rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">färgläggare av rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan värittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5954">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen opettaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">lärare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
