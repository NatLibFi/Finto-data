    <skos:prefLabel xml:lang="en">sponsoring person of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen sponsori</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Täcker finansiering av forskning och sponsring av evenemang som är grund för ett verk.</skos:scopeNote>
  </owl:Class>
