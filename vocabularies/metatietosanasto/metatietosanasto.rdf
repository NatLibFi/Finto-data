  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5750">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">distributör (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">jakelija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5619"/>
    <skos:definition xml:lang="sv">Institution som svarar för distributionen av en publicerad manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa julkaistun manifestaation jakelusta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30417"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
