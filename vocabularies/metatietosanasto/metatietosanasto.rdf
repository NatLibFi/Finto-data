    <skos:prefLabel xml:lang="sv">i färg</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">värillinen</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Esimerkiksi kartan värillisyys.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">T.ex. en karta i färg.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1671">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">faksimilavtryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">faksimilejäljennös</skos:altLabel>
    <skos:altLabel xml:lang="sv">faksimiler</skos:altLabel>
    <skos:altLabel xml:lang="sv">faksimiltryck</skos:altLabel>
    <skos:definition xml:lang="sv">Illustrativt innehåll som består av en exakt reproduktion av ett original, vanligen också med samma mått som originalet. Särskilt om böcker, dokument, tryckta bilder och ritningar.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka koostuu originaalin tarkasta jäljennöksestä, yleensä samanmittaisena kuin originaali, erityisesti kirjoista, asiakirjoista, painokuvista ja piirustuksista.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">faksimil</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">faksimile</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: faksimil, xx faksimil.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: faksimileja, xx faksimilea.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1672">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som vanligen består av en- eller flerfärgad dekoration och som är handgjord med målfärg, bläck eller folie.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka koostuu yleensä yksi- tai monivärisestä koristelusta ja joka on tehty käsin maalilla, musteella tai folioiden avulla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">illumination</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">illuminointi</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: illuminationer, xx illuminationer</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: illuminointeja, xx illuminointia</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1673">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som utgörs av märkta områden, i vilka data i viss form inmatas av bestämda personer och för bestämda syften, inkluderar vanligen ifyllningsanvisningar.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka muodostuu merkityistä alueista joihin syötetään määrämuotoista tietoa määriteltyjen henkilöiden toimesta ja määriteltyjä tarkoituksia varten, sisältää yleensä täyttämisohjeet.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blankett</skos:prefLabel>
    <skos:prefLabel xml:lang="en">form</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lomake</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: blanketter, xx blanketter</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: lomakkeita, xx lomaketta</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1682">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">colorist</skos:altLabel>
    <skos:altLabel xml:lang="en">colorist agent</skos:altLabel>
    <skos:altLabel xml:lang="en">colourist</skos:altLabel>
    <skos:altLabel xml:lang="sv">färgläggare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">värittäjä (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5684"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att färglägga ritningar, råkopior, fotografier, kartor, rörliga bilder eller annat innehåll.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, liikkuvia kuvia tai muuta sisältöä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20283"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">colourist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">färgläggare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">värittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1686">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">huvudredaktör (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">päätoimittaja (suhde)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5584"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen vastaavana toimittajana.</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck som ansvarig redaktör.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">huvudredaktör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">päätoimittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m169">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30163"/>
