    <skos:definition xml:lang="sv">Titel för verk, som en ISSN-registreringsbyrå gett.</skos:definition>
    <skos:prefLabel xml:lang="fi">Avainnimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Key title</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Nyckeltitel</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m604">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">landskommun</skos:altLabel>
    <skos:altLabel xml:lang="fi">maalaiskunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">pitäjä</skos:altLabel>
    <skos:altLabel xml:lang="sv">socken</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p10083"/>
    <skos:definition xml:lang="sv">Autonom enhet på lokal nivå av offentlig förvaltning, med eget område och befolkning.</skos:definition>
    <skos:definition xml:lang="fi">Julkishallinnon paikallistason itsehallinnollinen yksikkö, jolla on oma alueensa ja väestönsä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kommun</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kunta</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m358"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4778"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5054"/>
    <skos:scopeNote xml:lang="sv">Används inte om kommuner som är eller har varit städer eller köpingar.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Ei käytetä kunnista, jotka ovat tai ovat olleet kaupunkeja tai kauppaloita.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6040">
