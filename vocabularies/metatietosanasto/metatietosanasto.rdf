    <skos:definition xml:lang="sv">Titel för ett uttryck, som är i enlighet med naturligt språk och ordalydelse i allmänt språkbruk.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6037"/>
