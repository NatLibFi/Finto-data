    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som erbjuder experttjänster och ofta ger rekommendationer åt en aktör, som är upphovsperson till ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10071"/>
