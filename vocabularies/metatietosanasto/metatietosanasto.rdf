    <skos:altLabel xml:lang="sv">bokformgivare</skos:altLabel>
    <skos:altLabel xml:lang="fi">graafinen suunnittelija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">grafisk formgivare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5486"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation valmistamisesta vastaamalla kirjan graafisesta suunnittelusta, taitosta, materiaalien valinnasta ja käytettävistä valmistusmenetelmistä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av en manifestation, genom att ansvara för grafisk formgivning, layout, val av material och tillverkningsmetoder för en bok.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30349"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">book designer person</skos:prefLabel>
