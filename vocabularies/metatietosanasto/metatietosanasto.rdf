    <skos:prefLabel xml:lang="fi">näytelmämusiikki</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skådespelsmusik</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4310">
