    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för de flesta uppgifter som hör till utdelandet av roller och uppgifter för framträdare.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10547"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
