  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m811">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, exemplar som beskriver en apparat eller process och som kan bearbetas i utbildnings- eller analyssyfte för att framhäva en viss del eller funktion.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, laitetta tai prosessia kuvaava kappale, jota voidaan muokata koulutus- tai analyysitarkoituksessa tietyn osan tai toiminnon korostamiseksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1021"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">mallikappale</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mock-up</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">provexemplar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m813">
