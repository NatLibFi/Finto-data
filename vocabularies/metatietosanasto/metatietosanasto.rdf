  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5376">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5801"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5377"/>
    <skos:definition xml:lang="fi">Teos, jolla on kieliyleisö, jota on muutettu teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk med en språklig målgrupp som har ändrats för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10388"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kieliversio teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">language version of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">språkversion av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5377">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5467"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5702"/>
    <skos:definition xml:lang="fi">Teos, jolla on yleisö, jota on muutettu teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk med en målgrupp som har ändrats för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10384"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">muunnos yleisössä teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by audience of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av målgrupp för verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5378">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen laulaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångare (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä musiikissa ääntään käyttämällä, säestyksellä tai ilman, esiintyvä henkilö. Lauluesitys voi sisältää tai olla sisältämättä todellisia sanoja.</skos:definition>
    <skos:definition xml:lang="sv">Person som uppträder i musik som ingår i ett aggregat, genom att använda sin röst, med eller utan ackompanjemang. Sångframförandet kan vara med eller utan riktiga ord.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laulaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5379">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5504"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5474"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen laajennussuunnitelmaa päivittyvästä staattiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra utgivningsplanen för ett verk från integrerande till statisk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10382"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">staattinen versio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">static version</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">statisk version</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5380">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">donator (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">lahjoittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5428"/>
    <skos:definition xml:lang="fi">Kappaleen aiempi omistajayhteisö, joka lahjoittaa sen toiselle omistajalle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Tidigare ägarinstitution till ett exemplar, som donerar det till en annan ägare.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40140"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">donator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">donor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lahjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5381">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen esittelijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">presentatör (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin kuuluvaan sisältöön liittyvää taustatietoa antava yhteisö televisio-ohjelmassa tai elokuvassa.</skos:definition>
    <skos:definition xml:lang="sv">Institution som ger bakgrundsinformation i tv-program eller film, i anslutning till innehåll som hör till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">presentatör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5382">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5383"/>
    <skos:definition xml:lang="sv">Institution som en person grundat.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jonka henkilö on perustanut. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50112"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">founded corporate body of person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">henkilön perustama yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">institution grundad av person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5383">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Institution som är relaterad till en person.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka liittyy henkilöön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50318"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4433"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4438"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4445"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4454"/>
    <skos:prefLabel xml:lang="fi">henkilöön liittyvä yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">institution relaterad till personen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related corporate body of person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5384">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">DJ (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">DJ (person)</skos:altLabel>
    <skos:altLabel xml:lang="sv">discjockey</skos:altLabel>
    <skos:altLabel xml:lang="sv">diskjockey</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen miksaamalla ääniraitoja yhteen yhtäjaksoiseksi raidaksi live-esityksessä tai äänitysstudiossa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck genom att mixa ljudspår till ett sammanhängande spår under ett liveframträdande eller i en inspelningsstudio.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20349"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DJ</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DJ</skos:prefLabel>
    <skos:prefLabel xml:lang="en">DJ person</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske uudelleenmiksauksia, jotka olennaisesti muuttavat alkuperäisen teoksen luonnetta ja sisältöä, mikä johtaa uuteen teokseen, eikä äänitteen useampien raitojen miksaamista ja yhdistelyä. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte remixer som väsentligen ändrar det ursprungliga verkets karaktär och innehåll, vilket leder till ett nytt verk, och inte heller mixning och kombinering av flera spår i en ljudinspelning.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5385">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">julkaisija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">utgivare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5899"/>
    <skos:definition xml:lang="fi">Henkilö, joka julkaisee teoksen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som ger ut ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10456"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">issuing person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">julkaisija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utgivare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5386">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmfotograf (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som spelar in bilder antingen elektroniskt, eller på film eller video, och ofta väljer och arrangerar belysningen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10415"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">director person of photography</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmfotograf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5387">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Institution som relaterar till en släkt.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka liittyy sukuun. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50327"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4441"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4451"/>
    <skos:prefLabel xml:lang="sv">institution relaterad till släkten</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related corporate body of family</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukuun liittyvä yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5388">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmfotograf (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen kuvaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän liikkuvan kuvan joko digitaalisesti, filmille tai videolle tallentava yhteisö. Voi hoitaa myös valaistuksen. Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi.</skos:definition>
    <skos:definition xml:lang="sv">Institution som spelar in rörlig bild som ingår i ett aggregat antingen digitalt, på film eller på video. Kan även sköta belysning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">filmfotograf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5389">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">associated institution</skos:altLabel>
    <skos:altLabel xml:lang="fi">liittyvä yhteisö</skos:altLabel>
    <skos:altLabel xml:lang="sv">relaterad institution</skos:altLabel>
    <skos:definition xml:lang="sv">Institution som relaterar till en institution.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka liittyy yhteisöön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50336"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1333"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4434"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4436"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4437"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4439"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4446"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4447"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4449"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4450"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4452"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4453"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4455"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4456"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4457"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4458"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4459"/>
    <skos:prefLabel xml:lang="sv">institution relaterad till institutionen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related corporate body of corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisöön liittyvä yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5390">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kokoaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sammanställare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5391"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett nytt verk, såsom en bibliografi eller ett register, genom att välja, ordna, sammanställa och redigera data, information eller dylikt.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa uuden teoksen, kuten bibliografian tai hakemiston luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10538"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">compiler corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kokoaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sammanställare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön muokkaamista tai selkeyttämistä eikä teosten tai teosten osien valitsemista ja kokoamista yhteen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omfattar inte redigering eller förtydligande av innehållet i ett verks uttryck, eller val och hopsamling av verk eller del av verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5391">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">aggregaattori (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">aggregerad av (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett aggregerande verk, genom att välja och ordna uttryck av andra verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10542"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">aggregator corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aggregerad av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">koostaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5392">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5873"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5474"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen laajennussuunnitelmaa staattisesta peräkkäiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har skapats genom att ändra utvidgningsplanen för ett verk från statisk till successiv.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10381"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sarjaversio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">serialized version</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">seriell version</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5393">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5269"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m175"/>
    <skos:definition xml:lang="fi">Kokoelmateoksen manifestaatio, joka on toisen kokoelmateoksen manifestaation erillinen osa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation av samlingsverk, som är en separat del av en manifestation av ett samlingsverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30458"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alakokoelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">delsamling</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subcollection</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5394">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">televisiotuottaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-producent (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5817"/>
    <skos:definition xml:lang="fi">Henkilö, joka on tuottaja, joka on vastuussa suurimmasta osasta televisio-ohjelman liiketoiminnasta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en producent, som svarar för största delen av affärsverksamheten kring ett tv-program.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10424"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">television producer person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">televisiotuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-producent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5395">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kappaleen entisöijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator (institution) av exemplar</skos:altLabel>
    <skos:altLabel xml:lang="sv">restauratör av exemplar</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5697"/>
    <skos:definition xml:lang="sv">Institution som svarar för tekniska, redaktionella och kunskapsmässiga åtgärder, vilkas syfte är att återställa ett exemplar i dåligt skick så nära som möjligt dess ursprungliga skick.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka vastaa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä, joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40143"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleen entisöijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konservator av exemplar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restorationist corporate body of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5396">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">painaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5611"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av tryckt text, notmaterial eller något annat innehålls manifestation, med tryckplåt eller dylikt.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa painetun tekstin, nuottiaineiston tai muun sisällön manifestaation valmistamiseen painolaatalta tai -levyltä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30416"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">painaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">printer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Omfattar tillverkning av böcker, dagstidningar, tidskrifter, planscher eller partitur.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää kirjan, sanomalehden, aikakauslehden, julisteen tai partituurin valmistamisen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5397">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5969"/>
    <skos:altLabel xml:lang="fi">aiheena teoksessa (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">behandlat i verket (verk)</skos:altLabel>
    <skos:altLabel xml:lang="en">subject of (work)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5418"/>
    <skos:definition xml:lang="fi">Teos, joka koskee teosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som handlar om ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10264"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aiheena oleva teos teoksessa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">behandlat verk i verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subject work of</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5398">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5838"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3475"/>
    <skos:definition xml:lang="fi">Teos, jolla on numero, joka on omistettu tietylle aiheelle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har ett nummer, som är tillägnat ett visst ämne.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10411"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erikoisnumero teokselle</skos:prefLabel>
    <skos:prefLabel xml:lang="en">special issue of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">specialnummer av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5399">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">televisiotuottaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-producent (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5326"/>
    <skos:definition xml:lang="sv">Institution som är en producent, som svarar för största delen av affärsverksamheten kring ett tv-program.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on tuottaja, joka on vastuussa suurimmasta osasta televisio-ohjelman liiketoiminnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10518"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">television producer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">televisiotuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-producent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5400">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">transkriberare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">transkriboija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5739"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att uppteckna eller skriva ner noter för ett oskrivet eller onoterat innehåll eller ändra dess notationssystem till ett annat.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20477"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">transcriber corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">transkriberare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">transkriboija</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Hit hör inte transkribering av ett musikverk för ett annat instrument eller en annan framförande grupp.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tähän ei kuulu musiikkiteoksen transkribointi eri soittimelle tai esitysryhmälle. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5401">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">julkaisemattoman manifestaation tuottaja</skos:altLabel>
    <skos:altLabel xml:lang="fi">julkaisemattoman manifestaation tuottaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">producent (aktör) för opublicerat material</skos:altLabel>
    <skos:altLabel xml:lang="sv">producent för opublicerad manifestation</skos:altLabel>
    <skos:altLabel xml:lang="en">producer of unpublished manifestation</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5586"/>
    <skos:definition xml:lang="sv">Aktör som svarar för gravering, tillverkning, sammansättning eller annat tillverkningssätt för en opublicerad manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa julkaisemattoman manifestaation kaiverruksesta, valmistuksesta, kokoonpanosta tai muusta valmistustavasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30081"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">julkaisemattoman aineiston tuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">producent för opublicerat material</skos:prefLabel>
    <skos:prefLabel xml:lang="en">producer agent of unpublished manifestation</skos:prefLabel>
  </owl:Class>
