    <skos:definition xml:lang="fi">Liittää manifestaation järjestelmään, jonka mukaan videoaineisto muunnetaan televisiolähetystä varten.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med ett system, enligt vilket videomaterial konverteras för tv-sändning.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1084"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1280"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m239"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m248"/>
