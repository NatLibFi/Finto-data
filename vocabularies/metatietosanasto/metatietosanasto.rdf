  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5514">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">skapare (person) av verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen tekijä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5899"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa teoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10437"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m103"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1161"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1259"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m33"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3565"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3568"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3572"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3579"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m90"/>
    <skos:prefLabel xml:lang="en">creator person of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen tekijä</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar aktörer som gemensamt svarar för skapandet av ett verk, antingen genom att fungera i samma roll som en annan aktör, såsom i samarbete mellan två författare, eller genom att fungera i olika roller, såsom i samarbete mellan en kompositör och en textförfattare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5515">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
