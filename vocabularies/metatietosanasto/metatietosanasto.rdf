  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5871">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kuvanveistäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skulptör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5267"/>
    <skos:definition xml:lang="fi">Henkilö, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en konstnär som svarar för skapandet av ett tredimensionellt verk, genom att modellera, skära eller använda någon liknande teknik.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10427"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
