    <skos:definition xml:lang="fi">Henkilö, joka sponsoroi teosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som sponsrar ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10607"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
