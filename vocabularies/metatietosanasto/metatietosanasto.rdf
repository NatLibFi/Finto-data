    <skos:prefLabel xml:lang="en">contributor corporate body of still image</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">stillkuvaan osallinen yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6017">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">keksijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppfinnare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett nytt redskap eller en ny metod.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa uuden välineen tai menetelmän luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10537"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">inventor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">keksijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppfinnare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6018">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
