    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Bibliografinen koko muodostuu yhdestä tai useammasta lehdestä, jotka ovat kooltaan 1/32 arkista.</skos:definition>
    <skos:definition xml:lang="sv">Bokens format består av ett eller flera blad som till sin storlek är 1/36 av ett tryckark.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/bookFormat/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
