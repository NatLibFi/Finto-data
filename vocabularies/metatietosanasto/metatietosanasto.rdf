    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisältöön toisen teoksen ekspression sisältö on yhdistynyt. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, med vars innehåll ett annat verks uttrycks innehåll har införlivats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20143"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">absorbed by expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">införlivat i versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sulautunut teoksen versioon</skos:prefLabel>
  </owl:Class>
