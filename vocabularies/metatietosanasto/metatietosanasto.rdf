    <skos:altLabel xml:lang="en">editor person of text</skos:altLabel>
    <skos:altLabel xml:lang="sv">redaktör (person)</skos:altLabel>
    <skos:altLabel xml:lang="sv">redaktör (person) för text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstin toimittaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att justera innehåll som skapats av andra aktörer, för att uppfylla utgivnings- och andra bruksstandarder.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20338"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editor person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redaktör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till innehåll hör rörelsenotation, taktil rörelsenotation, taktil musiknotation, taktil text och text.</skos:scopeNote>
  </owl:Class>
