    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ekonomisk union</skos:altLabel>
    <skos:altLabel xml:lang="sv">hemligt sällskap (oregistrerat)</skos:altLabel>
    <skos:altLabel xml:lang="sv">jaktförening (oregistrerad)</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsästysseura (rekisteröimätön)</skos:altLabel>
    <skos:altLabel xml:lang="sv">militärallians</skos:altLabel>
    <skos:altLabel xml:lang="fi">salaseura (rekisteröimätön)</skos:altLabel>
