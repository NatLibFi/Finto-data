    <skos:altLabel xml:lang="en">papermaker</skos:altLabel>
    <skos:altLabel xml:lang="sv">papperstillverkare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5669"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkningen av papper som använts i en manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30215"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">paperinvalmistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">papermaker agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">papperstillverkare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1743">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
