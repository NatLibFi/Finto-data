    <skos:prefLabel xml:lang="sv">omarbetning av versionen</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kattaa sekä teoksen muotoon kohdistuvat muutokset että samassa muodossa kokonaan uudelleenmuokatut teokset. (RDA Registry)</skos:scopeNote>
