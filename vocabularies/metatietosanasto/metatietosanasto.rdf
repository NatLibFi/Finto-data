    <skos:prefLabel xml:lang="sv">analys av materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">analysis of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">analyysi aineistosta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5746">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">moderator (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">moderoija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare som deltar i utförandet av ett uttryck, genom att leda ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter i ämnen som relaterar till diskussionen.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen juontamalla (usein lähetettyä) ohjelmaa, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20491"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">moderator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">moderator corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">moderoija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5747">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljusdesigner (person)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljussättare</skos:altLabel>
    <skos:altLabel xml:lang="fi">valosuunnittelija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen suunnittelemalla ja luomalla valokomponentteja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att planera och skapa ljuskomponenter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20344"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">lighting designer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljusdesigner</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valosuunnittelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5748">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dansare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tanssija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen tanssimalla musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare, som deltar i utförandet av ett uttryck genom att dansa i ett musikaliskt eller dramatiskt framförande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20371"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dancer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dansare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tanssija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5749">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">radio-ohjaaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">radioregissör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5949"/>
    <skos:definition xml:lang="sv">Institution som är en regissör, som svarar för den allmänna ledningen och övervakningen av ett radioprogram.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10513"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">radio director corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">radio-ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">radioregissör</skos:prefLabel>
  </owl:Class>
