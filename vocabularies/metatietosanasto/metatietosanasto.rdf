  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3646">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Hederstitel för manliga regenter (kejsare) i Ryssland, Serbien och Bulgarien.</skos:definition>
    <skos:definition xml:lang="fi">Venäjän, Serbian ja Bulgarian miespuolisten hallitsijoiden (keisarien) arvonimi.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tsaari</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tsar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3647">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Gemål till hertig; kvinna som innehar hertiginnetitel.</skos:definition>
    <skos:definition xml:lang="fi">Herttuan puoliso; nainen jolla on herttuan arvo.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">hertiginna</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">herttuatar</skos:prefLabel>
  </owl:Class>
