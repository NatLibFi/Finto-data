    <skos:prefLabel xml:lang="sv">protokollförare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pöytäkirjan laatija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1301">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5267"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5362"/>
    <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa sarjakuvan kuvallisesta ja/tai kirjallisesta ilmaisusta.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar verk med en person som ansvarar för en series visuella och/eller litterära framställning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sarjakuvantekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">serieskapare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets skapare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1303">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DVD-levy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DVD-skiva</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">(DVD Digital Versatile Disc tai Digital Video Disc) tiedontallennukseen käytettävä optisesti luettava levy, DVD:n yleisimmät käyttötavat ovat videokuvan ja tiedon tallennus (Tietotekniikan termitalkoot, Wikipedia 15.1.2013)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">DVD (Digital Versatile Disc eller Digital Video Disc) är en optiskt läsbar skiva för lagring av data. De vanligaste användningsområden för DVD är video- och datalagring.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1304">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
