    <skos:prefLabel xml:lang="sv">sammanslagen med versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen versioon yhdistyjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4308">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4334"/>
    <skos:altLabel xml:lang="sv">införlivat i uttrycket</skos:altLabel>
