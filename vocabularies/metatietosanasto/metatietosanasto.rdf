  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5915">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen musiikkijohtaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikalisk ledare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä elokuvatuotannossa, musiikki- tai näytelmäesityksessä säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa koordinoiva henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som koordinerar kompositörers, ljudklippares och ljudmixares verksamhet i en filmproduktion eller i ett musikaliskt eller sceniskt uppförande som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">musiikillinen johtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikalisk ledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5916">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5743"/>
