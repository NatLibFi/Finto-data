    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3432"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3434"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3437"/>
