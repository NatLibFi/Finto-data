    <skos:definition xml:lang="sv">Förminskningsgrad för material i mikroform, då förhållandet till den ursprungliga bilden är 16x-30x.</skos:definition>
    <skos:definition xml:lang="fi">Pienennyssuhde mikromuotoiselle aineistolle, kun suhde alkuperäiseen kuvaan on 16x–30x.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAReductionRatio/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">normaali pienennys</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">normal förminskning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">normal reduction</skos:prefLabel>
  </owl:Class>
