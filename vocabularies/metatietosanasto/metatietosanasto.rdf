    <skos:prefLabel xml:lang="fi">romaanimukaelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">romanbearbetning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m3432">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1228"/>
    <skos:altLabel xml:lang="fi">televisiosovitus (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-bearbetning (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m743"/>
