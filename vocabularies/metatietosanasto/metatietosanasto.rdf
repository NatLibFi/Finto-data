  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m370">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">röntgenbild</skos:altLabel>
    <skos:definition xml:lang="sv">Enhet, stillbild som grundar sig på att strålning, t.ex. röntgen-, gamma- eller neutronstrålning, går igenom ett ogenomskinligt objekt.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, stillkuva, joka perustuu säteilyn - esimerkiksi röntgen-, gamma- tai neutronisäteilyn - läpäisyyn läpinäkymättömän kohteen läpi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1032"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">radiograph</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">röntgenfoto</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">röntgenkuva</skos:prefLabel>
  </owl:Class>
