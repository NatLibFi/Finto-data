    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1646"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5775"/>
    <skos:definition xml:lang="sv">Domstol som behandlar ärendekategorier skilt bestämda i lagen.</skos:definition>
    <skos:definition xml:lang="fi">Laissa erikseen määrättyjä asiaryhmiä käsittelevä tuomioistuin (Kielitoimiston sanakirja).</skos:definition>
    <skos:example xml:lang="fi">markkinaoikeus, työtuomioistuin, vakuutusoikeus, valtakunnanoikeus, vesioikeus, maaoikeus</skos:example>
    <skos:example xml:lang="sv">marknadsdomstolen, arbetsdomstolen, försäkringsdomstolen, riksrätten, vattendomstolen, jorddomstolen</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erityistuomioistuin</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">specialdomstol</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4760">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4691"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p16232"/>
    <skos:definition xml:lang="fi">Jonkin hoitamisesta huolehtiva elin (Kielitoimiston sanakirja), jota kutsutaan hoitokunnaksi.</skos:definition>
    <skos:definition xml:lang="sv">Organ som handhar skötseln av något och som benämns förvaltningsnämnd.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förvaltningsnämnd</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">hoitokunta</skos:prefLabel>
  </owl:Class>
