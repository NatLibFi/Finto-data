    <skos:prefLabel xml:lang="fi">Teoksen suhteet manifestaatioon</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Verks relationer till manifestationer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5589">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5692"/>
    <skos:altLabel xml:lang="en">analysed in (work)</skos:altLabel>
    <skos:altLabel xml:lang="sv">analyserad i verket</skos:altLabel>
    <skos:altLabel xml:lang="fi">analysoitu teoksessa</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5371"/>
    <skos:definition xml:lang="fi">Teos, joka kuvaa toisen teoksen rakennetta ja koostumusta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som beskriver ett annat verks struktur och sammansättning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10121"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">analys av verket i</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen analyysi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">work analysed in</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5590">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3578"/>
    <skos:definition xml:lang="sv">Institution som är åtalad i en straffprocess.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on syytettynä rikosprosessissa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10394"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">criminal defendant corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">institution som svarande i brottmål</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisövastaaja rikosoikeudessa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5591">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5455"/>
    <skos:altLabel xml:lang="sv">härlett uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">johdannaisekspressio</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Ekspressio, joka on muunnos saman teoksen toisesta ekspressiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som är en variant av ett annat uttryck av samma verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20575"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1585"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4177"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4215"/>
    <skos:prefLabel xml:lang="en">derivative expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">härledd version</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">johdannaisversio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5592">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">röstskådespelare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ääninäyttelijä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5793"/>
    <skos:definition xml:lang="sv">Institution som är en skådespelare, som deltar i utförandet av ett uttryck, genom att ge röst åt karaktärer i radio- och ljudproduktioner och animerade karaktärer i filmverk, samt genom att framträda i radio- och tv-reklarm, i dubbade uttryck etc.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on näyttelijä, joka osallistuu ekspression tekemiseen antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20502"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">röstskådespelare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">voice actor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääninäyttelijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5593">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bokbindare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sitoja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5285"/>
    <skos:definition xml:lang="fi">Henkilö, joka sitoo kappaleen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som binder ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40098"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">binder person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">bokbindare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sitoja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5594">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">historieberättare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tarinankertoja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare, som deltar i utförandet av ett uttryck genom att framföra en berättelse med en dramatisk eller teatralisk tolkning.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen kertomalla tarinan draamallisella tai teatraalisella tulkinnalla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20497"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">historieberättare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">storyteller corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tarinankertoja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5595">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">intervjuobjekt (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen haastateltava (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvään liikkuvan kuvan aineistoon tietoja keräävälle haastattelijalle (tavallisesti toimittaja tai mielipidemittauksen tekijä) vastauksia antava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som ger svar åt en intervjuare (vanligen en journalist eller opinionsmätare), som samlar information till material med rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastateltava</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuobjekt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5596">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5484"/>
    <skos:altLabel xml:lang="en">reproduction of (item)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5690"/>
    <skos:definition xml:lang="sv">Exemplar som har använts som grund för reproduktion.</skos:definition>
    <skos:definition xml:lang="fi">Kappale, jota on käytetty jäljentämisen pohjana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30303"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jäljenne kappaleesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reproduction of item of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">reproduktion av exemplaret</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5597">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4812"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5292"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5366"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5465"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5515"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5888"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5961"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5998"/>
    <skos:prefLabel xml:lang="fi">Teoksen suhteet kappaleeseen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Verks relationer till exemplar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5598">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kostymör (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen puvustaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän elokuvan, musiikki- tai näytelmäesityksen puvustuksen suunnitellut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som planerat kostymdesignen i en film, ett musikaliskt eller sceniskt framförande, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kostymör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puvustaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5599">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">gravör (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaivertaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5563"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av en manifestation, genom att gravera bokstäver, mönster eller andra tecken på en yta som används vid tryck, såsom en trä- eller metallyta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30350"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">engraver person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">gravör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kaivertaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5600">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">granskare av lärdomsprov (institution) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen opinnäytteen tarkastaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän opinnäytteen tarkastajaryhmän yhteisöjäsen.</skos:definition>
    <skos:definition xml:lang="sv">Institutionsmedlem i granskningsgrupp för lärdomsprov som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">granskare av lärdomsprov</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opinnäytteen tarkastaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5601">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5782"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5728"/>
    <skos:definition xml:lang="fi">Manifestaatio, jossa on metatietoteoksessa käytettäviä tietoja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som innehåller uppgifter som används i ett metadataverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10406"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">konsulterad källa</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">käytetty lähde</skos:prefLabel>
    <skos:prefLabel xml:lang="en">source consulted</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5602">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvan jakelija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmdistributör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5750"/>
    <skos:definition xml:lang="sv">Institution som svarar för distributionen av en film eller annan dylik manifestation till biografer eller andra distributionskanaler.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30406"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvan jakelija</skos:prefLabel>
    <skos:prefLabel xml:lang="en">film distributor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmdistributör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5603">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">framförande institution som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen esittäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä esityksessä näyttelevä, tanssiva, musiikkia esittävä tai muussa roolissa esiintyvä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som uppträder med skådespel, dans, musik eller något annat, i en föreställning som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framförande institution</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5604">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5863"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation lähettämisestä yleisölle radiossa, televisiossa, suoratoistolähetyksenä tai muuna lähetysmediana. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för sändning av en manifestation för en publik i radio, television, som direktsändning eller i något annat sändningsmedium.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30347"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">broadcaster person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lähetyksestä vastaava henkilö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sändningsansvarig person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5605">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka sisältyy merkintään "X esittää:" ekspression sisältävän manifestaation alku- tai lopputeksteissä ja joka liittyy todennäköisesti liikkuvan kuvan teoksen ekspression tuotantoon, rahoitukseen tai jakeluun jollakin tavoin. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som ingår i texten "X presenterar:" i för- och eftertexter i en manifestation som innehåller ett uttryck, och som troligtvis på något vis relaterar till produktion, finansiering eller distribution av ett uttryck för rörlig bild.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20388"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ansvarig person för framförande</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">esittämisestä vastaava henkilö</skos:prefLabel>
    <skos:prefLabel xml:lang="en">presenter person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5606">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">grundare (institution) av verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen perustaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för igångsättningen av ett diakroniskt verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa diakronisen teoksen alullepanosta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10546"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">founder corporate body of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">grundare av verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen perustaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5607">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">skapare (institution) av verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen tekijä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5574"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa teoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10531"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1335"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m253"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m352"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3561"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3570"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3575"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3578"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4461"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4590"/>
    <skos:prefLabel xml:lang="en">creator corporate body of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen tekijä</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar aktörer som gemensamt svarar för skapandet av ett verk, antingen genom att fungera i samma roll som en annan aktör, såsom i samarbete mellan två författare, eller genom att fungera i olika roller, såsom i samarbete mellan en kompositör och en textförfattare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5608">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen puhuja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">talare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä liikkuvassa kuvassa puhuva henkilö. Esimerkiksi luennon tai puheen pitäjä.</skos:definition>
    <skos:definition xml:lang="sv">Person som talar i rörlig bild som ingår i ett aggregat. Till exempel föredrags- eller talhållare.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan puhuja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">talare i rörlig bild</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5609">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen juontaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programledare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää ohjelmaa juontava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som leder ett program som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">juontaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5610">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5745"/>
    <skos:altLabel xml:lang="sv">analys av manifestationen i</skos:altLabel>
    <skos:altLabel xml:lang="en">analysed in (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation analyysi</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5650"/>
    <skos:definition xml:lang="fi">Teos, joka kuvaa manifestaation rakennetta ja luonnetta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som beskriver en manifestations struktur och karaktär.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30255"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston analyysi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">analys av materialet i</skos:prefLabel>
    <skos:prefLabel xml:lang="en">manifestation analysed in</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5611">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">tillverkare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">valmistaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5323"/>
    <skos:definition xml:lang="sv">Institution som svarar för tryckningen, mångfaldigandet, gjutandet av typer eller något annat framställningssätt för en utgiven manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa julkaistun manifestaation painamisesta, monistamisesta, kirjasinten valamisesta tai muusta valmistustavasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30419"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">manufacturer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tillverkare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valmistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5612">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">illustrator</skos:altLabel>
    <skos:altLabel xml:lang="en">photographer (expression)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5439"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen toimija, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Aktör som bidragit till ett aggregat och skapat ett uttryck av ett stillbildsverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30321"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till stillbild</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent of still image</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">stillkuvaan osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5613">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">radio-ohjaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">radioregissör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5729"/>
    <skos:definition xml:lang="fi">Henkilö, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en regissör, som svarar för den allmänna ledningen och övervakningen av ett radioprogram.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10419"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">radio director person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">radio-ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">radioregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5614">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">libretisti (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">librettist (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5362"/>
    <skos:definition xml:lang="fi">Henkilö, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är författare till texten i ett musikaliskt eller koreografiskt verk, såsom en opera, en balett eller något annat musikaliskt sceniskt verk eller oratorium.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10431"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">libretisti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">librettist</skos:prefLabel>
    <skos:prefLabel xml:lang="en">librettist person</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte författare till texter i enbart musikalsånger.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5615">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvan musiikin säveltäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kompositör (institution) av filmmusik</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5350"/>
    <skos:definition xml:lang="en">A corporate body who is responsible for creating a motion picture music work that complements a musical work.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av musik som kompletterar en film.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa elokuvaa täydentävän musiikin luomisesta.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer corporate body of motion picture music work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">elokuvan musiikin säveltäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör av filmmusik</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5616">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5670"/>
    <skos:definition xml:lang="fi">Metatietoteoksen kuvailema henkilö. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som ett metadataverk beskriver.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10614"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">metadata description of person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">metadatabeskrivning av personen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">metatietokuvailu henkilöstä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5617">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kääntäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">översättare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5693"/>
    <skos:definition xml:lang="sv">Institution som deltar i skapandet av ett uttryck, genom att uttrycka ett verks språkliga innehåll på ett språk som avviker från ett originalverks tidigare uttryck.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20464"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kääntäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">translator corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">översättare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En översättare kan också översätta språkligt innehåll mellan olika former av samma språk från olika tidsperioder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5618">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Släkt som är relaterad till en person.</skos:definition>
    <skos:definition xml:lang="fi">Suku, joka liittyy henkilöön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50317"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4424"/>
    <skos:prefLabel xml:lang="fi">henkilöön liittyvä suku</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related family of person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släkt relaterad till personen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5619">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">institution relaterad till manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaatioon liittyvä yhteisö</skos:altLabel>
    <skos:definition xml:lang="sv">Institution som relaterar till en manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka liittyy manifestaatioon. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30270"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5098"/>
    <skos:prefLabel xml:lang="fi">aineistoon liittyvä yhteisö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">institution relaterad till materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related corporate body of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5620">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5315"/>
    <skos:altLabel xml:lang="fi">manifestaatioon sisältyvä ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">uttryck som ingår i manifestation</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5696"/>
    <skos:definition xml:lang="fi">Ekspressio, joka sisältyy manifestaatioon. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som ingår i en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30139"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">expression manifested</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">innehåller (uttryck)</skos:prefLabel>
