    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasStepParent"/>
    <skos:definition xml:lang="sv">Man med vilken en beskriven persons biologiska förälder är i äktenskap eller samboförhållande.</skos:definition>
    <skos:definition xml:lang="fi">Mies, jonka kanssa kuvailtavan henkilön biologinen vanhempi on avio- tai avoliitossa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has stepfather</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">isäpuoli</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">styvfar</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4623"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4644">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
