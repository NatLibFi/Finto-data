    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m743"/>
    <skos:definition xml:lang="fi">Teos, joka on draamateos, joka on sovitettu toisesta teoksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett dramaverk, som omarbetats från ett annat verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dramatisering</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">dramatisointi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">dramatized as work</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2295">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
