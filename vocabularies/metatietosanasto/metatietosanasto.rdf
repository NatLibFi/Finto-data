    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">Waveform Audio File</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">WAV</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">WAV</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Kodningsformat för ljud, filändelse .wav, .wave</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänen koodausmuoto, tiedostopääte .wav, .wave</skos:scopeNote>
  </owl:Class>
