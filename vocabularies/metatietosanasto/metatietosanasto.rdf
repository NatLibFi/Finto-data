    <skos:definition xml:lang="sv">Uttryck som har undersökts eller evaluerats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10279"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">arviointi versiosta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">evaluation of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">evaluering av versionen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5519">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">erikoistehosteiden tekijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare av specialeffekter (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av uttryck av rörlig bild eller ljudverk, genom att planera eller skapa specialeffekter som sker under inspelning, såsom mekaniska effekter och optiska effekter skapade med kamera.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu liikkuvan kuvan tai ääniteoksen ekspression tekemiseen suunnittelemalla ja luomalla taltioinnin aikana tapahtuvat erikoistehosteet, kuten mekaaniset tehosteet ja kameralla toteutettavat optiset tehosteet. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20478"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erikoistehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av specialeffekter</skos:prefLabel>
    <skos:prefLabel xml:lang="en">special effects provider corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m552">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">author</skos:altLabel>
    <skos:altLabel xml:lang="sv">författare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjoittaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett textverk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa tekstiteoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10061"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1762"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m322"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m384"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m79"/>
    <skos:prefLabel xml:lang="en">author agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjoittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar skapandet av ett nytt verk genom att omarbeta, redigera eller arrangera ett verk av en annan upphovsperson, såvida ändringen väsentligen har ändrat originalets karaktär och innehåll eller uttrycksform.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5520">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5635"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m783"/>
    <skos:definition xml:lang="fi">Teos, jota täydentää teos, joka toteutuu äänenä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som kompletteras av ett verk, som förverkligas som ljud.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10376"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljud till verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sounds for work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääni teokseen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5521">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmskapare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen elokuvantekijä (henkilö)</skos:altLabel>
