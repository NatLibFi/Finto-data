    <skos:altLabel xml:lang="sv">sändningsansvarig</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m64"/>
    <skos:definition xml:lang="sv">Aktör som svarar för sändning av en manifestation för en publik i radio, television, som direktsändning eller i något annat sändningsmedium.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation lähettämisestä yleisölle radiossa, televisiossa, suoratoistolähetyksenä tai muuna lähetysmediana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30067"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">broadcaster agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lähetyksestä vastaava toimija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sändningsansvarig aktör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1751">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">painolaatan valmistaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">platemaker</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckplåtstillverkare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5586"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkningen av en manifestation, genom att tillverka tryckplåtar eller dylikt, för användning vid tillverkningen av tryckta bilder eller texter.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation valmistamisesta valmistamalla painettujen kuvien tai tekstin valmistuksessa käytettäviä painolaattoja tai -levyjä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30075"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1753"/>
    <skos:prefLabel xml:lang="fi">painolaatan valmistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">platemaker agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckplåtstillverkare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1752">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bokformgivare</skos:altLabel>
    <skos:altLabel xml:lang="en">book designer</skos:altLabel>
    <skos:altLabel xml:lang="fi">graafinen suunnittelija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">grafisk formgivare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5586"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkningen av en manifestation, genom att ansvara för grafisk formgivning, layout, val av material och tillverkningsmetoder för en bok.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation valmistamisesta vastaamalla kirjan graafisesta suunnittelusta, taitosta, materiaalien valinnasta ja käytettävistä valmistusmenetelmistä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30069"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">book designer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">graafinen suunnittelija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">grafisk formgivare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1753">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">collotyper</skos:altLabel>
    <skos:altLabel xml:lang="en">collotypist agent</skos:altLabel>
    <skos:altLabel xml:lang="sv">framställare av ljustryck (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kollotypian valmistaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1751"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkning av en manifestation, genom att göra fotografiska avtryck direkt från härdad gelatinfilm eller annat material med bläckmottagande och bläckavvisande ytor.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation valmistamisesta tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30077"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">collotyper agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framställare av ljustryck</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kollotypian valmistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1755">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">boktryckare</skos:altLabel>
    <skos:altLabel xml:lang="sv">boktryckare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjanpainaja</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjanpainaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">painaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">printer</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m148"/>
    <skos:definition xml:lang="sv">Aktör som deltar i tillverkningen av tryckt text, notmaterial eller någon annan manifestation, med tryckplåt eller dylikt.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu painetun tekstin, nuottiaineiston tai muun manifestaation valmistamiseen painolaatalta tai -levyltä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30078"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">painaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">printer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Omfattar tillverkning av böcker, dagstidningar, tidskrifter, planscher eller partitur.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää kirjan, sanomalehden, aikakauslehden, julisteen tai partituurin valmistamisen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1756">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvan jakelija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">film distributor</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmdistributör (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m889"/>
    <skos:definition xml:lang="sv">Aktör som svarar för distributionen av en film eller annan dylik manifestation till biografer eller andra distributionskanaler.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30068"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvan jakelija</skos:prefLabel>
    <skos:prefLabel xml:lang="en">film distributor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmdistributör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1757">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dedikationsförfattare (i exemplar)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5285"/>
    <skos:definition xml:lang="fi">Henkilö, joka kirjoittaa kappaleeseen omistuskirjoituksen tai merkinnön lahjoituksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som i ett exemplar skriver in en dedikation eller gåvoanteckning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40014"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dedikationsskrift av</skos:prefLabel>
    <skos:prefLabel xml:lang="en">inscriber</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">omistuskirjoituksen kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1758">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">annotator</skos:altLabel>
    <skos:altLabel xml:lang="sv">författare till anmärkning</skos:altLabel>
    <skos:altLabel xml:lang="fi">huomautuksen kirjoittaja</skos:altLabel>
    <skos:altLabel xml:lang="fi">huomautuksen tekijä</skos:altLabel>
    <skos:altLabel xml:lang="fi">huomautusten kirjoittaja</skos:altLabel>
    <skos:altLabel xml:lang="fi">huomautusten tekijä</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5285"/>
    <skos:definition xml:lang="fi">Henkilö, joka kirjoittaa käsin lisähuomautuksia tai muita selityksiä kappaleeseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som skriver tilläggsanmärkningar eller andra förklaringar för hand i ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">annotator</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare till annotation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lisähuomautusten kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1759">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">entisöijä (kappale)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kappaleen entisöijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator (aktör) av exemplar</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator (exemplar)</skos:altLabel>
    <skos:altLabel xml:lang="sv">restauratör av exemplar</skos:altLabel>
    <skos:altLabel xml:lang="en">restorationist (item)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5347"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tekniska, redaktionella och kunskapsmässiga åtgärder, vilkas syfte är att återställa ett exemplar i dåligt skick så nära som möjligt dess ursprungliga skick.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka vastaa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä, joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40024"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleen entisöijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konservator av exemplar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restorationist agent of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m176">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m83"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/w/P10217"/>
    <skos:definition xml:lang="fi">Kohderyhmä tarkoittaa käyttäjäryhmää, jolle aineiston sisältö on tarkoitettu tai jolle sisällön on katsottu sopivan, kuten tiettyä ikäryhmää (esim. lapset, nuoret, aikuiset), opiskelutasoa (esim. peruskoulu, lukio), esteellisyyttä (esim. näkörajoitteiset) tai muuta ryhmittelyä.</skos:definition>
    <skos:definition xml:lang="sv">Målgrupp avser den användargrupp som resursen riktar sig till eller för vilken resursen ansetts lämplig, såsom en viss åldersgrupp (t.ex. barn, unga, vuxna), utbildningsnivå (t.ex. grundskola, gymnasium) funktionsvariation (t.ex. synskadade) eller annan gruppindelning.</skos:definition>
    <skos:prefLabel xml:lang="en">Intended audience</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kohderyhmä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Målgrupp</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1760">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">dedicator</skos:altLabel>
    <skos:altLabel xml:lang="sv">dedikationsförfattare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">författare till dedikation</skos:altLabel>
    <skos:altLabel xml:lang="fi">omistuksen tekijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen omistanut</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen omistuskirjoituksen tekijä</skos:altLabel>
    <skos:altLabel xml:lang="sv">verket dedicerat av</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som tillägnar ett verk till en aktör som utgjort inspiration eller stöd.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka nimittää teoksen sitä innoittaineen tai tukeneen toimijan tunnustukseksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10048"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dedicator agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dedikationsförfattare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">omistuksen tekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1761">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression entisöijä</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression entisöijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator av uttryck</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator av uttryck (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator av version</skos:altLabel>
    <skos:altLabel xml:lang="sv">restauratör av version</skos:altLabel>
    <skos:altLabel xml:lang="en">restorationist (expression)</skos:altLabel>
    <skos:altLabel xml:lang="fi">version entisöijä</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5705"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att restaurera eller förena tidigare uttryck som kan vara skadade eller fragmentariska, för att skapa ett nytt uttryck.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20289"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">entisöijä (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konservator (uttryck)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restorationist agent of expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1762">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kokouksen raportoija</skos:altLabel>
    <skos:altLabel xml:lang="fi">kokousten raportoija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">mötesrapportör (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">rapporteur</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m552"/>
    <skos:definition xml:lang="sv">Aktör som är en författare, som fått i uppgift av en organisation att rapportera om mötesförfaranden.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10255"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kokousten raportoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mötesrapportör</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rapporteur agent</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omfattar inte ansvar som är begränsat till protokollföring.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1765">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">dedicatee (item)</skos:altLabel>
    <skos:altLabel xml:lang="sv">dedikationsmottagare</skos:altLabel>
    <skos:altLabel xml:lang="sv">exemplaret dedicerat till (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kappale omistettu</skos:altLabel>
    <skos:altLabel xml:lang="fi">kappaleen omistuksen kohde (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5810"/>
    <skos:definition xml:lang="sv">Aktör som ett exemplar är tillägnat.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jolle kappale on omistettu. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40025"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dedicatee agent of item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">exemplaret dedicerat till</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleen omistuksen kohde</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1767">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">illuminator</skos:altLabel>
    <skos:altLabel xml:lang="sv">illuminatör</skos:altLabel>
    <skos:altLabel xml:lang="fi">illuminoinnin tekijä (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5347"/>
    <skos:definition xml:lang="sv">Aktör som dekorerar ett enskilt exemplar genom att använda ädelmetaller eller färger, ofta i detaljerade mönster eller motiv.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka koristelee yksittäisen kappaleen käyttäen jalometalleja tai värejä, usein yksityiskohtaisissa kuvioissa tai motiiveissa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">illuminator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">illuminator agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">illuminoinnin tekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1768">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">current owner</skos:altLabel>
    <skos:altLabel xml:lang="sv">nuvarande ägare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">nykyinen omistaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ägare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4467"/>
    <skos:definition xml:lang="sv">Aktör som för tillfället juridiskt äger ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka tällä hetkellä laillisesti omistaa kappaleen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40018"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3583"/>
    <skos:prefLabel xml:lang="en">current owner agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">nuvarande ägare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">nykyinen omistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1769">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">donator (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">donor</skos:altLabel>
    <skos:altLabel xml:lang="fi">lahjoittaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1743"/>
    <skos:definition xml:lang="fi">Kappaleen aiempi omistaja, joka lahjoittaa kappaleen toiselle omistajalle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Tidigare ägare till ett exemplar, som donerar ett exemplar till en annan ägare.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">donator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">donor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lahjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1771">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">binder</skos:altLabel>
    <skos:altLabel xml:lang="sv">bokbindare (aktör)</skos:altLabel>
