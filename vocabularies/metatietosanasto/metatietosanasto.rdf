    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30047"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4288"/>
    <skos:prefLabel xml:lang="en">facsimile of manifestation of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">faksimil av manifestationen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">näköispainos manifestaatiosta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4267">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">spegelsajt</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4314"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on verkkosivuston tarkka kopio ja jota käytetään parantamaan alkuperäisen sivuston saavutettavuutta vähentämällä verkkoliikenteen kuormitusta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en precis kopia av en webbplats och som används för att förbättra tillgängligheten till en ursprunglig sida, genom att minska nättrafikens belastning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30028"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">mirror site</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">peilisivusto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">spegelsida</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4268">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4264"/>
