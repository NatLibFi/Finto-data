  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1436">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Illustrativt innehåll som utgörs av en bild som uppstår från ljus som träffar på ljuskänsligt material, vanligen fotografisk film eller i något elektroniskt lagringsmedium.</skos:definition>
    <skos:definition xml:lang="fi">Kuvasisältö, joka muodostuu valoherkälle pinnalle, tavallisesti valokuvafilmille tai elektroniseen tallennusvälineeseen, osuvan valon muodostamasta kuvasta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/IllusContent/1010"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fotografi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">photograph</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valokuva</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: fotografier, xx fotografier</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: valokuvia, xx valokuvaa</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1438">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">iBooks</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">iBooks</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m144">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fingers. (fingersättning av)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sorm. (sormutuksen tekijä)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen lisäämällä sormitukset notatoituun musiikkiin.</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck genom att lägga till fingersättningar för noterad musik.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fingersättning av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sormituksen tekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1440">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll uttryckt som tvådimensionell rörlig bild. T.ex. tvådimensionella filmer (spelfilmer eller tecknade filmer) och filminspelningar av framträdanden, händelser o.s.v. Även ljud kan anslutas till den rörliga bilden. Se även &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1356'&gt;kartografisk rörlig bild&lt;/a&gt;.</skos:definition>
    <skos:definition xml:lang="fi">Kaksiulotteisena liikkuvana kuvana esitetty sisältö. Esimerkiksi kaksiulotteiset elokuvat (näytellyt tai piirretyt), esitysten ja tapahtumien jne. filmi- ja videotallenteet. Liikkuvaan kuvaan voi liittyä ääntä.
Katso myös &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m1356'&gt;kartografinen liikkuva kuva&lt;/a&gt;.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1023"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kaksiulotteinen liikkuva kuva</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tvådimensionell rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="en">two-dimensional moving image</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1443">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3521"/>
    <skos:altLabel xml:lang="sv">kompletterande del till verket</skos:altLabel>
