    <skos:prefLabel xml:lang="fi">Ekspression nimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Title of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Uttryckstitel</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6039">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1568"/>
