    <skos:altLabel xml:lang="sv">kadettskola</skos:altLabel>
    <skos:altLabel xml:lang="fi">maanpuolustuskorkeakoulu</skos:altLabel>
    <skos:altLabel xml:lang="fi">maanpuolustusopisto</skos:altLabel>
