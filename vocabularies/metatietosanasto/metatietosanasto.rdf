    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5489"/>
    <skos:definition xml:lang="sv">Författare till text tillagd i ett musikverk.</skos:definition>
    <skos:definition xml:lang="fi">Musiikkiteokseen lisättyjen sanojen kirjoittaja.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">författare till tillagd sångtext</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lisätyn sanoituksen kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6069">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bearbetare till lättläst (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">selkomukauttaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5445"/>
    <skos:definition xml:lang="fi">Henkilö, joka mukauttaa alunperin yleiskielellä olleen tekstin selkokielelle.</skos:definition>
    <skos:definition xml:lang="sv">Person som bearbetar en text som ursprungligen varit allmänspråklig till lättläst.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bearbetare till lättläst</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">selkomukauttaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6070">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bearbetare till lättläst (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">selkomukauttaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5693"/>
    <skos:definition xml:lang="sv">Institution som bearbetar en text som ursprungligen varit allmänspråklig till lättläst.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka mukauttaa alunperin yleiskielellä olleen tekstin selkokielelle.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bearbetare till lättläst</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">selkomukauttaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6071">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">casting director</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">rollsättare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">roolittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6072">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Attribut till version för ett uttryck som är en förenklad bearbetning av ett musikverk, gjord för den ursprungliga musikaliska besättningen.</skos:definition>
    <skos:definition xml:lang="fi">Version määrite ekspressiolle, joka on musiikkiteoksen alkuperäiselle esityskokoonpanolle tehty yksinkertaistettu sovitus.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förenklad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yksinkertaistettu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6073">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m261"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/e/P20572"/>
    <skos:definition xml:lang="sv">Ord eller uttryck, tecken eller ord- eller teckengrupp, som särskiljer ett uttryck från ett annat uttryck av samma verk.</skos:definition>
    <skos:definition xml:lang="fi">Sana tai ilmaus, merkki tai sana- tai merkkiryhmä, joka erottaa ekspression toisesta saman teoksen ekspressiosta.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6072"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6074"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6075"/>
    <skos:prefLabel xml:lang="sv">Attribut till version</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Designation of version</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Version määrite</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6074">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Attribut till version för ett uttryck som är en bearbetning av ett musikverk.</skos:definition>
    <skos:definition xml:lang="fi">Version määrite ekspressiolle, joka on musiikkiteoksen sovitus.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bearbetad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovitettu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m6075">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Attribut till version för ett uttryck som består av utkast till ett eller flera musikverk av en kompositör.</skos:definition>
    <skos:definition xml:lang="fi">Version määrite ekspressiolle, joka koostuu säveltäjän yhden tai useamman musiikkiteoksen luonnoksista.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">luonnoksia</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utkast</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m608">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m175"/>
    <skos:altLabel xml:lang="en">contained in (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">del av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="sv">ingår i manifestation</skos:altLabel>
    <skos:altLabel xml:lang="fi">osa manifestaatiota</skos:altLabel>
    <skos:altLabel xml:lang="fi">sisältyy manifestaatioon</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5856"/>
    <skos:definition xml:lang="sv">En manifestation i vilken en ingående manifestation är en oberoende del av en annan manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaatio, johon sisältyvä manifestaatio on itsenäinen osa toisesta manifestaatiosta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30020"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m279"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4264"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4332"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5269"/>
    <skos:prefLabel xml:lang="sv">del av materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">osa aineistoa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">part of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m61">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4979"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/c/C10003"/>
    <skos:definition xml:lang="sv">Ett enskilt förverkligande av en manifestation (t.ex. enskild CD-ljudksiva, en bok i ett biblioteks samlingar)</skos:definition>
    <skos:definition xml:lang="fi">Yksittäinen manifestaation toteutuma (esim. yksittäinen CD-äänilevy, kirja kirjaston kokoelmissa).</skos:definition>
    <skos:prefLabel xml:lang="sv">Exemplar</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Item</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kappale</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m610">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, stillbild bestående av tvärprojektion, detalj, diagram, vertikalprojektion, perspektiv, planritning, arbetsritning o.s.v. Används inom byggbranschen och andra tekniska sammanhang.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, liikkumaton kuva, joka muodostuu poikkileikkauksesta, yksityiskohdista, kaavioista, julkisivupiirustuksesta, perspektiivistä, pohjapiirroksesta, työpiirustuksesta tms. Käytetään rakentamisessa ja muissa teknisissä yhteyksissä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1038"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">technical drawing</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekninen piirustus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">teknisk ritning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m613">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3431"/>
    <skos:altLabel xml:lang="fi">romaanimukaelman perustana</skos:altLabel>
    <skos:altLabel xml:lang="fi">romaanimukaelman perustana (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">romanbearbetning baserad på</skos:altLabel>
    <skos:altLabel xml:lang="sv">romanbearbetning baserad på (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1399"/>
    <skos:definition xml:lang="fi">Teos, joka on sovitettu romaaniksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har bearbetats till en roman.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10130"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">novelization of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">romaanimukaelma teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">romanbearbetning av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m614">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Ohut ja litteä kasvikuidusta sekä eläinperäisistä, mineraalipohjaisista tai synteettisistä täyteaineista tehdystä massasta puristamalla valmistettu materiaali.</skos:definition>
    <skos:definition xml:lang="sv">Tunt och platt material, som tillverkats genom att pressa massa bestående av växtfibrer och animaliska, mineralbaserade eller syntetiska fyllnadsmedel.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1025"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">paper</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">paperi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">papper</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m617">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet bestående av tvådimensionell bild eller mycket låg relief. Framställs genom att limma samman papper, tyg, fotografier eller andra material på en jämn yta.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, koostuu kaksiulotteisesta tai hyvin matalasta kohokuvasta, joka on tehty liimaamalla yhteen paperia, kangasta, valokuvia tai muita materiaaleja tasaiselle pinnalle.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">collage</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">collage</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kollaasi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m619">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">multiduk</skos:altLabel>
    <skos:definition xml:lang="fi">Elokuvafilmin esitysformaatti, joka käyttää useampia kankaita.</skos:definition>
    <skos:definition xml:lang="sv">Visningsformat för film, som använder flera filmdukar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/presFormat/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">monikangas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">multiscreen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">multiscreen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m621">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">3 3/4 tum/s</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">3 3/4 tuumaa/s</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m622">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, tredimensionell fysisk uttrycksform, vanligen för konst, i vilken bild och form är gjorda som reliefbild (ytrelief eller infälld relief) eller som en form som kan betraktas från alla håll.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kolmiulotteinen fyysinen yleensä taiteen ilmaisumuoto jossa kuva ja muoto on tehty kohokuvana (pintareliefi tai upotettu reliefi) tai joka puolelta katsottavana muotona.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1034"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">skulptur</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">veistos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m624">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kasetti, joka sisältää silmukkamaisen ääninauhan.</skos:definition>
    <skos:definition xml:lang="sv">Magasin som innehåller ljudband.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio cartridge</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudmagasin</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänisilmukkakasetti</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m627">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Elämänmuodon, taloudellisten tai aatteellisten päämäärien tms. perusteella kokonaisuuden muodostava ihmisryhmä tai yhteenliittymä. Perhe, suku, kansa, ammattikunta, urheiluseura ym. yhteisöt. Taloudellinen, aatteellinen yhteisö. Kansainvälinen yhteisö. Euroopan yhteisö, yhteisöt (lyhenne: EY). Perhe-, kaupunki-, kyläyhteisö. Pienyhteisö. Kieli-, tiede-, työyhteisö (Kielitoimiston sanakirja). Eroaa yhdistyksestä parhaiten uskonnollisten yhteisöjen kohdalla. Termiä käytetään, kun tarkempaa soveltuvaa termiä ei löydy.</skos:definition>
    <skos:definition xml:lang="sv">Grupp av människor eller sammanslutning som bildar en helhet utgående från levnadssätt, ekonomiska eller ideella mål e.d. Familj, släkt, folk, yrkeskår, idrottsförening m.fl. samfund. Ekonomiskt, ideellt samfund. Internationellt samfund. Europeiska gemenskapen, gemenskaperna (förkortning: EG). Familje-, stads-, bysamfund. Småsamfund. Språk-, vetenskaps-, arbetssamfund. Termen används då ingen mer specifik lämplig term finns.</skos:definition>
    <skos:example xml:lang="sv">Concordia (institution)</skos:example>
    <skos:example xml:lang="fi">Concordia (yhteisö)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">institution</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m630">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Material som består av kiseldioxid (silikat) och basiska oxider.</skos:definition>
    <skos:definition xml:lang="fi">Piidioksidista (silikaatista) ja emäksisistä oksideista muodostuva materiaali.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">glas</skos:prefLabel>
    <skos:prefLabel xml:lang="en">glass</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lasi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m631">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1303"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DVD-ROM-levy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DVD-ROM-skiva</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m633">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">lausuja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="sv">recit. (recitatör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">recitatör (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Kaunokirjallisen lyriikan esittäjä.</skos:definition>
    <skos:definition xml:lang="sv">Uppläsare av skönlitterär lyrik.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">lausuja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">recitatör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m634">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Produktionsmetod för material som grundar sig på känselsinnet, i vilken fasta punkter i plast värmelimmas på ett tunt och hållbart pappers yta.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä tuntoaistiin perustuvalle aineistolle, jossa ohuen ja kestävän paperin pintaan lämpöliimataan kiinteitä muovisia pisteitä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1019"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">solid dot</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">solid dot -painatus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">solid dot-tryckning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m637">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Bibliografinen koko muodostuu yhdestä tai useammasta lehdestä, jotka ovat kooltaan 1/16 arkista.</skos:definition>
    <skos:definition xml:lang="sv">Bokens format består av ett eller flera blad som till sin storlek är 1/16 av ett tryckark.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/bookFormat/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">16:o</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">16:o</skos:prefLabel>
    <skos:prefLabel xml:lang="en">16mo</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m64">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förlag</skos:altLabel>
    <skos:altLabel xml:lang="sv">förläggare</skos:altLabel>
    <skos:altLabel xml:lang="fi">kustantaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kustantaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">publisher</skos:altLabel>
    <skos:altLabel xml:lang="sv">utgivare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">utgivare (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5586"/>
    <skos:definition xml:lang="sv">Aktör som svarar för förläggande, utgivning eller utkommande av en publicerad manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa julkaistun manifestaation kustantamisesta, julkaisemisesta tai ilmestymisestä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30083"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1750"/>
    <skos:prefLabel xml:lang="fi">kustantaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">publisher agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">utgivare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m643">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Elokuvafilmin esitysformaatti, joka käyttää useampia synkronoituja projektoreita.</skos:definition>
    <skos:definition xml:lang="sv">Visningsformat för film, som använder flera synkroniserade projektorer.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/presFormat/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">multiprojector</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">multiprojektor</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">multiprojektori</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m645">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30172"/>
    <skos:altLabel xml:lang="sv">Inspelningsteknik</skos:altLabel>
    <skos:altLabel xml:lang="fi">Äänen tallentamisen tapa</skos:altLabel>
    <skos:definition xml:lang="fi">Liittää manifestaation menetelmään, jota on käytetty äänen tallentamiseksi äänentoistoa varten.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med en metod som använts för att lagra ljud avsett för ljuduppspelning.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m480"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m702"/>
    <skos:prefLabel xml:lang="sv">Inspelningstyp</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Type of recording</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Äänen tallennustapa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m646">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30156"/>
    <skos:definition xml:lang="fi">Manifestaation nimeke, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
    <skos:definition xml:lang="sv">Titel för manifestation, som har valts till primär i en viss tillämpning eller kontext.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">huvudtitel</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">päänimeke</skos:prefLabel>
    <skos:prefLabel xml:lang="en">title proper</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m648">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DAT-kasetti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DAT-kassett</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m649">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kasetti, joka sisältää ääninauhan.</skos:definition>
    <skos:definition xml:lang="sv">Kassett som innehåller ljudband.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audiocasette</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudkassett</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänikasetti</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m65">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Diplomi-insinöörin, arkkitehdin tai maisema-arkkitehdin tutkinnon päätteeksi tehtävä opinnäyte.</skos:definition>
    <skos:definition xml:lang="sv">Lärdomsprov som görs som avslutning på en diplomingenjörs-, arkitekt- eller landskapsarkitektexamen.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">diplomarbete</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">diplomityö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m650">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">pianorulla</skos:altLabel>
    <skos:altLabel xml:lang="sv">pianorulle</skos:altLabel>
    <skos:definition xml:lang="fi">Paperirulla, jossa olevat rei’itykset edustavat toistettavia säveliä. Suunniteltu toistamaan musiikkia mekaanisesti automaattipianon, automaattiurkujen yms. avulla.</skos:definition>
    <skos:definition xml:lang="sv">Pappersrulle på vilken musiktoner representeras av hål. Utformad för att mekaniskt återskapa musik i självspelande piano, orgel e.d.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio roll</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudrulle</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänirulla</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Ljudbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänitallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m653">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m61"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/i/P40003"/>
    <skos:altLabel xml:lang="sv">Särskilda kännetecken för exemplar</skos:altLabel>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1099"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1491"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2253"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m506"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m565"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m774"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m973"/>
    <skos:prefLabel xml:lang="sv">Anmärkning om exemplarspecifik bäraregenskap</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Huomautus kappalekohtaisen tallenteen ominaisuudesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Modification of item</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Liittää kappaleen huomautukseen, joka antaa lisätietoa kuvailun kohteena olevan kappaleen tallenteen erityispiirteistä. Erityispiirteiden ei oleteta koskevan samaa manifestaatiota edustavia muita kappaleita.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Sammankopplar exemplar med en anmärkning som ger tilläggsinformation om särdragen i ett exemplars bärare. Särdragen förmodas inte gälla andra exemplar som representerar samma manifestation.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m654">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
