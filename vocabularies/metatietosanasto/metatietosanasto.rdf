  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m197">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Ensemble bestående av tio eller fler sångare.</skos:definition>
    <skos:definition xml:lang="fi">Kymmenen tai useamman laulajan muodostama esityskokoonpano.</skos:definition>
    <skos:example xml:lang="sv">Brahe Djäknar (kör)</skos:example>
    <skos:example xml:lang="fi">Campanella (kuoro)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuoro</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1970">
