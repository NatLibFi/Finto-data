    <skos:definition xml:lang="fi">Kokoelmateoksen manifestaatio, joka sisältää kappaleen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation av samlingsverk som innehåller ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40161"/>
