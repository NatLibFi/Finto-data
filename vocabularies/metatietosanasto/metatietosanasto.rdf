    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#isPatronOf"/>
    <skos:definition xml:lang="sv">Institution (t.ex. en konstnärsgrupp) som stöds eller gynnas av en beskriven institution.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö (esim. taiteilijaryhmä), jota kuvailtava yhteisö tukee tai suosii.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
