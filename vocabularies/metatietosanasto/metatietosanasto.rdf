    <skos:prefLabel xml:lang="fi">kartografinen taktiili kuva</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kartografisk taktil bild</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m729">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, bildkort (fysiskt eller digitalt) som innehåller ord, siffror, bilder o.s.v. och som är utformat för att snabbt visas som hjälpmedel i undervisningen.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kuvakortti (fyysinen tai digitaalinen), joka sisältää sanoja, numeroita, kuvia jne., suunniteltu näytettäväksi nopeasti opetuksen apuvälineinä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">flash card</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opetuskortti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">undervisningskort</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m731">
