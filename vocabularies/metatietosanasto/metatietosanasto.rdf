    <skos:altLabel xml:lang="sv">läroinrättning</skos:altLabel>
    <skos:altLabel xml:lang="fi">oppilaitos (yhteisötyyppi)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1028"/>
