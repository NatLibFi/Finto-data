    <skos:prefLabel xml:lang="fi">sisältyy aineistoon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5737">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dansare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tanssija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare, som deltar i utförandet av ett uttryck genom att dansa i ett musikaliskt eller dramatiskt framförande.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen tanssimalla musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20489"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">dancer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dansare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tanssija</skos:prefLabel>
  </owl:Class>
