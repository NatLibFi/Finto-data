    <skos:definition xml:lang="sv">Uttryck som ett verk handlar om.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10258"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aiheena oleva versio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">behandlad version</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subject expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5339">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen ääniteknikko (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljudtekniker (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän äänen teknisistä näkökohdista äänitys-, miksaus- ja äänentoistoprosessien aikana huolehtiva henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som sköter de tekniska aspekterna på ljud som ingår i ett aggregat, under inspelnings-, mixnings- och ljudåtergivningsprocesser.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljudtekniker</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääniteknikko</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m534">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ohjelmoija (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ohjelmoija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">programmer</skos:altLabel>
    <skos:altLabel xml:lang="sv">programmerare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programmerare (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">programmoija</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett datorprogram.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa tietokoneohjelman luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10050"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ohjelmoija</skos:prefLabel>
    <skos:prefLabel xml:lang="en">programmer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programmerare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5340">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kokousten raportoija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">mötesrapportör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5497"/>
    <skos:definition xml:lang="sv">Institution som är en författare, som fått i uppgift av en organisation att rapportera om mötesförfaranden.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10526"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kokousten raportoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mötesrapportör</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rapporteur corporate body</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omfattar inte ansvar som är begränsat till protokollföring.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5341">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">julkaisemattoman manifestaation tuottaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">producent (institution) för opublicerad manifestation</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5323"/>
    <skos:definition xml:lang="sv">Institution som svarar för gravering, tillverkning, sammansättning eller annat tillverkningssätt för en opublicerad manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa julkaisemattoman manifestaation kaiverruksesta, valmistuksesta, kokoonpanosta tai muusta tuotantotavasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30418"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">julkaisemattoman aineiston tuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">producent för opublicerat material</skos:prefLabel>
    <skos:prefLabel xml:lang="en">producer corporate body of unpublished manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5342">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">röstskådespelare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ääninäyttelijä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5645"/>
    <skos:definition xml:lang="fi">Henkilö, joka on näyttelijä, joka osallistuu ekspression tekemiseen antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en skådespelare, som deltar i utförandet av ett uttryck, genom att ge röst åt karaktärer i radio- och ljudproduktioner och animerade karaktärer i filmverk, samt genom att framträda i radio- och tv-reklarm, i dubbade uttryck etc.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20384"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">röstskådespelare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">voice actor person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääninäyttelijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5344">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5297"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2286"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka laajentaa toisen teoksen ekspression kerrontaa ajassa eteenpäin. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk som utvidgar ett annat verks uttrycks berättande framåt i tiden.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20335"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">jatko-osa (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sequel expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppföljare (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5345">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förkortad av (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">lyhentäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5739"/>
    <skos:definition xml:lang="sv">Institution som deltar i skapandet av ett uttryck, genom att förkorta ett relaterat verks uttryck utan att förändra framställningens allmänna innehåll eller stil.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen lyhentämällä siihen liittyvän teoksen ekspressiota muuttamatta esityksen yleistä sisältöä tai tyyliä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20475"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">abridger corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förkortad av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lyhentäjä</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske oleellista muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte betydande ändringar, som leder till skapandet av ett nytt verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5346">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen visuaalisten tehosteiden tekijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare (institution) av visuella effekter som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän liikkuvan kuvan visuaaliset tehosteet jälkituotantovaiheessa suunnitteleva ja tekevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som planerar och utför visuella effekter i postproduktionsfasen av rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">skapare av visuella effekter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">visuaalisten tehosteiden tekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5347">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bearbetare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">modifier</skos:altLabel>
    <skos:altLabel xml:lang="fi">muokkaaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5810"/>
    <skos:definition xml:lang="sv">Aktör som gör ändringar i ett exemplar, utan att skapa en ny manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka tekee muutoksia kappaleeseen luomatta uutta manifestaatiota. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40093"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1759"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1767"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1771"/>
    <skos:prefLabel xml:lang="sv">bearbetare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">modifier agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muokkaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5348">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (person) till textverk</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiteoksen kirjoittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5362"/>
    <skos:definition xml:lang="en">A person who is responsible for creating a textual work that complements a work.</skos:definition>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa toista teosta täydentävän tekstin luomisesta.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av en text som kompletterar ett annat verk.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">author person of textual work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare till textverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstiteoksen kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5349">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">omistaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ägare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5779"/>
    <skos:definition xml:lang="sv">Institution som har nuvarande eller tidigare juridisk äganderätt till ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jolla on kappaleen nykyinen tai aiempi laillinen omistusoikeus. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40136"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">omistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">owner corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ägare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m535">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">förbjuden under 18 år</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kielletty alle 18-vuotiailta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5350">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kompositör (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">säveltäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tonsättare</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett musikverk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa musiikkiteoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10536"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säveltäjä</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar omarbetningen av ett annat musikaliskt verk, parafrasen av ett verk, skapandet av ett verk enligt en annan kompositörs allmänna stil eller skapandet av ett verk som grundar sig på en annan kompositörs musik, som gjorts för att bilda en tydlig variant.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5351">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">colorist person</skos:altLabel>
    <skos:altLabel xml:lang="sv">färgläggare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">värittäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, liikkuvia kuvia tai muuta sisältöä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att färglägga ritningar, råkopior, fotografier, kartor, rörliga bilder eller annat innehåll.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20340"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">colourist person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">färgläggare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">värittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5352">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5445"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu sellaisen ekspression tekemiseen, joka on saumaton yhdistelmä erilaisia sisältöjä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett sådant uttryck som är en sömlös kombination av olika innehåll.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20367"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (person) till sammansmältning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor person to amalgamation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhdistymään osallinen henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5353">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">DJ (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">DJ (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">discjockey</skos:altLabel>
    <skos:altLabel xml:lang="sv">diskjockey</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck genom att mixa ljudspår till ett sammanhängande spår under ett liveframträdande eller i en inspelningsstudio.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen miksaamalla ääniraitoja yhteen yhtäjaksoiseksi raidaksi live-esityksessä tai äänitysstudiossa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20467"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DJ</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DJ</skos:prefLabel>
    <skos:prefLabel xml:lang="en">DJ corporate body</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske uudelleenmiksauksia, jotka olennaisesti muuttavat alkuperäisen teoksen luonnetta ja sisältöä, mikä johtaa uuteen teokseen, eikä äänitteen useampien raitojen miksaamista ja yhdistelyä. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte remixer som väsentligen ändrar det ursprungliga verkets karaktär och innehåll, vilket leder till ett nytt verk, och inte heller mixning och kombinering av flera spår i en ljudinspelning.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5354">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">paperinvalmistaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">pappersmakare</skos:altLabel>
    <skos:altLabel xml:lang="sv">papperstillverkare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5619"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av papper som använts i en manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30422"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">paperinvalmistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">papermaker corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">papperstillverkare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5355">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">editor corporate body of text</skos:altLabel>
    <skos:altLabel xml:lang="sv">redaktör (institution)</skos:altLabel>
    <skos:altLabel xml:lang="sv">redaktör (institution) för text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstin toimittaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5805"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att justera innehåll som skapats av andra aktörer, för att uppfylla utgivnings- och andra bruksstandarder.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20456"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redaktör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till innehåll hör rörelsenotation, taktil rörelsenotation, taktil musiknotation, taktil text och text.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5356">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen näyttämöohjaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">scenregissör (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää näyttämöesitystä johtava ja valvova henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som leder och övervakar ett sceniskt framförande som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">näyttämöohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">scenregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5358">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">remiksaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">remixer (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">uudelleenmiksaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett ljudverk, genom att manipulera, kombinera, blanda och återproducera tidigare inspelade ljud.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10449"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">remix artist person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">remixer</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">uudelleenmiksaaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte remixande som inte väsentligen ändrar det ursprungliga verkets karaktär och innehåll, och inte sammanfogande av tidigare inspelade musikstycken till ett musikstycke.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5359">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5707"/>
    <skos:altLabel xml:lang="fi">arviointi manifestaatiosta</skos:altLabel>
    <skos:altLabel xml:lang="sv">evaluering av manifestationen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5738"/>
    <skos:definition xml:lang="fi">Manifestaatio, jota on tutkittu tai arvioitu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som har undersökts eller evaluerats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10273"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">arviointi aineistosta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">evaluation of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">evaluering av materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m536">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">line by line</skos:altLabel>
    <skos:altLabel xml:lang="sv">linje för linje</skos:altLabel>
    <skos:definition xml:lang="sv">Layout som består av textrader som varvas med notrader sammanhörande med föregående text.</skos:definition>
    <skos:definition xml:lang="fi">Layout, joka koostuu tekstisäkeistä, jotka vuorottelevat edeltävään tekstiin liittyvien nuottisäkeiden kanssa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/layout/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">line by line</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">rad för rad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säkeet peräkkäin</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5360">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4812"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5338"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5361"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5443"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5457"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5518"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5633"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5649"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5672"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5695"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5722"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5727"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5950"/>
    <skos:prefLabel xml:lang="fi">Teoksen suhteet ekspressioon</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Verks relationer till uttryck</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5361">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5799"/>
    <skos:altLabel xml:lang="sv">konkordans (verk) till uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="sv">konkordans till uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="fi">konkordanssihakemisto (teos) ekspressiolle</skos:altLabel>
    <skos:altLabel xml:lang="fi">konkordanssihakemisto ekspressiolle</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5950"/>
    <skos:definition xml:lang="fi">Kaikkien tai valikoitujen ekspressiossa esiintyvien sanojen systemaattisen oppaan perustana olevan tekstiteoksen ekspressio. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av textverk som är grund för en systematisk guide över alla eller utvalda ord som förekommer i ett uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10628"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">concordance work for</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konkordans till versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">konkordanssihakemisto versiolle</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5362">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjoittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa tekstiteoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett textverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10436"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">author person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjoittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar skapandet av ett nytt verk genom att omarbeta, redigera eller arrangera ett verk av en annan upphovsperson, såvida ändringen väsentligen har ändrat originalets karaktär och innehåll eller uttrycksform.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5363">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">digitaaliseen sisältöön osallinen ohjelmistokehittäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programutvecklare (person) som är bidragsgivare till digitalt innehåll</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5894"/>
    <skos:definition xml:lang="fi">Aggregaatin digitaaliseen sisältöön kuuluvan tietokoneohjelman henkilötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsperson till datorprogram som ingår i ett aggregats digitala innehåll.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
