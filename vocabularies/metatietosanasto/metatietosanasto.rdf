  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m248">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Lähetysstandardi, joka on useimmissa maissa käytetyn analogisen television värikoodausstandardi, jota käytetään 625 juovaa / 25 ruutua sekunnissa -lähetyksiin. Nimetty Phase Alternating Linen mukaan.</skos:definition>
    <skos:definition xml:lang="sv">Sändningsstandard, som är färgkodningsstandard för analog television som används i de flesta länder och som används för 625 linjer / 25 rutor i sekunden -sändningar. Förkortning för Phase Alternating Line.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/broadcastStand/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">PAL</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">PAL</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">PAL</skos:prefLabel>
  </owl:Class>
