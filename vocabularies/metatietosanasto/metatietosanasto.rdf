    <skos:definition xml:lang="fi">Äänitteen sukupolven määrite tallenteen negatiiviselle metallikopiolle, joka on kaiverrettu lakkapäällysteiselle levylle levysorvin avulla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1002"/>
