    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää näyttämöesitystä johtava ja valvova yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som leder och övervakar ett sceniskt framförande som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">näyttämöohjaaja</skos:prefLabel>
