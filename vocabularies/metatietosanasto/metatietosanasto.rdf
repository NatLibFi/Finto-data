    <skos:definition xml:lang="fi">Teoksen ekspression saama ilmiasu.</skos:definition>
    <skos:prefLabel xml:lang="fi">Manifestaatio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1381">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Igumen som vigts till det stora schemat.</skos:definition>
