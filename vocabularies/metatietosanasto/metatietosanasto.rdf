    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kaksiulotteisena liikkuvana kuvana esitetty kartografinen sisältö. Esimerkiksi liikkuvat satelliittikuvat maasta tai muista taivaankappaleista.</skos:definition>
    <skos:definition xml:lang="sv">Kartografiskt innehåll uttryckt som tvådimensionell rörlig bild. T.ex. rörliga satellitbilder av jorden eller andra himlakroppar.</skos:definition>
