  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5528">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5328"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5536"/>
    <skos:definition xml:lang="fi">Teos, joka on luotu muuttamalla teoksen genreä tai kirjallista muotoa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som skapats genom att ändra ett verks genre eller litterära form.</skos:definition>
