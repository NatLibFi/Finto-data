    <skos:definition xml:lang="sv">Aktör som deltar i tillverkningen av en manifestation genom att tillverka tryckytan för relief, djuptryck eller plantryck.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu manifestaation valmistamiseen valmistamalla kohokuvan, syväpainon tai laakapainon painopinnan. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30072"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
