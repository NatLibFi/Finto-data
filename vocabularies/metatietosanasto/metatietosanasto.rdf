    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m511"/>
    <skos:definition xml:lang="sv">Aktör som är en konstnär, som svarar för utnyttjande av bokens form eller ändring av dess fysiska struktur.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10254"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bokkonstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="en">book artist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjataiteilija</skos:prefLabel>
  </owl:Class>
