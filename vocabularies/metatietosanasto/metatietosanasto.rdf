    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att planera kostymdesignen i en filmproduktion eller ett musikaliskt eller sceniskt framförande.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20463"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">costume designer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kostymör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puvustaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5834">
