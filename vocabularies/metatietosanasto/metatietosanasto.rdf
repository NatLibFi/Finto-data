    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1747"/>
    <skos:definition xml:lang="sv">Aktör som svarar för tillverkningen av en manifestation genom att etsa metall, glas eller någon annan yta med hjälp av syra eller något annat frätande ämne.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa manifestaation valmistamisesta etsaamalla metallia, lasia tai muuta pintaa hapon tai muun syövyttävän aineen avulla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30076"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">etcher agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">etsaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">etsare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1747">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
