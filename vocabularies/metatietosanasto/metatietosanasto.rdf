    <skos:altLabel xml:lang="fi">Teoksen muoto</skos:altLabel>
    <skos:altLabel xml:lang="sv">Verkets form</skos:altLabel>
    <skos:altLabel xml:lang="sv">Verkets kategori</skos:altLabel>
    <skos:definition xml:lang="fi">Liittää teoksen tyyppiin, johon teos kuuluu.</skos:definition>
