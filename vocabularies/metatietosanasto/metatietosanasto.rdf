    <skos:definition xml:lang="fi">Ilmavoimien operatiivinen joukko-osasto, joka jakaantuu yhteen tai useampaan laivueeseen (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Operativt truppförband inom flygvapnet, som kan indelas i flera divisioner.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
