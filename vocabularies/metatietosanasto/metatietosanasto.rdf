    <skos:altLabel xml:lang="fi">sisältää näköispainoksen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m175"/>
    <skos:definition xml:lang="sv">Exakt reproduktion av en manifestation, som är en del av en annan manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Manifestaation täsmällinen jäljennös, joka on toisen manifestaation osana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30046"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">facsimile part</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">faksimildel</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">näköispainososa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4269">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4291"/>
    <skos:altLabel xml:lang="fi">käsikirjoitus ekspressioon</skos:altLabel>
    <skos:altLabel xml:lang="sv">manuskript till uttrycket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4218"/>
    <skos:definition xml:lang="fi">Teoksen, kuten elokuvan, television tai videon, ekspressio, joka käyttää teoksen tekstiä käsikirjoituksena. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av ett verk, såsom en film, ett tv-program eller en video, som använder ett verks text som manuskript.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20102"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4294"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4295"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4320"/>
    <skos:prefLabel xml:lang="fi">käsikirjoitus teoksen versioon</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">manuskript till versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">screenplay for expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4271">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4333"/>
    <skos:altLabel xml:lang="sv">konkordans (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">konkordanssihakemisto (ekspressio)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1117"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka koostuu kaikkien tai valikoitujen tekstiteoksen toteutuksessa esiintyvien sanojen hakemistosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk som består av ett register över alla eller utvalda ord som förekommer i förverkligandet av ett textverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20108"/>
