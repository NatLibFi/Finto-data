    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4218"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio kuten elokuva, näytelmä, televisio-ohjelma tms., joka käyttää musiikkiteosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av ett verk, såsom en film, ett skådespel, ett tv-program eller dylikt, som använder ett musikverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20244"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
