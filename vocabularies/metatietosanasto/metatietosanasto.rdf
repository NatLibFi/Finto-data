    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat, genom att skapa ett uttryck av ett slutord som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
