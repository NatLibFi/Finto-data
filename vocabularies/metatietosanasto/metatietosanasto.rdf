    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">DJ (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="sv">discjockey</skos:altLabel>
    <skos:altLabel xml:lang="sv">diskjockey</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen DJ (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä ääniraitoja yhteen yhtäjaksoiseksi raidaksi live-esityksessä tai äänitysstudiossa miksaava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som mixar ljudspår som ingår i ett aggregat till ett sammanhängande spår under ett liveframträdande eller i en inspelningsstudio.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DJ</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DJ</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5801">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
