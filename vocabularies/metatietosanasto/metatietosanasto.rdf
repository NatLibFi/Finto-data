    <skos:altLabel xml:lang="fi">reserviupseerikoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">reservofficersskola</skos:altLabel>
    <skos:altLabel xml:lang="fi">upseerikoulu</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11930"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
