    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">DJ (institution) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="sv">discjockey</skos:altLabel>
    <skos:altLabel xml:lang="sv">diskjockey</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen DJ (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyviä ääniraitoja yhteen yhtäjaksoiseksi raidaksi live-esityksessä tai äänitysstudiossa miksaava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som mixar ljudspår som ingår i ett aggregat till ett sammanhängande spår under ett liveframträdande eller i en inspelningsstudio.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DJ</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DJ</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5491">
