    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Lagringssätt, i vilket ett materials innehåll lagras som sekvenser med binära värden.</skos:definition>
    <skos:definition xml:lang="fi">Tallentamisen tapa, jossa aineiston sisältö tallennetaan binääristen arvojen jaksoina.</skos:definition>
