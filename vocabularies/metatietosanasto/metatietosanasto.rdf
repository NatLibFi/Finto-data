    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kilpa (tapahtuma)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kisat (tapahtumat)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tävling (evenemang)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m863"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p836"/>
    <skos:definition xml:lang="fi">Tilaisuus, jossa kilpaillaan, esim. kisa(t), ottelu(t), turnaus (Kielitoimiston sanakirja).</skos:definition>
    <skos:definition xml:lang="sv">Tillfälle för tävling, t.ex. mästerskap, match, turnering.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kilpailu (tapahtuma)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tävling</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Om idrottstävlingar används termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4693'&gt;sportevenemang&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Urheilukilpailuista käytetään termiä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4693'&gt;urheilutapahtuma&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4718">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p8777"/>
    <skos:definition xml:lang="sv">Ekonomisk organisation som driver sina medlemmars eller sin referensgrupps intressen.</skos:definition>
    <skos:definition xml:lang="fi">Etujärjestö on taloudellinen järjestö, joka pyrkii ajamaan oman jäsenistönsä tai viiteryhmänsä etuja (Wikipedia).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">etujärjestö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intresseorganisation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4719">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
