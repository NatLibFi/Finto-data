    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4199"/>
    <skos:definition xml:lang="fi">Liikkuvan kuvan teoksen ekspressio, joka perustuu toisen teoksen ekspressioon. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av ett verk med rörlig bild, som grundar sig på ett annat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20009"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as motion picture expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">elokuvaversio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmversion</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4208">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen lisäämällä siihen tehtäviä.</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck genom att tillfoga uppgifter.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">skapare av uppgifter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tehtävien tekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4209">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m551"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/a/P50116"/>
    <skos:definition xml:lang="en">A gender with which a person identifies.</skos:definition>
    <skos:definition xml:lang="sv">Personers könsidentitet.</skos:definition>
    <skos:definition xml:lang="fi">Sukupuoli, jota henkilö kokee edustavansa.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4224"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4231"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4232"/>
    <skos:prefLabel xml:lang="en">gender</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kön</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukupuoli</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används för att bestämma termer som beskriver kön hos medlemmar av en grupp (t.ex. män, kvinnor, transpersoner). Vid val av enskilda termer används ALLFO-termer ur gruppen &lt;a href='http://www.yso.fi/onto/yso/p22231'&gt;roll relaterad till kön&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään määrittämään ryhmän jäsenten sukupuolta kuvaavia termejä (esim. miehet, naiset, transihmiset). Yksittäisten termien valinnassa käytetään YSO-termejä ryhmästä &lt;a href='http://www.yso.fi/onto/yso/p22231'&gt;sukupuoleen liittyvä rooli&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m421">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30122"/>
    <skos:altLabel xml:lang="sv">Mikrofilm- och mikrokortemulsion</skos:altLabel>
    <skos:definition xml:lang="fi">Mikrofilmin tai mikrokortin valoherkkiä kemikaaleja sisältävä pinnoite.</skos:definition>
    <skos:definition xml:lang="sv">Ytbeläggning som innehåller ljuskänsliga kemikalier på mikrofilm eller mikrofiche.</skos:definition>
    <skos:prefLabel xml:lang="en">Emulsion on microfilm and microfiche</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Emulsion på mikrofilm och mikrofiche</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Mikrofilmin ja mikrokortin emulsio</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kuvailussa käytetään käsiteryhmässä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m654'&gt;Materiaali&lt;/a&gt; olevia käsitteitä.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Vid beskrivning används begrepp ur begreppsgruppen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m654'&gt;Material&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4210">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4180"/>
    <skos:altLabel xml:lang="fi">romaanimukaelma (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">romanbearbetning (uttryck)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4199"/>
    <skos:definition xml:lang="fi">Romaanin ekspressio, joka on sovitettu toisen teoksen ekspressiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av roman som har bearbetats utgående från ett annat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20088"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as novel expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">romaanimukaelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">romanbearbetning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4211">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4186"/>
    <skos:altLabel xml:lang="fi">oopperasovitus (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">operabearbetning (uttryck)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4199"/>
    <skos:definition xml:lang="fi">Toisen teoksen ekspressioon perustuva oopperan ekspressio. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av opera som grundar sig på ett annat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20242"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as opera expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">oopperasovitus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">operabearbetning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4213">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4171"/>
    <skos:altLabel xml:lang="fi">runomukaelma (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">versbearbetning (uttryck)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4199"/>
    <skos:definition xml:lang="fi">Runomuodossa oleva ekspressio, joka on sovitettu toisen teoksen ekspressiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck i versform, som är bearbetat utifrån ett annat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20077"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted in verse as expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">runomukaelma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">versbearbetning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4214">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4178"/>
    <skos:altLabel xml:lang="sv">radiobearbetning (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">radiosovitus (ekspressio)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4199"/>
    <skos:definition xml:lang="fi">Radio-ohjelman ekspressio, joka perustuu toisen teoksen ekspressioon. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av radioprogram, som grundar sig på ett annat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20060"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as radio program expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">radiobearbetning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">radiosovitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4215">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3540"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5591"/>
    <skos:definition xml:lang="fi">Musiikkiteoksen ekspressio, joka muokkaa sävellystä esityskokoonpanolle, joka poikkeaa siitä, mille teos alun perin tarkoitettiin. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av musikverk, som omarbetar en komposition för en musikalisk besättning som avviker från den som ursprungligen avsågs för verket.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20165"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">arranged as</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">arrangerad som</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovitus</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Detta element tillämpas på varianter av verk, i vilka den musikaliska besättningen eller dylikt är samma och i vilka kompositionens musikaliska huvudsakliga innehåll till sina väsentliga delar har bevarats oförändrat. Elementet gäller inte ändringar beträffande det huvudsakliga innehållet, ur vilka ett nytt musikverk uppkommer.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tätä elementtiä sovelletaan teoksen muunnoksiin, joissa on sama esityskokoonpano tms. ja jotka säilyttävät alkuperäisen sävellyksen musiikillisen pääsisällön oleellisin osin muuttumattomana. Elementti ei kata pääsisältöön kohdistuvia muunnoksia, joista syntyy uusi musiikkiteos. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4216">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4181"/>
    <skos:altLabel xml:lang="sv">videobearbetning (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">videosovitus (ekspressio)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4199"/>
    <skos:definition xml:lang="sv">Uttryck av video, som grundar sig på ett annat verks uttryck.</skos:definition>
    <skos:definition xml:lang="fi">Videon ekspressio, joka perustuu toisen teoksen ekspressioon. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20067"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as video expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">videobearbetning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">videosovitus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4217">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3545"/>
    <skos:altLabel xml:lang="fi">variaatio (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">variation (uttryck)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m731"/>
    <skos:definition xml:lang="fi">Musiikkiteoksen ekspressio, jossa toisen teoksen ekspressiosta otettu melodinen, temaattinen tai harmoninen aines muodostaa erillisen teeman, jota toistetaan muunnellen yhden tai useamman kerran. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av musikverk, i vilket ett melodiskt, tematiskt eller harmoniskt material, taget ur ett annat verks uttryck, bildar ett fristående tema som återges varierat en eller flera gånger.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20082"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">modified by variation as expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">variaatio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4218">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kompletterande uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">liittyy ekspressioon</skos:altLabel>
    <skos:altLabel xml:lang="sv">relaterat uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">täydentävä ekspressio</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka on yhdistetty siihen liittyvään ekspressioon ilman, että kumpaakaan ekspressiota pidetään ensisijaisena. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, som är sammanparat med ett relaterat uttryck, utan att någotdera uttrycket anses primärt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20100"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4229"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4238"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4239"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4269"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4279"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4291"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4293"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4305"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4316"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4326"/>
    <skos:prefLabel xml:lang="en">complemented by expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompletterande version</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">täydentävä teoksen versio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4219">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4184"/>
    <skos:altLabel xml:lang="sv">bearbetad till radiomanuskript (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">radiokäsikirjoitus</skos:altLabel>
    <skos:altLabel xml:lang="fi">radiokäsikirjoitus (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">radiomanuskript</skos:altLabel>
    <skos:altLabel xml:lang="sv">radiomanuskript (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sovitettu radiokäsikirjoitukseksi (ekspressio)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4199"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka koostuu toisen teoksen ekspressioon perustuvasta radio-ohjelman käsikirjoituksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk som består av ett manuskript till ett radioprogram som grundar sig på ett annat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20099"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">adapted as radio script expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">bearbetad till radiomanuskript</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovitettu radiokäsikirjoitukseksi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m422">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Emulsio, joka koostuu yhdestä tai useammasta valoherkästä diazonium-suolakerroksesta polyesteri- tai asetaattipohjalla ja josta saadaan dye-coupling-menetelmällä atsovärikuva.
Materiaali, jota tavallisesti käytetään mikrofilmin tai mikrokortin pohjamateriaalina.</skos:definition>
    <skos:definition xml:lang="sv">Emulsion som består av en eller flera lager av ljuskänsligt diazoniumsalt på polyester- eller acetatbotten och från vilket man får azofärgbild med dye-coupling-metoden. Material som vanligtvis används som bottenmaterial för mikrofilm eller mikrofiche.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1046"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">diatso</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">diazo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">diazo emulsion</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4220">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4194"/>
    <skos:altLabel xml:lang="en">adapted as musical theater expression</skos:altLabel>
    <skos:altLabel xml:lang="sv">bearbetad till musikalversion av uttryck</skos:altLabel>
