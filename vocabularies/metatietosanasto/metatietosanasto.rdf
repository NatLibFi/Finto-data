    <skos:altLabel xml:lang="sv">uppfostringsanstalt</skos:altLabel>
    <skos:altLabel xml:lang="fi">vastaanottokoti</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4668"/>
