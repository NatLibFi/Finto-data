  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5064">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m281"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:altLabel xml:lang="sv">annan bestämning relaterat till institution</skos:altLabel>
    <skos:definition xml:lang="en">A characteristic other than place that is associated with corporate body, date associated with corporate body, associated institution, type of corporate body, or type of jurisdiction.</skos:definition>
    <skos:definition xml:lang="sv">Attribut relaterat till en institution, som är något annat än en plats, ett tidsavsnitt relaterat till en institution, en relaterad institution, en typ av institution eller en typ av förvaltningsområde.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisöön liittyvä määrite, joka on muu kuin paikka, yhteisöön liittyvä ajanjakso, liittyvä yhteisö, yhteisön tyyppi tai hallintoalueen tyyppi.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2042"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5058"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5059"/>
    <skos:prefLabel xml:lang="sv">annat attribut relaterat till institution</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muu yhteisöön liittyvä määrite</skos:prefLabel>
    <skos:prefLabel xml:lang="en">other designation associated with corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5065">
