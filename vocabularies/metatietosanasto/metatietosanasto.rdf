  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m276">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">pressmatris</skos:altLabel>
    <skos:definition xml:lang="sv">Bestämning av generation för en originalskivas negativkopia i hårdmetall, som kan sättas i press och användas för att trycka spårmönster vid tillverkning av ett parti skivor.</skos:definition>
    <skos:definition xml:lang="fi">Äänitteen sukupolven määrite originaalilevyn kovametalliselle negatiivikopiolle, joka voidaan asentaa puristimeen ja käyttää urakuvion painamiseen levyjen tuotantoerän valmistuksessa.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">isiö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">patris</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stamper</skos:prefLabel>
  </owl:Class>
