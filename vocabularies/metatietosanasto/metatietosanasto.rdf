    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">irtolehtiä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">lösblad</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1019">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll uttryckt med teckensystem för beskrivning av rörelse, avsett att vidröras.</skos:definition>
    <skos:definition xml:lang="fi">Liikettä kuvailevan merkkijärjestelmän avulla esitetty sisältö, joka on tarkoitettu kosketeltavaksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1017"/>
