  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m98">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka koostuu palamattomasta selluloosa-asetaatista tai polyesterista.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av eldfast cellulosa-acetat eller polyester.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1033"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">safety base</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">säkerhetsfilm</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">varmuusfilmi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m982">
    <dc11:source xml:lang="sv">ONIX-term</dc11:source>
    <dc11:source xml:lang="fi">ONIX-termi</dc11:source>
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kirjasinkoko, joka on tarkoitettu auttamaan lukijoita, joilla on vaikeuksia lukea tavallisen kokoista tekstiä.</skos:definition>
    <skos:definition xml:lang="sv">Teckengrad som är avsedd att hjälpa läsare som har svårigheter att läsa text i normal storlek.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/fontSize/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">isotekstinen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">large print</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stor stil</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m984">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">hardboard</skos:altLabel>
    <skos:definition xml:lang="sv">Stabilt, kompakt och styvt material, ofta tillverkat genom varmpressning av fiber.</skos:definition>
    <skos:definition xml:lang="fi">Tukeva, tiivis ja jäykkä, usein kuidusta kuumapuristamalla valmistettu materiaali.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">hardboard</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">hårdpapp</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kovalevy</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m986">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvan tekijä</skos:altLabel>
    <skos:altLabel xml:lang="fi">elokuvantekijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmens skapare</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmmakare</skos:altLabel>
    <skos:altLabel xml:lang="en">filmmaker</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av en självständig eller personlig film.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10063"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvantekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">filmmaker agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmskapare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Skaparen svarar själv till alla delar för idén till och förverkligandet av filmen.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m988">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p23003"/>
    <skos:definition xml:lang="fi">Eräistä naispuolisista hallitsijoista; ruhtinassuvun naispuolinen jäsen, varsinkin ruhtinaan puoliso.</skos:definition>
    <skos:definition xml:lang="sv">Om vissa kvinnliga regenter; kvinnlig medlem av furstesläkt, särsk. gemål till furste.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">furstinna</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ruhtinatar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m991">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
