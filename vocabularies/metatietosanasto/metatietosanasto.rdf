    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">enskild näringsidkare</skos:altLabel>
    <skos:altLabel xml:lang="sv">firma</skos:altLabel>
    <skos:altLabel xml:lang="fi">yksityinen elinkeinonharjoittaja</skos:altLabel>
    <skos:definition xml:lang="fi">Elinkeinotoimintaa harjoittava luonnollinen henkilö erotukseksi vastaavaa toimintaa harjoittavasta yhtiöstä.</skos:definition>
    <skos:definition xml:lang="sv">Fysisk person som utövar näringsverksamhet, till skillnad från bolag som utövar motsvarande verksamhet.</skos:definition>
    <skos:example xml:lang="fi">Vaasan osoitteet (toiminimi)</skos:example>
    <skos:example xml:lang="sv">Vasa adresser (firmanamn)</skos:example>
