  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4133">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">album (musik)</skos:altLabel>
    <skos:altLabel xml:lang="fi">albumi (musiikki)</skos:altLabel>
    <skos:definition xml:lang="fi">Useita sävellyksiä sisältävä tai kestoltaan pitkä (vähintään n. 30 min) äänitejulkaisu.</skos:definition>
    <skos:definition xml:lang="sv">Utgiven ljudupptagning som innehåller flera kompositioner eller vars speltid är lång (minst ca 30 min.)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">musiikkialbumi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikalbum</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
  </owl:Class>
