    <skos:definition xml:lang="fi">Sukuun liittyvä tyyppi tai jaottelu.</skos:definition>
    <skos:definition xml:lang="sv">Typ eller indelning relaterad till släkt.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4866"/>
