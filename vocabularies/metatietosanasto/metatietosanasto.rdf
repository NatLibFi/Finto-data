  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5684">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bidragsgivare till sammansmältning</skos:altLabel>
    <skos:altLabel xml:lang="en">contributor to amalgamation</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhdistymään osallistuja</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5710"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett sådant uttryck som är en sömlös kombination av olika innehåll.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu sellaisen ekspression tekemiseen, joka on saumaton yhdistelmä erilaisia sisältöjä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20328"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m130"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m156"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m158"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1596"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1682"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3590"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till sammansmältning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent to amalgamation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhdistymään osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5685">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">laulaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare, som deltar i utförandet av ett uttryck, genom att använda sin röst, med eller utan instrumentalackompanjemang, för att producera musik.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20382"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laulaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">singer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Sångarens framförande kan vara med eller utan riktiga ord.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5687">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kommentator (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen kommentaattori (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän audiovisuaalisen aineiston aihetta tulkitseva, analysoiva tai keskustelussa käsittelevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som tolkar, analyserar eller diskuterar ett ämne i audiovisuellt material som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kommentaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentator</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5688">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvan musiikin säveltäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kompositör (person) av filmmusik</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5464"/>
    <skos:definition xml:lang="en">A person who is responsible for creating a motion picture music work that complements a musical work.</skos:definition>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa elokuvaa täydentävän musiikin luomisesta.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av musik som kompletterar en film.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer person of motion picture music work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">elokuvan musiikin säveltäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör av filmmusik</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5689">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">berättare (person) som är bidragsgivare till tal</skos:altLabel>
    <skos:altLabel xml:lang="fi">puheeseen osallinen kertoja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5485"/>
    <skos:definition xml:lang="fi">Henkilö, joka aggregaattiin kuuluvassa sisällössä lukee ääneen tai kertoo toiminnasta, tapahtumasta, tapahtumien kulusta tms.</skos:definition>
    <skos:definition xml:lang="sv">Person som högläser eller berättar om en handling, en händelse, ett händelseförlopp eller något annat dylikt, i ett innehåll som hör till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">berättare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kertoja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m569">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, stillbild, oftast framställd genom att måla färg direkt på ett underlag, vanligtvis på en tvådimensionell yta.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, liikkumaton kuva, joka on tehty useimmiten maalaamalla väriaineita suoraan alustalle, yleensä kaksiulotteiselle pinnalle.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1024"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">maalaus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">målning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">painting</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5690">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5631"/>
    <skos:altLabel xml:lang="sv">exemplar relaterat till manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaatioon liittyvä kappale</skos:altLabel>
    <skos:definition xml:lang="sv">Exemplar som relaterar till en manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Kappale, joka liittyy manifestaatioon. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30140"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineistoon liittyvä kappale</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">exemplar relaterat till materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related item of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5691">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förkortad av (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">lyhentäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5548"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen lyhentämällä siihen liittyvän teoksen ekspressiota muuttamatta esityksen yleistä sisältöä tai tyyliä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i skapandet av ett uttryck, genom att förkorta ett relaterat verks uttryck utan att förändra framställningens allmänna innehåll eller stil.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20357"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">abridger person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förkortad av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lyhentäjä</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske oleellista muokkausta, joka johtaa uuden teoksen luomiseen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte betydande ändringar, som leder till skapandet av ett nytt verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5692">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5589"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5549"/>
    <skos:definition xml:lang="fi">Teos, jonka rakennetta kuvaa toinen teos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk, vars struktur ett annat verk beskriver.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10140"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">analys av verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">analysis of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">analyysi teoksesta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5693">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression tekijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare (institution) av uttryck</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5902"/>
    <skos:definition xml:lang="sv">Institution som svarar för förverkligandet av ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa teoksen toteutuksesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20507"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">creator corporate body of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av version</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen version tekijä</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ekspression tekijään kuuluvat kääntäjä, sovittaja, esittäjä jne. Ekspression toteuttaman teoksen tekijä on myös ekspression tekijä. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till skapare av ett uttryck hör översättare, arrangör, framförande aktör etc. Skapare av ett verk som förverkligas av ett uttryck är också skapare av ett uttryck.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5694">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kokousten raportoija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">mötesrapportör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5362"/>
    <skos:definition xml:lang="fi">Henkilö, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en författare, som fått i uppgift av en organisation att rapportera om mötesförfaranden.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10432"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kokousten raportoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mötesrapportör</skos:prefLabel>
    <skos:prefLabel xml:lang="en">rapporteur person</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omfattar inte ansvar som är begränsat till protokollföring.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5695">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5913"/>
    <skos:altLabel xml:lang="sv">analys av uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="fi">analyysi ekspressiosta</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5672"/>
    <skos:definition xml:lang="fi">Ekspressio, jonka osia ja niiden välisiä suhteita on tutkittu analyyttisesti. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck, vars delar har undersökts analytiskt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10278"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">analys av versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">analysis of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">analyysi versiosta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5696">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5797"/>
    <skos:altLabel xml:lang="fi">manifestaatioon liittyvä ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">uttryck relaterat till manifestationen</skos:altLabel>
    <skos:definition xml:lang="fi">Ekspressio, joka liittyy manifestaatioon. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som relaterar till en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30266"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineistoon liittyvä versio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related expression of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">version relaterad till materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5697">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bearbetare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">muokkaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5779"/>
    <skos:definition xml:lang="sv">Institution som gör ändringar i ett exemplar, utan att skapa en ny manifestation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka tekee muutoksia kappaleeseen luomatta uutta manifestaatiota. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40144"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bearbetare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">modifier corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muokkaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5698">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förvaltare</skos:altLabel>
    <skos:altLabel xml:lang="sv">förvarare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">säilyttäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5699"/>
    <skos:definition xml:lang="fi">Henkilö, jolla on kappaleen laillinen säilyttämisoikeus. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som har juridisk förvaringsrätt till ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40103"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">custodian person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förvarare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säilyttäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5699">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Henkilö, joka liittyy kappaleeseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som relaterar till ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40073"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleeseen liittyvä henkilö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">person relaterad till exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related person of item</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5700">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kokoaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sammanställare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5849"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa uuden teoksen, kuten bibliografian tai hakemiston luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av ett nytt verk, såsom en bibliografi eller ett register, genom att välja, ordna, sammanställa och redigera data, information eller dylikt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10444"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">compiler person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kokoaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sammanställare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön muokkaamista tai selkeyttämistä eikä teosten tai teosten osien valitsemista ja kokoamista yhteen. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omfattar inte redigering eller förtydligande av innehållet i ett verks uttryck, eller val och hopsamling av verk eller del av verk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5701">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen erikoistehosteiden tekijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare av specialeffekter (institution) som bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvien liikkuvan kuvan tai äänen taltiointien erikoistehosteet (esim. mekaaniset tehosteet ja kameralla toteutettavat optiset tehosteet) tekevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som skapar specialeffekter (t.ex. mekaniska effekter och optiska effekter skapade med kamera) i inspelningar av rörlig bild eller ljud, som ingår i aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erikoistehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av specialeffekter</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5702">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5536"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5418"/>
    <skos:definition xml:lang="fi">Teos, jolla on toiminta-ala tai toimituslinja, genre tai kirjallinen muoto, kohdeyleisö tai tyyli, jota on muutettu teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk med ett verksamhetsfält eller en redaktionell linje, genre eller litterär form, målgrupp eller stil, som har ändrats för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10337"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">muunnos teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5703">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">forskare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som stöder uppkomsten av ett verk genom sin forskning.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka tukee teoksen syntymistä tutkimuksellaan. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10510"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">forskare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">researcher corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tutkija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5704">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">lavastaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">scenograf (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen valvomalla taiteilijoita ja käsityöläisiä, jotka rakentavat lavasteita elokuvatuotantoihin. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att övervaka konstnärer och hantverkare som bygger kulisser för filmproduktioner.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20350"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">art director person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lavastaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">scenograf</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5705">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">granskare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">reviser</skos:altLabel>
    <skos:altLabel xml:lang="fi">tarkistaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5710"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att göra ändringar i ett annat uttrycks innehåll.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen tekemällä muutoksia toisen ekspression sisältöön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20327"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1096"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1205"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1761"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3584"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m495"/>
    <skos:prefLabel xml:lang="sv">granskare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reviser agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tarkistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5706">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">lantmätare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">maanmittari (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5404"/>
    <skos:definition xml:lang="fi">Henkilö, joka kartografiaan osallisena toimijana tuottaa maantieteellisen alueen mitat tai mittasuhteet. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är delaktig aktör i kartografi och ger mått eller proportioner för ett geografiskt område.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30337"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lantmätare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maanmittari</skos:prefLabel>
    <skos:prefLabel xml:lang="en">surveyor person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5707">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5359"/>
    <skos:altLabel xml:lang="en">evaluated in (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">evaluering av manifestation i</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation arviointi</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5764"/>
    <skos:definition xml:lang="fi">Teos, joka sisältää tutkivan arvioinnin ja arvostelun manifestaatiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som innehåller en undersökande utvärdering och bedömning av en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30258"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston arviointi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">evaluering av materialet i</skos:prefLabel>
    <skos:prefLabel xml:lang="en">manifestation evaluated by</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5708">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">protokollförare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">pöytäkirjan laatija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5805"/>
    <skos:definition xml:lang="sv">Institution som svarar för sammanställandet av ett protokoll för ett möte.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka vastaa kokouksen pöytäkirjan laatimisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20510"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">minute taker corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">protokollförare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pöytäkirjan laatija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5709">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5773"/>
    <skos:altLabel xml:lang="fi">hakemisto manifestaatiolle</skos:altLabel>
    <skos:altLabel xml:lang="sv">index till materialet</skos:altLabel>
    <skos:altLabel xml:lang="sv">register till manifestationen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5728"/>
    <skos:definition xml:lang="fi">Manifestaation sisällön systemaattisen oppaan perustana olevan tekstiteoksen manifestaatio. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation av textverk som är grund för en systematisk vägledning till innehållet i en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10627"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">hakemisto aineistolle</skos:prefLabel>
    <skos:prefLabel xml:lang="en">index for</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">register till materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5710">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">contributor</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression tekijä</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression tekijä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare av uttryck</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare av uttryck (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5307"/>
    <skos:definition xml:lang="sv">Aktör som svarar för förverkligandet av ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa teoksen toteutuksesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20053"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m23"/>
    <skos:prefLabel xml:lang="en">creator agent of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av version</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">version tekijä</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ekspression tekijään kuuluvat kääntäjä, sovittaja, esittäjä jne. Ekspression toteuttaman teoksen tekijä on myös ekspression tekijä. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till skapare av uttryck hör översättare, arrangör, framförande person etc. Skapare av ett uttryck som förverkligar ett verk är också skapare av ett uttryck.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5711">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">mixer (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen miksaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä musiikissa ääniraitoja käsittelevä, miksaava tai yhdistelevä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som behandlar, mixar och kombinerar ljudspår i musik som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">miksaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mixer</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5712">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">aggregaattori</skos:altLabel>
    <skos:altLabel xml:lang="fi">aggregaattori (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">aggregator</skos:altLabel>
    <skos:altLabel xml:lang="sv">aggregerad av (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett aggregerande verk, genom att välja och ordna uttryck av andra verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10393"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1037"/>
    <skos:prefLabel xml:lang="en">aggregator agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aggregerad av</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">koostaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5713">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvaohjaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmregissör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5729"/>
    <skos:definition xml:lang="fi">Henkilö, joka on ohjaaja, joka on vastuussa elokuvatun esityksen yleisestä johtamisesta ja valvonnasta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en regissör, som svarar för allmän ledning och övervakning av en filmad föreställning som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10418"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvaohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">film director person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5714">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">framförande person som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen esittäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä liikkuvassa kuvassa esiintyvä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">framförande person i rörlig bild</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan esittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5715">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa kaikenlaisen akateemisen toiminnan valvonnasta, joka johtaa teokseen, mukaan lukien tutkielmat, tutkimukset ja projektit. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för övervakning av all slags akademisk verksamhet, som leder till ett verk, även avhandlingar, forskning och projekt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10407"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m576"/>
    <skos:prefLabel xml:lang="en">academic supervisor</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">akademisk handledare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">akateeminen ohjaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5716">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Aktör som relaterar till en släkt.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka liittyy sukuun. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50324"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">aktör relaterad till släkten</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related agent of family</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukuun liittyvä toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5717">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (person) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen kirjoittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5814"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän tekstin kirjoittanut henkilö. Määritelmä kattaa myös uuden sisällön luomisen toisen tekijän tekstiä mukailemalla, muokkaamalla tai sovittamalla, jos muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai ilmaisutapaa.</skos:definition>
    <skos:definition xml:lang="sv">Person som skrivit en text som ingår i ett aggregat. Innefattar även skapandet av nytt innehåll genom att omarbeta, redigera eller bearbeta text av en annan upphovsperson, såvida ändringen väsentligen har ändrat originalets karaktär och innehåll eller uttrycksform.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">författare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5718">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljuddesigner (person) som är bidragsgivare till tal</skos:altLabel>
    <skos:altLabel xml:lang="fi">puheeseen osallinen äänisuunnittelija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5485"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän puhesisällön äänikomponentteja suunnitteleva ja tekevä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som planerar och gör ljudkomponenter i ett talinnehåll som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljuddesigner för tal</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puheen äänisuunnittelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5719">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bokkonstnär (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjataiteilija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5732"/>
    <skos:definition xml:lang="sv">Institution som är en konstnär, som svarar för utnyttjande av bokens form eller ändring av dess fysiska struktur.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10522"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bokkonstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="en">book artist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjataiteilija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m572">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">historieberättare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="en">storyteller</skos:altLabel>
    <skos:altLabel xml:lang="fi">tarinankertoja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare, som deltar i utförandet av ett uttryck genom att framföra en berättelse med en dramatisk eller teatralisk tolkning.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen kertomalla tarinan draamallisella tai teatraalisella tulkinnalla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20023"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">historieberättare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">storyteller agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tarinankertoja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5720">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esineeseen osallinen kuvanveistäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skulptör (person) som är bidragsgivare till föremål</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5425"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän kolmiulotteisen teoksen muovaamalla, veistämällä tai vastaavalla tekniikalla luonut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som skapat ett tredimensionellt verk som ingår i ett aggregat, genom att modellera, skära eller använda någon liknande teknik.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuvanveistäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skulptör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5721">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen tuotantosuunnittelija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">produktionsdesigner (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin liittyvän elokuvatuotannon visuaalisen kokonaisilmeen suunnitellut henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som planerat det visuella helhetsuttrycket i en filmproduktion som relaterar till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">produktionsdesigner</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuotantosuunnittelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5722">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5546"/>
    <skos:altLabel xml:lang="fi">edustava ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">representativt uttryck</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5457"/>
    <skos:definition xml:lang="fi">Ekspressio, jota pidetään kanonisena tietolähteenä teoksen identifioinnissa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som anses vara kanonisk informationskälla vid identifieringen av ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10346"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">edustava versio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">representativ version</skos:prefLabel>
    <skos:prefLabel xml:lang="en">representative expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5723">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelande aktör (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">taltioija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen käyttämällä tallennuslaitetta äänen tai videon taltioimiseen tallennustilanteessa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att använda en inspelningsapparat för att lagra ljud eller video vid ett inspelningstillfälle.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20358"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelande person</skos:prefLabel>
    <skos:prefLabel xml:lang="en">recordist person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taltioija</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Inbegriper fältinspelningar av naturljud, musikframföranden och andra evenemang.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää luonnonäänten, musiikkiesitysten ja muiden tapahtumien kenttä-äänitykset. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5724">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">maskeeraaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">maskör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att svara för maskering i en film, en musikal eller ett sceniskt verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen vastaamalla elokuvan, musikaalin tai näyttämöteoksen maskeerauksesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20459"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">makeup artist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maskeeraaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">maskör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5725">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5727"/>
    <skos:altLabel xml:lang="en">commentary in (expression)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression kommentaari</skos:altLabel>
    <skos:altLabel xml:lang="fi">kommentaari teoksessa (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommentar i verket (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommentar till uttrycket i</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5840"/>
    <skos:definition xml:lang="fi">Teos, joka on joukko selittäviä tai kriittisiä huomautuksia ekspressiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en mängd förklarande eller kritiska anmärkningar om ett uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20271"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">expression commentary in</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentar till versionen i</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">version kommentaari</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5726">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dockspelare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">nukettaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen käsittelemällä, kontrolloimalla tai ohjaamalla nukkeja tai marionetteja elokuvatuotannossa tai musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som deltar i utförandet av ett uttryck genom att hantera, kontrollera eller styra dockor eller marionetter i en filmproduktion eller ett musikaliskt eller sceniskt uppförande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20374"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dockspelare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">nukettaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">puppeteer person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5727">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5725"/>
    <skos:altLabel xml:lang="fi">kommentaari ekspressiosta</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommentar till uttrycket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5672"/>
    <skos:definition xml:lang="fi">Selittävien tai kriittisten huomautusten joukon perustana käytetty ekspressio. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som använts som grund för en samling förklarande eller kritiska anmärkningar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10282"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">commentary on expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kommentaari versiosta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentar till versionen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5728">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5433"/>
    <skos:altLabel xml:lang="sv">manifestation relaterad till verket</skos:altLabel>
    <skos:altLabel xml:lang="fi">teokseen liittyvä manifestaatio</skos:altLabel>
    <skos:definition xml:lang="fi">Manifestaatio, joka liittyy teokseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som relaterar till ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10309"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">material relaterat till verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related manifestation of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teokseen liittyvä aineisto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5729">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ohjaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">regissör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för den allmänna ledningen av ett filmat framträdande, ett radio- eller tv-program eller dylikt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10455"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">director person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">regissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m573">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30263"/>
    <skos:definition xml:lang="sv">Allmän bestämning som anger storleksförhållandet mellan en bild som förminskats till mikrostorlek och en ursprunglig bild, ur vilken den förminskade bilden producerats.</skos:definition>
    <skos:definition xml:lang="fi">Yleinen määrite, joka ilmaisee mikrokokoiseksi pienennetyn kuvan suhteen alkuperäiseen kuvaan, josta pienennetty kuva on tuotettu.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1209"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1279"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1360"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m503"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m574"/>
    <skos:prefLabel xml:lang="sv">Attribut till förminskningsgrad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Pienennyssuhteen määrite</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Reduction ratio designation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5730">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">skapare (person) av visuella effekter</skos:altLabel>
    <skos:altLabel xml:lang="fi">visuaalisten tehosteiden tekijä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu liikkuvan kuvan teoksen ekspression tekemiseen suunnittelemalla ja luomalla visuaaliset tehosteet jälkituotantovaiheessa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck av ett verk med rörlig bild, genom att planera och skapa visuella effekter i postproduktionsfasen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20361"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">skapare av visuella effekter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">visuaalisten tehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">visual effects provider person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5731">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arrangör av evenemang</skos:altLabel>
    <skos:altLabel xml:lang="sv">evenemangsarrangör (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">järjestäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">mötesarrangör</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som ordnar en konferens, en utställning eller något annat evenemang som ger upphov till ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10457"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">evenemangsarrangör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">järjestäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">organizer person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5732">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">konstnär (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">taiteilija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av en ursprunglig grafisk design, teckning, målning eller dylikt.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10545"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">artist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taiteilija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5733">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">illuminator (institution)</skos:altLabel>
    <skos:altLabel xml:lang="sv">illuminatör</skos:altLabel>
    <skos:altLabel xml:lang="fi">illuminoinnin tekijä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5697"/>
    <skos:definition xml:lang="sv">Institution som dekorerar ett enskilt exemplar genom att använda ädelmetaller eller färger, ofta i detaljerade mönster eller motiv.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka koristelee yksittäisen kappaleen käyttäen jalometalleja tai värejä, usein yksityiskohtaisissa kuvioissa tai motiiveissa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40132"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">illuminator</skos:prefLabel>
    <skos:prefLabel xml:lang="en">illuminator corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">illuminoinnin tekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5734">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">inspelande aktör (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen taltioija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää ääntä tai videota tallennuslaitteen avulla taltioiva henkilö. Esimerkiksi luonnonäänten, folkloren, musiikin tms. kenttätallennukset.</skos:definition>
    <skos:definition xml:lang="sv">Person som spelar in ljud eller video som ingår ett aggregat, med hjälp av en inspelningsapparat. T.ex. fältinspelningar av naturljud, folklore, musik eller dylikt.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelande person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taltioija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5735">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5660"/>
