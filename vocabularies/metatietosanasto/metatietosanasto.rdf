    <skos:altLabel xml:lang="fi">äänittäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5812"/>
    <skos:definition xml:lang="sv">Institution som är en ljudtekniker, som deltar i utförandet av ljudinnehållet i ett uttryck, genom att övervaka det tekniska utförandet av en ljudinspelning.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on ääniteknikko, joka osallistuu ekspression äänisisällön tekemiseen valvomalla äänityksen teknistä toteutusta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20504"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelningstekniker</skos:prefLabel>
    <skos:prefLabel xml:lang="en">recording engineer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänittäjä</skos:prefLabel>
  </owl:Class>
