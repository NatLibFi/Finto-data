    <skos:altLabel xml:lang="sv">ambassad</skos:altLabel>
    <skos:altLabel xml:lang="sv">beskickning</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaupallinen edustusto</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommersiell representation</skos:altLabel>
    <skos:altLabel xml:lang="fi">lähetystö</skos:altLabel>
    <skos:altLabel xml:lang="fi">suurlähetystö: konsulaatti</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhteystoimisto</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3435"/>
    <skos:definition xml:lang="sv">Om staters representation utomlands och motsvarande organ i internationella samarbetsorgan.</skos:definition>
    <skos:definition xml:lang="fi">Valtion edustuksesta ulkomailla ja kansainvälisissä yhteistyöelimissä vastaavat toimielimet.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">edustusto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">representation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4762">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40344"/>
    <skos:definition xml:lang="sv">Grundenhet vid artilleri.</skos:definition>
    <skos:definition xml:lang="fi">Komppaniaa vastaava tykistön perusyksikkö (Wikipedia).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">batteri</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">patteri</skos:prefLabel>
  </owl:Class>
