    <skos:definition xml:lang="sv">Enhet, kort, på vilket man kan skriva eller trycka meddelande, och som skickas per post utan kuvert.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, kortti, johon voi kirjoittaa tai painaa viestin ja lähettää postitse ilman kirjekuorta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1028"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">postcard</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">postikortti</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">postkort</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1376">
