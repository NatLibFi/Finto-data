    <skos:prefLabel xml:lang="sv">regional version</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5301">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljuddesigner (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">äänisuunnittelija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen suunnittelemalla ja luomalla äänikomponentteja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att planera och skapa ljudkomponenter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20343"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljuddesigner</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sound designer person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänisuunnittelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5302">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu sellaisen ekspression tekemiseen, joka on esitys. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett sådant uttryck som är ett framförande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20366"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (person) till framförande</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor person to performance</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">esitykseen osallinen henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5303">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dubbningsregissör (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen dubbausohjaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvää ääniraitaa täydentävän dialogin tai muiden äänien lisäämisen yleisestä johtamisesta ja valvonnasta vastaava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för allmän ledning och övervakning av tillägget av dialog eller andra röster, som kompletterar ett ljudspår som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">dubbausohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dubbningsregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5304">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arrangör (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sovittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5739"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett verks uttryck, genom att omarbeta kompositionen för en musikalisk besättning som avviker från originalverket.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu teoksen ekspression tekemiseen muokkaamalla sävellyksen alkuperäisteoksesta poikkeavalle esityskokoonpanolle. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20483"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">arranger corporate body of music</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">arrangör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En arrangör kan också bearbeta verket för samma musikaliska besättning eller dylikt och bevara originalkompositionens musikaliska innehåll till sina väsentliga delar oförändrade. I detta ingår inte omfattande ändringar som leder till skapandet av ett nytt musikverk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sovittaja voi myös muokata teosta samalle esityskokoonpanolle tms. säilyttäen alkuperäisen sävellyksen musiikillisen sisällön olennaisilta osin muuttumattomana. Tähän ei sisälly laaja muokkaaminen, joka johtaa uuden musiikkiteoksen luomiseen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5305">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">writer of added commentary</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of added lyrics</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of added text</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of afterword</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of foreword</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of introduction</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of postface</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of preface</skos:altLabel>
    <skos:altLabel xml:lang="en">writer of supplementary textual content</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5439"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen toimija, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Aktör som bidragit till ett aggregat och skapat ett uttryck av ett textverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30328"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till text</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent of text</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstiin osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5306">
