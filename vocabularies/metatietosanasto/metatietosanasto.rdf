    <skos:definition xml:lang="sv">Institution som bidragit till ett aggregat, genom att skapa ett uttryck av ett kartografiskt verk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30396"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
