    <skos:altLabel xml:lang="fi">musiikkiin osallinen miksaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä musiikissa ääniraitoja käsittelevä, miksaava tai yhdistelevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som behandlar, mixar och kombinerar ljudspår i musik som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">miksaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mixer</skos:prefLabel>
  </owl:Class>
