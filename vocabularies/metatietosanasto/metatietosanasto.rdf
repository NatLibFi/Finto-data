    <skos:altLabel xml:lang="sv">tv-regissör (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän TV-ohjelman yleisestä johtamisesta ja valvomisesta vastaava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för allmän ledning och övervakning av ett tv-program som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">televisio-ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-regissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5307">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">aktör relaterad till uttrycket</skos:altLabel>
