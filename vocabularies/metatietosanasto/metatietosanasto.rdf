    <skos:prefLabel xml:lang="en">Category of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Kategori av verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Teoksen kategoria</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Kategori av verk-termer används för att åtskilja olika verk med samma namn. För att ange en mer detaljerad genreindelning används &lt;a href="https://finto.fi/slm/sv/"&gt;Finländsk genre- och formlista (FGF)&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset. Kun tarvitset tarkempaa genrejaottelua käytä &lt;a href="https://finto.fi/slm/fi/"&gt;Suomalaista lajityyppi- ja muotosanastoa (SLM)&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m992">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
