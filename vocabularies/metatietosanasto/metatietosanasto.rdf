    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/a/P50022"/>
    <skos:altLabel xml:lang="fi">toimiala</skos:altLabel>
    <skos:altLabel xml:lang="sv">verksamhetsområde</skos:altLabel>
    <skos:definition xml:lang="en">A field of endeavor, area of competence, or responsibility in which a corporate body is engaged.</skos:definition>
    <skos:definition xml:lang="fi">Ala, jolla yhteisö toimii tai on toiminut, tai jonka asiantuntija tms. se on.</skos:definition>
    <skos:definition xml:lang="sv">Sektor inom vilken en institution fungerar eller har fungerat, eller inom vilken den är specialist.</skos:definition>
