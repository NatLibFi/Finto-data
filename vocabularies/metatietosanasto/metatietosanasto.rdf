    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">7 1/2 tum/s</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">7 1/2 tuumaa/s</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m92">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">akademisk avhandling</skos:altLabel>
    <skos:altLabel xml:lang="fi">diss.</skos:altLabel>
    <skos:altLabel xml:lang="sv">diss.</skos:altLabel>
    <skos:altLabel xml:lang="sv">dissertation</skos:altLabel>
    <skos:altLabel xml:lang="fi">väitösk.</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">doktorsavhandling</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">väitöskirja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m920">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fyrkanalsljud</skos:altLabel>
    <skos:definition xml:lang="sv">Ljudkanal bestående av fyra kanaler, för kvadrofoniskt ljud.</skos:definition>
    <skos:definition xml:lang="fi">Neljästä kanavasta koostuva kvadrofonisen äänen äänikanava.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/configPlayback/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kvadrofoninen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kvadrofonisk</skos:prefLabel>
    <skos:prefLabel xml:lang="en">quadraphonic</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m921">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Aineiston säilyttämiseen tarkoitettu kotelo, josta säilytettävä tallenne on fyysisesti erotettavissa.</skos:definition>
    <skos:definition xml:lang="sv">Fodral avsett för förvaring av material.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fodral</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kotelo</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m922">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Bestämning av generation för material som är en kombination av olika generationer och som därför inte kan beskrivas med en exaktare term.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolven määrite aineistolle, joka on eri sukupolvien yhdistelmä ja jota ei tästä syystä voida kuvata täsmällisemmällä termillä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blandad generation</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mixed generation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukupolvien yhdistelmä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m923">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Mediet innehåller stillbildspar och används med hjälp av en stereoskopisk eller -grafisk apparat för att uppnå en tredimensionell effekt.</skos:definition>
    <skos:definition xml:lang="fi">Viestin sisältää stillkuvapareja ja on tarkoitettu käytettäväksi stereoskooppisella tai stereografisella laitteella kolmiulotteisen vaikutelman saamiseksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMediaType/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">stereografinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stereografisk</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stereographic</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m93">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4296"/>
    <skos:altLabel xml:lang="fi">jäljenteenä</skos:altLabel>
    <skos:altLabel xml:lang="fi">jäljenteenä (manifestaatio)</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation jäljenne</skos:altLabel>
    <skos:altLabel xml:lang="sv">reproducerats som (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">som kopia</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4314"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on jäljenne toisesta manifestaatiosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en reproduktion av en annan manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30039"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1294"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m243"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4281"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4283"/>
    <skos:prefLabel xml:lang="fi">aineiston jäljenne</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reproduced as manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">reproduktion av materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m930">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">MPEG-1</skos:altLabel>
    <skos:altLabel xml:lang="sv">MPEG-1</skos:altLabel>
    <skos:altLabel xml:lang="fi">MPEG-2 Audio Layer III</skos:altLabel>
    <skos:altLabel xml:lang="sv">MPEG-2 Audio Layer III</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">MP3</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">MP3</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Kodningsformat för ljud, filändelse .mp3</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänen koodausmuoto, tiedostopääte .mp3</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m932">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka muodostuu Kerria Lacca -hyönteisnaaraan erittämästä hartsista, jota voidaan liuottaa etyylialkoholiin pensselillä levitettäväksi liuokseksi.</skos:definition>
    <skos:definition xml:lang="sv">Material som innehåller harts utsöndrat av lacksköldlusen (Kerria Lacca). Ämnet kan lösas i etylalkohol till en lösning som kan strykas ut med pensel.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1034"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">schellack</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sellakka</skos:prefLabel>
    <skos:prefLabel xml:lang="en">shellac</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m933">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Bestämning av generation för ett material som är en kopia avsedd för forskningsändamål.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolven määrite aineistolle, joka on tutkimuskäyttöön tehty kopio.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1018"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">katselukopio</skos:prefLabel>
    <skos:prefLabel xml:lang="en">viewing copy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">visningskopia</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m935">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">musical director</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikillinen johtaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkijohtaja</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikalisk ledare (aktör)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att koordinera kompositörers, ljudklippares och ljudmixares verksamhet i en filmproduktion eller i ett musikaliskt eller sceniskt uppförande.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20035"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">musical director agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikillinen johtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikalisk ledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m936">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kort filmremsa, oftast oböjlig istället för rullad.</skos:definition>
    <skos:definition xml:lang="fi">Lyhyt filmiliuska, yleensä jäykkä, ei rullattu.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1035"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">filmiliuska</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmremsa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">filmslip</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Bärare för projicerbara bilder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Heijastettava kuvatallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m938">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kartografiskt innehåll uttryckt som form eller former och avsett att användas genom beröring som en tredimensionell form eller former.</skos:definition>
    <skos:definition xml:lang="fi">Muotona tai muotoina esitetty kartografinen sisältö, joka on tarkoitettu kosketeltavaksi kolmiulotteiseksi muodoksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">cartographic tactile three-dimensional form</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kartografinen taktiili kolmiulotteinen muoto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kartografisk taktil tredimensionell form</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m939">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9664"/>
    <skos:definition xml:lang="sv">Manlig härskare i monarkisk stat (kungadöme).</skos:definition>
    <skos:definition xml:lang="fi">Monarkkisen valtion (kuningaskunnan) miespuolinen hallitsija.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kung</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuningas</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m940">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Kort med en eller flera öppningar för mikrofilmsbilder.</skos:definition>
    <skos:definition xml:lang="fi">Kortti, jossa on yksi tai useampi aukko mikrofilmikuvaa varten.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1021"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">aperture card</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fönsterkort</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ikkunakortti</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Mikroformsbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Mikromuotoinen tallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m941">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p7393"/>
    <skos:definition xml:lang="fi">Kahden tai useamman henkilön yhteenliittymä, joka on muodostettu liiketoiminnan harjoittamista varten (Kielitoimiston sanakirja). Yhtiöstä, jota ei ole alun perin perustettu harjoittamaan liiketoimintaa, käytetään myös muuta soveltuvaa termiä, esim. urheiluseura.</skos:definition>
    <skos:definition xml:lang="sv">Sammanslutning av två eller flera personer, som har bildats i syfte att bedriva affärsverksamhet. Om bolag som ursprungligen inte grundats för att utöva affärsverksamhet används även andra lämpliga termer, t.ex. idrottsförening.</skos:definition>
    <skos:example xml:lang="sv">Kajaani (bolag)</skos:example>
    <skos:example xml:lang="fi">Kajaani (yhtiö)</skos:example>
    <skos:example xml:lang="sv">Kaleva (förlagsaktiebolag)</skos:example>
    <skos:example xml:lang="sv">Kaleva (försäkringsbolag)</skos:example>
    <skos:example xml:lang="fi">Kaleva (kustannusosakeyhtiö).</skos:example>
    <skos:example xml:lang="fi">Kaleva (vakuutusyhtiö)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bolag</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhtiö</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Eri yhtiötyyppejä kuvaavia termejä käytetään, jos identifiointi vaatii.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Termer som beskriver olika bolagstyper används om de är nödvändiga för identifiering.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m942">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">besättning</skos:altLabel>
    <skos:altLabel xml:lang="sv">diskussionsgrupp</skos:altLabel>
    <skos:altLabel xml:lang="fi">elokuvakerho</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmklubb</skos:altLabel>
    <skos:altLabel xml:lang="sv">frimärksklubb</skos:altLabel>
    <skos:altLabel xml:lang="sv">grupp i sociala medier</skos:altLabel>
    <skos:altLabel xml:lang="sv">gäng</skos:altLabel>
    <skos:altLabel xml:lang="fi">harrastusryhmä</skos:altLabel>
    <skos:altLabel xml:lang="fi">henkilöstö</skos:altLabel>
    <skos:altLabel xml:lang="sv">hobbygrupp</skos:altLabel>
    <skos:altLabel xml:lang="fi">jengi</skos:altLabel>
    <skos:altLabel xml:lang="fi">joukkue</skos:altLabel>
    <skos:altLabel xml:lang="fi">kerho (ryhmä)</skos:altLabel>
    <skos:altLabel xml:lang="fi">keskusteluryhmä</skos:altLabel>
    <skos:altLabel xml:lang="fi">kirjallisuuspiiri (ryhmä)</skos:altLabel>
    <skos:altLabel xml:lang="sv">klubb (grupp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kollektiivi (ryhmä)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kollektiv (grupp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">konsortio</skos:altLabel>
    <skos:altLabel xml:lang="sv">konsortium</skos:altLabel>
    <skos:altLabel xml:lang="sv">konstnärskollektiv</skos:altLabel>
    <skos:altLabel xml:lang="sv">lag</skos:altLabel>
    <skos:altLabel xml:lang="fi">miehistö</skos:altLabel>
    <skos:altLabel xml:lang="sv">nätverk</skos:altLabel>
    <skos:altLabel xml:lang="fi">opetusryhmä</skos:altLabel>
    <skos:altLabel xml:lang="sv">personal</skos:altLabel>
    <skos:altLabel xml:lang="fi">postimerkkikerho</skos:altLabel>
    <skos:altLabel xml:lang="fi">seurue</skos:altLabel>
    <skos:altLabel xml:lang="fi">sosiaalisen median palvelun käyttäjäryhmä</skos:altLabel>
    <skos:altLabel xml:lang="sv">sällskap</skos:altLabel>
    <skos:altLabel xml:lang="fi">taiteilijakollektiivi</skos:altLabel>
    <skos:altLabel xml:lang="sv">team</skos:altLabel>
    <skos:altLabel xml:lang="fi">tiimi</skos:altLabel>
    <skos:altLabel xml:lang="fi">työyhteenliittymä</skos:altLabel>
    <skos:altLabel xml:lang="sv">undervisningsgrupp</skos:altLabel>
    <skos:altLabel xml:lang="fi">verkosto</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1127"/>
    <skos:definition xml:lang="fi">Pienimuotoinen jotain yhteistä tavoitetta tai tarkoitusta varten perustettu, yleensä tilapäisluonteinen yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Småskalig, vanligen tillfällig sammanslutning grundad för något gemensamt mål eller syfte.</skos:definition>
    <skos:example xml:lang="fi">Duudsonit (ryhmä)</skos:example>
    <skos:example xml:lang="sv">KAJ (grupp)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">grupp</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ryhmä</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används när det inte finns eller behövs någon mer exakt typ för gruppen. Om registrerade föreningar används främst termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m594'&gt;förening (registrerad)&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään kun määritelmän mukaiselle yhteisölle ei löydy tarkempaa tyyppiä tai sen käyttöä ei nähdä tarpeelliseksi. Rekisteröidyistä yhdistyksistä käytetään ensisijaisesti termiä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m594'&gt;yhdistys (rekisteröity)&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m944">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">linjeetsning</skos:altLabel>
    <skos:definition xml:lang="sv">Djuptrycksmetod, i vilken mönstret görs på en tryckplåt i metall som täckts med ett syrabeständigt ämne.</skos:definition>
    <skos:definition xml:lang="fi">Syväpainomenetelmä, jossa kuvio tehdään haponkestävällä aineella peitetylle metalliselle painolaatalle.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1006"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">etching</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">etsaus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">etsning</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m948">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Innehåll uttryckt med streck, former o.s.v., avsett att vidröras som tvådimensionell bild eller bilder.</skos:definition>
    <skos:definition xml:lang="fi">Viivoina, muotoina jne. esitetty sisältö, joka on tarkoitettu kosketeltavaksi kaksiulotteiseksi stillkuvaksi tai -kuviksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1015"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">tactile image</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taktiili kuva</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">taktil bild</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m951">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Dolby Laboratoriesin kehittämä sarja melunvaimennusjärjestelmiä käytettäväksi analogisessa magneettinauhassa.</skos:definition>
    <skos:definition xml:lang="sv">Serie brusreduceringssystem för analogt magnetband, utvecklad av Dolby Laboratories.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/specPlayback/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">Dolby</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Dolby</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Dolby</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m953">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">mikrokort (ogenomskinlig)</skos:altLabel>
    <skos:definition xml:lang="sv">Kort av ogenomskinligt material med mikrobilder.</skos:definition>
    <skos:definition xml:lang="fi">Läpinäkymätöntä materiaali oleva kortti, jolla on mikrovalokuvia.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1028"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">microopaque</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mikrofiche (ogenomskinlig)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mikrokortti (läpinäkymätön)</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Mikroformsbärare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Mikromuotoinen tallenne.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m955">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Inspelningsmedium för att lagra binärt kodad data på ett transparent medium med reflekterande bakgrund. Ändringar i reflektion avläses som en binär dataström, med laser.</skos:definition>
    <skos:definition xml:lang="fi">Tallennusmedia binäärisesti koodatun datan tallentamiseksi läpinäkyvälle välineelle, jolla on heijastava tausta. Heijastuksen muutokset tulkitaan binäärisenä datavirtana laserin avulla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/recMedium/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">optical</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">optinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">optisk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m956">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression haastattelija</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression haastattelija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">interviewer (expression)</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuare i uttryck</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuare i uttryck (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">version haastattelija</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att fungera som intervjuare, journalist, opinionsmätare eller någon annan aktör som samlar in uppgifter.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonain muuna toimijana, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20032"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastattelija (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">interviewer agent of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuare (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m96">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Erittäin suuri kirjasinkoko, joka on tarkoitettu auttamaan lukijoita, joilla on vaikeuksia lukea isotekstistä tekstiä.</skos:definition>
    <skos:definition xml:lang="sv">Fontstorlek avsedd för personer med synskada.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/fontSize/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erittäin suuri teksti</skos:prefLabel>
    <skos:prefLabel xml:lang="en">giant print</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mycket stor stil</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m960">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2291"/>
    <skos:altLabel xml:lang="fi">edeltäjä</skos:altLabel>
    <skos:altLabel xml:lang="fi">edeltäjä (teos)</skos:altLabel>
    <skos:altLabel xml:lang="sv">föregående (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2275"/>
    <skos:definition xml:lang="fi">Teos, joka on valmis diakroninen teos, jonka sisältöä jatkaa toinen diakroninen teoso. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett färdigt diakroniskt verk, vars innehåll ett annat diakroniskt verk fortsätter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10226"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">continuation of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">fortsättning på verket</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">jatkoa teokselle</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Detta element lämpar sig vanligen för successivt utkommande verk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvään teokseen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m962">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">coil bound</skos:altLabel>
    <skos:altLabel xml:lang="en">comb-bound</skos:altLabel>
    <skos:altLabel xml:lang="fi">rengaskirja</skos:altLabel>
    <skos:altLabel xml:lang="sv">ringpärm</skos:altLabel>
    <skos:definition xml:lang="sv">Sidorna är sammanbundna med en spiralrygg. Spiralryggen kan vara synlig eller övertäckt och gjord av t.ex. plast eller metall. Pärmarna kan vara hårda eller mjuka. Sidorna kan inte lösgöras från sprialryggen.</skos:definition>
    <skos:definition xml:lang="fi">Sivut liitetty yhteen kierreselällä. Kierteet voivat olla näkyvillä tai peitettynä. Kierteiden materiaalina voi olla esim. muovi tai metalli. Kansi voi olla kova-tai pehmeäkantinen. Sivuja ei saa irrotettua kierreselästä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kierreselkä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">spiral-bound</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">spiralrygg</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m963">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Glasnyckeln-priset delas årligen ut till den bästa nordiska kriminalromanen. Priset har delats ut sedan 1992. För att nomineras bör en bok vara tillgänglig på svenska, norska eller danska i originalspråk eller som översättning. Priset delas ut av Skandinaviska Kriminalsällskapet.</skos:definition>
    <skos:definition xml:lang="fi">Vuosittain myönettävä palkinto parhaalle pohjoismaiselle rikosromaanille. Palkinto on myönetty vuoden 1992 alkaen. Kirja hyväksytään ehdokkaaksi vain, mikäli se on luettavissa joko alkuperäisenä tai käännöksenä ruotsiksi, norjaksi tai tanskaksi. Palkinnon myöntää Skandinaviska Kriminalsällskapet.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Glasnyckeln, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Lasiavain-palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Glasnyckeln</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Lasiavain-palkinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m965">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">hederstecken</skos:altLabel>
    <skos:altLabel xml:lang="fi">mitali</skos:altLabel>
    <skos:definition xml:lang="sv">Enhet, tredimensionellt föremål av metall på vilket det finns reliefmönster på ena eller båda sidorna, och som är ämnat som minnessak.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, pienestä metallinpalasta muodostuva kolmiulotteinen esine, jossa on kohokuvio toisella tai molemmilla puolilla ja jolla on muistotarkoitus.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1020"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kunniamerkki</skos:prefLabel>
    <skos:prefLabel xml:lang="en">medal</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">medalj</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m967">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Filformat för lagring av elektroniskt textinnehåll.</skos:definition>
    <skos:definition xml:lang="fi">Tiedostotyyppi elektronisesti taltioidun tekstisisällön tallentamiseksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/fileType/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tekstitiedosto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">text file</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">textfil</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m968">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Windows Media</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Windows Media</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m97">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30208"/>
    <skos:definition xml:lang="fi">Liittää manifestaation manifestaation fyysiseen pohjamateriaaliin.</skos:definition>
    <skos:definition xml:lang="sv">Sammankopplar manifestation med manifestationens fysiska bottenmaterial.</skos:definition>
    <skos:prefLabel xml:lang="en">Base material</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Bottenmaterial</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Pohjamateriaali</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kuvailussa käytetään käsiteryhmässä &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m654'&gt;Materiaali&lt;/a&gt; olevia käsitteitä.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Vid beskrivning används begrepp ur begreppsgruppen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m654'&gt;Material&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
