    <skos:altLabel xml:lang="sv">försäljare</skos:altLabel>
    <skos:altLabel xml:lang="fi">myyjä (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">myyjä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">seller</skos:altLabel>
    <skos:altLabel xml:lang="sv">säljare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">säljare (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1743"/>
    <skos:definition xml:lang="fi">Kappaleen aiempi omistaja, joka myy kappaleen toiselle omistajalle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Tidigare ägare till ett exemplar, som säljer ett exemplar till ett en annan ägare.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
