    <skos:prefLabel xml:lang="sv">elektronikarbetare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4076">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">radanvartija</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2874"/>
    <skos:definition xml:lang="sv">Banvaktens uppgift var att sköta en viss, vanligen ca fem kilometer lång sträcka av en järnväg. Han såg till att spåret och korsningarna var i skick och överlag att bandelen fungerade.</skos:definition>
    <skos:definition xml:lang="fi">Ratavartijan tehtävänä oli hoitaa tiettyä tavallisesti noin viiden kilometrin pituista rataosuutta; hän huolehti siitä, että rata pysyi kunnossa, tasoristeysten laippaurat olivat puhtaat, naulat ja pultit kohdallaan ja muutenkin varmistaa rataosuuden toimivuus (Lähde: Wikipedia.)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">banvakt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ratavartija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4077">
