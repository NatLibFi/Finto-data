    <skos:definition xml:lang="sv">Institution som bildats ur en sammanslagning av två eller flera institutioner.</skos:definition>
    <skos:definition xml:lang="fi">Kahden tai useamman yhteisön yhdistymisestä muodostunut yhteisö. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">institution bildad genom sammanslagning</skos:prefLabel>
    <skos:prefLabel xml:lang="en">product of merger</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhdistymisestä muodostunut yhteisö</skos:prefLabel>
  </owl:Class>
