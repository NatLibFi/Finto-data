    <skos:prefLabel xml:lang="en">coin</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">metalliraha</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mynt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m103">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">medlem i betygskommitté</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu akateemisen opinnäytteen tai väitöskirjan tarkastuksen suorittavaan ryhmään. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i en grupp som utför granskning av ett akademiskt lärdomsprov eller en doktorsavhandling.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10284"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
