  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1266">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Fodral, som innehåller t.ex. grafikblad, bildkort e.d.</skos:definition>
    <skos:definition xml:lang="fi">Kotelo, joka sisältää esim. grafiikanlehtiä, kuvakortteja tms. (Kuvailusäännöt)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bildportfölj</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvasalkku</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1267">
