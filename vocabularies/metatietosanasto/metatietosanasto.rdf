  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1263">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen nauhan videoformaatti, jonka Electronic Industries Association of Japan kehitti ammattilaiskäyttöön vuonna 1969.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för analogt band, som Electronic Industries Association of Japan utvecklade för professionellt bruk år 1969.</skos:definition>
