    <skos:altLabel xml:lang="sv">deltagare (person) i paneldiskussion som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen panelisti (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvään keskusteluohjelmaan osallistuva henkilö. Paneelikeskusteluissa käsitellään eri aiheita usein niitä tuntevien asiantuntijoiden kesken.</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i ett diskussionsprogram som ingår i ett aggregat. I paneldiskussioner behandlas olika ämnen, ofta mellan experter i ämnena.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i paneldiskussion</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">panelisti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5638">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Släkt som relaterar till en institution.</skos:definition>
    <skos:definition xml:lang="fi">Suku, joka liittyy yhteisöön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50335"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4427"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4430"/>
    <skos:prefLabel xml:lang="en">related family of corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släkt relaterad till institutionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisöön liittyvä suku</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5639">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">collotypist corporate body</skos:altLabel>
    <skos:altLabel xml:lang="sv">framställare av ljustryck (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kollotypian valmistaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5654"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkning av en manifestation, genom att göra fotografiska avtryck direkt från härdad gelatinfilm eller annat material med bläckmottagande och bläckavvisande ytor.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation valmistamisesta tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30415"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">collotyper corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framställare av ljustryck</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kollotypian valmistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5640">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5251"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5336"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#isPatronOf"/>
    <skos:definition xml:lang="fi">Henkilö (esim. taiteilija), jota kuvailtava yhteisö tukee tai suosii.</skos:definition>
    <skos:definition xml:lang="sv">Person (t.ex. en konstnär) som stöds eller gynnas av en beskriven institution.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">is patron of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mecenat för</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mesenaattina</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5641">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m875"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4427"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4430"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5527"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5562"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5638"/>
    <skos:prefLabel xml:lang="sv">Institutioners relationer till släkter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Yhteisön suhteet sukuun</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5642">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmfotograf (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen kuvaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän liikkuvan kuvan joko digitaalisesti, filmille tai videolle tallentava henkilö. Voi hoitaa myös valaistuksen. Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi.</skos:definition>
    <skos:definition xml:lang="sv">Person som spelar in rörlig bild som ingår i ett aggregat antingen digitalt, på film eller på video. Kan även sköta belysning.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">filmfotograf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5643">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kompositör (institution) av videomusik</skos:altLabel>
    <skos:altLabel xml:lang="fi">videon musiikin säveltäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5350"/>
    <skos:definition xml:lang="en">A corporate body who is responsible for creating a video music work that complements a musical work.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av musik som kompletterar en video.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa videota täydentävän musiikin luomisesta.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer corporate body of video music work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör av videomusik</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">videon musiikin säveltäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5644">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">redaktionschef (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimituspäällikkö (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som har ett juridiskt eller kunskapsmässigt ansvar, men inte kreativt ansvar för ett diakroniskt verks redaktionella linje och innehåll.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10417"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editorial director person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redaktionschef</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimituspäällikkö</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte justering, förtydligande eller annan ändring av innehållet i ett verks uttryck.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5645">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">näyttelijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skådespelare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen näyttelemällä musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som bidrar till utförandet av ett uttryck, genom att skådespela i ett musikaliskt eller sceniskt uppförande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20369"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">actor person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">näyttelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skådespelare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5646">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5927"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5621"/>
    <skos:definition xml:lang="fi">Teos, jolla on laajennussuunnitelma, jota on muutettu peräkkäisestä päivittyväksi teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk med en utvidgningsplan som har ändrats från successiv till integrerande för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10380"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">peräkkäisversio teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sequential version of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">successiv version av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5647">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5422"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5576"/>
    <skos:definition xml:lang="fi">Teos, joka on kokoelmamanifestaation metatietokokonaisuus. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en metadatahelhet för en samlingsmanifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30463"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">finding aid</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förteckning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">luettelo</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5648">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5097"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen henkilö, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression.</skos:definition>
    <skos:definition xml:lang="sv">Person som bidragit till ett aggregat och skapat ett uttryck av ett stillbildsverk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30343"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (person) till stillbild</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor person of still image</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">stillkuvaan osallinen henkilö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5649">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5553"/>
    <skos:altLabel xml:lang="fi">arvostelu ekspressiosta</skos:altLabel>
    <skos:altLabel xml:lang="sv">recension av uttrycket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5518"/>
    <skos:definition xml:lang="fi">Ekspressio, jota on käytetty lyhyen arvioinnin perustana. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som använts för en kort bedömning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10280"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">arvostelu versiosta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">recension av versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">review of expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m565">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författarens signatur</skos:altLabel>
    <skos:altLabel xml:lang="sv">skaparens signatur</skos:altLabel>
    <skos:altLabel xml:lang="sv">upphovsmannens signatur</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">tekijän signeeraus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">upphovspersonens signatur</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5650">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5651"/>
    <skos:altLabel xml:lang="sv">beskrivning av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="en">described in (manifestation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation kuvaus</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaatiota kuvaava teos</skos:altLabel>
    <skos:altLabel xml:lang="sv">verk som beskriver manifestationen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5764"/>
    <skos:definition xml:lang="fi">Teos, joka kuvaa manifestaatiota. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som beskriver en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30254"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineistoa kuvaava teos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">manifestation described by</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">verk som beskriver materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5651">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5650"/>
    <skos:altLabel xml:lang="sv">beskrivning av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvaus manifestaatiosta</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5738"/>
    <skos:definition xml:lang="fi">Manifestaatio, jota teos kuvaa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som ett verk beskriver.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10271"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">beskrivning av materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">description of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaus aineistosta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5652">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">puhuja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">talare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare som deltar i utförandet av ett verks uttryck genom att tala ord.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu teoksen ekspression tekemiseen puhumalla sanoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20498"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puhuja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">speaker corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">talare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Inbegriper en föreläsning eller ett tal.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää luennon tai puheen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5653">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5300"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5377"/>
    <skos:definition xml:lang="fi">Teos, jolla on alueyleisö, jota on muutettu teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk med en regional målgrupp, som har ändrats för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10389"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alueversio teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">regional version av verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">regional version of</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5654">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">painolaatan valmistaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckplåtstillverkare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5323"/>
    <skos:definition xml:lang="sv">Institution som svarar för tillverkningen av en manifestation, genom att tillverka tryckplåtar eller dylikt, för användning vid tillverkningen av tryckta bilder eller texter.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa manifestaation valmistamisesta valmistamalla painettujen kuvien tai tekstin valmistuksessa käytettäviä painolaattoja tai -levyjä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30413"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">painolaatan valmistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">platemaker corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckplåtstillverkare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5655">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dirigent (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">johtaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare som deltar i utförandet av ett musikverks uttryck, genom att dirigera en uppträdande grupp i en musik- eller dramaföreställning.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20501"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">conductor corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dirigent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">johtaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5656">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">editor</skos:altLabel>
    <skos:altLabel xml:lang="en">editor agent of text</skos:altLabel>
    <skos:altLabel xml:lang="sv">redaktör (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">toimittaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5684"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att justera innehåll som skapats av andra aktörer, för att uppfylla utgivnings- och andra bruksstandarder.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20330"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">editor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">redaktör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Till innehåll hör rörelsenotation, taktil rörelsenotation, taktil musiknotation, taktil text och text.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5657">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">puhuja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">talare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu teoksen ekspression tekemiseen puhumalla sanoja. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som deltar i utförandet av ett verks uttryck genom att tala ord.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20380"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puhuja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">speaker person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">talare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Inbegriper en föreläsning eller ett tal.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää luennon tai puheen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5658">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">animaattori (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">animatör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i skapandet av ett uttryck genom att ge skenbar rörelse åt livlösa objekt eller teckningar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20394"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">animaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="en">animator person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">animatör</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske animaatiopiirrosten tekijää. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte skapare av animationsteckningar.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5659">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen opettaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">lärare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä AV-aineistossa opettava tai asiaa esittelevä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som undervisar eller förevisar en sak i AV-material som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lärare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opettaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m566">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Basmaterial bildat av icke-metalliska mineraler såsom lera, som bränts i hög temperatur med ett hårt och skört, värmetåligt och slitstarkt material som resultat.</skos:definition>
    <skos:definition xml:lang="fi">Epämetallisista mineraaleista kuten savesta muodostuva pohjamateriaali, joka on poltettu korkeassa lämpötilassa, tuloksena kova, hauras, kuumuuden ja kulutuksenkestävä materiaali.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">ceramic</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">keramiikka</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">keramik</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5660">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5735"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5389"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasPatron"/>
    <skos:definition xml:lang="sv">Institution som stöder eller gynnar en beskriven institution (t.ex. en konstnärsgrupp).</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka tukee tai suosii kuvailtavaa yhteisöä (esim. taiteilijaryhmää).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has patron</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mecenat</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">mesenaatti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5661">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förvaltare</skos:altLabel>
    <skos:altLabel xml:lang="sv">förvarare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">säilyttäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5779"/>
    <skos:definition xml:lang="sv">Institution som har juridisk förvaringsrätt till ett exemplar.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jolla on kappaleen laillinen säilyttämisoikeus. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40135"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">custodian corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">förvarare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säilyttäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5662">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">digitaaliseen sisältöön osallinen ohjelmoija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programmerare (institution) som är bidragsgivare till digitalt innehåll</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5298"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän digitaalisen sisällön yhteisötekijä.</skos:definition>
    <skos:definition xml:lang="sv">Upphovsinstitution till digitalt innehåll som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ohjelmoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programmerare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5663">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">lavastaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">scenograf (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att övervaka konstnärer och hantverkare som bygger kulisser för filmproduktioner.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen valvomalla taiteilijoita ja käsityöläisiä, jotka rakentavat lavasteita elokuvatuotantoihin. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20468"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">art director corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lavastaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">scenograf</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5664">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljudproducent (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">äänituottaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5326"/>
    <skos:definition xml:lang="sv">Institution som är en producent, som svarar för skötseln av de flesta kommersiella uppgifterna kring en ljudinspelning.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10515"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio producer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudproducent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänituottaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5665">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arrangör (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sovittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5548"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu teoksen ekspression tekemiseen muokkaamalla sävellyksen alkuperäisteoksesta poikkeavalle esityskokoonpanolle. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett verks uttryck, genom att omarbeta kompositionen för en musikalisk besättning som avviker från originalverket.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20365"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">arranger person of music</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">arrangör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovittaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En arrangör kan också bearbeta verket för samma musikaliska besättning eller dylikt och bevara originalkompositionens musikaliska innehåll till sina väsentliga delar oförändrade. I detta ingår inte omfattande ändringar som leder till skapandet av ett nytt musikverk.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sovittaja voi myös muokata teosta samalle esityskokoonpanolle tms. säilyttäen alkuperäisen sävellyksen musiikillisen sisällön olennaisilta osin muuttumattomana. Tähän ei sisälly laaja muokkaaminen, joka johtaa uuden musiikkiteoksen luomiseen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5666">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Släkt som relaterar till en släkt.</skos:definition>
    <skos:definition xml:lang="fi">Suku, joka liittyy sukuun. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50326"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">related family of family</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släkt relaterad till släkten</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukuun liittyvä suku</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5667">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deltagare (person) i paneldiskussion</skos:altLabel>
    <skos:altLabel xml:lang="sv">paneldeltagare</skos:altLabel>
    <skos:altLabel xml:lang="fi">panelisti (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som deltar i utförandet av ett uttryck, genom att delta i ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter inom ämnen som relaterar till diskussionen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20375"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i paneldiskussion</skos:prefLabel>
    <skos:prefLabel xml:lang="en">panelist person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">panelisti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5668">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">paperinvalmistaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">pappersmakare</skos:altLabel>
    <skos:altLabel xml:lang="sv">papperstillverkare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5972"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av papper som använts i en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30364"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">paperinvalmistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">papermaker person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">papperstillverkare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5669">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">aktör relaterad till manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="sv">annan aktör relaterad till manifestationen</skos:altLabel>
