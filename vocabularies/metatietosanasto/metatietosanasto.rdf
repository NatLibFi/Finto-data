    <skos:definition xml:lang="sv">Institution som deltar i skapandet av ett uttryck, genom att undersöka, planera, förverkliga eller testa en programvara.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen tutkimalla, suunnittelemalla, toteuttamalla tai testaamalla ohjelmistoa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20471"/>
