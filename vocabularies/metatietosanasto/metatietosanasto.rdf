    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4596"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4618"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4619"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5249"/>
