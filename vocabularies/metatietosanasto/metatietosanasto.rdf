    <skos:altLabel xml:lang="sv">bror</skos:altLabel>
    <skos:altLabel xml:lang="en">has brother</skos:altLabel>
    <skos:altLabel xml:lang="en">has sister</skos:altLabel>
    <skos:altLabel xml:lang="fi">sisar (sukulainen)</skos:altLabel>
    <skos:altLabel xml:lang="fi">sisko</skos:altLabel>
    <skos:altLabel xml:lang="sv">syster</skos:altLabel>
    <skos:altLabel xml:lang="fi">veli</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasSibling"/>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön sisarus, riippumatta biologisesta sukulaisuudesta.</skos:definition>
    <skos:definition xml:lang="sv">Syskon till en beskriven person, oberoende biologiskt släktskap.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has sibling</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sisarus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">syskon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4634">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
