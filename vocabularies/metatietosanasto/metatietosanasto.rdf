    <skos:prefLabel xml:lang="en">sculptor person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skulptör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5872">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kompositör (institution) av musik till tv-program</skos:altLabel>
