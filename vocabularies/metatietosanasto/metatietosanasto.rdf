    <skos:prefLabel xml:lang="en">language version</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">språkversion</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5802">
