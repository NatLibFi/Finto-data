    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3006"/>
    <skos:definition xml:lang="sv">Noggrant planerat arbete för att uppnå ett visst syfte.</skos:definition>
    <skos:definition xml:lang="fi">Projekti eli hanke on tarkkaan suunniteltu työ tietyn päämäärän saavuttamiseksi (Wikipedia).</skos:definition>
    <skos:example xml:lang="sv">Alkohol- och narkotikaundersökningen (projekt)</skos:example>
