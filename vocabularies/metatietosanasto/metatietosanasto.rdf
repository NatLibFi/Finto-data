  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m304">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Bestämning av generation för en bandkopia, vanligen originalets kopia i första generation, som används för att tillverka masskopior.</skos:definition>
    <skos:definition xml:lang="fi">Äänitteen sukupolven määrite nauhakopiolle, yleensä originaalin ensimmäisen sukupolven kopiolle, jota käytetään massakopioiden valmistamiseen.</skos:definition>
