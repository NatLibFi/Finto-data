    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasFosterParent"/>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön kasvattanut henkilö, joka ei ole tämän biologinen vanhempi.</skos:definition>
    <skos:definition xml:lang="sv">Person som fostrat en beskriven person, som inte är dennas biologiska förälder.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fosterförälder</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has foster parent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kasvattivanhempi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4633">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
