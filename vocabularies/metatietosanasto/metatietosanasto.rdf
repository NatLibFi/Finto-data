  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m656">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">blueprint</skos:altLabel>
    <skos:definition xml:lang="sv">Produktionsmetod, i vilken tryckning grundar sig på en kemisk reaktion i järnsalt, som ändrar opaka toner eller färger till vita på blå botten.</skos:definition>
    <skos:definition xml:lang="fi">Valmistusmenetelmä, jossa painatus perustuu rautasuolan kemialliseen reaktioon, joka muuttaa läpikuultamattomat sävyt tai värit valkoisiksi sinisellä pohjalla.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">blueprint process</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">blåkopia-metod</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sinikopiomenetelmä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m659">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">illustrationskartong</skos:altLabel>
    <skos:definition xml:lang="fi">Laminoidusta pahvista koostuva materiaali, jonka pintaan on liimattu paperikerroksia.</skos:definition>
    <skos:definition xml:lang="sv">Material bestående av laminerad papp, på vars yta papperslager har limmats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">illustration board</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">illustration board</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvituskartonki</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m66">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">temperafärg</skos:altLabel>
    <skos:definition xml:lang="fi">Materiaali, jossa on sekoitettuna väriainetta ja vesiliukoista yleensä tahmeaa sideainetta, kuten munankeltuaista, pysyväksi ja nopeasti kuivuvaksi maalausaineeksi.</skos:definition>
    <skos:definition xml:lang="sv">Material som innehåller en blandning av färgämne med ett vattenlösligt, ofta trögflytande bindeämne, såsom äggula, och som fungerar som en beständig och snabbtorkande målningsfärg.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1038"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">tempera</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tempera</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tempera</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m666">
