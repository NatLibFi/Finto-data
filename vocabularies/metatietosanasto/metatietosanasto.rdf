    <skos:definition xml:lang="fi">Kuvailtavan henkilön sisarus, joka on syntynyt saman raskauden tuloksena. Koskee kaksosia, kolmosia ja muita monikkolapsia.</skos:definition>
    <skos:definition xml:lang="sv">Syskon till en beskriven person, som har fötts ur samma graviditet. Gäller tvillingar, trillingar och andra flerlingsbarn.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">flerling</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has multiple birth sibling</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">monikkosisarus</skos:prefLabel>
  </owl:Class>
