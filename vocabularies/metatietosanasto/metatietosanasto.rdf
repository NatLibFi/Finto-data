    <skos:prefLabel xml:lang="sv">bilaga till versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liite teoksen versioon</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar referenslistor, statistiktabeller och förklaringar, som inte är nödvändiga för att innehållet ska vara fullständigt.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Sisältää viitelistat, tilastolliset taulukot ja selitykset, jotka eivät ole välttämättömiä, jotta sisältö olisi täydellinen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4264">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
