  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4816">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4324"/>
    <skos:altLabel xml:lang="sv">införlivat delvis i uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="fi">sulautunut osittain ekspressioon</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppgått delvis i uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="sv">uppgått delvis i versionen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2286"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisältöön toisen teoksen ekspression osittainen sisältö on yhdistynyt. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk, med vars innehåll ett annat verks uttrycks innehåll delvis har införlivats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20144"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">absorbed in part by expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">införlivat delvis i versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sulautunut osittain teoksen versioon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m483">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Vuoden historiateos -palkinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">Årets historieverk-priset</skos:altLabel>
    <skos:definition xml:lang="fi">Historian Ystäväin Liiton vuodesta 1973 palkitsema teos, joka on ”erittäin ansiokkaasti edistänyt historiallisen tietämyksen laajenemista ja syvenemistä suomalaisen yleisön keskuudessa”. Vuoden historiateos julkistetaan helmikuisilla Historiapäivillä.</skos:definition>
    <skos:definition xml:lang="sv">Sedan 1973 har Historievännernas förbund premierat verk som förtjänstfullt bidragit till en ökad och fördjupad historisk insikt hos den finska publiken. Årets historieverk tillkännages i februari under Historiedagarna.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Årets historieverk, 2019</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Vuoden historiateos, 2019</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Vuoden historiateos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Årets historieverk</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4843">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">flexband</skos:altLabel>
    <skos:altLabel xml:lang="fi">flexikantinen</skos:altLabel>
    <skos:altLabel xml:lang="sv">inbunden, mjuka pärmar</skos:altLabel>
    <skos:altLabel xml:lang="en">paperback</skos:altLabel>
    <skos:altLabel xml:lang="fi">sidottu, pehmeäkantinen</skos:altLabel>
    <skos:definition xml:lang="sv">Böjlig, ofta häftad. Mjuka pärmar, gjorda av t.ex. ytbehandlat papper eller kartong. Inkluderar också tyg-, bad- och mjukisböcker.</skos:definition>
    <skos:definition xml:lang="fi">Taipuisa, usein nidottu. Pehmeät kannet. Pehmeäkantisen kirjan kannet ovat esim. pintakäsiteltyä paperia tai kartonkia. Sisältää myös kangaskirjat, kylpykirjat ja pehmokirjat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">mjuka pärmar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pehmeäkantinen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">softcover</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4844">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">hardback</skos:altLabel>
    <skos:definition xml:lang="sv">Oböjlig, ofta inbunden. Hårda pärmar, gjorda av överdragen papp. Inkluderar också böcker med pappsidor.</skos:definition>
    <skos:definition xml:lang="fi">Taipumaton, usein sidottu. Kovat kannet. Kovakantisen kirjan kannet ovat päällystettyä pahvia. Sisältää myös pahvisivuiset kirjat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">hardcover</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">hårda pärmar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kovakantinen</skos:prefLabel>
  </owl:Class>
