  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5261">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen laulaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångare (institution) som är bidragsgivare till musik</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä musiikissa ääntään käyttämällä, säestyksellä tai ilman, esiintyvä yhteisö. Lauluesitys voi sisältää tai olla sisältämättä todellisia sanoja.</skos:definition>
    <skos:definition xml:lang="sv">Institution som uppträder i musik som ingår i ett aggregat, genom att använda sin röst, med eller utan ackompanjemang. Sångframförandet kan vara med eller utan riktiga ord.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laulaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5262">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5263"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5969"/>
    <skos:definition xml:lang="fi">Teos, jota on tutkittu tai arvioitu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har undersökts eller evaluerats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10153"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">arviointi teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">evaluation of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">evaluering av verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5263">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5262"/>
    <skos:altLabel xml:lang="fi">arvioitu teoksessa</skos:altLabel>
    <skos:altLabel xml:lang="en">evaluated in (work)</skos:altLabel>
    <skos:altLabel xml:lang="sv">evaluerad i verket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5397"/>
    <skos:definition xml:lang="fi">Teos, joka tutkii tai arvioi teosta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som undersöker eller evaluerar ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10120"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">evaluering av verket i</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen arviointi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">work evaluated by</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5264">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Henkilö, joka liittyy henkilöön. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är relaterad till en person.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50316"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1801"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1802"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4409"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4411"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4417"/>
    <skos:prefLabel xml:lang="fi">henkilöön liittyvä henkilö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">person relaterad till personen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related person of person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5265">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">instrumentalist (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">soittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare, som deltar i utförandet av ett uttryck genom att spela ett instrument.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20494"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">instrumentalist</skos:prefLabel>
    <skos:prefLabel xml:lang="en">instrumentalist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">soittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5266">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esittäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">framförare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck genom att framföra musik, skådespela, dansa, tala, eller fungera i andra roller, ofta i ett musikaliskt eller dramatiskt framförande.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla ja muissa rooleissa usein musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20469"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framförande institution</skos:prefLabel>
    <skos:prefLabel xml:lang="en">performer corporate body</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5267">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">konstnär (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">taiteilija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för skapandet av en ursprunglig grafisk design, teckning, målning eller dylikt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10451"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">artist person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konstnär</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taiteilija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5268">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5502"/>
    <skos:altLabel xml:lang="en">facsimile (item)</skos:altLabel>
    <skos:altLabel xml:lang="sv">faksimil (exemplar)</skos:altLabel>
    <skos:altLabel xml:lang="fi">näköispainos (kappale)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5484"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka jäljentää tarkalleen toista manifestaatiota edustavan kappaleen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som exakt reproducerar ett exemplar som representerar en annan manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40089"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">facsimile of item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">faksimil av exemplaret</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kappaleen näköispainos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5269">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5393"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m608"/>
    <skos:definition xml:lang="fi">Kokoelmateoksen manifestaatio, joka sisältyy toisen kokoelmateoksen manifestaatioon erillisenä osana. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation av samlingsverk, som ingår som en separat del av en manifestation av ett annat samlingsverk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30459"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">alakokoelma kokoelmassa</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">delsamling i samlingen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">subcollection of</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m527">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">laulaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">laulaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">singer</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sångare (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare, som deltar i utförandet av ett uttryck, genom att använda sin röst, med eller utan instrumentalackompanjemang, för att producera musik.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20025"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">laulaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">singer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sångare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Sångarens framförande kan vara med eller utan riktiga ord.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5270">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (institution) till textverk</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiteoksen kirjoittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5497"/>
    <skos:definition xml:lang="en">A corporate body who is responsible for creating a textual work that complements a work.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av en text som kompletterar ett annat verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa toista teosta täydentävän tekstin luomisesta.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">author corporate body of textual work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">författare till textverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tekstiteoksen kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5271">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5742"/>
    <skos:altLabel xml:lang="en">digital transfer (item)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konverterad (exemplar)</skos:altLabel>
    <skos:altLabel xml:lang="fi">konvertoinnin tulos (kappale)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5484"/>
    <skos:definition xml:lang="fi">Digitaalisessa muodossa oleva manifestaatio, joka on tulosta toisessa digitaalisessa muodossa olevan kappaleen muunnoksesta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation i digital form, som är resultat av en konvertering av en manifestation i en annan digital form.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40087"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">digital transfer of item</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konverterad</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">konvertoinnin tulos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5272">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">televisio-ohjaaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-regissör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5949"/>
    <skos:definition xml:lang="sv">Institution som är en regissör, som svarar för allmän ledning och övervakning av ett tv-program.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on ohjaaja, joka on vastuussa televisio-ohjelman yleisestä johtamisesta ja valvonnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10514"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">televisio-ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">television director corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-regissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5273">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arkitekt (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">arkkitehti (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som ansvarar för skapandet av en arkitektplan, inklusive en bildpresentation över hur en byggnad eller en annan konstruktion ska se ut när den är färdig.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10438"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">architect person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">arkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">arkkitehti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5274">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">mottagare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">vastaanottaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5574"/>
    <skos:definition xml:lang="sv">Institution till vilken ett verk eller en del av ett verk har riktats.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, jolle teos tai teoksen osa on osoitettu. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10507"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">addressee corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mottagare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vastaanottaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5275">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5439"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen toimija, joka on luonut aggregaattiin sisältyvän digitaalisen sisällön ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Aktör som bidragit till ett aggregat och som skapat ett uttryck med digitalt innehåll som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30333"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till digitalt innehåll</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent of computer content</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">digitaaliseen sisältöön osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5276">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">musiikkiohjelmoija (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">musikprogrammerare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Aktör som deltar i skapandet av ett musikverks uttryck, genom att producera ljud med elektriska ljudenheter eller datorprogram.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu musiikkiteoksen ekspression tekemiseen tuottamalla ääniä sähköisillä äänilaitteilla tai tietokoneohjelmilla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20480"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">music programmer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikkiohjelmoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musikprogrammerare</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ei koske uuden musiikkiteoksen luomista. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Gäller inte skapandet av ett nytt musikverk.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5277">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmregissör (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen elokuvaohjaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän elokuvan yleisestä johtamisesta ja valvomisesta vastaava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för allmän ledning och övervakning av en film som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvaohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5278">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">creator</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare (aktör) av verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen tekijä (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5482"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa teoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10065"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1042"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1298"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1328"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1486"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1617"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1760"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1978"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m25"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3566"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3569"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3577"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3580"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3581"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m38"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m397"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m511"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m534"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m552"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m695"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m713"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m758"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m767"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m986"/>
    <skos:prefLabel xml:lang="en">creator agent of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen tekijä</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Innefattar aktörer som gemensamt svarar för skapandet av ett verk, antingen genom att fungera i samma roll som en annan aktör, såsom i samarbete mellan två författare, eller genom att fungera i olika roller, såsom i samarbete mellan en kompositör och en textförfattare.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5279">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">colorist corporate body</skos:altLabel>
    <skos:altLabel xml:lang="sv">färgläggare (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">värittäjä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5805"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck, genom att färglägga ritningar, råkopior, fotografier, kartor, rörliga bilder eller annat innehåll.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, liikkuvia kuvia tai muuta sisältöä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20458"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">colourist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">färgläggare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">värittäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m528">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Material som består av vätska eller kräm som innehåller färgämnen.</skos:definition>
    <skos:definition xml:lang="fi">Väriaineita sisältävästä nesteestä tai tahnasta muodostuva materiaali.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1017"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bläck</skos:prefLabel>
    <skos:prefLabel xml:lang="en">ink</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muste</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5280">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">intervjuare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen haastattelija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvään liikkuvan kuvan aineistoon tietoa keräävä yhteisö. Haastattelee, raportoi, tekee kyselytutkimusta tai kerää ihmisiltä tietoa muulla tavoin.</skos:definition>
    <skos:definition xml:lang="sv">Institution som samlar information till material med rörlig bild som ingår i ett aggregat, genom att intervjua, rapportera, göra gallup eller på annat sätt samla in uppgifter från människor.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastattelija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5281">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen erikoistehosteiden tekijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare av specialeffekter (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvien liikkuvan kuvan tai äänen taltiointien erikoistehosteet (esim. mekaaniset tehosteet ja kameralla toteutettavat optiset tehosteet) tekevä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som skapar specialeffekter (t.ex. mekaniska effekter och optiska effekter skapade med kamera) i inspelningar av rörlig bild eller ljud, som ingår i aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erikoistehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av specialeffekter</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5282">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">distributör (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">jakelija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5972"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa julkaistun manifestaation jakelusta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för distributionen av en publicerad manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30359"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">distributor person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">distributör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">jakelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5283">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bidragsgivare (person) till koreografi</skos:altLabel>
    <skos:altLabel xml:lang="en">contributor person of choreography</skos:altLabel>
    <skos:altLabel xml:lang="fi">koreografiaan osallinen henkilö</skos:altLabel>
