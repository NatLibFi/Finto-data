    <skos:scopeNote xml:lang="fi">Monikossa: suunnitelmia, xx suunnitelmaa</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4351">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Digitaalisesti koodattuna datana esitetty kartografinen sisältö, joka on tarkoitettu tietokoneen käsiteltäväksi.</skos:definition>
    <skos:definition xml:lang="sv">Kartografiskt innehåll presenterad som digitalt kodad data, vilken är avsedd att behandlas av dator.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1001"/>
