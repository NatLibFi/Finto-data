  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4764">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">aikuisopisto</skos:altLabel>
    <skos:altLabel xml:lang="sv">arbetarinstitut</skos:altLabel>
    <skos:altLabel xml:lang="sv">folkhögskola</skos:altLabel>
    <skos:altLabel xml:lang="fi">kansalaisopisto</skos:altLabel>
    <skos:altLabel xml:lang="fi">kansanopisto</skos:altLabel>
    <skos:altLabel xml:lang="fi">kesäyliopisto</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikunnan koulutuskeskus</skos:altLabel>
    <skos:altLabel xml:lang="sv">medborgarinstitut</skos:altLabel>
    <skos:altLabel xml:lang="fi">opintokeskus</skos:altLabel>
    <skos:altLabel xml:lang="sv">sommaruniversitet</skos:altLabel>
    <skos:altLabel xml:lang="sv">studiecenter</skos:altLabel>
    <skos:altLabel xml:lang="fi">työväenopisto</skos:altLabel>
    <skos:altLabel xml:lang="fi">vapaaopisto</skos:altLabel>
    <skos:altLabel xml:lang="sv">vuxeninstitut</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11391"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12167"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12168"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12169"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12915"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p21208"/>
    <skos:definition xml:lang="sv">Läroanstalt inom fritt bildningsarbete som ger allmänbildande eller specialiserad undervisning.</skos:definition>
    <skos:definition xml:lang="fi">Yleissivistävää tai erikoisalan opetusta tai ammattikoulutusta antavia vapaansivistystyön oppilaitoksia (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">institut</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opisto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4765">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Maistraatit olivat vuoteen 1978 asti niin sanottujen vanhojen kaupunkien, eli ennen vuotta 1959 perustettujen kaupunkien, virastoja, jotka ratkaisivat mm. lupa-asioita ja joilla oli toimivaltaa järjestysasioissa. Maistraatti toimi myös ulosotonhaltijana ja suoritti kiinteistöjen pakkohuutokaupat alueellaan sekä toimi muutoksenhakuelimenä kaupunginvoutien ratkaisuihin (Arkistojen portti).</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Ämbetsverk i städer fram till år 1978 som bl.a. avgjorde tillståndsärenden och som hade befogenheter i ordningsmål etc. Magistrater fungerade också som överexekutor och utförde exekutiva auktioner av fastigheter på sina områden, samt fungerade som besvärsinstans för statsfogdars avgöranden.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">magistrat</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maistraatti</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4768"/>
    <skos:scopeNote xml:lang="sv">Används inte om magistrat som grundades i samband med häradsreformen år 1996.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Ei käytetä vuoden 1996 kihlakuntauudistuksen myötä perustetuista maistraateista.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4766">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">familjecentral</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4668"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p23383"/>
    <skos:definition xml:lang="sv">Samordnat servicenätverk för barn, ungdomars och familjers välmående och hjälpbehov, som fungerar och leds som en helhet.</skos:definition>
    <skos:definition xml:lang="fi">Yhteensovitettu lasten, nuorten ja perheiden hyvinvoinnin ja avuntarpeisiin vastaava palveluverkosto, joka toimii ja jota johdetaan yhtenä kokonaisuutena.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">familjecenter</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">perhekeskus</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4767">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljudinspelningsstudio</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p29982"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">inspelningsstudio</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">äänitysstudio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4768">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p18601"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Järjestysoikeus oli yleistä hallintoa, järjestystä ja taloutta käsittelevä julkinen hallintoviranomainen ja tuomioistuin Suomen kauppaloissa sekä vuodesta 1960 lähtien myös uusissa kaupungeissa, joissa ei ollut raas­tuvan­oikeutta eikä maistraattia (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Offentlig förvaltningsmyndighet och domstol som skötte allmän förvaltning, ordning och ekonomi i finländska köpingar, och fr.o.m. år 1960 också i nya städer som inte hade rådstuvurätt eller magistrat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">järjestysoikeus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ordningsrätt</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4765"/>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4769">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">fiskelag</skos:altLabel>
    <skos:altLabel xml:lang="fi">jakokunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">kalastuskunta</skos:altLabel>
    <skos:altLabel xml:lang="sv">skifteslag</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p13414"/>
    <skos:definition xml:lang="fi">Kiinteistön omistajat, jotka omistavat yhteisen vesi- tms. alueen.</skos:definition>
    <skos:definition xml:lang="sv">Ägare till en fastighet, som tillsammans äger ett gemensamt vatten- eller annat dylikt område.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">delägarlag</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">osakaskunta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4770">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2978"/>
    <skos:definition xml:lang="fi">Kulloinkin istuva ylintä toimeenpanovaltaa valtiossa käyttävä elin, joka Suomessa nimetään pääministerin mukaan. Voidaan käyttää myös itsehallintoalueen ja osavaltion hallituksesta.</skos:definition>
    <skos:definition xml:lang="sv">Organ med högsta verkställande makt i en stat, som i Finlands namnges efter statsministern. Kan även användas om regering för autonomt område eller delstat.</skos:definition>
    <skos:example xml:lang="sv">Kekkonens tredje regering</skos:example>
    <skos:example xml:lang="fi">Kekkosen III hallitus</skos:example>
    <skos:example xml:lang="fi">Sanna Marinin hallitus</skos:example>
    <skos:example xml:lang="sv">Sanna Marins regering</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">hallitus (valtion hallitus)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">regering</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4771">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">avoin yhtiö</skos:altLabel>
    <skos:altLabel xml:lang="fi">kommandiittiyhtiö</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommanditbolag</skos:altLabel>
    <skos:altLabel xml:lang="sv">öppet bolag</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m941"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p15849"/>
    <skos:definition xml:lang="sv">Företagsform som grundar sig på samverkan mellan två eller flera juridiska eller naturliga personer, och som karakteriseras av bolagets självständighet, bolagsmännens personliga deltagande i bolagets verksamhet och deras obegränsade ansvar för bolagets åligganden, samt det specifika ekonomiska syfte som bolaget har.</skos:definition>
    <skos:definition xml:lang="fi">Kahden tai useamman oikeushenkilön tai luonnollisen henkilön yhteistoimintaan perustuva yritysmuoto, jolle on tunnusomaista yhtiön itsenäisyys (henkilöyhtiö on omistajistaan erillinen oikeussubjekti), yhtiömiesten henkilökohtainen osallistuminen yhtiön toimintaan ja heidän rajaton vastuunsa yhtiön velvoitteista sekä yhtiöllä oleva tietty taloudellinen tarkoitus. (Tieteen termipankki.)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">henkilöyhtiö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">personbolag</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4772">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p3448"/>
    <skos:definition xml:lang="fi">Kanavan toiminnasta vastaava viranomainen, joka on nimetty kanavan mukaan.</skos:definition>
    <skos:definition xml:lang="sv">Myndighet som ansvarar för en kanals verksamhet, och som är namngiven enligt kanalen.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kanal</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kanava</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4773">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">havsfort</skos:altLabel>
    <skos:altLabel xml:lang="fi">merilinnake</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p20695"/>
    <skos:definition xml:lang="fi">Merivoimien rannikkojoukkojen sotilasyksikkö (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Militär enhet för marinens kuststyrkor.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fort</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">linnake</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4774">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m197"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p26954"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">flickkör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tyttökuoro</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4775">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kaupanvahvistaja (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">köpvittne (institutionstyp)</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p13797"/>
    <skos:definition xml:lang="fi">Julkinen kaupanvahvistaja. Viranomainen, joka kutsumansa todistajan kanssa todistaa oikeaksi kiinteistön luovutuskirjan (Kielitoimiston sanakirja).</skos:definition>
    <skos:definition xml:lang="sv">Offentligt köpvittne. Myndighet som med kallat vittne bestyrker en fastighets överlåtelsebrev.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kaupanvahvistaja (viranomainen)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">köpvittne (myndighet)</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Används om en person som fungerar i myndighetsställning och som institution.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään viranomaisasemassa toimivasta henkilöstä, jonka tulkitaan toimivan yhteisönä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4776">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kansalaiskoulu</skos:altLabel>
    <skos:altLabel xml:lang="sv">medborgarskola</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p2182"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Kansakoulu oli Suomessa aluksi nelivuotinen oppilaitos, joita alettiin perustaa vuoden 1866 kansakouluasetuksen myötä. Asetuksen mukaan kaupungit velvoitettiin perustamaan kansakouluja, mutta maaseudulla kunta sai päättää. 1800-luvun loppupuolella ja 1900-luvun alkupuolella kiertokoulut olivat maaseudulla tärkeitä. Vuonna 1921 tuli voimaan oppivelvollisuuslaki, jolloin kansakoulu muuttui kuusivuotiseksi ja kiertokoulut lakkautettiin. Kansakoulut lakkautettiin peruskoulu-uudistuksen yhteydessä 1970-luvulla. (Wikipedia.)</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Folkskolan var i Finland till en början en fyraårig skola som började grundas i samband med folkskolförordningen år 1866. Enligt förordningen ålades städerna att grunda folkskolor, men på landsbygden fick kommunerna bestämma själva. Kring sekelskiftet var ambulatoriska skolor viktiga på landsbygden. År 1921 trädde lagen om läroplikt i kraft och då blev folkskolan sexårig och de ambulatoriska skolorna upphävdes. Folkskolorna upphävdes i samband med grundskolereformen på 1970-talet.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">folkskola</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kansakoulu</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Termen används även om medborgarskolor, som var en fortsättning på den egentliga folkskolan.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Yhteisötermiä käytetään myös kansalaiskouluista, joka on varsinaisen kansakoulun jatkokoulu.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4777">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">seminaari (opettajaseminaari)</skos:altLabel>
    <skos:altLabel xml:lang="sv">seminarium (lärarseminarium)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Kansakoulunopettajien opettajanvalmistuslaitoksesta käytetty nimitys 1863-1973.</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Benämning på inrättning för folkskollärarutbildning år 1863-1973.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">lärarseminarium</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opettajaseminaari</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4778">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">administrativ socken</skos:altLabel>
    <skos:altLabel xml:lang="fi">hallintopitäjä</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaupunki (hallintoalue)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ort (förvaltningsområde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">paikkakunta (hallintoalue)</skos:altLabel>
    <skos:altLabel xml:lang="sv">stad (förvaltningsområde)</skos:altLabel>
    <skos:definition xml:lang="fi">Valtakunnallisen tai alueellisen organisaation paikallishallinnon yksikölle määritelty toimialue, esim. yhden kunnan alue.</skos:definition>
    <skos:definition xml:lang="sv">Verksamhetsområde för en lokal förvaltningsenhet inom en nationell eller regional organisation, t.ex. en kommuns område.</skos:definition>
    <skos:example xml:lang="sv">Kouvola skattebyrå; Suomussalmi forstrevir; Tuusniemi post- och telegrafkontor</skos:example>
    <skos:example xml:lang="fi">Kouvolan verotoimisto; Suomussalmen metsänhoitoalue; Tuusniemen posti- ja lennätintoimisto</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">kommun (förvaltningsområde)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kunta (hallintoalue)</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m358"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4703"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4878"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5054"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m604"/>
    <skos:scopeNote xml:lang="sv">Kan användas utöver en kategori av institution, för att precisera att den offentligrättsliga institutionen i fråga är en lokal organisation.  &#xD;
&#xD;
Om kommunalförvaltningens organisationer kan också termerna [http://urn.fi/URN:NBN:fi:au:mts:m604] och [http://urn.fi/URN:NBN:fi:au:mts:m358] användas som kategori av institution för precisera institutionens form.&#xD;
&#xD;
Om samkommun används termen [http://urn.fi/URN:NBN:fi:au:mts:m4703] som kategori av institution. &#xD;
&#xD;
Om församling används termen [http://urn.fi/URN:NBN:fi:au:mts:m4676] som kategori av institution.&#xD;
&#xD;
Om kyrklig samfällighet används termen [http://urn.fi/URN:NBN:fi:au:mts:m4747] som kategori av institution.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Voidaan käyttää valitun yhteisön kategorian lisäksi täsmentämään, että ko. julkishallinnollinen yhteisö on paikallinen organisaatio.&#xD;
&#xD;
Kunnallishallinnon organisaatioista voi käyttää myös yhteisön muotoa tarkentavia yhteisön kategorian termejä [http://urn.fi/URN:NBN:fi:au:mts:m604] ja [http://urn.fi/URN:NBN:fi:au:mts:m358].&#xD;
&#xD;
Kuntayhtymästä käytä yhteisön kategorian termiä [http://urn.fi/URN:NBN:fi:au:mts:m4703]. &#xD;
&#xD;
Seurakunnasta käytä yhteisön kategorian termiä [http://urn.fi/URN:NBN:fi:au:mts:m4676].&#xD;
&#xD;
Seurakuntayhtymistä käytä yhteisön kategorian termiä [http://urn.fi/URN:NBN:fi:au:mts:m4747].</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4779">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">julkisoikeudellinen laitos</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4669"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p8675"/>
    <skos:definition xml:lang="fi">Jonkin ministeriön alainen, valtakunnallinen viranomainen tai erillislaitos.</skos:definition>
    <skos:definition xml:lang="sv">Nationell myndighet eller fristående institution, som befinner sig under ett ministerium.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">centralt ämbetsverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">keskusvirasto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m478">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Används för ljud avsedda att lyssna på, t.ex. naturljud och ljud framställda på konstgjort sätt. Används inte för tal och musik.</skos:definition>
    <skos:definition xml:lang="fi">Kuunneltavaksi tarkoitettu muu äänisisältö kuin puhe tai musiikki. Sisältää esim. luonnonäänet, keinotekoisesti tuotetut äänet jne.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1012"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ljud</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sounds</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääni</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4780">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4686"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p15484"/>
    <skos:definition xml:lang="sv">Organisation i statens ägo, som utövar affärsverksamhet.</skos:definition>
    <skos:definition xml:lang="fi">Valtion omistama liiketoimintaa harjoittava organisaatio.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">statligt affärsverk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valtion liikelaitos</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4781">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40339"/>
    <skos:definition xml:lang="fi">Historiallinen termi. Ratsuväen perusyksikkö.</skos:definition>
    <skos:definition xml:lang="sv">Historisk term. Grundenhet vid kavalleri.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">eskadroona</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skvadron</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4782">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40338"/>
    <skos:definition xml:lang="fi">Ilmavoimissa kolmen tai neljän lentueen muodostama joukkoyksikkö (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Truppenhet inom flygvapnet.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">flottilj (flygvapnet)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">laivue (ilmavoimat)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4783">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">bas</skos:altLabel>
    <skos:altLabel xml:lang="fi">tukikohta</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p9832"/>
    <skos:definition xml:lang="fi">Asevoimien tukikohta, johon on sijoitettu sotajoukkoja ja -kalustoa.</skos:definition>
    <skos:definition xml:lang="sv">Bas för vapenmakt, vid vilken militära styrkor och materiel är placerad.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">militärbas</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sotilastukikohta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4784">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p19538"/>
    <skos:definition xml:lang="sv">Statsbolag är antingen aktiebolag (ab) eller publika aktiebolag (abp), i vilka staten har bestämmanderätt.</skos:definition>
    <skos:definition xml:lang="fi">Valtionyhtiö on joko osakeyhtiö (oy) tai julkinen osakeyhtiö (oyj), jossa valtiolla on määräysvalta (Wikipedia).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">statsbolag</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valtionyhtiö</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Om bolag i vilka staten är majoritetsägare används förutom termen &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4660'&gt;aktiebolag&lt;/a&gt; även termen statsbolag.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Termiä valtionyhtiö käytetään termin &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m4660'&gt;osakeyhtiö&lt;/a&gt; ohella valtion enemmistöomistuksissa olevista yhtiöistä.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4785">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">förvaltningsråd</skos:altLabel>
    <skos:altLabel xml:lang="fi">hallintoneuvosto</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4691"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p24461"/>
    <skos:definition xml:lang="sv">Beslutande eller rådgivande organ för stat, bolag eller annan institution.</skos:definition>
    <skos:definition xml:lang="fi">Valtion, yhtiön tai muun yhteisön päättävä tai neuvoa antava elin (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">neuvosto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">råd</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4786">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40343"/>
    <skos:definition xml:lang="fi">Merivoimien joukkoyksikkö, joka koostuu viiriköistä tai alusperusyksiköistä (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Truppenhet inom marinen.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">flottilj (marinen)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">laivue (merivoimat)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4787">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">marineskader</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4678"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p40340"/>
    <skos:definition xml:lang="fi">Merivoimien joukko-osasto, johon kuuluu 3-6 laivuetta sekä esikunta ja huoltoyksiköt (Wikipedia).</skos:definition>
    <skos:definition xml:lang="sv">Truppförband inom marinen.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">flottavdelning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lippue</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4788">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">naturcentrum</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p10570"/>
    <skos:definition xml:lang="sv">Informations- och guidningscentrum om naturen som finns i närheten av skydds- eller friluftsområden, förvaltade av Forststyrelsen.</skos:definition>
    <skos:definition xml:lang="fi">Metsähallituksen hallinnoima suojelu- tai retkeilyalueen läheisyydessä sijaitseva luonnon esittely- ja opastuskeskus.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">luontokeskus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">naturum</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4789">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">flygstation</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p664"/>
    <skos:definition xml:lang="fi">Lentoaseman toiminnasta vastaava viranomainen, joka on nimetty lentoaseman nimen mukaan.</skos:definition>
    <skos:definition xml:lang="sv">Myndighet som ansvarar för en flygplats verksamhet, och som är namngiven enligt flygplatsens namn.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">flygplats</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">lentoasema</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m479">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
