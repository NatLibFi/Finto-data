    <skos:altLabel xml:lang="fi">maatalousalan oppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">merenkulkuoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">metsä- ja puutalousoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">sairaanhoito-oppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">sosiaalialan oppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">suojelualan oppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">taideoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">teknillinen oppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">terveydenhuolto-oppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">urheiluoppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="fi">viestintäalan oppilaitos</skos:altLabel>
    <skos:altLabel xml:lang="sv">yrkesinriktad läroanstalt</skos:altLabel>
    <skos:altLabel xml:lang="sv">yrkesinstitut</skos:altLabel>
    <skos:altLabel xml:lang="sv">yrkesläroinrättning</skos:altLabel>
    <skos:altLabel xml:lang="sv">yrkesskola</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4757"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5780"/>
    <skos:definition xml:lang="sv">Andra stadiets läroanstalt som ger utbildning för ett yrke.</skos:definition>
    <skos:definition xml:lang="fi">Toiseen asteen ammattiin valmistava oppilaitos.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ammatillinen oppilaitos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">yrkesläroanstalt</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4723">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">asunto-osakeyhtiö</skos:altLabel>
    <skos:altLabel xml:lang="sv">bostadsaktiebolag</skos:altLabel>
    <skos:altLabel xml:lang="sv">fastighetsaktiebolag</skos:altLabel>
    <skos:altLabel xml:lang="sv">husbolag</skos:altLabel>
    <skos:altLabel xml:lang="fi">keskinäinen kiinteistöosakeyhtiö</skos:altLabel>
    <skos:altLabel xml:lang="fi">kiinteistöosakeyhtiö</skos:altLabel>
    <skos:altLabel xml:lang="fi">taloyhtiö</skos:altLabel>
