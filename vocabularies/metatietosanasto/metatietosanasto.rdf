    <skos:prefLabel xml:lang="sv">lantbruksförvaltning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">maataloushallinto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4948">
