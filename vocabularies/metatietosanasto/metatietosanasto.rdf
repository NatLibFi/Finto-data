    <skos:altLabel xml:lang="fi">lyhennelmä ekspressiosta</skos:altLabel>
    <skos:altLabel xml:lang="fi">lyhennelmän perustana</skos:altLabel>
    <skos:altLabel xml:lang="fi">lyhennelmän perustana (ekspressio)</skos:altLabel>
