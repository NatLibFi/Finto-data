    <skos:altLabel xml:lang="sv">uppdragsgivare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5899"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa teoksen teettämisestä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för beställningen av ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10439"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">commissioning person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimeksiantaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">uppdragsgivare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5757">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">berättare (institution) som är bidragsgivare till tal</skos:altLabel>
    <skos:altLabel xml:lang="fi">puheeseen osallinen kertoja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6009"/>
    <skos:definition xml:lang="sv">Institution som högläser eller berättar om en handling, en händelse, ett händelseförlopp eller något annat dylikt, i ett innehåll som hör till ett aggregat.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka aggregaattiin kuuluvassa sisällössä lukee ääneen tai kertoo toiminnasta, tapahtumasta, tapahtumien kulusta tms.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">berättare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kertoja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5759">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">domstolssekreterare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuomioistuimen kirjuri (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu teoksen ekspression tekemiseen valmistelemalla tuomioistuimen lausunnon julkaistavaksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett verks uttryck, genom att förbereda en domstols utlåtande för publicering.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20352"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">court reporter person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">domstolssekreterare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuomioistuimen kirjuri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m576">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">handledare för examen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5715"/>
    <skos:definition xml:lang="fi">Henkilö, joka on akateeminen ohjaaja, joka on vastuussa teokseen johtavan akateemisen opinnäyte- tai väitöskirjatutkimuksen neuvomisesta tai valvonnasta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en akademisk handledare, som svarar för vägledning eller övervakning av ett lärdomsprov eller en doktorsavhandling som leder till ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10041"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">degree supervisor</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">handledare för lärdomsprov</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opinnäytteen ohjaaja</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kattaa opinnäytteen tai väitöskirjan ohjaajan. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omfattar handledare för lärdomsprov eller doktorsavhandling.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5760">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dockspelare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen nukettaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä esityksessä tai filmissä nukkeja käsittelevä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som hanterar dockor i en föreställning eller film som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">dockspelare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">nukettaja</skos:prefLabel>
  </owl:Class>
