  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m274">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">Fack-Finlandia-priset</skos:altLabel>
    <skos:altLabel xml:lang="sv">Fack-Finlandiapriset</skos:altLabel>
    <skos:altLabel xml:lang="sv">Fakta Finlandia</skos:altLabel>
    <skos:altLabel xml:lang="sv">Fakta Finlandia-priset</skos:altLabel>
    <skos:altLabel xml:lang="sv">Fakta-Finlandiapriset</skos:altLabel>
    <skos:altLabel xml:lang="fi">Tieto-Finlandia</skos:altLabel>
    <skos:altLabel xml:lang="fi">Tieto-Finlandia-palkinto</skos:altLabel>
    <skos:altLabel xml:lang="fi">Tietokirjallisuuden Finlandia</skos:altLabel>
    <skos:definition xml:lang="sv">Pris som utdelas av Finlands bokstiftelse för en meriterad fack- eller lärobok. Priset hette fram till år 2015 Fack-Finlandiapriset.</skos:definition>
    <skos:definition xml:lang="fi">Suomen Kirjasäätiön jakama tunnustus ansiokkaalle tieto- tai oppikirjalle. Palkinnon nimi oli vuoteen 2015 saakka Tieto-Finlandia-palkinto.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Finlandiapriset i facklitteratur, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Tieto-Finlandia-palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">Finlandiapriset i facklitteratur</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Tietokirjallisuuden Finlandia-palkinto</skos:prefLabel>
  </owl:Class>
