    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kalevi Jäntin säätiön vuosittain nuorille kirjailijoille myöntämä kirjallisuuspalkinto. Perustettiin vuonna 1942.</skos:definition>
    <skos:definition xml:lang="sv">Litteraturpris som årligen utdelas av Kalevi Jäntin säätiö till unga författare. Grundades år 1942.</skos:definition>
