    <skos:prefLabel xml:lang="sv">intertextuell relation (verk)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m412">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Keramiskt material som tillverkats genom bränning av eldfast vit lera (kaolin) och fältspat.</skos:definition>
    <skos:definition xml:lang="fi">Tulenkestävästä valkoisesta savesta (kaoliinista) ja maasälvästä polttamalla valmistettu keraaminen materiaali.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1031"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">porcelain</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">porslin</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">posliini</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4122">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5352"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen lisäämällä julkaisuun sukututkimuksen aineistoa.</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck genom att tillföra en publikation släktforskarmaterial.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">genealogist</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släktforskare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukututkija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4126">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4127"/>
    <skos:altLabel xml:lang="en">container of (expression)</skos:altLabel>
    <skos:altLabel xml:lang="sv">del av versionen</skos:altLabel>
    <skos:altLabel xml:lang="fi">version osa</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Ekspressio, joka on itsenäinen osa toista ekspressiota. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som är en självständig del av ett annat uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20145"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">del av uttrycket</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ekspression osa</skos:prefLabel>
    <skos:prefLabel xml:lang="en">part expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4127">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4126"/>
    <skos:altLabel xml:lang="en">contained in (expression)</skos:altLabel>
    <skos:altLabel xml:lang="sv">del av uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="sv">del av versionen</skos:altLabel>
    <skos:altLabel xml:lang="sv">ingår i uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">osa teoksen versiosta</skos:altLabel>
    <skos:altLabel xml:lang="fi">sisältyy ekspressioon</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Ekspressio, jolla on toinen ekspressio erillisenä osana. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som har ett annat uttryck som en skild del.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20074"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">del av uttrycket</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">osa ekspressiosta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">part of expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4128">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Jarl Hellemann -käännöskirjapalkinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">Jarl Hellemanns översättningspris</skos:altLabel>
    <skos:definition xml:lang="fi">Jarl Hellemann -käännöskirjapalkinto on Tammen perustama kirjallisuuspalkinto, joka jaetaan vuosittain korkeatasoisen kaunokirjallisen teoksen laadukkaasta suomennoksesta. Palkinto on nimetty Tammen aiemman toimitusjohtajan ja Keltaisen kirjaston perustajan Jarl Hellemannin mukaan. Palkinto jaettiin ensimmäisen kerran 2015.</skos:definition>
    <skos:definition xml:lang="sv">Litteraturpris som grundats av förlaget Tammi och som utdelas årligen till en kvalitativ finskspråkig översättning av ett högklassigt skönlitterärt verk. Priset är namngivet efter den tidigare direktören och grundaren av Keltainen kirjasto - Jarl Hellemann. Priset utdelades första gången 2015.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Jarl Hellemann-priset, 2015</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Jarl Hellemann -palkinto, 2015</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Jarl Hellemann -palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Jarl Hellemann-priset</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4129">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">Vuoden luontokirja -palkinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">Årets naturbok-priset</skos:altLabel>
    <skos:definition xml:lang="sv">Verk utvalt årligen av WWF Finland som passar för en bred publik och främjar budskapet om naturskydd, samt är högklassigt. Priset utdelades första gången 1978.</skos:definition>
    <skos:definition xml:lang="fi">WWF Suomen vuosittain valitsema teos, joka sopii suurelle yleisölle, edistää luonnonsuojelun viestiä ja on korkealaatuinen. Palkinto myönnettiin ensimmäisen kerran 1978.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Årets naturbok, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Vuoden luontokirja, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Vuoden luontokirja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Årets naturbok</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4130">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Helsingin Science Fiction -seuran jakama palkinto vuoden parhaasta suomeksi ilmestyneestä tieteiskirjasta. Jaettu vuodesta 1986 alkaen.</skos:definition>
    <skos:definition xml:lang="sv">Pris utdelat av Helsingfors science fiction-förening för årets bästa science fiction-bok som utkommit på finska. Priset har utdelats sedan år 1986.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Tähtivaeltaja-priset, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Tähtivaeltaja-palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Tähtivaeltaja-palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tähtivaeltaja-priset</skos:prefLabel>
  </owl:Class>
