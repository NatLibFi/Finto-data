  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5314">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">esittelijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">presentatör (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare, som deltar i utförandet av ett uttryck genom att framträda i tv eller film med bakgrundsinformation.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen esiintymällä televisiossa tai elokuvassa taustatiedon antajana. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20488"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittelijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">onscreen presenter corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">presentatör</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Gäller framträdande i icke-fiktiv film eller i inledning till fiktiv film.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Koskee ei-fiktiivisessä elokuvassa tai fiktiivisen elokuvan johdannossa esiintymistä. Ei koske esiintymistä ruudussa ei-esittävässä roolissa. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5315">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5620"/>
    <skos:altLabel xml:lang="fi">ekspression manifestaatio</skos:altLabel>
    <skos:altLabel xml:lang="sv">manifestation av uttryck</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5797"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on ekspression fyysinen ilmentymä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är en fysisk manifestation av ett uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20059"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">ingår i materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">manifestation of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sisältyy aineistoon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5316">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">framförande person som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen esittäjä (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvässä esityksessä näyttelevä, tanssiva, musiikkia esittävä tai muussa roolissa esiintyvä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som uppträder med skådespel, dans, musik eller något annat, i en föreställning som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">esittäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">framförande person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5317">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">mottagare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">vastaanottaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5899"/>
    <skos:definition xml:lang="fi">Henkilö, jolle teos tai teoksen osa on osoitettu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person till vilken ett verk eller en del av ett verk har riktats.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10413"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">addressee person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mottagare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vastaanottaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5318">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kokoelman muodostaja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">samlare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett samlingsverk, genom att välja och ordna exemplar som representerar uttryck för andra verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka vastaa kokoelmateoksen luomisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10631"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">collector corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kokoelman muodostaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">samlare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5319">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5321"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Ekspressio, joka aggregoi ekspression osaksi aggregoivan ekspression suunnitelmaa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som aggregerar ett uttryck till del av planen för ett aggregerande uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20320"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">aggregated by</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aggregator</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">aggregoija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5320">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">omistaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ägare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5699"/>
    <skos:definition xml:lang="fi">Henkilö, jolla on kappaleen nykyinen tai aiempi laillinen omistusoikeus. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som har nuvarande eller tidigare juridisk äganderätt till ett exemplar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40104"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">omistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">owner person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ägare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5321">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5319"/>
    <skos:altLabel xml:lang="sv">aggregerar uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="fi">aggregoi ekspression</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
    <skos:definition xml:lang="fi">Ekspressio, joka on valittu osaksi aggregoivan ekspression suunnitelmaa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck som har valts till del av planen för ett aggregerande uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20319"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">aggregates</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">aggregerar versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">aggregoi version</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5323">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">manifestaation tekijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare (institution) av manifestation</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5619"/>
    <skos:definition xml:lang="sv">Institution som svarar för ett eller flera uttrycks yttre form.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa yhden tai useamman ekspression ilmiasusta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30421"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">creator corporate body of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av material</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Manifestaation tekijä sisältää jakelijan, valmistajan, tuottajan ja kustantajan. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Skapare av manifestation innefattar distributör, tillverkare, producent och utgivare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5324">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kääntäjä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">översättare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5445"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i skapandet av ett uttryck, genom att uttrycka ett verks språkliga innehåll på ett språk som avviker från ett originalverks tidigare uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20346"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kääntäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">translator person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">översättare</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En översättare kan också översätta språkligt innehåll mellan olika former av samma språk från olika tidsperioder.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5325">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">protokollförare (institution) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen pöytäkirjan laatija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän kokouspöytäkirjan laatinut yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som sammanställt ett mötesprotokoll som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">protokollförare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">pöytäkirjan laatija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5326">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">producent (institution)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuottaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för största delen av de kommersiella uppgifterna kring en film-, ljudupptagnings-, tv-, streaming- eller dylik produktion.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10548"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">producent</skos:prefLabel>
    <skos:prefLabel xml:lang="en">producer corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuottaja</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">En producent svarar typiskt för skaffande av finansiering, ledning av produktion, anställning av nyckelpersonal, ordning av distributörer etc.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5327">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">klippare (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen leikkaaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5470"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta, sekä kuvan että äänen osalta, vastaava yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som svarar för samling, ordnande och klippning av film, video eller andra format för rörlig bild som ingår i ett aggregat, både beträffande bild och ljud.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">klippare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">leikkaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5328">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5528"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5702"/>
    <skos:definition xml:lang="fi">Teos, jolla on genre, jota on muutettu teoksen luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som har en genre, som är ändrad för att skapa ett verk.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10343"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m837"/>
    <skos:prefLabel xml:lang="fi">muunnos genressä teoksesta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">transformation by genre of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">variant av genre för verket</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5329">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5330"/>
    <skos:altLabel xml:lang="sv">bindning av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation sidos</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5433"/>
    <skos:definition xml:lang="fi">Teos, joka on manifestaation sidos. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är ett band av en manifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30310"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston sidos</skos:prefLabel>
    <skos:prefLabel xml:lang="en">binding of manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">bindning av materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5330">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5329"/>
    <skos:altLabel xml:lang="sv">bindning av manifestationen</skos:altLabel>
    <skos:altLabel xml:lang="fi">manifestaation sidos manifestaatiosta</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5728"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on sidottu. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som är bunden.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10363"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">aineiston sidos aineistosta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">binding of manifestation of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">bindning av materialet</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5331">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen äänisuunnittelija (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ljuddesigner (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän liikkuvan kuvan ääniä suunnitteleva ja tekevä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som planerat och utfört ljud i rörlig bild som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">liikkuvan kuvan äänisuunnittelija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljuddesigner för rörlig bild</skos:prefLabel>
  </owl:Class>
