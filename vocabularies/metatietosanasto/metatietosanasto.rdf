    <skos:prefLabel xml:lang="sv">abstrakt (verk)</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">abstraktit (teos)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2288">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3462"/>
    <skos:altLabel xml:lang="sv">parodi (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">parodia (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m2277"/>
    <skos:definition xml:lang="fi">Teos, joka jäljittelee toisen teoksen tyyliä tai sisältöä humoristisesti. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som imiterar ett annat verks stil eller innehåll humoristiskt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10144"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">parodi</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">parodia</skos:prefLabel>
    <skos:prefLabel xml:lang="en">parodied as work</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m2289">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3453"/>
    <skos:altLabel xml:lang="sv">förkortning (verk)</skos:altLabel>
    <skos:altLabel xml:lang="fi">lyhennelmä (teos)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m530"/>
    <skos:definition xml:lang="fi">Teos, joka lyhentää siihen liittyvää teosta muuttamatta sen merkityssisältöä tai esitystyyliä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som förkortar ett relaterat verk, utan att ändra dess betydelsemässiga innehåll eller presentationssätt.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10167"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
