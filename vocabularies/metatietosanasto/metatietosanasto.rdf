    <skos:prefLabel xml:lang="en">person member of corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">personmedlem i institution</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisön henkilöjäsen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m749">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Hienojakoisesta kalkkikivestä tai muusta pehmeästä kalsiumkarbonaatista muodostuva materiaali.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av finfördelad kalksten eller annat mjukt kalciumkarbonat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1008"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">chalk</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">krita</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">liitu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m752">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Levy, jonka ulkoreunalla on aukkoja, joissa on stereografisia stillkuvia. Käytetään stereografisella katselulaitteella (stereoskoopilla).</skos:definition>
    <skos:definition xml:lang="sv">Skiva, i vars yttre kant finns öppningar med stereografiska stillbilder. Används med en stereografisk visningsapparat (stereoskop).</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierType/1043"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">stereografinen levy</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">stereografisk skiva</skos:prefLabel>
    <skos:prefLabel xml:lang="en">stereograph disc</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Stereografinen tallenne.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Stereografisk bärare.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m755">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">RTF</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">RTF</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m758">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">haastateltava</skos:altLabel>
    <skos:altLabel xml:lang="en">interviewee</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuad</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuobjekt</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuobjekt (aktör) i verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen haastateltava (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett verk, genom att svara en intervjuare, vanligen en journalist, opinionsmätare eller som någon annan aktör, som samlar information.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa teoksen luomisesta vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jonkinlaiselle muulle toimijalle, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10059"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">interviewee agent of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuobjekt i verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen haastateltava</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m767">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">haastattelija (teos)</skos:altLabel>
    <skos:altLabel xml:lang="en">interviewer</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuare (aktör) i verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen haastattelija (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett verk, genom att fungera som intervjuare, journalist, opinionsmätare eller någon annan aktör, som samlar information.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10057"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">interviewer agent of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuare i verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen haastattelija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m769">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Jaetaan lasten- ja nuortenkirjan kuvittajalle. Palkinto jaetaan joka toinen vuosi. Vuodesta 1997 palkinnon myöntäjä on ollut Grafia ry.</skos:definition>
    <skos:definition xml:lang="sv">Utdelas åt en barn- och ungdomsboksillustratör. Priset utdelas vartannat år. Sedan 1997 har priset utdelats av Grafia rf.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Rudolf Koivu-priset, 2020</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Rudolf Koivu -palkinto, 2020</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Rudolf Koivu -palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Rudolf Koivu-priset</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m77">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka on kemiallinen yhdistelmä eläin-, kasvi- ja mineraalipohjaisia tai synteettisiä aineita. Vaha on muokattavissa ympäristön lämpötilassa, se tuntuu liukkaalta, sillä on alhainen sulamispiste ja yleensä läpikuultava, vettä hylkivä pinta ja se liukenee orgaanisiin liuottimiin.</skos:definition>
    <skos:definition xml:lang="sv">Material som är en kemisk förening av djur-, växt-, mineralbaserade eller syntetiska ämnen. Vax kan bearbetas i omgivningens temperatur, det känns glatt, har en låg smältpunkt och vanligen en genomskinlig, vattenavstötande yta, samt upplöses i organiska lösningsmedel.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1044"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">vaha</skos:prefLabel>
    <skos:prefLabel xml:lang="en">vax</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vax</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m771">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Excel</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Excel</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m772">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka koostuu synteettisistä tai puolisynteettisistä orgaanisista polymeereistä, joilla on suuri molekyylipaino ja jotka ovat muovattavia.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av syntetiska eller halvsyntetiska organiska polymerer, som har en hög molekylvikt och är formbara.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1029"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">muovi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">plast</skos:prefLabel>
    <skos:prefLabel xml:lang="en">plastic</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m773">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">RealAudio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">RealAudio</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Kodningsformat för ljud, filändelse .ra, .rm</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänen koodausmuoto, tiedostopääte .ra, .rm</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m774">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:example xml:lang="sv">Marginalanmärkningar till Pirjo Karvonens text.</skos:example>
    <skos:example xml:lang="fi">Reunahuomautuksia Pirjo Karvosen kirjoitukseen.</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">marginalanmärkningar</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">reunahuomautuksia</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m777">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m138"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <rdfs:seeAlso rdf:resource="http://rdaregistry.info/Elements/m/P30002"/>
    <skos:definition xml:lang="sv">Indelning som uttrycker vilken typ av apparat som behövs för att titta på, spela upp eller utföra ett materials innehåll. Då ingen medietyp passar in på den inspelning som beskrivs, anges termen 'annan'.</skos:definition>
    <skos:definition xml:lang="fi">Jaottelu, joka ilmaisee aineiston sisällön katsomiseen, toistamiseen, suorittamiseen ym. tarvittavan laitteen tyyppiä. Jos mikään mediatyypin termeistä ei sovellu kuvailun kohteen tallenteeseen, merkitään 'muu'.</skos:definition>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1012"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1062"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1288"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1515"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m355"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m502"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m545"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m87"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m923"/>
    <skos:prefLabel xml:lang="en">Media type</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Mediatyyppi</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Medietyp</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m779">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">instrumentalist</skos:altLabel>
    <skos:altLabel xml:lang="sv">instrumentalist (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">instrumentalist (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">soittaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">soittaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m1060"/>
    <skos:definition xml:lang="sv">Aktör som är en framförare, som deltar i utförandet av ett uttryck genom att spela ett instrument.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20020"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">instrumentalist</skos:prefLabel>
    <skos:prefLabel xml:lang="en">instrumentalist agent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">soittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m780">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Enhet, vanligen tvådimensionell karta i skala, som i sin helhet eller delvis skildrar ett avsnitt av jordens, någon annan himlakropps eller en fiktiv plats yta.</skos:definition>
    <skos:definition xml:lang="fi">Laajuuden yksikkö, yleensä mittakaavassa ja kaksiulotteisena esitetty kartta, joka on maan tai muun tähtitaivaan kappaleen tai kuvitteellisen paikan pinnan kuvaus kokonaisuudessaan tai osittain.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACarrierEU/1019"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">karta</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kartta</skos:prefLabel>
    <skos:prefLabel xml:lang="en">map</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">I plural: xx kartor, kartor</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Monikossa: xx karttaa, karttoja</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m781">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">E00</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">E00</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m783">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">liittyy teokseen</skos:altLabel>
    <skos:altLabel xml:lang="sv">relaterat verk</skos:altLabel>
