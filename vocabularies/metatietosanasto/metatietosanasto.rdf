  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m392">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Materiaali, joka koostuu veteen ja mahdolliseen täyteaineeseen sekoitetusta kalsiumsulfaattidihydraatista tai kalsiumkarbonaatista muodostaen massan, josta vapautuu lämpöä, minkä jälkeen massa kovettuu.</skos:definition>
    <skos:definition xml:lang="sv">Material som består av kalciumsulfathydrat eller kalciumkarbonat blandat i vatten och med ett eventuellt fyllnadsmaterial, vilket bildar en massa som frigör värme och därefter hårdnar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMaterial/1028"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">gips</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kipsi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">plaster</skos:prefLabel>
  </owl:Class>
