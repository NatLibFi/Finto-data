    <skos:definition xml:lang="fi">Yhteisö, joka on aiemmin laillisesti omistanut kappaleen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40134"/>
