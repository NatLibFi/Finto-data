  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4347">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kartografinen tietotyyppi, joka käyttää pistematriisin tietorakennetta esittämään tavallisesti suorakulmaisessa pikseleiden verkossa esiintyviä geospatiaalisia ominaisuuksia.</skos:definition>
    <skos:definition xml:lang="sv">Kartografisk datatyp som använder punktmatrisformat för att representera geospatiala egenskaper, vanligen i ett fyrkantigt rutnät av pixlar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACartoDT/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">raster</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">raster</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rasteri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4349">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Kartografinen tietotyyppi, joka käyttää vektoreiden määrittämiä polygoneja esittämään geospatiaalisia ominaisuuksia.</skos:definition>
    <skos:definition xml:lang="sv">Kartografisk datatyp, som använder polygoner bestämda av vektorer för att visa geospatiala egenskaper.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDACartoDT/1002"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">vector</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">vektor</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vektori</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4350">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
