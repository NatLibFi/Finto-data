  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1383">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Filtyp för lagring av elektroniska program, som består av kommandolistor som ordnats för utförande med datorrogram.</skos:definition>
    <skos:definition xml:lang="fi">Tiedostotyyppi sähköisesti taltioitujen ohjelmien tallentamiseksi, jotka koostuvat tietokoneohjelman suoritettaviksi tarkoitetuista järjestetyistä komentolistoista.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/fileType/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">ohjelmatiedosto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">program file</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programfil</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1384">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">D-uppsats</skos:altLabel>
    <skos:altLabel xml:lang="sv">gradu</skos:altLabel>
    <skos:altLabel xml:lang="sv">magisteruppsats</skos:altLabel>
    <skos:altLabel xml:lang="sv">pro gradu</skos:altLabel>
    <skos:altLabel xml:lang="sv">trebetygsuppsats</skos:altLabel>
    <skos:definition xml:lang="sv">Avhandling som krävs för att avklara högre högskoleexamen vid ett universitet.</skos:definition>
    <skos:definition xml:lang="fi">Ylempään korkeakoulututkintoon yliopistossa vaadittava tutkielma. (Kielitoimiston sanakirja)</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">pro gradu -tutkielma</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">pro gradu-avhandling</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1386">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Myöntää Lauri Jäntin säätiö, ja se jaetaan joka kolmas vuosi ansiokkaalle lasten tai nuorten tietokirjalle.</skos:definition>
    <skos:definition xml:lang="sv">Utdelas vart tredje år av Lauri Jäntin säätiö för en meriterad fackbok för barn eller ungdomar.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-formatet: 586 ## ‡a Tieto-Lauri-priset, 2016</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Tieto-Lauri-palkinto, 2016</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Tieto-Lauri-palkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Tieto-Lauri-priset</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1387">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
