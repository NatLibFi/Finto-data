    <skos:prefLabel xml:lang="fi">televisiotuottaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-producent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1171">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Filformat för lagring av elektroniskt upptaget stillbildsinnehåll.</skos:definition>
    <skos:definition xml:lang="fi">Tiedostotyyppi elektronisesti taltioidun still-kuvasisällön tallentamiseksi.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/fileType/1004"/>
