    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5251"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5382"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5383"/>
