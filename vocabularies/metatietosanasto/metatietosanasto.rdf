    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">asiantuntija (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">asiantuntija (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">consultant</skos:altLabel>
    <skos:altLabel xml:lang="sv">expert (relation)</skos:altLabel>
    <skos:altLabel xml:lang="sv">sakkunnig</skos:altLabel>
