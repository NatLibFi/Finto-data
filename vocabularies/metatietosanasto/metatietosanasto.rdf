    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">delegaatio</skos:altLabel>
    <skos:altLabel xml:lang="fi">valtuusto (määrätehtävään valtuutettu)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4691"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p17674"/>
    <skos:definition xml:lang="fi">Määrätehtävään valtuutettu edustajisto (Kielitoimiston sanakirja).</skos:definition>
    <skos:definition xml:lang="sv">Representantkår befullmäktigad för en bestämd uppgift.</skos:definition>
    <skos:example xml:lang="fi">Eduskunnan pankkivaltuusto</skos:example>
    <skos:example xml:lang="sv">Riksdagens bankfullmäktige</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
