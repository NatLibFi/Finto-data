    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5278"/>
    <skos:definition xml:lang="sv">Aktör som svarar för skapandet av ett musikverk.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on vastuussa musiikkiteoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10053"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">composer</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kompositör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">säveltäjä</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m696">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">addressee</skos:altLabel>
    <skos:altLabel xml:lang="sv">mottagare (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="fi">vastaanottaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5482"/>
    <skos:definition xml:lang="sv">Aktör till vilken ett verk eller en del av ett verk har riktats.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, jolle teos tai teoksen osa on osoitettu. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10070"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">addressee agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mottagare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vastaanottaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m699">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">elokuvaohjaaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">elokuvaohjaaja (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">film director</skos:altLabel>
    <skos:altLabel xml:lang="sv">filmregissör (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m397"/>
    <skos:definition xml:lang="sv">Aktör som är en regissör, som svarar för allmän ledning och övervakning av en filmad föreställning.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on ohjaaja, joka on vastuussa elokuvatun esityksen yleisestä johtamisesta ja valvonnasta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10013"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvaohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">film director agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m700">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">costume designer</skos:altLabel>
    <skos:altLabel xml:lang="sv">kostymör (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kostymör (relation)</skos:altLabel>
    <skos:altLabel xml:lang="fi">puvustaja (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">puvustaja (toimija)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5579"/>
    <skos:definition xml:lang="sv">Aktör som deltar i utförandet av ett uttryck, genom att planera kostymdesignen i en filmproduktion eller ett musikaliskt eller sceniskt framförande.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20036"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">costume designer agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kostymör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puvustaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m702">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Lagringsmetod, i vilken innehåll lagrats på ett medium som löpande variabla storheter.</skos:definition>
    <skos:definition xml:lang="fi">Tallentamisen tapa, jossa sisältö on taltioitu tallenteeseen jatkuvina muuttuvina suureina.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/typeRec/1001"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">analog</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">analog</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">analoginen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m704">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Bestämning av generation för digitalt material som har skapats genom att digitera med största möjliga resolution, och som ofta används för att tillverka kopior.</skos:definition>
    <skos:definition xml:lang="fi">Sukupolven määrite digitaaliselle aineistolle, joka on luotu digitoimalla suurimmalla mahdollisella resoluutiolla ja jota usein käytetään kopioiden valmistamiseen.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAGeneration/1005"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">master</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">masterkopia</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">masterkopio</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m705">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">henkilörahasto</skos:altLabel>
    <skos:altLabel xml:lang="sv">minnesfond</skos:altLabel>
    <skos:altLabel xml:lang="fi">muistorahasto</skos:altLabel>
    <skos:altLabel xml:lang="sv">personfond</skos:altLabel>
    <skos:altLabel xml:lang="sv">stödfond</skos:altLabel>
    <skos:altLabel xml:lang="fi">tukirahasto</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p5933"/>
    <skos:definition xml:lang="fi">Julkisoikeudellinen rahasto tai sellainen yksityinen rahasto, joka ei ole säätiörekisterissä (henkilöstörahasto, tukirahasto, muistorahasto).</skos:definition>
    <skos:definition xml:lang="sv">Offentligrättslig fond eller sådan privat fond som inte finns i Stiftelseregistret.</skos:definition>
    <skos:example xml:lang="sv">Försörjningsberedskapsfonden</skos:example>
    <skos:example xml:lang="fi">Huoltovarmuusrahasto</skos:example>
    <skos:example xml:lang="sv">Jubileumsfonden för Finlands självständighet</skos:example>
    <skos:example xml:lang="sv">Statens bostadsfond</skos:example>
    <skos:example xml:lang="fi">Suomen itsenäisyyden juhlarahasto</skos:example>
    <skos:example xml:lang="sv">Svenska kulturfonden</skos:example>
    <skos:example xml:lang="sv">Sysselsättningsfonden</skos:example>
    <skos:example xml:lang="fi">Työllisyysrahasto</skos:example>
    <skos:example xml:lang="fi">Valtion asuntorahasto</skos:example>
    <skos:example xml:lang="fi">Vastauksemme lapualaisille (rahasto)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fond</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">rahasto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m711">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Elokuvafilmin esitysformaatti, jonka kuvasuhde on 2.33:1 käyttäen 35 mm:n filmiä.</skos:definition>
    <skos:definition xml:lang="sv">Visningsformat för film, vars bildförhållande är 2.33:1 och med 35 mm:s film.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/presFormat/1011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">techniscope</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">techniscope</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">techniscope</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m713">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
