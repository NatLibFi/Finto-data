    <skos:definition xml:lang="sv">Person som deltar i skapandet av ett uttryck, genom att undersöka, planera, förverkliga eller testa en programvara.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20353"/>
