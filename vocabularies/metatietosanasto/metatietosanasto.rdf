    <skos:prefLabel xml:lang="fi">litografi</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Avser också grafiker som gör en teckning direkt på en yta som används för tryckning.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle. (RDA Registry)</skos:scopeNote>
  </owl:Class>
