    <skos:altLabel xml:lang="sv">arbetskoloni</skos:altLabel>
    <skos:altLabel xml:lang="fi">avovankila</skos:altLabel>
    <skos:altLabel xml:lang="sv">centralfängelse</skos:altLabel>
    <skos:altLabel xml:lang="sv">fångkoloni</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaupunginvankila</skos:altLabel>
    <skos:altLabel xml:lang="fi">kehruuhuone</skos:altLabel>
    <skos:altLabel xml:lang="fi">keskusvankila</skos:altLabel>
    <skos:altLabel xml:lang="sv">kronofängelse</skos:altLabel>
    <skos:altLabel xml:lang="fi">kruununvankila</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuritushuone</skos:altLabel>
    <skos:altLabel xml:lang="fi">linnavankila</skos:altLabel>
    <skos:altLabel xml:lang="sv">länsfängelse</skos:altLabel>
    <skos:altLabel xml:lang="fi">lääninvankila</skos:altLabel>
    <skos:altLabel xml:lang="fi">nuorisovankila</skos:altLabel>
    <skos:altLabel xml:lang="fi">poliisivankila</skos:altLabel>
    <skos:altLabel xml:lang="sv">polisfängelse</skos:altLabel>
    <skos:altLabel xml:lang="fi">rangaistusvankila</skos:altLabel>
    <skos:altLabel xml:lang="sv">reservfängelse</skos:altLabel>
    <skos:altLabel xml:lang="sv">slottsfängelse</skos:altLabel>
    <skos:altLabel xml:lang="sv">spinnhus</skos:altLabel>
    <skos:altLabel xml:lang="sv">stadsfängelse</skos:altLabel>
    <skos:altLabel xml:lang="sv">straffängelse</skos:altLabel>
    <skos:altLabel xml:lang="sv">tukthus</skos:altLabel>
    <skos:altLabel xml:lang="fi">tunnustusvankila</skos:altLabel>
    <skos:altLabel xml:lang="fi">työsiirtola</skos:altLabel>
    <skos:altLabel xml:lang="sv">ungdomsfängelse</skos:altLabel>
    <skos:altLabel xml:lang="fi">vankisiirtola</skos:altLabel>
    <skos:altLabel xml:lang="fi">varavankila</skos:altLabel>
    <skos:altLabel xml:lang="sv">öppet fängelse</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p11055"/>
    <skos:definition xml:lang="sv">Inrättning vid vilken fängelsestraff verkställs och personer som dömts till frihets­berövande förvaras.</skos:definition>
    <skos:definition xml:lang="fi">Laitos, jossa pannaan täytäntöön vankeusrangaistuksia ja jossa säilytetään vangittuja henkilöitä (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fängelse</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">vankila</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4682">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">direktion</skos:altLabel>
    <skos:altLabel xml:lang="sv">domkapitel</skos:altLabel>
    <skos:altLabel xml:lang="fi">hallitus (yhteisötyyppi)</skos:altLabel>
    <skos:altLabel xml:lang="fi">johtokunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">kaupunginhallitus</skos:altLabel>
    <skos:altLabel xml:lang="sv">kommunstyrelse</skos:altLabel>
    <skos:altLabel xml:lang="fi">kunnanhallitus</skos:altLabel>
    <skos:altLabel xml:lang="sv">stadsstyrelse</skos:altLabel>
    <skos:altLabel xml:lang="sv">styrelse (institutionstyp)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tuomiokapituli</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4691"/>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p37875"/>
    <skos:definition xml:lang="sv">Verkställande (ofta även beslutande) organ i förening, bolag e.d.</skos:definition>
    <skos:definition xml:lang="fi">Yhdistyksen, yhtiön tms. toimeenpaneva (usein myös päättävä) elin (Kielitoimiston sanakirja).</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">hallitus (toimielin)</skos:prefLabel>
