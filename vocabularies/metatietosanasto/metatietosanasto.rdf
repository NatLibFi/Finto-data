    <skos:altLabel xml:lang="fi">sotilasliitto</skos:altLabel>
    <skos:altLabel xml:lang="sv">sällskap (oregistrerat)</skos:altLabel>
    <skos:altLabel xml:lang="fi">talousliitto</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p1393"/>
    <skos:example xml:lang="sv">Folkhälsan (organisation)</skos:example>
    <skos:example xml:lang="fi">Maan Turva (järjestö)</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">järjestö</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">organisation</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m257"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m318"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4657"/>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m594"/>
    <skos:scopeNote xml:lang="sv">Används om internationella organisationer och sådan inhemska organisationer som inte är registrerade föreningar, offentligrättsliga föreningar, partier, religiösa samfund eller stiftelser.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Käytetään kansainvälisistä järjestöistä ja sellaisista kotimaisista järjestöistä, jotka eivät ole rekisteröityjä yhdistyksiä, julkisoikeudellisia yhdistyksiä, puolueita, uskonnollisia yhdyskuntia eivätkä säätiöitä.</skos:scopeNote>
  </owl:Class>
