    <skos:prefLabel xml:lang="fi">kartografinen data</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kartografisk data</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4352">
