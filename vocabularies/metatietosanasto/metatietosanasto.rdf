  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m252">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Fotomekanisk reproduktionsmetod som bygger på djuptrycksteknik.</skos:definition>
    <skos:definition xml:lang="fi">Syväpainomenetelmä, jossa metallinen painolevy valmistetaan bikromaattimenetelmällä, jossa gelatiinipinnoite jää vaihtelevan paksuiseksi. Levy syövytetään, jolloin muodostuu vaihtelevan syvyisiä soluja jotka sitovat eri määrän mustetta.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAproductionMethod/1014"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">fotogravyr</skos:prefLabel>
    <skos:prefLabel xml:lang="en">photogravure process</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">valokaiverrusmenetelmä</skos:prefLabel>
  </owl:Class>
