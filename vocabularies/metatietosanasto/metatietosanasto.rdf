    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4296"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m93"/>
    <skos:prefLabel xml:lang="en">equivalent manifestation</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">material med samma innehåll</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">samansisältöinen aineisto</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4315">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4240"/>
    <skos:altLabel xml:lang="sv">guide (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">opas (ekspressio)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4285"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, joka opastaa käyttäjää vallitsevan teoksen käytössä muistiinpanojen, opiskelumateriaalien, harjoitusten, tehtävien, kysymysten ja vastausten tai muiden opettajan tai opiskelijan aineistojen avulla. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk som handleder användare i användningen av ett verk med hjälp av anteckningar, studiematerial, övningar, uppgifter, frågor och svar eller andra material för lärare eller studerande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20120"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">guide</skos:prefLabel>
    <skos:prefLabel xml:lang="en">guide expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">opas</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4316">
