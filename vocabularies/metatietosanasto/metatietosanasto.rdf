  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1269">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Analogisen ja digitaalisen nauhan videoformaatti, johon sisältyvät Video8, Hi-8 sekä Digital8 -formaatit.</skos:definition>
    <skos:definition xml:lang="sv">Videoformat för analogt och digitalt band, i vilket ingår Video8, Hi-8 och Digital8-format.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/videoFormat/1007"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
