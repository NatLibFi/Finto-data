    <skos:altLabel xml:lang="sv">serieversion</skos:altLabel>
    <skos:altLabel xml:lang="sv">tecknad serie-version (verk)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m743"/>
    <skos:definition xml:lang="fi">Teos, joka on toiseen teokseen perustuva sarjakuvaromaani. (RDA Registry)</skos:definition>
