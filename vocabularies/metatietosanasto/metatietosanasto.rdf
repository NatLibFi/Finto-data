    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasSpouse"/>
    <skos:definition xml:lang="fi">Henkilö, jonka kanssa kuvailtava henkilö on avioliitossa.</skos:definition>
    <skos:definition xml:lang="sv">Person med vilken en beskriven person är gift.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has spouse</skos:prefLabel>
