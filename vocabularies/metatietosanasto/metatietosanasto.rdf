  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4611">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4625"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#isChannelOf"/>
    <skos:definition xml:lang="fi">Kohde, jolta välittäjä tai meedio ottaa vastaan viestejä - eli henkilö tai hengellinen entiteetti, kuten kuollut henkilö, henkiolento tai enkeli, jolle kuvailtava henkilö tai hengellinen entiteetti toimii välittäjänä tai meediona.</skos:definition>
    <skos:definition xml:lang="sv">Person eller andlig entitet, såsom en avliden person, en andevarelse eller en ängel, från vilken en beskriven person eller andlig entitet som medium tar emot meddelanden eller fungerar som förmedlare.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">is channel of</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">medium för</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">meediona</skos:prefLabel>
  </owl:Class>
