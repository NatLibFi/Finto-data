  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4910">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">Lauri Jänttis pris för facklitteratur</skos:altLabel>
    <skos:definition xml:lang="fi">Lauri Jäntin säätiön vuodesta 1985 vuosittain jakama kirjallisuuspalkinto, joka myönnetään edellisenä vuonna ilmestyneelle merkittävälle suomenkieliselle tietokirjalle.</skos:definition>
    <skos:definition xml:lang="sv">Litteraturpris som sedan år 1985 utdelas årligen av Lauri Jäntti-stiftelsen, åt en betydande finskspråkig bok som utkommit det föregående året.</skos:definition>
    <skos:example xml:lang="sv">I MARC 21-fältet: 586 ## ‡a Lauri Jäntti-priset för facklitteratur, 2006</skos:example>
    <skos:example xml:lang="fi">MARC 21 -formaatissa: 586 ## ‡a Lauri Jäntin tietokirjapalkinto, 2006</skos:example>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">Lauri Jäntin tietokirjapalkinto</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Lauri Jäntti-priset för facklitteratur</skos:prefLabel>
  </owl:Class>
