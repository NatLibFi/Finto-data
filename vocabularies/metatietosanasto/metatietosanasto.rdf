    <skos:altLabel xml:lang="fi">tekstiin osallinen tuomioistuimen kirjuri (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5814"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän tuomioistuimen lausunnon julkaistavaksi valmisteleva henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som förbereder en domstols utlåtande, som ingår i ett aggregat, för publicering.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">domstolssekreterare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tuomioistuimen kirjuri</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5861">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
