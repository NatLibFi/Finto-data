  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5996">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kommentator (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen kommentaattori (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän audiovisuaalisen aineiston aihetta tulkitseva, analysoiva tai keskustelussa käsittelevä henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som tolkar, analyserar eller diskuterar ett ämne i audiovisuellt material som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kommentaattori</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kommentator</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5997">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">författare (institution) som är bidragsgivare till text</skos:altLabel>
    <skos:altLabel xml:lang="fi">tekstiin osallinen kirjoittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän tekstin kirjoittanut yhteisö. Määritelmä kattaa myös uuden sisällön luomisen toisen tekijän tekstiä mukailemalla, muokkaamalla tai sovittamalla, jos muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai ilmaisutapaa.</skos:definition>
    <skos:definition xml:lang="sv">Institution som skrivit en text som ingår i ett aggregat. Innefattar även skapandet av nytt innehåll genom att omarbeta, redigera eller bearbeta text av en annan upphovsperson, såvida ändringen väsentligen har ändrat originalets karaktär och innehåll eller uttrycksform.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">författare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kirjoittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5998">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5368"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5961"/>
