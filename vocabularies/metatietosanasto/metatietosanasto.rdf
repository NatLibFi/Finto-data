    <skos:definition xml:lang="fi">Yhteisö, joka vastaa analyyttisen luettelon luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10636"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
