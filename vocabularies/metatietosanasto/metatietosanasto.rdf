    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4304"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4317"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4331"/>
    <skos:prefLabel xml:lang="en">music for expression</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">musiikki teoksen versioon</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musik till versionen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4306">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4310"/>
