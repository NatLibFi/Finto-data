    <skos:prefLabel xml:lang="en">predecessor of corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisön edeltäjä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4456">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5389"/>
    <skos:definition xml:lang="sv">Lokal institution, som står i kontakt med en större organisation som ett moderbolag representerar.</skos:definition>
    <skos:definition xml:lang="fi">Paikallinen yhteisö, jolla on yhteys emoyhtiön edustamaan laajempaan organisaatioon. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50241"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">local affiliate</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">lokalt dotterbolag</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">paikallinen tytäryhtiö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4457">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">sammanslagits med institution</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhteisöön yhdistynyt</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5389"/>
    <skos:definition xml:lang="sv">Institution som har sammanslagits med en annan institution för att bilda en tredje institution.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on sulautunut toiseen yhteisöön muodostaakseen kolmannen yhteisön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50011"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kanssayhdistyjä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mergee</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sammanslagits tillsammans med</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4458">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="en">corporate member</skos:altLabel>
    <skos:altLabel xml:lang="sv">institutionsmedlem</skos:altLabel>
    <skos:altLabel xml:lang="sv">medlemsinstitution i institutionen</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhteisöjäsen</skos:altLabel>
    <skos:altLabel xml:lang="fi">yhteisön jäsenyhteisö</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5389"/>
    <skos:definition xml:lang="sv">Institution i vilken en annan institution är medlemsinstitution.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on toisen yhteisön jäsenyhteisö. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50231"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
