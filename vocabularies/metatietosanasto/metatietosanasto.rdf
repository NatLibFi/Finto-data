    <skos:prefLabel xml:lang="sv">läroanstalt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">oppilaitos</skos:prefLabel>
    <skos:related rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m324"/>
