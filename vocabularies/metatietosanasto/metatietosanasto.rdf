    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka vakuuttaa olevansa viestintäkanava henkien maailmaan. (RDA Registry)</skos:definition>
