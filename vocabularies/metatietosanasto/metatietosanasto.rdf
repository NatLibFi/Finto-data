  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m269">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="fi">Polariteetti, jossa kuvan värit ja valoisuus ovat yhdistelmä ihmissilmin nähtäviä värejä ja valoisuutta sekä ihmissilmin nähtävien värien ja valoisuuden vastakohtia.</skos:definition>
    <skos:definition xml:lang="sv">Polaritet i vilken bildens färger och ljus är en blandning av dem som kan ses med blotta ögat och motsatserna till vad som kan ses med blotta ögat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAPolarity/1003"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">blandad polaritet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">mixed polarity</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">polariteettien yhdistelmä</skos:prefLabel>
  </owl:Class>
