  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5539">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arkitekt (institution) som är bidragsgivare till föremål</skos:altLabel>
    <skos:altLabel xml:lang="fi">esineeseen osallinen arkkitehti (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5337"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän arkkitehtisuunnitelman luomisesta vastuussa oleva yhteisö, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina.</skos:definition>
    <skos:definition xml:lang="sv">Institution som ansvarar för skapandet av en arkitektplan, inklusive en bildpresentation över hur en byggnad eller en annan konstruktion ska se ut när den är färdig, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">arkkitehti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5540">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">ljudtekniker (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ääniteknikko (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen huolehtimalla äänen teknisistä näkökohdista äänitys-, miksaus- ja äänentoistoprosessien aikana. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att sköta de tekniska aspekterna på ljud under inspelnings-, mixnings- och ljudåtergivningsprocesser.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20348"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">audio engineer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ljudtekniker</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">ääniteknikko</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5541">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5446"/>
    <skos:altLabel xml:lang="en">finding aid, hierarchic</skos:altLabel>
    <skos:altLabel xml:lang="sv">förteckning, hierarkisk</skos:altLabel>
    <skos:altLabel xml:lang="fi">luettelo, hierarkkinen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5647"/>
    <skos:definition xml:lang="fi">Teos, joka kokoelmamanifestaatioon sisältyvien alakokoelmien ja kappaleiden metatietokokonaisuus. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en metadatahelhet för delsamlingar och exemplar som ingår i en samlingsmanifestation.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30465"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">hierarchic finding aid</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">hierarkisk förteckning</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">hierarkkinen luettelo</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Kokoelma sisältää arkistokokoelman. (RDA Registry)</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Samling inbegriper arkivsamling.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5542">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kuoronjohtaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">kördirigent (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5543"/>
    <skos:definition xml:lang="fi">Henkilö, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla kuoroa musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en dirigent som deltar i utförandet av ett uttryck genom att leda en kör i en musik- eller dramaföreställning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20336"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">choral conductor person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuoronjohtaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kördirigent</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5543">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">dirigent (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">johtaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som deltar i utförandet av ett musikverks uttryck, genom att dirigera en uppträdande grupp i en musik- eller dramaföreställning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20383"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">conductor person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">dirigent</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">johtaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5544">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">juontaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">programledare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5289"/>
    <skos:definition xml:lang="fi">Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen juontamalla (usein lähetettyä) ohjelmaa, johon osallistuu muita esittäjiä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en framförare som deltar i utförandet av ett uttryck, genom att leda ett (ofta utsänt) program, i vilket andra uppträdande deltar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20372"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">host person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">juontaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">programledare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5545">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">televisio-ohjaaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tv-regissör (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5729"/>
    <skos:definition xml:lang="fi">Henkilö, joka on ohjaaja, joka on vastuussa televisio-ohjelman yleisestä johtamisesta ja valvonnasta. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en regissör, som svarar för allmän ledning och övervakning av ett tv-program.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10420"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">televisio-ohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">television director person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tv-regissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5546">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5722"/>
    <skos:altLabel xml:lang="fi">edustava ekspressio teokselle</skos:altLabel>
    <skos:altLabel xml:lang="sv">representativt uttryck för verket</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5513"/>
    <skos:definition xml:lang="fi">Teos, jonka tietojen identifioinnin kanonisena lähteenä ekspressiota pidetään. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk, för vars uppgifter ett uttryck anses vara kanonisk källa för identifiering.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20325"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">edustava versio teokselle</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">representativ version för verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">representative expression of</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5547">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression haastateltava (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">intervjuobjekt (institution) i uttryck</skos:altLabel>
    <skos:altLabel xml:lang="fi">version haastateltava</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5499"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck av ett verk genom att svara en intervjuare, vanligen en journalist, opinionsmätare eller någon annan aktör, som samlar information.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu teoksen ekspression tekemiseen vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jollekin muulle toimijalle, joka kerää tietoja. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20472"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">haastateltava (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">interviewee corporate body of expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">intervjuobjekt (uttryck)</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5548">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">granskare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tarkistaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5445"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen tekemällä muutoksia toisen ekspression sisältöön. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att göra ändringar i ett annat uttrycks innehåll.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20347"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">granskare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">reviser person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tarkistaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5549">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5371"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5969"/>
    <skos:definition xml:lang="fi">Teos, jota teos kuvaa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som ett verk beskriver.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10100"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m3476"/>
    <skos:prefLabel xml:lang="sv">beskrivning av verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">description of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kuvaus teoksesta</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m555">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kuvanveistäjä (suhde)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvanveistäjä (toimija)</skos:altLabel>
    <skos:altLabel xml:lang="en">sculptor</skos:altLabel>
    <skos:altLabel xml:lang="sv">skulptör (aktör)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skulptör (relation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m511"/>
    <skos:definition xml:lang="sv">Aktör som är en konstnär som svarar för skapandet av ett tredimensionellt verk, genom att modellera, skära eller använda någon liknande teknik.</skos:definition>
    <skos:definition xml:lang="fi">Toimija, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10202"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuvanveistäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="en">sculptor agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skulptör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5550">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kalligraf (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">kalligrafi (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5267"/>
    <skos:definition xml:lang="fi">Henkilö, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som är en konstnär som svarar för kalligrafi, i vilken huvudvikten ligger vid de estetiska värdena i handskrift eller grafisk konst, oberoende av om samma aktör också svarar för den skrivna texten.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10426"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">calligrapher person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kalligraf</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kalligrafi</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5551">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5439"/>
    <skos:definition xml:lang="fi">Aggregaattiin osallinen toimija, joka on luonut aggregaattiin sisältyvän koreografisen teoksen ekspression. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Aktör som bidragit till ett aggregat genom att skapa ett uttryck av ett koreografiskt verk som ingår i ett aggregat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30316"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">bidragsgivare (aktör) till koreografi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">contributor agent of choreography</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">koreografiaan osallinen toimija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5553">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5649"/>
    <skos:altLabel xml:lang="sv">analyserad i verket (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">arvosteltu teoksessa (ekspressio)</skos:altLabel>
    <skos:altLabel xml:lang="fi">ekspression arvostelu</skos:altLabel>
    <skos:altLabel xml:lang="sv">recension av uttrycket i</skos:altLabel>
    <skos:altLabel xml:lang="en">reviewed in (expression)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5762"/>
    <skos:definition xml:lang="fi">Teos, joka on ekspression lyhyt arviointi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Verk som är en kort recension av ett uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20274"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">expression reviewed by</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">recension av versionen i</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">version arvostelu</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5554">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmregissör (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen elokuvaohjaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän elokuvan yleisestä johtamisesta ja valvomisesta vastaava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för allmän ledning och övervakning av en film som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">elokuvaohjaaja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">filmregissör</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5555">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arrangör (person) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen sovittaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5442"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän sävellyksen alkuperäisteoksesta poikkeavalle esiintymiskokoonpanolle muokkaava henkilö. Voi myös muokata sävellystä samankaltaiselle esityskokoonpanolle säilyttäen alkuperäisen sävellyksen musikaalisen sisällön olennaisilta osin muuttumattomana.</skos:definition>
    <skos:definition xml:lang="sv">Person som omarbetar en komposition som ingår i ett aggregat, för en musikalisk besättning som avviker från originalverkets. Personen kan också omarbeta kompositionen för en likartad besättning så att originalkompositionens musikaliska innehåll till sina väsentliga delar bevaras oförändrat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arrangör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5556">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">forskare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">tutkija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5514"/>
    <skos:definition xml:lang="fi">Henkilö, joka tukee teoksen syntymistä tutkimuksellaan (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som stöder uppkomsten av ett verk genom sin forskning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10416"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">forskare</skos:prefLabel>
    <skos:prefLabel xml:lang="en">researcher person</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">tutkija</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5557">
    <isothes:superGroup rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4815"/>
    <rdf:type rdf:resource="http://purl.org/iso25964/skos-thes#ConceptGroup"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5310"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5374"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5502"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5596"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5690"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5742"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5919"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5946"/>
    <skos:member rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5962"/>
    <skos:prefLabel xml:lang="fi">Manifestaation suhteet kappaleeseen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Manifestationers relationer till exemplar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5558">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression entisöijä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator (institution) av uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator av version</skos:altLabel>
    <skos:altLabel xml:lang="sv">restauratör (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">version entisöijä</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5739"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck genom att restaurera eller sammanfoga tidigare uttryck, som kan vara skadade eller fragmentariska, för att skapa ett nytt uttryck.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu ekspression tekemiseen restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20473"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">entisöijä (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konservator (uttryck)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restorationist corporate body of expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5559">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">piirtäjä (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">ritare (institution)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5805"/>
    <skos:definition xml:lang="sv">Institution som deltar i utförandet av ett uttryck skapat av en arkitekt, designer eller annan dylik aktör, genom att skapa precisa planer eller ritningar av byggnader, fartyg, flygplan, apparater, föremål eller andra kreationer.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20457"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">draftsman corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">piirtäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">ritare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5560">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5772"/>
    <skos:altLabel xml:lang="fi">arvostelu manifestaatiosta</skos:altLabel>
    <skos:altLabel xml:lang="sv">recension av manifestationen</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5359"/>
    <skos:definition xml:lang="fi">Lyhyen arvioinnin perustana käytetty manifestaatio. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som använts som grund för en kort bedömning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10274"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">arvostelu aineistosta</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">recension av materialet</skos:prefLabel>
    <skos:prefLabel xml:lang="en">review of manifestation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5561">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">deltagare (institution) i paneldiskussion</skos:altLabel>
    <skos:altLabel xml:lang="sv">paneldeltagare</skos:altLabel>
    <skos:altLabel xml:lang="fi">panelisti (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5266"/>
    <skos:definition xml:lang="sv">Institution som är en framförare som deltar i utförandet av ett uttryck, genom att delta i ett (ofta utsänt) program, i vilket olika ämnen diskuteras, vanligen tillsammans med experter inom ämnen som relaterar till diskussionen.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20493"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">deltagare i paneldiskussion</skos:prefLabel>
    <skos:prefLabel xml:lang="en">panelist corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">panelisti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5562">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5638"/>
    <skos:definition xml:lang="sv">Släkt som hör till en institution.</skos:definition>
    <skos:definition xml:lang="fi">Suku, joka kuuluu yhteisöön. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50437"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">family member of corporate body</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släktmedlem i institution</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">yhteisön sukujäsen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5563">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">klichétillverkare</skos:altLabel>
    <skos:altLabel xml:lang="fi">kuvalaatan valmistaja (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">tryckmakare (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5486"/>
    <skos:definition xml:lang="fi">Henkilö, joka on vastuussa manifestaation valmistamisesta valmistamalla kohokuvan, syväpainon tai laakapainon painopinnan. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för tillverkningen av en manifestation genom att tillverka tryckytan för relief, djuptryck eller plantryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30352"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kuvalaatan valmistaja</skos:prefLabel>
    <skos:prefLabel xml:lang="en">printmaker person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">tryckmakare</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5564">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kostymör (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">puvustaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att planera kostymdesignen i en filmproduktion eller ett musikaliskt eller sceniskt framförande.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20345"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">costume designer person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kostymör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">puvustaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5565">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">kartograf (institution) för verk</skos:altLabel>
    <skos:altLabel xml:lang="fi">teoksen kartantekijä (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5607"/>
    <skos:definition xml:lang="sv">Institution som svarar för skapandet av ett kartografiskt verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka on vastuussa kartografisen teoksen luomisesta. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10529"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">cartographer corporate body of work</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kartograf för verk</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teoksen kartantekijä</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5566">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">puheeseen osallinen puhuja (yhteisö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">talare (institution) i talet</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m6009"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän puheen pitävä yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Institution som håller ett tal som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">puheen puhuja</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">talare i tal</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5567">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arkitekt (person) som är bidragsgivare till föremål</skos:altLabel>
    <skos:altLabel xml:lang="fi">esineeseen osallinen arkkitehti (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5425"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän arkkitehtisuunnitelman luomisesta vastuussa oleva henkilö, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina.</skos:definition>
    <skos:definition xml:lang="sv">Person som ansvarar för skapandet av en arkitektplan, inklusive en bildpresentation över hur en byggnad eller en annan konstruktion ska se ut när den är färdig, som ingår i ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arkitekt</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">arkkitehti</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5568">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">transkriberare (person)</skos:altLabel>
    <skos:altLabel xml:lang="fi">transkriboija (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5548"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck, genom att uppteckna eller skriva ner noter för ett oskrivet eller onoterat innehåll eller ändra dess notationssystem till ett annat.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20359"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">transcriber person</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">transkriberare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">transkriboija</skos:prefLabel>
    <skos:scopeNote xml:lang="sv">Hit hör inte transkribering av ett musikverk för ett annat instrument eller en annan framförande grupp.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Tähän ei kuulu musiikkiteoksen transkribointi eri soittimelle tai esitysryhmälle. (RDA Registry)</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5569">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">erikoistehosteiden tekijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">skapare av specialeffekter (person)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5302"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu liikkuvan kuvan tai ääniteoksen ekspression tekemiseen suunnittelemalla ja luomalla taltioinnin aikana tapahtuvat erikoistehosteet, kuten mekaaniset tehosteet ja kameralla toteutettavat optiset tehosteet. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av uttryck av rörlig bild eller ljudverk, genom att planera eller skapa specialeffekter som sker under inspelning, såsom mekaniska effekter och optiska effekter skapade med kamera.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20360"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">erikoistehosteiden tekijä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">skapare av specialeffekter</skos:prefLabel>
    <skos:prefLabel xml:lang="en">special effects provider person</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m557">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">DVD-A</skos:altLabel>
    <skos:altLabel xml:lang="sv">DVD-A</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">DVD-Audio</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">DVD-Audio</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">DVD-levyjen yleisin digitaalinen formaatti.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Det vanligaste digitala formatet för DVD-skivor.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Kodningsformat för ljud.</skos:scopeNote>
    <skos:scopeNote xml:lang="fi">Äänen koodausmuoto.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5570">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">arrangör (institution) som är bidragsgivare till musik</skos:altLabel>
    <skos:altLabel xml:lang="fi">musiikkiin osallinen sovittaja (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5883"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän sävellyksen alkuperäisteoksesta poikkeavalle esiintymiskokoonpanolle muokkaava yhteisö. Voi myös muokata sävellystä samankaltaiselle esityskokoonpanolle säilyttäen alkuperäisen sävellyksen musikaalisen sisällön olennaisilta osin muuttumattomana.</skos:definition>
    <skos:definition xml:lang="sv">Institution som omarbetar en komposition som ingår i ett aggregat, för en musikalisk besättning som avviker från originalverkets. Institutionen kan också omarbeta kompositionen för en likartad besättning så att originalkompositionens musikaliska innehåll till sina väsentliga delar bevaras oförändrat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">arrangör</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sovittaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5571">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Släkt som en aktör relaterar till.</skos:definition>
    <skos:definition xml:lang="fi">Suku, johon identifioitavana oleva toimija liittyy. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/a/P50219"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">related family of agent</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släkt relaterad till aktören</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">toimijaan liittyvä suku</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5572">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5919"/>
    <skos:altLabel xml:lang="fi">kappaleen edustama manifestaatio</skos:altLabel>
    <skos:altLabel xml:lang="sv">manifestation som exemplaret representerar</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5631"/>
    <skos:definition xml:lang="fi">Manifestaatio, jota kappale edustaa. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som ett exemplar representerar.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/i/P40049"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">kappaleen edustama aineisto</skos:prefLabel>
    <skos:prefLabel xml:lang="en">manifestation exemplified</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">material som exemplaret representerar</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5573">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">ekspression entisöijä (henkilö)</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator (person) av uttrycket</skos:altLabel>
    <skos:altLabel xml:lang="sv">konservator av version</skos:altLabel>
    <skos:altLabel xml:lang="sv">restauratör (uttryck)</skos:altLabel>
    <skos:altLabel xml:lang="fi">version entisöijä</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5548"/>
    <skos:definition xml:lang="fi">Henkilö, joka osallistuu ekspression tekemiseen restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Person som deltar i utförandet av ett uttryck genom att restaurera eller sammanfoga tidigare uttryck, som kan vara skadade eller fragmentariska, för att skapa ett nytt uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20355"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">entisöijä (ekspressio)</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">konservator (uttryck)</skos:prefLabel>
    <skos:prefLabel xml:lang="en">restorationist person of expression</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5574">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Institution som relaterar till ett verk.</skos:definition>
    <skos:definition xml:lang="fi">Yhteisö, joka liittyy teokseen. (RDA Registry)</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/w/P10314"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:narrower rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m420"/>
    <skos:prefLabel xml:lang="sv">institution relaterad till verket</skos:prefLabel>
    <skos:prefLabel xml:lang="en">related corporate body of work</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">teokseen liittyvä yhteisö</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5575">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
