    <skos:definition xml:lang="fi">Digitaalisessa muodossa oleva kappale, joka muunnetaan toisessa digitaalisessa muodossa olevaksi manifestaatioksi. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Exemplar i digital form, som konverteras till en manifestation i en annan digital form.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30298"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
