  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5859">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">klippare (person) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen leikkaaja (henkilö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5313"/>
    <skos:definition xml:lang="fi">Aggregaattiin sisältyvän filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta, sekä kuvan että äänen osalta, vastaava henkilö.</skos:definition>
    <skos:definition xml:lang="sv">Person som svarar för samling, ordnande och klippning av film, video eller andra format för rörlig bild som ingår i ett aggregat, både beträffande bild och ljud.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">klippare</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">leikkaaja</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m586">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kosketeltava nuottikirjoitus</skos:altLabel>
    <skos:definition xml:lang="fi">Musiikkinotaationa esitetty sisältö, joka on tarkoitettu kosketeltavaksi. Esimerkiksi pistenuottikirjoitus ja muut taktiilit nuottikirjoitukset.</skos:definition>
    <skos:definition xml:lang="sv">Noterad musik avsedd att vidröras, t.ex. punktskriftsnoter.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAContentType/1016"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">tactile notated music</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">taktiili nuottikirjoitus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">taktil musiknotation</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5860">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
