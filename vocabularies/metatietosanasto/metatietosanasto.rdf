  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m355">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Mediet innehåller mycket små objekt och används med hjälp av en apparat såsom ett mikroskop, som visar detaljer som inte går att ses med blotta ögat.</skos:definition>
    <skos:definition xml:lang="fi">Viestin sisältää hyvin pieniä objekteja, ja se on suunniteltu käytettäväksi laitteella kuten mikroskoopilla, joka paljastaa yksityiskohtia joita ei voi nähdä paljaalla silmällä.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/RDAMediaType/1004"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">mikroskooppinen</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">mikroskopisk</skos:prefLabel>
  </owl:Class>
