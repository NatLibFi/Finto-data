    <skos:altLabel xml:lang="fi">kunnallinen palokunta</skos:altLabel>
    <skos:altLabel xml:lang="fi">palolaitos</skos:altLabel>
    <skos:closeMatch rdf:resource="http://www.yso.fi/onto/yso/p12796"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="sv">brandkår</skos:prefLabel>
