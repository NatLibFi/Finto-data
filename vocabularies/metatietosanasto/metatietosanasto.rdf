    <skos:definition xml:lang="fi">Kuvailtavan henkilön sisarus, jolla on samat biologiset vanhemmat kuin hänellä.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
