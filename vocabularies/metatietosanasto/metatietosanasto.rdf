    <skos:altLabel xml:lang="fi">poliisihallinto</skos:altLabel>
    <skos:altLabel xml:lang="sv">polisförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="sv">räddningsförvaltning</skos:altLabel>
    <skos:altLabel xml:lang="fi">siirtoväen huolto</skos:altLabel>
    <skos:altLabel xml:lang="fi">väestönsiirto</skos:altLabel>
