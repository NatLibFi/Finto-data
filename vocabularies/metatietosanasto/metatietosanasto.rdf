    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasParentInlaw"/>
    <skos:definition xml:lang="sv">Förälder till en partner till en beskriven person.</skos:definition>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön puolison vanhempi.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">appivanhempi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">has parent-in-law</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">svärförälder</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4635">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasRelative"/>
    <skos:definition xml:lang="fi">Henkilö, jolle kuvailtava henkilö on sukua. Ei viittaa vain biologiseen sukulaisuuteen, vaan myös avioliiton, adoption tai kasvatuksen kautta muodostuneisiin suhteisiin.</skos:definition>
    <skos:definition xml:lang="sv">Person med vilken en beskriven person är släkt. Hänvisar inte enbart till biologiskt släktskap, utan även relationer som bildats genom äktenskap, adoption eller fostran.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has relative</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">släkting</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">sukulainen</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4636">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">kyty</skos:altLabel>
    <skos:altLabel xml:lang="fi">käly</skos:altLabel>
    <skos:altLabel xml:lang="fi">lanko</skos:altLabel>
    <skos:altLabel xml:lang="sv">makas/makes syskon</skos:altLabel>
    <skos:altLabel xml:lang="fi">nato</skos:altLabel>
    <skos:altLabel xml:lang="fi">sisaruksen puoliso</skos:altLabel>
    <skos:altLabel xml:lang="sv">svägerska</skos:altLabel>
    <skos:altLabel xml:lang="sv">svåger</skos:altLabel>
    <skos:altLabel xml:lang="sv">syskons partner</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5264"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasSiblingInlaw"/>
    <skos:definition xml:lang="fi">Kuvailtavan henkilön puolison sisarus.</skos:definition>
    <skos:definition xml:lang="sv">Syskon till en beskriven persons partner.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
