    <skos:altLabel xml:lang="sv">animatör (institution) som är bidragsgivare till rörlig bild</skos:altLabel>
    <skos:altLabel xml:lang="fi">liikkuvaan kuvaan osallinen animaattori (yhteisö)</skos:altLabel>
