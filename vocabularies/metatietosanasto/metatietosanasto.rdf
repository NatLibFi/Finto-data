    <skos:prefLabel xml:lang="fi">8 mm</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">8 mm</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m1270">
