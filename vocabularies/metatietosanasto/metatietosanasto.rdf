    <skos:prefLabel xml:lang="en">card</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kort</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kortti</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ilman laitetta käytettävä tallennetyyppi.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Omedierad bärartyp.</skos:scopeNote>
  </owl:Class>
