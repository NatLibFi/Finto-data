    <skos:prefLabel xml:lang="en">Polarity</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Liittää manifestaation suhteeseen, joka kuvan väreillä ja valoisuudella on kuvan kohteen väreihin ja valoisuuteen.</skos:scopeNote>
