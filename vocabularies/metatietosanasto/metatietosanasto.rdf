    <skos:prefLabel xml:lang="fi">laulu</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">sång</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Teoksen muoto -termejä käytetään erottamaan toisistaan samannimiset teokset.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Verkets form-termer används för att åtskilja verk med samma namn.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5246">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">hallitusneuvos (arvonimi)</skos:altLabel>
    <skos:altLabel xml:lang="sv">regeringsråd (hederstitel)</skos:altLabel>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">hallitusneuvos</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">regeringsråd</skos:prefLabel>
    <skos:scopeNote xml:lang="fi">Ammattina käytä: &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m3671'&gt;hallitusneuvos&lt;/a&gt;.</skos:scopeNote>
    <skos:scopeNote xml:lang="sv">Som yrke använd: &lt;a href='http://urn.fi/URN:NBN:fi:au:mts:m3671'&gt;regeringsråd&lt;/a&gt;.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5249">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:inverseOf rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5238"/>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5336"/>
    <skos:closeMatch rdf:resource="https://d-nb.info/standards/elementset/agrelon#hasMuse"/>
    <skos:definition xml:lang="fi">Henkilö, joka inspiroi kuvailtavaa yhteisöä taiteellisessa työssä.</skos:definition>
    <skos:definition xml:lang="sv">Person som inspirerar en beskriven institution i konstnärligt arbete.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">has muse</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">musa</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">muusa</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m5251">
    <dc11:source>AgRelOn, an Agent Relationship Ontology</dc11:source>
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
