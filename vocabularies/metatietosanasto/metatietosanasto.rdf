    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="sv">Specialegenskap för ljudåtergivning som följer National Association of Broadcasters standarder.</skos:definition>
    <skos:definition xml:lang="fi">Äänentoiston erityisominaisuus, joka noudattaa National Association of Broadcastersin standardeja.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/termList/specPlayback/1009"/>
