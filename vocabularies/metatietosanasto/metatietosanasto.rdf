    <skos:altLabel xml:lang="fi">tekstiin osallinen raportoija (yhteisö)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5413"/>
    <skos:definition xml:lang="fi">Aggregaattiin liittyvissä teksteissä kokouksista raportoiva yhteisö.</skos:definition>
    <skos:definition xml:lang="sv">Person som rapporterar om möten i texter som relaterar till ett aggregat.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">raportoija</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">rapportör</skos:prefLabel>
