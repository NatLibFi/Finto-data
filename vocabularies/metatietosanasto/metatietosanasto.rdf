    <skos:definition xml:lang="fi">Musiikkiteoksen, kuten konserton, ekspressio, johon on lisätty musiikkiteoksen ekspressio, joka on solistille tarkoitettu koristeellinen osa samalta tai eri säveltäjältä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av musikverk, såsom en konsert, till vilken lagts till ett musikverks uttryck som är en dekorativ del för en solist, av samma eller en annan kompositör.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20083"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="en">cadenza composed for expression</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">kadens till versionen</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">kadenssi versioon</skos:prefLabel>
  </owl:Class>
  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4338">
    <dc11:source xml:lang="sv">RDA-term</dc11:source>
    <dc11:source xml:lang="fi">RDA-termi</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="sv">filmad med</skos:altLabel>
    <skos:altLabel xml:lang="fi">filmillä myös (manifestaatio)</skos:altLabel>
    <skos:altLabel xml:lang="sv">på filmen även (manifestation)</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4247"/>
    <skos:definition xml:lang="fi">Manifestaatio, joka on kuvattu samalle filmille kuin kuvailun kohteena oleva manifestaatio. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Manifestation som har filmats på samma film som den manifestation som är föremål för beskrivning.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/m/P30037"/>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
