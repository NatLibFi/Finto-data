    <skos:altLabel xml:lang="fi">johdettu ekspressio</skos:altLabel>
    <skos:altLabel xml:lang="sv">uttryck av härlett verk</skos:altLabel>
    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m5675"/>
