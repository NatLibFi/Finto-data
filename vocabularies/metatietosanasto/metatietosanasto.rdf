  <owl:Class rdf:about="http://urn.fi/URN:NBN:fi:au:mts:m4047">
    <dc11:source xml:lang="fi">Kansallinen RDA-termi</dc11:source>
    <dc11:source xml:lang="sv">Nationell RDA-term</dc11:source>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:altLabel xml:lang="fi">lennätinvirkailija</skos:altLabel>
    <skos:definition xml:lang="sv">En telefgrafist skickar ut och tar emot elektromagnetiska meddelanden med hjälp av fasta kablar. Använts som yrkesbenämning vid bl.a. telegrafkontor.</skos:definition>
    <skos:definition xml:lang="fi">Sähköttäjä lähettää ja vastaanottaa morsettamalla sähkömagneettisia viestejä käyttäen kiinteitä kaapeleita. Käytetty ammattinimikkeenä mm. lennätinkonttoreissa.</skos:definition>
    <skos:inScheme rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:"/>
    <skos:prefLabel xml:lang="fi">sähköttäjä</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">telegrafist</skos:prefLabel>
