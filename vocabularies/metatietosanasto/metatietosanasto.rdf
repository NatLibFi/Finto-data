    <skos:broader rdf:resource="http://urn.fi/URN:NBN:fi:au:mts:m4236"/>
    <skos:definition xml:lang="fi">Teoksen ekspressio, jonka sisältöä on laajennettu siihen liittyvän teoksen ekspression sisällöllä. (RDA Registry)</skos:definition>
    <skos:definition xml:lang="sv">Uttryck av verk vars innehåll har utvidgats med innehåll från ett relaterat verks uttryck.</skos:definition>
    <skos:exactMatch rdf:resource="http://rdaregistry.info/Elements/e/P20089"/>
